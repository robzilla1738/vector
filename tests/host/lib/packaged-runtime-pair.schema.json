{
  "manifestSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "producer",
      "version",
      "source",
      "native",
      "package",
      "inputHelper",
      "originalPairProof",
      "watcher",
      "cleanup",
      "qualification",
      "privateRuntimeActive"
    ],
    "properties": {
      "producer": {
        "const": "aux-packaged-runtime-pair"
      },
      "version": {
        "const": 1
      },
      "source": {
        "$ref": "#/$defs/source"
      },
      "native": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "buildId",
          "sourceCommit",
          "generatedFiles",
          "graph",
          "compiledClosure"
        ],
        "properties": {
          "buildId": {
            "type": "string",
            "minLength": 1
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "generatedFiles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/regularFile"
            },
            "minItems": 3
          },
          "graph": {
            "$ref": "#/$defs/graph"
          },
          "compiledClosure": {
            "allOf": [
              {
                "$ref": "#/$defs/closure"
              },
              {
                "properties": {
                  "scope": {
                    "const": "compiled-deployment"
                  }
                }
              }
            ]
          }
        }
      },
      "package": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "appRoot",
          "runtimeRootRelative",
          "runtimeIdentityRelative",
          "runtimeIdentityFile",
          "runtimeIdentity",
          "runtimeClosure",
          "nodeRelative",
          "nodeFile",
          "nodeVersion",
          "appClosure",
          "shellAssets",
          "stage",
          "unsigned"
        ],
        "properties": {
          "appRoot": {
            "type": "string",
            "pattern": "^/"
          },
          "runtimeRootRelative": {
            "const": "Contents/Resources/aux-runtime"
          },
          "runtimeIdentityRelative": {
            "const": "Contents/Resources/aux-runtime/aux-runtime-identity.json"
          },
          "runtimeIdentityFile": {
            "$ref": "#/$defs/regularFile"
          },
          "runtimeIdentity": {
            "$ref": "#/$defs/productIdentity"
          },
          "runtimeClosure": {
            "allOf": [
              {
                "$ref": "#/$defs/closure"
              },
              {
                "properties": {
                  "scope": {
                    "const": "complete-tree"
                  }
                }
              }
            ]
          },
          "nodeRelative": {
            "const": "Contents/Helpers/Aux Runtime"
          },
          "nodeFile": {
            "$ref": "#/$defs/regularFile"
          },
          "nodeVersion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "process"
            ],
            "properties": {
              "value": {
                "const": "v26.7.0"
              },
              "process": {
                "$ref": "#/$defs/successfulChild"
              }
            }
          },
          "appClosure": {
            "allOf": [
              {
                "$ref": "#/$defs/closure"
              },
              {
                "properties": {
                  "scope": {
                    "const": "complete-tree"
                  }
                }
              }
            ]
          },
          "shellAssets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pinnedManifest",
              "dimensionAwareDigest",
              "sourceInputClosure",
              "gritBuildSource",
              "generatedResourceMap",
              "generatedPak",
              "deployedCarriers",
              "resourceReadbackProof"
            ],
            "properties": {
              "pinnedManifest": {
                "$ref": "#/$defs/reference"
              },
              "dimensionAwareDigest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sourceInputClosure": {
                "allOf": [
                  {
                    "$ref": "#/$defs/closure"
                  },
                  {
                    "properties": {
                      "scope": {
                        "const": "complete-tree"
                      }
                    }
                  }
                ]
              },
              "gritBuildSource": {
                "$ref": "#/$defs/reference"
              },
              "generatedResourceMap": {
                "$ref": "#/$defs/reference"
              },
              "generatedPak": {
                "$ref": "#/$defs/reference"
              },
              "resourceReadbackProof": {
                "$ref": "#/$defs/reference"
              },
              "deployedCarriers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/reference"
                }
              }
            }
          },
          "stage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stageRuntimeSource",
              "argv",
              "exitCode",
              "stdout",
              "stderr",
              "children",
              "cleanup"
            ],
            "properties": {
              "stageRuntimeSource": {
                "$ref": "#/$defs/reference"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "exitCode": {
                "const": 0
              },
              "stdout": {
                "$ref": "#/$defs/reference"
              },
              "stderr": {
                "$ref": "#/$defs/reference"
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/successfulChild"
                },
                "minItems": 1
              },
              "cleanup": {
                "$ref": "#/$defs/cleanup"
              }
            }
          },
          "unsigned": {
            "const": true
          }
        }
      },
      "inputHelper": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "compilerManifestProducer",
          "compilerManifestVersion",
          "compiledArtifactManifest",
          "independentHelperAudit",
          "independentHelperAuditProducer",
          "independentHelperAuditVersion",
          "source",
          "executable"
        ],
        "properties": {
          "compilerManifestProducer": {
            "const": "aux-native-window-helper-compile"
          },
          "compilerManifestVersion": {
            "const": 1
          },
          "compiledArtifactManifest": {
            "$ref": "#/$defs/reference"
          },
          "independentHelperAudit": {
            "$ref": "#/$defs/reference"
          },
          "independentHelperAuditProducer": {
            "const": "aux-native-window-helper-independent-audit"
          },
          "independentHelperAuditVersion": {
            "const": 1
          },
          "source": {
            "$ref": "#/$defs/regularFile"
          },
          "executable": {
            "$ref": "#/$defs/regularFile"
          }
        }
      },
      "originalPairProof": {
        "$ref": "#/$defs/reference"
      },
      "watcher": {
        "$ref": "#/$defs/watcher"
      },
      "cleanup": {
        "$ref": "#/$defs/cleanup"
      },
      "qualification": {
        "const": "none"
      },
      "privateRuntimeActive": {
        "const": false
      }
    },
    "$defs": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "productIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "tree",
          "dirty",
          "label"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "tree": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "dirty": {
            "const": false
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "regularFile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "mode",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "processIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pid",
          "ppid",
          "pgid",
          "started",
          "argv"
        ],
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "ppid": {
            "type": "integer",
            "minimum": 0
          },
          "pgid": {
            "type": "integer",
            "minimum": 1
          },
          "started": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "successfulChild": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "exitCode",
          "timedOut",
          "cancelled",
          "groupEmpty",
          "stdout",
          "stderr"
        ],
        "properties": {
          "identity": {
            "$ref": "#/$defs/processIdentity"
          },
          "exitCode": {
            "const": 0
          },
          "timedOut": {
            "const": false
          },
          "cancelled": {
            "const": false
          },
          "groupEmpty": {
            "const": true
          },
          "stdout": {
            "$ref": "#/$defs/reference"
          },
          "stderr": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "cleanup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "originalProcesses",
          "originalGroups",
          "finalAbsenceReceipt",
          "originalProcessesAbsent",
          "originalGroupsAbsent",
          "slotAbsent",
          "cleanupDebt"
        ],
        "properties": {
          "originalProcesses": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/processIdentity"
            },
            "minItems": 1
          },
          "originalGroups": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1
          },
          "finalAbsenceReceipt": {
            "$ref": "#/$defs/reference"
          },
          "originalProcessesAbsent": {
            "const": true
          },
          "originalGroupsAbsent": {
            "const": true
          },
          "slotAbsent": {
            "const": true
          },
          "cleanupDebt": {
            "const": null
          }
        }
      },
      "watcher": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "config",
          "events",
          "ready",
          "done",
          "exitCode",
          "incident"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/reference"
          },
          "config": {
            "$ref": "#/$defs/reference"
          },
          "events": {
            "$ref": "#/$defs/reference"
          },
          "ready": {
            "$ref": "#/$defs/reference"
          },
          "done": {
            "$ref": "#/$defs/reference"
          },
          "exitCode": {
            "const": 0
          },
          "incident": {
            "const": null
          }
        }
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "head",
          "gitTree",
          "productIdentity",
          "wholeCheckoutCleanBefore",
          "wholeCheckoutCleanAfter",
          "nativeReplayProof",
          "sourcePreparationProof"
        ],
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^/"
          },
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "gitTree": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "productIdentity": {
            "$ref": "#/$defs/productIdentity"
          },
          "wholeCheckoutCleanBefore": {
            "const": true
          },
          "wholeCheckoutCleanAfter": {
            "const": true
          },
          "nativeReplayProof": {
            "$ref": "#/$defs/reference"
          },
          "sourcePreparationProof": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "graph": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "controller",
          "argv",
          "targets",
          "exitCode",
          "terminalProof",
          "rawLog",
          "children",
          "cleanup"
        ],
        "properties": {
          "controller": {
            "$ref": "#/$defs/reference"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "targets": {
            "const": [
              "chrome",
              "chrome/browser/ui/aux:owner_mutation_fence_unittests",
              "chrome/browser/ui/aux:profile_spaces_unittests",
              "unit_tests",
              "content_unittests",
              "blink_unittests",
              "browser_tests",
              "cc_unittests",
              "viz_unittests",
              "blink_platform_unittests",
              "chrome/browser/ui/aux:journey_fixture_path_unittests",
              "chrome/browser/ui/aux:link_routing_unittests",
              "chrome/browser/ui/aux:auto_pip_site_policy_unittests",
              "interactive_ui_tests",
              "blink_common_unittests",
              "components_unittests",
              "components_browsertests"
            ]
          },
          "exitCode": {
            "const": 0
          },
          "terminalProof": {
            "$ref": "#/$defs/reference"
          },
          "rawLog": {
            "$ref": "#/$defs/reference"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/successfulChild"
            },
            "minItems": 1
          },
          "cleanup": {
            "$ref": "#/$defs/cleanup"
          }
        }
      },
      "closure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "rows",
          "inventorySha256",
          "scope",
          "rootMetadata"
        ],
        "properties": {
          "root": {
            "type": "string",
            "pattern": "^/"
          },
          "rows": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "path",
                    "sha256",
                    "mode",
                    "size"
                  ],
                  "properties": {
                    "kind": {
                      "const": "regular"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "mode": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "path",
                    "target",
                    "sha256",
                    "mode",
                    "size"
                  ],
                  "properties": {
                    "kind": {
                      "const": "symlink"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "mode": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "path",
                    "mode"
                  ],
                  "properties": {
                    "kind": {
                      "const": "directory"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//).+$"
                    },
                    "mode": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4095
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "inventorySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "enum": [
              "complete-tree",
              "compiled-deployment"
            ]
          },
          "rootMetadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "device",
              "inode",
              "mode"
            ],
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
                "minimum": 1
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4095
              }
            }
          }
        }
      }
    }
  },
  "independentAuditSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "producer",
      "version",
      "manifest",
      "originalPairProof",
      "helperManifest",
      "independentHelperAudit",
      "actualSourceHead",
      "actualProductIdentity",
      "actualNativeBuildId",
      "actualNativeSourceCommit",
      "byteFactCount",
      "checks",
      "passed",
      "qualification",
      "privateRuntimeActive"
    ],
    "properties": {
      "producer": {
        "const": "aux-packaged-runtime-pair-independent-audit"
      },
      "version": {
        "const": 1
      },
      "manifest": {
        "$ref": "#/$defs/reference"
      },
      "originalPairProof": {
        "$ref": "#/$defs/reference"
      },
      "helperManifest": {
        "$ref": "#/$defs/reference"
      },
      "independentHelperAudit": {
        "$ref": "#/$defs/reference"
      },
      "actualSourceHead": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "actualProductIdentity": {
        "$ref": "#/$defs/productIdentity"
      },
      "actualNativeBuildId": {
        "type": "string",
        "minLength": 1
      },
      "actualNativeSourceCommit": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "byteFactCount": {
        "type": "integer",
        "minimum": 1
      },
      "checks": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceClean",
          "originalFullGraphSuccess",
          "compiledClosureComplete",
          "nativeIdentityMatches",
          "runtimeIdentityMatches",
          "appClosureComplete",
          "runtimeClosureComplete",
          "nodeIdentityMatches",
          "shellAssetsMatch",
          "helperCompilerAndBytesMatch",
          "watchFinishedWithoutIncident",
          "originalCleanupAbsent"
        ],
        "properties": {
          "sourceClean": {
            "const": true
          },
          "originalFullGraphSuccess": {
            "const": true
          },
          "compiledClosureComplete": {
            "const": true
          },
          "nativeIdentityMatches": {
            "const": true
          },
          "runtimeIdentityMatches": {
            "const": true
          },
          "appClosureComplete": {
            "const": true
          },
          "runtimeClosureComplete": {
            "const": true
          },
          "nodeIdentityMatches": {
            "const": true
          },
          "shellAssetsMatch": {
            "const": true
          },
          "helperCompilerAndBytesMatch": {
            "const": true
          },
          "watchFinishedWithoutIncident": {
            "const": true
          },
          "originalCleanupAbsent": {
            "const": true
          }
        }
      },
      "passed": {
        "const": true
      },
      "qualification": {
        "const": "none"
      },
      "privateRuntimeActive": {
        "const": false
      }
    },
    "$defs": {
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "productIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "tree",
          "dirty",
          "label"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "tree": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "dirty": {
            "const": false
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "externalAdmissionArguments": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "manifestPath",
      "manifestSha256",
      "auditPath",
      "auditSha256",
      "helperManifestPath",
      "helperManifestSha256",
      "helperAuditPath",
      "helperAuditSha256"
    ],
    "properties": {
      "manifestPath": {
        "type": "string",
        "pattern": "^/"
      },
      "manifestSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "auditPath": {
        "type": "string",
        "pattern": "^/"
      },
      "auditSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "helperManifestPath": {
        "type": "string",
        "pattern": "^/"
      },
      "helperManifestSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "helperAuditPath": {
        "type": "string",
        "pattern": "^/"
      },
      "helperAuditSha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  }
}
