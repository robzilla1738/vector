{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "producer",
    "version",
    "passed",
    "sourceCommit",
    "originalInterpreter",
    "originalArgv",
    "gritSourceRefs",
    "interpreterImportRefs",
    "actionInputRefs",
    "admitted",
    "originalGritActionDispatched",
    "fullResolutionBaseline",
    "resolutionTool",
    "normalStartupProbeReceipt",
    "originalCleanupProof",
    "independentDerivationPreaudit",
    "derivationInput",
    "failures",
    "closedProbeEnvironment",
    "normalStartupProbe",
    "ownedScratchRoot"
  ],
  "properties": {
    "producer": {
      "const": "aux-shell-original-import-input-closure"
    },
    "version": {
      "const": 1
    },
    "passed": {
      "const": true
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "originalInterpreter": {
      "$ref": "#/$defs/reference"
    },
    "originalArgv": {
      "type": "array",
      "minItems": 101,
      "maxItems": 101,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gritSourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "interpreterImportRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "actionInputRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "admitted": {
      "const": false
    },
    "originalGritActionDispatched": {
      "const": false
    },
    "fullResolutionBaseline": {
      "$ref": "#/$defs/reference"
    },
    "resolutionTool": {
      "$ref": "#/$defs/reference"
    },
    "normalStartupProbeReceipt": {
      "$ref": "#/$defs/reference"
    },
    "originalCleanupProof": {
      "$ref": "#/$defs/reference"
    },
    "independentDerivationPreaudit": {
      "$ref": "#/$defs/reference"
    },
    "derivationInput": {
      "$ref": "#/$defs/reference"
    },
    "failures": {
      "type": "array",
      "maxItems": 0
    },
    "closedProbeEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PATH",
        "LANG",
        "LC_ALL",
        "PYTHONDONTWRITEBYTECODE",
        "PYTHONNOUSERSITE",
        "PYTHONPYCACHEPREFIX"
      ],
      "properties": {
        "PATH": {
          "const": "/usr/bin:/bin"
        },
        "LANG": {
          "const": "C"
        },
        "LC_ALL": {
          "const": "C"
        },
        "PYTHONDONTWRITEBYTECODE": {
          "const": "1"
        },
        "PYTHONNOUSERSITE": {
          "const": "1"
        },
        "PYTHONPYCACHEPREFIX": {
          "type": "string",
          "pattern": "^/.*/fresh-empty-pycache$"
        }
      },
      "$defs": {
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "normalStartupProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix",
        "basePrefix",
        "userSiteEnabled",
        "pythonPathEnvironmentPresent",
        "pythonHomeEnvironmentPresent",
        "sysPath",
        "loadedModuleFiles"
      ],
      "properties": {
        "prefix": {
          "type": "string"
        },
        "basePrefix": {
          "type": "string"
        },
        "userSiteEnabled": {
          "const": false
        },
        "pythonPathEnvironmentPresent": {
          "const": false
        },
        "pythonHomeEnvironmentPresent": {
          "const": false
        },
        "sysPath": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "loadedModuleFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "ownedScratchRoot": {
      "type": "string",
      "pattern": "^/"
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
