{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "producer",
    "version",
    "inputOrigin",
    "sourceCommit",
    "originalSuccessfulGraphProof",
    "originalGritAction",
    "originalSourceManifest",
    "originalGeneratedGrd",
    "originalGeneratedHeader",
    "originalGeneratedResourceMap",
    "replayController",
    "replayArgv",
    "ownedScratchRoot",
    "replayOnlyOutputRedirectionEvidence",
    "stdout",
    "stderr",
    "exitCode",
    "originalCleanupProof",
    "rows",
    "failures",
    "passed",
    "originalImportInputClosureProof"
  ],
  "properties": {
    "producer": {
      "const": "aux-shell-original-action-transform-replay"
    },
    "version": {
      "const": 1
    },
    "inputOrigin": {
      "const": "original-source"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "originalSuccessfulGraphProof": {
      "$ref": "#/$defs/reference"
    },
    "originalGritAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "responseFiles",
        "expandedArgv",
        "defineArguments",
        "minifierArguments",
        "environmentProvenance",
        "toolAndSourceRefs"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "responseFiles": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "expandedArgv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defineArguments": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minifierArguments": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "environmentProvenance": {
          "$ref": "#/$defs/reference"
        },
        "toolAndSourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "originalSourceManifest": {
      "$ref": "#/$defs/reference"
    },
    "originalGeneratedGrd": {
      "$ref": "#/$defs/reference"
    },
    "originalGeneratedHeader": {
      "$ref": "#/$defs/reference"
    },
    "originalGeneratedResourceMap": {
      "$ref": "#/$defs/reference"
    },
    "replayController": {
      "$ref": "#/$defs/reference"
    },
    "replayArgv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ownedScratchRoot": {
      "type": "string",
      "pattern": "^/"
    },
    "replayOnlyOutputRedirectionEvidence": {
      "$ref": "#/$defs/reference"
    },
    "stdout": {
      "$ref": "#/$defs/reference"
    },
    "stderr": {
      "$ref": "#/$defs/reference"
    },
    "exitCode": {
      "type": "integer"
    },
    "originalCleanupProof": {
      "$ref": "#/$defs/reference"
    },
    "rows": {
      "type": "array",
      "minItems": 175,
      "maxItems": 175,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourcePath",
          "resourceName",
          "resourceId",
          "originalSourceInput",
          "originalSourceInputSize",
          "originalSelectedIncludeEvidence",
          "actualGritNodeType",
          "actualPipelineCodeRefs",
          "expandedDefines",
          "expandedMinifierArgv",
          "actualTransformStages",
          "expectedTransformedArtifact",
          "expectedTransformedSize",
          "expectedTransformedSha256",
          "expectedStoredArtifact",
          "expectedStoredSha256",
          "expectedStoredSize",
          "sourceEqualsExpectedTransformed",
          "failures"
        ],
        "properties": {
          "resourcePath": {
            "type": "string",
            "minLength": 1
          },
          "resourceName": {
            "type": "string",
            "minLength": 1
          },
          "resourceId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "originalSourceInput": {
            "$ref": "#/$defs/reference"
          },
          "originalSourceInputSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "originalSelectedIncludeEvidence": {
            "$ref": "#/$defs/reference"
          },
          "actualGritNodeType": {
            "enum": [
              "BINDATA",
              "chrome_html"
            ]
          },
          "actualPipelineCodeRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/reference"
            }
          },
          "expandedDefines": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "boolean",
                "integer"
              ]
            }
          },
          "expandedMinifierArgv": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "actualTransformStages": {
            "type": "array",
            "minItems": 0,
            "items": {
              "enum": [
                "original-input-read",
                "chrome-html-gather",
                "preprocess",
                "flattenhtml",
                "configured-css-minifier",
                "gzip-compress",
                "brotli-compress",
                "literal-payload"
              ]
            }
          },
          "expectedTransformedArtifact": {
            "$ref": "#/$defs/reference"
          },
          "expectedTransformedSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "expectedTransformedSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedStoredArtifact": {
            "$ref": "#/$defs/reference"
          },
          "expectedStoredSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedStoredSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "sourceEqualsExpectedTransformed": {
            "type": "boolean"
          },
          "failures": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "passed": {
      "type": "boolean"
    },
    "originalImportInputClosureProof": {
      "$ref": "#/$defs/reference"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
