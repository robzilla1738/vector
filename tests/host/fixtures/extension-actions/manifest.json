{
  "manifest_version": 3,
  "name": "Aux extension fixture",
  "version": "1.0.0",
  "permissions": ["storage", "tabs", "contextMenus", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_title": "Aux extension fixture", "default_popup": "popup.html" },
  "commands": { "_execute_action": { "suggested_key": { "mac": "Command+Shift+Y", "default": "Ctrl+Shift+Y" } } },
  "side_panel": { "default_path": "panel.html" }
}
