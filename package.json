{
  "name": "aux-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aux \u2014 a local agent-first browser with one execution runtime shared by its native human interface and structured agent interfaces.",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/gen-runtime-schema.mjs && tsc -b tsconfig.json",
    "agent-api:docs": "pnpm --filter @aux/contracts build && node scripts/generate-agent-api-docs.mjs",
    "dev": "node scripts/dev.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "typecheck": "node scripts/gen-runtime-schema.mjs && tsc -b tsconfig.json && tsc -p apps/shell/tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:unit": "vitest run --project unit",
    "bench": "node tests/benchmarks/run.mjs",
    "bench:native": "node tests/benchmarks/native-browser.mjs",
    "bench:observation": "node tests/benchmarks/observation.mjs",
    "cli": "node packages/cli/dist/main.js",
    "bench:tasks": "node tests/benchmarks/tasks/run.mjs",
    "lint": "oxlint apps packages tests scripts",
    "contrast:check": "node scripts/check-glass-contrast.mjs",
    "smoke:native": "node scripts/dev.mjs --temp-profile",
    "format": "prettier --write apps packages scripts tests chromium/*.mjs *.json *.ts",
    "size": "node scripts/check-budgets.mjs bundle",
    "colors": "node scripts/check-raw-colors.mjs",
    "bridge:coverage": "node scripts/check-bridge-coverage.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:shell": "pnpm --filter @aux/shell dev"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "catalog:",
    "@types/pngjs": "6.0.5",
    "ai": "7.0.93",
    "exceljs": "4.4.0",
    "jsdom": "catalog:",
    "jszip": "3.10.1",
    "oxlint": "1.83.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "tar": "7.5.22",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
