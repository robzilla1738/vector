{
  "name": "vector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vector \u2014 a local agent-first browser. One execution runtime shared by a native human interface and structured agent interfaces.",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "VECTOR_ELECTRON=1 node scripts/dev.mjs",
    "dev:electron": "VECTOR_ELECTRON=1 node scripts/dev.mjs",
    "dev:native-engine": "node scripts/dev.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "typecheck": "tsc -b tsconfig.json --force",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit apps/desktop/renderer",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "smoke:packaged": "node tests/smoke/packaged.mjs",
    "bench": "node tests/benchmarks/run.mjs",
    "package": "node scripts/package-local.mjs",
    "package:local": "node scripts/package-local.mjs",
    "package:native-engine": "node scripts/package-native.mjs",
    "package:electron": "node scripts/package-local.mjs",
    "cli": "node packages/cli/dist/main.js",
    "bench:tasks": "node tests/benchmarks/tasks/run.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "jsdom": "26.1.0"
  }
}
