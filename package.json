{
  "name": "aux-browser",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Aux local browser, reusing the supplied implementation with Aux branding.",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "aux": "node scripts/aux.mjs",
    "package": "node scripts/package-aux.mjs",
    "smoke": "node scripts/daemon-smoke.mjs",
    "check": "pnpm test:provided && pnpm check:provided",
    "stage:provided": "node scripts/stage-provided.mjs",
    "assemble:provided": "node scripts/assemble-provided.mjs",
    "check:provided": "node scripts/check-provided.mjs",
    "test:provided": "node --test vendor/provided/*.test.mjs scripts/lib/provided-*.test.mjs scripts/lib/aux-mark.test.mjs",
    "check:independent": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm check:cleanroom && pnpm smoke",
    "check:cleanroom": "node scripts/check-cleanroom.mjs",
    "reference:index": "node scripts/reference-hashes.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check apps packages",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
