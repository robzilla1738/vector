{
  "name": "aux-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aux \u2014 a local agent-first browser with one execution runtime shared by its native human interface and structured agent interfaces.",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "agent-api:docs": "pnpm --filter @aux/contracts build && node scripts/generate-agent-api-docs.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:electron": "node scripts/dev.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "typecheck": "tsc -b tsconfig.json && tsc -p apps/desktop/tsconfig.renderer.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "smoke:packaged": "node tests/smoke/packaged.mjs",
    "smoke:release": "node tests/smoke/run-suite.mjs release",
    "smoke:all": "node tests/smoke/run-suite.mjs all",
    "bench": "node tests/benchmarks/run.mjs",
    "bench:observation": "node tests/benchmarks/observation.mjs",
    "budgets": "node scripts/check-budgets.mjs bundle",
    "package": "node scripts/package-local.mjs",
    "package:local": "node scripts/package-local.mjs",
    "package:signed": "node scripts/package-local.mjs --signed",
    "verify:package:signed": "node scripts/verify-signed-package.mjs",
    "cli": "node packages/cli/dist/main.js",
    "bench:tasks": "node tests/benchmarks/tasks/run.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "oxlint apps packages tests scripts --max-warnings=390",
    "format:check": "prettier --check apps/desktop/renderer/src/floating-sidebar.ts apps/desktop/renderer/src/floating-sidebar.test.ts apps/desktop/renderer/src/command-results.ts apps/desktop/renderer/src/command-results.test.ts apps/desktop/renderer/src/components/PageSurface.tsx apps/desktop/renderer/src/components/PageSurface.test.tsx apps/desktop/renderer/src/components/PageSurface.css apps/desktop/renderer/src/components/NativeDialog.tsx apps/desktop/renderer/src/components/NativeDialog.css apps/desktop/renderer/src/components/CommandBar.css apps/desktop/renderer/src/components/SpaceEditor.tsx apps/desktop/renderer/src/styles/space-grain.css",
    "smoke:design": "node tests/smoke/run-suite.mjs design",
    "host:compare": "node tests/host/compare.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "1.83.0",
    "prettier": "3.9.9",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
