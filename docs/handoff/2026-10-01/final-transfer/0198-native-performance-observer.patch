index 0000000..edfe888
--- /dev/null
+++ b/cc/trees/aux_performance_content_frame.cc
@@ -0,0 +1,71 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+#include "cc/trees/aux_performance_content_frame.h"
+#include <utility>
+#include "base/functional/bind.h"
+
+namespace aux {
+NativeContentFrameMeasurement::NativeContentFrameMeasurement(ScopeReader read_scope)
+    : read_scope_(std::move(read_scope)) {}
+NativeContentFrameMeasurement::~NativeContentFrameMeasurement() { Cancel(); }
+bool NativeContentFrameMeasurement::Stable() const {
+  return sample_ && !read_scope_.is_null() && read_scope_.Run() == sample_->scope;
+}
+bool NativeContentFrameMeasurement::Arm(base::TimeTicks input, Result result) {
+  if (sample_) { Refuse(ContentPresentationFailure::kOverlap); return false; }
+  if (read_scope_.is_null() || result.is_null() || input.is_null() || input <= last_input_ ||
+      input > base::TimeTicks::Now() || base::TimeTicks::Now() - input > base::Seconds(1) ||
+      !base::TimeTicks::IsConsistentAcrossProcesses()) return false;
+  const auto scope = read_scope_.Run();
+  if (!scope || scope->window_id <= 0 || scope->content_id <= 0 || scope->renderer_pid <= 0 ||
+      !scope->document_generation || !scope->frame_sink.is_valid()) return false;
+  sample_.emplace(); sample_->scope = *scope; sample_->input = input;
+  last_input_ = input; result_ = std::move(result);
+  timeout_.Start(FROM_HERE, base::Seconds(5),
+                 base::BindOnce(&NativeContentFrameMeasurement::Refuse, base::Unretained(this), ContentPresentationFailure::kTimeout));
+  return true;
+}
+bool NativeContentFrameMeasurement::MatchingMutation(base::TimeTicks mutation) {
+  if (!Stable() || mutation.is_null() || !sample_->mutation.is_null() ||
+      mutation < sample_->input || mutation > base::TimeTicks::Now()) { Refuse(ContentPresentationFailure::kMutation); return false; }
+  sample_->mutation = mutation; return true;
+}
+bool NativeContentFrameMeasurement::Submitted(NativePerformanceSwapPromise::Submission submission) {
+  if (!Stable() || sample_->mutation.is_null() || sample_->submission.frame_token ||
+      !submission.submitted_frame || !submission.activated || !submission.frame_token ||
+      submission.frame_token <= last_token_ || submission.commit < sample_->mutation ||
+      submission.submitted < submission.commit || submission.submitted > base::TimeTicks::Now()) {
+    Refuse(ContentPresentationFailure::kSubmission); return false;
+  }
+  sample_->submission = submission; last_token_ = submission.frame_token; return true;
+}
+void NativeContentFrameMeasurement::Presented(const viz::FrameSinkId& actual_sink,
+    uint32_t actual_token, const viz::FrameTimingDetails& actual_timing) {
+  if (!sample_ || !sample_->submission.frame_token || actual_sink != sample_->scope.frame_sink ||
+      actual_token != sample_->submission.frame_token) return;
+  sample_->timing = actual_timing;
+  const auto& actual_feedback = actual_timing.presentation_feedback;
+  if (!Stable() || actual_timing.received_compositor_frame_timestamp.is_null() ||
+      actual_timing.embedded_frame_timestamp.is_null() || actual_timing.draw_start_timestamp.is_null() ||
+      actual_timing.received_compositor_frame_timestamp < sample_->submission.commit ||
+      actual_timing.embedded_frame_timestamp < actual_timing.received_compositor_frame_timestamp ||
+      actual_timing.draw_start_timestamp < actual_timing.embedded_frame_timestamp ||
+      actual_feedback.timestamp < actual_timing.draw_start_timestamp || actual_feedback.failed() ||
+      !(actual_feedback.flags & gfx::PresentationFeedback::kHWCompletion) ||
+      actual_feedback.timestamp.is_null() || actual_feedback.timestamp < sample_->submission.submitted ||
+      actual_feedback.timestamp > base::TimeTicks::Now() ||
+      actual_feedback.timestamp - sample_->input > base::Seconds(5)) { Refuse(ContentPresentationFailure::kPresentation); return; }
+  sample_->measured = true;
+  timeout_.Stop();
+  auto sample = std::move(*sample_); sample_.reset();
+  std::move(result_).Run(std::move(sample));
+}
+void NativeContentFrameMeasurement::Refuse(ContentPresentationFailure reason) {
+  if (!sample_) return;
+  timeout_.Stop();
+  sample_->failure = reason;
+  auto sample = std::move(*sample_); sample_.reset();
+  if (!result_.is_null()) std::move(result_).Run(std::move(sample));
+}
+void NativeContentFrameMeasurement::Cancel() { Refuse(ContentPresentationFailure::kCancelled); }
+}  // namespace aux
