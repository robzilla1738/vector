new file mode 100644
index 0000000..51c20b5
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/native_command_results_witness.cc
@@ -0,0 +1,89 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+#include "third_party/blink/renderer/core/frame/native_command_results_witness.h"
+#include <cmath>
+#include "ui/gfx/geometry/rect_f.h"
+#include "third_party/blink/renderer/core/display_lock/display_lock_utilities.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/document_lifecycle.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/dom/static_node_list.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/style/computed_style.h"
+namespace blink {
+namespace {
+constexpr uint64_t kLargestSafeGeneration = 9007199254740991ULL;
+std::optional<uint64_t> Generation(Element& element, const char* attribute) {
+  const auto& value = element.getAttribute(AtomicString(attribute));
+  if (value.empty() || value.length() > 16) return std::nullopt;
+  uint64_t result = 0;
+  for (unsigned i = 0; i < value.length(); ++i) {
+    const auto c = value[i];
+    if (c < '0' || c > '9') return std::nullopt;
+    result = result * 10 + c - '0';
+    if (result > kLargestSafeGeneration) return std::nullopt;
+  }
+  if (value.length() > 1 && value[0] == '0') return std::nullopt;
+  return result;
+}
+bool Visible(Element& element) {
+  if (!element.isConnected() || !element.GetLayoutObject() ||
+      DisplayLockUtilities::IsDisplayLockedPreventingPaint(&element)) return false;
+  unsigned ancestors = 0;
+  for (auto* current = &element; current; current = current->parentElement()) {
+    if (++ancestors > 128 || current->hasAttribute(AtomicString("inert")) ||
+        current->getAttribute(AtomicString("aria-hidden")) == "true") return false;
+    const auto* style = current->GetComputedStyle();
+    if (!style || style->Visibility() != EVisibility::kVisible || style->Opacity() <= 0) return false;
+  }
+  const auto rect = element.GetBoundingClientRectNoLifecycleUpdate();
+  return std::isfinite(rect.x()) && std::isfinite(rect.y()) && std::isfinite(rect.width()) &&
+      std::isfinite(rect.height()) && rect.width() > 0 && rect.height() > 0;
+}
+Element* ExactlyOne(ContainerNode& parent, const char* fixed_selector) {
+  auto* items = parent.QuerySelectorAll(AtomicString(fixed_selector));
+  return items && items->length() == 1 ? items->item(0) : nullptr;
+}
+}  // namespace
+std::optional<NativeCommandResultsWitness> ReadNativeCommandResultsWitness(
+    Document& document, NativeCommandResultsSource actual_expected_source) {
+  // Reading must not trigger another lifecycle or paint unrelated future state.
+  if (!document.View() || document.Lifecycle().GetState() != DocumentLifecycle::kPaintClean) return std::nullopt;
+  auto* surface = ExactlyOne(document, "dialog.command-surface[open][data-command-surface-sequence]");
+  if (!surface || !Visible(*surface)) return std::nullopt;
+  auto* input = ExactlyOne(*surface, "input[role=combobox][data-command-value-generation]");
+  if (!input || document.FocusedElement() != input || !Visible(*input)) return std::nullopt;
+  const auto sequence = Generation(*surface, "data-command-surface-sequence");
+  const auto generation = Generation(*input, "data-command-value-generation");
+  if (!sequence || !*sequence || !generation) return std::nullopt;
+  NativeCommandResultsWitness result{document.Token(), *sequence, *generation};
+  auto* list = ExactlyOne(*surface, "[role=listbox]");
+  if (!list || !Visible(*list)) return result;
+  const char* source = actual_expected_source == NativeCommandResultsSource::kHistory ? "history" : "registry";
+  const auto results_generation = Generation(*list, "data-command-results-generation");
+  if (!results_generation || *results_generation != *generation ||
+      list->getAttribute(AtomicString("data-command-results-source")) != source) return result;
+  auto* rows = list->QuerySelectorAll(AtomicString("[role=option]"));
+  if (!rows || rows->length() > 256) return std::nullopt;
+  const gfx::RectF viewport(document.View()->GetLayoutSize());
+  const auto list_rect = list->GetBoundingClientRectNoLifecycleUpdate();
+  const auto surface_rect = surface->GetBoundingClientRectNoLifecycleUpdate();
+  for (unsigned i = 0; i < rows->length(); ++i) {
+    auto* row = rows->item(i);
+    const auto row_generation = Generation(*row, "data-command-result-generation");
+    if (!row_generation || *row_generation != *generation ||
+        row->getAttribute(AtomicString("data-command-result-source")) != source || !Visible(*row)) continue;
+    const auto rect = row->GetBoundingClientRectNoLifecycleUpdate();
+    if (viewport.Intersects(rect) && list_rect.Intersects(rect) && surface_rect.Intersects(rect))
+      ++result.visible_matching_rows;
+  }
+  if (result.visible_matching_rows) result.results_generation = *results_generation;
+  return result;
+}
+bool NativeCommandResultsMatchNextInput(const NativeCommandResultsWitness& baseline,
+    const NativeCommandResultsWitness& current) {
+  return baseline.document == current.document && baseline.surface_sequence == current.surface_sequence &&
+      baseline.value_generation < kLargestSafeGeneration && current.value_generation == baseline.value_generation + 1 &&
+      current.results_generation == current.value_generation && current.visible_matching_rows > 0;
+}
+}  // namespace blink
