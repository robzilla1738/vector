+namespace aux {
+enum class PerformanceInputKind { kKeyDown, kLeftMouseUp, kLeftMouseDragged };
+struct PerformanceInput {
+  PerformanceTarget target;
+  PerformanceInputKind kind;
+  base::TimeTicks event_ticks;
+  base::TimeTicks observed_ticks;
+  int source_pid = 0;
+};
+// Call only at the existing owned native window event-dispatch path. Never
+// observes other windows or reads key text/codes, URLs or session data.
