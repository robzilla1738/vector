@@ -0,0 +1,72 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+// Synthetic DOM contract tests; never native appearance/performance evidence.
+#include "third_party/blink/renderer/core/frame/native_command_results_witness.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/dom/focus_params.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+namespace blink {
+class NativeCommandResultsWitnessTest : public PageTestBase {
+ protected:
+  void Fixture(const char* source, const char* generation, const char* row_generation,
+               const char* row_style = "") {
+    String html = String("<dialog open class=command-surface data-command-surface-sequence=7>"
+                         "<input role=combobox data-command-value-generation=") + generation +
+        "><div role=listbox data-command-results-generation=" + generation +
+        " data-command-results-source=" + source +
+        "><div role=option data-command-result-generation=" + row_generation +
+        " data-command-result-source=" + source + " style='" + row_style +
+        "'>Synthetic row</div></div></dialog>";
+    SetBodyInnerHTML(html);
+    auto* input = GetDocument().QuerySelector(AtomicString("input"));
+    ASSERT_TRUE(input);
+    ASSERT_TRUE(GetDocument().SetFocusedElement(input, FocusParams()));
+    UpdateAllLifecyclePhasesForTest();
+  }
+};
+TEST_F(NativeCommandResultsWitnessTest, ActualCurrentGenerationAndVisibleSourceRequired) {
+  Fixture("history", "1", "1");
+  const auto baseline = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(baseline); ASSERT_GT(baseline->visible_matching_rows, 0U);
+  Fixture("history", "2", "1");
+  auto current = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(current); EXPECT_FALSE(NativeCommandResultsMatchNextInput(*baseline, *current));
+  Fixture("history", "2", "2");
+  current = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(current); EXPECT_TRUE(NativeCommandResultsMatchNextInput(*baseline, *current));
+}
+TEST_F(NativeCommandResultsWitnessTest, WrongProviderAndHiddenRowCannotCount) {
+  Fixture("registry", "2", "2");
+  auto result = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(result); EXPECT_EQ(result->visible_matching_rows, 0U);
+  Fixture("history", "2", "2", "opacity:0");
+  result = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(result); EXPECT_EQ(result->visible_matching_rows, 0U);
+}
+TEST_F(NativeCommandResultsWitnessTest, InputEchoAndABAOrSkippedGenerationCannotCount) {
+  Fixture("history", "1", "1");
+  const auto baseline = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(baseline);
+  Fixture("history", "1", "1");
+  auto current = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(current); EXPECT_FALSE(NativeCommandResultsMatchNextInput(*baseline, *current));
+  Fixture("history", "3", "3");
+  current = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(current); EXPECT_FALSE(NativeCommandResultsMatchNextInput(*baseline, *current));
+}
+TEST_F(NativeCommandResultsWitnessTest, ActualInitialZeroGenerationCanAdvanceToFirstInput) {
+  Fixture("history", "0", "0");
+  const auto baseline = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(baseline); EXPECT_EQ(baseline->value_generation, 0U);
+  Fixture("history", "1", "1");
+  const auto current = ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory);
+  ASSERT_TRUE(current); EXPECT_TRUE(NativeCommandResultsMatchNextInput(*baseline, *current));
+}
+TEST_F(NativeCommandResultsWitnessTest, UnknownAndNoncanonicalGenerationRefuse) {
+  Fixture("history", "NaN", "NaN");
+  EXPECT_FALSE(ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory));
+  Fixture("history", "02", "02");
+  EXPECT_FALSE(ReadNativeCommandResultsWitness(GetDocument(), NativeCommandResultsSource::kHistory));
+}
+}  // namespace blink
