+#include <utility>
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "cc/trees/layer_tree_host.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/renderer/platform/widget/widget_base.h"
+namespace blink {
+NativePerformanceWidgetMeasurement::NativePerformanceWidgetMeasurement(
+    WidgetBase* widget, aux::NativeContentFrameMeasurement::ScopeReader read_scope,
+    MutationMatcher mutation_matches)
+    : widget_(widget ? widget->GetWeakPtr() : base::WeakPtr<WidgetBase>()), read_scope_(std::move(read_scope)),
+      mutation_matches_(std::move(mutation_matches)), measurement_(read_scope_) {
+  if (!widget_) return;
+  widget_->SetPerformanceInputCallbackForTesting(base::BindRepeating(
+      &NativePerformanceWidgetMeasurement::Input, weak_factory_.GetWeakPtr()));
+  widget_->SetPerformanceLifecycleCallbackForTesting(base::BindRepeating(
+      &NativePerformanceWidgetMeasurement::Lifecycle, weak_factory_.GetWeakPtr()));
+  widget_->SetExactPresentationCallbackForTesting(base::BindRepeating(
+      &NativePerformanceWidgetMeasurement::Presented, weak_factory_.GetWeakPtr()));
+}
+NativePerformanceWidgetMeasurement::~NativePerformanceWidgetMeasurement() {
+  if (widget_) {
+    widget_->SetPerformanceInputCallbackForTesting({});
+    widget_->SetPerformanceLifecycleCallbackForTesting({});
+    widget_->SetExactPresentationCallbackForTesting({});
+  }
+  Cancel();
+}
+bool NativePerformanceWidgetMeasurement::Prepare(WebInputEvent::Type expected_input, Result result) {
+  if (!widget_ || !widget_->LayerTreeHost() || read_scope_.is_null() || !read_scope_.Run() ||
+      mutation_matches_.is_null() || mutation_matches_.Run() || result.is_null() || result_ ||
+      (expected_input != WebInputEvent::Type::kRawKeyDown && expected_input != WebInputEvent::Type::kMouseUp &&
+       expected_input != WebInputEvent::Type::kMouseMove)) return false;
+  prepared_scope_ = read_scope_.Run();
+  if (!prepared_scope_) return false;
+  expected_input_ = expected_input; result_ = std::move(result); awaiting_input_ = true;
+  input_timeout_.Start(FROM_HERE, base::Seconds(5), base::BindOnce(
+      &NativePerformanceWidgetMeasurement::Cancel, weak_factory_.GetWeakPtr()));
+  return true;
+}
+void NativePerformanceWidgetMeasurement::Input(const WebInputEvent& input) {
+  if (!awaiting_input_ || input.GetType() != expected_input_ ||
+      (input.GetModifiers() & WebInputEvent::kIsAutoRepeat)) return;
+  if (input.GetType() == WebInputEvent::Type::kMouseUp &&
+      static_cast<const WebMouseEvent&>(input).button != WebPointerProperties::Button::kLeft) return;
+  if (input.GetType() == WebInputEvent::Type::kMouseMove && !(input.GetModifiers() & WebInputEvent::kLeftButtonDown)) return;
+  if (read_scope_.is_null() || read_scope_.Run() != prepared_scope_) { Cancel(); return; }
+  awaiting_input_ = false; input_timeout_.Stop();
+  if (!measurement_.Arm(input.TimeStamp(), base::BindOnce(
+      &NativePerformanceWidgetMeasurement::Complete, weak_factory_.GetWeakPtr()))) { Cancel(); return; }
+  awaiting_mutation_ = true;
+}
+void NativePerformanceWidgetMeasurement::Lifecycle() {
+  if (!awaiting_mutation_) return;
+  if (!widget_ || !widget_->LayerTreeHost() || read_scope_.is_null() || !read_scope_.Run()) { Cancel(); return; }
+  if (!mutation_matches_.Run()) return;
+  awaiting_mutation_ = false;
+  if (!measurement_.MatchingMutation(base::TimeTicks::Now())) return;
+  widget_->LayerTreeHost()->QueueSwapPromise(std::make_unique<aux::NativePerformanceSwapPromise>(
+      base::SingleThreadTaskRunner::GetCurrentDefault(), base::BindOnce(
+          &NativePerformanceWidgetMeasurement::Submitted, weak_factory_.GetWeakPtr())));
+}
+void NativePerformanceWidgetMeasurement::Submitted(aux::NativePerformanceSwapPromise::Submission submission) {
+  measurement_.Submitted(std::move(submission));
+}
+void NativePerformanceWidgetMeasurement::Presented(uint32_t token, const viz::FrameTimingDetails& details) {
+  if (read_scope_.is_null()) { Cancel(); return; }
+  const auto scope = read_scope_.Run();
+  if (!scope) { Cancel(); return; }
+  // This callback is installed on the SAME actual native-granted WidgetBase.
+  // Browser verifies its own current widget/sink/document against this scope.
+  measurement_.Presented(scope->frame_sink, token, details);
+}
+void NativePerformanceWidgetMeasurement::Complete(aux::ContentPresentationSample sample) {
+  input_timeout_.Stop(); prepared_scope_.reset();
+  awaiting_input_ = false; awaiting_mutation_ = false; expected_input_ = WebInputEvent::Type::kUndefined;
+  if (result_) std::move(result_).Run(std::move(sample));
+}
+void NativePerformanceWidgetMeasurement::Cancel() {
+  awaiting_input_ = false; awaiting_mutation_ = false; expected_input_ = WebInputEvent::Type::kUndefined;
+  input_timeout_.Stop(); prepared_scope_.reset();
+  auto result = std::move(result_);
+  measurement_.Cancel();
+  if (result) {
+    aux::ContentPresentationSample sample; sample.failure = aux::ContentPresentationFailure::kCancelled;
+    std::move(result).Run(std::move(sample));
+  }
+}
+}  // namespace blink
