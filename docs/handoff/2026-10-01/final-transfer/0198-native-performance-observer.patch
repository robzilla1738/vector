+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_COMMAND_RESULTS_WITNESS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_COMMAND_RESULTS_WITNESS_H_
+#include <stdint.h>
+#include <optional>
+#include "third_party/blink/public/common/tokens/tokens.h"
+#include "third_party/blink/renderer/core/core_export.h"
+namespace blink {
+class Document;
+enum class NativeCommandResultsSource { kHistory, kRegistry };
+struct NativeCommandResultsWitness {
+  DocumentToken document;
+  uint64_t surface_sequence = 0;
+  uint64_t value_generation = 0;
+  uint64_t results_generation = 0;
+  unsigned visible_matching_rows = 0;
+};
+// Fixed read-only native DOM witness. No query/row text, URL, script, selector or
+// caller-provided state. Only the browser-owned current Aux widget may call it.
+// The private owner grant and native input pairing are separate requirements.
+CORE_EXPORT std::optional<NativeCommandResultsWitness> ReadNativeCommandResultsWitness(
+    Document& document, NativeCommandResultsSource actual_expected_source);
+CORE_EXPORT bool NativeCommandResultsMatchNextInput(const NativeCommandResultsWitness& baseline,
+    const NativeCommandResultsWitness& current);
+}  // namespace blink
+#endif
