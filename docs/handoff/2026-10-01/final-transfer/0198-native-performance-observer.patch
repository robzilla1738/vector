@@ -0,0 +1,65 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_PERFORMANCE_OBSERVER_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_PERFORMANCE_OBSERVER_H_
+
+#include <optional>
+#include <stdint.h>
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "ui/compositor/compositor_observer.h"
+
+namespace content { class WebContents; }
+namespace aux {
+// These are native-owned identities, never inputs to a public method or renderer RPC.
+struct PerformanceTarget {
+  int window_id = 0;
+  int content_id = 0;
+  int process_id = 0;
+  uint64_t document_generation = 0;
+  bool operator==(const PerformanceTarget&) const = default;
+};
+enum class PresentationMetric { kCommandResults, kSplitDrop, kClaim,
+                                kLittleWindow, kPictureInPicture, kTabSwitch };
+bool NativePerformanceObservationEnabled();
+std::optional<base::TimeDelta> ValidatedPresentationInterval(
+    base::TimeTicks input, base::TimeTicks matched, base::TimeTicks now,
+    const gfx::PresentationFeedback& feedback);
+
+// Emits only after a native mutation hook proves its contents are included in
+// this exact root compositor frame. Merely requesting the next frame cannot
+// satisfy this recorder. Ownership/lifetime revalidation is supplied by the host.
+class NativePresentationObserver final : public ui::CompositorObserver {
+ public:
+  using TargetReader = base::RepeatingCallback<std::optional<PerformanceTarget>()>;
+  NativePresentationObserver(ui::Compositor* compositor, TargetReader read_target);
+  ~NativePresentationObserver() override;
+  bool Arm(PresentationMetric metric, base::TimeTicks native_input);
+  bool MatchSubmittedFrame(uint32_t root_frame_token,
+                           const PerformanceTarget& target);
+  void Cancel();
+  void OnDidPresentCompositorFrame(ui::Compositor* compositor, uint32_t token,
+                                  const gfx::PresentationFeedback& feedback) override;
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override;
+ private:
+  void Refuse(const char* reason);
+  raw_ptr<ui::Compositor> compositor_;
+  TargetReader read_target_;
+  std::optional<PerformanceTarget> target_;
+  PresentationMetric metric_ = PresentationMetric::kCommandResults;
+  base::TimeTicks input_;
+  base::TimeTicks matched_;
+  base::TimeTicks last_input_;
+  uint32_t token_ = 0;
+  uint32_t last_token_ = 0;
+  base::OneShotTimer timeout_;
+};
+// Fixed current authorized shell only; returns no data for foreign, changing or
+// unobservable process/document. Raw RSS and footprint are distinct definitions.
+std::optional<base::DictValue> MeasureCurrentShellMemory(
+    content::WebContents* shell, NativePresentationObserver::TargetReader read_target);
+}  // namespace aux
+#endif
