+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_WIDGET_COMPOSITING_NATIVE_PERFORMANCE_WIDGET_MEASUREMENT_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_WIDGET_COMPOSITING_NATIVE_PERFORMANCE_WIDGET_MEASUREMENT_H_
+#include <optional>
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "cc/trees/aux_performance_content_frame.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+namespace blink {
+class WidgetBase;
+// Native internal owner only. Installation requires the parent-owned private
+// fixture capability/current widget/document/sink chain; no JS/public receiver.
+// MutationMatcher must read the fixed ACTUAL product generation after lifecycle,
+// including provider completion. An input echo/next frame is not a match.
+class PLATFORM_EXPORT NativePerformanceWidgetMeasurement {
+ public:
+  using MutationMatcher = base::RepeatingCallback<bool()>;
+  using Result = aux::NativeContentFrameMeasurement::Result;
+  NativePerformanceWidgetMeasurement(WidgetBase* widget,
+      aux::NativeContentFrameMeasurement::ScopeReader read_scope,
+      MutationMatcher mutation_matches);
+  ~NativePerformanceWidgetMeasurement();
+  bool Prepare(WebInputEvent::Type expected_input, Result result);
+  void Cancel();
+ private:
+  void Input(const WebInputEvent& input);
+  void Lifecycle();
+  void Submitted(aux::NativePerformanceSwapPromise::Submission submission);
+  void Presented(uint32_t token, const viz::FrameTimingDetails& details);
+  void Complete(aux::ContentPresentationSample sample);
+  base::WeakPtr<WidgetBase> widget_;
+  aux::NativeContentFrameMeasurement::ScopeReader read_scope_;
+  MutationMatcher mutation_matches_;
+  aux::NativeContentFrameMeasurement measurement_;
+  WebInputEvent::Type expected_input_ = WebInputEvent::Type::kUndefined;
+  Result result_;
+  std::optional<aux::ContentPerformanceScope> prepared_scope_;
+  base::OneShotTimer input_timeout_;
+  bool awaiting_input_ = false;
+  bool awaiting_mutation_ = false;
+  base::WeakPtrFactory<NativePerformanceWidgetMeasurement> weak_factory_{this};
+};
+}  // namespace blink
+#endif
