+void RenderWidgetHostImpl::MeasureNativeCommandPresentationForTesting(
+    blink::mojom::NativeCommandPresentationScopePtr scope,
+    mojo::PendingRemote<blink::mojom::NativeCommandPresentationReadiness> readiness,
+    base::OnceCallback<void(blink::mojom::NativeCommandPresentationResultPtr)>
+        callback) {
+  auto reply = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(callback), blink::mojom::NativeCommandPresentationResultPtr());
+  if (!scope || !readiness.is_valid() || !blink_frame_widget_ || !GetProcess() ||
+      !GetProcess()->GetProcess().IsValid() ||
+      scope->frame_sink != GetFrameSinkId() ||
+      scope->renderer_pid != GetProcess()->GetProcess().Pid())
+    return;
+  if (!widget_compositor_) {
+    blink_frame_widget_->BindWidgetCompositor(
+        widget_compositor_.BindNewPipeAndPassReceiver(
+            GetUIThreadTaskRunner({BrowserTaskType::kUserInput})));
+  }
+  auto expected = scope->Clone();
+  widget_compositor_->MeasureNativeCommandPresentation(std::move(scope), std::move(readiness),
+      base::BindOnce(
+          [](base::WeakPtr<RenderWidgetHostImpl> self,
+             blink::mojom::NativeCommandPresentationScopePtr expected,
+             base::OnceCallback<void(
+                 blink::mojom::NativeCommandPresentationResultPtr)> reply,
+             blink::mojom::NativeCommandPresentationResultPtr result) {
+            if (!self || !self->GetProcess() ||
+                !self->GetProcess()->GetProcess().IsValid() ||
+                expected->renderer_pid != self->GetProcess()->GetProcess().Pid() ||
+                expected->frame_sink != self->GetFrameSinkId() ||
+                !result || !result->scope ||
+                result->scope->window_id != expected->window_id ||
+                result->scope->content_id != expected->content_id ||
+                result->scope->renderer_pid != expected->renderer_pid ||
+                result->scope->document_generation != expected->document_generation ||
+                result->scope->document != expected->document ||
+                result->scope->frame_sink != expected->frame_sink ||
+                (expected->source == blink::mojom::NativeCommandPresentationSource::kObserveCurrent
+                    ? (result->scope->source != blink::mojom::NativeCommandPresentationSource::kHistory &&
+                       result->scope->source != blink::mojom::NativeCommandPresentationSource::kRegistry)
+                    : result->scope->source != expected->source)) {
+              std::move(reply).Run(nullptr);
+              return;
+            }
+            std::move(reply).Run(std::move(result));
+          }, weak_factory_.GetWeakPtr(), std::move(expected), std::move(reply)));
+}
