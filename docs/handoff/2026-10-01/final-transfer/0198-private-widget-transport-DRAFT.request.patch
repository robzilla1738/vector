+void WebFrameWidgetImpl::MeasureNativeCommandPresentation(
+    mojom::blink::NativeCommandPresentationScopePtr scope,
+    base::OnceCallback<void(mojom::blink::NativeCommandPresentationScopePtr)> prepared_callback, NativeCommandPresentationCallback callback) {
+  auto refuse = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(callback), mojom::blink::NativeCommandPresentationResultPtr());
+  if (!scope || !widget_base_ || !local_root_ || !ForTopMostMainFrame() ||
+      !local_root_->GetFrame() || !local_root_->GetFrame()->GetDocument() ||
+      scope->window_id <= 0 || scope->content_id <= 0 ||
+      scope->renderer_pid != base::GetCurrentProcId() ||
+      scope->document_generation == 0 ||
+      (scope->source != mojom::blink::NativeCommandPresentationSource::kHistory &&
+       scope->source != mojom::blink::NativeCommandPresentationSource::kRegistry &&
+       scope->source != mojom::blink::NativeCommandPresentationSource::kObserveCurrent) ||
+      !scope->frame_sink.is_valid() ||
+      scope->frame_sink != frame_sink_id_ || widget_base_->WillBeDestroyed())
+    return;
+  Document* document = local_root_->GetFrame()->GetDocument();
+  if (document->Url().Protocol() != "chrome" ||
+      document->Url().Host() != "aux" || document->Token() != scope->document)
+    return;
+  if (scope->source == mojom::blink::NativeCommandPresentationSource::kObserveCurrent) {
+    if (document->Lifecycle().GetState() != DocumentLifecycle::kPaintClean)
+      return;
+    auto* surfaces = document->QuerySelectorAll(AtomicString(
+        "dialog.command-surface[open][data-command-surface-sequence]"));
+    if (!surfaces || surfaces->length() != 1)
+      return;
+    const auto mode = surfaces->item(0)->getAttribute(AtomicString("data-mode"));
+    if (mode == "command")
+      scope->source = mojom::blink::NativeCommandPresentationSource::kRegistry;
+    else if (mode == "new-tab" || mode == "edit")
+      scope->source = mojom::blink::NativeCommandPresentationSource::kHistory;
+    else
+      return;
+  }
+  // Never replace an armed request. Completed instances may be released.
+  if (native_command_measurement_pending_)
+    return;
+  native_command_measurement_.reset();
+  const auto source = scope->source ==
+      mojom::blink::NativeCommandPresentationSource::kHistory
+      ? NativeCommandResultsSource::kHistory
+      : NativeCommandResultsSource::kRegistry;
+  auto baseline = ReadNativeCommandResultsWitness(*document, source);
+  if (!baseline)
+    return;
+  const aux::ContentPerformanceScope actual_scope{
+      scope->window_id, scope->content_id, scope->renderer_pid,
+      scope->document_generation, scope->frame_sink};
+  auto read_scope = base::BindRepeating(
+      [](WeakPersistent<WebFrameWidgetImpl> self, DocumentToken token,
+         aux::ContentPerformanceScope actual)
+          -> std::optional<aux::ContentPerformanceScope> {
+        if (!self || !self->widget_base_ || self->widget_base_->WillBeDestroyed() ||
+            self->frame_sink_id_ != actual.frame_sink || !self->local_root_ ||
+            !self->local_root_->GetFrame())
+          return std::nullopt;
+        Document* current = self->local_root_->GetFrame()->GetDocument();
+        if (!current || current->Token() != token ||
+            current->Url().Protocol() != "chrome" ||
+            current->Url().Host() != "aux")
+          return std::nullopt;
+        return actual;
+      }, WrapWeakPersistent(this), document->Token(), actual_scope);
+  auto matches = base::BindRepeating(
+      [](WeakPersistent<WebFrameWidgetImpl> self,
+         NativeCommandResultsWitness before, NativeCommandResultsSource source) {
+        if (!self || !self->local_root_ || !self->local_root_->GetFrame())
+          return false;
+        Document* current = self->local_root_->GetFrame()->GetDocument();
+        if (!current || current->Token() != before.document)
+          return false;
+        auto witness = ReadNativeCommandResultsWitness(*current, source);
+        return witness && NativeCommandResultsMatchNextInput(before, *witness);
+      }, WrapWeakPersistent(this), *baseline, source);
+  native_command_measurement_ =
+      std::make_unique<NativePerformanceWidgetMeasurement>(widget_base_.get(),
+          std::move(read_scope), std::move(matches));
+  auto ready_scope = scope->Clone();
+  native_command_measurement_pending_ = true;
+  const bool prepared = native_command_measurement_->Prepare(WebInputEvent::Type::kRawKeyDown,
+      base::BindOnce(
+          [](WeakPersistent<WebFrameWidgetImpl> self,
+             mojom::blink::NativeCommandPresentationScopePtr scope,
+             NativeCommandPresentationCallback callback,
+             aux::ContentPresentationSample sample) {
+            if (self)
+              self->native_command_measurement_pending_ = false;
+            if (sample.measured && (!self || !self->widget_base_ ||
+                self->widget_base_->WillBeDestroyed() || !self->local_root_ ||
+                !self->local_root_->GetFrame() ||
+                !self->local_root_->GetFrame()->GetDocument() ||
+                self->local_root_->GetFrame()->GetDocument()->Token() != scope->document ||
+                self->frame_sink_id_ != scope->frame_sink)) {
+              sample.measured = false;
+              sample.failure = aux::ContentPresentationFailure::kCancelled;
+            }
+            auto result = mojom::blink::NativeCommandPresentationResult::New();
+            result->scope = std::move(scope);
+            result->measured = sample.measured;
+            result->failure = static_cast<int>(sample.failure);
+            result->input = sample.input;
+            result->mutation = sample.mutation;
+            result->commit = sample.submission.commit;
+            result->submitted = sample.submission.submitted;
+            result->frame_token = sample.submission.frame_token;
+            result->activated = sample.submission.activated;
+            result->submitted_frame = sample.submission.submitted_frame;
+            result->submission_failure = sample.submission.failure_reason;
+            result->timing = sample.timing;
+            // Native browser consumer rechecks live scope and native HID pair.
+            // Do not destroy the owning measurement from inside its callback.
+            std::move(callback).Run(std::move(result));
+          }, WrapWeakPersistent(this), std::move(scope), std::move(refuse)));
+  if (!prepared)
+    native_command_measurement_pending_ = false;
+  else if (prepared_callback)
+    std::move(prepared_callback).Run(std::move(ready_scope));
+}
