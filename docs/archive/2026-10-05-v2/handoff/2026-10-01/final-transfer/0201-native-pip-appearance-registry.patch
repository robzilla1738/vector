new file mode 100644
index 0000000..923d1a7
--- /dev/null
+++ b/chrome/browser/ui/aux/native_pip_appearance_registry.cc
@@ -0,0 +1,141 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+#include "chrome/browser/ui/aux/native_pip_appearance_registry.h"
+#include <utility>
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/buildflags.h"
+#include "chrome/browser/ui/aux/journey_fixture_path.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/views/overlay/video_overlay_window_views.h"
+#include "chrome/browser/ui/views/picture_in_picture/document_pip_host.h"
+#include "content/public/browser/picture_in_picture_window_controller.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/views/widget/widget.h"
+
+namespace aux {
+bool NativePipAppearanceObservationEnabled() {
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+  return NativeAppearanceObservationEnabled();
+#else
+  return false;
+#endif
+}
+namespace {
+bool ValidOwner(const NativePipOwner& owner, NativePipSurfaceKind kind) {
+  if (!NativePipAppearanceObservationEnabled() || !owner.profile || !owner.opener ||
+      !owner.controller || owner.opener->IsBeingDestroyed() ||
+      owner.opener->GetBrowserContext() != owner.profile ||
+      owner.controller->GetWebContents() != owner.opener) return false;
+  const auto selected = base::FilePath(base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("user-data-dir"));
+  if (owner.profile->GetPath().DirName() != selected) return false;
+  auto* opener = owner.opener->GetPrimaryMainFrame();
+  if (!opener || !opener->IsRenderFrameLive() || opener->IsErrorDocument()) return false;
+  if (kind == NativePipSurfaceKind::kVideo)
+    return !owner.child && !owner.controller->GetChildWebContents();
+  if (!owner.child || owner.child->IsBeingDestroyed() ||
+      owner.child->GetBrowserContext() != owner.profile ||
+      owner.controller->GetChildWebContents() != owner.child) return false;
+  auto* child = owner.child->GetPrimaryMainFrame();
+  return child && child->IsRenderFrameLive() && !child->IsErrorDocument();
+}
+}  // namespace
+NativePipAppearanceRegistry::NativePipAppearanceRegistry() = default;
+NativePipAppearanceRegistry::~NativePipAppearanceRegistry() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  while (!entries_.empty()) Unregister(entries_.begin()->first);
+}
+bool NativePipAppearanceRegistry::RegisterVideo(VideoOverlayWindowViews* window, ControllerReader read_current) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!window || read_current.is_null()) return false;
+  const auto weak = window->GetWeakPtr();
+  return Register(window, NativePipSurfaceKind::kVideo,
+      base::BindRepeating([](base::WeakPtr<views::Widget> weak, VideoOverlayWindowViews* window, ControllerReader read_current) -> std::optional<NativePipOwner> {
+        if (!weak || weak.get() != window) return std::nullopt;
+        auto* controller = window->GetController();
+        if (!controller || read_current.Run() != controller) return std::nullopt;
+        auto* opener = controller->GetWebContents();
+        if (!opener || opener->IsBeingDestroyed()) return std::nullopt;
+        return NativePipOwner{Profile::FromBrowserContext(opener->GetBrowserContext()),
+                              opener, controller->GetChildWebContents(), controller};
+      }, weak, base::Unretained(window), std::move(read_current)));
+}
+bool NativePipAppearanceRegistry::RegisterDocumentHost(DocumentPipHost* host,
+                                                       ControllerReader read_current) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!host || read_current.is_null()) return false;
+  const auto weak = host->GetWeakPtr();
+  return Register(host->GetWidget(), NativePipSurfaceKind::kDocument,
+      base::BindRepeating([](base::WeakPtr<DocumentPipHost> weak, ControllerReader read_current) -> std::optional<NativePipOwner> {
+        if (!weak) return std::nullopt;
+        auto* controller = read_current.Run();
+        if (!controller) return std::nullopt;
+        return NativePipOwner{weak->GetProfile(), weak->GetOpenerWebContents(),
+                              weak->GetChildWebContents(), controller};
+      }, weak, std::move(read_current)));
+}
+bool NativePipAppearanceRegistry::RegisterBrowserDocument(BrowserWindowInterface* browser,
+    views::Widget* widget, OwnerReader read_current) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!browser || !widget || browser->GetType() != BrowserWindowInterface::TYPE_PICTURE_IN_PICTURE ||
+      !browser->GetWindow() || browser->GetWindow()->GetNativeWindow() != widget->GetNativeWindow()) return false;
+  return Register(widget, NativePipSurfaceKind::kDocument, std::move(read_current));
+}
+bool NativePipAppearanceRegistry::Register(views::Widget* widget,
+    NativePipSurfaceKind kind, OwnerReader read_current) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!NativePipAppearanceObservationEnabled() || !widget || !widget->IsVisible() ||
+      read_current.is_null() || entries_.contains(widget) || entries_.size() >= 8) return false;
+  const auto owner = read_current.Run();
+  if (!owner || !ValidOwner(*owner, kind)) return false;
+  Entry entry{kind, widget->GetWeakPtr(), *owner,
+      owner->opener->GetPrimaryMainFrame()->GetWeakDocumentPtr(),
+      owner->child ? owner->child->GetPrimaryMainFrame()->GetWeakDocumentPtr() : content::WeakDocumentPtr(),
+      std::move(read_current)};
+  entries_.emplace(widget, std::move(entry)); widget->AddObserver(this); return true;
+}
+void NativePipAppearanceRegistry::Unregister(views::Widget* widget) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto found = entries_.find(widget);
+  if (found == entries_.end()) return;
+  if (found->second.widget) widget->RemoveObserver(this);
+  entries_.erase(found);
+}
+bool NativePipAppearanceRegistry::Stable(const Entry& entry) const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!NativePipAppearanceObservationEnabled() || !entry.widget || !entry.widget->IsVisible()) return false;
+  auto* opener = entry.opener_document.AsRenderFrameHostIfValid();
+  if (!opener || content::WebContents::FromRenderFrameHost(opener) != entry.owner.opener) return false;
+  if (entry.owner.child) {
+    auto* child = entry.child_document.AsRenderFrameHostIfValid();
+    if (!child || content::WebContents::FromRenderFrameHost(child) != entry.owner.child) return false;
+  }
+  const auto current = entry.read_current.Run();
+  return current == entry.owner && ValidOwner(*current, entry.kind);
+}
+std::optional<base::DictValue> NativePipAppearanceRegistry::SnapshotFor(
+    Profile* current_profile, OpenerMatcher owns_opener) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!NativePipAppearanceObservationEnabled() || !current_profile || owns_opener.is_null()) return std::nullopt;
+  Entry* selected = nullptr;
+  for (auto it = entries_.begin(); it != entries_.end();) {
+    auto& entry = it->second;
+    if (!Stable(entry)) { auto* widget = it->first; ++it; Unregister(widget); continue; }
+    ++it;
+    if (entry.owner.profile != current_profile || !owns_opener.Run(entry.owner.opener)) continue;
+    if (selected) return std::nullopt;
+    selected = &entry;
+  }
+  if (!selected) return std::nullopt;
+  auto result = ReadNativePipWindowAppearance(selected->widget.get(), selected->kind);
+  if (!result || !Stable(*selected) || !owns_opener.Run(selected->owner.opener)) return std::nullopt;
+  return result;
+}
+void NativePipAppearanceRegistry::OnWidgetVisibilityChanged(views::Widget* widget, bool visible) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!visible) Unregister(widget);
+}
+void NativePipAppearanceRegistry::OnWidgetDestroying(views::Widget* widget) { Unregister(widget); }
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/native_pip_appearance_registry.h b/chrome/browser/ui/aux/native_pip_appearance_registry.h
new file mode 100644
index 0000000..8d58658
--- /dev/null
+++ b/chrome/browser/ui/aux/native_pip_appearance_registry.h
@@ -0,0 +1,67 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_PIP_APPEARANCE_REGISTRY_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_PIP_APPEARANCE_REGISTRY_H_
+#include <map>
+#include <optional>
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "base/sequence_checker.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "ui/views/widget/widget_observer.h"
+class Profile;
+class BrowserWindowInterface;
+class DocumentPipHost;
+class VideoOverlayWindowViews;
+namespace content { class WebContents; class PictureInPictureWindowController; }
+namespace aux {
+bool NativePipAppearanceObservationEnabled();
+enum class NativePipSurfaceKind { kVideo, kDocument };
+struct NativePipOwner {
+  Profile* profile = nullptr;
+  content::WebContents* opener = nullptr;
+  content::WebContents* child = nullptr;
+  content::PictureInPictureWindowController* controller = nullptr;
+  bool operator==(const NativePipOwner&) const = default;
+};
+// Actual lifetime-owned widget/controller registration; never a title, requested
+// PID/window ID, caller label or bounds lookup. Hooks are MAC/test-fixture only.
+class NativePipAppearanceRegistry final : public views::WidgetObserver {
+ public:
+  using OwnerReader = base::RepeatingCallback<std::optional<NativePipOwner>()>;
+  using ControllerReader = base::RepeatingCallback<content::PictureInPictureWindowController*()>;
+  using OpenerMatcher = base::RepeatingCallback<bool(content::WebContents*)>;
+  NativePipAppearanceRegistry();
+  ~NativePipAppearanceRegistry() override;
+  bool RegisterVideo(VideoOverlayWindowViews* window, ControllerReader read_current);
+  bool RegisterDocumentHost(DocumentPipHost* host, ControllerReader read_current);
+  bool RegisterBrowserDocument(BrowserWindowInterface* browser, views::Widget* widget,
+                               OwnerReader read_current);
+  void Unregister(views::Widget* widget);
+  // Authorized zero-argument Aux host supplies its ACTUAL current Profile and
+  // native owner-tab matcher internally. Ambiguity/unknown/foreign is refused.
+  std::optional<base::DictValue> SnapshotFor(Profile* current_profile, OpenerMatcher owns_opener);
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+ private:
+  struct Entry {
+    NativePipSurfaceKind kind;
+    base::WeakPtr<views::Widget> widget;
+    NativePipOwner owner;
+    content::WeakDocumentPtr opener_document;
+    content::WeakDocumentPtr child_document;
+    OwnerReader read_current;
+  };
+  bool Register(views::Widget* widget, NativePipSurfaceKind kind, OwnerReader read_current);
+  bool Stable(const Entry& entry) const;
+  std::map<views::Widget*, Entry> entries_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+// Real current child's NSWindow/theme/ColorProvider/material/frame only. No Aux
+// WebUI theme/material is copied. Missing remote NSWindow yields no snapshot.
+std::optional<base::DictValue> ReadNativePipWindowAppearance(
+    views::Widget* widget, NativePipSurfaceKind kind);
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/aux/native_pip_appearance_registry_unittest.cc b/chrome/browser/ui/aux/native_pip_appearance_registry_unittest.cc
new file mode 100644
index 0000000..4e06149
--- /dev/null
+++ b/chrome/browser/ui/aux/native_pip_appearance_registry_unittest.cc
@@ -0,0 +1,24 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+// Authority/refusal tests only; not native visual qualification evidence.
+#include "chrome/browser/ui/aux/native_pip_appearance_registry.h"
+#include "base/test/scoped_command_line.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux {
+TEST(NativePipAppearanceRegistry, ExplicitSwitchCannotGrantForeignProfile) {
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitch("aux-native-appearance-observer");
+  command.GetProcessCommandLine()->AppendSwitchASCII("user-data-dir", "/tmp/foreign-pip-fixture/profile");
+  EXPECT_FALSE(NativePipAppearanceObservationEnabled());
+  NativePipAppearanceRegistry registry;
+  EXPECT_FALSE(registry.SnapshotFor(nullptr, {}));
+}
+TEST(NativePipAppearanceRegistry, MissingActualWidgetNeverProducesSnapshot) {
+  NativePipAppearanceRegistry registry;
+  EXPECT_FALSE(registry.RegisterVideo(nullptr, {}));
+  EXPECT_FALSE(registry.RegisterDocumentHost(nullptr, {}));
+  EXPECT_FALSE(registry.RegisterBrowserDocument(nullptr, nullptr, {}));
+  EXPECT_FALSE(ReadNativePipWindowAppearance(nullptr, NativePipSurfaceKind::kVideo));
+  EXPECT_FALSE(ReadNativePipWindowAppearance(nullptr, NativePipSurfaceKind::kDocument));
+}
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/native_pip_window_appearance_mac.mm b/chrome/browser/ui/aux/native_pip_window_appearance_mac.mm
new file mode 100644
index 0000000..c8062ce
--- /dev/null
+++ b/chrome/browser/ui/aux/native_pip_window_appearance_mac.mm
@@ -0,0 +1,105 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license in the LICENSE file.
+#include "chrome/browser/ui/aux/native_pip_appearance_registry.h"
+#import <Cocoa/Cocoa.h>
+#include <cmath>
+#include <limits>
+#include "base/process/process_handle.h"
+#include "base/time/time.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/views/widget/widget.h"
+
+namespace aux {
+namespace {
+struct OwnedWindow {
+  CGRect frame;
+  int layer;
+};
+std::optional<OwnedWindow> ReadOwnedWindow(CGWindowID id) {
+  CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionIncludingWindow, id);
+  if (!list) return std::nullopt;
+  std::optional<OwnedWindow> result;
+  if (CFArrayGetCount(list) == 1) {
+    NSDictionary* info = (__bridge NSDictionary*)CFArrayGetValueAtIndex(list, 0);
+    CGRect frame;
+    NSNumber* native_layer = info[(__bridge NSString*)kCGWindowLayer];
+    NSDictionary* native_bounds = info[(__bridge NSString*)kCGWindowBounds];
+    const auto layer = native_layer.longLongValue;
+    if ([native_layer isKindOfClass:[NSNumber class]] && [native_bounds isKindOfClass:[NSDictionary class]] &&[info[(__bridge NSString*)kCGWindowOwnerPID] intValue] == base::GetCurrentProcId() &&
+        [info[(__bridge NSString*)kCGWindowNumber] unsignedIntValue] == id &&
+        layer >= 0 && layer <= std::numeric_limits<int>::max() &&
+        CGRectMakeWithDictionaryRepresentation((__bridge CFDictionaryRef)
+            native_bounds, &frame) &&
+        std::isfinite(frame.origin.x) && std::isfinite(frame.origin.y) &&
+        std::isfinite(frame.size.width) && std::isfinite(frame.size.height) &&
+        frame.size.width > 0 && frame.size.height > 0) result = OwnedWindow{frame, static_cast<int>(layer)};
+  }
+  CFRelease(list); return result;
+}
+}  // namespace
+std::optional<base::DictValue> ReadNativePipWindowAppearance(
+    views::Widget* widget, NativePipSurfaceKind kind) {
+  if (!NativePipAppearanceObservationEnabled() || !widget || !widget->IsVisible()) return std::nullopt;
+  NSWindow* window = widget->GetNativeWindow().GetNativeNSWindow();
+  if (!window || !window.visible || window.windowNumber <= 0 ||
+      window.windowNumber > std::numeric_limits<int>::max()) return std::nullopt;
+  const CGWindowID id = static_cast<CGWindowID>(window.windowNumber);
+  const auto before = ReadOwnedWindow(id);
+  if (!before) return std::nullopt;
+  base::DictValue record, frame;
+  record.Set("producer", "aux-native-pip-appearance"); record.Set("version", 1);
+  record.Set("pid", base::GetCurrentProcId()); record.Set("windowId", static_cast<int>(id));
+  record.Set("surfaceKind", kind == NativePipSurfaceKind::kVideo ? "video-pip" : "document-pip");
+  record.Set("windowLayer", before->layer);
+  frame.Set("x", before->frame.origin.x); frame.Set("y", before->frame.origin.y);
+  frame.Set("width", before->frame.size.width); frame.Set("height", before->frame.size.height);
+  record.Set("frame", std::move(frame));
+  NSString* theme = [window.effectiveAppearance bestMatchFromAppearancesWithNames:
+      @[NSAppearanceNameAqua, NSAppearanceNameDarkAqua]];
+  const char* native_theme = [theme isEqualToString:NSAppearanceNameAqua] ? "light" :
+      [theme isEqualToString:NSAppearanceNameDarkAqua] ? "dark" : nullptr;
+  record.Set("nativeTheme", native_theme ? base::Value(native_theme) : base::Value());
+  const auto color_mode = widget->GetColorProviderKeyForTesting().color_mode;
+  record.Set("viewTheme", color_mode == ui::ColorProviderKey::ColorMode::kDark ? "dark" : "light");
+  // These Views overlays have no Aux WebUI DOM/material association. Read the
+  // child window honestly; parent theme/preferences cannot establish its policy.
+  record.Set("auxTheme", base::Value());
+  record.Set("windowOpaque", static_cast<bool>(window.opaque));
+  const char* backing = nullptr;
+  const char* material = nullptr;
+  NSView* candidate = nil;
+  unsigned effects = 0;
+  for (NSView* view in window.contentView.subviews) {
+    if (view.hidden || view.alphaValue <= 0 || !NSContainsRect(view.frame, window.contentView.bounds)) continue;
+    if ([view isKindOfClass:[NSVisualEffectView class]] ||
+        [view isKindOfClass:NSClassFromString(@"NSGlassEffectView")]) { ++effects; candidate = view; }
+  }
+  if (effects == 1) {
+    if ([candidate isKindOfClass:NSClassFromString(@"NSGlassEffectView")]) {
+      backing = "liquid-glass"; material = "liquid-glass";
+    } else if ([candidate isKindOfClass:[NSVisualEffectView class]]) {
+      backing = "visual-effect";
+      switch (((NSVisualEffectView*)candidate).material) {
+        case NSVisualEffectMaterialSidebar: material = "sidebar"; break;
+        case NSVisualEffectMaterialUnderWindowBackground: material = "under-window"; break;
+        case NSVisualEffectMaterialTitlebar: material = "titlebar"; break;
+        default: break;
+      }
+    }
+  }
+  record.Set("backing", backing ? base::Value(backing) : base::Value());
+  record.Set("material", material ? base::Value(material) : base::Value());
+  record.Set("nativeReduceTransparency", static_cast<bool>(NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceTransparency));
+  record.Set("nativeReduceMotion", static_cast<bool>(NSWorkspace.sharedWorkspace.accessibilityDisplayShouldReduceMotion));
+  const auto after = ReadOwnedWindow(id);
+  NSString* final_theme = [window.effectiveAppearance bestMatchFromAppearancesWithNames:
+      @[NSAppearanceNameAqua, NSAppearanceNameDarkAqua]];
+  if (!NativePipAppearanceObservationEnabled() || !widget->IsVisible() ||
+      widget->GetNativeWindow().GetNativeNSWindow() != window || !window.visible ||
+      !after || before->layer != after->layer || !CGRectEqualToRect(before->frame, after->frame) ||
+      !(theme == final_theme || [theme isEqualToString:final_theme]) ||
+      widget->GetColorProviderKeyForTesting().color_mode != color_mode) return std::nullopt;
+  record.Set("nativeUnixMs", base::Time::Now().InMillisecondsFSinceUnixEpoch());
+  return record;
+}
+}  // namespace aux
