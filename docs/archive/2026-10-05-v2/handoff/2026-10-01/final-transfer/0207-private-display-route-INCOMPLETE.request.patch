+void RootCompositorFrameSinkImpl::MeasureNativeGuestInclusion(
+    mojom::NativeGuestInclusionScopePtr scope, MeasureNativeGuestInclusionCallback result) {
+  if (!display_ || !scope || scope->guests.empty() || scope->guests.size() > 4 ||
+      scope->display_sink != display_->CurrentSurfaceId().frame_sink_id()) {
+    std::move(result).Run(nullptr); return;
+  }
+  NativeGuestInclusionScope actual{scope->display_sink, scope->shell_sink,
+      scope->mutation_shell_token, scope->input, scope->mutation, scope->shell_submission,
+      scope->guests};
+  display_->RequestNativeGuestInclusion(std::move(actual), base::BindOnce(
+      [](mojom::NativeGuestInclusionScopePtr scope,
+         MeasureNativeGuestInclusionCallback result, NativeGuestInclusionResult sample) {
+        auto wire = mojom::NativeGuestInclusionResult::New();
+        wire->measured = sample.measured; wire->scope = std::move(scope);
+        wire->display_surface = sample.display_surface;
+        for (const auto& guest : sample.drawn)
+          wire->drawn.push_back(mojom::NativeDrawnGuest::New(guest.surface, guest.token, guest.visible_bounds));
+        wire->draw = sample.draw; wire->swap = sample.swap; wire->feedback = sample.feedback;
+        wire->elapsed = sample.elapsed;
+        std::move(result).Run(std::move(wire));
+      }, std::move(scope), std::move(result)));
 }
 
