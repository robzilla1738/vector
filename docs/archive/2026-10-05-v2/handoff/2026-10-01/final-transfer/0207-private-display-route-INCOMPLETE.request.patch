+void Compositor::MeasureNativeGuestInclusion(
+    viz::mojom::NativeGuestInclusionScopePtr scope,
+    base::OnceCallback<void(viz::mojom::NativeGuestInclusionResultPtr)> result) {
+  if (result.is_null()) return;
+  if (!display_private_ || !scope || scope->display_sink != frame_sink_id_ ||
+      scope->guests.empty() || scope->guests.size() > 4) {
+    std::move(result).Run(nullptr); return;
+  }
+  display_private_->MeasureNativeGuestInclusion(std::move(scope), std::move(result));
