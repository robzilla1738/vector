+/** A real controller for fixtures with no installed native leases. Any browser permission refuses. */
+export function fixtureEmptyOvernightAuthority(repo: Repo): void {
+  const native = new NullNativeBridge();
+  const page = (id: string) => { const value = repo.getPage(id); if (!value) throw new AuxError("not_found", "No fixture native page"); return value; };
+  const approvals = new ApprovalStore(repo.db, () => {}, repo.columnCipher);
+  const egress = new BrowserEgress({ profileId: "fixture", native, run: () => null, page,
+    ownsPage: () => false, audit: () => {}, approve: async () => false });
+  const gate = new SafetyDispatchGate({ approvals, journal: new DecisionJournal(repo.db), managedRules: () => [], userRules: () => [],
+    localCeiling: () => "ask", audit: () => {} });
+  const controller = new NativePermissionController({ profileId: "fixture",
+    approvals, egress, gate, mentions: fixtureTurnMentions(page), page, run: id => repo.getRun(id),
+    requiresTurn: () => true,
+    sourceCheck: () => { throw new AuxError("backend_unavailable", "This fixture has no native source authority"); },
+    standingOnly: id => !!repo.getRun(id)?.config?.nightShiftItemId,
+    assertDispatch: id => checkNightShiftDispatch(repo, id), overnightAuthority: id => nightShiftEffectAuthority(repo, id),
+    retireReservation: input => native.permissionRetire(input),
+  });
+  installOvernightAuthority(repo, controller);
+}
