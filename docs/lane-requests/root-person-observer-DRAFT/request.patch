+            element.getAttribute("placeholder") || textOf(element, 120) || element.getAttribute("name") || "").slice(0, 120);
+        entries.push({ ref: `r${id}`, frame: "main", tag, name,
+            role: element.getAttribute("role") ?? (tag === "button" ? "button" : tag === "a" ? "link" : undefined),
+            rect: { x: Math.round(rect.x), y: Math.round(rect.y), w: Math.round(rect.width), h: Math.round(rect.height) },
+            selector: {},
+            ...(tag === "input" ? { type: element.getAttribute("type") ?? "text" } : {}),
+            ...(tag === "a" ? { href: safeUrl(element.getAttribute("href") ?? "") } : {}),
+        });
+    }
+    const formFields = entries.filter(entry => ["input", "select", "textarea"].includes(entry.tag))
+        .map(entry => ({ ref: entry.ref, label: entry.name, type: entry.type ?? entry.tag }));
+    const tables = elements.filter(element => element.tagName === "TABLE").slice(0, 6).map((table, index) => {
