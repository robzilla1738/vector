+// Read-only original bound process identity. This does not prove compilation,
+// create input or change focus; caller must independently retain artifacts.
+func warmWindowIdentity(_ request: [String: Any]) throws -> [String: Any] {
+  guard Set(request.keys).isSubset(of: Set(["id", "command"])),
+        request["command"] as? String == "warmWindowIdentity" else {
+    throw protocolError("Invalid fixed warm identity request")
+  }
+  try requireLiveTarget()
+  let target = try warmWindowKernelGeneration(pid)
+  let helper = try warmWindowKernelGeneration(getpid())
+  try requireLiveTarget()
+  guard try warmWindowKernelGeneration(pid) == target,
+        try warmWindowKernelGeneration(getpid()) == helper else {
+    throw protocolError("Warm identity original generation changed")
+  }
+  return ["producer": "aux-native-stock-warm-identity", "version": 1,
+          "targetPid": Int(pid), "helperPid": Int(getpid()),
+          "targetProcessUuid": target.imageUuid, "targetProcessStartMachTicks": String(target.startMachTicks),
+          "helperProcessUuid": helper.imageUuid, "helperProcessStartMachTicks": String(helper.startMachTicks)]
+}
