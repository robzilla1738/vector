diff --git a/chrome/browser/ui/aux/native_browser_memory_inventory.cc b/chrome/browser/ui/aux/native_browser_memory_inventory.cc
new file mode 100644
index 0000000..1761ec0
--- /dev/null
+++ b/chrome/browser/ui/aux/native_browser_memory_inventory.cc
@@ -0,0 +1,78 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_browser_memory_inventory.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <algorithm>
+#include "base/process/process_handle.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+#include "content/public/browser/browser_child_process_host_iterator.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/child_process_data.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/common/process_type.h"
+namespace aux {
+std::optional<NativeBrowserMemoryInventory> ReadNativeBrowserMemoryInventory(
+    base::WeakPtr<WebUIBrowserUI> ui) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const auto shell = ReadNativeGuestStageShellOwner(ui);
+  if (!shell || !ui || !ui->web_ui()) return std::nullopt;
+  auto* profile = Profile::FromWebUI(ui->web_ui());
+  if (!profile || profile->IsOffTheRecord()) return std::nullopt;
+  NativeBrowserMemoryInventory inventory;
+  inventory.shell = *shell;
+  const auto browser_pid = base::GetCurrentProcId();
+  if (browser_pid <= 0 || browser_pid == shell->shell_renderer_pid) return std::nullopt;
+  inventory.processes.emplace(browser_pid,
+      NativeMemoryProcessOwner{"browser", {}, content::PROCESS_TYPE_BROWSER, {}});
+  size_t host_count = 0;
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd(); it.Advance()) {
+    auto* host = it.GetCurrentValue();
+    if (!host || host->GetBrowserContext() != profile || !host->GetProcess().IsValid()) continue;
+    const auto pid = host->GetProcess().Pid();
+    const int id = host->GetID().value();
+    if (pid <= 0 || pid == browser_pid || id <= 0) return std::nullopt;
+    if (++host_count > 128 ||
+        (!inventory.processes.contains(pid) && inventory.processes.size() >= 32)) return std::nullopt;
+    const std::string role = pid == shell->shell_renderer_pid ? "shell" : "renderer";
+    auto position = inventory.processes.try_emplace(pid,
+        NativeMemoryProcessOwner{role, {}, content::PROCESS_TYPE_RENDERER, {}}).first;
+    if (position->second.role != role || position->second.process_type != content::PROCESS_TYPE_RENDERER)
+      return std::nullopt;
+    const auto task = content::ChildProcessTaskPortProvider::GetInstance()->ReadOwnedTaskIdentity(
+        pid, {content::ChildProcessTaskPortProvider::OwnedHostKind::kRenderer, id});
+    if (!task || !position->second.host_tasks.emplace(id, *task).second) return std::nullopt;
+    position->second.host_ids.push_back(id);
+  }
+  // The actual iterator CHECK requires UI despite its older IO-thread comment.
+  // Do not dispatch it to IO based on that stale descriptive text.
+  unsigned gpu_count = 0;
+  for (content::BrowserChildProcessHostIterator it; !it.Done(); ++it) {
+    const auto& data = it.GetData();
+    if (!data.GetProcess().IsValid()) continue;
+    const auto pid = data.GetProcess().Pid();
+    const int id = data.GetChildProcessId().value();
+    if (pid <= 0 || id <= 0 || inventory.processes.contains(pid) ||
+        data.process_type == content::PROCESS_TYPE_RENDERER ||
+        data.process_type == content::PROCESS_TYPE_BROWSER) return std::nullopt;
+    const bool gpu = data.process_type == content::PROCESS_TYPE_GPU;
+    if (++host_count > 128 || inventory.processes.size() >= 32 ||
+        (gpu && ++gpu_count > 1)) return std::nullopt;
+    const auto task = content::ChildProcessTaskPortProvider::GetInstance()->ReadOwnedTaskIdentity(
+        pid, {content::ChildProcessTaskPortProvider::OwnedHostKind::kBrowserChild, id});
+    if (!task) return std::nullopt;
+    inventory.processes.emplace(pid, NativeMemoryProcessOwner{
+        gpu ? "gpu" : "browser-child", {id}, data.process_type, {{id, *task}}});
+  }
+  if (gpu_count != 1 || inventory.processes.size() > 32 ||
+      !inventory.processes.contains(shell->shell_renderer_pid)) return std::nullopt;
+  for (auto& [pid, owner] : inventory.processes) {
+    std::ranges::sort(owner.host_ids);
+    if (std::adjacent_find(owner.host_ids.begin(), owner.host_ids.end()) != owner.host_ids.end())
+      return std::nullopt;
+  }
+  if (!ui || ReadNativeGuestStageShellOwner(ui) != shell) return std::nullopt;
+  return inventory;
+}
+}  // namespace aux
+#endif
