+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_BROWSER_MEMORY_INVENTORY_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_BROWSER_MEMORY_INVENTORY_H_
+#include "build/build_config.h"
+#include "chrome/browser/buildflags.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+#include "base/memory/weak_ptr.h"
+#include "content/browser/child_process_task_port_provider_mac.h"
+#include "chrome/browser/ui/aux/native_guest_stage_owner.h"
+#include "chrome/browser/ui/aux/native_process_footprint.h"
+class WebUIBrowserUI;
+namespace aux {
+struct NativeMemoryProcessOwner {
+  std::string role;
+  std::vector<int> host_ids;
+  int process_type = 0;
+  std::map<int, content::ChildProcessTaskPortProvider::OwnedTaskIdentity> host_tasks;
+  bool operator==(const NativeMemoryProcessOwner&) const = default;
+};
+struct NativeBrowserMemoryInventory {
+  NativeGuestStageOwnedSnapshot shell;
+  std::map<base::ProcessId, NativeMemoryProcessOwner> processes;
+  bool operator==(const NativeBrowserMemoryInventory&) const = default;
+};
+// Actual native host inventories only. PIDs are output, never caller selectors.
+// The current selected regular Profile and shell document must remain valid.
+std::optional<NativeBrowserMemoryInventory> ReadNativeBrowserMemoryInventory(
+    base::WeakPtr<WebUIBrowserUI> ui);
+}  // namespace aux
+#endif
