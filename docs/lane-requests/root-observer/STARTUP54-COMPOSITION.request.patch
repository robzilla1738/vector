+void WebFrameWidgetImpl::BeginNativeStartupFrame(
+    mojom::blink::NativeStartupFrameScopePtr scope,
+    mojo::PendingReceiver<mojom::blink::NativeStartupFrameLease> lease,
+    NativeStartupCallback callback) {
+  auto reply = mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback),
+      mojom::blink::NativeStartupFrameSubmissionPtr());
+  if (!scope || !lease.is_valid() || !widget_base_ || widget_base_->WillBeDestroyed() ||
+      !local_root_ || !ForTopMostMainFrame() || !local_root_->GetFrame() ||
+      !local_root_->GetFrame()->GetDocument() || scope->renderer_pid != base::GetCurrentProcId() ||
+      scope->shell_sink != frame_sink_id_ || native_startup_frame_ ||
+      native_command_measurement_pending_ || native_guest_stage_pending_ || native_created_guest_pending_ ||
+      (native_organization_work_ && native_organization_work_->armed()) ||
+      (native_guest_document_stamp_ && native_guest_document_stamp_->armed())) return;
+  auto* document = local_root_->GetFrame()->GetDocument();
+  if (scope->document != document->Token()) return;
+  const NativeStartupFrameScope expected{{scope->window_id, scope->widget_routing_id,
+      scope->renderer_pid, scope->native_document_generation, scope->shell_sink},
+      scope->document, scope->request_nonce, scope->sample_sequence, scope->admitted_launch, scope->hardware_registration};
+  auto reader = base::BindRepeating(
+      [](WeakPersistent<WebFrameWidgetImpl> self, WeakPersistent<Document> held,
+         NativeStartupFrameScope expected) -> std::optional<NativeStartupFrameScope> {
+        if (!self || !held || !self->widget_base_ || self->widget_base_->WillBeDestroyed() ||
+            !self->local_root_ || !self->local_root_->GetFrame() ||
+            self->local_root_->GetFrame()->GetDocument() != held.Get() ||
+            held->Token() != expected.document || self->frame_sink_id_ != expected.widget.frame_sink ||
+            expected.widget.renderer_pid != base::GetCurrentProcId()) return std::nullopt;
+        return expected;
+      }, WrapWeakPersistent(this), WrapWeakPersistent(document), expected);
+  native_startup_frame_ = std::make_unique<NativeStartupFrameController>(
+      widget_base_.get(), document, std::move(reader));
+  native_startup_frame_->Begin(std::move(scope), std::move(lease), std::move(reply));
+}
