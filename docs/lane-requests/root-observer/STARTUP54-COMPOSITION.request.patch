+
+// Browser-owned continuity assertions on the already-bound original shell
+// widget. No URL/PID/window/document can be selected by a caller. The launch
+// stamp originates exclusively in admitted original helper/kernel evidence.
+struct NativeStartupFrameScope {
+  mojo_base.mojom.UnguessableToken request_nonce;
+  uint64 sample_sequence;
+  int32 window_id;
+  int32 widget_routing_id;
+  int32 renderer_pid;
+  uint64 native_document_generation;
+  DocumentToken document;
+  viz.mojom.FrameSinkId shell_sink;
+  viz.mojom.FrameSinkId display_sink;
+  mojo_base.mojom.TimeTicks admitted_launch;
+  mojo_base.mojom.TimeTicks hardware_registration;
+};
+struct NativeStartupFrameSubmission {
+  NativeStartupFrameScope scope;
+  DocumentToken witness_document;
+  string composer_instance;
+  mojo_base.mojom.TimeTicks observed_typeable_at;
+  mojo_base.mojom.TimeTicks commit;
+  mojo_base.mojom.TimeTicks submitted_at;
+  uint32 shell_frame_token;
+  bool activated;
+  bool submitted_frame;
+  int32 submission_failure;
+};
+// Browser retains this exact private pipe through first eligible full shell HW.
+// Disconnect revokes the lifecycle observer and pending-tree marker. It does
+// not authorize creation, focus, navigation, profile or application effects.
+interface NativeStartupFrameLease {
+  Stop();
+};
