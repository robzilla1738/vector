+  EXPECT_FALSE(ValidateNativeStartupViewportGeometry(g));
+  g = WholeShell(); g.client_screen.Offset(1, 0);
+  EXPECT_FALSE(ValidateNativeStartupViewportGeometry(g));
+  g = WholeShell(); g.root_screen.set_height(600);
+  EXPECT_FALSE(ValidateNativeStartupViewportGeometry(g));
