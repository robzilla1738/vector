diff --git a/tests/host/lib/private-observation-owner.mjs b/tests/host/lib/private-observation-owner.mjs
new file mode 100644
--- /dev/null
+++ b/tests/host/lib/private-observation-owner.mjs
@@ -0,0 +1,52 @@
+import assert from 'node:assert/strict';
+/** Original App-owned child lifetime only. The caller retains spawn, native slot
+ * and artifact cleanup ownership; this guard neither launches nor admits a pair. */
+export function createPrivateObservationOwner({ child, generation, pair, stream }) {
+  assert.ok(Number.isInteger(child?.pid) && child.pid > 0 && Number.isInteger(generation) && generation > 0);
+  const pid = child.pid, native = Object.freeze({ ...pair.native });
+  let retired, closeReceipt, resolveClose;
+  const closed = new Promise(resolve => { resolveClose = resolve; });
+  function retire(error) {
+    if (retired) return;
+    retired = error; stream.dispose();
+  }
+  function failed(error) { retire(error); }
+  function close(code, signal) {
+    closeReceipt = Object.freeze({ pid, generation, code, signal });
+    retire(new Error('Original private child closed'));
+    child.off('error', failed); child.off('close', close);
+    resolveClose(closeReceipt);
+  }
+  child.once('error', failed); child.once('close', close);
+  function assertChild() {
+    if (retired) throw retired;
+    assert.equal(child.pid, pid, 'Original private child identity changed');
+    assert.equal(child.exitCode, null, 'Original private child exited before receipt delivery');
+    assert.equal(child.signalCode, null, 'Original private child signaled before receipt delivery');
+  }
+  function assertLive() {
+    assertChild(); pair.validate(); assertChild();
+    assert.deepEqual(pair.native, native, 'Original compiled identity changed');
+  }
+  async function observe(selection) {
+    assertLive();
+    const receipt = await (selection === undefined ? stream.discover() : stream.observe(selection));
+    assertLive();
+    assert.equal(receipt.window.pid, pid, 'Foreign private receipt child');
+    assert.equal(receipt.window.windowKind, 'private');
+    assert.equal(receipt.runtimeStatus, 'inactive-private');
+    assert.deepEqual(receipt.native, native, 'Private native receipt differs from original pair');
+    const freeze = value => {
+      if (value && typeof value === 'object') { for (const item of Object.values(value)) freeze(item); Object.freeze(value); }
+      return value;
+    };
+    return freeze(structuredClone(receipt));
+  }
+  try { assertLive(); }
+  catch (error) { retire(error); child.off('error', failed); child.off('close', close); throw error; }
+  return Object.freeze({ pid, generation, native, closed, assertLive,
+    discover() { assert.equal(arguments.length, 0, 'Private discovery has no selectors'); return observe(); },
+    observe, retire,
+    get closeReceipt() { return closeReceipt; },
+  });
+}
diff --git a/tests/host/lib/private-window-observation.mjs b/tests/host/lib/private-window-observation.mjs
new file mode 100644
--- /dev/null
+++ b/tests/host/lib/private-window-observation.mjs
@@ -0,0 +1,32 @@
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { normalizeNativeAppearance } from './appearance-provenance.mjs';
+
+export const privateWindowPrefix = 'AUX_NATIVE_PRIVATE_WINDOW_V1 ';
+
+/** The native producer, not expected labels, supplies identity. This decoder
+ * does not attest a compiler artifact or pretend an inactive runtime answered. */
+export function normalizePrivateWindowObservation(line, options) {
+  assert.equal(typeof line, 'string');
+  assert.ok(Buffer.byteLength(line) <= 8192 && line.startsWith(privateWindowPrefix) && line.endsWith('\n'));
+  const raw = JSON.parse(line.slice(privateWindowPrefix.length, -1));
+  assert.equal(line, privateWindowPrefix + JSON.stringify(raw) + '\n', 'Noncanonical or duplicate private receipt fields');
+  assert.deepEqual(Object.keys(raw).sort(), ['appearance', 'native', 'producer', 'runtimeStatus', 'version']);
+  assert.equal(raw.producer, 'aux-native-private-window-observation');
+  assert.equal(raw.version, 1);
+  assert.equal(raw.runtimeStatus, 'inactive-private');
+  assert.deepEqual(Object.keys(raw.native ?? {}).sort(), ['buildId', 'sourceCommit']);
+  assert.equal(raw.native.sourceCommit, options.candidate.native.sourceCommit, 'Foreign compiled native source');
+  assert.equal(raw.native.buildId, options.candidate.native.buildId, 'Foreign compiled native build');
+  const parts = raw.native.buildId.split('+');
+  assert.equal(parts.length, 3);
+  assert.ok(parts[0].length > 0 && parts[0].length <= 128);
+  assert.equal(parts[1], options.candidate.native.manifestHash);
+  assert.equal(parts[2], raw.native.sourceCommit);
+  assert.deepEqual(Object.keys(raw.appearance?.frame ?? {}).sort(), ['height', 'width', 'x', 'y']);
+  const window = normalizeNativeAppearance(JSON.stringify(raw.appearance), options);
+  assert.equal(window.windowKind, 'private', 'Receipt is not the observed private window');
+  return Object.freeze({ producer: raw.producer, version: raw.version,
+    native: Object.freeze({ ...raw.native, manifestHash: parts[1] }), runtimeStatus: raw.runtimeStatus,
+    window, raw: Object.freeze({ line, sha256: createHash('sha256').update(line).digest('hex') }) });
+}
diff --git a/tests/host/lib/private-window-stream.mjs b/tests/host/lib/private-window-stream.mjs
new file mode 100644
--- /dev/null
+++ b/tests/host/lib/private-window-stream.mjs
@@ -0,0 +1,62 @@
+import assert from 'node:assert/strict';
+import { normalizePrivateWindowObservation, privateWindowPrefix } from './private-window-observation.mjs';
+
+/** Direct-child stderr only. All identities are bound by the original launcher;
+ * no log-file recovery, caller-selected PID, restart or guessed window route. */
+export function createPrivateWindowStream({ pid, generation, candidate }) {
+  assert.ok(Number.isInteger(pid) && pid > 0 && Number.isInteger(generation) && generation > 0);
+  const startedAt = new Date().toISOString();
+  let buffer = '', bytes = 0, records = 0, retired, waiting;
+  function retire(error) {
+    if (retired) return;
+    retired = error; buffer = '';
+    if (waiting) { clearTimeout(waiting.timer); waiting.reject(error); waiting = undefined; }
+  }
+  function wait(windowId, notBefore, timeoutMs) {
+    if (retired) return Promise.reject(retired);
+    try {
+      assert.ok(!waiting, 'Overlapping private observation');
+      const now = Date.now(), start = Date.parse(notBefore);
+      assert.ok(Number.isFinite(start) && start >= Date.parse(startedAt) && start <= now && now - start <= 5000);
+      assert.ok(Number.isInteger(timeoutMs) && timeoutMs > 0 && timeoutMs <= 5000);
+      return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => { waiting = undefined; reject(new Error('No fresh original private native receipt')); }, timeoutMs);
+        waiting = { windowId, notBefore: start, timer, resolve, reject };
+      });
+    } catch (error) { return Promise.reject(error); }
+  }
+  return Object.freeze({
+    write(chunk, source) {
+      if (retired) return;
+      try {
+        assert.equal(source?.pid, pid); assert.equal(source?.generation, generation);
+        assert.ok(Buffer.isBuffer(chunk)); bytes += chunk.length;
+        assert.ok(bytes <= 4 * 1024 * 1024, 'Private stderr byte budget exhausted');
+        buffer += chunk.toString('utf8');
+        let newline;
+        while ((newline = buffer.indexOf('\n')) !== -1) {
+          const line = buffer.slice(0, newline + 1); buffer = buffer.slice(newline + 1);
+          assert.ok(Buffer.byteLength(line) <= 16384, 'Oversized direct-child stderr line');
+          if (!line.startsWith(privateWindowPrefix)) continue;
+          assert.ok(++records <= 4000, 'Private receipt budget exhausted');
+          // Decode using the actual native identity for preliminary window lookup;
+          // the decoder then validates all original candidate/native fields.
+          const value = JSON.parse(line.slice(privateWindowPrefix.length));
+          const receipt = normalizePrivateWindowObservation(line, { candidate, targetPid: pid,
+            windowId: value.appearance?.windowId, startedAt, completedAt: new Date().toISOString() });
+          if (waiting && (waiting.windowId === null || receipt.window.windowId === waiting.windowId) &&
+              Date.parse(receipt.window.observedAt) >= waiting.notBefore) {
+            const current = waiting; waiting = undefined; clearTimeout(current.timer); current.resolve(receipt);
+          }
+        }
+        assert.ok(Buffer.byteLength(buffer) <= 16384, 'Unterminated direct-child stderr line');
+      } catch (error) { retire(error); }
+    },
+    discover() { return wait(null, new Date().toISOString(), 5000); },
+    observe({ windowId, notBefore, timeoutMs = 5000 }) {
+      if (!Number.isInteger(windowId) || windowId <= 0) return Promise.reject(new Error('Missing original private window'));
+      return wait(windowId, notBefore, timeoutMs);
+    },
+    dispose() { retire(new Error('Original private child observation retired')); },
+  });
+}
