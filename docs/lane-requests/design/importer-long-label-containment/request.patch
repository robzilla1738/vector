+// @vitest-environment jsdom
+import { readFileSync } from "node:fs";
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { expect, it, vi } from "vitest";
+import type { ImportJobStatus } from "@aux/contracts";
+import { ImportDataSetting } from "./ImportDataSetting";
+
+const rpc = vi.hoisted(() => vi.fn());
+vi.mock("../store", () => ({ call: rpc }));
+vi.mock("../bridge", () => ({ bridge: { onEvent: () => () => {} } }));
+(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const css = readFileSync("apps/shell/src/components/ImportDataSetting.css", "utf8");
+function containment() {
+  const rule = css.match(/(\.import-setting :is\(legend, \.hint, \.import-report li\))\s*\{([^}]+)\}/);
+  expect(rule).not.toBeNull();
+  expect(rule![2]).toMatch(/min-width:\s*0;/);
+  expect(rule![2]).toMatch(/max-width:\s*100%;/);
+  expect(rule![2]).toMatch(/overflow-wrap:\s*anywhere;/);
+  expect(rule![2]).not.toMatch(/text-overflow|overflow:\s*hidden|white-space:\s*nowrap/);
+  return rule![1]!;
+}
+
+it("contains full long Profile and blocker text without changing reviewed categories or original focus", async () => {
+  const profileId = "P".repeat(64),
+    blocker = `Unreadable-${"b".repeat(500)}`;
+  rpc.mockReset();
+  rpc.mockImplementation(async (method: string) => {
+    if (method === "import.status")
+      return { jobId: "long-profile", done: true, cancelled: false, progress: [] };
+    if (method === "import.preview")
+      return {
+        sources: [
+          {
+            id: "firefox",
+            label: "Firefox",
+            profiles: [profileId],
+            categories: [],
+            profileCategories: [
+              {
+                profileId,
+                categories: [
+                  { category: "bookmarks", available: true, count: 1 },
+                  { category: "history", available: false, blocker },
+                ],
+              },
+            ],
+          },
+        ],
+      };
+    if (method === "import.run") return { jobId: "long-profile" };
+    throw new Error(`Unexpected ${method}`);
+  });
+  const host = document.createElement("div");
+  document.body.append(host);
+  const root = createRoot(host);
+  try {
+    await act(async () => root.render(<ImportDataSetting />));
+    await act(async () => host.querySelector("button")!.click());
+    const selector = containment();
+    const profile = [...host.querySelectorAll("legend")].find(
+      (item) => item.textContent === `Profile: ${profileId}`,
+    )!;
+    const blocked = [...host.querySelectorAll(".hint")].find((item) => item.textContent === blocker)!;
+    expect(profile.matches(selector)).toBe(true);
+    expect(blocked.matches(selector)).toBe(true);
+    const choices = [...host.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
+    expect(choices.map((input) => [input.checked, input.disabled])).toEqual([
+      [false, false],
+      [false, true],
+    ]);
+    await act(async () => {
+      choices[0]!.focus();
+      choices[0]!.click();
+      choices[1]!.click();
+    });
+    expect(document.activeElement).toBe(choices[0]);
+    expect(choices.map((input) => input.checked)).toEqual([true, false]);
+    await act(async () =>
+      [...host.querySelectorAll("button")]
+        .find((button) => button.textContent === "Import selected (1)")!
+        .click(),
+    );
+    expect(rpc).toHaveBeenCalledWith("import.run", {
+      selections: [{ sourceId: "firefox", profileId, categories: ["bookmarks"] }],
+    });
+    expect(rpc.mock.calls.filter(([method]) => method === "import.run")).toHaveLength(1);
+  } finally {
+    await act(async () => root.unmount());
+    host.remove();
+  }
+});
+
+it("contains complete terminal diagnostics and receipt labels while keeping explicit retry and consent copy", async () => {
+  const diagnostic = `Unconfirmed-${"e".repeat(700)}-<script>keep-text</script>`;
+  const detail = `Source-${"d".repeat(700)}`;
+  const label = "L".repeat(200);
+  const job: ImportJobStatus = {
+    jobId: "long-diagnostic",
+    done: true,
+    cancelled: false,
+    error: diagnostic,
+    progress: [
+      { source: "chrome", label, category: "history", state: "error", imported: 500, skipped: 1, detail },
+    ],
+  };
+  rpc.mockReset();
+  rpc.mockResolvedValue(job);
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => root.render(<ImportDataSetting />));
+    const selector = containment();
+    const error = [...host.querySelectorAll("p")].find((item) => item.textContent === diagnostic)!;
+    const report = host.querySelector(".import-report li")!;
+    expect(error.matches(selector)).toBe(true);
+    expect(report.matches(selector)).toBe(true);
+    expect(error.textContent).toBe(diagnostic);
+    expect(report.textContent).toContain(label);
+    expect(report.textContent).toContain(detail);
+    expect(report.textContent).toContain("500 imported");
+    expect(report.textContent).toContain("1 skipped");
+    expect(host.querySelector("script")).toBeNull();
+    expect(host.textContent?.replace(/\s+/g, " ")).toContain("Nothing is imported until you confirm.");
+    expect(
+      [...host.querySelectorAll("button")].find((button) => button.textContent === "Review sources to retry")!
+        .disabled,
+    ).toBe(false);
+    expect(host.querySelector("button")!.matches(selector)).toBe(false);
+    expect(rpc.mock.calls).toEqual([["import.status", {}]]);
+  } finally {
+    await act(async () => root.unmount());
+  }
+});
