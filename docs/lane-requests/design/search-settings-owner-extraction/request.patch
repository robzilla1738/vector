diff --git a/apps/shell/src/search-settings-save-owner.test.tsx b/apps/shell/src/search-settings-save-owner.test.tsx
new file mode 100644
index 000000000..1ebb7e1d9
--- /dev/null
+++ b/apps/shell/src/search-settings-save-owner.test.tsx
@@ -0,0 +1,76 @@
+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { expect, it, vi } from "vitest";
+import { DEFAULT_SEARCH_ENGINE } from "@aux/contracts/search-engine";
+vi.mock("./bridge", () => ({ bridge: { windowId: "original", privateMode: false } }));
+vi.mock("./store", () => ({ errToast: vi.fn() }));
+vi.mock("./commands", () => ({ executeCommand: vi.fn() }));
+import { invokeScopedControl } from "./scoped-control-commands";
+import { SearchEngineSetting } from "./components/SearchEngineSetting";
+import { SearchEnginesSetting } from "./components/SearchEnginesSetting";
+it("keeps two actual Settings save owners independent through false and successful ACK", async () => {
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  vi.spyOn(HTMLElement.prototype, "getClientRects").mockReturnValue([{}] as never);
+  const host = document.createElement("div");
+  document.body.append(host);
+  const root = createRoot(host);
+  let one!: (ack: boolean) => void, two!: (ack: boolean) => void;
+  const single = vi.fn(
+    () =>
+      new Promise<boolean>((resolve) => {
+        one = resolve;
+      }),
+  );
+  const keyword = vi.fn(
+    () =>
+      new Promise<boolean>((resolve) => {
+        two = resolve;
+      }),
+  );
+  const rows = [{ keyword: "gh", name: "GitHub", template: "https://github.com/search?q=%s" }];
+  try {
+    await act(async () =>
+      root.render(
+        <>
+          <SearchEngineSetting value={DEFAULT_SEARCH_ENGINE} onSave={single} />
+          <SearchEnginesSetting value={rows} onSave={keyword} />
+        </>,
+      ),
+    );
+    const google = [...host.querySelectorAll("button")].find((node) => node.textContent === "Google")!;
+    const remove = host.querySelector<HTMLButtonElement>('button[aria-label="Remove gh engine"]')!;
+    let first!: unknown, second!: unknown;
+    google.focus();
+    await act(async () => {
+      first = invokeScopedControl("select-search-engine");
+    });
+    remove.focus();
+    await act(async () => {
+      second = invokeScopedControl("remove-keyword-search-engine");
+    });
+    expect(single).toHaveBeenCalledWith("https://www.google.com/search?q=%s");
+    expect(keyword).toHaveBeenCalledWith([]);
+    await act(async () => {
+      one(false);
+      expect(await first).toBe(false);
+    });
+    expect(host.querySelector(".search-engine-setting [role=alert]")!.textContent).toContain(
+      "The search engine wasn’t saved. Try again.",
+    );
+    expect(remove.disabled).toBe(true);
+    expect(google.disabled).toBe(false);
+    await act(async () => {
+      two(true);
+      expect(await second).toBe(true);
+    });
+    expect(remove.disabled).toBe(false);
+    expect(host.querySelector(".search-engines-setting [role=alert]")).toBeNull();
+    expect(rows).toEqual([{ keyword: "gh", name: "GitHub", template: "https://github.com/search?q=%s" }]);
+  } finally {
+    await act(async () => root.unmount());
+    host.remove();
+    vi.restoreAllMocks();
+    vi.unstubAllGlobals();
+  }
+});
diff --git a/apps/shell/src/settings/sections/use-settings-save-owner.ts b/apps/shell/src/settings/sections/use-settings-save-owner.ts
new file mode 100644
index 000000000..81d7a10b3
--- /dev/null
+++ b/apps/shell/src/settings/sections/use-settings-save-owner.ts
@@ -0,0 +1,68 @@
+import { useCallback, useLayoutEffect, useRef, useState, type RefObject } from "react";
+import { bridge } from "../../bridge";
+import { guardCommandCompletion } from "../../command-completion";
+export type SettingsSaveOwner = { active: boolean; identity: object; pending: boolean };
+/** Shared local save delivery; callers retain every original validation and native argument. */
+export function useSettingsSaveOwner(identity: object, windowId: string, privateMode: boolean) {
+  const owner = useRef<SettingsSaveOwner>({ active: false, identity, pending: false });
+  useLayoutEffect(() => {
+    const original = { active: true, identity, pending: false };
+    owner.current = original;
+    return () => {
+      original.active = false;
+    };
+  }, [identity]);
+  const [busyOwner, setBusyOwner] = useState<SettingsSaveOwner | null>(null);
+  const [failure, setFailure] = useState<{ owner: SettingsSaveOwner; message: string } | null>(null);
+  const current = useCallback(
+    (original: SettingsSaveOwner) =>
+      original.active &&
+      owner.current === original &&
+      original.identity === identity &&
+      bridge.windowId === windowId &&
+      bridge.privateMode === privateMode,
+    [identity, windowId, privateMode],
+  );
+  const getOwner = useCallback(() => owner.current, []);
+  const busy = !!busyOwner && busyOwner.active && busyOwner.identity === identity;
+  const error = failure?.owner.active && failure.owner.identity === identity ? failure.message : "";
+  const fail = useCallback(
+    (original: SettingsSaveOwner, message: string) => setFailure({ owner: original, message }),
+    [],
+  );
+  const clearFailure = useCallback(() => setFailure(null), []);
+  const perform = useCallback(
+    <D>(
+      original: SettingsSaveOwner,
+      savedDraft: D,
+      draftRef: RefObject<D>,
+      work: () => Promise<boolean>,
+      saved: () => void,
+      message: string,
+    ) => {
+      original.pending = true;
+      setBusyOwner(original);
+      clearFailure();
+      const delivering = () => current(original) && draftRef.current === savedDraft;
+      const completion = (async () => {
+        try {
+          const ack = await work();
+          if (delivering()) {
+            if (!ack) fail(original, message);
+            else saved();
+          }
+          return ack;
+        } catch (reason) {
+          if (delivering()) fail(original, message);
+          throw reason;
+        } finally {
+          original.pending = false;
+          setBusyOwner((active) => (active === original ? null : active));
+        }
+      })();
+      return guardCommandCompletion(completion, delivering);
+    },
+    [current, fail, clearFailure],
+  );
+  return [getOwner, current, busy, error, fail, clearFailure, perform] as const;
+}
