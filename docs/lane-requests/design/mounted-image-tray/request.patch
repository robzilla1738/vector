+ await act(async()=>{if(mode==="resolve")held[0]!.done(ack);else held[0]!.fail(error);await old.catch(()=>{});});
+ expect(await old.then(value=>({value}),reason=>({reason}))).toEqual(mode==="resolve"?{value:ack}:{reason:error});
