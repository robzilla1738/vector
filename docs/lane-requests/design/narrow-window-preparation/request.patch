diff --git a/tests/host/lib/narrow-window.mjs b/tests/host/lib/narrow-window.mjs
new file mode 100644
index 000000000..1f249b9ab
--- /dev/null
+++ b/tests/host/lib/narrow-window.mjs
@@ -0,0 +1,46 @@
+import assert from 'node:assert/strict';
+
+// Explicit preparation target, not a native minimum or F21 approval.
+const width = 810;
+function frame(windows) {
+  const normal = windows.filter(window => window.layer === 0);
+  assert.equal(normal.length, 1, 'Narrow preparation requires one original layer-zero window');
+  const window = normal[0];
+  assert.ok(Number.isInteger(window.id) && window.id > 0 &&
+    ['x', 'y', 'width', 'height'].every(key => Number.isFinite(window[key])) &&
+    window.width > 0 && window.height > 0, 'Invalid observed native frame');
+  return Object.freeze({ id: window.id, x: window.x, y: window.y, width: window.width, height: window.height });
+}
+export async function prepareNarrowWindow(t) {
+  assert.equal(t.appearanceEnabled, true, 'Narrow preparation requires appearance opt-in');
+  const app = t.app, ax = t.ax, pid = app.pid;
+  const current = () => assert.ok(t.app === app && t.ax === ax && Number.isInteger(pid) && pid > 0 && app.pid === pid && ax.pid === pid,
+    'Original narrow-window owner retired');
+  current();
+  const rawIdentity = await ax.request('warmWindowIdentity'); current();
+  assert.deepEqual(Object.keys(rawIdentity).sort(), ['helperPid', 'helperProcessStartMachTicks', 'helperProcessUuid', 'producer', 'targetPid', 'targetProcessStartMachTicks', 'targetProcessUuid', 'version'], 'Invalid native identity fields');
+  assert.ok(rawIdentity.producer === 'aux-native-warm-window-identity' && rawIdentity.version === 1 &&
+    Number.isInteger(rawIdentity.helperPid) && rawIdentity.helperPid > 0 &&
+    ['targetProcessUuid', 'helperProcessUuid'].every(key => /^[a-f0-9]{32}$/.test(rawIdentity[key]) && rawIdentity[key] !== '0'.repeat(32)) &&
+    ['targetProcessStartMachTicks', 'helperProcessStartMachTicks'].every(key => typeof rawIdentity[key] === 'string' && /^[1-9][0-9]*$/.test(rawIdentity[key])), 'Invalid native kernel identity');
+  const identity = Object.freeze({ ...rawIdentity });
+  assert.equal(identity.targetPid, pid, 'Foreign native target');
+  assert.equal(identity.helperPid, ax.helperPid, 'Foreign native helper');
+  const beforeWindows = await ax.windows(); current();
+  const before = frame(beforeWindows);
+  assert.ok(before.width > 900, 'Narrow preparation requires a wider original frame');
+  assert.deepEqual(await ax.request('warmWindowIdentity'), identity, 'Original native generation changed'); current();
+  const from = Object.freeze({ x: before.x + before.width - 1, y: before.y + before.height - 1 });
+  const to = Object.freeze({ x: before.x + width - 1, y: from.y });
+  const input = await ax.drag(from, to, { steps: 20, holdMs: 100, destinationHoldMs: 100 }); current();
+  const afterWindows = await ax.windows(); current();
+  const after = frame(afterWindows);
+  assert.deepEqual(await ax.request('warmWindowIdentity'), identity, 'Original native generation changed'); current();
+  assert.equal(after.id, before.id, 'Original native window replaced');
+  assert.ok(after.width >= 720 && after.width <= 900 && Math.abs(after.width - width) <= 2 &&
+    after.width < before.width && Math.abs(after.height - before.height) <= 2 &&
+    Math.abs(after.x - before.x) <= 2 && Math.abs(after.y - before.y) <= 2,
+  'Native resize was clamped, unchanged, moved or outside the preparation target');
+  return Object.freeze({ pid, identity: Object.freeze({ ...identity }), windowId: before.id, before, after, input,
+    target: Object.freeze({ minimumWidth: 720, maximumWidth: 900, requestedWidth: width }), visualApproval: false });
+}
diff --git a/tests/host/narrow-window.test.mjs b/tests/host/narrow-window.test.mjs
new file mode 100644
index 000000000..580d90da2
--- /dev/null
+++ b/tests/host/narrow-window.test.mjs
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { prepareNarrowWindow } from './lib/narrow-window.mjs';
+function fixture() {
+  const before = { id: 71, layer: 0, x: 20, y: 30, width: 1200, height: 700 };
+  const after = { ...before, width: 810 };
+  const identity = { producer: 'aux-native-warm-window-identity', version: 1, targetPid: 201, helperPid: 301, targetProcessUuid: '1'.repeat(32), targetProcessStartMachTicks: '7', helperProcessUuid: '2'.repeat(32), helperProcessStartMachTicks: '8' };
+  let reads = 0;
+  const calls = [];
+  const t = { appearanceEnabled: true, app: { pid: 201 }, ax: { pid: 201, helperPid: 301,
+    request: async () => identity, windows: async () => [reads++ ? after : before],
+    drag: async (...args) => { calls.push(args); return { transport: 'controlled-test-input' }; } } };
+  return { t, before, after, identity, calls };
+}
+test('derives fixed HID coordinates from original frame and retains actual observed geometry', async () => {
+  const { t, calls } = fixture();
+  const result = await prepareNarrowWindow(t);
+  assert.deepEqual(calls, [[{ x: 1219, y: 729 }, { x: 829, y: 729 }, { steps: 20, holdMs: 100, destinationHoldMs: 100 }]]);
+  assert.equal(result.after.width, 810); assert.equal(result.before.width, 1200);
+  assert.equal(result.windowId, 71); assert.equal(result.visualApproval, false);
+});
+test('refuses ambiguity, malformed geometry and already narrow input before effects', async () => {
+  for (const windows of [[], [{ id: 71, layer: 0, x: 0, y: 0, width: 800, height: 700 }],
+    [{ id: 71, layer: 0, x: NaN, y: 0, width: 1200, height: 700 }],
+    [{ id: 71, layer: 0 }, { id: 72, layer: 0 }]]) {
+    const { t, calls } = fixture(); t.ax.windows = async () => windows;
+    await assert.rejects(prepareNarrowWindow(t)); assert.equal(calls.length, 0);
+  }
+});
+test('refuses clamp, unchanged, replacement, movement and out-of-range after real input', async () => {
+  for (const change of [{ width: 1200 }, { width: 850 }, { width: 710 }, { id: 72 }, { x: 25 }, { height: 650 }]) {
+    const { t, after, calls } = fixture(); Object.assign(after, change);
+    await assert.rejects(prepareNarrowWindow(t)); assert.equal(calls.length, 1);
+  }
+});
+test('original generation and owner retirement across awaits refuse before or after input', async () => {
+  for (const phase of ['identity', 'windows', 'drag']) {
+    const { t, calls } = fixture();
+    if (phase === 'identity') t.ax.request = async () => { t.app.pid = 202; return {}; };
+    if (phase === 'windows') t.ax.windows = async () => { t.ax.pid = 202; return []; };
+    if (phase === 'drag') t.ax.drag = async () => { calls.push('input'); t.app = { pid: 201 }; };
+    await assert.rejects(prepareNarrowWindow(t), /owner retired/);
+    assert.equal(calls.length, phase === 'drag' ? 1 : 0);
+  }
+  const { t, identity, calls } = fixture(); let n = 0;
+  t.ax.request = async () => n++ ? { ...identity, targetProcessStartMachTicks: '8' } : identity;
+  await assert.rejects(prepareNarrowWindow(t), /generation changed/); assert.equal(calls.length, 0);
+});
+test('preserves original input refusal without retry or manufactured geometry', async () => {
+  const { t } = fixture(), original = new Error('HID refused');
+  t.ax.drag = async () => { throw original; };
+  await assert.rejects(prepareNarrowWindow(t), error => error === original);
+});
+
+test('missing or foreign kernel receipt refuses before input', async () => {
+  for (const change of [{ producer: 'caller-label' }, { targetPid: 202 }, { helperPid: 302 }, { helperProcessUuid: '0'.repeat(32) }, { targetProcessStartMachTicks: '0' }]) {
+    const { t, identity, calls } = fixture(); t.ax.request = async () => ({ ...identity, ...change });
+    await assert.rejects(prepareNarrowWindow(t)); assert.equal(calls.length, 0);
+  }
+});
