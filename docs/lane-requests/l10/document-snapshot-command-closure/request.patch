+const snapshot=(id="one",content="Original full snapshot text"):ReadSnapshot=>({attachment:{attachmentId:id,filename:"Original document.txt",excerpt:"Original full",included:true,createdAt:1,byteLength:content.length},content,contextCharacters:8,contextText:content.slice(0,8),contextTotalCharacters:content.length});
+let reads:{params:unknown;resolve(value:ReturnType<typeof snapshot>):void;reject(reason:unknown):void}[];
