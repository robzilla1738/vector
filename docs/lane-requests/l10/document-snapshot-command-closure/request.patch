+it("actual original read/filename/scope/source disclosure and full text remain intact",async()=>{await ready();expect(reads[0]!.params).toEqual({chatId:"a",attachmentId:"one"});expect(host.textContent).toContain("Original document.txt");expect(host.textContent).toContain("Original full snapshot text");await command(text);expect(host.querySelector('pre[aria-label="Included document text"]')?.textContent).toBe("Original");expect(control(text).getAttribute("aria-pressed")).toBe("true");await command(text);expect(host.querySelector('pre[aria-label="Included document text"]')).toBeNull();const pointer=new MouseEvent("click",{bubbles:true,cancelable:true});await act(async()=>{expect(control(details).dispatchEvent(pointer)).toBe(false);});expect(pointer.defaultPrevented).toBe(true);expect(host.querySelector<HTMLDetailsElement>("details")!.open).toBe(true);expect(host.textContent).toContain("Earlier turns and retries keep the text they used");});
+it("retry actual producer keeps error identity text and resolves fresh original request",async()=>{await render();const reason=new Error("Original read failed");await act(async()=>reads[0]!.reject(reason));expect(host.querySelector('[role="alert"]')?.textContent).toContain(String(reason));await command(retry);expect(reads).toHaveLength(2);expect(reads[1]!.params).toEqual(reads[0]!.params);await act(async()=>reads[1]!.resolve(snapshot()));expect(host.querySelector('[role="alert"]')).toBeNull();});
+it("close loading snapshot is registered and retains original callback ACK",async()=>{await render();const ack={original:"close"};close.mockReturnValue(ack);const original=await command(closeId);await expect(original.result).resolves.toBe(ack);expect(close).toHaveBeenCalledTimes(1);});
+it("held chat A→B→A replies cannot replace the newest actual snapshot",async()=>{await render();await render("b");await render("a");expect(reads).toHaveLength(3);await act(async()=>reads[2]!.resolve(snapshot("one","Current accepted source")));await act(async()=>{reads[0]!.resolve(snapshot("one","Retired original source"));reads[1]!.resolve(snapshot("one","Foreign chat source"));});expect(host.textContent).toContain("Current accepted source");expect(host.textContent).not.toContain("Retired original source");expect(host.textContent).not.toContain("Foreign chat source");});
+it("held attachment one→two→one failure cannot replace current source",async()=>{await render();await render("a","two");await render("a","one");await act(async()=>reads[2]!.resolve(snapshot()));await act(async()=>reads[0]!.reject(new Error("Retired source failure")));expect(host.querySelector('[role="alert"]')).toBeNull();expect(host.textContent).toContain("Original full snapshot text");});
+it("observed foreign window ABA refuses old close and held reply publication",async()=>{await render();bridge.windowId="foreign";await act(async()=>control(closeId).click());bridge.windowId=windowId;await expect(executeCommand(closeId)).rejects.toThrow();await act(async()=>reads[0]!.resolve(snapshot()));expect(host.textContent).not.toContain("Original full snapshot text");expect(close).not.toHaveBeenCalled();expect(useStore.getState().toasts).toEqual([]);});
+it("committed disconnected→connected→disconnected renews exact read and refuses old failures",async()=>{await render();await act(async()=>useStore.setState({connected:true}));await act(async()=>useStore.setState({connected:false}));expect(reads).toHaveLength(3);await act(async()=>reads[2]!.resolve(snapshot("one","Latest source after renewal")));await act(async()=>reads[0]!.reject(new Error("Old disconnected reply")));expect(host.textContent).toContain("Latest source after renewal");expect(host.querySelector('[role="alert"]')).toBeNull();});
+it("focused remaps use actual loaded summary and included-text controls",async()=>{useStore.setState({settings:{shortcutOverrides:{[details]:[{key:"j",command:true,alt:true}],[text]:[{key:"k",command:true,alt:true}]}}});await ready();await act(async()=>{control(details).focus();expect(dispatchShortcut({key:"j",meta:true,alt:true,shift:false})).toBe(true);});expect(host.querySelector<HTMLDetailsElement>("details")!.open).toBe(true);await act(async()=>{control(text).focus();expect(dispatchShortcut({key:"k",meta:true,alt:true,shift:false})).toBe(true);});expect(host.querySelector('pre[aria-label="Included document text"]')).not.toBeNull();});
+it("full included reference hides text-scope control exactly as original",async()=>{await render();const value=snapshot();value.contextCharacters=value.content.length;delete value.contextText;await act(async()=>reads[0]!.resolve(value));expect(control(text)).toBeNull();expect(host.textContent).toContain("Entire text reference included in new replies");});
+it("hidden/unfocused controls refuse original close or display mutation",async()=>{await ready();control(closeId).setAttribute("hidden","");control(closeId).focus();await expect(executeCommand(closeId)).rejects.toThrow();host.focus();await expect(executeCommand(text)).rejects.toThrow();expect(close).not.toHaveBeenCalled();});
+it("all four actions remain original normal scoped controls",()=>{for(const id of [text,details,retry,closeId])expect(COMMANDS.find(row=>row.id===id)).toMatchObject({windows:["normal"],palette:false,bindings:[],intercept:true});});
