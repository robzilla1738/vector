+                   content::WeakDocumentPtr original_document) {
+                  auto* original_frame =
+                      original_document.AsRenderFrameHostIfValid();
+                  if (!original_view || !original_frame ||
+                      original_view->native_input_binding_ != original_binding ||
+                      original_view->native_input_document_
+                              .AsRenderFrameHostIfValid() != original_frame)
+                    return;
+                  auto* contents = WebContentsImpl::FromRenderWidgetHostImpl(
+                      original_view->host());
+                  if (!contents ||
+                      contents->GetPrimaryMainFrame() != original_frame ||
+                      !original_frame->IsActive() ||
+                      !original_frame->IsRenderFrameLive())
