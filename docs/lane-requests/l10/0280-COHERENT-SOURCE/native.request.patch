+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_CDP_INPUT_MAC_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_CDP_INPUT_MAC_H_
+#include <optional>
