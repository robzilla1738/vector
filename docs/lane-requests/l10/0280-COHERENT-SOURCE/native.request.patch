+IN_PROC_BROWSER_TEST_F(NativeInputAcknowledgementBrowserTest,
+                       GenuineAckReleaseAdmitsOnlyOriginalDocument) {
+  ASSERT_NO_FATAL_FAILURE(NavigateWithHeldAcknowledgement());
