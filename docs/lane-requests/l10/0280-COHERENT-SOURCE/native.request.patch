+    const std::string& id) {
+  auto found = native_input_waiters_.find(id);
+  if (found == native_input_waiters_.end()) return;
+  auto waiter = std::move(found->second);
+  native_input_waiters_.erase(found);
+  waiter->timer.Stop();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(waiter->callback), false));
+}
+
+void RenderWidgetHostViewMac::FinishNativeInputAdmissionWaiters(bool ready) {
+  auto waiters = std::move(native_input_waiters_);
+  native_input_waiters_.clear();
+  const auto weak = weak_factory_.GetWeakPtr();
+  for (auto& [id, waiter] : waiters) {
+    waiter->timer.Stop();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+            [](base::WeakPtr<RenderWidgetHostViewMac> view, bool ready,
+               std::string binding, content::WeakDocumentPtr document,
+               base::OnceCallback<void(bool)> callback) {
+              const bool admitted = ready && view &&
+                  view->native_input_binding_ == binding &&
+                  view->HasNativeInputAdmissionForDocument(document);
