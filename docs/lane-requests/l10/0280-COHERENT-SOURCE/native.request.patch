@@ -0,0 +1,123 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_cdp_input_mac.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/logging.h"
+#include "chrome/browser/ui/aux/runtime_host.h"
+#import <Cocoa/Cocoa.h>
+#include <cmath>
+#include <limits>
+#include <utility>
+#include <unistd.h>
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/egress_controller.h"
+#include "chrome/browser/ui/aux/page_identity.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/native_platform_input_admission.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/events/event_utils.h"
+namespace aux {
+void PublishNativeCdpPersonTakeover(const NativeCdpPersonInput& input) {
+  // Native retirement already happened synchronously. Only its exact original
+  // registered scope travels to the authenticated runtime; a page-only input
+  // notification could otherwise stop a later run that reused the same tab.
+  auto* frame = input.document.AsRenderFrameHostIfValid();
+  auto* process = frame ? frame->GetProcess() : nullptr;
+  auto* profile = process ? Profile::FromBrowserContext(
+      process->GetBrowserContext()) : nullptr;
+  auto* catalog = profile ? TabCatalog::GetForProfile(profile) : nullptr;
+  auto* contents = catalog ? catalog->FindPage(input.page_id) : nullptr;
+  if (!profile || profile->IsOffTheRecord() || !frame || !contents ||
+      contents->GetPrimaryMainFrame() != frame || !frame->IsActive() ||
+      !frame->IsRenderFrameLive())
+    return;
+  base::DictValue payload;
+  payload.Set("scope", input.retired.original_scope.Clone());
+  const bool installed = !input.retired.original_lease.empty();
+  payload.Set("phase", installed ? "installed" : "preparing");
+  if (installed)
+    payload.Set("lease", input.retired.original_lease.Clone());
+  auto json = base::WriteJson(payload);
+  if (!json)
+    return;
+  auto* runtime = AuxRuntimeHost::ForProfile(profile);
+  if (!runtime)
+    return;
+  // No runtime reply can rearm the native document. The runtime revalidates
+  // this original scope inside its acknowledged serialized control boundary.
+  runtime->CallInternal("view.takeover", std::move(*json), base::BindOnce(
+      [](AuxRuntimeHost::Response response) {
+        if (!response.ok)
+          LOG(WARNING) << "Aux native takeover refused: " << response.error_code;
+      }));
+}
+std::optional<NativeCdpPersonInput> RetireForNativeCdpPersonInput(
+    const content::NativePlatformInputAdmission& admission) {
+  if (!admission.Consume())
+    return std::nullopt;
+  auto* contents = admission.contents();
+  auto* widget = admission.widget();
+  const auto& document = admission.document();
+  const auto& native_event = admission.event();
+  NSEvent* event = native_event.Get();
+  auto* frame = document.AsRenderFrameHostIfValid();
+  auto* profile = contents ? Profile::FromBrowserContext(contents->GetBrowserContext())
+                           : nullptr;
+  if (!profile || profile->IsOffTheRecord() || !widget || !frame || !event ||
+      !event.CGEvent || contents->GetPrimaryMainFrame() != frame ||
+      !frame->IsActive() || !frame->IsRenderFrameLive() || !widget->GetProcess() ||
+      widget->GetProcess()->GetBrowserContext() != profile)
+    return std::nullopt;
+  const bool keyboard = event.type == NSEventTypeKeyDown ||
+                        event.type == NSEventTypeKeyUp ||
+                        event.type == NSEventTypeFlagsChanged;
+  const bool mouse = event.type == NSEventTypeLeftMouseDown ||
+                     event.type == NSEventTypeRightMouseDown ||
+                     event.type == NSEventTypeOtherMouseDown ||
+                     event.type == NSEventTypeLeftMouseUp ||
+                     event.type == NSEventTypeRightMouseUp ||
+                     event.type == NSEventTypeOtherMouseUp ||
+                     event.type == NSEventTypeLeftMouseDragged ||
+                     event.type == NSEventTypeRightMouseDragged ||
+                     event.type == NSEventTypeOtherMouseDragged ||
+                     event.type == NSEventTypeScrollWheel;
+  if (!keyboard && !mouse)
+    return std::nullopt;
+  const int64_t source = CGEventGetIntegerValueField(
+      event.CGEvent, kCGEventSourceUnixProcessID);
+  if (source < 0 || source > std::numeric_limits<int>::max() || source == getpid())
+    return std::nullopt;
+  auto* root_widget = frame->GetRenderWidgetHost();
+  auto* view = root_widget ? root_widget->GetView() : nullptr;
+  if (!view || !view->HasNativeInputAdmissionForDocument(document))
+    return std::nullopt;
+  const std::string page_id = PageIdentity::GetOrCreate(profile, contents);
+  auto* catalog = TabCatalog::GetForProfile(profile);
+  auto* egress = EgressController::ForProfile(profile);
+  if (!catalog || catalog->FindPage(page_id) != contents ||
+      !egress || !egress->IsIsolatedPage(contents))
+    return std::nullopt;
+  const auto admitted_ticks = admission.admitted_ticks();
+  base::TimeTicks original_event_ticks;
+  bool original_clock_valid = false;
+  if (std::isfinite(event.timestamp) && event.timestamp > 0 &&
+      base::TimeTicks::IsConsistentAcrossProcesses()) {
+    original_event_ticks = ui::EventTimeStampFromSeconds(event.timestamp);
+    original_clock_valid = !original_event_ticks.is_null() &&
+        original_event_ticks <= admitted_ticks &&
+        ui::EventLatencyTimeFromNative(native_event, admitted_ticks) ==
+            original_event_ticks;
+  }
+  auto retired = egress->RetireForNativePersonInput(
+      contents, document, original_event_ticks, admitted_ticks,
+      original_clock_valid);
+  if (!retired)
+    return std::nullopt;
+  return NativeCdpPersonInput{page_id, document, std::move(*retired),
+                            static_cast<int>(source)};
+}
+}
diff --git a/.native/chrome/browser/ui/aux/native_creator_close_receipt.cc b/.native/chrome/browser/ui/aux/native_creator_close_receipt.cc
new file mode 100644
--- /dev/null
+++ b/.native/chrome/browser/ui/aux/native_creator_close_receipt.cc
@@ -0,0 +1,145 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_creator_close_receipt.h"
+
+#include <utility>
+#include <algorithm>
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/render_frame_host.h"
+
+namespace aux {
+NativeCreatorCloseReceipt::NativeCreatorCloseReceipt(
+    content::WebContents* page, base::TimeTicks original_deadline,
+    base::RepeatingCallback<bool()> current,
+    base::OnceCallback<void(bool)> completion)
+    : content::WebContentsUserData<NativeCreatorCloseReceipt>(*page),
+      content::WebContentsObserver(page),
+      original_document_(page->GetPrimaryMainFrame()->GetWeakDocumentPtr()),
+      original_deadline_(original_deadline),
+      current_(std::move(current)), completion_(std::move(completion)) {
+  // The native creator/lease/transition admission supplies its existing
+  // absolute deadline. Unload callbacks never start a fresh authority window.
+  deadline_timer_.Start(
+      FROM_HERE, std::max(base::TimeDelta(), original_deadline_ - base::TimeTicks::Now()),
+      base::BindOnce(
+          [](base::WeakPtr<NativeCreatorCloseReceipt> receipt,
+             base::UnguessableToken token) {
+            if (receipt) receipt->Refuse(token);
+          }, weak_factory_.GetWeakPtr(), token_));
+}
+NativeCreatorCloseReceipt::~NativeCreatorCloseReceipt() {
+  weak_factory_.InvalidateWeakPtrs();
+  // Userdata removal/replacement is not evidence that its page was closed.
+  Finish(false);
+}
+base::UnguessableToken NativeCreatorCloseReceipt::invocation() const {
+  return active_ ? token_ : base::UnguessableToken();
+}
+bool NativeCreatorCloseReceipt::Current(const base::UnguessableToken& token) {
+  if (token.is_empty() || token != token_ || retired_ || detaching_ ||
+      !current_ || !completion_ || !web_contents() ||
+      original_deadline_.is_null() || base::TimeTicks::Now() >= original_deadline_ ||
+      original_document_.AsRenderFrameHostIfValid() !=
+          web_contents()->GetPrimaryMainFrame()) return false;
+  auto weak = weak_factory_.GetWeakPtr();
+  auto current = current_;
+  const bool valid = current.Run();
+  return weak && valid && !retired_ && !detaching_ && web_contents() &&
+      base::TimeTicks::Now() < original_deadline_ &&
+      original_document_.AsRenderFrameHostIfValid() ==
+          web_contents()->GetPrimaryMainFrame();
+}
+bool NativeCreatorCloseReceipt::Begin(const base::UnguessableToken& token) {
+  if (active_ || !Current(token)) return false;
+  active_ = true;
+  return true;
+}
+void NativeCreatorCloseReceipt::End(const base::UnguessableToken& token) {
+  if (token == token_) { active_ = false; detach_ready_ = false; }
+}
+bool NativeCreatorCloseReceipt::MayDetach(const base::UnguessableToken& token) {
+  if (!active_ || !Current(token)) return false;
+  // This callback-bearing check does not publish successful destruction.
+  // The caller must recheck the original model/member after it returns.
+  detach_ready_ = true;
+  return true;
+}
+bool NativeCreatorCloseReceipt::ConsumeForDetach(
+    const base::UnguessableToken& token) {
+  // No callback or event-loop boundary between these original checks and the
+  // irreversible effect. MayDetach alone cannot make destructor cleanup win.
+  if (token.is_empty() || token != token_ || !active_ || !detach_ready_ ||
+      retired_ || detaching_ || !completion_ || !web_contents() ||
+      original_document_.AsRenderFrameHostIfValid() !=
+          web_contents()->GetPrimaryMainFrame() ||
+      original_deadline_.is_null() || base::TimeTicks::Now() >= original_deadline_)
+    return false;
+  detach_ready_ = false;
+  detaching_ = true;
+  active_ = false;
+  return true;
+}
+void NativeCreatorCloseReceipt::CancelForHuman() {
+  retired_ = true;
+  active_ = false;
+  detach_ready_ = false;
+  current_.Reset();
+  Finish(false);
+}
+void NativeCreatorCloseReceipt::Refuse(const base::UnguessableToken& token) {
+  if (token != token_ || detaching_) return;
+  retired_ = true;
+  active_ = false;
+  detach_ready_ = false;
+  current_.Reset();
+  Finish(false);
+}
+bool NativeCreatorCloseReceipt::MayContinue(const base::UnguessableToken& token) {
+  return Current(token);
+}
+bool NativeCreatorCloseReceipt::QueueHumanClose(base::OnceClosure close) {
+  if (!original_ack_pending_) return false;
+  if (!human_close_) human_close_ = std::move(close);
+  CancelForHuman();
+  return true;
+}
+void NativeCreatorCloseReceipt::AwaitOriginalAck(const base::UnguessableToken& token) {
+  if (token == token_ && !retired_ && !detaching_)
+    original_ack_pending_ = true;
+}
+void NativeCreatorCloseReceipt::OriginalAck(const base::UnguessableToken& token) {
+  if (token != token_) return;
+  original_ack_pending_ = false;
+  if (human_close_)
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, std::move(human_close_));
+}
+void NativeCreatorCloseReceipt::Finish(bool closed) {
+  if (!completion_) return;
+  // Do not reenter tab-strip mutation while it owns its reentrancy guard.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(completion_), closed));
+}
+base::WeakPtr<NativeCreatorCloseReceipt>
+NativeCreatorCloseReceipt::GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+void NativeCreatorCloseReceipt::PrimaryPageChanged(content::Page&) {
+  // A replacement page retires the original callback identity. A queued human
+  // invocation retains its own original document fence and cannot close this
+  // replacement merely because the old renderer callback disappeared.
+  Refuse(token_);
+  OriginalAck(token_);
+}
+void NativeCreatorCloseReceipt::RenderFrameDeleted(content::RenderFrameHost*) {
+  if (!original_document_.AsRenderFrameHostIfValid()) {
+    Refuse(token_);
+    OriginalAck(token_);
+  }
+}
+void NativeCreatorCloseReceipt::WebContentsDestroyed() {
+  human_close_.Reset();
+  original_ack_pending_ = false;
+  Finish(detaching_);
+}
+WEB_CONTENTS_USER_DATA_KEY_IMPL(NativeCreatorCloseReceipt);
+}  // namespace aux
