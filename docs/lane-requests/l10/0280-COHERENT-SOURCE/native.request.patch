+#include "chrome/browser/ui/aux/egress_controller.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "ui/gfx/native_ui_types.h"
+namespace content {
+class NativePlatformInputAdmission;
+}
+namespace aux {
+struct NativeCdpPersonInput {
+  std::string page_id;
+  content::WeakDocumentPtr document;
+  NativeCdpRetirementReceipt retired;
+  int source_pid = 0;
+};
+// Only the original native NSViewHost admission path may call this. It does
+// not read key text/codes, credentials, cookies or sessions. An invalid clock
+// invalidates measurement, never suppresses scoped authority retirement.
+void PublishNativeCdpPersonTakeover(const NativeCdpPersonInput& input);
+std::optional<NativeCdpPersonInput> RetireForNativeCdpPersonInput(
+    const content::NativePlatformInputAdmission& admission);
+}
+#endif
