+    get windowId() {
+      return hostState.windowId;
+    },
+    get privateMode() {
+      return hostState.privateMode;
+    },
+    get windowKind() {
+      return hostState.kind;
+    },
+    pickEvidenceDocument: hostState.pick,
+    saveFile: hostState.saveFile,
+    saveStoredArtifact: hostState.saveArtifact,
