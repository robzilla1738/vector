+  useStore.setState(initial, true);
+});
+afterEach(async () => {
+  await act(async () => root.unmount());
+  host.remove();
+  useStore.setState(initial, true);
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+const render = async (value = receipt) => {
+  await act(async () =>
+    root.render(
