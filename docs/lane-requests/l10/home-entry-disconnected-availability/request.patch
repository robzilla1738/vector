+
+it("keeps disconnected Home switches usable with original held preference acknowledgments", async () => {
+  useStore.setState({ connected: false, settings: { homeEntryMode: "search" } }); await render();
+  const acknowledgments: ((value: unknown) => void)[] = [];
+  const fallback = vi.mocked(bridge.invoke).getMockImplementation()!;
+  vi.mocked(bridge.invoke).mockImplementation((method, params) => method === "settings.set" ? new Promise(resolve => acknowledgments.push(resolve)) : fallback(method, params));
+  let ask!: Promise<unknown>;
+  await act(async () => { modeButton("Ask").focus(); ask = executeCommand("select-home-ask"); });
+  expect(host.querySelector(".home-ask textarea")).not.toBeNull();
+  const askAck = { homeEntryMode: "ask" };
+  await act(async () => { acknowledgments[0]!(askAck); await expect(ask).resolves.toBe(askAck); });
+  let search!: Promise<unknown>;
+  await act(async () => { modeButton("Search").focus(); search = executeCommand("select-home-search"); });
+  expect(host.querySelector(".cmdbar input")).not.toBeNull();
+  const searchAck = { homeEntryMode: "search" };
+  await act(async () => { acknowledgments[1]!(searchAck); await expect(search).resolves.toBe(searchAck); });
+  expect(useStore.getState().connected).toBe(false);
+  expect(vi.mocked(bridge.invoke).mock.calls.filter(([method]) => method === "settings.set").map(([, args]) => args)).toEqual([{ homeEntryMode: "ask" }, { homeEntryMode: "search" }]);
+});
