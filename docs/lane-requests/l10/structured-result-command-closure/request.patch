+  await key(1, "End");
+  expect(document.activeElement).toBe(row(2));
+  await key(2, "ArrowDown");
+  expect(document.activeElement).toBe(row(2));
+  await key(2, "ArrowUp");
+  expect(document.activeElement).toBe(row(1));
+  await key(1, "Home");
+  expect(document.activeElement).toBe(row(0));
+  await key(0, "ArrowUp");
+  expect(document.activeElement).toBe(row(0));
