diff --git a/tests/host/lib/native-command-presentation.mjs b/tests/host/lib/native-command-presentation.mjs
new file mode 100644
--- /dev/null
+++ b/tests/host/lib/native-command-presentation.mjs
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+const readyPrefix = 'AUX_NATIVE_COMMAND_PRESENTATION_READY_V1 ';
+const scopeKeys = ['producer', 'version', 'sampleSequence', 'windowId', 'widgetRoutingId', 'rendererPid', 'nativeDocumentGeneration', 'frameSinkClientId', 'frameSinkSinkId', 'resultsSource', 'surfaceMode'];
+const ticks = ['nativeInputUs', 'nativeReceiptUs', 'rendererInputUs', 'mutationUs', 'commitUs', 'submittedUs', 'receivedUs', 'embeddedUs', 'drawUs', 'presentationUs'];
+function keys(value, expected) { assert.deepEqual(Object.keys(value).sort(), [...expected].sort(), 'Unexpected command receipt fields'); }
+function parse(raw) {
+  assert.equal(typeof raw, 'string'); assert.ok(Buffer.byteLength(raw) <= 4000);
+  // Chromium retains doubles as e.g. 6.0; do not rewrite original scalar bytes.
+  assert.ok(raw.startsWith('{') && raw.endsWith('}'));
+  const property = /"((?:[^"\\]|\\.)*)":(?:"(?:[^"\\]|\\.)*"|-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?|true|false|null)/y;
+  const seen = new Set(); let offset = 1;
+  while (offset < raw.length - 1) {
+    property.lastIndex = offset; const match = property.exec(raw); assert.ok(match, 'Invalid flat native record');
+    const key = JSON.parse('"' + match[1] + '"'); assert.ok(!seen.has(key), 'Duplicate command receipt field'); seen.add(key);
+    offset = property.lastIndex;
+    if (offset < raw.length - 1) { assert.equal(raw[offset], ','); offset++; assert.ok(offset < raw.length - 1); }
+  }
+  assert.equal(offset, raw.length - 1);
+  const value = JSON.parse(raw);
+  assert.ok(value && typeof value === 'object' && !Array.isArray(value)); return value;
+}
+function positive(value) { assert.ok(Number.isSafeInteger(value) && value > 0); }
+function counter(value) { assert.equal(typeof value, 'string'); assert.match(value, /^[1-9][0-9]*$/); assert.ok(BigInt(value) <= 9007199254740991n); }
+function scope(value) {
+  assert.equal(value.producer, 'aux-native-command-presentation'); assert.equal(value.version, 1);
+  counter(value.sampleSequence); counter(value.nativeDocumentGeneration);
+  for (const field of ['windowId', 'widgetRoutingId', 'rendererPid', 'frameSinkClientId', 'frameSinkSinkId']) positive(value[field]);
+  assert.ok(['new-tab', 'edit', 'command'].includes(value.surfaceMode), 'Mode was not observed');
+  assert.equal(value.resultsSource, value.surfaceMode === 'command' ? 'registry' : 'history', 'Observed mode/source mismatch');
+}
+export function decodeNativeCommandReady(raw) {
+  assert.equal(typeof raw, 'string'); assert.ok(raw.startsWith(readyPrefix));
+  const value = parse(raw.slice(readyPrefix.length)); keys(value, [...scopeKeys, 'status']); scope(value); assert.equal(value.status, 'ready');
+  return Object.freeze(value);
+}
+// Original READY and final raw bodies are mandatory; parsed caller labels grant nothing.
+export function decodeNativeCommandPresentation(raw, originalReadyRaw) {
+  const ready = decodeNativeCommandReady(originalReadyRaw), value = parse(raw);
+  keys(value, [...scopeKeys, ...ticks, 'rendererMeasured', 'rendererFailure', 'frameToken', 'activated', 'submittedFrame', 'submissionFailure', 'feedbackFlags', 'nativeInputSourcePid', 'measured', 'elapsedMs', 'status']);
+  scope(value); for (const field of scopeKeys) assert.equal(value[field], ready[field], `Changed original READY ${field}`);
+  assert.equal(value.status, 'measured'); assert.equal(value.measured, true); assert.equal(value.rendererMeasured, true);
+  assert.equal(value.rendererFailure, 0); assert.equal(value.activated, true); assert.equal(value.submittedFrame, true);
+  positive(value.frameToken); assert.ok(value.frameToken <= 0xffffffff);
+  assert.ok(Number.isInteger(value.submissionFailure) && value.submissionFailure < 0);
+  assert.ok(Number.isInteger(value.feedbackFlags) && value.feedbackFlags >= 0 && value.feedbackFlags <= 0xffffffff);
+  assert.ok((value.feedbackFlags & 4) !== 0 && (value.feedbackFlags & 16) === 0, 'Missing successful hardware completion');
+  assert.ok(Number.isInteger(value.nativeInputSourcePid) && value.nativeInputSourcePid >= 0);
+  const time = Object.fromEntries(ticks.map(field => { counter(value[field]); return [field, BigInt(value[field])]; }));
+  assert.equal(time.nativeInputUs, time.rendererInputUs, 'Different original input clocks');
+  assert.ok(time.nativeReceiptUs >= time.nativeInputUs && time.nativeReceiptUs <= time.presentationUs);
+  const ordered = ['nativeInputUs', 'mutationUs', 'commitUs', 'submittedUs', 'receivedUs', 'embeddedUs', 'drawUs', 'presentationUs'];
+  for (let index = 1; index < ordered.length; index++) assert.ok(time[ordered[index]] >= time[ordered[index - 1]], 'Broken command causal timing');
+  const elapsedUs = time.presentationUs - time.nativeInputUs;
+  assert.ok(elapsedUs <= 5000000n); assert.equal(value.elapsedMs, Number(elapsedUs) / 1000);
+  return Object.freeze({ ...value, elapsedUs: String(elapsedUs), firstFrameProven: false, ordinaryNavigationTimingProven: false, datasetCardinalityProven: false, nativeQualificationProven: false });
+}
diff --git a/tests/host/lib/native-command-presentation.test.mjs b/tests/host/lib/native-command-presentation.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/host/lib/native-command-presentation.test.mjs
@@ -0,0 +1,40 @@
+// Synthetic protocol controls, never physical input or performance qualification.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { decodeNativeCommandReady, decodeNativeCommandPresentation } from './native-command-presentation.mjs';
+const scope = { producer: 'aux-native-command-presentation', version: 1, sampleSequence: '1', windowId: 2, widgetRoutingId: 3, rendererPid: 4, nativeDocumentGeneration: '5', frameSinkClientId: 6, frameSinkSinkId: 7, resultsSource: 'history', surfaceMode: 'new-tab' };
+const ready = value => 'AUX_NATIVE_COMMAND_PRESENTATION_READY_V1 ' + JSON.stringify({ ...value, status: 'ready' });
+const sample = () => ({ ...scope, rendererMeasured: true, rendererFailure: 0, frameToken: 9, activated: true, submittedFrame: true, submissionFailure: -1, feedbackFlags: 4, nativeInputUs: '1000000', nativeReceiptUs: '1000010', rendererInputUs: '1000000', mutationUs: '1001000', commitUs: '1002000', submittedUs: '1003000', receivedUs: '1004000', embeddedUs: '1005000', drawUs: '1006000', presentationUs: '1030004', nativeInputSourcePid: 0, measured: true, elapsedMs: 30.004, status: 'measured' });
+test('all actual mode/source pairs retain fractional native hardware interval and no cardinality label', () => {
+  for (const surfaceMode of ['new-tab', 'edit', 'command']) {
+    const value = { ...sample(), surfaceMode, resultsSource: surfaceMode === 'command' ? 'registry' : 'history' };
+    const result = decodeNativeCommandPresentation(JSON.stringify(value), ready(valueScope(value)));
+    assert.equal(result.elapsedUs, '30004'); assert.ok(result.elapsedMs > 30); assert.equal(result.datasetCardinalityProven, false); assert.equal(result.nativeQualificationProven, false);
+  }
+});
+function valueScope(value) { return Object.fromEntries(Object.keys(scope).map(key => [key, value[key]])); }
+for (const [name, mutate] of [
+  ['foreign READY mode', value => { value.surfaceMode = 'edit'; }],
+  ['changed sample', value => { value.sampleSequence = '2'; }],
+  ['changed document', value => { value.nativeDocumentGeneration = '6'; }],
+  ['software feedback', value => { value.feedbackFlags = 0; }],
+  ['failed feedback', value => { value.feedbackFlags = 20; }],
+  ['different renderer input', value => { value.rendererInputUs = '1000001'; }],
+  ['receipt before input', value => { value.nativeReceiptUs = '999999'; }],
+  ['received before submit', value => { value.receivedUs = '1002999'; }],
+  ['missing activation', value => { value.activated = false; }],
+  ['failed submit', value => { value.submissionFailure = 0; }],
+  ['invented elapsed', value => { value.elapsedMs = 30; }],
+  ['overflow timestamp', value => { value.presentationUs = '9007199254740992'; }],
+]) test(`original command pair refuses ${name}`, () => { const value = sample(); mutate(value); assert.throws(() => decodeNativeCommandPresentation(JSON.stringify(value), ready(scope))); });
+test('duplicate/extra fields and unobserved or inconsistent READY refuse', () => {
+  assert.throws(() => decodeNativeCommandReady(ready({ ...scope, surfaceMode: 'unknown' })));
+  assert.throws(() => decodeNativeCommandReady(ready({ ...scope, surfaceMode: 'command' })));
+  assert.throws(() => decodeNativeCommandPresentation(JSON.stringify({ ...sample(), callerMode: 'new-tab' }), ready(scope)));
+  assert.throws(() => decodeNativeCommandPresentation(JSON.stringify(sample()).replace('{', '{"windowId":2,'), ready(scope)));
+});
+
+test('actual Chromium integer-valued double serialization remains original', () => {
+  const raw = JSON.stringify(sample()).replace('\"frameSinkClientId\":6', '\"frameSinkClientId\":6.0');
+  assert.equal(decodeNativeCommandPresentation(raw, ready(scope)).frameSinkClientId, 6);
+});
diff --git a/tests/tools/command-performance-mailbox.test.mjs b/tests/tools/command-performance-mailbox.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/tools/command-performance-mailbox.test.mjs
@@ -0,0 +1,56 @@
+// Real private dirfd transport, synthetic native receipts; no native launch.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, rmSync, readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { createPerformanceMailbox } from '../host/lib/performance-mailbox.mjs';
+const source = { pid: 42, generation: 1 }, method = 'commandPresentationSnapshot';
+const record = { producer: 'aux-native-command-presentation', version: 1, sampleSequence: '9', windowId: 2, widgetRoutingId: 3, rendererPid: 4, nativeDocumentGeneration: '5', frameSinkClientId: 6, frameSinkSinkId: 7, resultsSource: 'history', surfaceMode: 'edit', status: 'ready' };
+const ready = () => Buffer.from('AUX_NATIVE_COMMAND_PRESENTATION_READY_V1 ' + JSON.stringify(record) + '\n');
+const refusal = () => Buffer.from('AUX_NATIVE_FIXTURE_REPLY_V1 ' + JSON.stringify({ producer: 'aux-native-fixture-reply', version: 1, pid: 42, windowId: 2, sequence: '1', operation: method, record: { producer: record.producer, version: 1, windowId: 2, status: 'refused', measured: false, reason: 'cancelled' } }) + '\n');
+async function fixture(body) {
+  const root = mkdtempSync('/private/tmp/aux-native-journey-command-mailbox-'); mkdirSync(join(root, 'profile'), { mode: 0o700 });
+  const mailbox = createPerformanceMailbox({ userDataDir: join(root, 'profile'), ...source });
+  try { await body(mailbox, root); } finally { mailbox.dispose(); rmSync(root, { recursive: true, force: true }); }
+}
+test('fixed command crosses original writer and fragmented same-child READY is retained separately from completion', () => fixture(async (mailbox, root) => {
+  const completion = mailbox.invoke(method), preparation = mailbox.waitForCommandPresentationReady();
+  assert.deepEqual(JSON.parse(readFileSync(join(root, 'performance-request.json'))), { sequence: '1', operation: method });
+  for (const byte of ready()) mailbox.write(Buffer.from([byte]), source);
+  const observed = await preparation; assert.equal(observed.raw, ready().toString().trimEnd()); assert.equal(observed.pid, 42); assert.equal(observed.record.sampleSequence, '9');
+  mailbox.write(refusal(), source); assert.equal(JSON.parse(await completion).status, 'refused'); assert.deepEqual(mailbox.lastReceipt.commandReady, observed);
+}));
+test('preparation refusal rejects READY waiter and retains original final refusal', () => fixture(async mailbox => {
+  const completion = mailbox.invoke(method), preparation = mailbox.waitForCommandPresentationReady(); mailbox.write(refusal(), source);
+  await assert.rejects(preparation, /preparation refused/); assert.equal(JSON.parse(await completion).reason, 'cancelled');
+}));
+for (const kind of ['foreign-child', 'duplicate', 'disposed']) test(`original readiness refuses ${kind}`, () => fixture(async mailbox => {
+  const completion = mailbox.invoke(method); const preparation = mailbox.waitForCommandPresentationReady();
+  if (kind === 'foreign-child') mailbox.write(ready(), { ...source, generation: 2 });
+  else if (kind === 'disposed') mailbox.dispose();
+  else { mailbox.write(ready(), source); await preparation; mailbox.write(ready(), source); }
+  await assert.rejects(completion); if (kind !== 'duplicate') await assert.rejects(preparation);
+}));
+test('unrequested readiness cannot arm or survive into another transaction', () => fixture(async mailbox => {
+  mailbox.write(ready(), source); await assert.rejects(mailbox.invoke(method), /Unrequested/); await assert.rejects(mailbox.waitForCommandPresentationReady(), /Unrequested/);
+}));
+function measured(changes = {}) {
+  const value = { ...record, rendererMeasured: true, rendererFailure: 0, frameToken: 9, activated: true, submittedFrame: true, submissionFailure: -1, feedbackFlags: 4, nativeInputUs: '1000000', nativeReceiptUs: '1000010', rendererInputUs: '1000000', mutationUs: '1001000', commitUs: '1002000', submittedUs: '1003000', receivedUs: '1004000', embeddedUs: '1005000', drawUs: '1006000', presentationUs: '1029999', nativeInputSourcePid: 0, measured: true, elapsedMs: 29.999, status: 'measured', ...changes };
+  return Buffer.from('AUX_NATIVE_FIXTURE_REPLY_V1 ' + JSON.stringify({ producer: 'aux-native-fixture-reply', version: 1, pid: 42, windowId: 2, sequence: '1', operation: method, record: value }) + '\n');
+}
+test('measured final must match original READY and native timing independently', () => fixture(async mailbox => {
+  const completion = mailbox.invoke(method); mailbox.write(ready(), source);
+  const originalReady = await mailbox.waitForCommandPresentationReady(); mailbox.write(measured(), source);
+  assert.equal(JSON.parse(await completion).elapsedMs, 29.999); assert.equal(mailbox.lastReceipt.commandReady.raw, originalReady.raw);
+}));
+for (const kind of ['without-ready', 'changed-mode', 'software-frame']) test(`measured final refuses ${kind}`, () => fixture(async mailbox => {
+  const completion = mailbox.invoke(method);
+  if (kind !== 'without-ready') mailbox.write(ready(), source);
+  mailbox.write(measured(kind === 'changed-mode' ? { surfaceMode: 'new-tab' } : kind === 'software-frame' ? { feedbackFlags: 0 } : {}), source);
+  await assert.rejects(completion);
+}));
+test('later transaction refuses a repeated native sample even with new mailbox sequence', () => fixture(async mailbox => {
+  const first = mailbox.invoke(method); mailbox.write(ready(), source); mailbox.write(refusal(), source); await first;
+  const next = mailbox.invoke(method), preparation = mailbox.waitForCommandPresentationReady(); mailbox.write(ready(), source);
+  await assert.rejects(next, /Stale/); await assert.rejects(preparation, /Stale/);
+}));
