// Only a boolean leaves the page. A failed or incomplete probe is unknown,
// which protects the tab from duplicate cleanup.
constexpr char16_t kUnsavedWorkScript[] = uR"JS((() => {
  try {
    if (document.designMode === 'on' || document.querySelector('[contenteditable="true"], [contenteditable=""], [contenteditable="plaintext-only"]')) return true;
    const fields = document.querySelectorAll('input, textarea, select');
    if (fields.length > 5000) return null;
    for (const field of fields) {
      if (field instanceof HTMLTextAreaElement) {
        if (field.value !== field.defaultValue) return true;
      } else if (field instanceof HTMLSelectElement) {
        const options = Array.from(field.options);
        const defaults = options.filter(option => option.defaultSelected);
        if (defaults.length ? options.some(option => option.selected !== option.defaultSelected)
          : field.multiple ? options.some(option => option.selected)
          : field.selectedIndex > 0) return true;
      } else if (field instanceof HTMLInputElement) {
        if (field.type === 'file') { if (field.files?.length) return true; }
        else if (field.type === 'checkbox' || field.type === 'radio') { if (field.checked !== field.defaultChecked) return true; }
        else if (!['hidden', 'button', 'submit', 'reset', 'image'].includes(field.type) && field.value !== field.defaultValue) return true;
      }
    }
    return false;
  } catch { return null; }
})())JS";

constexpr int kUnsavedWorkWorld = content::ISOLATED_WORLD_ID_CONTENT_END + 8;

class UnsavedWorkRequest : public std::enable_shared_from_this<UnsavedWorkRequest> {
 public:
  using Reply = aux::mojom::ShellHost::RequestCallback;

  using Results = base::OnceCallback<void(base::DictValue)>;

  UnsavedWorkRequest(base::WeakPtr<WebUIBrowserUI> ui, Reply callback)
      : ui_(std::move(ui)), callback_(std::move(callback)) {}
  UnsavedWorkRequest(base::WeakPtr<WebUIBrowserUI> ui, Results results)
      : ui_(std::move(ui)), results_(std::move(results)) {}

  void Start(const base::ListValue& tabs, bool shared_profile = false) {
    shared_profile_ = shared_profile;
    struct Job {
      std::string page_id;
      content::GlobalRenderFrameHostId frame_id;
      int64_t navigation_id;
    };
    std::vector<Job> jobs;
    auto* catalog = aux::TabCatalog::GetForProfile(ui_->browser()->GetProfile());
    for (const auto& value : tabs) {
      const auto& request = value.GetDict();
      const std::string& page_id = *request.FindString("pageId");
      const std::string& url = *request.FindString("url");
      if (items_.contains(page_id)) {
        if (items_[page_id].url != url) items_[page_id].unknown = true;
        continue;
      }
      Item& item = items_[page_id];
      item.url = url;
      BrowserWindowInterface* owner = nullptr;
      content::WebContents* contents = catalog->FindPage(page_id, &owner);
      if (!CanProbe(contents, owner) || contents->IsLoading() ||
          contents->IsCrashed() || contents->GetLastCommittedURL().spec() != url ||
          !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) continue;
      content::RenderFrameHost* main = contents->GetPrimaryMainFrame();
      if (!main || !main->IsRenderFrameLive() ||
          main->GetLastCommittedURL().spec() != url) continue;
      item.navigation_id = main->GetNavigationId();
      main->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
        if (!frame->IsRenderFrameLive()) { item.unknown = true; return; }
        if (item.frames.size() >= 512) { item.unknown = true; return; }
        const auto id = frame->GetGlobalId();
        item.frames.emplace(id, frame->GetNavigationId());
        jobs.push_back({page_id, id, frame->GetNavigationId()});
        ++item.pending;
        ++pending_;
      });
      if (item.frames.empty()) item.unknown = true;
    }
    if (!pending_) { Finish(); return; }
    timer_.Start(FROM_HERE, base::Seconds(5),
                 base::BindOnce([](std::shared_ptr<UnsavedWorkRequest> self) {
                   self->Finish();
                 }, shared_from_this()));
    for (const Job& job : jobs) {
      content::RenderFrameHost* frame = content::RenderFrameHost::FromID(job.frame_id);
      if (!frame) {
        OnResult(job.page_id, job.frame_id, job.navigation_id, base::Value());
        continue;
      }
      frame->ExecuteJavaScriptInIsolatedWorld(
          kUnsavedWorkScript,
          base::BindOnce([](std::shared_ptr<UnsavedWorkRequest> self,
                            std::string page_id,
                            content::GlobalRenderFrameHostId frame_id,
                            int64_t navigation_id, base::Value result) {
            self->OnResult(page_id, frame_id, navigation_id, std::move(result));
          }, shared_from_this(), job.page_id, job.frame_id, job.navigation_id),
          kUnsavedWorkWorld);
    }
  }

 private:
  struct Item {
    std::string url;
    int64_t navigation_id = 0;
    std::map<content::GlobalRenderFrameHostId, int64_t> frames;
    int pending = 0;
    bool dirty = false;
    bool unknown = false;
  };

  void OnResult(const std::string& page_id,
                content::GlobalRenderFrameHostId frame_id,
                int64_t navigation_id,
                base::Value result) {
    if (!callback_ && !results_) return;
    Item& item = items_.at(page_id);
    content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frame_id);
    if (!frame || frame->GetNavigationId() != navigation_id || !result.is_bool())
      item.unknown = true;
    else if (result.GetBool())
      item.dirty = true;
    --item.pending;
    if (--pending_ == 0) Finish();
  }

  void Finish() {
    if (!callback_ && !results_) return;
    timer_.Stop();
    if (!ui_) return;
    auto* catalog = aux::TabCatalog::GetForProfile(ui_->browser()->GetProfile());
    base::DictValue result;
    for (const auto& [page_id, item] : items_) {
      BrowserWindowInterface* owner = nullptr;
      content::WebContents* contents = catalog->FindPage(page_id, &owner);
      bool valid = CanProbe(contents, owner) && !contents->IsLoading() &&
                   !contents->IsCrashed() &&
                   contents->GetLastCommittedURL().spec() == item.url &&
                   contents->GetPrimaryMainFrame() &&
                   contents->GetPrimaryMainFrame()->GetLastCommittedURL().spec() == item.url &&
                   contents->GetPrimaryMainFrame()->GetNavigationId() == item.navigation_id;
      if (valid) {
        std::map<content::GlobalRenderFrameHostId, int64_t> current;
        contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
            [&](content::RenderFrameHost* frame) {
              if (frame->IsRenderFrameLive())
                current.emplace(frame->GetGlobalId(), frame->GetNavigationId());
            });
        valid = current == item.frames;
      }
      result.Set(page_id, !valid || item.unknown || item.pending ? "unknown" :
                          item.dirty ? "dirty" : "clean");
    }
    if (results_) std::move(results_).Run(std::move(result));
    else std::move(callback_).Run(true, *base::WriteJson(result), "", "");
  }

  bool CanProbe(content::WebContents* contents, BrowserWindowInterface* owner) const {
    if (!ui_ || !contents || !owner || !contents->GetPrimaryMainFrame()) return false;
    auto* profile = ui_->browser()->GetProfile();
    if (owner != ui_->browser() && (!shared_profile_ || profile->IsOffTheRecord() ||
        owner->GetProfile() != profile || owner->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
        ui_->browser()->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
        aux::IsLittleWindow(owner) || aux::IsQuickAskWindow(owner) ||
        aux::IsLittleWindow(ui_->browser()) || aux::IsQuickAskWindow(ui_->browser()))) return false;
    const auto* identity = aux::PageIdentity::FromWebContents(contents);
    if (!identity || identity->runtime_owned()) return false;
    aux::EgressRequestContext context;
    context.page_id = aux::PageIdentity::GetOrCreate(profile, contents);
    context.document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
    return !aux::EgressController::ForProfile(profile)->IsProtected(context);
  }
  bool shared_profile_ = false;
  base::WeakPtr<WebUIBrowserUI> ui_;
  Reply callback_;
  Results results_;
  std::map<std::string, Item> items_;
  int pending_ = 0;
  base::OneShotTimer timer_;
};

}  // namespace

void WebUIBrowserUI::HandleAuxTabsRequest(
    const std::string& method, const base::ListValue& args,
    RequestCallback callback) {
  const base::ListValue* list = &args;
  if (method == "archiveTab") {
    if (args.size() != 4 || !args[0].is_string() || !args[1].is_string() ||
        !args[2].is_string() || (!args[3].is_double() && !args[3].is_int())) {
      std::move(callback).Run(false, "", "invalid_argument", "Invalid archive request");
      return;
    }
    const std::string page_id = args[0].GetString();
    const std::string url = args[1].GetString();
    const std::string batch_id = args[2].GetString();
    const double last_active = args[3].GetDouble();
    if (page_id.empty() || page_id.size() > 128 || url.size() > 8192 ||
        batch_id.empty() || batch_id.size() > 200 || (!std::isfinite(last_active) || last_active < 0)) {
      std::move(callback).Run(false, "", "invalid_argument", "Invalid archive identity");
      return;
    }
    base::ListValue request;
    base::DictValue tab;
    tab.Set("pageId", page_id);
    tab.Set("url", url);
    request.Append(std::move(tab));
    auto done = base::BindOnce(
        [](base::WeakPtr<WebUIBrowserUI> ui, std::string page_id, std::string url,
           std::string batch_id, double last_active, RequestCallback callback,
           base::DictValue checks) {
          if (!ui) return;
          const auto respond = [&](bool archived, std::string reason) {
            base::DictValue result;
            result.Set("archived", archived);
            if (!reason.empty()) result.Set("reason", std::move(reason));
            std::move(callback).Run(true, *base::WriteJson(result), "", "");
          };
          Profile* profile = ui->browser()->GetProfile();
          const std::string* clean = checks.FindString(page_id);
          if (profile->IsOffTheRecord() || !clean || *clean != "clean") {
            respond(false, "This tab has unsaved work or could not be checked.");
            return;
          }
          auto* catalog = aux::TabCatalog::GetForProfile(profile);
          BrowserWindowInterface* owner = nullptr;
          auto* contents = catalog->FindPage(page_id, &owner);
          if (!contents || !owner || contents->GetLastCommittedURL().spec() != url ||
              !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() ||
              contents->IsCurrentlyAudible() || contents->IsLoading() ||
              contents->IsCrashed() || contents->NeedToFireBeforeUnloadOrUnloadEvents()) {
            respond(false, "This tab changed or is protected.");
            return;
          }
          const auto* identity = aux::PageIdentity::FromWebContents(contents);
          aux::EgressRequestContext context;
          context.document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
          context.page_id = page_id;
          if (!identity || identity->runtime_owned() ||
              aux::EgressController::ForProfile(profile)->IsProtected(context)) {
            respond(false, "Aux is working in this tab.");
            return;
          }
          const std::string issuer_id = base::NumberToString(ui->browser()->GetSessionID().id());
          std::string error;
          const auto organization = aux::OrganizationStore::Snapshot(profile, issuer_id, &error);
          const auto* layout = organization ? organization->FindDict("layout") : nullptr;
          const auto* shared = layout ? layout->FindDict("shared") : nullptr;
          if (!shared) { respond(false, "Profile organization is unavailable."); return; }
          std::optional<bool> automatic;
          if (const auto* entries = shared->FindList("archivedTabs")) for (const auto& value : *entries) {
            const auto* entry = value.GetIfDict();
            if (!entry) continue;
            const auto* id = entry->FindString("pageId");
            const auto* batch = entry->FindString("batchId");
            const auto* state = entry->FindString("state");
            const auto* reason = entry->FindString("reason");
            const auto* expected_url = entry->FindString("url");
            if (id && *id == page_id && batch && *batch == batch_id && state && *state == "pending" &&
                expected_url && *expected_url == url && reason && (*reason == "manual" || *reason == "auto"))
              automatic = *reason == "auto";
          }
          if (!automatic) { respond(false, "This archive receipt changed."); return; }
          const auto snapshot = catalog->Snapshot();
          const auto* windows = snapshot.FindList("windows");
          const auto* tabs = snapshot.FindList("tabs");
          int64_t elected = std::numeric_limits<int64_t>::max();
          int64_t issuer = 0;
          bool target_found = false;
          if (windows) for (const auto& window_value : *windows) {
            const auto* window = window_value.GetIfDict();
            const auto* kind = window ? window->FindString("windowKind") : nullptr;
            const auto* id = window ? window->FindString("windowId") : nullptr;
            if (!kind || !id || *kind != "normal") continue;
            int64_t numeric = 0;
            if (!base::StringToInt64(*id, &numeric)) continue;
            elected = std::min(elected, numeric);
            const auto* active = window->FindString("activePageId");
            if (*automatic && active && *active == page_id) {
              respond(false, "An active tab stays open."); return;
            }
          }
          if (*automatic && (!base::StringToInt64(issuer_id, &issuer) || elected != issuer)) {
            respond(false, "This window is not the automatic archiver."); return;
          }
          if (tabs) for (const auto& tab_value : *tabs) {
            const auto* tab = tab_value.GetIfDict();
            const auto* id = tab ? tab->FindString("pageId") : nullptr;
            if (!id || *id != page_id) continue;
            const auto* kind = tab->FindString("windowKind");
            const auto activity = tab->FindDouble("lastActiveAt");
            target_found = kind && *kind == "normal" && !tab->FindBool("anchor").value_or(false) &&
                           !tab->FindDict("split") && (!*automatic || (activity && *activity == last_active));
          }
          if (!target_found) { respond(false, "This tab changed or is in a protected window."); return; }
          bool pending = false;
          if (const auto* folder = shared->FindDict("tabFolder"); *automatic && folder && folder->FindString(page_id)) {
            respond(false, "Folder tabs stay open."); return;
          }
          if (const auto* pins = shared->FindDict("pins")) for (const auto [space, value] : *pins) {
            const auto* list = value.GetIfList();
            if (!list) continue;
            for (const auto& pin_value : *list) {
              const auto* pin = pin_value.GetIfDict();
              const auto* id = pin ? pin->FindString("pageId") : nullptr;
              if (id && *id == page_id) { respond(false, "Pinned apps stay open."); return; }
            }
          }
          if (const auto* groups = shared->FindList("splitGroups")) for (const auto& group_value : *groups) {
            const auto* group = group_value.GetIfDict();
            const auto* panes = group ? group->FindList("panes") : nullptr;
            if (panes) for (const auto& pane : *panes) {
              if (pane.is_string() && pane.GetString() == page_id) { respond(false, "Split tabs stay open."); return; }
            }
          }
          if (const auto* entries = shared->FindList("archivedTabs")) for (const auto& entry_value : *entries) {
            const auto* entry = entry_value.GetIfDict();
            const auto* id = entry ? entry->FindString("pageId") : nullptr;
            const auto* batch = entry ? entry->FindString("batchId") : nullptr;
            const auto* state = entry ? entry->FindString("state") : nullptr;
            const auto* reason = entry ? entry->FindString("reason") : nullptr;
            const auto* expected_url = entry ? entry->FindString("url") : nullptr;
            if (state && *state == "pending" && batch && *batch != batch_id) {
              respond(false, "Another archive batch is pending."); return;
            }
            if (id && batch && state && reason && expected_url && *id == page_id &&
                *batch == batch_id && *state == "pending" && *reason == (*automatic ? "auto" : "manual") && *expected_url == url)
              pending = true;
          }
          if (!pending) { respond(false, "This archive receipt changed."); return; }
          auto* model = owner->GetTabStripModel();
          const int index = model->GetIndexOfWebContents(contents);
          if (index < 0 || model->IsTabPinned(index) || model->GetSplitForTab(index)) {
            respond(false, "Pinned and split tabs stay open."); return;
          }
          model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
          respond(!catalog->FindPage(page_id), "");
        }, GetWeakPtr(), page_id, url, batch_id, last_active, std::move(callback));
    std::make_shared<UnsavedWorkRequest>(GetWeakPtr(), std::move(done))->Start(request, true);
    return;
  }
  if (method == "tabSleep") {
    if (list->size() != 2 || !(*list)[0].is_string() || !(*list)[1].is_string()) {
      std::move(callback).Run(false, "", "invalid_argument", "Invalid sleep request");
      return;
    }
    const std::string page_id = (*list)[0].GetString();
    const std::string url = (*list)[1].GetString();
    if (page_id.empty() || page_id.size() > 128 || url.size() > 8192) {
      std::move(callback).Run(false, "", "invalid_argument", "Invalid tab or URL");
      return;
    }
    base::ListValue request;
    base::DictValue tab;
    tab.Set("pageId", page_id);
    tab.Set("url", url);
    request.Append(std::move(tab));
    auto done = base::BindOnce(
        [](base::WeakPtr<WebUIBrowserUI> ui, std::string page_id,
           std::string url, RequestCallback callback, base::DictValue checks) {
          if (!ui) return;
          base::DictValue result;
          const std::string* state = checks.FindString(page_id);
          if (!state || *state != "clean") {
            result.Set("slept", false);
            result.Set("reason", "This tab has unsaved work or could not be checked.");
          } else {
            std::string error;
            const auto organization = aux::OrganizationStore::Snapshot(
                ui->browser()->GetProfile(), "main", &error);
            const auto* layout = organization ? organization->FindDict("layout") : nullptr;
            const auto* shared = layout ? layout->FindDict("shared") : nullptr;
            bool keep_awake = false;
            if (const auto* pins = shared ? shared->FindDict("pins") : nullptr) {
              for (const auto [space, values] : *pins) {
                const auto* list = values.GetIfList();
                if (!list) continue;
                for (const auto& value : *list) {
                  const auto* pin = value.GetIfDict();
                  const auto* id = pin ? pin->FindString("pageId") : nullptr;
                  if (id && *id == page_id && pin->FindBool("keepAwake").value_or(false))
                    keep_awake = true;
                }
              }
            }
            if (!shared || keep_awake) {
              result.Set("slept", false);
              result.Set("reason", keep_awake ? "This pinned app is set to stay awake." : "Profile organization is unavailable.");
            } else {
              result = aux::TabCatalog::GetForProfile(ui->browser()->GetProfile())
                           ->SleepTab(ui->browser(), page_id, url);
            }
          }
          std::move(callback).Run(true, *base::WriteJson(result), "", "");
        }, GetWeakPtr(), page_id, url, std::move(callback));
    std::make_shared<UnsavedWorkRequest>(GetWeakPtr(), std::move(done))
        ->Start(request);
    return;
  }
  if (method == "tabsUnsavedWork") {
    if (list->size() != 1 || !(*list)[0].is_list() ||
        (*list)[0].GetList().size() > 100) {
      std::move(callback).Run(false, "", "invalid_argument",
                              "Choose up to 100 tabs to check");
      return;
    }
    for (const auto& value : (*list)[0].GetList()) {
      const auto* item = value.GetIfDict();
      if (!item || item->size() != 2 || !item->FindString("pageId") ||
          !item->FindString("url") || item->FindString("pageId")->empty() ||
          item->FindString("pageId")->size() > 128 ||
          item->FindString("url")->size() > 8192) {
        std::move(callback).Run(false, "", "invalid_argument",
                                "Invalid tab or URL");
        return;
      }
    }
    std::make_shared<UnsavedWorkRequest>(GetWeakPtr(), std::move(callback))
        ->Start((*list)[0].GetList(), true);
    return;
  }
  if (method == "tabAudio") {
    if (!list->empty()) {
      std::move(callback).Run(false, "", "invalid_argument",
                              "Tab audio takes no arguments");
      return;
    }
    const base::DictValue snapshot =
        aux::TabCatalog::GetForProfile(browser_->GetProfile())->Snapshot();
    base::DictValue audio;
    for (const auto& value : *snapshot.FindList("tabs")) {
      const auto& tab = value.GetDict();
      const std::string* page_id = tab.FindString("pageId");
      if (!page_id) continue;
      base::DictValue state;
      state.Set("muted", tab.FindBool("muted").value_or(false));
      state.Set("audible", tab.FindBool("audible").value_or(false));
      auto* contents = aux::TabCatalog::GetForProfile(browser_->GetProfile())
                           ->FindPage(*page_id);
      state.Set("video", aux::PageHasVideo(contents));
      state.Set("pip", contents && (contents->HasPictureInPictureVideo() ||
                                    contents->HasPictureInPictureDocument()));
      audio.Set(*page_id, std::move(state));
    }
    std::move(callback).Run(true, *base::WriteJson(audio), "", "");
    return;
  }
  if (method == "bindTabSpace" || method == "migrateTabSpaces") {
    const bool migrate = method == "migrateTabSpaces";
    base::ListValue assignments;
    if (!migrate && list->size() == 2 && (*list)[0].is_string() &&
        (*list)[1].is_string()) {
      base::DictValue assignment;
      assignment.Set("pageId", (*list)[0].GetString());
      assignment.Set("spaceId", (*list)[1].GetString());
      assignments.Append(std::move(assignment));
    } else if (migrate && list->size() == 1 && (*list)[0].is_list() &&
               (*list)[0].GetList().size() <= 512) {
      assignments = (*list)[0].GetList().Clone();
    } else {
      std::move(callback).Run(false, "", "invalid_argument", "Invalid Space assignments");
      return;
    }
    if (browser_->GetProfile()->IsOffTheRecord()) {
      std::move(callback).Run(false, "", "forbidden", "Private tabs do not bind to saved Spaces");
      return;
    }
    auto* catalog = aux::TabCatalog::GetForProfile(browser_->GetProfile());
    const auto snapshot = catalog->Snapshot();
    const std::string window_id = base::NumberToString(browser_->GetSessionID().id());
    std::set<std::string> seen;
    base::ListValue pending;
    for (const auto& value : assignments) {
      const auto* item = value.GetIfDict();
      const auto* page_id = item ? item->FindString("pageId") : nullptr;
      const auto* space_id = item ? item->FindString("spaceId") : nullptr;
      if (!page_id || !space_id || page_id->empty() || space_id->empty() ||
          page_id->size() > 128 || space_id->size() > 128 || item->size() != 2) {
        std::move(callback).Run(false, "", "invalid_argument", "Invalid tab or Space identifier");
        return;
      }
      if (!seen.insert(*page_id).second) continue;
      for (const auto& tab_value : *snapshot.FindList("tabs")) {
        const auto& tab = tab_value.GetDict();
        if (tab.FindString("pageId") && *tab.FindString("pageId") == *page_id &&
            tab.FindString("windowId") && *tab.FindString("windowId") == window_id &&
            !tab.FindBool("popup").value_or(false) &&
            !tab.FindBool("runtimeOwned").value_or(false) &&
            (!migrate || !tab.FindString("spaceId"))) {
          auto request = item->Clone();
          request.Set("generation", tab.FindInt("generation").value_or(0));
          request.Set("bindingVersion", ++space_binding_versions_[*page_id]);
          pending.Append(std::move(request));
          break;
        }
      }
    }
    if (!migrate && pending.empty()) {
      std::move(callback).Run(false, "", "not_found", "That tab is unavailable for Space memory");
      return;
    }
    AuxRuntimeHost::ForProfile(browser_->GetProfile())->CallApi(
        "spaces.list", "{}", base::BindOnce(
        [](base::WeakPtr<WebUIBrowserUI> self, base::ListValue pending,
           bool migrate, std::string window_id, RequestCallback callback,
           AuxRuntimeHost::Response response) {
          if (!self) return;
          if (!response.ok) {
            std::move(callback).Run(false, "", response.error_code, response.error_message);
            return;
          }
          auto spaces = base::JSONReader::Read(response.result_json, base::JSON_PARSE_RFC);
          if (!spaces || !spaces->is_list()) {
            std::move(callback).Run(false, "", "internal", "Invalid Space catalog");
            return;
          }
          auto* catalog = aux::TabCatalog::GetForProfile(self->browser_->GetProfile());
          const auto current = catalog->Snapshot();
          int migrated = 0;
          base::DictValue binding;
          for (const auto& value : pending) {
            const auto& request = value.GetDict();
            const auto& page_id = *request.FindString("pageId");
            const auto& space_id = *request.FindString("spaceId");
            if (self->space_binding_versions_[page_id] != request.FindInt("bindingVersion")) continue;
            bool valid_tab = false;
            for (const auto& tab_value : *current.FindList("tabs")) {
              const auto& tab = tab_value.GetDict();
              if (tab.FindString("pageId") && *tab.FindString("pageId") == page_id &&
                  tab.FindString("windowId") && *tab.FindString("windowId") == window_id &&
                  tab.FindInt("generation") == request.FindInt("generation") &&
                  !tab.FindBool("popup").value_or(false) &&
                  !tab.FindBool("runtimeOwned").value_or(false) &&
                  (!migrate || !tab.FindString("spaceId"))) valid_tab = true;
            }
            if (!valid_tab) continue;
            for (const auto& space_value : spaces->GetList()) {
              const auto* space = space_value.GetIfDict();
              if (!space || !space->FindString("id") || *space->FindString("id") != space_id ||
                  space->FindBool("archived").value_or(false)) continue;
              const auto* workspace = space->FindString("workspaceId");
              if (!workspace || workspace->empty() || workspace->size() > 128) continue;
              catalog->BindSpace(page_id, space_id, *workspace);
              binding.Set("spaceId", space_id);
              binding.Set("workspaceId", *workspace);
              ++migrated;
              break;
            }
          }
          if (!migrate && migrated != 1) {
            std::move(callback).Run(false, "", "conflict", "The tab or Space changed. Select it again.");
            return;
          }
          if (migrate) { binding.clear(); binding.Set("migrated", migrated); }
          std::move(callback).Run(true, *base::WriteJson(binding), "", "");
        }, weak_factory_.GetWeakPtr(), std::move(pending), migrate,
           window_id, std::move(callback)));
    return;
  }
  if (method == "tabsSnapshot" || method == "tabsSince") {
    if ((method == "tabsSnapshot" && !list->empty()) ||
        (method == "tabsSince" &&
         (list->size() != 1 || !(*list)[0].is_int()))) {
      std::move(callback).Run(false, "", "invalid_argument",
                              "Invalid tab catalog request");
      return;
    }
    auto* catalog = aux::TabCatalog::GetForProfile(browser_->GetProfile());
    base::DictValue result;
    if (method == "tabsSnapshot") {
      result = catalog->Snapshot();
    } else {
      result.Set("kind", "snapshot");
      result.Set("snapshot", catalog->Snapshot());
    }
    std::move(callback).Run(true, *base::WriteJson(result), "", "");
    return;
  }
  if (method == "tabCommand") {
    if (list->size() < 2 || list->size() > 3 || !(*list)[0].is_string() ||
        !(*list)[1].is_dict() ||
        (list->size() == 3 && !(*list)[2].is_int())) {
      std::move(callback).Run(false, "", "invalid_argument",
                              "Invalid tab command envelope");
      return;
    }
    const std::string& command_id = (*list)[0].GetString();
    if (command_id.size() < 8 || command_id.size() > 128) {
      std::move(callback).Run(false, "", "invalid_argument",
                              "Invalid tab command identifier");
      return;
    }
    const std::optional<int> expected_version =
        list->size() == 3 ? std::optional<int>((*list)[2].GetInt())
                          : std::nullopt;
    base::DictValue ack =
        aux::TabCatalog::GetForProfile(browser_->GetProfile())
            ->Command(browser_, command_id, (*list)[1].GetDict(),
                      expected_version);
    std::move(callback).Run(true, *base::WriteJson(ack), "", "");
    return;
  }
  std::move(callback).Run(false, "", "not_found",
                          "Unsupported Aux shell method: " + method);
}
#endif
