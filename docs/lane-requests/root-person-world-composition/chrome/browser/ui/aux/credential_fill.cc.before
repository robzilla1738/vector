namespace aux {
namespace {

constexpr int kCredentialWorld = content::ISOLATED_WORLD_ID_CONTENT_END + 10;
constexpr size_t kMaxSelector = 1000;

bool ValidSelector(const std::string* selector) {
  if (!selector || selector->empty() || selector->size() > kMaxSelector)
    return false;
  return std::none_of(selector->begin(), selector->end(), [](unsigned char ch) {
    return ch < 0x20 || ch == 0x7f;
  });
}

// A fixed script accepts JSON-encoded selectors only; it never reads values.
// It refuses foreign submission origins, ambiguous targets, hidden fields,
// cross-form usernames, and any non-primary-frame login. The browser repeats
// this check after the user consents and before the password driver fills.
constexpr char kCheckTargetPrefix[] = R"JS((() => {
  const selectors = )JS";
constexpr char kCheckTargetSuffix[] = R"JS(;
  if (document.visibilityState !== 'visible' || document.readyState === 'loading' ||
      location.protocol !== 'https:') return false;
  let password, username;
  try {
    const matches = document.querySelectorAll(selectors.password);
    if (matches.length !== 1) return false;
    password = matches[0];
    if (selectors.username) {
      const users = document.querySelectorAll(selectors.username);
      if (users.length !== 1) return false;
      username = users[0];
    }
  } catch { return false; }
  const usable = el => el instanceof HTMLInputElement && el.isConnected &&
      !el.disabled && !el.readOnly && el.getClientRects().length > 0 &&
      getComputedStyle(el).visibility === 'visible';
  if (!usable(password) || password.type !== 'password' || !password.form ||
      (username && (!usable(username) || username.form !== password.form)))
    return false;
  try {
    if (new URL(password.form.action, location.href).origin !== location.origin)
      return false;
  } catch { return false; }
  password.focus();
  return document.activeElement === password;
})())JS";

base::DictValue Status(const char* status) {
  base::DictValue result;
  result.Set("status", status);
  base::DictValue reply;
  reply.Set("result", std::move(result));
  return reply;
}

}  // namespace

bool CredentialFillRequestAllowed(const base::DictValue& request,
                                  const GURL& active_url,
                                  const url::Origin& frame_origin) {
  for (const auto [key, value] : request) {
    if (key != "pageId" && key != "expectedUrl" &&
        key != "passwordSelector" && key != "usernameSelector")
      return false;
    if (!value.is_string())
      return false;
  }
  const auto* page_id = request.FindString("pageId");
  const auto* expected_url = request.FindString("expectedUrl");
  const auto* password = request.FindString("passwordSelector");
  const auto* username = request.FindString("usernameSelector");
  if (!page_id || page_id->empty() || page_id->size() > 200 ||
      !expected_url || expected_url->size() > 8192 ||
      !ValidSelector(password) || (username && !ValidSelector(username)))
    return false;
  const GURL url(*expected_url);
  return url.is_valid() && url.SchemeIs("https") &&
         !url.has_username() && !url.has_password() &&
         url.spec() == *expected_url && active_url == url &&
         !frame_origin.opaque() && frame_origin == url::Origin::Create(url);
}

bool CredentialFillDocumentMatches(const base::DictValue& request,
                                   const GURL& active_url,
                                   const url::Origin& frame_origin,
                                   int64_t active_navigation_id,
                                   int64_t original_navigation_id) {
  return active_navigation_id == original_navigation_id &&
         CredentialFillRequestAllowed(request, active_url, frame_origin);
}

std::u16string CredentialFillAccountLabel(std::u16string_view username,
                                          bool account_store) {
  std::u16string label;
  for (char16_t character : username.substr(0, 96)) {
    const bool control = character < 0x20 ||
                         (character >= 0x7f && character <= 0x9f) ||
                         character == 0x061c || character == 0x200e ||
                         character == 0x200f ||
                         (character >= 0x2028 && character <= 0x202e) ||
                         (character >= 0x2066 && character <= 0x206f) ||
                         character == 0xfeff;
    label.push_back(control ? u' ' : character);
  }
  if (label.find_first_not_of(u' ') == std::u16string::npos)
    label = u"Saved account";
  label += account_store ? u" · Account store" : u" · This device";
  return label;
}

CredentialFill::CredentialFill(Profile* profile,
                               base::DictValue request,
                               std::shared_ptr<std::atomic_bool> cancelled,
                               Callback callback)
    : profile_(profile),
      request_(std::move(request)),
      callback_(std::move(callback)),
      cancelled_(std::move(cancelled)) {}

CredentialFill::~CredentialFill() = default;

bool CredentialFill::ActiveDocument() const {
  if (cancelled_->load() || !profile_ || profile_->IsOffTheRecord() ||
      !page_ || !frame_)
    return false;
  const std::string* page_id = request_.FindString("pageId");
  const std::string* expected_url = request_.FindString("expectedUrl");
  if (!page_id || !expected_url)
    return false;
  BrowserWindowInterface* owner = nullptr;
  auto* catalog = TabCatalog::GetForProfile(profile_);
  auto* current = catalog ? catalog->FindPage(*page_id, &owner) : nullptr;
  return current == page_.get() && owner && owner->GetProfile() == profile_ &&
         owner->IsActive() &&
         owner->GetTabStripModel()->GetActiveWebContents() == current &&
         current->GetVisibility() == content::Visibility::VISIBLE &&
         current->GetPrimaryMainFrame() == frame_ &&
         CredentialFillDocumentMatches(
             request_, current->GetLastCommittedURL(),
             frame_->GetLastCommittedOrigin(), frame_->GetNavigationId(),
             navigation_id_);
}

void CredentialFill::Start() {
  const std::string* page_id = request_.FindString("pageId");
  const std::string* expected_url = request_.FindString("expectedUrl");
  if (!page_id || !expected_url || !profile_ || profile_->IsOffTheRecord()) {
    Finish("permission_denied");
    return;
  }
  const GURL url(*expected_url);
  if (!CredentialFillRequestAllowed(request_, url,
                                    url::Origin::Create(url))) {
    Finish("permission_denied");
    return;
  }
  BrowserWindowInterface* owner = nullptr;
  auto* catalog = TabCatalog::GetForProfile(profile_);
  auto* page = catalog ? catalog->FindPage(*page_id, &owner) : nullptr;
  if (!page || !owner || owner->GetProfile() != profile_ ||
      !owner->IsActive() ||
      owner->GetTabStripModel()->GetActiveWebContents() != page ||
      page->GetLastCommittedURL() != url ||
      page->GetVisibility() != content::Visibility::VISIBLE) {
    Finish("target_changed");
    return;
  }
  page_ = page->GetWeakPtr();
  frame_ = page->GetPrimaryMainFrame();
  navigation_id_ = frame_ ? frame_->GetNavigationId() : 0;
  if (!frame_ || !CredentialFillRequestAllowed(
                     request_, page->GetLastCommittedURL(),
                     frame_->GetLastCommittedOrigin()) ||
      !ActiveDocument()) {
    Finish("permission_denied");
    return;
  }
  deadline_.Start(FROM_HERE, base::Seconds(55),
                  base::BindOnce(&CredentialFill::Finish,
                                 weak_factory_.GetWeakPtr(), "cancelled"));
  CheckTarget(base::BindOnce(&CredentialFill::OnTargetChecked,
                             weak_factory_.GetWeakPtr()));
}

void CredentialFill::CheckTarget(base::OnceCallback<void(bool)> callback) {
  if (!ActiveDocument()) {
    std::move(callback).Run(false);
    return;
  }
  base::DictValue selectors;
  selectors.Set("password", *request_.FindString("passwordSelector"));
  if (const auto* username = request_.FindString("usernameSelector"))
    selectors.Set("username", *username);
  const auto json = base::WriteJson(selectors);
  if (!json) {
    std::move(callback).Run(false);
    return;
  }
  const std::u16string script = base::UTF8ToUTF16(
      std::string(kCheckTargetPrefix) + *json + kCheckTargetSuffix);
  frame_->ExecuteJavaScriptInIsolatedWorld(
      script,
      base::BindOnce(
          [](base::WeakPtr<CredentialFill> self,
             base::OnceCallback<void(bool)> callback, base::Value value) {
            std::move(callback).Run(self && self->ActiveDocument() &&
                                    value.is_bool() && value.GetBool());
          },
          weak_factory_.GetWeakPtr(), std::move(callback)),
      kCredentialWorld);
}

void CredentialFill::OnTargetChecked(bool valid) {
  if (!valid) {
    Finish("target_changed");
    return;
  }
  std::vector<scoped_refptr<password_manager::PasswordStoreInterface>> stores;
  if (auto store = ProfilePasswordStoreFactory::GetForProfile(
          profile_, ServiceAccessType::EXPLICIT_ACCESS))
    stores.push_back(std::move(store));
  if (auto store = AccountPasswordStoreFactory::GetForProfile(
          profile_, ServiceAccessType::EXPLICIT_ACCESS))
    stores.push_back(std::move(store));
  if (stores.empty()) {
    Finish("unavailable");
    return;
  }
  pending_stores_ = stores.size();
  const GURL url(*request_.FindString("expectedUrl"));
  password_manager::PasswordFormDigest digest(
      password_manager::PasswordForm::Scheme::kHtml,
      url::Origin::Create(url).GetURL().spec(), url);
  for (const auto& store : stores)
    store->GetLogins(digest, weak_factory_.GetWeakPtr());
}

void CredentialFill::OnGetPasswordStoreResultsOrErrorFrom(
    password_manager::PasswordStoreInterface* store,
    password_manager::LoginsResultOrError results) {
  if (!callback_)
    return;
  const GURL url(*request_.FindString("expectedUrl"));
  const auto origin = url::Origin::Create(url);
  if (auto* logins = std::get_if<password_manager::LoginsResult>(&results)) {
    for (auto& login : *logins) {
      auto form = password_manager::ToPasswordForm(std::move(login));
      if (form.scheme == password_manager::PasswordForm::Scheme::kHtml &&
          form.signon_realm == origin.GetURL().spec() &&
          url::Origin::Create(form.url) == origin &&
          !form.blocked_by_user && !form.password_value.empty())
        credentials_.push_back(std::move(form));
    }
  }
  if (--pending_stores_ > 0)
    return;
  if (!ActiveDocument()) {
    Finish("target_changed");
    return;
  }
  if (credentials_.empty()) {
    Finish("unavailable");
    return;
  }
  std::vector<std::u16string> accounts;
  for (const auto& form : credentials_)
    accounts.push_back(CredentialFillAccountLabel(
        form.username_value, form.IsUsingAccountStore()));
  prompt_ = ShowCredentialFillPrompt(
      origin.Serialize(), accounts,
      base::BindOnce(&CredentialFill::OnAccountChosen,
                     weak_factory_.GetWeakPtr()));
  if (!prompt_)
    Finish("permission_denied");
}

void CredentialFill::OnAccountChosen(std::optional<size_t> index) {
  prompt_.reset();
  if (!index || *index >= credentials_.size()) {
    Finish("cancelled");
    return;
  }
  if (!ActiveDocument()) {
    Finish("target_changed");
    return;
  }
  auto* factory = password_manager::ContentPasswordManagerDriverFactory::
      FromWebContents(page_.get());
  auto* client = factory ? factory->password_client() : nullptr;
  authenticator_ = client ? client->GetDeviceAuthenticator() : nullptr;
  if (!authenticator_ ||
      !authenticator_->CanAuthenticateWithBiometricOrScreenLock()) {
    Finish("permission_denied");
    return;
  }
  authenticator_->AuthenticateWithMessage(
      u"Approve Aux filling this saved password",
      base::BindOnce(&CredentialFill::OnAuthenticated,
                     weak_factory_.GetWeakPtr(), *index));
}

void CredentialFill::OnAuthenticated(size_t index, bool authorized) {
  authenticator_.reset();
  if (!authorized) {
    Finish("permission_denied");
    return;
  }
  if (!ActiveDocument()) {
    Finish("target_changed");
    return;
  }
  CheckTarget(base::BindOnce(&CredentialFill::OnTargetRechecked,
                             weak_factory_.GetWeakPtr(), index));
}

void CredentialFill::OnTargetRechecked(size_t index, bool valid) {
  if (!valid || !ActiveDocument()) {
    Finish("target_changed");
    return;
  }
  auto* driver = password_manager::ContentPasswordManagerDriver::
      GetForRenderFrameHost(frame_);
  if (!driver) {
    Finish("unavailable");
    return;
  }
  // This is the only point where a saved value leaves the browser process,
  // through Chromium's password fill IPC to the owning renderer.
  const auto& form = credentials_[index];
  if (!EgressController::ForProfile(profile_)->ProtectCredential(
          frame_, form.username_value, form.password_value.value())) {
    Finish("target_changed");
    return;
  }

  driver->FillSuggestion(
      form.username_value, form.password_value.value(),
      base::BindOnce(&CredentialFill::OnFilled, weak_factory_.GetWeakPtr()));
}

void CredentialFill::OnFilled(bool success) {
  Finish(success && ActiveDocument() ? "filled" : "target_changed");
}

void CredentialFill::Finish(const char* status) {
  if (!callback_)
    return;
  deadline_.Stop();
  weak_factory_.InvalidateWeakPtrs();
  if (authenticator_)
    authenticator_->Cancel();
  authenticator_.reset();
  if (prompt_) {
    prompt_->Close();
    prompt_.reset();
  }
  credentials_.clear();
  auto callback = std::move(callback_);
  std::move(callback).Run(Status(status));
}

}  // namespace aux
