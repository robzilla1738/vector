+bool CopyOutputRequest::SetAuxPersonCaptureFrames(std::vector<SurfaceId> surfaces, std::vector<uint32_t> tokens) {
+  if (surfaces.size() > 64 || surfaces.size() != tokens.size()) return false;
+  for (size_t i = 0; i < surfaces.size(); ++i) {
+    if (!surfaces[i].is_valid() || !tokens[i]) return false;
+    for (size_t j = 0; j < i; ++j) if (surfaces[i].frame_sink_id() == surfaces[j].frame_sink_id()) return false;
+  }
+  aux_person_capture_surfaces_ = std::move(surfaces);
+  aux_person_capture_tokens_ = std::move(tokens);
+  return true;
 }
 
