+// Copyright 2026 The Aux Authors
+#ifndef CHROME_COMMON_AUX_PERSON_CAPTURE_MASK_H_
+#define CHROME_COMMON_AUX_PERSON_CAPTURE_MASK_H_
+namespace aux::person_capture_mask {
+inline constexpr char16_t kProgram[] = uR"AUXMASK(// Fixed browser-owned isolated-world program; no caller script or selector.
+// Browser must retain each original frame WeakDocument, wait for its paint ACK,
+// and restore these same documents before exporting any captured pixels.
+(function(operation, captureId) {
+  'use strict';
+  const key = '__auxPersonCaptureOriginalMask';
+  if (!/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/.test(captureId)) return false;
+  if (operation === 'begin') {
+    if (globalThis[key]) return false;
+    if (!document.documentElement || document.designMode.toLowerCase() !== 'off') return false;
+    const elements = [], roots = [document], allRoots = [];
+    let examined = 0;
+    while (roots.length) {
+      const root = roots.pop(); allRoots.push(root);
+      for (const node of root.querySelectorAll('*')) {
+        if (++examined > 10000 || elements.length >= 2000 || allRoots.length > 64) return false;
+        if (node.shadowRoot) roots.push(node.shadowRoot);
+        // Custom elements may contain closed shadow roots. Mask the entire
+        // host conservatively; its descendants cannot override group opacity.
+        if (node.matches('input,textarea,select,[contenteditable]') || node.localName.includes('-')) {
+          if (getComputedStyle(node).display === 'contents') return false;
+          elements.push(node);
+        }
+      }
+    }
+    const originals = elements.map(node => ({node, style:node.getAttribute('style'), maskedStyle:node.getAttribute('style'), foreignStyle:false}));
+    const state = {captureId, originals, dirty:false, observer:null};
+    const foreign = records => {
+      if (records.length) state.dirty = true;
+      for (const record of records) if (record.type === 'attributes' && record.attributeName === 'style') {
+        const item = originals.find(item => item.node === record.target);
+        if (item) item.foreignStyle = true;
+      }
+    };
+    state.foreign = foreign;
+    globalThis[key] = state;
+    try {
+      // Start before a style write may synchronously invoke author custom
+      // element callbacks. Only the exact single original style mutation is
+      // our write; every other begin-time mutation refuses pixel export.
+      state.observer = new MutationObserver(foreign);
+      for (const root of allRoots) state.observer.observe(root,{subtree:true,childList:true,attributes:true,attributeOldValue:true,characterData:true});
+      for (const item of originals) {
+        const before = item.node.getAttribute('style');
