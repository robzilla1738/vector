+void PictureInPictureWindowManager::RegisterNativeBrowserDocumentAppearanceForTesting(
+    BrowserWindowInterface* browser, views::Widget* widget) {
+  if (!aux::NativePipAppearanceObservationEnabled() || !browser || !widget ||
+      browser->GetType() != BrowserWindowInterface::TYPE_PICTURE_IN_PICTURE) return;
+  if (!native_appearance_registry_for_testing_)
+    native_appearance_registry_for_testing_ = std::make_unique<aux::NativePipAppearanceRegistry>();
+  const auto weak_browser = browser->GetWeakPtr();
+  const auto weak_widget = widget->GetWeakPtr();
+  native_appearance_registry_for_testing_->RegisterBrowserDocument(browser, widget,
+      base::BindRepeating([](PictureInPictureWindowManager* manager, base::WeakPtr<BrowserWindowInterface> weak_browser, base::WeakPtr<views::Widget> weak_widget) -> std::optional<aux::NativePipOwner> {
+        if (!weak_browser || !weak_widget || !weak_browser->GetWindow() ||
+            weak_browser->GetType() != BrowserWindowInterface::TYPE_PICTURE_IN_PICTURE ||
+            weak_browser->GetWindow()->GetNativeWindow() != weak_widget->GetNativeWindow() ||
+            !weak_browser->GetTabStripModel() || !manager->pip_window_controller_) return std::nullopt;
+        auto* child = manager->pip_window_controller_->GetChildWebContents();
+        if (!child || weak_browser->GetTabStripModel()->GetActiveWebContents() != child) return std::nullopt;
+        return aux::NativePipOwner{weak_browser->GetProfile(), manager->pip_window_controller_->GetWebContents(),
+                                  child, manager->pip_window_controller_.get()};
+      }, base::Unretained(this), weak_browser, weak_widget));
+}
