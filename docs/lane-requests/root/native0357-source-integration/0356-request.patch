+// static
+bool PictureInPictureWindowManager::IsChildWebContents(
+    content::WebContents* wc) {
+  auto* instance =
+      base::Singleton<PictureInPictureWindowManager>::GetIfExists();
+  if (!instance) {
+    // No manager => no pip window.
+    return false;
+  }
+
+  return instance->GetChildWebContents() == wc;
+}
