    const x = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width)), y = Math.max(0, Math.min(1, (event.clientY - bounds.top) / bounds.height));
    setRegion({ x: Math.min(x, start.current.x), y: Math.min(y, start.current.y), width: Math.abs(x - start.current.x), height: Math.abs(y - start.current.y) });
  }} onPointerUp={() => { start.current = null; }} onPointerCancel={() => { start.current = null; }}>
    <img src={capture.dataUrl} alt=\"Capture to review before attaching\" draggable={false}/>
    {region && <span className=\"capture-region\" style={{ left: `${region.x * 100}%`, top: `${region.y * 100}%`, width: `${region.width * 100}%`, height: `${region.height * 100}%` }}/>}</div>;
  const current = () => operationCurrent(operationOwner.current) && operationOwner.current.chatId === chatId && currentChat.current === chatId;
  const imageCurrent = (item: ConversationImage) => current() && imageMatches(item);
  const captureCurrent = () => current() && !!capture && !operationOwner.current.locked;
  const captureActions = <div className=\"capture-actions\"><ConversationImageAction command=\"cancel-conversation-image\" className=\"btn sm ghost\" disabled={busy} current={captureCurrent} invoke={cancelCapture}>Cancel</ConversationImageAction>{region && <ConversationImageAction command=\"use-whole-conversation-image\" className=\"btn sm ghost\" disabled={busy} current={captureCurrent} invoke={() => setRegion(null)}>Use whole image</ConversationImageAction>}<ConversationImageAction command=\"attach-conversation-image\" className=\"btn sm\" disabled={disabled || busy} current={captureCurrent} invoke={saveCapture}>Attach {region ? \"region\" : \"image\"}</ConversationImageAction></div>;
  const triggers = <div className=\"capture-triggers\"><ConversationImageAction command=\"attach-conversation-document\" className=\"btn sm\" disabled={disabled || busy} current={current} invoke={onDocument}>Document</ConversationImageAction><ConversationImageAction command=\"choose-conversation-image\" className=\"btn sm\" disabled={disabled || busy || images.length >= 4} current={current} invoke={chooseImage}>Image</ConversationImageAction><ConversationImageAction command=\"capture-conversation-page\" className=\"btn sm\" disabled={disabled || busy || !canCapture || images.length >= 4} title={captureDisabledReason} current={() => current() && !!canCapture && pageCurrent()} invoke={() => takeCapture()}>Capture</ConversationImageAction><ConversationImageAction command=\"select-conversation-image-region\" originalRef={lassoTrigger} className=\"btn sm\" disabled={disabled || busy || !onPage || images.length >= 4} title={onPage ? \"Select directly on the visible page\" : \"Show this page by itself to select an area\"} current={() => current() && !!onPage && pageCurrent() && useStore.getState().mode === \"focus\" && useStore.getState().activePageId === page?.pageId && !useStore.getState().splitPageId} invoke={() => takeCapture(true)}>Select area</ConversationImageAction></div>;
  const showRest = (showAttachedImages && images.length > 0) || !!error || busy || !!capture || !!preview;
  return <><section className=\"conversation-captures\" aria-label=\"Image references\">
    {detachedTools ? toolsTarget && createPortal(triggers, toolsTarget) : triggers}
    {showRest && <div className=\"conversation-capture-rest\">
    {images.length >= 4 && <p className=\"hint\">Four images attached. Remove one to add another.</p>}
    {error && <p className=\"field-error\" role=\"alert\">{error}</p>}
    {busy && <output className=\"hint\" data-block>Preparing image…</output>}
    {showAttachedImages && images.map(item => <div className=\"conversation-document\" key={item.imageId}><label htmlFor={`${imageScope}-${item.imageId}`}><ConversationImageChoice id={`${imageScope}-${item.imageId}`} checked={item.included} disabled={disabled || busy} current={() => imageCurrent(item)} invoke={included => change(item.imageId, included)}/><span><b>{item.filename}</b><small>{item.width} × {item.height} · {Math.ceil(item.byteLength / 1024)} KB</small></span></label><ConversationImageAction command=\"preview-conversation-image\" className=\"btn sm ghost\" disabled={busy} current={() => imageCurrent(item)} invoke={() => inspect(item.imageId)}>Preview</ConversationImageAction><ConversationImageAction command=\"remove-conversation-image\" className=\"icon-btn xs\" aria-label={`Remove ${item.filename}`} disabled={disabled || busy} current={() => imageCurrent(item)} invoke={() => change(item.imageId)}>{shellIconClose}</ConversationImageAction></div>)}
    {capture && !lasso && <div className=\"capture-editor\" ref={review}>
      <p className=\"hint\">{capture.title} · {capture.sourceUrl ? hostOf(capture.sourceUrl) : \"Local image\"}</p>
      <p className=\"hint\">Drag to select a region. Editable fields are hidden in page captures. Keyboard: arrows move it; Shift + arrows resize it. Escape clears the selection.</p>
      {selection}
      {captureActions}
    </div>}
    {preview && <div ref={review}><ImagePreview snapshot={preview} onClose={() => setPreview(null)} closeControl={<ConversationImageAction command=\"cancel-conversation-image\" className=\"icon-btn xs\" aria-label=\"Close image preview\" current={current} invoke={() => setPreview(null)}>{shellIconClose}</ConversationImageAction>} /></div>}
    </div>}
  </section>{capture && lasso && overlay === \"capture\" && createPortal(<div className=\"page-lasso\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Select an area of the captured page\">
    <div className=\"page-lasso-image\" style={{ left: lasso.bounds.left + (lasso.bounds.width - Math.min(lasso.bounds.width / lasso.width, lasso.bounds.height / lasso.height) * lasso.width) / 2, top: lasso.bounds.top + (lasso.bounds.height - Math.min(lasso.bounds.width / lasso.width, lasso.bounds.height / lasso.height) * lasso.height) / 2, width: Math.min(lasso.bounds.width / lasso.width, lasso.bounds.height / lasso.height) * lasso.width, height: Math.min(lasso.bounds.width / lasso.width, lasso.bounds.height / lasso.height) * lasso.height }}>{selection}</div>
    <div className=\"page-lasso-bar\"><span>{capture.title} · Drag to select · Editable fields hidden</span>{captureActions}</div>
  </div>, document.body)}</>;
}
