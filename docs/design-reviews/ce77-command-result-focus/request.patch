+it('keeps the editing input focused until a primary result click selects once', async () => {
+  const select = vi.fn(), blur = vi.fn();
+  await act(async () => root.render(<><input aria-label="Editing query" onBlur={blur} /><SearchResultRow id="current-tab" title="Aux native Red" detail="127.0.0.1" query="Red" icon="T" selected resultSource="registry" resultGeneration={7} onSelect={select} onHover={() => {}} /></>));
+  const input = host.querySelector('input')!;
+  const option = host.querySelector('[role="option"]')!;
+  input.focus();
+  const down = new MouseEvent('mousedown', { bubbles: true, cancelable: true, button: 0 });
+  await act(async () => { option.dispatchEvent(down); });
+  expect(down.defaultPrevented).toBe(true);
+  expect(document.activeElement).toBe(input);
+  expect(blur).not.toHaveBeenCalled();
+  expect(select).not.toHaveBeenCalled();
+  await act(async () => { option.dispatchEvent(new MouseEvent('mouseup', { bubbles: true, button: 0 })); option.dispatchEvent(new MouseEvent('click', { bubbles: true, button: 0 })); });
+  expect(select).toHaveBeenCalledOnce();
+  expect(option.getAttribute('data-command-result-generation')).toBe('7');
+  expect(option.getAttribute('data-command-result-source')).toBe('registry');
+});
