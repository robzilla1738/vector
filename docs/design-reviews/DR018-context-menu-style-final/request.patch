diff --git a/apps/shell/src/components/ConversationContextMenu.css b/apps/shell/src/components/ConversationContextMenu.css
new file mode 100644
index 00000000..0664d9eb
--- /dev/null
+++ b/apps/shell/src/components/ConversationContextMenu.css
@@ -0,0 +1,16 @@
+@layer components {
+.home-tools-trigger { margin-left:auto; }
+.home-tools-trigger > button { width:28px; height:28px; padding:0; justify-content:center; }
+.home-tools-menu .capture-triggers { display:grid; gap:var(--space-1); }
+.home-tools-menu .capture-triggers > button { justify-content:flex-start; width:100%; min-height:36px; padding:var(--space-2); text-align:left; background:transparent; box-shadow:none; border:0; }
+.home-tools-menu .capture-triggers > button:hover { background:var(--bg-hover); }
+.home-tools-context { padding:var(--space-2) 0; margin:var(--space-2) 0; border-block:var(--hairline) solid var(--line); }
+.home-tools-menu .conversation-browser-context { width:100%; justify-items:stretch; margin:0; }
+.home-tools-menu .conversation-browser-context-controls { flex-wrap:wrap; justify-content:flex-start; }
+.home-tools-menu .dictation-trigger { min-height:36px; padding:var(--space-2); }
+.home-context-summary { display:flex; align-items:center; gap:var(--space-2); max-width:100%; width:fit-content; padding:var(--space-2); border-radius:var(--r-pill); background:var(--bg-hover); color:var(--ink-2); font-size:var(--fs-xs); }
+.home-context-summary > span:not(.ci) { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
+/* The same explicit context choices remain available in narrow menus. */
+.home-tools-menu .conversation-browser-context-controls > :not(.browser-context-trigger) { display:flex; }
+.conversation:not(.conversation-home) .home-tools-trigger > button { width:auto; min-width:28px; padding:var(--space-1) var(--space-2); gap:var(--space-1); }
+}
