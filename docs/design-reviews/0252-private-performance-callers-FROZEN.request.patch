+        if len(body) > 512 or os.write(temporary, body) != len(body):
+            raise ValueError("incomplete bounded mailbox")
+        os.fsync(temporary)
+        validate(value, fd)
+        os.rename(TEMP, FILE, src_dir_fd=fd, dst_dir_fd=fd)
+        os.fsync(fd)
