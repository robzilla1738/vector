+        os.close(temporary)
+        try:
+            os.unlink(TEMP, dir_fd=fd)
+        except FileNotFoundError:
+            pass
+
+
+def parse(body):
+    if len(body) > 1024:
+        raise ValueError("oversized fixed request")
