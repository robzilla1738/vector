+  return realpath(path, resolved) && std::strcmp(path, resolved) == 0 &&
+      stat(resolved, &named) == 0 && named.st_dev == identity->st_dev &&
+      named.st_ino == identity->st_ino && S_ISDIR(named.st_mode);
