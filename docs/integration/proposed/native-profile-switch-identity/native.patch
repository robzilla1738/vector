+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+void Browser::CommitAuxProfileSwitchIdentity(
+    Profile* target,
+    std::unique_ptr<ScopedProfileKeepAlive> prepared_keep_alive) {
+  CHECK(aux_profile_switch_in_progress_);
+  CHECK(aux_profile_switch_suppress_empty_);
+  CHECK_EQ(type_, TYPE_NORMAL);
+  CHECK(profile_->IsRegularProfile());
+  CHECK(target);
+  CHECK(target->IsRegularProfile());
+  CHECK_NE(profile_.get(), target);
+  CHECK(prepared_keep_alive);
+  CHECK_EQ(prepared_keep_alive->profile(), target);
+  CHECK(tab_strip_model_->empty());
+  CHECK(!IsDeleteScheduled());
+  // Called inside the manager's synchronous ownership-transfer closure. No
+  // view/controller callbacks are emitted until all authoritative identities
+  // agree. The window, SessionID, model and its delegate remain unchanged.
+  profile_keep_alive_ = std::move(prepared_keep_alive);
+  profile_ = target;
+  tab_strip_model_->RebindProfileForAuxProfileSwitch(
+      target, base::PassKey<Browser>());
+}
+
+uint32_t Browser::SuppressEmptyForAuxProfileSwitch() {
+  aux_profile_switch_suppress_empty_ = true;
+  return ++aux_profile_switch_generation_;
+}
+
+void Browser::PostClearAuxProfileSwitchEmptySuppression(uint32_t generation) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&Browser::ClearAuxProfileSwitchEmptySuppression,
+                     weak_factory_.GetWeakPtr(), generation));
+}
+
+void Browser::ClearAuxProfileSwitchEmptySuppression(uint32_t generation) {
+  if (generation == aux_profile_switch_generation_) {
+    aux_profile_switch_suppress_empty_ = false;
+  }
+}
+#endif
