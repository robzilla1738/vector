+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+void TabStripModel::RebindProfileForAuxProfileSwitch(
+    Profile* profile,
+    base::PassKey<Browser>) {
+  CHECK(profile);
+  CHECK(profile->IsRegularProfile());
+  CHECK(profile_->IsRegularProfile());
+  CHECK(!reentrancy_guard_);
+  CHECK(empty());
+  CHECK(selection_model_.empty());
+  CHECK(!group_model_ || group_model_->ListTabGroups().empty());
+  // The detached collections retain their actual tabs and BrowserContexts;
+  // this changes only the stable, currently empty model's service identity.
+  profile_ = profile;
+}
