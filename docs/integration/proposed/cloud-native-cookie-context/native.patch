 Profile* DevToolsBrowserContextManager::GetProfileById(
     const std::string& context_id) {
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+  // Explicit, unguessable native IDs may resolve only already-loaded regular
+  // Aux profiles. Never substitute the last-used profile or load a disk path.
+  auto* manager = g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (manager) {
+    for (auto* candidate : manager->GetLoadedProfiles()) {
+      if (candidate->IsRegularProfile() && !candidate->IsOffTheRecord() &&
+          candidate->UniqueId() == context_id)
+        return candidate;
+    }
+  }
+#else
   Profile* default_profile =
       ProfileManager::GetLastUsedProfile()->GetOriginalProfile();
   if (context_id == default_profile->UniqueId()) {
     return default_profile;
   }
+#endif
   auto it = otr_profiles_.find(context_id);
   if (it == otr_profiles_.end())
     return nullptr;
