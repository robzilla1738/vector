+bool OmniboxPopupViewWebUI::CanPrepareForAuxProfileSwitch() const {
+  const auto reject = [](const char* stage) {
+    LOG(ERROR) << "Aux profile transition rejected: " << stage;
+    return false;
+  };
+  if (aux_profile_switch_paused_)
+    return reject("classic-idle.view-paused");
+  if (!presenter_)
+    return reject("classic-idle.presenter-missing");
+  if (!edit_model_observation_.IsObserving())
+    return reject("classic-idle.model-observer");
+  if (controller()->edit_model()->user_input_in_progress())
+    return reject("classic-idle.input-in-progress");
+  if (!controller()->autocomplete_controller()->done())
+    return reject("classic-idle.autocomplete-running");
+  if (controller()->popup_state_manager()->popup_state() !=
+      OmniboxPopupState::kNone)
+    return reject("classic-idle.popup-state");
+  if (!presenter_->CanRetireIdleClassicForAuxProfileSwitch()) {
+    LOG(ERROR) << "Aux profile transition rejected: classic-idle.presenter";
+    return false;
+  }
+  auto* content = presenter_->GetWebUIContent();
+  if (!content || !content->CanRetireIdleForAuxProfileSwitch()) {
+    LOG(ERROR) << "Aux profile transition rejected: classic-idle.content-interaction";
+    return false;
+  }
+  return true;
+}
+
+void OmniboxPopupViewWebUI::PrepareForAuxProfileSwitch() {
+  CHECK(CanPrepareForAuxProfileSwitch());
+  aux_profile_switch_paused_ = true;
+  edit_model_observation_.Reset();
+  // Synchronous presenter destruction drains its widget deletion queue and
+  // destroys the source WebContents, Mojo handlers and profile observations
+  // before OmniboxController destroys the old AutocompleteController.
+  presenter_.reset();
+}
+
+void OmniboxPopupViewWebUI::ResumeAfterAuxProfileSwitch() {
+  CHECK(aux_profile_switch_paused_);
+  CHECK(!presenter_);
+  // Both commit and abort restore a coherent client/profile before this call.
+  presenter_ = std::make_unique<OmniboxPopupPresenter>(
+      location_bar_, *presenter_delegate_, controller());
+  edit_model_observation_.Observe(controller()->edit_model());
+  aux_profile_switch_paused_ = false;
+}
