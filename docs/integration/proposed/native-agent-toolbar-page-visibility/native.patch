 namespace {
 
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+// Observed supplied presentation: Agent pages already contain their assistant.
+// Only committed state is used; a pending navigation cannot hide the action.
+bool IsCommittedAgentToolbarPage(BrowserWindowInterface* browser) {
+  const auto* tab = browser->GetActiveTabInterface();
+  const auto* contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return false;
+  }
+  const GURL& url = contents->GetLastCommittedURL();
+  return (url.SchemeIs(extensions::kExtensionScheme) &&
+          url.host() == aux::kAgentExtensionId) ||
+         (url.SchemeIs(content::kChromeUIScheme) &&
+          url.host() == chrome::kChromeUINewTabHost);
+}
+#endif
