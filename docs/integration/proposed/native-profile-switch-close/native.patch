+void Browser::CloseAuxProfileSwitchWorkspaces() {
+  const auto* owner_state = BrowserInitState::From(this);
+  if (!owner_state || owner_state->is_aux_profile_switch_cache()) {
+    return;
+  }
+  const uint64_t owner_id = owner_state->aux_profile_switch_workspace_id();
+  std::vector<base::WeakPtr<BrowserWindowInterface>> caches;
+  for (auto* window : GetAllBrowserWindowInterfaces()) {
+    const auto* state = BrowserInitState::From(window);
+    if (window != this && state && state->is_aux_profile_switch_cache() &&
+        state->aux_profile_switch_workspace_id() == owner_id &&
+        !window->IsDeleteScheduled()) {
+      caches.push_back(window->GetWeakPtr());
+    }
+  }
+  // Snapshot weak identities first: real close observers can remove peers.
+  for (const auto& weak : caches) {
+    if (!weak) {
+      continue;
+    }
+    auto* window = weak.get();
+    const auto* state = BrowserInitState::From(window);
+    auto* unload = UnloadController::From(window);
+    if (!state || !state->is_aux_profile_switch_cache() ||
+        state->aux_profile_switch_workspace_id() != owner_id || !unload ||
+        unload->is_attempting_to_close_browser() ||
+        unload->is_delete_scheduled()) {
+      continue;
+    }
+    // Positive role+owner identity comes only from the real desktop Browser
+    // cache factory. Never close an arbitrary same-profile user window.
+    auto* cache = static_cast<Browser*>(window);
+    if (auto* service = GetAppropriateSessionServiceForProfile(window)) {
+      service->WindowClosing(window->GetSessionID());
+    }
+    cache->SuppressEmptyForAuxProfileSwitch();
+    while (!cache->GetTabStripModel()->empty()) {
+      cache->GetTabStripModel()->DetachAndDeleteWebContentsAt(0);
+    }
+    // Current155 requires the real did-close event followed by its normal
+    // posted owner deletion, rather than deleting during observer callbacks.
+    unload->OnWindowCloseComplete();
+  }
+}
