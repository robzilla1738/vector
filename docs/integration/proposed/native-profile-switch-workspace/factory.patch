+void BrowserInitState::KeepAuxProfileSwitchProfileAlive(Profile* profile) {
+  if (!profile) {
+    return;
+  }
+  profile = profile->GetOriginalProfile();
+  if (!profile || profile->IsOffTheRecord() || profile->GetPath().empty() ||
+      aux_profile_switch_keep_alives_.contains(profile->GetPath())) {
+    return;
+  }
+  auto keep_alive = ScopedProfileKeepAlive::TryAcquire(
+      profile, ProfileKeepAliveOrigin::kBrowserWindow);
+  if (keep_alive) {
+    aux_profile_switch_keep_alives_.emplace(profile->GetPath(),
+                                          std::move(keep_alive));
+  }
+}
