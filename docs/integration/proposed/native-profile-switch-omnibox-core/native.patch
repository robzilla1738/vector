+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+void OmniboxEditModel::ResetForAuxProfileSwitch() {
+  CHECK(!user_input_in_progress_);
+  weak_factory_.InvalidateWeakPtrs();
+  // Retire actual old-profile upload/session ownership; never preserve a
+  // contextual search handle or provider match in the new profile.
+  query_contextualizer_.reset();
+  query_contextualizer_delegate_.reset();
+  session_handle_.reset();
+  query_contextualizer_initialized_ = false;
+  Revert();
+  rich_suggestion_bitmaps_.clear();
+  icon_bitmaps_.clear();
+}
+#endif
