+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+void OmniboxController::RebindClientForAuxProfileSwitch(
+    std::unique_ptr<OmniboxClient> client) {
+  CHECK(client);
+  CHECK(edit_model_->view());
+  CHECK(!IsPopupOpen());
+  CHECK(!edit_model_->user_input_in_progress());
+  // The actual view/popup observe this same controller and edit model. Retire
+  // old async results before destroying provider-backed matches or services.
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  StopAutocomplete(/*clear_result=*/true);
+  edit_model_->ResetForAuxProfileSwitch();
+  autocomplete_controller_->RemoveObserver(this);
+  autocomplete_controller_.reset();
+  client_ = std::move(client);
+  CreateAutocompleteController(autocomplete_stop_timer_duration_);
+  autocomplete_controller_->AddObserver(this);
+}
+#endif
 
