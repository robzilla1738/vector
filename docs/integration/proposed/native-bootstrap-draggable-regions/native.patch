+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+void BrowserView::AuxPopupDraggableRegionsChanged(
+    const std::vector<blink::mojom::DraggableRegionPtr>& regions,
+    content::WebContents* contents) {
+  const auto& app_name = BrowserInitState::From(browser())->create_params().app_name;
+  if ((app_name != "aux-account-password-popup" &&
+       app_name != "aux-extension-popup") ||
+      !contents || contents != GetActiveWebContents()) {
+    return;
+  }
+  SkRegion result;
+  for (const auto& region : regions) {
+    result.op(SkIRect::MakeLTRB(region->bounds.x(), region->bounds.y(),
+                              region->bounds.right(), region->bounds.bottom()),
+              region->draggable ? SkRegion::kUnion_Op
+                                : SkRegion::kDifference_Op);
+  }
+  aux_popup_draggable_contents_ = contents->GetWeakPtr();
+  aux_popup_draggable_region_ = std::move(result);
+}
+
+void BrowserView::ClearAuxPopupDraggableRegions(content::WebContents* contents) {
+  if (aux_popup_draggable_contents_.get() == contents) {
+    aux_popup_draggable_contents_.reset();
+    aux_popup_draggable_region_.reset();
+  }
+}
+
+bool BrowserView::IsPointInAuxPopupDraggableRegion(const gfx::Point& point) {
+  const auto& app_name = BrowserInitState::From(browser())->create_params().app_name;
+  if ((app_name != "aux-account-password-popup" &&
+       app_name != "aux-extension-popup") ||
+      !aux_popup_draggable_region_ ||
+      !aux_popup_draggable_contents_ ||
+      aux_popup_draggable_contents_.get() != GetActiveWebContents()) {
+    return false;
+  }
+  auto* contents_view = GetActiveContentsWebView();
+  if (!contents_view) return false;
+  gfx::Point in_contents(point);
+  views::View::ConvertPointToTarget(this, contents_view, &in_contents);
+  return contents_view->GetLocalBounds().Contains(in_contents) &&
+         aux_popup_draggable_region_->contains(in_contents.x(), in_contents.y());
+}
+#endif
