+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+void BrowserWebContentsDelegate::AuxPopupTabMembershipChanged(
+    content::WebContents* contents, bool inserted) {
+  const auto& app_name = BrowserInitState::From(&*browser_)->create_params().app_name;
+  if (app_name != "aux-account-password-popup" &&
+      app_name != "aux-extension-popup") {
+    return;
+  }
+  // Original3355fd8 enables the renderer producer on insertion;33555b8
+  // disables it before detaching. This is not a PWA display-mode feature.
+  contents->SetSupportsDraggableRegions(inserted);
+  if (!inserted) {
+    if (auto* view = BrowserView::GetBrowserViewForBrowser(&*browser_))
+      view->ClearAuxPopupDraggableRegions(contents);
+  }
+}
