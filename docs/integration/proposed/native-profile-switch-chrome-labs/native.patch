+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+bool ChromeLabsCoordinator::CanRebindForAuxProfileSwitch() const {
+  return !aux_profile_switch_prepared_ && !aux_callback_depth_ &&
+         browser_->GetProfile()->IsRegularProfile() &&
+         From(browser_) == this && chrome_labs_action_item_ &&
+         chrome_labs_action_item_ == actions::ActionManager::Get().FindAction(
+             kActionShowChromeLabs,
+             BrowserActions::From(browser_)->root_action_item()) &&
+         !chrome_labs_bubble_view_tracker_.view() &&
+         !controller_ && !flags_storage_ && !flags_state_ &&
+         pinned_actions_observation_.IsObservingSource(
+             PinnedToolbarActionsModel::Get(browser_->GetProfile())) &&
+         std::ranges::none_of(aux_live_widgets_,
+                              [](const auto& widget) { return !!widget; });
+}
+
+void ChromeLabsCoordinator::PrepareForAuxProfileSwitch() {
+  CHECK(CanRebindForAuxProfileSwitch());
+  aux_source_profile_ = browser_->GetProfile()->GetWeakPtr();
+  aux_profile_switch_prepared_ = true;
+  pinned_actions_observation_.Reset();
+  chrome_labs_action_item_ = nullptr;
+}
+
+void ChromeLabsCoordinator::BindForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(!aux_callback_depth_);
+  CHECK(!pinned_actions_observation_.IsObserving());
+  CHECK(!chrome_labs_bubble_view_tracker_.view());
+  CHECK(!controller_ && !flags_storage_ && !flags_state_);
+  pinned_actions_observation_.Observe(
+      PinnedToolbarActionsModel::Get(browser_->GetProfile()));
+  chrome_labs_action_item_ = actions::ActionManager::Get().FindAction(
+      kActionShowChromeLabs, BrowserActions::From(browser_)->root_action_item());
+  CHECK(chrome_labs_action_item_);
+  aux_profile_switch_prepared_ = false;
+  aux_source_profile_.reset();
+  // Existing implementation reads actual target experiment state and actual
+  // newly rebuilt pinned button. Do not write flags or fabricate a notification.
+  MaybeInstallDotIndicator();
+}
+
+void ChromeLabsCoordinator::RebindForAuxProfileSwitch(Profile* target_profile) {
+  CHECK(target_profile && target_profile->IsRegularProfile());
+  CHECK_EQ(browser_->GetProfile(), target_profile);
+  CHECK(browser_->GetTabStripModel()->empty());
+  BindForAuxProfileSwitch();
+}
+
+void ChromeLabsCoordinator::AbortForAuxProfileSwitch(Profile* source_profile) {
+  CHECK(aux_source_profile_);
+  CHECK_EQ(source_profile, aux_source_profile_.get());
+  CHECK_EQ(browser_->GetProfile(), source_profile);
+  auto* model = browser_->GetTabStripModel();
+  CHECK(model);
+  for (int index = 0; index < model->count(); ++index) {
+    CHECK_EQ(model->GetWebContentsAt(index)->GetBrowserContext(), source_profile);
+  }
+  BindForAuxProfileSwitch();
+}
+
+base::ScopedClosureRunner ChromeLabsCoordinator::EnterAuxProfileCallback() {
+  ++aux_callback_depth_;
+  return base::ScopedClosureRunner(base::BindOnce(
+      &ChromeLabsCoordinator::LeaveAuxProfileCallback,
+      aux_weak_factory_.GetWeakPtr()));
+}
+
+void ChromeLabsCoordinator::LeaveAuxProfileCallback() {
+  CHECK_GT(aux_callback_depth_, 0u);
+  --aux_callback_depth_;
+}
