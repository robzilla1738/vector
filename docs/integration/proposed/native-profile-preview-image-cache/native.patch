 void ProfilePagePreviewPageView::SetCapturedImage(const gfx::ImageSkia& image) {
+  // Original4654f/4655108: an actual borrowed live host takes precedence.
+  if (live_host_->GetVisible()) {
+    return;
+  }
   captured_image_->SetImage(ui::ImageModel::FromImageSkia(image));
+  captured_image_->SetVisible(!image.isNull());
+  fallback_->SetVisible(image.isNull());
+  InvalidateLayout();
 }
 void ProfilePagePreviewPageView::ShowLiveContent(bool live) {
+  // Original4658d3c /4658374: active live/fallback presentation retires the
+  // cached image, rather than drawing metadata over a stale captured sidebar.
+  captured_image_->SetImage(ui::ImageModel());
+  captured_image_->SetVisible(false);
   live_host_->SetVisible(live);
   fallback_->SetVisible(!live);
   InvalidateLayout();
