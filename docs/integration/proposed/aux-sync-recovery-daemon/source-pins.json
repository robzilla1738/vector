  "edits": [
    {
      "name": "actual daemon client and confirmed enrollment bridge",
      "find": "async function enrollAccountSyncKeyRecovery(Cn){let ei=await fetchAccountSyncKeyStatus(Cn);if(ei.state===`ready`)return ei;if(!ei.canEnroll)throw Error(`Recover encrypted browser data on this device before enabling account recovery.`);let ti=await readLocalChromeSyncKey(Cn);if(!ti||ti.byteLength!==32)throw ti?.fill(0),Error(`The encrypted browser data key is unavailable on this device.`);try{return await fetchAuxAPIAuthenticatedJson(Cn,`/sync/key/enroll`,{method:`POST`,body:{cskB64:toBase64(ti)},output:accountSyncKeyStatusSchema.pick({state:!0,syncGeneration:!0,revision:!0})})}finally{ti.fill(0)}}",
      "replace": "var auxSyncRecoveryPendingEnrollments=new Map;\nfunction getAuxSyncRecoveryContext(accountId){\n if(process.platform!==`darwin`||!Number.isSafeInteger(accountId)||accountId<0)throw Error(`Aux browser recovery requires macOS`);\n let userId=getAuthenticatedUserId(accountId),generation=readAccessTokenSyncGeneration(AccountRegistry.getSession(accountId)?.accessToken);\n if(typeof userId!==`string`||!userId||!Number.isSafeInteger(generation)||generation<0)throw Error(`Sign in before recovering browser data.`);\n return{userId,generation};\n}\nfunction auxSyncRecoveryApiCode(error,code){\n return error instanceof AuxApiError&&error.status===409&&(error.code===code||error.details?.response?.status===409&&error.details?.error?.error?.code===code);\n}\nfunction makeAuxSyncRecoveryClient(accountId){\n return new AuxSyncRecoveryClient({\n  context:getAuxSyncRecoveryContext,\n  request:(id,path,body)=>{if(id!==accountId||!path.startsWith(`/sync/recovery/v2/`))throw Error(`Invalid account recovery request`);return fetchAuxAPIAuthenticatedJson(id,path,{method:`POST`,body,timeoutMs:2e4,output:{parse(value){if(!value||typeof value!==`object`||Array.isArray(value))throw Error(`Invalid Aux recovery response`);return value}}})},\n  sign:bytes=>signCdpChallenge(bytes),\n  readCsk:async id=>{let before=getAuxSyncRecoveryContext(id),state=await evaluateLocalChromeSyncKey(id),after=getAuxSyncRecoveryContext(id);if(before.userId!==after.userId||before.generation!==after.generation)throw Error(`Account changed during recovery.`);if(state.status===`missing`)return null;if(state.status!==`usable_owned`||state.syncGeneration!==before.generation)throw Error(`Existing Sync key requires explicit ownership or generation migration`);return readLocalChromeSyncKey(id)},\n  publishRecoveredCsk:(id,key,expected)=>publishAuxRecoveredCsk(id,key,expected),\n  status:id=>fetchAccountSyncKeyStatus(id),\n  isRecoveryNotConfigured:error=>auxSyncRecoveryApiCode(error,`RECOVERY_NOT_CONFIGURED`)\n });\n}\nasync function enrollAccountSyncKeyRecovery(accountId,recoveryEntropyB64){\n // Existing UI sends only accountId: do not generate an unseen recovery key.\n if(typeof recoveryEntropyB64!==`string`||!recoveryEntropyB64)throw new AuxApiError(409,`Save and verify your 12-word Aux browser recovery key before enabling recovery.`,`SYNC_RECOVERY_CONFIRMATION_REQUIRED`);\n let entropy=Buffer.from(recoveryEntropyB64,`base64`),digest;\n try{if(entropy.length!==16||entropy.toString(`base64`)!==recoveryEntropyB64)throw Error(`Use the 12-word Aux browser recovery key.`);digest=createHash(`sha256`).update(entropy).digest(`hex`)}finally{entropy.fill(0)}\n let context=getAuxSyncRecoveryContext(accountId),pending=auxSyncRecoveryPendingEnrollments.get(accountId);\n if(pending&&(pending.context.userId!==context.userId||pending.context.generation!==context.generation||pending.digest!==digest)){\n  if(pending.inFlight)throw Error(`An account recovery enrollment is already in progress`);\n  auxSyncRecoveryPendingEnrollments.delete(accountId);pending=void 0;\n }\n if(!pending){pending={context,digest,prepared:void 0,inFlight:void 0};auxSyncRecoveryPendingEnrollments.set(accountId,pending)}\n if(pending.inFlight)return pending.inFlight;\n let record=pending,client=makeAuxSyncRecoveryClient(accountId);\n let operation=(async()=>{try{\n  record.prepared??=await client.prepareConfirmedEnrollment(accountId,recoveryEntropyB64);\n  let response=await client.publishEnrollment(record.prepared);\n  if(auxSyncRecoveryPendingEnrollments.get(accountId)===record)auxSyncRecoveryPendingEnrollments.delete(accountId);\n  return{state:response.state,syncGeneration:response.syncGeneration,revision:response.revision};\n }catch(error){\n  if(auxSyncRecoveryApiCode(error,`RECOVERY_CHALLENGE_INVALID`)||auxSyncRecoveryApiCode(error,`RECOVERY_STATE_CHANGED`))if(auxSyncRecoveryPendingEnrollments.get(accountId)===record)auxSyncRecoveryPendingEnrollments.delete(accountId);\n  throw error;\n }finally{record.inFlight=void 0}})();record.inFlight=operation;return operation;\n}\n",
      "count": 1
    },
    {
      "name": "actual recovery delegates to paired Aux-v2 client",
      "find": "async function recoverAccountSyncKey(Cn,ei){throw Error(`This legacy cryptographic operation is unavailable in this macOS Aux build`)}",
      "replace": "async function recoverAccountSyncKey(accountId,recoveryEntropyB64){getAuxSyncRecoveryContext(accountId);return makeAuxSyncRecoveryClient(accountId).recover(accountId,recoveryEntropyB64)}",
      "count": 1
    },
    {
      "name": "same mutation with optional explicitly confirmed entropy",
      "find": "enrollSyncKeyRecovery:accountProcedure.mutation(({input:Cn})=>enrollAccountSyncKeyRecovery(Cn.accountId))",
      "replace": "enrollSyncKeyRecovery:accountProcedure.input(object({recoveryEntropyB64:string$3().min(1).optional()})).mutation(({input:Cn})=>enrollAccountSyncKeyRecovery(Cn.accountId,Cn.recoveryEntropyB64))",
      "count": 1
    }
