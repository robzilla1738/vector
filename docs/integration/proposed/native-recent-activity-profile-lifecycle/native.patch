+bool RecentActivityBubbleCoordinator::CanPauseForAuxProfileSwitch() const {
+  // Hide clears the tracker before asynchronous widget destruction finishes.
+  // The observation must also be gone before profile-bound rows can migrate.
+  return !aux_profile_switch_paused_ && !tracker_.view() &&
+         !bubble_widget_observation_.IsObserving();
+}
+
+void RecentActivityBubbleCoordinator::PauseForAuxProfileSwitch() {
+  CHECK(CanPauseForAuxProfileSwitch());
+  aux_profile_switch_paused_ = true;
+}
+
+void RecentActivityBubbleCoordinator::ResumeForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_paused_);
+  CHECK(!tracker_.view());
+  CHECK(!bubble_widget_observation_.IsObserving());
+  // No Profile or service is cached by the dormant coordinator. Future Show
+  // calls construct their original bubble with the caller's current profile.
+  aux_profile_switch_paused_ = false;
+}
