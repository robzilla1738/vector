 namespace {
 
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+void PinSuppliedAgentAction(Profile* profile,
+                            extensions::ExtensionPrefs* prefs,
+                            bool has_action) {
+  if (profile->IsOffTheRecord() || !has_action) {
+    return;
+  }
+  auto pinned = prefs->GetPinnedExtensions();
+  if (!std::ranges::contains(pinned, aux::kAgentExtensionId)) {
+    pinned.push_back(aux::kAgentExtensionId);
+    prefs->SetPinnedExtensions(pinned);
+  }
+}
+#endif
+
 // These values are persisted to logs. Entries should not be renumbered and
 // numeric values should never be reused.
