+// Exact native reservation owns the observer ticket and the original runtime
+// lease. The observer's private callback fires only after a real complete cohort
+// fence AND the original direct reaper; no JS-provided PID/proof enters here.
+template <class Reservation>
+aux::descendants::Ticket ReserveDescendantCohort(
+    const std::shared_ptr<Worker>& worker,
+    const std::shared_ptr<Reservation>& reservation, bool pty) {
+  std::weak_ptr<Worker> weak_worker = worker;
+  std::weak_ptr<Reservation> weak_reservation = reservation;
+  return aux::descendants::Reserve(worker->generation,
+      [weak_worker, weak_reservation, pty] {
+        auto owner = weak_worker.lock();
+        auto item = weak_reservation.lock();
+        if (!owner || !item || getpid() != kHostProcess) return;
+        std::shared_ptr<RuntimeScope> runtime;
+        bool closed = false;
+        {
+          std::lock_guard<std::mutex> lock(owner->mutex);
+          if (item->descendant_completed) return;
+          item->descendant_completed = true;
+          if (item->descendant_counted) {
+            auto& pending = pty ? owner->pty_descendant_pending
+                                : owner->exec_descendant_pending;
+            if (!pending) {
+              if (pty) owner->pty_descendants_unknown = true;
+              else owner->exec_descendants_unknown = true;
+              return;
+            }
+            --pending;
+            runtime = item->runtime_scope;
+          }
+          closed = owner->terminal;
+        }
+        if (runtime) RuntimeChildCohortSettled(runtime);
+        if (closed) owner->Close();
+        DetachCompletedEnvironment(owner);
+      });
+}
