+bool ValidHandoffEntries(const AuxUiCacheCohort::Entries& entries, bool target) {
+  if (entries.size() > 65536) return false;
+  size_t total = 0;
+  std::optional<std::vector<uint16_t>> previous;
+  for (const auto& entry : entries) {
+    if (!entry || entry->key.size() > 8192 ||
+        entry->key.size() + entry->value.size() > 8 * 1024 * 1024 - total) return false;
+    total += entry->key.size() + entry->value.size();
+    if (previous && *previous >= entry->key) return false;
+    previous = entry->key;
+    std::string name;
+    std::vector<uint8_t> raw;
+    for (uint16_t unit : entry->key) {
+      if (unit < 0x20 || unit > 0x7e) return false;
+      name.push_back(static_cast<char>(unit)); raw.push_back(static_cast<uint8_t>(unit));
+    }
+    auto local_raw = raw;
+    local_raw.insert(local_raw.begin(), 1);
+    if (!AuxUiCacheCohort::IsReviewedKey(raw, false) &&
+        !AuxUiCacheCohort::IsReviewedKey(local_raw, true)) return false;
+    if (!target) continue;
+    bool current = name.starts_with("aux.chat-draft.v3:") ||
+                   name.starts_with("aux.chat-draft-text.v1:");
