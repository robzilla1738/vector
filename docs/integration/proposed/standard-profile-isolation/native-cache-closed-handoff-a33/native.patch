+bool StorageAreaImpl::AuxUiHandoffSourceMatches(
+    const AsyncDomStorageDatabase::AuxUiMapSnapshot* map) const {
+  if (!map_locator_) return false;
+  const bool ui_origin = map_locator_->storage_key().origin() == url::Origin::Create(
+      GURL("chrome-extension://gokkffaiccpmoeodpmeamcjajcagjmkm/"));
+  // Null means an actual non-UI native receiver owner. It cannot fabricate an
+  // empty Aux renderer/cache/source proof for a privileged UI origin.
+  if (!map) return !ui_origin;
+  if (!ui_origin || !MatchesAuxUiMigrationMap(*map)) return false;
+  const bool local = map_locator_->session_ids().empty();
+  size_t found = 0;
+  if (map_state_ == MapState::LOADED_KEYS_AND_VALUES) {
+    for (const auto& [key, value] : keys_values_map_) {
+      if (!AuxUiCacheCohort::IsReviewedKey(key, local)) continue;
+      auto entry = map->source.find(key);
+      if (entry == map->source.end() || entry->second != value) return false;
+      ++found;
+    }
+  } else if (map_state_ == MapState::LOADED_KEYS_ONLY) {
+    for (const auto& [key, size] : keys_only_map_) {
+      if (!AuxUiCacheCohort::IsReviewedKey(key, local)) continue;
+      auto entry = map->source.find(key);
+      if (entry == map->source.end() || entry->second.size() != size) return false;
+      ++found;
+    }
+  } else {
+    // The real AsyncDB owns complete disk CAS/sync/readback. An actually
+    // unloaded native view contains no values to relabel or newly invent.
+    return map_state_ == MapState::UNLOADED;
+  }
+  return found == map->source.size();
+}
+void StorageAreaImpl::HandoffAuxUiMigrationCaches(const base::UnguessableToken& original,
+    const base::UnguessableToken& next,
+    const AsyncDomStorageDatabase::AuxUiMapSnapshot* map,
+    AsyncDomStorageDatabase::StatusCallback callback) {
+  if (aux_cache_handoff_original_) {
+    ReadAuxUiMigrationCacheHandoff(original, next, map, std::move(callback)); return;
+  }
+  RunAuxUiCacheHandoff(original, next, map, false, std::move(callback));
+}
+void StorageAreaImpl::ReadAuxUiMigrationCacheHandoff(const base::UnguessableToken& original,
+    const base::UnguessableToken& next,
+    const AsyncDomStorageDatabase::AuxUiMapSnapshot* map,
+    AsyncDomStorageDatabase::StatusCallback callback) {
+  if (aux_cache_handoff_original_ != original || aux_cache_handoff_next_ != next ||
+      bool(map) != bool(aux_cache_handoff_map_) ||
+      (map && (map->storage_key != aux_cache_handoff_map_->storage_key ||
+               map->session_ids != aux_cache_handoff_map_->session_ids ||
+               map->map_id != aux_cache_handoff_map_->map_id ||
+               map->source != aux_cache_handoff_map_->source ||
+               map->target != aux_cache_handoff_map_->target))) {
+    std::move(callback).Run(DbStatus::IOError("Exact original native map handoff correlation differs")); return;
+  }
+  RunAuxUiCacheHandoff(original, next, map, true, std::move(callback));
+}
+void StorageAreaImpl::RunAuxUiCacheHandoff(const base::UnguessableToken& original,
+    const base::UnguessableToken& next,
+    const AsyncDomStorageDatabase::AuxUiMapSnapshot* map, bool observation_only,
+    AsyncDomStorageDatabase::StatusCallback callback) {
+  if (original.is_empty() || next.is_empty() || original == next || aux_cache_callback_ ||
+      (aux_cache_request_ != original &&
+       !(aux_cache_handoff_complete_ && aux_cache_request_ == next)) ||
+      has_pending_load_tasks() || commit_batch_ || commit_batches_in_flight_ ||
+      !database_ || !database_->IsAuxUiMigrationHeld() ||
+      aux_cache_holds_.size() != aux_cache_participants_.size() + 1 ||
+      aux_cache_prepared_count_ != aux_cache_holds_.size() ||
+      aux_cache_handoff_history_.size() >= 128 ||
+      (!aux_cache_handoff_complete_ && !AuxUiHandoffSourceMatches(map))) {
+    std::move(callback).Run(DbStatus::IOError("Actual restored native map/cohort owner is not held")); return;
+  }
+  if (!aux_cache_handoff_original_) {
+    aux_cache_handoff_original_ = original; aux_cache_handoff_next_ = next;
+    aux_cache_handoff_map_ = map ?
+        std::make_unique<AsyncDomStorageDatabase::AuxUiMapSnapshot>(*map) : nullptr;
+  }
+  aux_cache_handoff_observe_ = observation_only;
+  aux_cache_handoff_error_.reset(); aux_cache_cursor_ = 0;
+  aux_cache_callback_ = std::move(callback);
+  AuxUiCacheHandoffNext(DbStatus::OK());
+}
+void StorageAreaImpl::AuxUiCacheHandoffNext(DbStatus status) {
+  if (!status.ok() && !aux_cache_handoff_error_) aux_cache_handoff_error_ = std::move(status);
+  if (aux_cache_cursor_ == aux_cache_holds_.size()) {
+    if (!aux_cache_handoff_error_ &&
+        (has_pending_load_tasks() || commit_batch_ || commit_batches_in_flight_ ||
+         !database_ || !database_->IsAuxUiMigrationHeld() ||
+         aux_cache_holds_.size() != aux_cache_participants_.size() + 1 ||
+         (!aux_cache_handoff_complete_ && !AuxUiHandoffSourceMatches(aux_cache_handoff_map_.get()))))
+      aux_cache_handoff_error_ = DbStatus::IOError("Native source/cohort changed during closed handoff");
+    if (!aux_cache_handoff_error_ && !aux_cache_handoff_complete_) {
+      // All actual cohorts have the same closed successor before this native
+      // request advances. Old map/recovery source stays separately retained.
+      aux_cache_retired_map_ = std::move(aux_cache_map_);
+      aux_cache_map_ = aux_cache_handoff_map_ ?
+          std::make_unique<AsyncDomStorageDatabase::AuxUiMapSnapshot>(*aux_cache_handoff_map_) : nullptr;
+      aux_cache_request_ = aux_cache_handoff_next_;
+      aux_cache_handoff_complete_ = true;
+    }
+    auto callback = std::move(aux_cache_callback_);
+    std::move(callback).Run(aux_cache_handoff_error_.value_or(DbStatus::OK())); return;
+  }
+  auto participant = aux_cache_holds_[aux_cache_cursor_++];
+  if (!participant) {
+    AuxUiCacheHandoffNext(DbStatus::IOError("Original actual cache participant was destroyed")); return;
+  }
+  auto reply = mojo::WrapCallbackWithDefaultInvokeIfNotRun(base::BindOnce(
+      &StorageAreaImpl::AuxUiCacheHandoffNext, weak_ptr_factory_.GetWeakPtr()),
+      DbStatus::IOError("Actual closed cache handoff acknowledgment remains unknown"));
+  AuxUiCacheCohort::Entries source, target;
+  if (aux_cache_handoff_map_) {
+    auto decoded = AuxUiCacheCohort::DecodeSelected(aux_cache_handoff_map_->source,
+        map_locator_->session_ids().empty());
+    auto destination = AuxUiCacheCohort::DecodeSelected(aux_cache_handoff_map_->target,
+        map_locator_->session_ids().empty());
+    if (!decoded.has_value() || !destination.has_value()) {
+      std::move(reply).Run(DbStatus::NotSupported("Exact native handoff source codec refused")); return;
+    }
+    source = std::move(decoded).value();
+    target = std::move(destination).value();
+  }
+  // Continue through every original participant even after a refusal so all
+  // first attempts are finite. Subsequent rounds are observation only.
+  if (aux_cache_handoff_observe_)
+    participant->ReadHandoff(*aux_cache_handoff_original_, *aux_cache_handoff_next_, source, target, std::move(reply));
+  else
+    participant->Handoff(*aux_cache_handoff_original_, *aux_cache_handoff_next_, source, target, std::move(reply));
 }
 std::vector<AsyncDomStorageDatabase::AuxUiCacheView> StorageAreaImpl::CopyAuxUiMigrationCacheViews() const {
   std::vector<AsyncDomStorageDatabase::AuxUiCacheView> result;
