+// Native per-client ownership, never a PID, path, or completion supplied by JS.
+// Only a main executable exporting the reviewed browser bridge opts in.
+struct AuxCrashpadCloseState {
+  std::atomic<bool> closing{false};
+  std::atomic<bool> finished{false};
+  pthread_t thread{};
+  bool started = false;  // Published by InitialStart before the client is used.
+  bool joined = false;
+  bool registration_closed = false;
+  bool unknown = false;
+  base::apple::ScopedMachSendRight wake;
+  ~AuxCrashpadCloseState() {
+    // Ordinary destruction is not a shutdown receipt. The native close path
+    // requires a successful join; a lost client cannot report completion.
+    if (started && !joined) pthread_detach(thread);
+  }
+};
