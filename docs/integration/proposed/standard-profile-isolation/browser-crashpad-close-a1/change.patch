+int CrashpadClient::CloseAuxBrowserRegistration() {
+  if (!aux::browser_custody::Bridge()) return 2;
+  if (!aux_close_state_) return exception_port_.is_valid() ? 2 : 1;
+  auto& state = *aux_close_state_;
+  state.closing.store(true);
+  if (state.unknown) return 2;
+  if (state.started && !state.joined) {
+    if (!state.finished.load()) {
+      // A nonblocking private wake for the original receiver. A full queue
+      // already wakes it; invalid destination may mean actual teardown is in
+      // progress. Neither is completion: only finished + pthread_join is.
+      mach_msg_header_t wake{};
+      wake.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0);
+      wake.msgh_size = sizeof(wake);
+      wake.msgh_remote_port = state.wake.get();
+      wake.msgh_id = 0x415558;
+      const auto kr = mach_msg(&wake, MACH_SEND_MSG | MACH_SEND_TIMEOUT,
+                               sizeof(wake), 0, MACH_PORT_NULL, 0,
+                               MACH_PORT_NULL);
+      if (kr != MACH_MSG_SUCCESS && kr != MACH_SEND_TIMED_OUT &&
+          kr != MACH_SEND_INVALID_DEST) state.unknown = true;
+      return state.unknown ? 2 : 0;
+    }
+    if (pthread_equal(state.thread, pthread_self()) ||
+        pthread_join(state.thread, nullptr) != 0) {
+      state.unknown = true;
+      return 2;
+    }
+    state.joined = true;
+  }
+  state.wake.reset();
+  if (!state.registration_closed) {
+    if (exception_port_.is_valid()) {
+      exception_mask_t mask = EXC_MASK_CRASH | EXC_MASK_RESOURCE;
+      if (MacOSVersionNumber() < 13'00'00) mask |= EXC_MASK_GUARD;
+      mask &= ExcMaskValid();
+      ExceptionPorts ports(ExceptionPorts::kTargetTypeTask, TASK_NULL);
+      ExceptionPorts::ExceptionHandlerVector handlers;
+      if (!ports.GetExceptionPorts(mask, &handlers)) {
+        state.unknown = true;
+        return 2;
+      }
+      exception_mask_t found = 0;
+      for (const auto& handler : handlers) {
+        if (handler.port != exception_port_.get()) {
+          // Another registration is not ours to overwrite or close.
+          state.unknown = true;
+          return 2;
+        }
+        found |= handler.mask;
+      }
+      if ((found & mask) != mask) { state.unknown = true; return 2; }
+      // Restore system crash handling, restricted to this client's same mask.
+      // Standard cooperative ownership does not claim a hostile task-port CAS.
+      base::apple::ScopedMachSendRight system(SystemCrashReporterHandler());
+      if (!SetCrashExceptionPorts(system.get())) {
+        state.unknown = true;
+        return 2;
+      }
+      exception_port_.reset();
+      handlers.clear();  // Release the temporary queried send rights too.
+    }
+    state.registration_closed = true;
+  }
+  return 1;
@@ -523,0 +648,3 @@
+  if (aux_close_state_ && aux_close_state_->closing.load()) return false;
+  if (aux::browser_custody::Bridge() && !aux_close_state_)
