+bool IsAuxRecoveryDigest(std::string_view value, bool allow_empty = false) {
+  return (allow_empty && value.empty()) || (value.size() == 64 &&
+      std::ranges::all_of(value, [](char byte) {
+        return (byte >= '0' && byte <= '9') || (byte >= 'a' && byte <= 'f');
+      }));
