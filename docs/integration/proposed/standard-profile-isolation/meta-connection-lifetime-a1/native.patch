+void TargetHandler::DisposeAuxBrowserContextAndObserve(
+    const std::string& context_id,
+    std::unique_ptr<DisposeAuxBrowserContextAndObserveCallback> callback) {
+  if (access_mode_ != AccessMode::kBrowser ||
+      !dispose_on_detach_context_ids_.contains(context_id)) {
+    callback->sendFailure(Response::ServerError(
+        "Aux context is not owned by this authenticated session"));
+    return;
+  }
+  auto* delegate = DevToolsManager::GetInstance()->delegate();
+  auto* context = delegate ? delegate->GetBrowserContext(context_id) : nullptr;
+  if (!context || context == delegate->GetDefaultBrowserContext()) {
+    callback->sendFailure(Response::ServerError("Aux context is unavailable"));
+    return;
+  }
+  // The exact current handler/session created this dispose-on-detach context.
+  // A reconnected handler cannot claim its predecessor's owned set.
+  delegate->DisposeAuxBrowserContextAndObserve(context, base::BindOnce(
+      [](std::unique_ptr<DisposeAuxBrowserContextAndObserveCallback> response,
+         bool destroyed, const std::string& state) {
+        if (!destroyed) {
+          response->sendFailure(Response::ServerError(state));
+          return;
+        }
+        response->sendSuccess(true, state == "memory-only-partitions", "unknown");
+      }, std::move(callback)));
+}
