+void DevToolsBrowserContextManager::DisposeAuxBrowserContextAndObserve(
+    content::BrowserContext* context,
+    content::DevToolsManagerDelegate::DisposeCallback callback) {
+  const std::string id = context->UniqueId();
+  const auto found = otr_profiles_.find(id);
+  if (found == otr_profiles_.end() || found->second.get() != context ||
+      aux_context_object_observers_.contains(id)) {
+    std::move(callback).Run(false, "Aux context is unavailable or already closing");
+    return;
+  }
+  aux_context_object_observers_.emplace(id, std::move(callback));
+  DisposeBrowserContext(context, base::BindOnce(
+      [](base::WeakPtr<DevToolsBrowserContextManager> self,
+         const std::string& observed_id, bool accepted, const std::string& error) {
+        if (!self || accepted)
+          return;  // Request accepted is not destruction completion.
+        auto pending = self->aux_context_object_observers_.find(observed_id);
+        if (pending == self->aux_context_object_observers_.end())
+          return;
+        auto done = std::move(pending->second);
+        self->aux_context_object_observers_.erase(pending);
+        std::move(done).Run(false, error);
+      }, weak_factory_.GetWeakPtr(), id));
+}
+
+// static
+void DevToolsBrowserContextManager::NotifyAuxContextObjectDestroyed(
+    const std::string& context_id, bool storage_memory_only) {
+  auto& self = GetInstance();
+  auto found = self.aux_context_object_observers_.find(context_id);
+  if (found == self.aux_context_object_observers_.end())
+    return;
+  auto done = std::move(found->second);
+  self.aux_context_object_observers_.erase(found);
+  // Storage and network teardown may continue after Profile destruction.
+  std::move(done).Run(true, storage_memory_only ? "memory-only-partitions"
+                                             : "unverified-partitions");
+}
