+          snapshot.source_ready = false; return;
+        }
+        auto source_units = AuxUiCacheCohort::DecodeSelected(map.source, map.session_ids.empty());
+        auto target_units = AuxUiCacheCohort::DecodeSelected(map.target, map.session_ids.empty());
