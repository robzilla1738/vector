+bool ProfileImpl::ObserveAuxOTRDestruction(
+    Profile* child, base::OnceCallback<void(bool)> callback) {
+  if (!child || !child->IsOffTheRecord() || !callback)
+    return false;
+  const OTRProfileID id = child->GetOTRProfileID();
+  const auto entry = otr_profiles_.find(id);
+  if (!id.IsDevTools() || entry == otr_profiles_.end() ||
+      entry->second.get() != child || aux_otr_destruction_callbacks_.contains(id))
+    return false;
+  aux_otr_destruction_callbacks_.emplace(id, std::move(callback));
+  return true;
+}
+
+void ProfileImpl::CancelAuxOTRDestruction(Profile* child) {
+  if (!child || !child->IsOffTheRecord())
+    return;
+  const OTRProfileID id = child->GetOTRProfileID();
+  const auto entry = otr_profiles_.find(id);
+  if (entry != otr_profiles_.end() && entry->second.get() == child)
+    aux_otr_destruction_callbacks_.erase(id);
+}
