+        : read(fd, UNSAFE_TODO(bytes + offset), size - offset);
+    if (n < 0 && (errno == EINTR || errno == EAGAIN)) continue;
+    if (n <= 0) return false;
+    offset += static_cast<size_t>(n);
+  }
