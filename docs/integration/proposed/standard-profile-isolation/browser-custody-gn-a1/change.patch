--- a/base/BUILD.gn
+++ b/base/BUILD.gn
@@ -242,6 +242,41 @@
 # base compilation units to be linked in where they wouldn't have otherwise.
 # This does not include test code (test support and anything in the test
 # directory) which should use source_set as is recommended for GN targets).
+if (is_mac) {
+  # No implementation, allocation, or dependency on the base component. The
+  # Crashpad/Framework clients call the one main-executable bridge.
+  source_set("aux_browser_descendant_client") {
+    public = [
+      "process/mac/aux_browser_descendant_bridge.h",
+      "process/mac/aux_browser_descendant_client.h",
+    ]
+    sources = public
+  }
+
+  # Only the primary browser image owns the ES stream and ticket registry.
+  # mac_app_bundle forwards deps to both its bundle and executable target.
+  source_set("aux_browser_descendant_engine") {
+    visibility = [
+      "//chrome:chrome_app",
+      "//chrome:chrome_app_executable",
+    ]
+    public = [ "process/mac/aux_browser_descendant_engine.h" ]
+    sources = [
+      "process/mac/aux_browser_descendant_bridge.cc",
+      "process/mac/aux_browser_descendant_engine.cc",
+      "process/mac/aux_browser_descendant_engine.h",
+    ]
+    deps = [ ":aux_browser_descendant_client" ]
+    configs -= [ "//build/config/compiler:no_exceptions" ]
+    configs += [ "//build/config/compiler:exceptions" ]
+    cflags_cc = [ "-fblocks" ]
+    libs = [
+      "EndpointSecurity",
+      "bsm",
+    ]
+  }
+}
+
