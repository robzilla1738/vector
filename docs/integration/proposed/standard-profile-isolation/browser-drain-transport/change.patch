+int32_t AuthenticatedNativeParentConnection::ExchangeBrowserDrain(
+    uint64_t generation, const BrowserDrainChallenge& nonce, bool acknowledgement,
+    BrowserDrainReport* output, uint32_t timeout_ms) {
+  if (output) *output = {};
+  auto state = state_;
+  if (!output || !generation || !ValidTimeout(timeout_ms) || getpid() != state->process)
+    return 3;
+  if (Revalidate(timeout_ms) != ExchangeStatus::authenticated) return 2;
+  std::optional<NativeSendRight> endpoint;
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    if (state->snapshot.closed) return 2;
+    endpoint.emplace(state->endpoint.CopyOwnedRight());
+    if (!endpoint->is_valid()) return 2;
+    ++state->snapshot.active_checks;
+  }
+  auto finish = +[](State* retained) {
+    std::lock_guard<std::mutex> lock(retained->mutex);
+    --retained->snapshot.active_checks;
+  };
+  std::unique_ptr<State, decltype(finish)> active(state.get(), finish);
+  ReceiveRight reply;
+  if (reply.get() == MACH_PORT_NULL) return 2;
+  Wire request{};
+  request.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, MACH_MSG_TYPE_MAKE_SEND_ONCE);
+  request.header.msgh_size = sizeof(request);
+  request.header.msgh_remote_port = endpoint->BorrowNativeName();
+  request.header.msgh_local_port = reply.get();
+  request.header.msgh_id = acknowledgement ? kBrowserDrainAck : kBrowserDrainRequest;
+  request.generation = generation;
+  request.nonce = nonce;
+  auto result = mach_msg(&request.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT,
+      sizeof(request), 0, MACH_PORT_NULL, timeout_ms, MACH_PORT_NULL);
+  if (result != KERN_SUCCESS) {
+    if (RecoverableSendError(result)) {
+      const auto local = MACH_MSGH_BITS_LOCAL(request.header.msgh_bits);
+      if (local == MACH_MSG_TYPE_MOVE_SEND || local == MACH_MSG_TYPE_MOVE_SEND_ONCE)
+        mach_port_deallocate(mach_task_self(), request.header.msgh_local_port);
+    } else {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      ++state->snapshot.unresolved_send_cleanup;
+      state->snapshot.closed = true;
+    }
+    return 2;
+  }
+  BrowserDrainReceived received{};
+  result = mach_msg(&received.wire.header, kReceiveOptions, 0, sizeof(received),
+      reply.get(), timeout_ms, MACH_PORT_NULL);
+  if (result == MACH_RCV_TIMED_OUT) return 1;
+  if (result != KERN_SUCCESS) {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    ++state->snapshot.unresolved_receive_cleanup;
+    state->snapshot.last_receive_error = result;
+    state->snapshot.closed = true;
+    return 2;
+  }
+  DestroyMessage destroy(&received.wire.header);
+  const auto audit = received.trailer.msgh_audit;
+  const auto& report = received.wire.report;
+  if (received.wire.header.msgh_size != sizeof(BrowserDrainWire) ||
+      received.wire.header.msgh_id != (acknowledgement ? kBrowserDrainAckReply : kBrowserDrainReply) ||
+      (received.wire.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) ||
+      received.trailer.msgh_trailer_type != MACH_MSG_TRAILER_FORMAT_0 ||
+      received.trailer.msgh_trailer_size < sizeof(mach_msg_audit_trailer_t) ||
+      audit_token_to_pid(audit) != state->birth.pid ||
+      audit_token_to_pidversion(audit) != state->snapshot.parent_pid_version ||
+      getppid() != state->birth.pid || !SameBirth(state->birth, 0) ||
+      !NativeOperations::Validate(audit, *state->policy) ||
+      DrainInteger(report, 0, 4) != 1 || DrainInteger(report, 8, 8) != generation ||
+      DrainInteger(report, 28, 4) != 0 || DrainInteger(report, 4, 4) > 3 ||
+      (acknowledgement ? DrainDigest(report) != nonce :
+          !std::equal(nonce.begin(), nonce.end(), report.begin() + 32))) return 3;
+  std::lock_guard<std::mutex> lock(state->mutex);
+  if (state->snapshot.closed) return 2;
+  *output = report;
+  return static_cast<int32_t>(DrainInteger(report, 4, 4));
+}
+int32_t AuthenticatedNativeParentConnection::CopyBrowserDrainReport(
+    uint64_t generation, const BrowserDrainChallenge& challenge,
+    BrowserDrainReport* output, uint32_t timeout_ms) {
+  return ExchangeBrowserDrain(generation, challenge, false, output, timeout_ms);
+}
+int32_t AuthenticatedNativeParentConnection::AcknowledgeBrowserDrainReport(
+    const BrowserDrainReport& report, uint32_t timeout_ms) {
+  if (DrainInteger(report, 0, 4) != 1 || DrainInteger(report, 4, 4) != 0 ||
+      DrainInteger(report, 24, 4) != 6 || !DrainInteger(report, 16, 8)) return 3;
+  BrowserDrainReport reply{};
+  const auto result = ExchangeBrowserDrain(DrainInteger(report, 8, 8),
+      DrainDigest(report), true, &reply, timeout_ms);
+  return result == 0 && reply == report ? 0 : result == 0 ? 3 : result;
 }
