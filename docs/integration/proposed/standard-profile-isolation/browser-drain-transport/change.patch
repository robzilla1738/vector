+bool RegisterBrowserDrainReportProvider(BrowserDrainReportProvider provider,
+                                        BrowserDrainAckObserver acknowledged) {
+  std::lock_guard<std::mutex> lock(DrainProviderMutex());
+  if (!provider || !acknowledged) return false;
+  if (drain_provider) return drain_provider == provider && drain_ack_observer == acknowledged;
+  drain_provider = provider;
+  drain_ack_observer = acknowledged;
+  return true;
+}
