+uint64_t DrainInteger(const BrowserDrainReport& report, size_t offset, size_t length) {
+  uint64_t value = 0;
+  for (size_t i = 0; i < length; ++i) value = (value << 8) | report[offset + i];
+  return value;
+}
+BrowserDrainChallenge DrainDigest(const BrowserDrainReport& report) {
+  BrowserDrainChallenge digest{};
+  CC_SHA256(report.data(), report.size(), digest.data());
+  return digest;
+}
