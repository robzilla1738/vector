+bool SelectedNativeHome::BindBrowserDescendantScope(uint64_t generation) {
+  const auto pulse = InspectReadyPulse();
+  if (!generation || !pulse || pulse->generation != generation) return false;
+  auto owner = state_->child;
+  std::lock_guard<std::mutex> lock(owner->mutex);
+  if (getpid() != owner->process || !owner->peer || !owner->child.IsValid() ||
+      owner->observation.closed || owner->observation.exit_ownership_unknown ||
+      owner->observation.exit_observed_and_reaped) return false;
+  return aux::browser_custody::TransferDaemon(owner->descendant_ticket,generation);
+}
