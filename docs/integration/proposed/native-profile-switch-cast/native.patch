+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+bool CastBrowserController::CanReleaseForAuxProfileSwitch(
+    BrowserWindowInterface* browser) {
+  if (!browser || !browser->GetProfile()->IsRegularProfile()) {
+    return false;
+  }
+  if (auto* controller = From(browser);
+      controller && controller->aux_profile_callback_depth_) {
+    return false;
+  }
+  auto* model = browser->GetTabStripModel();
+  if (!model) {
+    return false;
+  }
+  for (int index = 0; index < model->count(); ++index) {
+    // Read existing tab-owned state only; never instantiate or close a dialog.
+    auto* dialog = MediaRouterDialogControllerViews::FromWebContents(
+        model->GetWebContentsAt(index));
+    if (dialog && !dialog->CanRelinquishForAuxProfileSwitch()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::ScopedClosureRunner CastBrowserController::EnterAuxProfileCallback() {
+  ++aux_profile_callback_depth_;
+  return base::ScopedClosureRunner(base::BindOnce(
+      &CastBrowserController::LeaveAuxProfileCallback,
+      aux_weak_factory_.GetWeakPtr()));
+}
+
+void CastBrowserController::LeaveAuxProfileCallback() {
+  CHECK_GT(aux_profile_callback_depth_, 0u);
+  --aux_profile_callback_depth_;
+}
+#endif
+
