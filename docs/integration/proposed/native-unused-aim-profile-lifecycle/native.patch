+    return false;
+  }
+  if (!(widgets_pending_deletion_.empty())) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.presenter-pending-widget";
+    return false;
+  }
+  if (permission_observation_.IsObserving()) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.presenter-permission-observer";
+    return false;
+  }
+  if (is_prompt_showing_) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.presenter-permission-prompt";
+    return false;
+  }
+  if (is_handling_prompt_dismissal_) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.presenter-permission-dismissal";
+    return false;
+  }
+  if (!(deactivation_blockers_count_ == 0)) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.presenter-blockers";
+    return false;
+  }
+  if (focus_requested_) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.presenter-focus";
+    return false;
+  }
+  return true;
+}
