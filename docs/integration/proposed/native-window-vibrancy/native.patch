+  NSView* container = root;
+  if (IsGlassBackgroundEffectView(effect)) {
+    SEL selector = @selector(contentView);
+    if ([effect respondsToSelector:selector]) {
+      id content = reinterpret_cast<id (*)(id, SEL)>(objc_msgSend)(effect,
+                                                                 selector);
+      if ([content isKindOfClass:[NSView class]]) {
+        container = content;
+      }
+    }
+  }
+  [compositor removeFromSuperview];
+  compositor.frame = container.bounds;
+  compositor.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  [container addSubview:compositor];
+}
