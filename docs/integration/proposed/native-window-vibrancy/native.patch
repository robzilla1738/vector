+void NativeWidgetNSWindowBridge::StartWindowEffectPreferencesObserver() {
+  window_vibrancy_disabled_ = ReadWindowVibrancyDisabled();
+  window_glass_variant_ = ReadWindowGlassVariant();
+  if (window_effect_preferences_observed_) {
+    return;
+  }
+  CFNotificationCenterAddObserver(
+      CFNotificationCenterGetDarwinNotifyCenter(), this,
+      [](CFNotificationCenterRef, void* observer, CFStringRef name,
+         const void*, CFDictionaryRef) {
+        if (name && CFEqual(name, kWindowEffectPreferenceDomain)) {
+          static_cast<NativeWidgetNSWindowBridge*>(observer)
+              ->UpdateWindowEffectPreferences();
+        }
+      },
+      kWindowEffectPreferenceDomain, nullptr,
+      CFNotificationSuspensionBehaviorDeliverImmediately);
+  window_effect_preferences_observed_ = true;
+  window_effect_preferences_timer_.Start(
+      FROM_HERE, base::Milliseconds(250),
+      base::BindRepeating(
+          &NativeWidgetNSWindowBridge::UpdateWindowEffectPreferences,
+          factory_.GetWeakPtr()));
+}
+
+void NativeWidgetNSWindowBridge::ReplaceWindowBackgroundEffectView(
+    bool fullscreen) {
+  NSView* compositor = FindCompositorSuperview(bridged_view_);
+  [FindWindowBackgroundEffectView(bridged_view_) removeFromSuperview];
+  NSView* effect = CreateBrowserWindowBackgroundEffectView(
+      bridged_view_.bounds, fullscreen, window_vibrancy_disabled_,
+      window_glass_variant_);
+  [bridged_view_ addSubview:effect positioned:NSWindowBelow relativeTo:nil];
+  if (compositor) {
+    AttachCompositorToWindowBackground(bridged_view_, effect, compositor);
+  }
+}
+
+void NativeWidgetNSWindowBridge::UpdateWindowEffectPreferences() {
+  const bool disabled = ReadWindowVibrancyDisabled();
+  const std::optional<int> variant = ReadWindowGlassVariant();
+  const bool disabled_changed = disabled != window_vibrancy_disabled_;
+  const bool variant_changed = variant != window_glass_variant_;
+  window_vibrancy_disabled_ = disabled;
+  window_glass_variant_ = variant;
+  NSView* effect = FindWindowBackgroundEffectView(bridged_view_);
+  if (!effect) {
+    return;
+  }
+  if (disabled_changed) {
+    effect.hidden = disabled;
+    if (is_translucent_window_ && !IsWindowModalSheet()) {
+      window_.opaque = disabled;
+      NSColor* background = NSColor.windowBackgroundColor;
+      if (@available(macOS 26, *)) {
+        if (!disabled) {
+          background = [background colorWithAlphaComponent:0.001];
+        }
+      }
+      window_.backgroundColor = background;
+    }
+  }
+  if (variant_changed && IsGlassBackgroundEffectView(effect)) {
+    if (variant) {
+      [effect setValue:@(*variant) forKey:@"variant"];
+    } else {
+      ReplaceWindowBackgroundEffectView(
+          (window_.styleMask & NSWindowStyleMaskFullScreen) != 0);
+    }
+  }
+}
