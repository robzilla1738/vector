+bool ReadWindowVibrancyDisabled() {
+  CFPreferencesAppSynchronize(kWindowEffectPreferenceDomain);
+  base::apple::ScopedCFTypeRef<CFPropertyListRef> value(
+      CFPreferencesCopyAppValue(kWindowVibrancyDisabledKey,
+                                kWindowEffectPreferenceDomain));
+  return value && CFGetTypeID(value.get()) == CFBooleanGetTypeID() &&
+         CFBooleanGetValue(static_cast<CFBooleanRef>(value.get()));
+}
+
+std::optional<int> ReadWindowGlassVariant() {
+  if (@available(macOS 26, *)) {
+    CFPreferencesAppSynchronize(kWindowEffectPreferenceDomain);
+    base::apple::ScopedCFTypeRef<CFPropertyListRef> value(
+        CFPreferencesCopyAppValue(CFSTR("liquidGlassVariant"),
+                                  kWindowEffectPreferenceDomain));
+    int variant = 0;
+    if (value && CFGetTypeID(value.get()) == CFNumberGetTypeID() &&
+        CFNumberGetValue(static_cast<CFNumberRef>(value.get()),
+                         kCFNumberIntType, &variant) &&
+        variant >= 1 && variant <= 20) {
+      return variant;
+    }
+  }
+  return std::nullopt;
+}
+
+bool IsGlassBackgroundEffectView(NSView* view) {
+  if (@available(macOS 26, *)) {
+    Class glass_class = NSClassFromString(@"NSGlassEffectView");
+    return glass_class && [view isKindOfClass:glass_class];
+  }
+  return false;
+}
+
+NSView* FindWindowBackgroundEffectView(NSView* root) {
+  for (NSView* child in root.subviews) {
+    if ([child isKindOfClass:[NSVisualEffectView class]] ||
+        IsGlassBackgroundEffectView(child)) {
+      return child;
+    }
+  }
+  return nil;
+}
+
+NSView* FindCompositorSuperview(NSView* root) {
+  if ([root isKindOfClass:[ViewsCompositorSuperview class]]) {
+    return root;
+  }
+  for (NSView* child in root.subviews) {
+    if (NSView* compositor = FindCompositorSuperview(child)) {
+      return compositor;
+    }
+  }
+  return nil;
+}
+
+NSView* CreateBrowserWindowBackgroundEffectView(
+    NSRect bounds,
+    bool fullscreen,
+    bool disabled,
+    std::optional<int> glass_variant) {
+  NSView* effect = nil;
+  if (@available(macOS 26, *)) {
+    Class glass_class = NSClassFromString(@"NSGlassEffectView");
+    if (!fullscreen && glass_class) {
+      effect = [[glass_class alloc] initWithFrame:bounds];
+      if (glass_variant) {
+        [effect setValue:@(*glass_variant) forKey:@"variant"];
+      }
+      // Preserve the supplied optional AppKit blending selector; do not select
+      // a new material or substitute a custom-painted backdrop.
+      SEL selector =
+          NSSelectorFromString(@"_setVibrantBlendingStyleForSubtree:");
+      if ([effect respondsToSelector:selector]) {
+        reinterpret_cast<void (*)(id, SEL, NSInteger)>(objc_msgSend)(
+            effect, selector, 0);
+      }
+    }
+  }
+  if (!effect) {
+    NSVisualEffectView* visual =
+        [[NSVisualEffectView alloc] initWithFrame:bounds];
+    visual.material = NSVisualEffectMaterialUnderWindowBackground;
+    visual.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+    visual.state = NSVisualEffectStateFollowsWindowActiveState;
+    effect = visual;
+  }
+  effect.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  effect.hidden = disabled;
+  return effect;
+}
+
+void AttachCompositorToWindowBackground(NSView* root,
