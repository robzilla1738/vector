+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool BrowserView::CanRebindForAuxProfileSwitch(Profile* target) const {
+  return !aux_profile_switch_paused_ && GetProfile()->IsRegularProfile() &&
+         target && target->IsRegularProfile() && target != GetProfile() &&
+         registrar_.prefs() == GetProfile()->GetPrefs();
+}
+
+uint64_t BrowserView::BeginAuxProfileSwitch(Profile* target) {
+  CHECK(CanRebindForAuxProfileSwitch(target));
+  aux_profile_switch_paused_ = true;
+  aux_profile_switch_source_ = GetProfile()->GetWeakPtr();
+  aux_profile_switch_target_ = target->GetWeakPtr();
+  registrar_.Reset();
+  return ++aux_profile_switch_generation_;
+}
+
+void BrowserView::BindPrefsForAuxProfileSwitch() {
+  CHECK(!registrar_.prefs());
+  registrar_.Init(GetProfile()->GetPrefs());
+  registrar_.Add(
+      prefs::kFullscreenAllowed,
+      base::BindRepeating(&BrowserView::UpdateFullscreenAllowedFromPolicy,
+                          base::Unretained(this),
+                          aux_fullscreen_allowed_without_policy_));
+}
+
+void BrowserView::RebindAuxProfileSwitch(uint64_t generation) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK_EQ(generation, aux_profile_switch_generation_);
+  CHECK(aux_profile_switch_target_);
+  CHECK_EQ(GetProfile(), aux_profile_switch_target_.get());
+  CHECK(browser_->GetTabStripModel()->empty());
+  BindPrefsForAuxProfileSwitch();
+}
+
+void BrowserView::EndAuxProfileSwitch(uint64_t generation) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK_EQ(generation, aux_profile_switch_generation_);
+  CHECK(GetProfile() == aux_profile_switch_source_.get() ||
+        GetProfile() == aux_profile_switch_target_.get());
+  // Rollback restores the source's real preference service after its tabs.
+  if (registrar_.prefs() != GetProfile()->GetPrefs()) {
+    registrar_.Reset();
+    BindPrefsForAuxProfileSwitch();
+  }
+  aux_profile_switch_paused_ = false;
+  aux_profile_switch_source_.reset();
+  aux_profile_switch_target_.reset();
+  UpdateFullscreenAllowedFromPolicy(aux_fullscreen_allowed_without_policy_);
+}
