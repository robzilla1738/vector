+      aux_local_state &&
+      aux_local_state->FindPreference(tabs::kAuxVerticalTabInsertionPosition)) {
+    auto* model = params->browser->GetTabStripModel();
+    const bool insert_at_top = aux_local_state->GetString(
+        tabs::kAuxVerticalTabInsertionPosition) != "bottom";
+    if (params->url.SchemeIs("chrome-extension") &&
+        params->url.host() == aux::kAgentExtensionId) {
+      params->group.reset();
+      aux_force_ungrouped_tab = true;
