 #import <Foundation/Foundation.h>
 
 #include "base/apple/bundle_locations.h"
+#include "base/apple/scoped_cftyperef.h"
 #include "base/values.h"
 #include "chrome/browser/mac/dock.h"
 namespace extensions {
+namespace {
+CFStringRef AuxVibrancyDomain() {
+  return (__bridge CFStringRef)base::apple::OuterBundle().bundleIdentifier;
+}
+}  // namespace
+bool ReadAuxWindowVibrancyEnabled() {
+  const auto domain = AuxVibrancyDomain();
+  if (!domain) {
+    return true;
+  }
+  CFPreferencesAppSynchronize(domain);
+  base::apple::ScopedCFTypeRef<CFPropertyListRef> disabled(
+      CFPreferencesCopyAppValue(CFSTR("windowBackgroundVibrancyDisabled"), domain));
+  return !disabled || CFGetTypeID(disabled.get()) != CFBooleanGetTypeID() ||
+         !CFBooleanGetValue(static_cast<CFBooleanRef>(disabled.get()));
+}
+bool WriteAuxWindowVibrancyEnabled(bool enabled) {
+  const auto domain = AuxVibrancyDomain();
+  if (!domain) {
+    return false;
+  }
+  CFPreferencesSetAppValue(CFSTR("windowBackgroundVibrancyDisabled"),
+                           enabled ? kCFBooleanFalse : kCFBooleanTrue, domain);
+  if (!CFPreferencesAppSynchronize(domain)) {
+    return false;
+  }
+  CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(),
+                                       domain, nullptr, nullptr, true);
+  return true;
+}
