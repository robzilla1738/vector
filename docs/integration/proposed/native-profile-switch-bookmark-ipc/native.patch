 BookmarksServiceFeature::~BookmarksServiceFeature() = default;
+
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+void BookmarksServiceFeature::PrepareForAuxProfileSwitch() {
+  CHECK(!aux_profile_switch_paused_);
+  aux_profile_switch_paused_ = true;
+  // Existing shutdown actually destroys the service/active receivers and
+  // pending receivers and removes its old model observation.
+  ShutdownService();
+}
+
+void BookmarksServiceFeature::RebindForAuxProfileSwitch(
+    BrowserWindowInterface& browser) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK_EQ(From(&browser), this);
+  CHECK(browser.GetProfile()->IsRegularProfile());
+  CHECK(!observation_.IsObserving());
+  CHECK(!bookmarks_service_);
+  CHECK(queued_receivers_.empty());
+  merged_service_ = BookmarkMergedSurfaceServiceFactory::GetForProfile(
+      browser.GetProfile());
+  aux_profile_switch_paused_ = false;
+  // Match genuine service absence: Accept closes a receiver instead of
+  // presenting empty successful bookmarks from another or invented profile.
+  if (merged_service_) {
+    observation_.Observe(merged_service_);
+    if (merged_service_->loaded()) {
+      InitializeService();
+    }
+  }
+}
