-    if (active && manager) {
-      auto* controller = manager->fullscreen_controller();
-      if (controller->GetFullscreenState(active).target_mode ==
-          content::FullscreenMode::kContent) {
-        // A chrome shortcut needs visible shell controls. Leave only this
-        // tab's content fullscreen, retaining any prior browser fullscreen.
-        auto* catalog = aux::TabCatalog::GetForProfile(browser_->GetProfile());
-        if (!catalog) return false;
-        const auto self = GetWeakPtr();
-        const auto browser = browser_->GetWeakPtr();
-        controller->ExitFullscreenModeForTab(active);
-        if (!self || !browser || browser->IsDeleteScheduled() ||
-            !IsAuthorizedAuxDocument() || !shell_host_client_.is_bound() ||
-            browser_->GetTabStripModel()->GetActiveWebContents() != active ||
-            controller->GetFullscreenState(active).target_mode ==
-                content::FullscreenMode::kContent) {
-          return false;
-        }
-        // Controller observers are posted. Send the cleared native owner on
-        // this same client pipe before the shortcut can focus a hidden field.
-        catalog->RefreshPage();
-        if (!self || !browser || browser->IsDeleteScheduled() ||
-            !IsAuthorizedAuxDocument() || !shell_host_client_.is_bound() ||
-            browser_->GetTabStripModel()->GetActiveWebContents() != active) {
-          return false;
-        }
-      }
-    }
-    FocusAuxShell();
-  }
-  base::DictValue shortcut;
-  shortcut.Set("commandId", command_id);
-  if (website_pass_through.has_value()) shortcut.Set("websitePassThrough", *website_pass_through);
-  shortcut.Set("key", preview_tabs ? "Tab" : "");
-  shortcut.Set("ctrl", preview_tabs);
-  shortcut.Set("meta", false);
