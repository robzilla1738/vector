+     binding_epoch_(aux::GetProfileCookieBindingEpoch(profile)),
+     restore_epoch_(aux::GetProfileCookieRestoreEpoch(profile)),account_id_(account_id),
+     keep_alive_(keep_alive.release(),base::OnTaskRunnerDeleter(content::GetUIThreadTaskRunner({}))) {}
+const std::string& AuxNativeMessagingProfileOwner::binding() const {
+  std::call_once(binding_once_,[this] {
+    base::ScopedBlockingCall blocking(FROM_HERE,base::BlockingType::WILL_BLOCK);
+    binding_receipt_=AuxNativeHostLease::CaptureProfileBinding(profile_path_,profile_id_,account_id_).value_or("");
+  });
+  return binding_receipt_;
+}
