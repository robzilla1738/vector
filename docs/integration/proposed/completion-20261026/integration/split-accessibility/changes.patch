+std::vector<uint32_t> SplitPaneTree::VisualPaneSlots() const {
+  auto placements = Layout({0, 0, 1000000, 1000000}, 0, 0);
+  std::erase_if(placements, [](const Placement& pane) { return !pane.slot; });
+  std::stable_sort(placements.begin(), placements.end(),
+                   [](const Placement& a, const Placement& b) {
+    return a.bounds.y != b.bounds.y ? a.bounds.y < b.bounds.y
+                                    : a.bounds.x < b.bounds.x;
+  });
+  std::vector<uint32_t> slots;
+  for (const auto& pane : placements) slots.push_back(pane.slot);
+  return slots;
+}
