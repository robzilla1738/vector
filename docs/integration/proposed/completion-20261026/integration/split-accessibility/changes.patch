 namespace split_tabs {
 
+std::vector<tabs::TabInterface*> GetTabsInVisualOrder(const SplitTabData& data) {
+  const auto tabs = data.ListTabs();
+  const auto& tree = data.visual_data()->pane_tree();
+  if (!tree) return tabs;
+  CHECK_EQ(tree->pane_slots().size(), tabs.size());
+  std::vector<tabs::TabInterface*> ordered;
+  for (const uint32_t slot : tree->VisualPaneSlots()) {
+    const auto member = std::ranges::find(tree->pane_slots(), slot);
+    CHECK(member != tree->pane_slots().end());
+    ordered.push_back(tabs[std::distance(tree->pane_slots().begin(), member)]);
+  }
+  CHECK_EQ(ordered.size(), tabs.size());
+  return ordered;
+}
