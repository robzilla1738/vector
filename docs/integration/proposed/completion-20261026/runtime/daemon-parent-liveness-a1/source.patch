+// Both deadlines run from the first observed peer loss, so a browser crash
+// ends this process about kPeerLossDeadline later, not twice that.
+std::optional<std::chrono::steady_clock::time_point> peer_lost_at;
+std::chrono::steady_clock::time_point NotePeerLoss() {
+  std::lock_guard<std::mutex> lock(peer_loss_mutex);
+  if (!peer_lost_at) peer_lost_at = std::chrono::steady_clock::now();
+  return *peer_lost_at;
+}
 // Called only from the pulse and authority threads, which main joins before
 // joining the deadline thread.
 void ArmPeerLossDeadline(node::Environment* environment) {
+  const auto lost = NotePeerLoss();
   std::lock_guard<std::mutex> lock(peer_loss_mutex);
   if (event_loop_returned || peer_loss_deadline.joinable()) return;
-  peer_loss_deadline = std::thread([environment] {
+  peer_loss_deadline = std::thread([environment, lost] {
