 namespace {
 constexpr uint32_t kPeerTimeoutMs = 2000;
 constexpr auto kPulseInterval = std::chrono::seconds(1);
+// After peer loss the supplied shutdown closes its servers, but a remaining
+// handle (an fs.watch FSEvents source) keeps the loop alive indefinitely, and
+// the next launch is refused while this process lives. Bound it with the
+// existing fatal Stop.
+constexpr auto kPeerLossDeadline = std::chrono::seconds(10);
+std::mutex peer_loss_mutex;
+std::condition_variable peer_loss_wake;
+bool event_loop_returned = false;
+std::thread peer_loss_deadline;
+// Called only from the pulse and authority threads, which main joins before
+// joining the deadline thread.
+void ArmPeerLossDeadline(node::Environment* environment) {
+  std::lock_guard<std::mutex> lock(peer_loss_mutex);
+  if (event_loop_returned || peer_loss_deadline.joinable()) return;
+  peer_loss_deadline = std::thread([environment] {
+    std::unique_lock<std::mutex> wait(peer_loss_mutex);
+    // Main sets the flag under this lock before any teardown, so Stop
+    // never reaches a released environment.
+    if (!peer_loss_wake.wait_for(wait, kPeerLossDeadline, [] { return event_loop_returned; }))
+      node::Stop(environment);
+  });
+}
+void EndPeerLossDeadline() {
+  {
+    std::lock_guard<std::mutex> lock(peer_loss_mutex);
+    event_loop_returned = true;
+  }
+  peer_loss_wake.notify_all();
+}
