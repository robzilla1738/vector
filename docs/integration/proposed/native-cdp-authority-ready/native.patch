+void RemoteDebuggingServer::OnAuxCdpAuthorityReady() {
+  // Startup can reach us before the daemon has loaded its installation key.
+  // Retry only when that real authority becomes available, never unfiltered.
+  if (aux_phase_ == AuxPhase::kFailed) {
+    aux_phase_ = AuxPhase::kOff;
+  }
+  ReconcileAuxServer();
 }
