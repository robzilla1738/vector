+bool ProfilePreviewRegionOwner::UpdatePageGeometry(
+    ProfilePagePreviewPageView& page) {
+  auto* region = views::AsViewClass<VerticalTabStripRegionView>(region_.view());
+  if (!region) {
+    return false;
+  }
+  const auto surfaces = region->GetAuxProfilePreviewSurfaces();
+  const auto bounds = ProfilePreviewPresentation::PreviewBounds(
+      *region, surfaces, region->GetAuxProfilePreviewTopBoundary());
+  // Supplied 0x4658b68/0x46407f8 projects visible role bounds into the region,
+  // then subtracts the preview's top. Chromium 155's header children are nested.
+  const auto relative_bounds = [&](views::View* child) {
+    gfx::Rect result;
+    if (child && child->GetVisible() && child->parent() &&
+        region->Contains(child)) {
+      result = views::View::ConvertRectToTarget(child->parent(), region,
+                                              child->bounds());
+    }
+    result.Offset(0, -bounds.y());
+    return result;
+  };
+  const auto header = relative_bounds(region->GetAuxSidebarProfileButton());
+  const auto search = relative_bounds(region->GetAuxSidebarSearchButton());
+  const auto scroll = relative_bounds(surfaces[2]);
+  auto alive = weak_factory_.GetWeakPtr();
+  views::ViewTracker page_lifetime(&page);
+  page.SetBoundsRect(bounds);
+  if (!alive || !page_lifetime.view()) {
+    return false;
+  }
+  page.SetFallbackGeometry(header, search, scroll);
+  return alive && page_lifetime.view();
+}
