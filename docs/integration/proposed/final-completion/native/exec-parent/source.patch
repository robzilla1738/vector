+// Native-only containment metadata producer. No JavaScript/environment path,
+// caller policy or status receipt can select a protected directory.
+extension AuxSignedFreshBootstrapPolicyLoader {
+    fileprivate static func execPrivateParent() throws -> String {
+        let policy = try load()
+        guard policy.contents.role == .daemon, policy.contents.embeddedDaemon,
+              policy.contents.includesRebuiltPtyModule else { throw AuxFreshBootstrapPolicyError.policy }
+        let path = policy.contents.canonicalPrivateParent
+        guard try canonical(path) == path else { throw AuxFreshBootstrapPolicyError.path }
+        let fd = open(path, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK)
+        guard fd >= 0 else { throw AuxFreshBootstrapPolicyError.path }
+        defer { close(fd) }
+        let held = try metadata(fd, directory: true, privateDirectory: true)
+        func sameParent() throws {
+            let now = try metadata(fd, directory: true, privateDirectory: true)
+            var entry = stat()
+            guard lstat(path, &entry) == 0, entry.st_dev == held.st_dev,
+                  entry.st_ino == held.st_ino, now.st_dev == held.st_dev,
+                  now.st_ino == held.st_ino, try canonical(path) == path else {
+                throw AuxFreshBootstrapPolicyError.path
+            }
+        }
+        try sameParent()
+        try policy.revalidateCurrentIdentity()
+        try sameParent()
+        return path
+    }
+}
+@_cdecl("AuxCopyAuthenticatedExecPrivateParent")
+func AuxCopyAuthenticatedExecPrivateParent(_ output: UnsafeMutablePointer<CChar>?,
+                                         _ capacity: UInt32,
+                                         _ count: UnsafeMutablePointer<UInt32>?) -> Int32 {
+    guard getpid() == auxImagePreparationProcess, let count else { return -1 }
+    count.pointee = 0
+    guard let output, capacity > 1, capacity <= 4096 else { return -1 }
+    output.pointee = 0
+    auxImagePreparationLock.lock(); let prepared = auxImagePreparationComplete; auxImagePreparationLock.unlock()
+    guard prepared else { return -1 }
+    do {
+        let bytes = try AuxSignedFreshBootstrapPolicyLoader.execPrivateParent().utf8CString
+        guard bytes.count > 1, bytes.count <= Int(capacity), bytes.count <= 4096 else { return -1 }
+        for index in bytes.indices { output[index] = bytes[index] }
+        count.pointee = UInt32(bytes.count)
+        return 0
+    } catch { return -1 }
+}
