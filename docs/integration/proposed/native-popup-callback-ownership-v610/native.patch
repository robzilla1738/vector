+  // The manager outlives individual popup/options windows. A queued callback
+  // must not close or focus a successor created before it runs.
+  void PostWindowTask(void (PopupManager::*callback)()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<PopupManager> manager, uint64_t generation,
+               uint64_t options_generation, void (PopupManager::*callback)()) {
+              if (manager && manager->generation_ == generation &&
+                  manager->options_generation_ == options_generation) {
+                (manager.get()->*callback)();
+              }
+            },
+            weak_factory_.GetWeakPtr(), generation_, options_generation_,
+            callback));
+  }
