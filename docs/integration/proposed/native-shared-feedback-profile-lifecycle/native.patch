 void SharedTabGroupFeedbackController::TearDown() {
+  active_tab_change_subscriptions_.clear();
+  tab_group_sync_observer_.Reset();
+  if (browser_ && !aux_profile_switch_paused_)
+    browser_->GetTabStripModel()->RemoveObserver(this);
+  browser_ = nullptr;
+  tab_group_sync_service_ = nullptr;
+}
+
+bool SharedTabGroupFeedbackController::CanPauseForAuxProfileSwitch() const {
+  const auto* education = browser_ ? BrowserUserEducationInterface::From(browser_)
+                                  : nullptr;
+  return browser_ && tab_group_sync_service_ &&
+         tab_group_sync_observer_.IsObserving() &&
+         !aux_profile_switch_paused_ && !aux_callback_active_ &&
+         (!education || !education->IsAnyFeaturePromoActive());
+}
+
+bool SharedTabGroupFeedbackController::CanRebindForAuxProfileSwitch(
+    Profile* target) const {
+  return CanPauseForAuxProfileSwitch() && target &&
+         browser_->GetTabStripModel()->SupportsTabGroups() &&
+         TabGroupSyncServiceFactory::GetForProfile(target);
+}
+
+void SharedTabGroupFeedbackController::PauseForAuxProfileSwitch() {
+  CHECK(CanPauseForAuxProfileSwitch());
+  aux_profile_switch_paused_ = true;
+  active_tab_change_subscriptions_.clear();
+  tab_group_sync_observer_.Reset();
   browser_->GetTabStripModel()->RemoveObserver(this);
-  browser_ = nullptr;
+  tab_group_sync_service_ = nullptr;
+}
+
+void SharedTabGroupFeedbackController::ResumeForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_paused_);
+  CHECK(browser_);
+  CHECK(!tab_group_sync_observer_.IsObserving());
+  CHECK(active_tab_change_subscriptions_.empty());
+  tab_group_sync_service_ =
+      TabGroupSyncServiceFactory::GetForProfile(browser_->GetProfile());
+  CHECK(tab_group_sync_service_);
+  aux_profile_switch_paused_ = false;
+  tab_group_sync_observer_.Observe(tab_group_sync_service_);
+  browser_->GetTabStripModel()->AddObserver(this);
+  active_tab_change_subscriptions_.push_back(
+      browser_->RegisterActiveTabDidChange(
+          base::BindRepeating(&SharedTabGroupFeedbackController::MaybeShowIPH,
+                              base::Unretained(this))));
+  // Restore visibility from actual final tabs; do not synthesize an IPH trigger.
+  Init();
 }
 
