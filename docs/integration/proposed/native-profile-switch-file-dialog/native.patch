@@ -102,3 +102,20 @@
 void BrowserSelectFileDialogController::FileSelectionCanceled() {
   select_file_dialog_.reset();
 }
+
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool BrowserSelectFileDialogController::CanRebindForAuxProfileSwitch() const {
+  return !select_file_dialog_;
+}
+
+void BrowserSelectFileDialogController::RebindForAuxProfileSwitch(
+    BrowserWindowInterface& browser) {
+  CHECK(CanRebindForAuxProfileSwitch());
+  CHECK_EQ(From(&browser), this);
+  CHECK_EQ(browser.GetType(), BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(browser.GetProfile()->IsRegularProfile());
+  CHECK_EQ(browser.GetTabStripModel(), &tab_strip_model_.get());
+  CHECK(tab_strip_model_->empty());
+  profile_ = *browser.GetProfile();
+}
+#endif
