+#ifndef CHROME_BROWSER_UI_AUX_SESSION_WRITER_PARTICIPANT_H_
+#define CHROME_BROWSER_UI_AUX_SESSION_WRITER_PARTICIPANT_H_
+
+#include <cstddef>
