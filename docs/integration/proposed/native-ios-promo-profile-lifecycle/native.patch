+bool IOSPromoController::CanPauseForAuxProfileSwitch() const {
+  const auto* education = BrowserUserEducationInterface::From(browser_);
+  return !aux_profile_switch_paused_ && !weak_ptr_factory_.HasWeakPtrs() &&
+         !tab_group_editor_hidden_subscription_ &&
+         (!education || !education->IsAnyFeaturePromoActive());
+}
+
+void IOSPromoController::PauseForAuxProfileSwitch() {
+  CHECK(CanPauseForAuxProfileSwitch());
+  aux_profile_switch_paused_ = true;
+  promo_trigger_subscription_ = {};
+  weak_ptr_factory_.InvalidateWeakPtrs();
+}
+
+void IOSPromoController::ResumeForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_paused_);
+  // Original service factory uses the now committed or restored window profile.
+  SubscribeToCurrentProfile();
+  aux_profile_switch_paused_ = false;
+}
