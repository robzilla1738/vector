diff --git a/chrome/browser/profiles/aux_async_profile_creation_admission.h b/chrome/browser/profiles/aux_async_profile_creation_admission.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/profiles/aux_async_profile_creation_admission.h
@@ -0,0 +1,77 @@
+#ifndef CHROME_BROWSER_PROFILES_AUX_ASYNC_PROFILE_CREATION_ADMISSION_H_
+#define CHROME_BROWSER_PROFILES_AUX_ASYNC_PROFILE_CREATION_ADMISSION_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+
+namespace aux {
+
+// Only synchronous covered dispatch scopes. Zero is NOT constructor-tail,
+// posted-task, storage-durability or whole-profile quiescence evidence.
+struct AsyncProfileCreationAdmissionSnapshot {
+  uint64_t generation;
+  bool closed;
+  size_t active_dispatches;
+  size_t unfinished_initializations;
+  size_t unresolved_initializations;
+};
+
+uint64_t CaptureAsyncProfileCreationGeneration();
+bool IsAsyncProfileCreationGenerationCurrent(uint64_t generation);
+void CloseAsyncProfileCreationAdmission();
+AsyncProfileCreationAdmissionSnapshot InspectAsyncProfileCreationAdmission();
+// Real ProfileImpl constructor/tail/destructor observations only. Destruction
+// before the actual final-init tail becomes sticky unresolved, never success.
+void ObserveAsyncProfileInitializationStarted(const void* profile);
+void ObserveAsyncProfileInitializationFinished(const void* profile);
+void ObserveAsyncProfileInitializationAbandoned(const void* profile);
+
+// Actual native operation scope; construction atomically acquires open admission
+// for this generation. No reset, caller Boolean or JS/environment grant exists.
+class ScopedAsyncProfileCreationDispatch final {
+ public:
+  explicit ScopedAsyncProfileCreationDispatch(uint64_t generation);
+  ~ScopedAsyncProfileCreationDispatch();
+  ScopedAsyncProfileCreationDispatch(const ScopedAsyncProfileCreationDispatch&) = delete;
+  ScopedAsyncProfileCreationDispatch& operator=(const ScopedAsyncProfileCreationDispatch&) = delete;
+  bool admitted() const { return admitted_; }
+ private:
+  const bool admitted_;
+};
+
+template <typename Operation>
+bool RunAsyncProfileCreationDispatch(uint64_t generation, Operation operation) {
+  ScopedAsyncProfileCreationDispatch dispatch(generation);
+  if (!dispatch.admitted())
+    return false;
+  std::move(operation)();
+  return true;
+}
+
+// The initialized callback's documented failure result is nullptr. Preserve
+// failure completion after close; never send nullptr to the created callback.
+template <typename Callback, typename ProfileType>
+void DeliverAsyncProfileInitialization(uint64_t generation,
+                                       Callback callback,
+                                       ProfileType* profile) {
+  if (callback.is_null())
+    return;
+  if (!profile || !RunAsyncProfileCreationDispatch(
+                      generation, [&] { std::move(callback).Run(profile); })) {
+    std::move(callback).Run(nullptr);
+  }
+}
+
+template <typename Callback, typename ProfileType>
+void DeliverAsyncProfileCreated(uint64_t generation,
+                                Callback callback,
+                                ProfileType* profile) {
+  if (!callback.is_null()) {
+    RunAsyncProfileCreationDispatch(
+        generation, [&] { std::move(callback).Run(profile); });
+  }
+}
+
+}  // namespace aux
+#endif
diff --git a/chrome/browser/profiles/aux_async_profile_creation_admission.cc b/chrome/browser/profiles/aux_async_profile_creation_admission.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/profiles/aux_async_profile_creation_admission.cc
@@ -0,0 +1,92 @@
+#include "chrome/browser/profiles/aux_async_profile_creation_admission.h"
+
+#include <atomic>
+#include <limits>
+#include <mutex>
+#include <set>
+
+namespace aux {
+namespace {
+constexpr uint64_t kClosed = uint64_t{1} << 63;
+constexpr uint64_t kActiveMask = kClosed - 1;
+// One native process-owned state, unaffected by ProfileManager construction.
+// The only admission transition is open-generation1 -> permanently closed.
+constinit std::atomic<uint64_t> state{0};
+struct Initializations {
+  Initializations();
+  ~Initializations();
+  std::mutex mutex;
+  std::set<const void*> unfinished;
+  size_t unresolved = 0;
+};
+Initializations::Initializations() = default;
+Initializations::~Initializations() = default;
+Initializations& Records() {
+  // Native process lifetime; no teardown callback may reset pending/unknown.
+  static Initializations* const records = new Initializations;
+  return *records;
+}
+void RecordUnresolved(Initializations& records) {
+  if (records.unresolved != std::numeric_limits<size_t>::max())
+    ++records.unresolved;
+}
+
+bool Acquire(uint64_t generation) {
+  if (generation != 1)
+    return false;
+  uint64_t observed = state.load(std::memory_order_acquire);
+  for (;;) {
+    if ((observed & kClosed) || (observed & kActiveMask) == kActiveMask)
+      return false;
+    if (state.compare_exchange_weak(observed, observed + 1,
+                                    std::memory_order_acq_rel,
+                                    std::memory_order_acquire)) {
+      return true;
+    }
+  }
+}
+}  // namespace
+
+uint64_t CaptureAsyncProfileCreationGeneration() {
+  return (state.load(std::memory_order_acquire) & kClosed) ? 0 : 1;
+}
+bool IsAsyncProfileCreationGenerationCurrent(uint64_t generation) {
+  return generation == 1 && CaptureAsyncProfileCreationGeneration() == generation;
+}
+void CloseAsyncProfileCreationAdmission() {
+  state.fetch_or(kClosed, std::memory_order_acq_rel);
+}
+AsyncProfileCreationAdmissionSnapshot InspectAsyncProfileCreationAdmission() {
+  auto& records = Records();
+  std::lock_guard<std::mutex> lock(records.mutex);
+  const uint64_t observed = state.load(std::memory_order_acquire);
+  return {(observed & kClosed) ? uint64_t{0} : uint64_t{1},
+          (observed & kClosed) != 0,
+          static_cast<size_t>(observed & kActiveMask),
+          records.unfinished.size(), records.unresolved};
+}
+void ObserveAsyncProfileInitializationStarted(const void* profile) {
+  auto& records = Records();
+  std::lock_guard<std::mutex> lock(records.mutex);
+  if (!profile || !records.unfinished.insert(profile).second)
+    RecordUnresolved(records);
+}
+void ObserveAsyncProfileInitializationFinished(const void* profile) {
+  auto& records = Records();
+  std::lock_guard<std::mutex> lock(records.mutex);
+  if (records.unfinished.erase(profile) != 1)
+    RecordUnresolved(records);
+}
+void ObserveAsyncProfileInitializationAbandoned(const void* profile) {
+  auto& records = Records();
+  std::lock_guard<std::mutex> lock(records.mutex);
+  if (records.unfinished.erase(profile) == 1)
+    RecordUnresolved(records);
+}
+ScopedAsyncProfileCreationDispatch::ScopedAsyncProfileCreationDispatch(
+    uint64_t generation) : admitted_(Acquire(generation)) {}
+ScopedAsyncProfileCreationDispatch::~ScopedAsyncProfileCreationDispatch() {
+  if (admitted_)
+    state.fetch_sub(1, std::memory_order_acq_rel);
+}
+}  // namespace aux
