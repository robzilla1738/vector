 // Test that an older valid file is selected if the newer file is invalid.
+TEST_P(CommandStorageBackendParamTest, AdmissionReadPreservesCandidates) {
+  const auto latest = WriteValidSessionFile(8888);
+  const auto older = GetFilePath(7777);
+  const auto invalid = GetFilePath(9999);
+  ASSERT_TRUE(base::CopyFile(latest, older));
+  ASSERT_TRUE(base::WriteFile(invalid, "invalid header"));
+  auto backend = CreateBackend();
+  auto result = backend->ReadLastSessionCommandsPreservingFiles();
+  EXPECT_FALSE(result.error_reading);
+  EXPECT_FALSE(backend->inited_for_testing());
+  EXPECT_TRUE(base::PathExists(latest));
+  EXPECT_TRUE(base::PathExists(older));
+  EXPECT_TRUE(base::PathExists(invalid));
+
+  // Ordinary accepted use still performs Chromium's original cleanup.
+  backend->ReadLastSessionCommands();
+  EXPECT_TRUE(backend->inited_for_testing());
+  EXPECT_TRUE(base::PathExists(latest));
+  EXPECT_FALSE(base::PathExists(older));
+  EXPECT_FALSE(base::PathExists(invalid));
+}
+
+TEST_P(CommandStorageBackendParamTest, FailedAdmissionReadPreservesCandidates) {
+  const auto first = GetFilePath(8888);
+  const auto second = GetFilePath(9999);
+  ASSERT_TRUE(base::WriteFile(first, "invalid first header"));
+  ASSERT_TRUE(base::WriteFile(second, "invalid second header"));
+  auto backend = CreateBackend();
+  EXPECT_TRUE(backend->ReadLastSessionCommandsPreservingFiles().error_reading);
+  EXPECT_FALSE(backend->inited_for_testing());
+  EXPECT_TRUE(base::PathExists(first));
+  EXPECT_TRUE(base::PathExists(second));
+}
