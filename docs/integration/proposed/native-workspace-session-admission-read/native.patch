+CommandStorageBackend::ReadCommandsResult
+CommandStorageBackend::ReadLastSessionCommandsPreservingFiles() {
+  // FindLastSessionFile is a const directory/header/marker read. Do not call
+  // InitIfNecessary: it deletes all older and invalid session candidates.
+  const auto info = inited_ ? last_session_info_ : FindLastSessionFile();
+  SessionFileReader::ReadResult read_result;
+  if (info) {
+    read_result = SessionFileReader::Read(info->path, encryptor_.get());
+  } else {
+    read_result.status = info.error();
+  }
+  ReadCommandsResult result;
+  result.commands = std::move(read_result.commands);
+  result.error_reading = IsError(read_result.status);
+  return result;
+}
