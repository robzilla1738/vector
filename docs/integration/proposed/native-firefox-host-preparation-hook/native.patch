+void ExternalProcessImporterHost::SetAuxPreparationCallback(
+    AuxPreparationCallback callback) {
+  aux_preparation_ = std::move(callback);
+}
+
+void ExternalProcessImporterHost::OnAuxPreparationComplete(bool succeeded) {
+  // Original410665c: cancellation/destruction must not restart this host.
+  if (cancelled_) {
+    return;
+  }
+  if (!succeeded) {
+    NotifyImportEnded();  // Notifies and deletes this host, as in the original.
+    return;
+  }
+  aux_preparation_complete_ = true;
+  LaunchImportIfReady();
+}
+#endif
