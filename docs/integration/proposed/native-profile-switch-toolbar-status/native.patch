+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool MediaToolbarButtonView::CanPrepareForAuxProfileSwitch(
+    Profile* target) const {
+  return target && target->IsRegularProfile() &&
+         browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         !aux_profile_switch_paused_ && !IsMenuShowing() &&
+         !MediaDialogView::IsShowing() &&
+         MediaNotificationServiceFactory::GetForProfile(target);
+}
+
+void MediaToolbarButtonView::PrepareForAuxProfileSwitch() {
+  CHECK(!aux_profile_switch_paused_);
+  CHECK(!IsMenuShowing());
+  CHECK(!MediaDialogView::IsShowing());
+  aux_profile_switch_paused_ = true;
+  // Real destruction unregisters from the old MediaItemManager. It may call
+  // Hide on this same button, whose permanent observer list must survive.
+  controller_.reset();
+}
+
+void MediaToolbarButtonView::RebindForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_paused_);
+  CHECK(!controller_);
+  CHECK(browser_->GetProfile()->IsRegularProfile());
+  service_ = MediaNotificationServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  CHECK(service_);
+  if (context_menu_) {
+    context_menu_->RebindForAuxProfileSwitch(*browser_->GetProfile());
+  }
+  aux_profile_switch_paused_ = false;
+  controller_ = std::make_unique<MediaToolbarButtonController>(
+      this, service_->media_item_manager());
+}
+#endif
+
 void MediaToolbarButtonView::AddObserver(MediaToolbarButtonObserver* observer) {
   observers_.AddObserver(observer);
