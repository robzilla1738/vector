+void AppMenuIconController::PrepareForAuxProfileSwitch() {
+  CHECK(!aux_profile_switch_paused_);
+  aux_profile_switch_paused_ = true;
+  global_error_observation_.Reset();
+}
+
+void AppMenuIconController::RebindForAuxProfileSwitch(Profile& profile) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK(profile.IsRegularProfile());
+  CHECK(!global_error_observation_.IsObserving());
+  profile_ = &profile;
+  global_error_observation_.Observe(
+      GlobalErrorServiceFactory::GetForProfile(profile_));
+  aux_profile_switch_paused_ = false;
+  UpdateDelegate();
+}
+#endif
