@@ -69,6 +81,31 @@
     *error = "Extension has no available action in the active tab";
     return false;
   }
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+  if (from_profile_search) {
+    // Original 40c9654/40c96f0 closes the actual search sender before invoking
+    // its window's action. Close runs the real WebContents delegate lifecycle.
+    auto browser_weak = browser->GetWeakPtr();
+    sender->Close();
+    browser = browser_weak.get();
+    if (!browser || browser->GetProfile() != profile || !browser->GetWindow()) {
+      *error = "Search browser is no longer available";
+      return false;
