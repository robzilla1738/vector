+    container = ExtensionsContainer::From(*browser);
+    action = container ? container->GetActionForId(extension->id()) : nullptr;
+    tab = browser->GetActiveTabInterface();
+    contents = container ? container->GetActiveWebContents() : nullptr;
+    if (!contents && tab) contents = tab->GetContents();
+    if (!action || !contents || contents->GetBrowserContext() != context ||
+        !action->IsEnabled(contents)) {
+      *error = "Extension has no available action in the active tab";
+      return false;
+    }
+  }
+#endif
   browser->GetWindow()->Activate();
   action->ExecuteUserAction(ToolbarActionViewModel::InvocationSource::kApi);
