+void CommandStorageManager::CloseWriterAdmissionAndObserve(
+    base::OnceCallback<void(SessionManagerCloseObservation)> done) {
+  writer_admission_.Close();
+  weak_factory_for_timer_.InvalidateWeakPtrs();
+  SessionManagerCloseObservation initial;
+  initial.admission_closed = writer_admission_.closed();
+  initial.admission_accounting_unknown = writer_admission_.unknown();
+  initial.unsubmitted_commands = pending_commands_.size();
+  initial.unsubmitted_reset = pending_reset_;
