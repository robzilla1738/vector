+      ShouldWriteEncryptedFiles() && !encrypted_backend_;
+  auto report = base::BindPostTaskToCurrentDefault(std::move(done));
+  auto observe = base::BarrierCallback<SessionBackendCloseObservation>(
+      encrypted_backend_ ? 2 : 1,
+      base::BindOnce(
+          [](SessionManagerCloseObservation result,
+             base::OnceCallback<void(SessionManagerCloseObservation)> callback,
+             std::vector<SessionBackendCloseObservation> observations) {
+            result.backends = std::move(observations);
+            std::move(callback).Run(std::move(result));
+          }, std::move(initial), std::move(report)));
+  for (auto backend : {backend_, encrypted_backend_}) {
+    if (!backend) continue;
+    const auto kind = backend == encrypted_backend_ ? SessionBackendKind::kEncrypted
+                                                    : SessionBackendKind::kClear;
+    auto completion = base::BindOnce(
+        [](base::RepeatingCallback<void(SessionBackendCloseObservation)> callback,
+           SessionBackendCloseObservation result) { callback.Run(result); },
+        observe);
+    if (!backend_task_runner_->PostNonNestableTask(
+            FROM_HERE,
+            base::BindOnce(&CommandStorageBackend::CloseWriterAdmissionAndObserve,
+                           std::move(backend), std::move(completion)))) {
+      SessionBackendCloseObservation result;
+      result.kind = kind;
+      result.task_rejected = true;
+      observe.Run(result);
+    }
+  }
+}
