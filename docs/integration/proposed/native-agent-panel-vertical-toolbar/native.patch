   // Start with some preliminary values.
   layout.force_top_container_to_top =
       layout_data_->tab_strip_type != TabStripType::kHorizontal;
+
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+  // The supplied Agent panel shares the toolbar row in vertical-tab windows.
+  // Other panel entries keep Chromium's default vertical-tab layout policy.
+  if (layout_data_->tab_strip_type == TabStripType::kVertical &&
+      views().side_panel &&
+      views().side_panel->GetCurrentEntryType() == SidePanelType::kToolbar) {
+    if (auto* browser_view =
+            views::AsViewClass<BrowserView>(views().browser_view.get())) {
+      auto* side_panel_ui = SidePanelUI::From(browser_view->browser());
+      if (side_panel_ui && side_panel_ui->IsSidePanelEntryShowing(
+              SidePanelEntryKey(SidePanelEntryId::kExtension,
+                                aux::kAgentExtensionId))) {
+        layout.force_top_container_to_top = false;
+      }
+    }
+  }
+#endif
 
