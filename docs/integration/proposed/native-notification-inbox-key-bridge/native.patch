+std::optional<std::array<uint8_t, 32>>
+LoadAgentInboxMasterKey(const base::FilePath &home) {
+  auto result = RunCarrier(home, "agent-inbox-key", {});
+  const auto *encoded = result ? result->FindString("key") : nullptr;
+  if (!encoded || result->size() != 1)
+    return std::nullopt;
+  auto bytes = base::Base64Decode(*encoded);
+  if (!bytes || bytes->size() != 32 || base::Base64Encode(*bytes) != *encoded)
+    return std::nullopt;
+  std::array<uint8_t, 32> key;
+  std::copy(bytes->begin(), bytes->end(), key.begin());
+  return key;
+}
