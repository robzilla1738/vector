+        GetState() == STATE_PRESSED) {
+      cc::PaintFlags flags;
+      flags.setAntiAlias(true);
+      flags.setColor(SkColorSetA(foreground, dark ? 0x1a : 0x14));
+      canvas->DrawRoundRect(gfx::RectF(GetLocalBounds()), 6, flags);
