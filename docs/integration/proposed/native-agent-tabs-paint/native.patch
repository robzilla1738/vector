+// Values recovered from the supplied native mixer, not155 ColorId numbers.
+enum class AgentTabsColor {
+  kSurfacePrimary,
+  kSurfaceBorder,
+  kSurfaceBorderStrong,
+  kPrimaryForeground,
+  kSecondaryForeground,
+  kSidebarMutedForeground,
+  kSidebarHover,
+  kMenuHover,
+};
+
+SkColor ResolveColor(const views::View* view, AgentTabsColor role) {
+  CHECK(view->GetWidget());
+  const bool dark = view->GetWidget()->GetColorMode() ==
+                    ui::ColorProviderKey::ColorMode::kDark;
+  switch (role) {
+    case AgentTabsColor::kSurfacePrimary:
+      return dark ? 0x14fafafa : 0xffffffff;
+    case AgentTabsColor::kSurfaceBorder:
+      return dark ? 0x26fafafa : 0x1a0a0a0a;
+    case AgentTabsColor::kSurfaceBorderStrong:
+      return dark ? 0x33fafafa : 0x260a0a0a;
+    case AgentTabsColor::kPrimaryForeground:
+      return dark ? 0xd9fafafa : 0xd90a0a0a;
+    case AgentTabsColor::kSecondaryForeground:
+      return dark ? 0x8cfafafa : 0x8c0a0a0a;
+    case AgentTabsColor::kSidebarMutedForeground:
+      return dark ? 0x73fafafa : 0x730a0a0a;
+    case AgentTabsColor::kSidebarHover:
+      // The original mixer aliases SidebarItemBackgroundHover247 to220.
+      return dark ? 0x14fafafa : 0x140a0a0a;
+    case AgentTabsColor::kMenuHover:
+      return dark ? 0x1afafafa : 0x140a0a0a;
+  }
+}
