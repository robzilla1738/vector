+class AgentTabsSeparator : public views::Separator {
+  METADATA_HEADER(AgentTabsSeparator, views::Separator)
+ public:
+  void OnPaint(gfx::Canvas* canvas) override {
+    // Keep155 Separator's pixel alignment, with the recovered private color.
+    views::View::OnPaint(canvas);
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    const gfx::Insets insets = GetInsets();
+    const gfx::Rect bounds = GetContentsBounds();
+    const float scale = canvas->UndoDeviceScaleFactor();
+    const int x = insets.left() == 0 ? std::floor(bounds.x() * scale)
+                                     : std::ceil(bounds.x() * scale);
+    const int y = insets.top() == 0 ? std::floor(bounds.y() * scale)
+                                    : std::ceil(bounds.y() * scale);
+    const int right = insets.right() == 0 ? std::ceil(bounds.right() * scale)
+                                          : std::floor(bounds.right() * scale);
+    const int bottom = insets.bottom() == 0
+                           ? std::ceil(bounds.bottom() * scale)
+                           : std::floor(bounds.bottom() * scale);
+    canvas->FillRect({x, y, std::max(1, right - x), std::max(1, bottom - y)},
+                     ResolveColor(this, AgentTabsColor::kSurfaceBorder));
+  }
+};
