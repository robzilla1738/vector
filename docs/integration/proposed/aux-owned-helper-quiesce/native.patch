+void BrowserPlatform::QuiesceOwnedDirectHelpersForMigration(
+    OwnedDirectHelperQuiesceCallback done) {
+  // This call closes carrier admission before starting asynchronous daemon
+  // drain through the existing scoped API. It does not wait for unrelated work.
+  owned_helper_quiesce_.CloseRequested();
+  CloseInstallationCarrierAdmission();
+  direct_daemon_admission_closed_ = true;
+  if (InspectOwnedDirectHelperQuiesce().direct_daemon) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(done),
+                                InspectOwnedDirectHelperQuiesce()));
+    return;
+  }
+  QuiesceDirectDaemonForMigration(base::BindOnce(
+      [](base::WeakPtr<BrowserPlatform> self,
+         OwnedDirectHelperQuiesceCallback done,
+         DirectDaemonQuiesceResult direct) {
+        if (!self) return;  // Lost completion remains pending; never success.
+        self->owned_helper_quiesce_.ObserveDirectResult(direct);
+        std::move(done).Run(self->InspectOwnedDirectHelperQuiesce());
+      }, weak_.GetWeakPtr(), std::move(done)));
+}
+OwnedDirectHelperQuiesceObservation
+BrowserPlatform::InspectOwnedDirectHelperQuiesce() const {
+  return owned_helper_quiesce_.Inspect(InspectInstallationCarrierCustody());
+}
 void BrowserPlatform::Shutdown() {
