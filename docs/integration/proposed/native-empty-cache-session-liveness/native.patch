+// A profile transfer retains an empty cache for the active profile. That
+// placeholder is not another open workspace when deciding whether the last
+// real window/tab should be preserved for session restore.
+bool IsEmptyAuxProfileSwitchCache(BrowserWindowInterface* browser) {
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+  const auto* state = BrowserInitState::From(browser);
+  return state && state->is_aux_profile_switch_cache() &&
+         browser->GetTabStripModel()->empty();
+#else
+  return false;
+#endif
+}
