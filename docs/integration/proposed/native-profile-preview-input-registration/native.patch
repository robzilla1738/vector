+bool ProfilePreviewInput::AttachToWidget() {
+  auto* region = region_.view();
+  auto* widget = region ? region->GetWidget() : nullptr;
+  auto* root = widget ? widget->GetRootView() : nullptr;
+  if (!root) {
+    return false;
+  }
+  if (event_root_.view() == root) {
+    return true;
+  }
+  DetachFromWidget();
+  event_root_.SetView(root);
+  root->AddPreTargetHandler(this, ui::EventTarget::Priority::kDefault);
+  return true;
+}
+void ProfilePreviewInput::DetachFromWidget() {
+  if (auto* root = event_root_.view()) {
+    root->RemovePreTargetHandler(this);
+    event_root_.SetView(nullptr);
+  }
+}
 
