+void ActiveTaskContextProviderImpl::PauseForAuxProfileSwitch() {
+  CHECK(CanPauseForAuxProfileSwitch());
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  ++callback_id_;
+  Observe(nullptr);
+  contextual_tasks_service_observation_.Reset();
+  if (auto* tabs = TabListInterface::From(browser_window_)) {
+    tabs->RemoveTabListInterfaceObserver(this);
+  }
+  contextual_tasks_panel_controller_ = nullptr;
+  contextual_tasks_service_ = nullptr;
+}
