+bool ContextualTasksSidePanelCoordinator::CanRetireForAuxProfileSwitch() {
+  for (auto* tab : TabListInterface::From(browser_window_)->GetAllTabs()) {
+    auto* contents = tab->GetContents();
+    if (!contents) continue;
+    auto* data = ContextualTasksWebContentsUserData::FromWebContents(contents);
+    if ((data && data->pending_task_id().has_value()) ||
+        (contextual_tasks_service_ &&
+         contextual_tasks_service_->GetContextualTaskForTab(
+             sessions::SessionTabHelper::IdForTab(contents)).has_value())) {
+      return false;
+    }
+  }
+  return task_id_to_web_contents_cache_.empty() && !in_cobrowsing_session_ &&
+         !closing_entry_source_ &&
+         !contextual_tasks_panel_host_->IsPanelInitialized() &&
+         !contextual_tasks_panel_host_->IsPanelOpenForContextualTask() &&
+         !contextual_tasks_panel_host_->GetWebContents() &&
+         !contextual_tasks_panel_host_->GetToolbarWebContents();
+}
