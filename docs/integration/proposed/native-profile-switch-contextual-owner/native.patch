+void ActiveTaskContextProviderImpl::RebindForAuxProfileSwitch(
+    ContextualTasksService* service) {
+  CHECK(service);
+  CHECK(!contextual_tasks_service_);
+  contextual_tasks_service_ = service;
+  // The resumed coordinator injects itself and resumes observation normally.
+}
