+bool ServiceWorkerTaskQueue::CanAdmitStart() const {
+  return WorkerStartAdmissionOwner().gate.Accepts(start_admission_generation_);
+}
+
+ServiceWorkerTaskQueue::QueueStartAdmissionSnapshot
+ServiceWorkerTaskQueue::InspectQueueStartAdmission() const {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  QueueStartAdmissionSnapshot result;
+  result.browser_context_token = browser_context_->UniqueToken();
+  result.captured_generation = start_admission_generation_;
+  for (const auto& [context, state] : worker_state_map_) {
+    result.workers.push_back({context, state->worker_id(), state->IsStarting(),
+                              state->IsReady()});
+  }
+  result.retired_workers = retired_worker_observations_;
+  for (const auto& [context, tasks] : pending_tasks_map_) {
+    result.pending_tasks += tasks.size();
+  }
+  result.registration_callbacks = registration_callbacks_;
+  result.verification_callbacks = verification_callbacks_;
+  result.pending_storage_registrations = pending_storage_registrations_.size();
+  result.pending_unregistrations = pending_unregistrations_.size();
+  result.closed_registration_results = closed_registration_results_;
+  result.closed_verification_results = closed_verification_results_;
+  return result;
+}
+
+void ServiceWorkerTaskQueue::CloseQueueStartAdmission() {
+  // Destroying OneShotTimers cancels their pending retries. Keep worker states,
+  // activations and tasks: empty retry maps are not worker-stop evidence.
+  worker_start_retries_.clear();
+  worker_registration_retries_.clear();
+  worker_unregistration_wait_retries_.clear();
+}
+
+// static
+ServiceWorkerTaskQueue::ProcessStartAdmissionSnapshot
+ServiceWorkerTaskQueue::InspectStartAdmissionForMigration() {
+  auto& owner = WorkerStartAdmissionOwner();
+  ProcessStartAdmissionSnapshot result;
+  result.admission_open = owner.gate.open();
+  result.generation = owner.gate.generation();
+  for (auto* queue : owner.queues) {
+    result.queues.push_back(queue->InspectQueueStartAdmission());
+  }
+  result.destroyed_queues = owner.destroyed;
+  return result;
+}
+
+// static
+ServiceWorkerTaskQueue::ProcessStartAdmissionSnapshot
+ServiceWorkerTaskQueue::CloseStartAdmissionForMigration() {
+  auto& owner = WorkerStartAdmissionOwner();
+  owner.gate.Close();  // Close globally BEFORE cancelling current queue timers.
+  for (auto* queue : owner.queues) {
+    queue->CloseQueueStartAdmission();
+  }
+  return InspectStartAdmissionForMigration();
+}
 
