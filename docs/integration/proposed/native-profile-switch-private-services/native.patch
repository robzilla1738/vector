+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool BrowserWindowFeatures::CanPrepareAuxPrivateProfileServices(
+    Profile* target) const {
+  auto* view = browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  return target && target->IsRegularProfile() && browser_ &&
+         browser_->GetProfile()->IsRegularProfile() && view &&
+         !aux_private_profile_services_.active &&
+         (!extension_keybinding_registry_ || view->GetFocusManager()) &&
+         (!incognito_clear_browsing_data_dialog_coordinator_ ||
+          incognito_clear_browsing_data_dialog_coordinator_
+              ->CanRebindForAuxProfileSwitch()) &&
+         (!default_search_extension_controlled_controller_ ||
+          default_search_extension_controlled_controller_
+              ->CanRebindForAuxProfileSwitch());
+}
+
+void BrowserWindowFeatures::BeginAuxPrivateProfileServices(Profile* target) {
+  CHECK(CanPrepareAuxPrivateProfileServices(target));
+  auto& state = aux_private_profile_services_;
+  state.active = true;
+  state.source = browser_->GetProfile();
+  state.had_instant = !!instant_controller_;
+  state.had_keybindings = !!extension_keybinding_registry_;
+  state.had_extension_window = !!extension_window_controller_;
+  // Keep source Instant/window owners through genuine detach notifications.
+  // They still refer to the correct source profile until the empty commit.
+  // Its real destructor unregisters old accelerators and clears ONLY this
+  // registry from the actual source profile's active-window registry.
+  extension_keybinding_registry_.reset();
+}
+
+void BrowserWindowFeatures::RebindAuxPrivateProfileServices() {
+  auto& state = aux_private_profile_services_;
+  CHECK(state.active);
+  CHECK(browser_->GetTabStripModel()->empty());
+  Profile* profile = browser_->GetProfile();
+  CHECK(profile->IsRegularProfile());
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser_);
+  CHECK(view);
+  // Keep the source controller through genuine source-tab detach events.
+  // Its original destructor/constructor notify the real extension window list.
+  extension_window_controller_.reset();
+  if (state.had_extension_window) {
+    extension_window_controller_ =
+        std::make_unique<extensions::BrowserExtensionWindowController>(browser_);
+  }
+  if (state.had_keybindings) {
+    CHECK(view->GetFocusManager());
+    extension_keybinding_registry_ =
+        std::make_unique<ExtensionKeybindingRegistryViews>(
+            browser_, extensions::ExtensionKeybindingRegistry::ALL_EXTENSIONS,
+            view->GetFocusManager());
+  }
+  instant_controller_.reset();
+  if (state.had_instant) {
+    CHECK(search::IsInstantExtendedAPIEnabled());
+    instant_controller_ = std::make_unique<BrowserInstantController>(
+        profile, browser_->GetTabStripModel());
+  }
+  if (incognito_clear_browsing_data_dialog_coordinator_) {
+    incognito_clear_browsing_data_dialog_coordinator_
+        ->RebindForAuxProfileSwitch(*browser_);
+  }
+  if (default_search_extension_controlled_controller_) {
+    default_search_extension_controlled_controller_->RebindForAuxProfileSwitch();
+  }
+}
+
+void BrowserWindowFeatures::FinishAuxPrivateProfileServices() {
+  CHECK(aux_private_profile_services_.active);
+  // Same physical window means no new OS activation notification. Bind the
+  // actual target registry to the genuine current activation state explicitly.
+  if (extension_keybinding_registry_) {
+    extension_keybinding_registry_->OnHostActivationChanged(
+        browser_->GetWindow()->IsActive());
+  }
+  aux_private_profile_services_ = {};
+}
+
+void BrowserWindowFeatures::AbortAuxPrivateProfileServices() {
+  auto& state = aux_private_profile_services_;
+  CHECK(state.active);
+  CHECK_EQ(browser_->GetProfile(), state.source);
+  // Abort is called after the core has restored genuine source collections.
+  // Instant/window/dialog owners never changed; recreate only old accelerators.
+  if (state.had_keybindings) {
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser_);
+    CHECK(view && view->GetFocusManager());
+    extension_keybinding_registry_ =
+        std::make_unique<ExtensionKeybindingRegistryViews>(
+            browser_, extensions::ExtensionKeybindingRegistry::ALL_EXTENSIONS,
+            view->GetFocusManager());
+  }
+  FinishAuxPrivateProfileServices();
+}
+#endif
