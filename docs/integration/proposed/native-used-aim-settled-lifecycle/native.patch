+
+bool ContextualSearchboxHandler::CanRetireForAuxProfileSwitch() const {
+  if (aux_pending_navigation_ != 0 ||
+      !pending_tab_context_fetches_.empty() || context_input_data_ ||
+      tab_context_snapshot_ || !selected_tabs.empty() ||
+      (autocomplete_controller() && !autocomplete_controller()->done()) ||
+      (query_contextualizer_ &&
+       query_contextualizer_->HasPendingWorkForAuxProfileSwitch()) ||
+      !drive_upload_click_callback_.is_null() ||
+      (screenshare_controller_ &&
+       !screenshare_controller_->CanRetireForAuxProfileSwitch())) {
+    return false;
+  }
+#if !BUILDFLAG(IS_ANDROID)
+  if (drive_picker_controller_ || drive_disclaimer_controller_ ||
+      drive_picker_deactivation_blocker_ ||
+      drive_picker_result_handler_receiver_.is_bound()) {
+    return false;
+  }
+#if BUILDFLAG(ENABLE_DICE_SUPPORT)
+  if (composebox_drive_signin_promo_controller_) {
+    return false;
+  }
+#endif
+#endif
+  return true;
+}
