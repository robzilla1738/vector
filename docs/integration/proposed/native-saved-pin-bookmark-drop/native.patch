+std::optional<gfx::Rect>
+VerticalTabBookmarksView::Impl::UpdateExternalInsertion(
+    const GURL& url,
+    const gfx::Point& screen_point) {
+  // Original4612384: actual model/visibility/bounds, no URL-based ownership.
+  if (!ScopeCurrent() || !url.is_valid() || !bookmark_model_ ||
+      !bookmark_model_->loaded() || !view_->GetVisible() ||
+      !view_->GetBoundsInScreen().Contains(screen_point)) {
+    ClearExternalInsertion(true);
+    return std::nullopt;
+  }
+  if (!external_insertion_) {
+    bounds_->Complete();
+    external_bounds_.clear();
+    for (const auto* node : visible_)
+      if (auto row = rows_.find(node); row != rows_.end())
+        external_bounds_.emplace(node, row->second->bounds());
+    external_insertion_ = true;
+    external_gap_.reset();
+    external_folder_ = nullptr;
+  }
+  if (external_folder_) {
+    if (auto row = rows_.find(external_folder_); row != rows_.end())
+      row->second->SetDropIndicator(0);
+    external_folder_ = nullptr;
+  }
+  gfx::Point point = screen_point;
+  views::View::ConvertPointFromScreen(contents_, &point);
+  size_t insertion = visible_.size();
+  const Node* parent = nullptr;
+  size_t index = 0;
+  for (size_t i = 0; i < visible_.size(); ++i) {
+    const auto* node = visible_[i];
+    auto snapshot = external_bounds_.find(node);
+    if (snapshot == external_bounds_.end())
+      continue;
+    const gfx::Rect& rect = snapshot->second;
+    if (insertion == visible_.size() && point.y() < rect.CenterPoint().y())
+      insertion = i;
+    // Full frozen folder row bounds, not indentation or moving hit bounds.
+    if (node->is_folder() && rect.Contains(point)) {
+      parent = node;
+      index = 0;
+      insertion = i + 1;
+      if (auto row = rows_.find(node); row != rows_.end()) {
+        row->second->SetDropIndicator(1);
+        external_folder_ = node;
+      }
+      break;
+    }
+  }
+  if (!parent && insertion < visible_.size()) {
+    const auto* next = visible_[insertion];
+    parent = next->parent();
+    if (parent)
+      index = parent->GetIndexOf(next).value_or(parent->children().size());
+  } else if (!parent && !visible_.empty()) {
+    const auto* last = visible_.back();
+    parent = last->parent();
+    if (parent)
+      index = parent->GetIndexOf(last).value_or(parent->children().size()) + 1;
+  }
+  if (!parent) {
+    parent = DefaultExternalParent();
+    if (parent)
+      index = parent->children().size();
+  }
+  if (!parent || !parent->is_folder()) {
+    ClearExternalInsertion(true);
+    return std::nullopt;
+  }
+  external_parent_ = parent;
+  external_index_ = std::min(index, parent->children().size());
+  insertion = std::min(insertion, visible_.size());
+  if (external_gap_ != insertion) {
+    const size_t begin =
+        external_gap_ ? std::min(*external_gap_, insertion) : insertion;
+    const size_t end =
+        external_gap_ ? std::max(*external_gap_, insertion) : visible_.size();
+    external_gap_ = insertion;
+    for (size_t i = begin; i < end; ++i) {
+      const auto* node = visible_[i];
+      auto row = rows_.find(node);
+      auto snapshot = external_bounds_.find(node);
+      if (row == rows_.end() || snapshot == external_bounds_.end())
+        continue;
+      gfx::Rect target = snapshot->second;
+      if (i >= insertion)
+        target.Offset(0, 36);  // Original46129b4: row32 + spacing4.
+      bounds_->SetTargetBounds(row->second, target);
+    }
+    bounds_animating_ = bounds_->IsAnimating();
+    contents_->SchedulePaint();
+  }
+  gfx::Rect target(8, 1, std::max(0, contents_->width() - 16), 32);
+  if (insertion < visible_.size() &&
+      external_bounds_.contains(visible_[insertion])) {
+    target = external_bounds_.at(visible_[insertion]);
+  } else if (!visible_.empty() && external_bounds_.contains(visible_.back())) {
+    target = external_bounds_.at(visible_.back());
+    target.set_y(target.bottom() + 4);
+  }
+  if (auto depth = depths_.find(parent); depth != depths_.end())
+    target.Inset(gfx::Insets::TLBR(0, (depth->second + 1) * 14, 0, 0));
+  gfx::Point origin = target.origin();
+  views::View::ConvertPointToScreen(contents_, &origin);
+  return gfx::Rect(origin, target.size());
+}
+
+void VerticalTabBookmarksView::Impl::ClearExternalInsertion(bool animate) {
+  if (!external_insertion_)
+    return;
+  external_insertion_ = false;
+  external_gap_.reset();
+  external_parent_ = nullptr;
+  external_folder_ = nullptr;
+  external_index_ = 0;
+  ClearIndicators();
+  for (const auto& [node, rect] : external_bounds_) {
+    auto row = rows_.find(node);
+    if (row == rows_.end())
+      continue;
+    if (animate)
+      bounds_->SetTargetBounds(row->second, rect);
+    else {
+      bounds_->StopAnimatingView(row->second);
+      row->second->SetBoundsRect(rect);
+    }
+  }
+  bounds_animating_ = animate && bounds_->IsAnimating();
+  external_bounds_.clear();
+  contents_->SchedulePaint();
+}
+
+const Node* VerticalTabBookmarksView::Impl::CommitExternalBookmark(
+    const GURL& url,
+    std::u16string title) {
+  // Original4613074 clears projection before AddURL. Missing/invalid explicit
+  // destination uses original4612dec's default and appends to it.
+  const Node* parent = external_insertion_ ? external_parent_.get() : nullptr;
+  const bool explicit_destination = parent && parent->is_folder();
+  size_t index = external_index_;
+  ClearExternalInsertion(false);
+  if (!ScopeCurrent() || !bookmark_model_ || !bookmark_model_->loaded() ||
+      !url.is_valid())
+    return nullptr;
+  if (!explicit_destination)
+    parent = DefaultExternalParent();
+  if (!parent || !parent->is_folder())
+    return nullptr;
+  index = explicit_destination ? std::min(index, parent->children().size())
+                               : parent->children().size();
+  if (title.empty())
+    title = base::UTF8ToUTF16(url.has_host() ? url.host() : url.spec());
+  const auto alive = weak_.GetWeakPtr();
+  const Node* created = bookmark_model_->AddURL(parent, index, title, url);
+  if (!alive || !created)
+    return nullptr;
+  // Real model observers may reenter in155. Reacquire the new node after the
+  // source pending-navigation/activated callback, never return a retired owner.
+  const int64_t id = created->id();
+  const auto uuid = created->uuid();
+  QueueNavigation(*created);
+  if (activated_)
+    activated_.Run();
+  if (!alive || !ScopeCurrent())
+    return nullptr;
+  const Node* current = Find(id);
+  return current && current->uuid() == uuid ? current : nullptr;
+}
 
