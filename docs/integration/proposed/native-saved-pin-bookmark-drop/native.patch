+// Original4612dec: visible roots in local-bar/other/mobile, then account
+// order; if none are visible, first non-null root in that same order. Chromium
+// 155's account getters enforce the same transport-feature invariant
+// themselves.
+const Node* VerticalTabBookmarksView::Impl::DefaultExternalParent() const {
+  if (!ScopeCurrent() || !bookmark_model_ || !bookmark_model_->loaded())
+    return nullptr;
+  const auto roots = Roots(*bookmark_model_);
+  for (const auto* node : roots)
+    if (node && node->IsVisible())
+      return node;
+  for (const auto* node : roots)
+    if (node)
+      return node;
+  return nullptr;
+}
