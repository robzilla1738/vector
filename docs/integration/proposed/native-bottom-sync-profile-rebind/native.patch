+void VerticalTabStripBottomContainer::PauseForAuxProfileSwitch() {
+  CHECK(!sync_profile_switch_paused_);
+  sync_profile_switch_paused_ = true;
+  sync_observation_.Reset();
+  sync_service_ = nullptr;
+}
+
+void VerticalTabStripBottomContainer::RebindAfterAuxProfileSwitch() {
+  CHECK(sync_profile_switch_paused_);
+  sync_profile_switch_paused_ = false;
+  BindSyncServiceForCurrentProfile();
+}
+
+void VerticalTabStripBottomContainer::BindSyncServiceForCurrentProfile() {
+  CHECK(!sync_profile_switch_paused_);
+  CHECK(!sync_service_);
+  CHECK(!sync_observation_.IsObserving());
+  sync_service_ = SyncServiceFactory::GetForProfile(browser_->GetProfile());
+  if (sync_service_) {
+    sync_observation_.Observe(sync_service_);
+  }
+  UpdateSyncState();
 }
 
