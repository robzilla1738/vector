+// The Aux Agent coordinator installs an explicit empty border before adding
+// content. A null border still means the panel has not been initialized: keep
+// the stock estimate then, and for every ordinary panel/header border.
+gfx::Insets GetContentSizingInsets(const SidePanel* panel) {
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+  if (panel->GetBorder() && panel->GetInsets().IsEmpty()) {
+    return panel->GetInsets();
+  }
+#endif
+  return GetBorderInsets();
+}
