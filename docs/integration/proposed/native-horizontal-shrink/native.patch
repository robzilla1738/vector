+void TabContainerImpl::ScrollTabToVisible(int model_index) {
+  views::View* contents = parent();
+  views::ScrollView* scroll_view = contents
+      ? views::ScrollView::GetScrollViewForContents(contents) : nullptr;
+  if (!scroll_view || GetTabCount() == 0) {
+    return;
+  }
+  const gfx::Rect visible_content_rect = scroll_view->GetVisibleRect();
