+
+void BrowserHandler::EnsureProfile(
+    int profile_index, std::optional<bool> should_focus,
+    std::optional<std::string> url,
+    std::unique_ptr<EnsureProfileCallback> callback) {
+  aux::EnsureProfileWindow(profile_index, std::move(url), should_focus,
+      authenticated_remote_debugging_,
+      base::BindRepeating([](base::WeakPtr<BrowserHandler> handler) {
+        return !!handler;
+      }, weak_factory_.GetWeakPtr()),
+      base::BindOnce([](std::unique_ptr<EnsureProfileCallback> callback,
+                        aux::ProfileWindowOutcome result) {
+        if (!result.error_code) {
+          callback->sendSuccess();
+        } else {
+          if (result.error_code == -32602)
+            callback->sendFailure(Response::InvalidParams(result.message));
+          else if (result.error_code == -32600)
+            callback->sendFailure(Response::InvalidRequest(result.message));
+          else
+            callback->sendFailure(Response::ServerError(result.message));
+        }
+      }, std::move(callback)));
+}
 
