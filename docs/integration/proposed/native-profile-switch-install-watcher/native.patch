 ExtensionInstalledWatcher::~ExtensionInstalledWatcher() {
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+  if (aux_profile_switch_paused_) {
+    return;
+  }
+#endif
   extensions::ExtensionRegistry::Get(profile_)->RemoveObserver(this);
 }
+
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool ExtensionInstalledWatcher::CanPrepareForAuxProfileSwitch() const {
+  return !aux_profile_switch_paused_ && aux_install_callback_depth_ == 0 &&
+         pending_installs_.empty();
+}
+
+void ExtensionInstalledWatcher::PrepareForAuxProfileSwitch() {
+  CHECK(CanPrepareForAuxProfileSwitch());
+  aux_profile_switch_paused_ = true;
+  weak_factory_.InvalidateWeakPtrs();
+  extensions::ExtensionRegistry::Get(profile_)->RemoveObserver(this);
+}
+
+void ExtensionInstalledWatcher::RebindForAuxProfileSwitch(
+    BrowserWindowInterface& browser) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK(pending_installs_.empty());
+  CHECK_EQ(From(&browser), this);
+  CHECK(browser.GetProfile()->IsRegularProfile());
+  profile_ = browser.GetProfile();
+  extensions::ExtensionRegistry::Get(profile_)->AddObserver(this);
+  aux_profile_switch_paused_ = false;
+}
+#endif
 
