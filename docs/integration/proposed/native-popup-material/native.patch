+NSView* CreatePermissionPromptBackgroundEffectView(
+    NSRect bounds,
+    std::optional<int> corner_radius) {
+  NSView* effect = nil;
+  if (@available(macOS 27, *)) {
+    NSGlassEffectView* glass = [[NSGlassEffectView alloc] initWithFrame:bounds];
+    glass.style = NSGlassEffectViewStyleRegular;
+    if (corner_radius) {
+      glass.cornerRadius = *corner_radius;
+    }
+    glass.contentView = [[NSView alloc] initWithFrame:glass.bounds];
+    SEL selector = NSSelectorFromString(@"_setVibrantBlendingStyleForSubtree:");
+    if ([glass respondsToSelector:selector]) {
+      reinterpret_cast<void (*)(id, SEL, NSInteger)>(objc_msgSend)(
+          glass, selector, 0);
+    }
+    effect = glass;
+  } else {
+    NSVisualEffectView* visual =
+        [[NSVisualEffectView alloc] initWithFrame:bounds];
+    visual.material = NSVisualEffectMaterialPopover;
+    visual.blendingMode = NSVisualEffectBlendingModeBehindWindow;
+    visual.state = NSVisualEffectStateActive;
+    visual.wantsLayer = YES;
+    if (corner_radius && *corner_radius >= 1) {
+      visual.layer.cornerRadius = *corner_radius;
+      visual.layer.masksToBounds = YES;
+    }
+    effect = visual;
+  }
+  effect.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  return effect;
+}
