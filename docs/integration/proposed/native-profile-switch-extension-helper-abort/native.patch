+
+void ExtensionBrowserWindowHelper::AbortAuxProfileSwitch() {
+  CHECK(aux_profile_switch_source_);
+  CHECK_EQ(browser_->GetProfile(), aux_profile_switch_source_.get());
+  CHECK(!registry_observation_.IsObserving());
+  // Core rollback has already restored the actual source tabs. This observer
+  // owns no tab transfer; the target-only empty-model guard must remain intact.
+  registry_observation_.Observe(ExtensionRegistry::Get(browser_->GetProfile()));
+  aux_profile_switch_source_.reset();
