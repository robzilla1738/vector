+bool ExtensionBrowserWindowHelper::CanPrepareForAuxProfileSwitch() const {
+  return !aux_profile_switch_source_ &&
+         browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         browser_->GetProfile()->IsRegularProfile() &&
+         registry_observation_.IsObservingSource(
+             ExtensionRegistry::Get(browser_->GetProfile()));
