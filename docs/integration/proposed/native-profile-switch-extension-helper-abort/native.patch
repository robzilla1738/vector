-  CHECK(browser_->GetProfile()->IsRegularProfile());
+  CHECK(CanPrepareForAuxProfileSwitch());
+  aux_profile_switch_source_ = browser_->GetProfile()->GetWeakPtr();
   // Old registry unload events must not close tabs after identity has moved.
   registry_observation_.Reset();
 }
 
 void ExtensionBrowserWindowHelper::RebindForAuxProfileSwitch(
