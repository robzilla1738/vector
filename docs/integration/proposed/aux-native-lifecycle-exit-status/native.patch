+TEST_F(DaemonSupervisorLifecycleTest, ReapedChildDoesNotInventExitZero) {
+  auto child = SyntheticChild(false);
+  ASSERT_TRUE(child.IsValid());
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    base::ScopedAllowBaseSyncPrimitivesForTesting allow_sync;
+    int observed = 0;
+    ASSERT_TRUE(child.WaitForExitWithTimeout(base::Seconds(5), &observed));
+    ASSERT_EQ(observed, 23);
+  }
+  // The process API subsequently reports absence without an observed status.
+  Own(std::move(child));
+  base::test::TestFuture<Result> done;
+  Quiesce(done);
+  const auto result = done.Take();
+  EXPECT_EQ(result.outcome, Outcome::kExited);
+  EXPECT_FALSE(result.exit_code.has_value());
+  EXPECT_FALSE(HasOwnedHandle());
+}
