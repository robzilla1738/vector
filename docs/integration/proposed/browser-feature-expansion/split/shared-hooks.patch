+
+bool TabStripModel::UpdateSplitPaneTree(
+    split_tabs::SplitTabId split_id, const split_tabs::SplitPaneTree& tree,
+    bool is_intermediate) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  auto* data = ContainsSplit(split_id) ? GetSplitData(split_id) : nullptr;
+  if (!data || !tree.IsValid() || tree.pane_slots().size() != data->ListTabs().size()) return false;
+  const auto previous = *data->visual_data();
+  if (!data->visual_data()->SetPaneTree(tree)) return false;
+  NotifySplitTabVisualsChanged(split_id, previous, *data->visual_data(),
+      SplitTabChange::SplitVisualChangeReason::kRatioUpdated, is_intermediate);
+  return true;
+}
+
+bool TabStripModel::RestorePaneToSplit(split_tabs::SplitTabId split_id,
+    int source_index, const split_tabs::SplitPaneTree& previous, uint32_t slot) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  if (!ContainsSplit(split_id) || !ContainsIndex(source_index) || closing_all() ||
+      !previous.IsValid() || previous.pane_slots().size() < 3) return false;
+  auto* source = GetTabAtIndex(source_index);
+  auto* data = GetSplitData(split_id);
+  auto members = data->ListTabs();
+  if (source->IsSplit() || !data->visual_data()->pane_tree() || members.empty() ||
+      source->GetGroup() != members.front()->GetGroup() ||
+      source->IsPinned() != members.front()->IsPinned()) return false;
+  auto reduced = previous;
+  if (!reduced.RemoveLeaf(slot) || reduced != *data->visual_data()->pane_tree()) return false;
+  std::map<tabs::TabInterface*, uint32_t> slots;
+  for (size_t i = 0; i < members.size(); ++i) slots[members[i]] = reduced.pane_slots()[i];
+  slots[source] = slot;
+  members.push_back(source);
+  auto visual = *data->visual_data();
+  auto* pivot = members.front();
+  RemoveSplitImpl(split_id, SplitTabChange::SplitTabRemoveReason::kSplitTabRemoved);
+  std::ranges::sort(members, {}, [this](auto* member) { return GetIndexOfTab(member); });
+  std::vector<int> indices;
+  std::vector<uint32_t> order;
+  for (auto* member : members) { indices.push_back(GetIndexOfTab(member)); order.push_back(slots.at(member)); }
+  auto restored = previous;
+  restored.SetPaneOrder(std::move(order)); visual.SetPaneTree(std::move(restored));
+  AddToSplitImpl(split_id, indices, GetIndexOfTab(pivot), visual,
+      SplitTabChange::SplitTabAddReason::kNewSplitTabAdded);
+  return true;
+}
+
+bool TabStripModel::JoinTabToSplit(int target_index, int source_index,
+    split_tabs::SplitPaneTree::Axis axis, bool before) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  if (!ContainsIndex(target_index) || !ContainsIndex(source_index) ||
+      target_index == source_index || closing_all() ||
+      (axis != split_tabs::SplitPaneTree::Axis::kHorizontal &&
+       axis != split_tabs::SplitPaneTree::Axis::kVertical)) return false;
+  auto* target = GetTabAtIndex(target_index);
+  auto* source = GetTabAtIndex(source_index);
+  if (source->IsSplit() || target->IsPinned() != source->IsPinned() ||
+      target->GetGroup() != source->GetGroup()) return false;
+  if (!target->IsSplit()) {
+    MoveTabToIndexImpl(source_index, target_index, source->GetGroup(), source->IsPinned(), false);
+    if (!before) {
+      const int source_now = GetIndexOfTab(source);
+      const int target_now = GetIndexOfTab(target);
+      if (source_now < target_now)
+        MoveTabToIndexImpl(source_now, target_now, source->GetGroup(), source->IsPinned(), false);
+    } else if (GetIndexOfTab(source) > GetIndexOfTab(target)) {
+      MoveTabToIndexImpl(GetIndexOfTab(source), GetIndexOfTab(target), source->GetGroup(), source->IsPinned(), false);
+    }
+    std::vector<int> indices{GetIndexOfTab(target), GetIndexOfTab(source)};
+    std::ranges::sort(indices);
+    AddToSplitImpl(split_tabs::SplitTabId::GenerateNew(), indices,
+        GetIndexOfTab(target), split_tabs::SplitTabVisualData(
+            axis == split_tabs::SplitPaneTree::Axis::kHorizontal
+                ? split_tabs::SplitTabLayout::kSideBySide : split_tabs::SplitTabLayout::kStacked),
+        SplitTabChange::SplitTabAddReason::kNewSplitTabAdded);
+    return true;
+  }
+  const auto split = *target->GetSplit();
+  auto* data = GetSplitData(split);
+  auto members = data->ListTabs();
+  if (members.size() >= split_tabs::SplitPaneTree::kMaxPanes) return false;
+  auto visual = *data->visual_data();
+  auto tree = visual.pane_tree().value_or(split_tabs::SplitPaneTree::Pair(
+      visual.split_layout() == split_tabs::SplitTabLayout::kSideBySide
+          ? split_tabs::SplitPaneTree::Axis::kHorizontal : split_tabs::SplitPaneTree::Axis::kVertical,
+      visual.split_ratio()));
+  if (tree.pane_slots().size() != members.size()) return false;
+  std::map<tabs::TabInterface*, uint32_t> slots;
+  for (size_t i = 0; i < members.size(); ++i) slots[members[i]] = tree.pane_slots()[i];
+  const uint32_t next_slot = *std::ranges::max_element(tree.pane_slots());
+  if (next_slot == std::numeric_limits<uint32_t>::max() ||
+      !tree.SplitLeaf(slots.at(target), next_slot + 1, axis, before)) return false;
+  slots[source] = next_slot + 1;
+  members.push_back(source);
+  RemoveSplitImpl(split, SplitTabChange::SplitTabRemoveReason::kSplitTabRemoved);
+  std::ranges::sort(members, {}, [this](auto* member) { return GetIndexOfTab(member); });
+  std::vector<int> indices;
+  std::vector<uint32_t> order;
+  for (auto* member : members) {
+    indices.push_back(GetIndexOfTab(member)); order.push_back(slots.at(member));
+  }
+  tree.SetPaneOrder(std::move(order));
+  visual.SetPaneTree(std::move(tree));
+  AddToSplitImpl(split, indices, GetIndexOfTab(target), visual,
+      SplitTabChange::SplitTabAddReason::kNewSplitTabAdded);
+  return true;
 }
 
