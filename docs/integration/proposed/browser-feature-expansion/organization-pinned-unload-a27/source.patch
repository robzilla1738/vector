+  const auto document = live->second.document_id;
+  const auto page = PageIdentity::GetOrCreate(profile_, tab->GetContents());
+  const auto alive = weak_.GetWeakPtr();
+  if (model_->GetActiveTab() == tab) {
+    // A retained page must not immediately reload because it stayed selected.
+    // Use this window's existing visible user page, or the real new-tab owner.
+    tabs::TabHandle next;
+    const auto* organization = Organization(browser_.get());
+    if (!organization || organization->blocked() || !ordinary_eligible_) return false;
+    for (auto* candidate : *model_) {
+      auto* contents = candidate->GetContents();
+      if (candidate == tab || !contents || contents->GetBrowserContext() != profile_ ||
+          candidate->IsSplit() || IsBookmarkTabExcluded(candidate, model_) ||
+          (!candidate->IsPinned() && !ordinary_eligible_.Run(*candidate))) continue;
+      const auto* identity = PageIdentity::FromWebContents(contents);
+      if (identity && identity->runtime_owned()) continue;
+      const auto id = GetRememberedPinnedTabEntryId(*contents).value_or("");
+      const auto entry = organization->snapshot().entries.find(id);
+      if (entry != organization->snapshot().entries.end() && !entry->second.archived &&
+          (entry->second.space_id.empty() || entry->second.space_id == active_space_)) {
+        next = candidate->GetHandle(); break;
+      }
+    }
+    if (next.Get()) {
+      model_->ActivateTab(next.Get());
+    } else {
+      NavigateParams params(browser_.get(), GURL(chrome::kChromeUINewTabURL), ui::PAGE_TRANSITION_TYPED);
+      params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      Navigate(&params);
+    }
+  }
+  if (!alive || !Current()) return false;
+  tab = handle.Get();
+  const auto current = views_.find(handle);
+  if (!tab || model_->GetIndexOfTab(tab) < 0 || model_->GetActiveTab() == tab || Protected(tab) ||
+      !tab->GetContents() || current == views_.end() ||
+      current->second.logical_id != logical || current->second.document_id != document ||
