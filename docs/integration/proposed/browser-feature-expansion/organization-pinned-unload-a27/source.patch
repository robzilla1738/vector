+  const bool retained = discarded && tab && model_->GetIndexOfTab(tab) >= 0 && contents &&
+      contents->GetBrowserContext() == profile_ && current_lifecycle &&
+      current_lifecycle->GetTabState() == mojom::LifecycleUnitState::DISCARDED &&
