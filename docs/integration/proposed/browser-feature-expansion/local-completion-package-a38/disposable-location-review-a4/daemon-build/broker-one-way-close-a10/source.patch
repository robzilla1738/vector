+// Revocation and uncertainty can only narrow this actual Environment's state.
+// They must remain possible after its browser peer exits. This capture grants
+// no writer admission and makes no physical-drain or authority assertion.
+std::shared_ptr<Worker> CaptureBrokerForOneWayRevocation(napi_env env) {
+  if(getpid()!=kHostProcess)return {};
+  auto* isolate=v8::Isolate::GetCurrent();
+  if(!isolate||isolate->GetCurrentContext().IsEmpty())return {};
+  auto* environment=node::GetCurrentEnvironment(isolate->GetCurrentContext());
+  std::shared_ptr<Worker> worker;
+  {std::lock_guard<std::mutex> lock(Registry().mutex);auto found=Registry().active.find(environment);if(found!=Registry().active.end())worker=found->second;}
+  if(!worker||!SameRuntimeEnvironment(env,environment,isolate))return {};
+  {std::lock_guard<std::mutex> lock(worker->mutex);
+    if(!CurrentWorker(*worker)||worker->initializing||worker->environment_detached)return {};
+  }
+  return worker;
+}
