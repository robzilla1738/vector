 void ChromeBrowserMainParts::PostMainMessageLoopRun() {
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && defined(AUX_BROWSER_ONLY_NATIVE_STARTUP) && AUX_BROWSER_ONLY_NATIVE_STARTUP
+  // Stop new feature work without invalidating the native selected owner.
+  // The existing authenticated daemon shutdown must finish while that browser
+  // peer and its published root FDs still validate protected SQLite closure.
+  aux::features::CloseNativeFeatureIoAdmission();
+  extensions::ShutdownAuxMiniPopup();
+  aux::ShutdownProfileGates();
+  aux::BrowserPlatform::Get().Shutdown();
+#endif
 #if BUILDFLAG(ENABLE_AUX_BROWSER) && defined(AUX_SEALED_NATIVE_COLD_ENTRY)
   aux::peer::BeginNativeBrowserShutdown();
   aux::PrepareNativeBrowserShutdownDrain();
 #endif
 
