+#if BUILDFLAG(ENABLE_AUX_BROWSER) && (!defined(AUX_BROWSER_ONLY_NATIVE_STARTUP) || !AUX_BROWSER_ONLY_NATIVE_STARTUP)
   // Keep networking and the UI task runner alive until owned daemon shutdown.
   extensions::ShutdownAuxMiniPopup();
   aux::ShutdownProfileGates();
