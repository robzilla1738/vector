+// Child menus have independent native close boundaries. Keep their delegate
+// alive until after the client-owned Widget, just like the primary menu above.
+using OwnedAuxProfilePopups =
+    std::map<views::Widget*, std::unique_ptr<OwnedPrimaryProfileMenu>>;
+OwnedAuxProfilePopups& AuxProfilePopupOwners() {
+  static base::NoDestructor<OwnedAuxProfilePopups> owners;
+  return *owners;
+}
+void RetireOwnedAuxProfilePopup(views::Widget* widget,
+                                 views::Widget::ClosedReason) {
+  auto& owners = AuxProfilePopupOwners();
+  const auto found = owners.find(widget);
+  if (found == owners.end()) return;
+  auto owner = std::move(found->second);
+  owners.erase(found);
+  // No further row action may run while native teardown is deferred out of
+  // activation/close observer iterations.
+  widget->GetContentsView()->SetEnabled(false);
+  widget->Hide();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(owner));
+}
+views::Widget* CreateOwnedAuxProfilePopup(
+    std::unique_ptr<views::BubbleDialogDelegate> delegate) {
+  auto owner = std::make_unique<OwnedPrimaryProfileMenu>();
+  owner->delegate = std::move(delegate);
+  owner->widget = views::BubbleDialogDelegate::CreateBubble(owner->delegate.get());
+  auto* widget = owner->widget.get();
+  widget->MakeCloseSynchronous(base::BindOnce(
+      &RetireOwnedAuxProfilePopup, widget));
+  AuxProfilePopupOwners().emplace(widget, std::move(owner));
+  return widget;
+}
 #endif
+void RetireAuxProfilePopup(views::Widget* widget) {
+  if (!widget) return;
+#if defined(AUX_BROWSER_ONLY_NATIVE_STARTUP)
+  RetireOwnedAuxProfilePopup(widget, views::Widget::ClosedReason::kUnspecified);
+#else
+  widget->CloseNow();
+#endif
+}
+void DestroyAuxProfilePopup(views::Widget* widget) {
+  if (!widget) return;
+#if defined(AUX_BROWSER_ONLY_NATIVE_STARTUP)
+  auto& owners = AuxProfilePopupOwners();
+  const auto found = owners.find(widget);
+  if (found == owners.end()) return;
+  auto owner = std::move(found->second);
+  owners.erase(found);
+  // Parent destruction already occurs outside the native callback stack. Tear
+  // down its current child before any parent delegate/row members disappear.
+  owner.reset();
+#else
+  widget->CloseNow();
+#endif
+}
 
