+void BrowserLiveTabContext::ReconstructSplit(
+    const std::vector<sessions::LiveTab*>& tabs, split_tabs::SplitTabId id,
+    const split_tabs::SplitTabVisualData& visual_data) {
+  if (tabs.size() < 2 || tabs.size() > split_tabs::SplitPaneTree::kMaxPanes ||
+      (visual_data.pane_tree() ? visual_data.pane_tree()->pane_slots().size() != tabs.size()
+                              : tabs.size() != 2)) return;
+  std::vector<std::pair<int, uint32_t>> mapped;
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    if (!tabs[i]) return;
+    auto* live = static_cast<sessions::ContentLiveTab*>(tabs[i]);
+    const int index = tab_strip_model_->GetIndexOfWebContents(&live->GetWebContents());
+    if (index < 0 || tab_strip_model_->GetTabAtIndex(index)->IsSplit()) return;
+    mapped.emplace_back(index, visual_data.pane_tree() ? visual_data.pane_tree()->pane_slots()[i] : 0);
+  }
+  std::ranges::sort(mapped);
+  std::vector<int> indices;
+  std::vector<uint32_t> slots;
+  for (auto [index, slot] : mapped) { indices.push_back(index); slots.push_back(slot); }
+  auto visual = visual_data;
+  if (visual.pane_tree()) {
+    auto tree = *visual.pane_tree();
+    if (!tree.SetPaneOrder(std::move(slots))) return;
+    visual.SetPaneTree(std::move(tree));
+  }
+  tab_strip_model_->RestoreSplit(id, indices, visual);
 }
 
