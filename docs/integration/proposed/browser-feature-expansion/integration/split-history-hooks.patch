+// Preserve a surviving branch when one member is restored out of window/group history.
+void RemoveSplitMemberMetadata(
+    std::vector<std::unique_ptr<tab_restore::Tab>>& tabs,
+    std::map<split_tabs::SplitTabId, std::unique_ptr<tab_restore::Split>>& splits,
+    size_t removed) {
+  const auto id = tabs[removed]->split_id;
+  if (!id) return;
+  size_t offset = 0;
+  for (size_t i = 0; i < removed; ++i) if (tabs[i]->split_id == id) ++offset;
+  auto visual = tabs[removed]->split_visual_data;
+  bool retain = false;
+  const size_t count = std::ranges::count_if(tabs, [&](const auto& tab) { return tab->split_id == id; });
+  if (visual && visual->pane_tree() && visual->pane_tree()->pane_slots().size() == count && count > 2 &&
+      offset < visual->pane_tree()->pane_slots().size()) {
+    auto tree = *visual->pane_tree();
+    retain = tree.RemoveLeaf(tree.pane_slots()[offset]);
+    if (retain) visual->SetPaneTree(std::move(tree));
+  }
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    if (i == removed || tabs[i]->split_id != id) continue;
+    if (retain) tabs[i]->split_visual_data = visual;
+    else { tabs[i]->split_id.reset(); tabs[i]->split_visual_data.reset(); }
+  }
+  if (retain && splits.contains(*id)) splits.at(*id)->visual_data = *visual;
+  else splits.erase(*id);
+}
