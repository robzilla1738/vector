+TEST(OrganizationModel, CleanupScopeIsExplicitBoundedAndReplayedExactly) {
+  auto snapshot = Initial();
+  snapshot.spaces.emplace(kOther, Space{kOther, "Work", "", 1});
+  Command policy; policy.action = Action::kSetCleanupPolicy;
+  policy.value = true; policy.index = 30;
+  const auto legacy_fingerprint = Fingerprint(policy);
+  policy.space_ids = std::vector<std::string>{kSpace};
+  auto scoped = Run(snapshot, policy);
+  ASSERT_EQ(scoped.error, Error::kNone);
+  EXPECT_TRUE(scoped.delta.sections_changed);
+  EXPECT_TRUE(CleanupIncludesSpace(scoped.snapshot, kSpace));
+  EXPECT_FALSE(CleanupIncludesSpace(scoped.snapshot, kOther));
+  EXPECT_FALSE(CleanupIncludesSpace(scoped.snapshot, ""));
+  const Context original{snapshot.profile_id, "native-generation", 0, Operation(1)};
+  EXPECT_EQ(Apply(scoped.snapshot, original, policy).error, Error::kReplay);
+  policy.space_ids = std::vector<std::string>{kOther};
+  EXPECT_EQ(Apply(scoped.snapshot, original, policy).error, Error::kOperationConflict);
+  policy.space_ids.reset();
+  EXPECT_EQ(Fingerprint(policy), legacy_fingerprint);
+  auto all = Run(scoped.snapshot, policy, 2);
+  ASSERT_EQ(all.error, Error::kNone);
+  EXPECT_TRUE(CleanupIncludesSpace(all.snapshot, kOther));
+  EXPECT_TRUE(all.delta.sections_changed);
+  policy.space_ids = std::vector<std::string>{};
+  EXPECT_EQ(Run(snapshot, policy).error, Error::kInvalid);
+  policy.space_ids = std::vector<std::string>{kSpace, kSpace};
+  EXPECT_EQ(Run(snapshot, policy).error, Error::kInvalid);
+  policy.space_ids = std::vector<std::string>{kFolder};
+  EXPECT_EQ(Run(snapshot, policy).error, Error::kMissing);
+  policy.space_ids = std::vector<std::string>(kMaxSpaces + 1, kSpace);
+  EXPECT_EQ(Run(snapshot, policy).error, Error::kInvalid);
+}
+TEST(OrganizationModel, RemovingLastSelectedSpaceDisablesInsteadOfWidening) {
+  auto snapshot = Initial();
+  snapshot.spaces.emplace(kOther, Space{kOther, "Work", "", 1});
+  snapshot.cleanup_enabled = true;
+  snapshot.cleanup_space_ids = std::vector<std::string>{kOther};
+  Command remove; remove.action = Action::kRemoveEmptySpace; remove.id = kOther;
+  auto removed = Run(snapshot, remove);
+  ASSERT_EQ(removed.error, Error::kNone);
+  ASSERT_TRUE(removed.snapshot.cleanup_space_ids);
+  EXPECT_TRUE(removed.snapshot.cleanup_space_ids->empty());
+  EXPECT_FALSE(removed.snapshot.cleanup_enabled);
+  EXPECT_FALSE(CleanupIncludesSpace(removed.snapshot, kSpace));
+  auto undo = ApplyUndo(removed.snapshot, snapshot,
+      {snapshot.profile_id, "native-generation", removed.snapshot.revision, Operation(2)}, kFolder);
+  ASSERT_EQ(undo.error, Error::kNone);
+  EXPECT_EQ(undo.snapshot.cleanup_space_ids, snapshot.cleanup_space_ids);
+  EXPECT_TRUE(undo.snapshot.cleanup_enabled);
+}
+TEST(OrganizationModel, CleanupScopeCodecPreservesLegacyAndRejectsUnknownState) {
+  auto snapshot = Initial();
+  auto legacy = EncodeSnapshot(snapshot);
+  EXPECT_FALSE(legacy.FindDict("cleanup")->contains("spaceIds"));
+  auto decoded_legacy = DecodeSnapshot(legacy, snapshot.profile_id);
+  ASSERT_TRUE(decoded_legacy.snapshot);
+  EXPECT_FALSE(decoded_legacy.snapshot->cleanup_space_ids);
+  snapshot.cleanup_enabled = true;
+  snapshot.cleanup_space_ids = std::vector<std::string>{kSpace};
+  auto encoded = EncodeSnapshot(snapshot);
+  auto decoded = DecodeSnapshot(encoded, snapshot.profile_id);
+  ASSERT_TRUE(decoded.snapshot);
+  EXPECT_EQ(*decoded.snapshot, snapshot);
+  encoded.FindDict("cleanup")->Set("spaceIds", base::ListValue().Append(kOther));
+  EXPECT_FALSE(DecodeSnapshot(encoded, snapshot.profile_id).snapshot);
+  encoded = EncodeSnapshot(snapshot);
+  encoded.FindDict("cleanup")->Set("futureScope", true);
+  EXPECT_FALSE(DecodeSnapshot(encoded, snapshot.profile_id).snapshot);
+}
