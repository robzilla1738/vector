+  bool CloseViewNow(tabs::TabHandle);
+  void EnsureSavedThenClose(tabs::TabHandle, base::OnceCallback<void(bool)>);
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
