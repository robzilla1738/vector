+void VerticalTabStripRegionView::SetAuxSidebarMode(aux::SidebarMode mode) {
+  const bool auto_hide = mode == aux::SidebarMode::kAutoHide;
+  state_controller_->SetExpandOnHoverEnabled(auto_hide);
+  state_controller_->RequestCollapse(auto_hide);
+}
+
+aux::FramePresentationInputs
+VerticalTabStripRegionView::GetAuxFramePresentationInputs() const {
+  aux::FramePresentationInputs inputs;
+  inputs.sidebar_collapsed = state_controller_->IsCollapsed();
+  inputs.hover_revealed = is_expanded_on_hover_ ||
+      (aux_profile_preview_admission_ &&
+       aux_profile_preview_admission_->retained());
+  inputs.transition_active = IsAnimatingSize();
+  inputs.sidebar_has_focus = GetFocusManager() &&
+      Contains(GetFocusManager()->GetFocusedView());
+  inputs.menu_open = keep_current_state_lock_count_ > 0 ||
+                    keep_expanded_lock_count_ > 0 || !!omnibox_open_lock_;
+  inputs.drag_active = !!link_drag_lock_ || aux_empty_pinned_drop_active_ ||
+                       state_controller_->is_resizing();
+  // Actual navigation focus is rechecked by AuxNavigationPlacement. Root adds
+  // preferences, actual native menus, and tab-drag ownership to this snapshot.
+  return inputs;
+}
