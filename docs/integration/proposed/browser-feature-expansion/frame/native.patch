+bool BrowserView::IsAuxSidebarNavigationHosted() const {
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+  return toolbar_ && aux_navigation_sidebar_host_ &&
+         toolbar_->parent() == aux_navigation_sidebar_host_;
+#else
+  return false;
+#endif
+}
+
+bool BrowserView::IsAuxMinimalUiEnabled() const {
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+  return aux_minimal_ui_enabled_;
+#else
+  return false;
+#endif
+}
+
+void BrowserView::ScheduleAuxFramePresentationUpdate() {
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+  if (!initialized_ || aux_frame_tearing_down_ || aux_frame_update_pending_ ||
+      aux_profile_switch_paused_ || suppress_layout_for_teardown_)
+    return;
+  aux_frame_update_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&BrowserView::UpdateAuxFramePresentation,
+                               weak_ptr_factory_.GetWeakPtr()));
+#endif
+}
+
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+void BrowserView::OnAuxFramePreferenceChanged() {
+  aux_navigation_refused_width_ = -1;
+  ScheduleAuxFramePresentationUpdate();
+}
+
+void BrowserView::UpdateAuxFramePresentation() {
+  aux_frame_update_pending_ = false;
+  if (!initialized_ || aux_frame_tearing_down_ || aux_profile_switch_paused_ ||
+      suppress_layout_for_teardown_ || in_process_fullscreen_ ||
+      !GetWidget() || !toolbar_ || !vertical_tab_strip_region_view_ ||
+      !aux_navigation_sidebar_host_ || !top_container_ ||
+      (browser_widget_ && browser_widget_->IsClosed()))
+    return;
+  const auto alive = weak_ptr_factory_.GetWeakPtr();
+  const auto* preferences = GetProfile()->GetPrefs();
+  const auto read_bool = [preferences](const char* name) {
+    return preferences->FindPreference(name) && preferences->GetBoolean(name);
+  };
+  auto inputs = vertical_tab_strip_region_view_->GetAuxFramePresentationInputs();
+  auto* vertical = tabs::VerticalTabStripStateController::From(browser_);
+  inputs.sidebar_navigation = vertical && vertical->ShouldDisplayVerticalTabs() &&
+      read_bool(aux::kSidebarNavigationEnabledPref) && !IsFullscreen() &&
+      GetIsNormalType();
+  inputs.minimal = read_bool(aux::kMinimalUiEnabledPref) && GetIsNormalType();
+  inputs.always_show_full_url = read_bool(omnibox::kPreventUrlElisionsInOmnibox);
+  inputs.navigation_has_focus = GetFocusManager() &&
+      toolbar_->Contains(GetFocusManager()->GetFocusedView());
+  inputs.menu_open |= toolbar_->IsAuxNavigationInteractionActive() ||
+                     !GetWidget()->IsActive();
+
+  if (!aux_navigation_placement_) {
+    if (toolbar_->parent() != top_container_)
+      return;
+    aux_navigation_placement_ = std::make_unique<aux::AuxNavigationPlacement>(
+        *toolbar_, *top_container_, *aux_navigation_sidebar_host_);
+  }
+  const bool was_hosted = IsAuxSidebarNavigationHosted();
+  const auto current_host = was_hosted ? aux::NavigationHost::kSidebar
+                                     : aux::NavigationHost::kTop;
+  const auto desired = aux::ResolveFramePresentation(inputs, current_host);
+  vertical_tab_strip_region_view_->SetAuxNavigationPlacementHold(
+      was_hosted && inputs.sidebar_collapsed && desired.relocation_deferred);
+  if (!alive)
+    return;
+  const int sidebar_width = vertical_tab_strip_region_view_->GetContentsBounds().width();
+  if (!inputs.sidebar_navigation || inputs.sidebar_collapsed)
+    aux_navigation_refused_width_ = -1;
+  if (desired.navigation == aux::NavigationHost::kSidebar && !was_hosted) {
+    if (sidebar_width == aux_navigation_refused_width_ ||
+        !toolbar_->CanUseAuxSidebarNavigationLayout()) {
+      inputs.sidebar_navigation = false;
+    } else if (!desired.relocation_deferred) {
+      toolbar_->SetAuxSidebarNavigationLayout(true);
+    }
+  }
+  if (!alive)
+    return;
+  const auto result = aux_navigation_placement_->Update(inputs, sidebar_width);
+  if (!alive)
+    return;
+  if (result == aux::AuxNavigationPlacement::Result::kUnavailable)
+    return;
+  const bool is_hosted = IsAuxSidebarNavigationHosted();
+  if (!is_hosted)
+    vertical_tab_strip_region_view_->SetAuxNavigationPlacementHold(false);
+  if (!alive)
+    return;
+  if (!is_hosted && toolbar_->IsAuxSidebarNavigationLayout())
+    toolbar_->SetAuxSidebarNavigationLayout(false);
+  if (!alive)
+    return;
+  if (result == aux::AuxNavigationPlacement::Result::kInsufficientWidth)
+    aux_navigation_refused_width_ = sidebar_width;
+  aux_navigation_sidebar_host_->SetVisible(is_hosted);
+  if (!alive)
+    return;
+  const bool minimal_changed = aux_minimal_ui_enabled_ != inputs.minimal;
+  aux_minimal_ui_enabled_ = inputs.minimal;
+  if (was_hosted != is_hosted)
+    EnsureFocusOrder();
+  if (was_hosted != is_hosted || minimal_changed) {
+    InvalidateLayout();
+    if (alive)
+      SchedulePaint();
+  }
+}
