+bool ToolbarView::IsAuxNavigationInteractionActive() const {
+  if (const auto* focus = GetFocusManager();
+      focus && Contains(focus->GetFocusedView()))
+    return true;
+  if (const auto* menu = GetAppMenuControl(); menu && menu->IsMenuShowing())
+    return true;
+  std::vector<const views::View*> pending{this};
+  while (!pending.empty()) {
+    const auto* view = pending.back();
+    pending.pop_back();
+    if (const auto* button = views::AsViewClass<ToolbarButton>(view);
+        button && button->IsMenuShowing())
+      return true;
+    for (const views::View* child : view->children())
+      pending.push_back(child);
+  }
+  return false;
+}
