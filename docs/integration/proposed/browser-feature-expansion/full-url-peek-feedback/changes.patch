 void MultiContentsViewMiniToolbar::RegisterTabSubscriptions() {
+  full_url_preferences_.Reset();
+  if (web_contents_) {
+    auto* profile = Profile::FromBrowserContext(web_contents_->GetBrowserContext());
+    auto* preferences = profile ? profile->GetPrefs() : nullptr;
+    if (preferences && preferences->FindPreference(omnibox::kPreventUrlElisionsInOmnibox)) {
+      full_url_preferences_.Init(preferences);
+      full_url_preferences_.Add(omnibox::kPreventUrlElisionsInOmnibox,
+          base::BindRepeating(&MultiContentsViewMiniToolbar::UpdateContents,
+                              base::Unretained(this)));
+    }
+  }
   if (auto* interface = GetTabInterface(web_contents_)) {
     auto* tab_alert_controller = tabs::TabAlertController::From(interface);
     OnAlertStatusIndicatorChanged(tab_alert_controller->GetAlertToShow());
