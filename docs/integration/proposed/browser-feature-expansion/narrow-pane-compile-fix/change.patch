+// Keep native toolbar-button styling while providing a label setter only for
+// these local presentation controls. ToolbarButton::SetText stays protected.
+class MultiContentsView::NarrowPaneButton final : public ToolbarButton {
+  METADATA_HEADER(NarrowPaneButton, ToolbarButton)
+ public:
+  explicit NarrowPaneButton(PressedCallback callback);
+  ~NarrowPaneButton() override;
+  void SetControlLabel(std::u16string_view text);
+};
+MultiContentsView::NarrowPaneButton::NarrowPaneButton(PressedCallback callback)
+    : ToolbarButton(std::move(callback)) {
+  SetProperty(views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                               views::MaximumFlexSizeRule::kPreferred));
+}
+MultiContentsView::NarrowPaneButton::~NarrowPaneButton() = default;
+void MultiContentsView::NarrowPaneButton::SetControlLabel(std::u16string_view text) {
+  ToolbarButton::SetText(text);
+}
