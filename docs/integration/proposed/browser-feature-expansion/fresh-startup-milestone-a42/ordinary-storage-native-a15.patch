+// Inspect only the retained authenticated channel. Swift also checks the
+// actual kernel parent birth and the retained root/generation bindings.
+extern "C" int32_t AuxInspectRetainedNativeParentConnection(uint64_t handle) {
+  try {
+    auto& registry = Connections();
+    if (getpid() != registry.process) return -3;
+    std::shared_ptr<AuthenticatedNativeParentConnection> actual;
+    {
+      std::lock_guard<std::mutex> lock(registry.mutex);
+      auto found = registry.records.find(handle);
+      if (found == registry.records.end()) return -1;
+      actual = found->second.connection;
+    }
+    const auto snapshot = actual->Inspect();
+    if (snapshot.wrong_process) return -3;
+    if (snapshot.closed || snapshot.parent_pid <= 1 ||
+        snapshot.parent_pid != getppid()) return -2;
+    if (snapshot.selected_home_cleanup_unresolved ||
+        snapshot.unresolved_receive_cleanup ||
+        snapshot.unresolved_send_cleanup) return 1;
+    return 0;
+  } catch (...) { return -1; }
+}
