+base::DictValue GetShortcutProfile(Profile* profile) {
+  const auto owner = ShortcutOwner(profile);
+  if (owner.empty() || !profile->GetPrefs()->FindPreference(kOverrides))
+    return ShortcutFailure("Shortcut profile authority unavailable");
+  const auto revision = ShortcutRevision(profile, owner);
+  if (revision.empty()) return ShortcutFailure("Shortcut revision unavailable");
+  base::ListValue bindings;
+  for (auto& row : GetKeyboardShortcuts(profile))
+    if (row.GetDict().FindInt("commandId") != kPopup) bindings.Append(std::move(row));
+  return base::DictValue().Set("success", true).Set("format", "aux-shortcuts")
+      .Set("version", 1).Set("platform", "mac").Set("ownerGeneration", owner)
+      .Set("revision", revision).Set("bindings", std::move(bindings));
+}
+base::DictValue ExportShortcutProfile(Profile* profile) {
+  auto current = GetShortcutProfile(profile);
+  if (!current.FindBool("success").value_or(false)) return current;
+  base::DictValue mappings;
+  for (const auto& binding : kBindings) {
+    if (binding.command == kPopup) continue;
+    mappings.Set(base::NumberToString(binding.command), Effective(profile, binding));
+  }
+  return base::DictValue().Set("success", true)
+      .Set("ownerGeneration", *current.FindString("ownerGeneration"))
+      .Set("revision", *current.FindString("revision")).Set("configuration",
+      base::DictValue().Set("format", "aux-shortcuts").Set("version", 1)
+        .Set("platform", "mac").Set("mappings", std::move(mappings)));
+}
+base::DictValue ImportShortcutProfile(Profile* profile,
+    const std::string& owner_generation, const std::string& revision,
+    const base::DictValue& mappings) {
+  const auto owner = ShortcutOwner(profile);
+  if (owner.empty() || owner != owner_generation ||
+      !profile->GetPrefs()->FindPreference(kOverrides))
+    return ShortcutFailure("Shortcut profile changed; reopen settings");
+  if (revision != ShortcutRevision(profile, owner))
+    return ShortcutFailure("Shortcuts changed; review the current table before retrying");
+  if (profile->GetPrefs()->IsManagedPreference(kOverrides))
+    return ShortcutFailure("Shortcuts are managed");
+  if (auto error = ValidateProspective(profile, mappings)) return ShortcutFailure(*error);
+  base::DictValue normalized;
+  for (const auto [key, value] : mappings) {
+    int command = 0;
+    base::StringToInt(key, &command);
+    if (ParseKeyboardShortcut(value.GetString()) != ParseKeyboardShortcut(Default(*FindBinding(command))))
+      normalized.Set(key, value.Clone());
+  }
+  // All checks precede exactly one profile-local write. No global registration,
+  // second counter-pref, sequential per-command mutation or partial import.
+  if (ShortcutOwner(profile) != owner || ShortcutRevision(profile, owner) != revision)
+    return ShortcutFailure("Shortcut authority changed during validation");
+  profile->GetPrefs()->SetDict(kOverrides, normalized.Clone());
+  if (ShortcutOwner(profile) != owner || profile->GetPrefs()->GetDict(kOverrides) != normalized)
+    return ShortcutFailure("Shortcut state changed during publication; reload settings");
+  RefreshActiveMenu();
+  auto result = GetShortcutProfile(profile);
+  result.Set("persistence", "native-pref-queued");
+  return result;
+}
+base::DictValue ResetShortcutProfile(Profile* profile,
+    const std::string& owner_generation, const std::string& revision) {
+  return ImportShortcutProfile(profile, owner_generation, revision, base::DictValue());
+}
