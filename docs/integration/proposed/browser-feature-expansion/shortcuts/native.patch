+base::DictValue ShortcutFailure(std::string error) {
+  return base::DictValue().Set("success", false).Set("error", std::move(error));
+}
+std::string Digest(std::string_view text) {
+  return base::HexEncode(crypto::hash::Sha256(text));
+}
+std::string ShortcutOwner(Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!g_browser_process || !g_browser_process->local_state() ||
+      !profile || !profile->IsRegularProfile() || profile->IsOffTheRecord() ||
+      profile != profile->GetOriginalProfile() || IsProfileCookieRestorePending(profile))
+    return {};
+  const auto roots = peer::CaptureActualChromiumBrowserRoots();
+  const auto admission = peer::InspectNativeBrowserShutdown();
+  if (!roots || !roots->Revalidate() || !admission.admitted_generation ||
+      admission.wrong_process || admission.admission_closed || admission.sequence_uncertain)
+    return {};
+  const auto id = GetProfileId(profile);
+  const auto epoch = GetProfileCookieBindingEpoch(profile);
+  if (id.empty() || epoch.empty()) return {};
+  return Digest(id + ":" + epoch + ":" + base::NumberToString(admission.admitted_generation));
+}
+std::string ShortcutRevision(Profile* profile, const std::string& owner) {
+  // Dict iteration is key ordered. JSON includes raw stored values, so even an
+  // invalid/unknown existing entry changes CAS rather than disappearing in a UI
+  // normalized view. The global chord is read for collisions, never mutated.
+  base::ListValue canonical;
+  canonical.Append(owner);
+  canonical.Append(profile->GetPrefs()->GetDict(kOverrides).Clone());
+  canonical.Append(g_browser_process->local_state()->GetString(kPopupShortcut));
+  auto json = base::WriteJson(canonical);
+  return json ? Digest(*json) : std::string();
+}
+std::optional<std::string> ValidateMappings(const base::DictValue& mappings) {
+  if (mappings.size() >= std::size(kBindings)) return "Too many shortcut mappings";
+  for (const auto [key, value] : mappings) {
+    int command = 0;
+    if (!base::StringToInt(key, &command) || base::NumberToString(command) != key ||
+        command == kPopup || !FindBinding(command) || !value.is_string() ||
+        value.GetString().size() > 96 ||
+        (!value.GetString().empty() && !ParseKeyboardShortcut(value.GetString())))
+      return "Unknown or invalid shortcut mapping; Mini popup is configured separately";
+  }
+  return std::nullopt;
+}
+std::optional<std::string> ValidateProspective(Profile* profile,
+                                              const base::DictValue& mappings) {
+  if (auto error = ValidateMappings(mappings)) return error;
+  if (!NSApp.mainMenu) return "Browser menu reservations are unavailable";
+  // The OS returns enabled symbolic hotkeys without acquiring any new grants.
+  base::apple::ScopedCFTypeRef<CFArrayRef> hotkeys;
+  if (CopySymbolicHotKeys(hotkeys.InitializeInto()) != noErr || !hotkeys)
+    return "macOS shortcut reservations are unavailable; no shortcuts changed";
+  std::vector<ui::Accelerator> reserved;
+  for (CFIndex i = 0; i < CFArrayGetCount(hotkeys.get()); ++i) {
+    auto item = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(hotkeys.get(), i));
+    if (!item || CFGetTypeID(item) != CFDictionaryGetTypeID()) continue;
+    const auto* enabled = CFDictionaryGetValue(item, kHISymbolicHotKeyEnabled);
+    if (!enabled || CFGetTypeID(enabled) != CFBooleanGetTypeID() ||
+        !CFBooleanGetValue(static_cast<CFBooleanRef>(enabled))) continue;
+    const auto* code = CFDictionaryGetValue(item, kHISymbolicHotKeyCode);
+    const auto* modifiers = CFDictionaryGetValue(item, kHISymbolicHotKeyModifiers);
+    int code_value = 0, modifiers_value = 0;
+    if (!code || !modifiers || CFGetTypeID(code) != CFNumberGetTypeID() ||
+        CFGetTypeID(modifiers) != CFNumberGetTypeID() ||
+        !CFNumberGetValue(static_cast<CFNumberRef>(code), kCFNumberIntType, &code_value) ||
+        !CFNumberGetValue(static_cast<CFNumberRef>(modifiers), kCFNumberIntType, &modifiers_value))
+      return "macOS shortcut reservations could not be read";
+    int flags = 0;
+    if (modifiers_value & cmdKey) flags |= ui::EF_COMMAND_DOWN;
+    if (modifiers_value & controlKey) flags |= ui::EF_CONTROL_DOWN;
+    if (modifiers_value & optionKey) flags |= ui::EF_ALT_DOWN;
+    if (modifiers_value & shiftKey) flags |= ui::EF_SHIFT_DOWN;
+    reserved.emplace_back(ui::KeyboardCodeFromKeyCode(code_value), flags);
+  }
+  reserved.emplace_back(ui::VKEY_TAB, ui::EF_COMMAND_DOWN);
+  reserved.emplace_back(ui::VKEY_TAB, ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN);
+  std::vector<std::pair<int, ui::Accelerator>> table;
+  for (const auto& binding : kBindings) {
+    const auto* mapping = mappings.FindString(base::NumberToString(binding.command));
+    const auto value = binding.command == kPopup ? Effective(profile, binding)
+                                                : mapping ? *mapping : Default(binding);
+    if (value.empty() && binding.command != kPopup) continue;
+    auto parsed = ParseKeyboardShortcut(value);
+    if (!parsed) return "Existing global shortcut is unavailable";
+    for (const auto& [other, accelerator] : table)
+      if (*parsed == accelerator)
+        return "Shortcut conflict between commands " + base::NumberToString(other) +
+               " and " + base::NumberToString(binding.command);
+    table.emplace_back(binding.command, *parsed);
+    if (binding.command == kPopup) continue;
+    if (std::ranges::find(reserved, *parsed) != reserved.end())
+      return "Command " + base::NumberToString(binding.command) + " conflicts with a macOS shortcut";
+    // Preserve the supplied command's own intentional default displacement,
+    // while comparing all other menu commands against the prospective table.
+    if (parsed != ParseKeyboardShortcut(Default(binding)) &&
+        MenuConflict(profile, NSApp.mainMenu,
+          ui::GetKeyEquivalentAndModifierMaskFromAccelerator(*parsed), binding.command, &mappings))
+      return "Command " + base::NumberToString(binding.command) + " conflicts with a browser menu shortcut";
+  }
+  return std::nullopt;
+}
