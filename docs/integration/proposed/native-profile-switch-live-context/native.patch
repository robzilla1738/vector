+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+void BrowserLiveTabContext::RebindForAuxProfileSwitch() {
+  CHECK_EQ(Get(browser_->GetUnownedUserDataHost()), this);
+  CHECK_EQ(browser_->GetType(), BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(browser_->GetProfile()->IsRegularProfile());
+  CHECK_EQ(browser_->GetTabStripModel(), &tab_strip_model_.get());
+  CHECK_EQ(browser_->GetSessionID(), session_id_);
+  CHECK(tab_strip_model_->empty());
+  // BrowserClosed only retires the old helper's closing_contexts_ pointer;
+  // it does not manufacture a history entry or close this physical window.
+  if (auto* service =
+          TabRestoreServiceFactory::GetForProfileIfExisting(&profile_.get())) {
+    service->BrowserClosed(this);
+  }
+  profile_ = *browser_->GetProfile();
+}
+
+sessions::LiveTabContext* BrowserLiveTabContext::FindContextWithIDForAuxProfile(
+    SessionID desired_id, Profile* expected_profile) {
+  CHECK(expected_profile);
+  auto* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithID(desired_id);
+  // The same real SessionID survives the in-place transaction. A stale
+  // source-profile restore ID must not resolve into its new target profile.
+  return browser && browser->GetProfile() == expected_profile
+             ? GetLiveTabContext(browser)
+             : nullptr;
+}
+#endif
+
 void BrowserLiveTabContext::ShowBrowserWindow() {
   base_window_->Show();
 }
