+void SessionRestore::RestoreAuxProfileWorkspace(
+    BrowserWindowInterface* cache,
+    base::OnceCallback<void(AuxWorkspaceResult)> completion) {
+  CHECK(completion);
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+  const auto* state = cache ? BrowserInitState::From(cache) : nullptr;
+  const auto* unload = cache ? UnloadController::From(cache) : nullptr;
+  if (state && state->is_aux_profile_switch_cache() && unload &&
+      !unload->is_attempting_to_close_browser() && !unload->is_delete_scheduled() &&
+      cache->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+      cache->GetProfile()->IsRegularProfile() &&
+      !profiles::IsProfileLocked(cache->GetProfile()->GetPath()) &&
+      cache->GetTabStripModel()->empty() &&
+      !IsRestoring(cache->GetProfile())) {
+    auto* restorer = new SessionRestoreImpl(
+        cache->GetProfile(), cache, false, false, false, false, true, true,
+        StartupTabs());
+    restorer->SetAuxWorkspaceCompletion(std::move(completion));
+    restorer->Restore();
+    return;
+  }
+#endif
+  std::move(completion).Run(AuxWorkspaceResult::kFailed);
+}
