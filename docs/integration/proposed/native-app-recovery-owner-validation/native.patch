+  bool HasAuxRestorableAppOwner(const sessions::SessionWindow& window) const {
+    const auto app_id = web_app::GetAppIdFromApplicationName(window.app_name);
+    if (app_id.empty()) {
+      return false;
+    }
+    // Match MaybeCreateAppBrowserController after its real registry barrier.
+    // A stale serialized app name alone must not become an ownerless app window.
+    auto* provider = web_app::WebAppProvider::GetForLocalAppsUnchecked(profile_);
+    if (provider && provider->registrar_unsafe().AppMatches(
+                        app_id, web_app::WebAppFilter::IsAppSurfaceableToUser())) {
+      return true;
+    }
+#if BUILDFLAG(ENABLE_HOSTED_APPS)
+    auto* registry = extensions::ExtensionRegistry::Get(profile_);
+    const auto* extension = registry ? registry->GetExtensionById(
+        app_id, extensions::ExtensionRegistry::EVERYTHING) : nullptr;
+    return extension && extension->is_hosted_app();
+#else
+    return false;
+#endif
+  }
