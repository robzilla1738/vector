      "outputSha256": "41acf84d6c2828d4093bb0efa47568408e3e69c9006fea628f587085aa0c3114",
      "edits": [
        {
          "find": "    init(canonicalDisposableRoot:String,journal:NativeFreshBootstrapJournal)throws {",
          "replace": "    init(canonicalDisposableRoot:String,journal:NativeFreshBootstrapJournal,\n         retainedRootDescriptor:Int32? = nil)throws {",
          "count": 1
        },
        {
          "find": "        let rootFD=open(canonicalDisposableRoot,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC)",
          "replace": "        let rootFD:Int32\n        if let retainedRootDescriptor {\n            rootFD=fcntl(retainedRootDescriptor,F_DUPFD_CLOEXEC,0)\n        } else {\n            rootFD=open(canonicalDisposableRoot,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC)\n        }",
          "count": 1
        },
        {
          "find": "            try Self.metadata(rootFD,directory:true)\n",
          "replace": "            try Self.metadata(rootFD,directory:true)\n            try Self.requireRootIdentity(canonicalDisposableRoot,fd:rootFD)\n",
          "count": 1
        },
        {
          "find": "    private func validateDirectories()throws {",
          "replace": "    private static func requireRootIdentity(_ path:String,fd:Int32)throws {\n        let current=open(path,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC)\n        guard current>=0 else{throw NativeFreshBootstrapStoreError.io(errno)}\n        defer{close(current)}\n        let retained=try statFD(fd),observed=try statFD(current)\n        guard retained.st_dev==observed.st_dev,retained.st_ino==observed.st_ino else{\n            throw NativeFreshBootstrapStoreError.unsafePath\n        }\n    }\n    private func validateDirectories()throws {",
          "count": 1
        }
      ]
    },
