+void CommandStorageBackend::AppendCommandsWithCompletion(
+    std::vector<std::unique_ptr<SessionCommand>> commands,
+    bool truncate,
+    base::OnceClosure error_callback,
+    base::OnceCallback<void(SessionBackendWriteOutcome)> completion) {
+  const WriteStatus status = AppendCommandsImpl(
+      std::move(commands), truncate, std::move(error_callback));
+  SessionBackendWriteOutcome outcome;
+  switch (status) {
+    case WriteStatus::kUnknown:
+      outcome = SessionBackendWriteOutcome::kSkippedNoInitialState;
+      break;
+    case WriteStatus::kSuccess:
+      outcome = SessionBackendWriteOutcome::kWritten;
+      break;
+    case WriteStatus::kFileNotOpened:
+      outcome = SessionBackendWriteOutcome::kFileNotOpened;
+      break;
+    case WriteStatus::kFileWriteError:
+      outcome = SessionBackendWriteOutcome::kFileWriteError;
+      break;
+    case WriteStatus::kSerializationError:
+      outcome = SessionBackendWriteOutcome::kSerializationError;
+      break;
+    case WriteStatus::kEncryptionUnavailable:
+      outcome = SessionBackendWriteOutcome::kEncryptionUnavailable;
+      break;
+  }
+  callback_task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(std::move(completion), outcome));
+}
