+    result.backend_outcomes.push_back(
+        sessions::SessionBackendWriteOutcome::kOwnerLost);
+    std::move(report).Run(std::move(result));
+    return;
+  }
+  command_storage_manager_->SaveWithCompletion(std::move(report));
+}
