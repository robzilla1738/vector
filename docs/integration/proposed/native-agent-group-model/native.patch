+void TabStripModel::SetGroupIsAgent(const tab_groups::TabGroupId& group_id,
+                                    bool is_agent) {
+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+  TabGroup* group = group_model_->GetTabGroup(group_id);
+  CHECK(group);
+  TabGroupFeatures* features = group->GetTabGroupFeatures();
+  CHECK(features);
+  if (features->is_agent_group() == is_agent) {
+    return;
+  }
+  features->set_is_agent_group(is_agent);
+  tab_groups::TabGroupVisualData old_visuals = *group->visual_data();
+  tab_groups::TabGroupVisualData new_visuals = old_visuals;
+  new_visuals.SetIsAgentGroup(is_agent);
+  group->SetVisualData(new_visuals, group->IsCustomized());
+  TabGroupChange::VisualsChange visuals;
+  visuals.old_visuals = &old_visuals;
+  visuals.new_visuals = &new_visuals;
+  NotifyTabGroupVisualsChanged(group_id, visuals);
+  const gfx::Range range = group->ListTabs();
+  for (uint32_t index = range.start(); index < range.end(); ++index) {
+    SetAgentGroupAudioMuted(GetWebContentsAt(index), is_agent);
+  }
+#endif  // BUILDFLAG(ENABLE_AUX_BROWSER)
+}
