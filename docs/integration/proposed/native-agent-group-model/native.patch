+bool HasAuthenticatedRemoteDebuggingSession(DevToolsAgentHost* host) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!host) {
+    return false;
+  }
+  auto impl = DevToolsAgentHostImpl::GetForId(host->GetId());
+  if (!impl || impl.get() != host) {
+    return false;
+  }
+  return std::ranges::any_of(impl->sessions(), [](const auto& session) {
+    return session->GetClient()->IsAuthenticatedRemoteDebuggingSession();
+  });
+}
 
