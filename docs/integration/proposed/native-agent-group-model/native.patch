+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+// The supplied producer accepts a secure session attached to a member target,
+// or a secure browser session. Merely trusting a client or naming a group does
+// not satisfy this actual connection predicate.
+bool HasAgentGroupSession(TabStripModel* model, const TabGroup* group) {
+  const gfx::Range range = group->ListTabs();
+  for (uint32_t index = range.start(); index < range.end(); ++index) {
+    auto* contents = model->GetWebContentsAt(index);
+    auto tab_host = content::DevToolsAgentHost::GetForTab(contents);
+    if (tab_host &&
+        content::HasAuthenticatedRemoteDebuggingSession(tab_host.get())) {
+      return true;
+    }
+    // The155 tab and page targets are distinct. Preserve existing page sessions
+    // without creating a new target merely to ask about authentication.
+    if (content::DevToolsAgentHost::HasFor(contents) &&
+        content::HasAuthenticatedRemoteDebuggingSession(
+            content::DevToolsAgentHost::GetOrCreateFor(contents).get())) {
+      return true;
+    }
+  }
+  for (const auto& host : content::DevToolsAgentHost::GetAll()) {
+    if (host->GetType() == content::DevToolsAgentHost::kTypeBrowser &&
+        content::HasAuthenticatedRemoteDebuggingSession(host.get())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool IsAgentGroup(TabGroupModel* model,
+                  const std::optional<tab_groups::TabGroupId>& id) {
+  const auto* group = model && id ? model->GetTabGroup(*id) : nullptr;
+  const auto* features = group ? group->GetTabGroupFeatures() : nullptr;
+  return features && features->is_agent_group();
+}
+
+void SetAgentGroupAudioMuted(content::WebContents* contents, bool is_agent) {
+  if (!contents) {
+    return;
+  }
+  if (is_agent) {
+    // Do not steal mute ownership from an already-muted tab.
+    if (!contents->IsAudioMuted()) {
+      SetTabAudioMuted(contents, true, TabMutedReason::kAgentGroup, {});
+    }
+    return;
+  }
+  if (!contents->IsAudioMuted() ||
+      GetTabAudioMutedReason(contents) != TabMutedReason::kAgentGroup) {
+    return;
+  }
+  const GURL& url = contents->GetLastCommittedURL();
+  if (!url.is_empty() && !url.SchemeIs(content::kChromeUIScheme)) {
+    auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+    auto* settings = HostContentSettingsMapFactory::GetForProfile(profile);
+    if (settings->GetContentSetting(url, url, ContentSettingsType::SOUND) ==
+        CONTENT_SETTING_BLOCK) {
+      SetTabAudioMuted(contents, true, TabMutedReason::kContentSetting, {});
+      return;
+    }
+  }
+  SetTabAudioMuted(contents, false, TabMutedReason::kAgentGroup, {});
+}
+#endif  // BUILDFLAG(ENABLE_AUX_BROWSER)
 
