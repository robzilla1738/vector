+    return entry.view_type == TabSlotView::ViewType::kTab;
+  });
+  content::WebContents* contents = nullptr;
+  if (count == 1 && data.source_view_index_ < data.tab_drag_data_.size())
+    contents = data.tab_drag_data_[data.source_view_index_].contents.get();
+  if (contents) {
+    native_drop_title_ = contents->GetTitle();
+    GURL url = contents->GetVisibleURL();
+    if (!url.is_valid()) url = contents->GetLastCommittedURL();
+    if (native_drop_title_.empty() && url.is_valid())
