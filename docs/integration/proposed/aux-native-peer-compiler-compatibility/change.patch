+// Volatile stores are observable side effects and cannot be optimized into a
+// discarded ordinary memset. No libc optional-extension declaration required.
+void WipeOwnedBytes(std::span<uint8_t> bytes) {
+  volatile uint8_t* output = bytes.data();
+  for (size_t index = 0; index < bytes.size(); ++index) output[index] = 0;
+}
