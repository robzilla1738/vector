+// Supplied045ceef4/045cfea8: capture the actual visible source surface, never
+// a model/browser-URL approximation. Invocation belongs to the profile scroll
+// owner; a normal NTP navigation does not initiate this separate screenshot.
+void AuxNtpTransitionState::CaptureProfileSwitchOverlay() {
+  ClearTransition();
+  RefreshBackground();
+  ClearProfileSwitchOverlay();
+  if (!owner_->GetVisible() || owner_->size().IsEmpty() || !web_contents())
+    return;
+  auto* view = web_contents()->GetRenderWidgetHostView();
+  if (!view || !view->IsSurfaceAvailableForCopy())
+    return;
+  const auto size = owner_->size();
+  const auto generation = ++profile_capture_generation_;
+  view->CopyFromSurface(
+      gfx::Rect(), size, base::Milliseconds(50),
+      base::BindPostTaskToCurrentDefault(base::BindOnce(
+          [](base::WeakPtr<AuxNtpTransitionState> state, uint64_t generation,
+             base::WeakPtr<content::WebContents> contents, gfx::Size size,
+             const content::CopyFromSurfaceResult& result) {
+            if (!state || !result.has_value() ||
+                result->bitmap.drawsNothing() || !result->bitmap.getPixels() ||
+                result->bitmap.width() != size.width() ||
+                result->bitmap.height() != size.height())
+              return;
+            state->ApplyProfileSwitchSnapshot(
+                generation, contents, size,
+                gfx::ImageSkia::CreateFrom1xBitmap(result->bitmap));
+          },
+          capture_weak_.GetWeakPtr(), generation, web_contents()->GetWeakPtr(),
+          size)));
+}
+
+void AuxNtpTransitionState::ApplyProfileSwitchSnapshot(
+    uint64_t generation,
+    base::WeakPtr<content::WebContents> contents,
+    gfx::Size size,
+    gfx::ImageSkia image) {
+  if (generation != profile_capture_generation_ || profile_crossfade_ ||
+      !contents || contents.get() != web_contents() || owner_->size() != size ||
+      image.size() != size)
+    return;
+  // Original constructor a686e60 resolves through its metadata to ImageView.
+  auto overlay =
+      std::make_unique<views::ImageView>(ui::ImageModel::FromImageSkia(image));
+  overlay->SetCanProcessEventsWithinSubtree(false);
+
+  overlay->SetBoundsRect(gfx::Rect(size));
+  // Original +310/+318 is ImageViewBase's optional image_size_, NOT a clip.
+  overlay->SetImageSize(size);
+  overlay->SetPaintToLayer(ui::LAYER_TEXTURED);
+  overlay->layer()->SetFillsBoundsOpaquely(false);
+  overlay->layer()->SetOpacity(0.0f);
+  profile_overlay_ = owner_->AddChildView(std::move(overlay));
+}
+
+bool AuxNtpTransitionState::BeginProfileSwitchCrossfade() {
+  if (!profile_overlay_ || !profile_overlay_->layer() ||
+      profile_overlay_->size() != owner_->size()) {
+    ClearProfileSwitchOverlay();
+    return false;
+  }
+  profile_crossfade_ = true;
+  profile_overlay_->layer()->SetOpacity(1.0f);
+  return true;
+}
+
+void AuxNtpTransitionState::SetProfileSwitchOpacity(float opacity) {
+  const float clamped = std::fmin(std::fmax(opacity, 0.0f), 1.0f);
+  saved_opacity_ = clamped;
+  if (!opacity_hidden_ && holder_->layer())
+    holder_->layer()->SetOpacity(clamped);
+  if (profile_crossfade_ && profile_overlay_ && profile_overlay_->layer())
+    profile_overlay_->layer()->SetOpacity(1.0f - clamped);
+}
+
+void AuxNtpTransitionState::ClearProfileSwitchOverlay() {
+  ++profile_capture_generation_;
+  profile_crossfade_ = false;
+  SetProfileSwitchOpacity(1.0f);
+  if (profile_overlay_) {
+    auto* old = profile_overlay_.get();
+    profile_overlay_ = nullptr;
+    owner_->RemoveChildViewT(old);
+  }
+}
+
+void AuxNtpTransitionState::BoundsChanged(const gfx::Rect& previous_bounds) {
+  if (previous_bounds.size() != owner_->size()) {
+    ClearTransition();
+    RefreshBackground();
+  }
+  if (profile_overlay_) {
+    profile_overlay_->SetBoundsRect(gfx::Rect(owner_->size()));
+    profile_overlay_->SetImageSize(owner_->size());
+  }
 }
 
