+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool ProfileMenuCoordinator::CanPrepareForAuxProfileSwitch() const {
+  return browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         browser_->GetProfile()->IsRegularProfile();
+}
+
+void ProfileMenuCoordinator::PrepareForAuxProfileSwitch() {
+  weak_pointer_factory_.InvalidateWeakPtrs();
+  if (bubble_tracker_ && bubble_tracker_.view()->GetWidget()) {
+    bubble_tracker_.view()->GetWidget()->CloseNow();
+  }
+  CHECK(!bubble_tracker_.view());
+}
+
+void ProfileMenuCoordinator::RebindForAuxProfileSwitch(Profile& target) {
+  CHECK(CanPrepareForAuxProfileSwitch());
+  CHECK(target.IsRegularProfile());
+  CHECK_EQ(browser_->GetProfile(), &target);
+  CHECK(browser_->GetTabStripModel()->empty());
+  profile_ = target;
+}
