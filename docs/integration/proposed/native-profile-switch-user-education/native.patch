+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool BrowserUserEducationInterfaceImpl::CanPrepareForAuxProfileSwitch() const {
+  return !aux_profile_switch_paused_ && state_ == State::kInitialized &&
+         queued_params_.empty() && !IsAnyFeaturePromoActive();
+}
+
+void BrowserUserEducationInterfaceImpl::PrepareForAuxProfileSwitch() {
+  CHECK(CanPrepareForAuxProfileSwitch());
+  aux_profile_switch_paused_ = true;
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  // Use the real context invalidation protocol: outstanding forwarding
+  // preconditions drop their old profile references instead of following a
+  // mutable window into another profile's storage service.
+  TearDown();
+  user_education_context_.reset();
+}
+
+void BrowserUserEducationInterfaceImpl::RebindForAuxProfileSwitch(
+    BrowserView& browser_view) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK_EQ(BrowserUserEducationInterface::From(browser_view.browser()), this);
+  CHECK(browser_view.GetProfile()->IsRegularProfile());
+  CHECK_EQ(state_, State::kTornDown);
+  CHECK(queued_params_.empty());
+  profile_ = browser_view.GetProfile();
+  state_ = State::kUninitialized;
+  aux_profile_switch_paused_ = false;
+  // Retain the same interface/userdata. Existing Init constructs a genuine
+  // target storage/context and its normal deferred completion; no startup
+  // promo request is synthesized by the migration.
+  Init(&browser_view);
+}
