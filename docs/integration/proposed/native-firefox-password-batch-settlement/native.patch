+void ProfileWriter::AddFirefoxPasswordForms(
+    const std::vector<password_manager::PasswordForm>& forms,
+    base::OnceCallback<void(bool)> completion) {
+  if (forms.empty()) {
+    std::move(completion).Run(true);
+    return;
+  }
+  const PrefService* prefs = profile_->GetPrefs();
+  if (prefs->IsManagedPreference(password_manager::prefs::kCredentialsEnableService) &&
+      !prefs->GetBoolean(password_manager::prefs::kCredentialsEnableService)) {
+    std::move(completion).Run(false);
+    return;
+  }
+  auto store = ProfilePasswordStoreFactory::GetForProfile(
+      profile_, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!store) {
+    std::move(completion).Run(false);
+    return;
+  }
+  std::vector<password_manager::StoredCredential> converted;
+  converted.reserve(forms.size());
+  for (const auto& form : forms)
+    converted.push_back(password_manager::FromPasswordForm(form));
+  store->AddLogins(std::move(converted), base::BindOnce(
+      [](scoped_refptr<password_manager::PasswordStoreInterface> store,
+         base::OnceCallback<void(bool)> completion) {
+        std::move(completion).Run(
+            store->GetError() == password_manager::ActionableError::kNoError);
+      }, store, std::move(completion)));
+}
