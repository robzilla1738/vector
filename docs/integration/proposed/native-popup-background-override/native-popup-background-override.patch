+void RenderWidgetHostViewBase::SetBackgroundColorOverride(
+    std::optional<SkColor> color) {
+  CHECK(!color || SkColorGetA(*color) == SK_AlphaOPAQUE ||
+        SkColorGetA(*color) == SK_AlphaTRANSPARENT);
+  if (background_color_override_ == color)
+    return;
+
+  bool was_opaque = IsBackgroundColorOpaque();
+  background_color_override_ = color;
+  UpdateBackgroundColor();
+  bool opaque = IsBackgroundColorOpaque();
+  if (was_opaque != opaque && host()->owner_delegate()) {
+    host()->owner_delegate()->SetBackgroundOpaque(opaque);
+  }
+}
