# Fixed launcher is copied by chrome_framework_helpers into the Framework's
# Helpers directory regardless of verify_dynamic_libraries.
if (is_mac) {
  executable("owned_headless_launcher") {
    output_name = "aux_owned_headless_launcher"
    sources = [
      "owned_headless_launcher.cc",
      "owned_headless_protocol.h",
    ]
    # Pure POSIX launcher: no Chrome component or custom C++ runtime symbols.
    # Keep default compiler/linker/SDK/warning configs, but do not inject the
    # shared libc++ executable_deps or C++ module target into this relocated
    # Framework Helpers executable.
    libs = [ "sandbox" ]
    no_default_deps = true
    use_libcxx_modules = false
  }
}

if (is_mac) {
  import("//build/config/mac/mac_sdk.gni")
  config("foundation_models_swift_runtime") {
    # clang links the Swift object's genuine autolink directives. Like the
    # existing iOS config, provide both SDK runtime stubs and the selected
    # compiler's static compatibility libraries to the final dependent link.
    lib_dirs = [
      rebase_path("$mac_sdk_path/usr/lib/swift", "", root_build_dir),
      rebase_path("$mac_bin_path/../lib/swift/macosx", "", root_build_dir),
    ]
  }
  swift_source_set("foundation_models_swift") {
    sources = [ "foundation_models.swift" ]
    all_dependent_configs = [ ":foundation_models_swift_runtime" ]
    swiftflags = [
      "-Xfrontend=-disable-autolink-framework",
      "-Xfrontend=FoundationModels",
    ]
    frameworks = [ "Foundation.framework" ]
    weak_frameworks = [ "FoundationModels.framework" ]
  }
}

