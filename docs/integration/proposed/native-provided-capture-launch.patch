 namespace extensions {
+bool ChromeManagementAPIDelegate::LaunchExtensionFunctionDelegate(
+    const Extension* extension, content::WebContents* sender,
+    content::BrowserContext* context, std::string* error) const {
+#if BUILDFLAG(IS_ANDROID)
+  *error = "chrome.management.launchExtension is not supported on this platform.";
+  return false;
+#else
+  Profile* profile = Profile::FromBrowserContext(context);
+  if (!profile || (profile->IsOffTheRecord() &&
+      !util::IsIncognitoEnabled(extension->id(), context))) {
+    *error = "Extension is unavailable in this browser mode";
+    return false;
+  }
+  BrowserWindowInterface* browser = sender && sender->GetBrowserContext() == context
+      ? browser_window_util::GetBrowserForTabContents(*sender) : nullptr;
+  if (!browser) browser = browser_window_util::GetLastActiveNormalBrowserWithProfile(
+      *profile, /*include_incognito_or_parent=*/false);
+  if (!browser || browser->GetProfile() != profile || !browser->GetWindow()) {
+    *error = "No active browser exists for this profile";
+    return false;
+  }
+  auto* container = ExtensionsContainer::From(*browser);
+  auto* action = container ? container->GetActionForId(extension->id()) : nullptr;
+  auto* tab = browser->GetActiveTabInterface();
+  auto* contents = container ? container->GetActiveWebContents() : nullptr;
+  if (!contents && tab) contents = tab->GetContents();
+  if (!action || !contents || contents->GetBrowserContext() != context ||
+      !action->IsEnabled(contents)) {
+    *error = "Extension has no available action in the active tab";
+    return false;
+  }
+  browser->GetWindow()->Activate();
+  action->ExecuteUserAction(ToolbarActionViewModel::InvocationSource::kApi);
+  return true;  // The native action was invoked; no delivery/side-effect claim.
+#endif
+}
