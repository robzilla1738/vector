+ExtensionFunction::ResponseAction ManagementLaunchExtensionFunction::Run() {
+  if (!extension() || extension()->location() != mojom::ManifestLocation::kComponent ||
+      !extension()->permissions_data()->HasAPIPermission(
+          mojom::APIPermissionID::kAuxLaunchExtension)) {
+    return RespondNow(Error("Permission denied: missing private entitlements"));
+  }
+  const auto params = management::LaunchExtension::Params::Create(args());
+  EXTENSION_FUNCTION_VALIDATE(params);
+  if (!browser_context()) return RespondNow(Error("Profile is no longer available"));
+  const Extension* target = ExtensionRegistry::Get(browser_context())
+      ->enabled_extensions().GetByID(params->id);
+  if (!target) return RespondNow(Error(keys::kNoExtensionError, params->id));
+  const auto* delegate = ManagementAPI::GetFactoryInstance()
+      ->Get(browser_context())->GetDelegate();
+  std::string error;
+  if (!delegate || !delegate->LaunchExtensionFunctionDelegate(
+          target, GetSenderWebContents(), browser_context(), &error)) {
+    return RespondNow(Error(error.empty() ?
+        "chrome.management.launchExtension is not supported on this platform." : error));
+  }
+  return RespondNow(NoArguments());
+}
