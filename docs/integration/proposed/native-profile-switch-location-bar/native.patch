+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool LocationBarView::CanPrepareForAuxProfileSwitch(Profile* target) const {
+  return target && target->IsRegularProfile() && browser_ &&
+         browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         profile_ == browser_->GetProfile() && is_initialized_ &&
+         !aux_profile_switch_paused_ && !in_popup_state_transition_ &&
+         !is_popup_mode_ && omnibox_controller_ &&
+         omnibox_view_ && selected_keyword_view_ && pref_registrar_ &&
+         !omnibox_popup_aim_presenter_ && !omnibox_popup_file_selector_ &&
+         !omnibox::IsWebUIOmniboxPopupEnabled() &&
+         !omnibox::IsWebUIOmniboxInBrowserViewEnabled() &&
+         !base::FeatureList::IsEnabled(omnibox::kWebUIOmniboxFullPopup) &&
+         !omnibox_controller_->IsPopupOpen() &&
+         !omnibox_controller_->edit_model()->user_input_in_progress() &&
+         omnibox_view_->CanPrepareForAuxProfileSwitch();
+}
+
+uint64_t LocationBarView::BeginAuxProfileSwitch(Profile* target) {
+  CHECK(CanPrepareForAuxProfileSwitch(target));
+  aux_profile_switch_paused_ = true;
+  aux_profile_switch_source_ = profile_->GetWeakPtr();
+  const uint64_t generation = ++aux_profile_switch_generation_;
+  weak_factory_.InvalidateWeakPtrs();
+  pref_registrar_->Reset();
+  omnibox_view_->PrepareForAuxProfileSwitch();
+  omnibox_controller_->StopAutocomplete(/*clear_result=*/true);
+  return generation;
+}
+
+void LocationBarView::BindPrefsForAuxProfileSwitch() {
+  pref_registrar_->Reset();
+  pref_registrar_->Init(profile_->GetPrefs());
+  pref_registrar_->Add(omnibox::kShowAiModeOmniboxButton,
+                       base::BindRepeating(&LocationBarView::OnChanged,
+                                           base::Unretained(this)));
+}
+
+void LocationBarView::RebindAuxProfileSwitch(uint64_t generation) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK_EQ(generation, aux_profile_switch_generation_);
+  CHECK(browser_->GetProfile()->IsRegularProfile());
+  CHECK(browser_->GetTabStripModel()->empty());
+  profile_ = browser_->GetProfile();
+  omnibox_controller_->RebindClientForAuxProfileSwitch(
+      std::make_unique<ChromeOmniboxClient>(this, browser_, profile_));
+  selected_keyword_view_->RebindForAuxProfileSwitch(*profile_);
+  omnibox_view_->RebindForAuxProfileSwitch();
+  BindPrefsForAuxProfileSwitch();
+}
+
+void LocationBarView::EndAuxProfileSwitch(uint64_t generation) {
+  if (generation != aux_profile_switch_generation_ ||
+      !aux_profile_switch_paused_) {
+    return;
+  }
+  CHECK_EQ(profile_, browser_->GetProfile());
+  aux_profile_switch_paused_ = false;
+  aux_profile_switch_source_.reset();
+  OnChanged();
+}
+
+void LocationBarView::AbortAuxProfileSwitch(uint64_t generation) {
+  if (generation != aux_profile_switch_generation_ ||
+      !aux_profile_switch_paused_) {
+    return;
+  }
+  CHECK_EQ(aux_profile_switch_source_.get(), browser_->GetProfile());
+  CHECK_EQ(profile_, browser_->GetProfile());
+  // The original client/providers were never replaced before identity.
+  // Restore real source observations after its actual tabs are restored.
+  omnibox_view_->RebindForAuxProfileSwitch();
+  BindPrefsForAuxProfileSwitch();
+  EndAuxProfileSwitch(generation);
+}
+#endif
