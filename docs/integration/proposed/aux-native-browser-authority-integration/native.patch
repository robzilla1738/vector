+DaemonAuthorityReply AuthenticatedSelectedHomeTransfer::SignDaemonChallenge(
+    std::span<const uint8_t> message, uint32_t timeout_ms) {
+  constexpr char domain[] = "Aux Daemon Auth v1"; // Includes exact terminating NUL.
+  if (message.size() != 51 || std::memcmp(message.data(), domain, sizeof(domain)) != 0)
+    return {};
+  return RequestAuthority(kSign, message, timeout_ms);
+}
+DaemonAuthorityReply AuthenticatedSelectedHomeTransfer::GetInstallationPublicKeys(uint32_t timeout_ms) {
+  return RequestAuthority(kPublicKeys, {}, timeout_ms);
+}
+DaemonAuthorityReply AuthenticatedSelectedHomeTransfer::GetAgentInboxV2MasterKey(uint32_t timeout_ms) {
+  return RequestAuthority(kInboxKey, {}, timeout_ms);
+}
+DaemonAuthorityReply AuthenticatedSelectedHomeTransfer::RequestAuthority(
+    uint32_t operation, std::span<const uint8_t> message, uint32_t timeout_ms) {
+  if (!ValidTimeout(timeout_ms)) return {};
+  const auto value = state_;
+  if (getpid() != value->process) return {DaemonAuthorityStatus::wrongProcess, {}};
+  int home = DuplicateRevalidatedDirectory();
+  if (home < 0) return {};
+  close(home);
+  const auto owner = value->owner.lock();
+  if (!owner) return {DaemonAuthorityStatus::closed, {}};
+  std::shared_ptr<AuthorityClient> client;
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    if (owner->snapshot.closed || owner->snapshot.generation != value->generation)
+      return {DaemonAuthorityStatus::closed, {}};
+    client = owner->authority;
+    if (client) ++owner->snapshot.active_exchanges;
+  }
+  if (!client) return {};
+  auto finish_call = +[](ParentTransport::State* retained) {
+    std::lock_guard<std::mutex> lock(retained->mutex);
+    --retained->snapshot.active_exchanges;
+  };
+  std::unique_ptr<ParentTransport::State, decltype(finish_call)> owned_call(owner.get(), finish_call);
+  // One exact outstanding operation per native selected installation. This
+  // serialization lock is not a browser/host lock and crosses no JS callback.
+  std::lock_guard<std::mutex> serial(client->mutex);
+  if (client->closed) return {DaemonAuthorityStatus::closed, {}};
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    if (owner->snapshot.closed || owner->snapshot.generation != value->generation) {
+      WipePayload(client->completed);
+      return {DaemonAuthorityStatus::closed, {}};
+    }
+  }
+  std::array<uint8_t, 51> body{};
+  std::copy(message.begin(), message.end(), body.begin());
+  const bool same = client->started && client->operation == operation && client->message == body;
+  if (client->pending && !same) return {DaemonAuthorityStatus::busy, {}};
+  if (!same) {
+    if (client->sequence == std::numeric_limits<uint64_t>::max()) return {};
+    ++client->sequence;
+    WipePayload(client->completed);
+    client->attempted = false;
+    client->completed_error = false;
+    client->operation = operation;
+    client->message = body;
+    arc4random_buf(client->nonce.data(), client->nonce.size());
+    client->started = true;
+  }
+  const bool observe = same && client->attempted;
+  bool acknowledging = false;
+  for (unsigned phase = 0; phase < 2; ++phase) {
+  ReceiveRight reply;
+  if (reply.get() == MACH_PORT_NULL) return {};
+  AuthorityReceived request{};
+  request.wire.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, MACH_MSG_TYPE_MAKE_SEND_ONCE);
+  request.wire.header.msgh_size = sizeof(AuthorityWire);
+  request.wire.header.msgh_remote_port = client->endpoint.BorrowNativeName();
+  request.wire.header.msgh_local_port = reply.get();
+  request.wire.header.msgh_id = kAuthorityRequest;
+  request.wire.operation = acknowledging ? kAcknowledge : observe ? kObserve : operation;
+  request.wire.generation = value->generation;
+  request.wire.sequence = client->sequence;
+  request.wire.nonce = client->nonce;
+  if (!observe && !acknowledging) request.wire.message = body;
+  // Once send is attempted the nonce is retained, including all timeout/error
+  // outcomes. A later call can only observe it, never silently sign again.
+  client->pending = true;
+  client->attempted = true;
+  auto result = mach_msg(&request.wire.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT,
+      sizeof(AuthorityWire), 0, MACH_PORT_NULL, timeout_ms, MACH_PORT_NULL);
+  if (result != KERN_SUCCESS) {
+    if (RecoverableSendError(result)) {
+      const auto local = MACH_MSGH_BITS_LOCAL(request.wire.header.msgh_bits);
+      if (local == MACH_MSG_TYPE_MOVE_SEND || local == MACH_MSG_TYPE_MOVE_SEND_ONCE)
+        mach_port_deallocate(mach_task_self(), request.wire.header.msgh_local_port);
+    } else {
+      std::lock_guard<std::mutex> lock(owner->mutex);
+      owner->snapshot.closed = true; ++owner->snapshot.generation;
+      WipePayload(client->completed);
+      return {DaemonAuthorityStatus::cleanupUnresolved, {}};
+    }
+    return {DaemonAuthorityStatus::timedOut, {}};
+  }
+  AuthorityReplyReceived response{};
+  PayloadWiper response_wiper(response.wire.payload);
+  result = mach_msg(&response.wire.header, kReceiveOptions, 0, sizeof(response),
+      reply.get(), timeout_ms, MACH_PORT_NULL);
+  if (result == MACH_RCV_TIMED_OUT) return {DaemonAuthorityStatus::timedOut, {}};
+  if (result != KERN_SUCCESS) {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    owner->snapshot.closed = true; ++owner->snapshot.generation;
+    WipePayload(client->completed);
+    return {DaemonAuthorityStatus::cleanupUnresolved, {}};
+  }
+  DestroyMessage cleanup(&response.wire.header);
+  const auto& wire = response.wire;
+  if (wire.header.msgh_size != sizeof(wire) || wire.header.msgh_id != kAuthorityReply ||
+      (wire.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) || wire.version != kAuthorityVersion ||
+      wire.generation != value->generation || wire.sequence != client->sequence ||
+      wire.nonce != client->nonce || wire.reserved != 0 ||
+      wire.length > wire.payload.size() ||
+      response.trailer.msgh_trailer_type != MACH_MSG_TRAILER_FORMAT_0 ||
+      response.trailer.msgh_trailer_size < sizeof(response.trailer) ||
+      audit_token_to_pid(response.trailer.msgh_audit) != owner->child->pid ||
+      audit_token_to_pidversion(response.trailer.msgh_audit) != value->version ||
+      !SameBirth(*owner->child, owner->process) || !WaitableLiveChild(owner->child->pid) ||
+      !NativeOperations::Validate(response.trailer.msgh_audit, *owner->policy)) {
+    WipePayload(client->completed); return {};
+  }
+  home = DuplicateRevalidatedDirectory();
+  if (home < 0) { WipePayload(client->completed); return {}; }
+  close(home);
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    if (owner->snapshot.closed || owner->snapshot.generation != value->generation)
+      { WipePayload(client->completed); return {DaemonAuthorityStatus::closed, {}}; }
+  }
+  switch (wire.status) {
+    case 0:
+      if (acknowledging) {
+        if (wire.length != 0 || (!client->completed_error && client->completed.empty())) return {};
+        client->pending = false;
+        if (client->completed_error) return {};
+        return {DaemonAuthorityStatus::ready, client->completed};
+      }
+      if (!wire.length || (operation == kInboxKey && wire.length != 32)) return {};
+      {
+        std::vector<uint8_t> payload(wire.payload.begin(), wire.payload.begin() + wire.length);
+        if (!client->completed.empty() && client->completed != payload) {
+          WipePayload(payload); WipePayload(client->completed); return {};
+        }
+        if (client->completed.empty()) client->completed = std::move(payload);
+        else WipePayload(payload);
+      }
+      {
+        DaemonAuthorityReply ready(DaemonAuthorityStatus::ready, client->completed);
+        ready.publication_ = std::shared_ptr<DaemonAuthorityPublication>(
+            new DaemonAuthorityPublication(value, client));
+        // Keep pending and backend completion intact until the genuine holder
+        // publication fence explicitly accepts this exact native observation.
+        return ready;
+      }
+    case 1: return {DaemonAuthorityStatus::pending, {}};
+    case 2: return {DaemonAuthorityStatus::busy, {}};
+    case 3:
+      client->closed = true;
+      WipePayload(client->completed);
+      return {DaemonAuthorityStatus::closed, {}};
+    case 4:
+      if (acknowledging) return {};
+      client->completed_error = true;
+      acknowledging = true;
+      continue;
+    default: return {};
+  }
+  }
+  return {DaemonAuthorityStatus::pending, {}};
+}
+
+DaemonAuthorityStatus AuthenticatedSelectedHomeTransfer::AcceptAuthorityReply(
+    const DaemonAuthorityReply& reply_value, uint32_t timeout_ms) {
+  const auto publication = reply_value.publication_;
+  if (!publication || reply_value.status != DaemonAuthorityStatus::ready ||
+      !ValidTimeout(timeout_ms)) return DaemonAuthorityStatus::refused;
+  const auto value = publication->selected.lock();
+  if (!value || value != state_) return DaemonAuthorityStatus::refused;
+  if (getpid() != value->process) return DaemonAuthorityStatus::wrongProcess;
+  int home = DuplicateRevalidatedDirectory();
+  if (home < 0) return DaemonAuthorityStatus::refused;
+  close(home);
+  const auto owner = value->owner.lock();
+  const auto client = publication->client.lock();
+  if (!owner || !client) return DaemonAuthorityStatus::closed;
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    if (owner->snapshot.closed || owner->snapshot.generation != value->generation ||
+        owner->authority != client) return DaemonAuthorityStatus::closed;
+    ++owner->snapshot.active_exchanges;
+  }
+  auto finish = +[](ParentTransport::State* retained) {
+    std::lock_guard<std::mutex> lock(retained->mutex);
+    --retained->snapshot.active_exchanges;
+  };
+  std::unique_ptr<ParentTransport::State, decltype(finish)> call(owner.get(), finish);
+  std::lock_guard<std::mutex> serial(client->mutex);
+  if (client->closed || client->sequence != publication->sequence ||
+      client->operation != publication->operation || client->nonce != publication->nonce ||
+      client->message != publication->message || client->completed_error ||
+      client->completed.empty() || client->completed != reply_value.payload)
+    return DaemonAuthorityStatus::refused;
+  if (publication->acknowledged) return DaemonAuthorityStatus::ready;
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    if (owner->snapshot.closed || owner->snapshot.generation != value->generation) {
+      WipePayload(client->completed); return DaemonAuthorityStatus::closed;
+    }
+  }
+  ReceiveRight reply;
+  if (reply.get() == MACH_PORT_NULL) return DaemonAuthorityStatus::refused;
+  AuthorityReceived request{};
+  request.wire.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, MACH_MSG_TYPE_MAKE_SEND_ONCE);
+  request.wire.header.msgh_size = sizeof(AuthorityWire);
+  request.wire.header.msgh_remote_port = client->endpoint.BorrowNativeName();
+  request.wire.header.msgh_local_port = reply.get();
+  request.wire.header.msgh_id = kAuthorityRequest;
+  request.wire.operation = kAcknowledge;
+  request.wire.generation = value->generation;
+  request.wire.sequence = publication->sequence;
+  request.wire.nonce = publication->nonce;
+  auto result = mach_msg(&request.wire.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT,
+      sizeof(AuthorityWire), 0, MACH_PORT_NULL, timeout_ms, MACH_PORT_NULL);
+  if (result != KERN_SUCCESS) {
+    if (RecoverableSendError(result)) {
+      const auto local = MACH_MSGH_BITS_LOCAL(request.wire.header.msgh_bits);
+      if (local == MACH_MSG_TYPE_MOVE_SEND || local == MACH_MSG_TYPE_MOVE_SEND_ONCE)
+        mach_port_deallocate(mach_task_self(), request.wire.header.msgh_local_port);
+      return DaemonAuthorityStatus::timedOut;
+    }
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    owner->snapshot.closed = true; ++owner->snapshot.generation;
+    WipePayload(client->completed);
+    return DaemonAuthorityStatus::cleanupUnresolved;
+  }
+  AuthorityReplyReceived response{};
+  PayloadWiper response_wiper(response.wire.payload);
+  result = mach_msg(&response.wire.header, kReceiveOptions, 0, sizeof(response),
+      reply.get(), timeout_ms, MACH_PORT_NULL);
+  if (result == MACH_RCV_TIMED_OUT) return DaemonAuthorityStatus::timedOut;
+  if (result != KERN_SUCCESS) {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    owner->snapshot.closed = true; ++owner->snapshot.generation;
+    WipePayload(client->completed);
+    return DaemonAuthorityStatus::cleanupUnresolved;
+  }
+  DestroyMessage cleanup(&response.wire.header);
+  const auto& wire = response.wire;
+  if (wire.header.msgh_size != sizeof(wire) || wire.header.msgh_id != kAuthorityReply ||
+      (wire.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) || wire.version != kAuthorityVersion ||
+      wire.generation != value->generation || wire.sequence != publication->sequence ||
+      wire.nonce != publication->nonce || wire.reserved != 0 || wire.length != 0 ||
+      response.trailer.msgh_trailer_type != MACH_MSG_TRAILER_FORMAT_0 ||
+      response.trailer.msgh_trailer_size < sizeof(response.trailer) ||
+      audit_token_to_pid(response.trailer.msgh_audit) != owner->child->pid ||
+      audit_token_to_pidversion(response.trailer.msgh_audit) != value->version ||
+      !SameBirth(*owner->child, owner->process) || !WaitableLiveChild(owner->child->pid) ||
+      !NativeOperations::Validate(response.trailer.msgh_audit, *owner->policy))
+    return DaemonAuthorityStatus::refused;
+  home = DuplicateRevalidatedDirectory();
+  if (home < 0) return DaemonAuthorityStatus::refused;
+  close(home);
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    if (owner->snapshot.closed || owner->snapshot.generation != value->generation)
+      return DaemonAuthorityStatus::closed;
+  }
+  if (wire.status == 1) return DaemonAuthorityStatus::pending;
+  if (wire.status == 3) {
+    client->closed = true; WipePayload(client->completed);
+    return DaemonAuthorityStatus::closed;
+  }
+  if (wire.status != 0) return DaemonAuthorityStatus::refused;
+  publication->acknowledged = true;
+  client->pending = false;
+  return DaemonAuthorityStatus::ready;
+}
+}  // namespace aux::peer
diff --git a/chrome/browser/aux/AuxNativePeerTransport.h b/chrome/browser/aux/AuxNativePeerTransport.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/aux/AuxNativePeerTransport.h
@@ -0,0 +1,207 @@
+#pragma once
+#include <Security/Security.h>
+#include <mach/mach.h>
+#include <sys/types.h>
+#include <cstdint>
+#include <memory>
+#include <span>
+#include <vector>
+#include <chrono>
+#include <optional>
+
+namespace aux::peer {
+// Immutable code policy supplied by trusted native host policy. Copying this
+// policy does not authenticate that host or establish profile writer custody.
+class ExactCodePolicy final {
+ public:
+  static std::shared_ptr<const ExactCodePolicy> CopyNativePolicy(
+      SecRequirementRef requirement, std::span<const uint8_t> cd_hash);
+  ~ExactCodePolicy();
+ private:
+  ExactCodePolicy(SecRequirementRef requirement, std::span<const uint8_t> hash);
+  struct Data;
+  std::unique_ptr<Data> data_;
+  friend class ParentTransport;
+  friend struct NativeOperations;
+};
+class NativeSendRight final {
+ public:
+  // Adopts one real received send-right ref, not a descriptor supplied by JS.
+  static NativeSendRight AdoptReceivedRight(mach_port_t right);
+  bool is_valid() const;
+  NativeSendRight CopyOwnedRight() const;
+  mach_port_t ReleaseForNativeHandoff();
+  mach_port_t BorrowNativeName() const;
+  NativeSendRight(NativeSendRight&& other) noexcept;
+  NativeSendRight& operator=(NativeSendRight&& other) noexcept;
+  ~NativeSendRight();
+  NativeSendRight(const NativeSendRight&) = delete;
+  NativeSendRight& operator=(const NativeSendRight&) = delete;
+ private:
+  explicit NativeSendRight(mach_port_t right);
+  mach_port_t right_ = MACH_PORT_NULL;
+  pid_t process_ = -1;
+  friend class ParentTransport;
+  friend struct NativeOperations;
+};
+struct TransportSnapshot {
+  uint64_t generation = 1;
+  bool closed = false;
+  bool wrong_process = false;
+  uint64_t active_exchanges = 0;
+  uint64_t active_receives = 0;
+  uint64_t active_code_validations = 0;
+  uint64_t active_selected_home_validations = 0;
+  uint64_t authenticated_exchanges = 0;
+  uint64_t authenticated_ready_home_exports = 0;
+  uint64_t rejected_peer_identities = 0;
+  uint64_t unresolved_reply_cleanup = 0;
+  bool child_pid_version_observed = false;
+  bool child_bound = false;
+  bool selected_home_pending = false;
+  uint64_t selected_home_cleanup_unresolved = 0;
+  uint64_t unresolved_receive_cleanup = 0;
+  int32_t last_receive_error = 0;
+};
+enum class ExchangeStatus { authenticated, timedOut, refused, closed, wrongProcess };
+struct ParentExchange {
+  ExchangeStatus status = ExchangeStatus::refused;
+  uint64_t transport_generation = 0;
+  int peer_pid = -1;
+  int peer_pid_version = -1;
+  bool right_cleanup_unresolved = false;
+  int32_t receive_error = 0;
+};
+enum class DaemonAuthorityStatus { ready, pending, busy, refused, closed, timedOut,
+                                   wrongProcess, cleanupUnresolved };
+class DaemonAuthorityPublication;
+struct DaemonAuthorityReply {
+  DaemonAuthorityReply();
+  DaemonAuthorityReply(DaemonAuthorityStatus result, std::vector<uint8_t> bytes);
+  ~DaemonAuthorityReply();
+  DaemonAuthorityReply(DaemonAuthorityReply&&) noexcept;
+  DaemonAuthorityReply& operator=(DaemonAuthorityReply&&) noexcept;
+  DaemonAuthorityReply(const DaemonAuthorityReply&) = delete;
+  DaemonAuthorityReply& operator=(const DaemonAuthorityReply&) = delete;
+  DaemonAuthorityStatus status = DaemonAuthorityStatus::refused;
+  std::vector<uint8_t> payload;
+ private:
+  std::shared_ptr<DaemonAuthorityPublication> publication_;
+  friend class AuthenticatedSelectedHomeTransfer;
+};
+class PreparedParentEndpoint;
+class OwnedNativePeerChild;
+class SelectedNativeHome;
+// Observational only: constructed from completed genuine ready-home exchanges.
+struct ReadyHomePulse {
+  uint64_t generation;
+  uint64_t exports;
+  std::chrono::steady_clock::time_point observed;
+};
+// Internal transport product: only actual authenticated Mach FD receipt creates
+// it; only the real owned child can promote it to a retained selected home.
+class AuthenticatedSelectedHomeTransfer final {
+ public:
+  ~AuthenticatedSelectedHomeTransfer();
+  DaemonAuthorityReply SignDaemonChallenge(std::span<const uint8_t> exact_message,
+                                           uint32_t timeout_ms);
+  DaemonAuthorityReply GetInstallationPublicKeys(uint32_t timeout_ms);
+  DaemonAuthorityReply GetAgentInboxV2MasterKey(uint32_t timeout_ms);
+  // Caller invokes only after its actual owner/pulse publication fence.
+  DaemonAuthorityStatus AcceptAuthorityReply(const DaemonAuthorityReply& reply,
+                                            uint32_t timeout_ms);
+  AuthenticatedSelectedHomeTransfer(const AuthenticatedSelectedHomeTransfer&) = delete;
+  AuthenticatedSelectedHomeTransfer& operator=(const AuthenticatedSelectedHomeTransfer&) = delete;
+ private:
+  struct State;
+  explicit AuthenticatedSelectedHomeTransfer(std::shared_ptr<State> state);
+  int DuplicateRevalidatedDirectory();
+  DaemonAuthorityReply RequestAuthority(uint32_t operation, std::span<const uint8_t> message, uint32_t timeout_ms);
+  std::optional<ReadyHomePulse> InspectReadyPulse();
+  std::shared_ptr<State> state_;
+  friend class ParentTransport;
+  friend class DaemonAuthorityPublication;
+  friend class SelectedNativeHome;
+  friend class OwnedNativePeerChild;
+};
+class ParentTransport final {
+ public:
+  // Native launch owner calls only after its actual spawn. Kernel checks require
+  // this process's live direct, waitable child; SIGCHLD auto-reaping is refused.
+  static std::unique_ptr<ParentTransport> BindActualDirectChild(
+      pid_t child, std::shared_ptr<const ExactCodePolicy> child_policy);
+  ~ParentTransport();
+  NativeSendRight CopySendRightForNativeHandoff();
+  // One bounded native exchange. Real IPC/live Security operations occur here.
+  ExchangeStatus ServiceOne(uint32_t timeout_ms);
+  TransportSnapshot CloseAndInspect();
+  TransportSnapshot Inspect() const;
+ private:
+  friend class PreparedParentEndpoint;
+  friend class OwnedNativePeerChild;
+  friend class AuthenticatedSelectedHomeTransfer;
+  std::shared_ptr<AuthenticatedSelectedHomeTransfer> TakeSelectedHomeTransfer();
+  struct State;
+  explicit ParentTransport(std::shared_ptr<State> state);
+  std::shared_ptr<State> state_;
+};
+// Native launch prepares its actual receive right before spawn; binding can be
+// completed only once using the actual live direct child after spawn returns.
+class PreparedParentEndpoint final {
+ public:
+  ~PreparedParentEndpoint();
+  static std::unique_ptr<PreparedParentEndpoint> PrepareBeforeSpawn(
+      std::shared_ptr<const ExactCodePolicy> child_policy);
+  NativeSendRight CopySendRightForNativeHandoff();
+  std::unique_ptr<ParentTransport> BindActualDirectChild(pid_t child);
+  TransportSnapshot CloseAndInspect();
+  TransportSnapshot Inspect() const;
+ private:
+  explicit PreparedParentEndpoint(std::shared_ptr<ParentTransport::State> state);
+  std::shared_ptr<ParentTransport::State> state_;
+};
+struct NativeParentConnectionSnapshot {
+  bool closed = false;
+  bool wrong_process = false;
+  uint64_t active_checks = 0;
+  int parent_pid = -1;
+  int parent_pid_version = -1;
+  uint64_t selected_home_cleanup_unresolved = 0;
+  uint64_t unresolved_receive_cleanup = 0;
+  uint64_t unresolved_send_cleanup = 0;
+  int32_t last_receive_error = 0;
+};
+// Only a real live handshake can construct this retained native connection.
+// The type authenticates a peer, NEVER profile/cohort/installer custody.
+class AuthenticatedNativeParentConnection final {
+ public:
+  static std::unique_ptr<AuthenticatedNativeParentConnection> Connect(
+      NativeSendRight endpoint,
+      std::shared_ptr<const ExactCodePolicy> parent_policy, uint32_t timeout_ms);
+  ~AuthenticatedNativeParentConnection();
+  AuthenticatedNativeParentConnection(const AuthenticatedNativeParentConnection&) = delete;
+  AuthenticatedNativeParentConnection& operator=(const AuthenticatedNativeParentConnection&) = delete;
+  ExchangeStatus Revalidate(uint32_t timeout_ms);
+#if defined(AUX_NATIVE_DAEMON_AUTHORITY_SERVER)
+  // Descriptor source is ONLY actual ready-service C producer, never a caller FD.
+  ParentExchange SendSelectedHome(uint64_t ready_service, uint32_t timeout_ms);
+#endif
+  int32_t StartPreparedDaemonAuthorityServer(uint64_t provider, uint32_t timeout_ms);
+  int32_t ServicePreparedDaemonAuthorityServer(uint32_t timeout_ms);
+  int32_t ClosePreparedDaemonAuthorityServer();
+  NativeParentConnectionSnapshot CloseAndInspect();
+  NativeParentConnectionSnapshot Inspect() const;
+ private:
+  struct State;
+  explicit AuthenticatedNativeParentConnection(std::shared_ptr<State> state);
+  friend struct AuthorityServer;
+  std::shared_ptr<State> state_;
+};
+// Child native bootstrap consumes a private endpoint transferred by actual
+// launch IPC. The peer is checked against its actual living parent, not a PID
+// argument/ENV value. Success authenticates this exchange only, NEVER a cohort.
+ParentExchange AuthenticateActualNativeParent(
+    const NativeSendRight& endpoint,
+    std::shared_ptr<const ExactCodePolicy> parent_policy,
+    uint32_t timeout_ms);
+}  // namespace aux::peer
diff --git a/chrome/browser/aux/AuxNativePeerWire.h b/chrome/browser/aux/AuxNativePeerWire.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/aux/AuxNativePeerWire.h
@@ -0,0 +1,105 @@
+#pragma once
+#include <mach/mach.h>
+#include <array>
+#include <cstdint>
+
+namespace aux::peer::detail {
+constexpr mach_msg_id_t kRequest = 0x41555851;  // AUXQ
+constexpr mach_msg_id_t kReply = 0x41555852;    // AUXR
+constexpr uint32_t kVersion = 1;
+constexpr uint32_t kMaximumTimeoutMs = 2'000;
+inline constexpr bool ValidTimeout(uint32_t timeout_ms) {
+  return timeout_ms > 0 && timeout_ms <= kMaximumTimeoutMs;
+}
+struct Wire {
+  mach_msg_header_t header{};
+  uint32_t version = kVersion;
+  uint32_t reserved = 0;
+  uint64_t generation = 0;
+  std::array<uint8_t, 32> nonce{};
+};
+struct Received {
+  Wire wire;
+  mach_msg_audit_trailer_t trailer;
+};
+static_assert(sizeof(Wire) % 4 == 0);
+inline bool ValidWire(const Received& received, mach_msg_id_t kind) {
+  return received.wire.header.msgh_size == sizeof(Wire) &&
+      received.wire.header.msgh_id == kind &&
+      !(received.wire.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) &&
+      received.wire.version == kVersion && received.wire.reserved == 0 &&
+      received.trailer.msgh_trailer_type == MACH_MSG_TRAILER_FORMAT_0 &&
+      received.trailer.msgh_trailer_size >= sizeof(mach_msg_audit_trailer_t);
+}
+
+// Distinct complex protocol; v1 heartbeats remain byte-for-byte noncomplex.
+constexpr mach_msg_id_t kSelectedHomeRequest = 0x41555848;  // AUXH
+constexpr mach_msg_id_t kSelectedHomeReply = 0x41555849;    // AUXI
+constexpr uint32_t kSelectedHomeVersion = 2;
+struct SelectedHomeWire {
+  mach_msg_header_t header{};
+  mach_msg_body_t body{};
+  mach_msg_port_descriptor_t fileport{};
+  uint32_t version = kSelectedHomeVersion;
+  uint32_t reserved = 0;
+  uint64_t generation = 0;
+  std::array<uint8_t, 32> nonce{};
+};
+struct SelectedHomeReceived {
+  SelectedHomeWire wire;
+  mach_msg_audit_trailer_t trailer;
+};
+static_assert(sizeof(SelectedHomeWire) % 4 == 0);
+inline bool ValidSelectedHomeWire(const SelectedHomeReceived& received) {
+  return received.wire.header.msgh_size == sizeof(SelectedHomeWire) &&
+      received.wire.header.msgh_id == kSelectedHomeRequest &&
+      (received.wire.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) &&
+      received.wire.body.msgh_descriptor_count == 1 &&
+      received.wire.fileport.type == MACH_MSG_PORT_DESCRIPTOR &&
+      received.wire.fileport.disposition == MACH_MSG_TYPE_PORT_SEND &&
+      received.wire.fileport.name != MACH_PORT_NULL &&
+      received.wire.version == kSelectedHomeVersion && received.wire.reserved == 0 &&
+      received.wire.generation == 0 &&
+      received.trailer.msgh_trailer_type == MACH_MSG_TRAILER_FORMAT_0 &&
+      received.trailer.msgh_trailer_size >= sizeof(mach_msg_audit_trailer_t);
+}
+
+// Finite native daemon authority RPC; never a generic command envelope.
+constexpr mach_msg_id_t kAuthorityRegister = 0x4155584a; // AUXJ
+constexpr mach_msg_id_t kAuthorityRegistered = 0x4155584b; // AUXK
+constexpr mach_msg_id_t kAuthorityRequest = 0x4155584c; // AUXL
+constexpr mach_msg_id_t kAuthorityReply = 0x4155584d; // AUXM
+constexpr uint32_t kAuthorityVersion = 4;
+constexpr uint32_t kSign = 1, kPublicKeys = 2, kInboxKey = 3, kObserve = 4, kAcknowledge = 5;
+struct AuthorityWire {
+  mach_msg_header_t header{};
+  uint32_t version = kAuthorityVersion;
+  uint32_t operation = 0;
+  uint64_t generation = 0;
+  uint64_t sequence = 0;
+  std::array<uint8_t, 16> nonce{};
+  std::array<uint8_t, 51> message{};
+  uint8_t padding = 0;
+};
+struct AuthorityReceived { AuthorityWire wire; mach_msg_audit_trailer_t trailer; };
+struct AuthorityReplyWire {
+  mach_msg_header_t header{};
+  uint32_t version = kAuthorityVersion;
+  int32_t status = -1;
+  uint64_t generation = 0;
+  uint64_t sequence = 0;
+  std::array<uint8_t, 16> nonce{};
+  uint32_t length = 0;
+  uint32_t reserved = 0;
+  std::array<uint8_t, 8192> payload{};
+};
+struct AuthorityReplyReceived { AuthorityReplyWire wire; mach_msg_audit_trailer_t trailer; };
+static_assert(sizeof(AuthorityWire) % 4 == 0);
+static_assert(sizeof(AuthorityReplyWire) % 4 == 0);
+
+// Apple libsyscall only treats these send errors as recoverable for cleanup.
+inline bool RecoverableSendError(mach_msg_return_t result) {
+  return result == MACH_SEND_INVALID_DEST || result == MACH_SEND_TIMED_OUT ||
+      result == MACH_SEND_INTERRUPTED;
+}
+}  // namespace aux::peer::detail
diff --git a/chrome/browser/aux/AuxOwnedNativePeerChild.cc b/chrome/browser/aux/AuxOwnedNativePeerChild.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/aux/AuxOwnedNativePeerChild.cc
@@ -0,0 +1,358 @@
+#include "AuxOwnedNativePeerChild.h"
+#include "base/apple/mach_port_rendezvous.h"
+#include "base/apple/scoped_mach_port.h"
+#include "base/process/process.h"
+#include "base/time/time.h"
+#include <sys/wait.h>
+#include <unistd.h>
+#include <mutex>
+#include <optional>
+#include <limits>
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+namespace aux::peer {
+struct OwnedNativePeerChild::State {
+  State(base::CommandLine command_value, base::LaunchOptions options_value,
+        std::unique_ptr<PreparedParentEndpoint> prepared_value, NativeSendRight handoff_value);
+  ~State();
+  static pid_t RegistryProcess();
+  static std::mutex& RetainedMutex();
+  static std::vector<std::shared_ptr<State>>& Retained();
+  static void CloseAndRetain(std::shared_ptr<State> state);
+  NativeChildObservation ObserveLocked();
+  NativeChildObservation ReapLocked();
+  const pid_t process = getpid();
+  std::mutex mutex;
+  base::CommandLine command;
+  base::LaunchOptions options;
+  std::unique_ptr<PreparedParentEndpoint> prepared;
+  NativeSendRight handoff;
+  std::shared_ptr<ParentTransport> peer;
+  base::Process child;
+  base::Time child_created;
+  NativeChildObservation observation;
+  bool retained_for_exit = false;
+};
+OwnedNativePeerChild::State::State(base::CommandLine command_value,
+    base::LaunchOptions options_value, std::unique_ptr<PreparedParentEndpoint> prepared_value,
+    NativeSendRight handoff_value)
+    : command(std::move(command_value)), options(std::move(options_value)),
+      prepared(std::move(prepared_value)), handoff(std::move(handoff_value)) {}
+OwnedNativePeerChild::State::~State() = default;
+pid_t OwnedNativePeerChild::State::RegistryProcess() { static const pid_t owner = getpid(); return owner; }
+std::mutex& OwnedNativePeerChild::State::RetainedMutex() {
+  static auto* mutex = new std::mutex;
+  return *mutex;
+}
+std::vector<std::shared_ptr<OwnedNativePeerChild::State>>& OwnedNativePeerChild::State::Retained() {
+  static auto* children = new std::vector<std::shared_ptr<State>>;
+  return *children;
+}
+NativeChildObservation OwnedNativePeerChild::State::ObserveLocked() {
+  observation.peer = peer ? peer->Inspect() : prepared->Inspect();
+  return observation;
+}
+OwnedNativePeerChild::OwnedNativePeerChild(std::shared_ptr<State> state) : state_(std::move(state)) {}
+std::unique_ptr<OwnedNativePeerChild> OwnedNativePeerChild::PrepareBeforeSpawn(
+    base::CommandLine command, base::LaunchOptions options,
+    std::shared_ptr<const ExactCodePolicy> policy) {
+  // This fresh cold path cannot carry the historical Keychain interposer. Its
+  // absence is a required real launch property, never an admission grant.
+  if (!policy || !options.clear_environment ||
+      options.environment.contains("DYLD_INSERT_LIBRARIES") ||
+      options.environment.contains("NODE_OPTIONS") ||
+      options.environment.contains("NODE_PATH") ||
+      options.environment.contains("AUX_ENABLE_PROVIDED_NATIVE_CARRIER") ||
+      options.environment.contains("AUX_PROVIDED_NATIVE_LOAD_ONLY") ||
+      options.mach_ports_for_rendezvous.contains(kNativeParentPeerPort)) return {};
+  auto prepared = PreparedParentEndpoint::PrepareBeforeSpawn(std::move(policy));
+  if (!prepared) return {};
+  auto right = prepared->CopySendRightForNativeHandoff();
+  if (!right.is_valid()) return {};
+  options.mach_ports_for_rendezvous.emplace(kNativeParentPeerPort,
+      base::MachRendezvousPort(right.BorrowNativeName(), MACH_MSG_TYPE_COPY_SEND));
+  return std::unique_ptr<OwnedNativePeerChild>(new OwnedNativePeerChild(
+      std::make_shared<State>(std::move(command), std::move(options), std::move(prepared), std::move(right))));
+}
+void OwnedNativePeerChild::State::CloseAndRetain(std::shared_ptr<State> state) {
+  if (getpid() != state->process || getpid() != RegistryProcess()) return;
+  bool retain = false;
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    state->observation.closed = true;
+    state->prepared->CloseAndInspect();
+    if (state->peer) state->peer->CloseAndInspect();
+    auto observed = state->ReapLocked();
+    retain = observed.launch_attempted && !observed.launch_failed &&
+        !observed.exit_observed_and_reaped && !state->retained_for_exit;
+    if (retain) state->retained_for_exit = true;
+  }
+  if (retain) {
+    std::lock_guard<std::mutex> lock(RetainedMutex());
+    Retained().push_back(std::move(state));
+  }
+}
+OwnedNativePeerChild::~OwnedNativePeerChild() {
+  if (getpid() != state_->process) return;
+  {
+    std::lock_guard<std::mutex> lock(state_->mutex);
+    // The private selected object now owns close/quarantine of this actual
+    // waitable child state. An observer or raw Boolean cannot set this field.
+    if (state_->observation.selected_home_owner_transferred) return;
+  }
+  State::CloseAndRetain(state_);
+}
+bool OwnedNativePeerChild::LaunchOnce() {
+  auto state = state_;
+  if (getpid() != state->process) return false;
+  std::lock_guard<std::mutex> lock(state->mutex);
+  if (state->observation.closed || state->observation.launch_attempted) return false;
+  state->observation.launch_attempted = true;
+  // Actual spawn is serialized with this owner's terminal close, matching the
+  // supplied supervisor's RunAdmittedLaunch generation-lock boundary.
+  // COPY_SEND borrows the original ref, retained in state->handoff throughout
+  // launch, early returns, rendezvous delivery and actual child exit.
+  state->child = base::LaunchProcess(state->command, state->options);
+  if (!state->child.IsValid()) {
+    state->observation.launch_failed = true;
+    state->prepared->CloseAndInspect();
+    return false;
+  }
+  state->observation.child_pid = state->child.Pid();
+  state->child_created = state->child.CreationTime();
+  state->peer = state->prepared->BindActualDirectChild(state->child.Pid());
+  state->observation.child_binding_failed = !state->peer;
+  if (!state->peer) state->prepared->CloseAndInspect();
+  // A failed binding does not discard/kill the child already spawned.
+  return static_cast<bool>(state->peer);
+}
+ExchangeStatus OwnedNativePeerChild::ServicePeerOnce(uint32_t timeout_ms) {
+  auto state = state_;
+  if (getpid() != state->process) return ExchangeStatus::wrongProcess;
+  std::shared_ptr<ParentTransport> peer;
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    if (state->observation.closed) return ExchangeStatus::closed;
+    peer = state->peer;
+  }
+  return peer ? peer->ServiceOne(timeout_ms) : ExchangeStatus::refused;
+}
+NativeChildObservation OwnedNativePeerChild::CloseAndInspect() {
+  auto state = state_;
+  if (getpid() != state->process) return NativeChildObservation{.closed = true, .wrong_process = true};
+  std::lock_guard<std::mutex> lock(state->mutex);
+  state->observation.closed = true;
+  state->prepared->CloseAndInspect();
+  if (state->peer) state->peer->CloseAndInspect();
+  return state->ObserveLocked();
+}
+NativeChildObservation OwnedNativePeerChild::ObserveAndReapExitedChild() {
+  auto state = state_;
+  if (getpid() != state->process) return NativeChildObservation{.closed = true, .wrong_process = true};
+  std::lock_guard<std::mutex> lock(state->mutex);
+  return state->ReapLocked();
+}
+NativeChildObservation OwnedNativePeerChild::State::ReapLocked() {
+  if (!child.IsValid() || observation.exit_observed_and_reaped)
+    return ObserveLocked();
+  siginfo_t exit{};
+  const pid_t pid = child.Pid();
+  if (child_created.is_null() || child.CreationTime() != child_created ||
+      waitid(P_PID, static_cast<id_t>(pid), &exit, WEXITED | WNOHANG | WNOWAIT) != 0) {
+    observation.exit_ownership_unknown = true;
+    return ObserveLocked();
+  }
+  if (!exit.si_pid) return ObserveLocked();
+  int status = 0;
+  if (exit.si_pid != pid || waitpid(pid, &status, WNOHANG) != pid) {
+    observation.exit_ownership_unknown = true;
+    return ObserveLocked();
+  }
+  observation.wait_status = status;
+  observation.exit_observed_and_reaped = true;
+  observation.closed = true;
+  prepared->CloseAndInspect();
+  if (peer) peer->CloseAndInspect();
+  child.Close();
+  return ObserveLocked();
+}
+size_t OwnedNativePeerChild::RetainedUnresolvedChildren() {
+  if (getpid() != State::RegistryProcess()) return std::numeric_limits<size_t>::max();
+  std::lock_guard<std::mutex> lock(State::RetainedMutex());
+  return State::Retained().size();
+}
+size_t OwnedNativePeerChild::PollRetainedOwnedChildren() {
+  if (getpid() != State::RegistryProcess()) return std::numeric_limits<size_t>::max();
+  std::vector<std::shared_ptr<State>> retained;
+  {
+    std::lock_guard<std::mutex> lock(State::RetainedMutex());
+    retained = State::Retained();
+  }
+  for (auto& state : retained) {
+    bool terminal = false;
+    {
+      std::lock_guard<std::mutex> lock(state->mutex);
+      terminal = state->ReapLocked().exit_observed_and_reaped;
+    }
+    if (terminal) {
+      std::lock_guard<std::mutex> lock(State::RetainedMutex());
+      std::erase(State::Retained(), state);
+    }
+  }
+  return RetainedUnresolvedChildren();
+}
+}  // namespace aux::peer
+
+namespace aux::peer {
+struct SelectedNativeHome::State {
+  State(std::shared_ptr<OwnedNativePeerChild::State> child_value,
+        std::shared_ptr<AuthenticatedSelectedHomeTransfer> transfer_value)
+      : child(std::move(child_value)), transfer(std::move(transfer_value)) {}
+  const pid_t process = getpid();
+  const std::shared_ptr<OwnedNativePeerChild::State> child;
+  const std::shared_ptr<AuthenticatedSelectedHomeTransfer> transfer;
+};
+SelectedNativeHome::SelectedNativeHome(std::shared_ptr<State> state) : state_(std::move(state)) {}
+SelectedNativeHome::~SelectedNativeHome() {
+  if (getpid() == state_->process) OwnedNativePeerChild::State::CloseAndRetain(state_->child);
+}
+int SelectedNativeHome::DuplicateRevalidatedDirectory() {
+  auto selected = state_;
+  auto owner = selected->child;
+  if (getpid() != selected->process || getpid() != owner->process) return -1;
+  std::shared_ptr<ParentTransport> peer;
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    auto observation = owner->ReapLocked();
+    if (observation.closed || observation.child_binding_failed || observation.exit_observed_and_reaped ||
+        observation.exit_ownership_unknown || !owner->child.IsValid()) return -1;
+    peer = owner->peer;
+  }
+  if (!peer) return -1;
+  int descriptor = selected->transfer->DuplicateRevalidatedDirectory();
+  if (descriptor < 0) return -1;
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    auto observation = owner->ReapLocked();
+    if (observation.closed || observation.exit_observed_and_reaped || observation.exit_ownership_unknown ||
+        owner->peer != peer) { close(descriptor); return -1; }
+  }
+  return descriptor;
+}
+std::optional<ReadyHomePulse> SelectedNativeHome::InspectReadyPulse() {
+  auto selected = state_;
+  auto owner = selected->child;
+  if (getpid() != selected->process || getpid() != owner->process) return std::nullopt;
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    auto observation = owner->ReapLocked();
+    if (observation.closed || observation.exit_observed_and_reaped ||
+        observation.exit_ownership_unknown || !owner->child.IsValid()) return std::nullopt;
+  }
+  return selected->transfer->InspectReadyPulse();
+}
+ExchangeStatus SelectedNativeHome::ServicePeerOnce(uint32_t timeout_ms) {
+  auto owner = state_->child;
+  if (getpid() != owner->process) return ExchangeStatus::wrongProcess;
+  std::shared_ptr<ParentTransport> peer;
+  {
+    std::lock_guard<std::mutex> lock(owner->mutex);
+    auto observation = owner->ReapLocked();
+    if (observation.closed || observation.exit_observed_and_reaped ||
+        observation.exit_ownership_unknown) return ExchangeStatus::closed;
+    peer = owner->peer;
+  }
+  return peer ? peer->ServiceOne(timeout_ms) : ExchangeStatus::refused;
+}
+NativeChildObservation SelectedNativeHome::InspectOwnedChild() {
+  if (getpid() != state_->process) return NativeChildObservation{.closed = true, .wrong_process = true};
+  std::lock_guard<std::mutex> lock(state_->child->mutex);
+  return state_->child->ReapLocked();
+}
+DaemonAuthorityReply SelectedNativeHome::SignDaemonChallenge(std::span<const uint8_t> message, uint32_t timeout_ms) {
+  auto before = InspectOwnedChild();
+  if (before.closed || before.wrong_process || before.exit_observed_and_reaped || before.exit_ownership_unknown)
+    return {DaemonAuthorityStatus::closed, {}};
+  auto reply = state_->transfer->SignDaemonChallenge(message, timeout_ms);
+  auto after = InspectOwnedChild();
+  if (after.closed || after.exit_observed_and_reaped || after.exit_ownership_unknown || after.child_pid != before.child_pid)
+    return {DaemonAuthorityStatus::closed, {}};
+  return reply;
+}
+DaemonAuthorityReply SelectedNativeHome::GetInstallationPublicKeys(uint32_t timeout_ms) {
+  auto before = InspectOwnedChild();
+  if (before.closed || before.wrong_process || before.exit_observed_and_reaped || before.exit_ownership_unknown)
+    return {DaemonAuthorityStatus::closed, {}};
+  auto reply = state_->transfer->GetInstallationPublicKeys(timeout_ms);
+  auto after = InspectOwnedChild();
+  if (after.closed || after.exit_observed_and_reaped || after.exit_ownership_unknown || after.child_pid != before.child_pid)
+    return {DaemonAuthorityStatus::closed, {}};
+  return reply;
+}
+DaemonAuthorityReply SelectedNativeHome::GetAgentInboxV2MasterKey(uint32_t timeout_ms) {
+  auto before = InspectOwnedChild();
+  if (before.closed || before.wrong_process || before.exit_observed_and_reaped || before.exit_ownership_unknown)
+    return {DaemonAuthorityStatus::closed, {}};
+  auto reply = state_->transfer->GetAgentInboxV2MasterKey(timeout_ms);
+  auto after = InspectOwnedChild();
+  if (after.closed || after.exit_observed_and_reaped || after.exit_ownership_unknown || after.child_pid != before.child_pid) {
+    if (!reply.payload.empty()) explicit_bzero(reply.payload.data(), reply.payload.size());
+    return {DaemonAuthorityStatus::closed, {}};
+  }
+  return reply;
+}
+DaemonAuthorityStatus SelectedNativeHome::AcceptAuthorityReply(
+    const DaemonAuthorityReply& reply, uint32_t timeout_ms) {
+  auto child = InspectOwnedChild();
+  if (child.closed || child.wrong_process || child.exit_observed_and_reaped || child.exit_ownership_unknown)
+    return DaemonAuthorityStatus::closed;
+  return state_->transfer->AcceptAuthorityReply(reply, timeout_ms);
+}
+NativeChildObservation SelectedNativeHome::CloseNativeAdmission() {
+  if (getpid() != state_->process) return NativeChildObservation{.closed = true, .wrong_process = true};
+  OwnedNativePeerChild::State::CloseAndRetain(state_->child);
+  std::lock_guard<std::mutex> lock(state_->child->mutex);
+  return state_->child->ObserveLocked();
+}
+std::unique_ptr<SelectedNativeHome> OwnedNativePeerChild::TakeSelectedHome() {
+  auto state = state_;
+  if (getpid() != state->process) return {};
+  std::shared_ptr<ParentTransport> peer;
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    auto observation = state->ReapLocked();
+    if (observation.closed || observation.selected_home_owner_transferred || !state->observation.launch_attempted || observation.launch_failed ||
+        observation.child_binding_failed || observation.exit_observed_and_reaped ||
+        observation.exit_ownership_unknown || !state->child.IsValid()) return {};
+    peer = state->peer;
+  }
+  if (!peer) return {};
+  auto transfer = peer->TakeSelectedHomeTransfer();
+  if (!transfer) return {};
+  // The FD is revalidated before constructing the private selected object; no
+  // public status/snapshot/JSON descriptor can manufacture this ownership.
+  int descriptor = transfer->DuplicateRevalidatedDirectory();
+  if (descriptor < 0) return {};
+  close(descriptor);
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    auto observation = state->ReapLocked();
+    if (observation.closed || observation.exit_observed_and_reaped || observation.exit_ownership_unknown ||
+        state->peer != peer) return {};
+  }
+  auto selected = std::unique_ptr<SelectedNativeHome>(new SelectedNativeHome(
+      std::make_shared<SelectedNativeHome::State>(state, std::move(transfer))));
+  bool transferred = false;
+  {
+    std::lock_guard<std::mutex> lock(state->mutex);
+    if (!state->observation.closed && !state->observation.selected_home_owner_transferred) {
+      state->observation.selected_home_owner_transferred = true;
+      transferred = true;
+    }
+  }
+  if (!transferred) return {};
+  return selected;
+}
+}  // namespace aux::peer
