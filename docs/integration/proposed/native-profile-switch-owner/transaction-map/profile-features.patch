+
+void ExtensionBrowserWindowHelper::RebindForAuxProfileSwitch(
+    Profile* target_profile) {
+  CHECK(!registry_observation_.IsObserving());
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK_EQ(browser_->GetProfile(), target_profile);
+  auto* tabs = TabListInterface::From(&browser_.get());
+  CHECK(tabs);
+  CHECK_EQ(tabs->GetTabCount(), 0);
+  registry_observation_.Observe(ExtensionRegistry::Get(target_profile));
+}
