 GlicSplitButtonController::~GlicSplitButtonController() = default;
 
+base::ScopedClosureRunner GlicSplitButtonController::EnterAuxProfileCallback() {
+  ++aux_callback_depth_;
+  return base::ScopedClosureRunner(base::BindOnce(
+      [](base::WeakPtr<GlicSplitButtonController> self) {
+        if (self) {
+          --self->aux_callback_depth_;
+        }
+      }, aux_mutation_weak_factory_.GetWeakPtr()));
+}
+
+
+
+bool GlicSplitButtonController::CanPrepareForAuxProfileSwitch() const {
+  if (aux_profile_switch_prepared_ || aux_callback_depth_ || !glic_service_ ||
+      glic_service_->profile() != browser_->GetProfile() ||
+      glic_service_->IsPanelShowingForBrowser(*browser_) ||
+      !glic_button_controller_->CanPrepareForAuxProfileSwitch() ||
+      !static_cast<GlicNudgeControllerImpl*>(glic_nudge_controller_.get())
+           ->CanPrepareForAuxProfileSwitch() ||
+      (glic_actor_nudge_controller_ &&
+       !glic_actor_nudge_controller_->CanPrepareForAuxProfileSwitch()) ||
+      (actor_task_list_bubble_controller_ &&
+       !actor_task_list_bubble_controller_->CanPrepareForAuxProfileSwitch())) {
+    return false;
+  }
+  for (auto* delegate : {horizontal_tabs_delegate_.get(),
+                         vertical_tabs_delegate_.get()}) {
+    if (delegate && (!delegate->CanRebindActorBubbleForAuxProfileSwitch() ||
+                     delegate->GetIsShowingGlicNudge() ||
+                     delegate->GetIsShowingGlicActorTaskIconNudge() ||
+                     delegate->IsActorTaskListBubbleShowing())) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void GlicSplitButtonController::PrepareForAuxProfileSwitch() {
+  CHECK(CanPrepareForAuxProfileSwitch());
+  aux_source_profile_ = browser_->GetProfile();
+  aux_profile_switch_prepared_ = true;
+  glic_button_controller_->PrepareForAuxProfileSwitch();
+  static_cast<GlicNudgeControllerImpl*>(glic_nudge_controller_.get())
+      ->PrepareForAuxProfileSwitch();
+  if (glic_actor_nudge_controller_) {
+    glic_actor_nudge_controller_->PrepareForAuxProfileSwitch();
+  }
+  if (actor_task_list_bubble_controller_) {
+    actor_task_list_bubble_controller_->PrepareForAuxProfileSwitch();
+  }
+}
+
+void GlicSplitButtonController::RebindForAuxProfileSwitch(
+    GlicKeyedService& service) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK_EQ(service.profile(), browser_->GetProfile());
+  glic_service_ = &service;
+  glic_button_controller_->RebindForAuxProfileSwitch(service);
+  if (glic_actor_nudge_controller_) {
+    glic_actor_nudge_controller_->RebindForAuxProfileSwitch(service.profile());
+  }
+  if (actor_task_list_bubble_controller_) {
+    actor_task_list_bubble_controller_->RebindForAuxProfileSwitch(service.profile());
+  }
+  auto leave = EnterAuxProfileCallback();
+  auto weak = aux_mutation_weak_factory_.GetWeakPtr();
+  if (horizontal_tabs_delegate_) {
+    CHECK(horizontal_tabs_delegate_->CanRebindActorBubbleForAuxProfileSwitch());
+    horizontal_tabs_delegate_->RebindActorBubbleForAuxProfileSwitch(service.profile());
+  }
+  if (weak && vertical_tabs_delegate_) {
+    CHECK(vertical_tabs_delegate_->CanRebindActorBubbleForAuxProfileSwitch());
+    vertical_tabs_delegate_->RebindActorBubbleForAuxProfileSwitch(service.profile());
+  }
+}
+
+void GlicSplitButtonController::FinishForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK_EQ(glic_service_->profile(), browser_->GetProfile());
+  aux_profile_switch_prepared_ = false;
+  aux_source_profile_ = nullptr;
+  auto leave = EnterAuxProfileCallback();
+  auto weak = aux_mutation_weak_factory_.GetWeakPtr();
+  static_cast<GlicNudgeControllerImpl*>(glic_nudge_controller_.get())
+      ->FinishForAuxProfileSwitch();
+  if (actor_task_list_bubble_controller_) {
+    actor_task_list_bubble_controller_->FinishForAuxProfileSwitch();
+  }
+  if (weak && glic_actor_nudge_controller_) {
+    glic_actor_nudge_controller_->FinishForAuxProfileSwitch();
+  }
+  if (weak) {
+    glic_button_controller_->FinishForAuxProfileSwitch();
+  }
+}
+
+void GlicSplitButtonController::AbortForAuxProfileSwitch(Profile* source) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK_EQ(aux_source_profile_, source);
+  CHECK_EQ(source, browser_->GetProfile());
+  CHECK_EQ(glic_service_->profile(), source);
+  aux_profile_switch_prepared_ = false;
+  aux_source_profile_ = nullptr;
+  auto leave = EnterAuxProfileCallback();
+  auto weak = aux_mutation_weak_factory_.GetWeakPtr();
+  static_cast<GlicNudgeControllerImpl*>(glic_nudge_controller_.get())
+      ->FinishForAuxProfileSwitch();
+  if (actor_task_list_bubble_controller_) {
+    actor_task_list_bubble_controller_->AbortForAuxProfileSwitch(source);
+  }
+  if (weak && glic_actor_nudge_controller_) {
+    glic_actor_nudge_controller_->AbortForAuxProfileSwitch(source);
+  }
+  if (weak) {
+    glic_button_controller_->AbortForAuxProfileSwitch(source);
+  }
+}
