 SessionServiceBrowserHelper::~SessionServiceBrowserHelper() = default;
 
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+uint64_t SessionServiceBrowserHelper::BeginAuxProfileSwitch() {
+  CHECK_EQ(browser_type_, BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(profile_->IsRegularProfile());
+  CHECK_EQ(tab_strip_model_->profile(), &*profile_);
+  aux_profile_switch_paused_ = true;
+  return ++aux_profile_switch_generation_;
+}
+
+void SessionServiceBrowserHelper::RebindAuxProfileSwitch(
+    Profile* target_profile) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK(tab_strip_model_->empty());
+  CHECK_EQ(tab_strip_model_->profile(), target_profile);
+  profile_ = *target_profile;
+}
+
+void SessionServiceBrowserHelper::EndAuxProfileSwitch(uint64_t generation) {
+  if (generation != aux_profile_switch_generation_) {
+    return;
+  }
+  CHECK(aux_profile_switch_paused_);
+  CHECK_EQ(tab_strip_model_->profile(), &*profile_);
+  for (int index = 0; index < tab_strip_model_->count(); ++index) {
+    CHECK_EQ(tab_strip_model_->GetWebContentsAt(index)->GetBrowserContext(),
+             &*profile_);
+  }
+  aux_profile_switch_paused_ = false;
+  // The original generation-bound 500ms rebuild persists both affected actual
+  // workspaces. Do not create a service or write intermediate detach events.
+}
+#endif
