 AiModePageActionController::~AiModePageActionController() = default;
 
+void AiModePageActionController::LeaveAuxCallback() {
+  CHECK(aux_callback_depth_ > 0);
+  --aux_callback_depth_;
+}
+
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+bool AiModePageActionController::CanRetireForAuxProfileSwitch() const {
+  auto* controller = location_bar_->GetOmniboxController();
+  return !aux_profile_switch_prepared_ && !aux_callback_depth_ &&
+         From(&bwi_.get()) == this &&
+         bwi_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         profile_->IsRegularProfile() &&
+         bwi_->GetProfile() == &profile_.get() && controller &&
+         omnibox_edit_model_observation_.IsObserving() &&
+         omnibox_edit_model_observation_.GetSource() == controller->edit_model();
+}
+
+void AiModePageActionController::PrepareForAuxProfileSwitch() {
+  CHECK(CanRetireForAuxProfileSwitch());
+  aux_profile_switch_prepared_ = true;
+  omnibox_edit_model_observation_.Reset();
+  pref_change_registrar_.Reset();
+  ai_mode_config_subscription_ = {};
+  // Original boundaries cancel only transient old-profile UI callback work.
+  // Do not hide the per-tab action, log a fake icon result or cancel a request
+  // through a different profile's service.
+  favicon_fetch_weak_factory_.InvalidateWeakPtrs();
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+std::unique_ptr<AiModePageActionController>
+AiModePageActionController::CreatePreparedForAuxProfileSwitch(
+    BrowserWindowInterface& bwi,
+    Profile& profile,
+    LocationBar& location_bar) {
+  CHECK_EQ(bwi.GetProfile(), &profile);
+  CHECK(profile.IsRegularProfile());
+  CHECK(AiModeButtonServiceFactory::GetForProfile(&profile));
+  // RegisterOnConfigChanged runs immediately. This constructor explicitly
+  // defers that UI update until the private owner is assigned and tabs settle.
+  return std::unique_ptr<AiModePageActionController>(
+      new AiModePageActionController(bwi, profile, location_bar, true));
+}
+
+void AiModePageActionController::FinishForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(!aux_callback_depth_);
+  CHECK_EQ(From(&bwi_.get()), this);
+  CHECK_EQ(bwi_->GetProfile(), &profile_.get());
+  CHECK_EQ(bwi_->GetTabStripModel()->profile(), &profile_.get());
+  CHECK(AiModeButtonServiceFactory::GetForProfile(&profile_.get()));
+  auto* controller = location_bar_->GetOmniboxController();
+  CHECK(controller);
+  CHECK(omnibox_edit_model_observation_.IsObserving());
+  CHECK_EQ(omnibox_edit_model_observation_.GetSource(), controller->edit_model());
+  aux_profile_switch_prepared_ = false;
+  // Last operation: actual UI observers may destroy this private owner/window.
+  UpdatePageAction();
+}
+#endif
