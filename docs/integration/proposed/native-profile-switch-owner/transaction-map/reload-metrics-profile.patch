 ReloadButton::~ReloadButton() = default;
 
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+bool ReloadButton::CanRebindForAuxProfileSwitch() const {
+  return !IsMenuShowing();
+}
+
+void ReloadButton::RebindForAuxProfileSwitch(Profile* target_profile) {
+  CHECK(CanRebindForAuxProfileSwitch());
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  // The recorder caches a Profile-keyed service and the last source input.
+  // Retire that pair rather than attributing an old input to the new profile.
+  // Construction binds the real target service; no input or metric is emitted.
+  metrics_recorder_ = std::make_unique<WaapUIMetricsRecorder>(target_profile);
+}
+#endif
+
 bool ReloadButton::GetDoubleClickTimerIsRunning() const {
