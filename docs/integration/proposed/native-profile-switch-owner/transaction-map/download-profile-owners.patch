 DownloadToolbarUIController::~DownloadToolbarUIController() = default;
 
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+bool DownloadToolbarUIController::CanRebindForAuxProfileSwitch() const {
+  if (aux_profile_switch_prepared_ || aux_callback_depth_ || !browser_view_ ||
+      !controller_ || !bubble_controller_ || pending_bubble_ || bubble_delegate_ ||
+      bubble_contents_ || bubble_closer_ || immersive_revealed_lock_ ||
+      has_pending_download_started_animation_) {
+    return false;
+  }
+  auto* browser = browser_view_->browser();
+  if (From(browser) != this ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !browser->GetProfile()->IsRegularProfile()) {
+    return false;
+  }
+  if (auto* button = GetDownloadsButton(browser_view_);
+      button && button->IsMenuShowing()) {
+    return false;
+  }
+  auto no_widgets = [](const auto& widgets) {
+    return std::ranges::none_of(widgets,
+                                [](const auto& widget) { return !!widget; });
+  };
+  return no_widgets(aux_live_bubble_widgets_) &&
+         no_widgets(aux_live_animation_widgets_);
+}
+
+void DownloadToolbarUIController::PrepareForAuxProfileSwitch() {
+  CHECK(CanRebindForAuxProfileSwitch());
+  aux_profile_switch_prepared_ = true;
+  weak_factory_.InvalidateWeakPtrs();
+  auto_close_bubble_timer_.Stop();
+  browser_collection_observation_.Reset();
+  // These private owners have paired lifetimes. Their destructors retire
+  // timers, fullscreen/power observations, old-profile watchers and weak tasks.
+  // No active view may hold their weak navigation/model handles at this point.
+  controller_.reset();
+  bubble_controller_.reset();
+  action_item_ = nullptr;
+  pending_security_content_.reset();
+  button_click_time_ = base::TimeTicks();
+}
+
+void DownloadToolbarUIController::RebindForAuxProfileSwitch(
+    Profile* target_profile) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  auto* browser = browser_view_->browser();
+  CHECK_EQ(browser->GetProfile(), target_profile);
+  CHECK_EQ(From(browser), this);
+  CHECK(browser->GetTabStripModel()->empty());
+  CHECK(!controller_);
+  CHECK(!bubble_controller_);
+  base::AutoReset<bool> rebinding(&aux_profile_switch_rebinding_, true);
+
+  action_item_ = actions::ActionManager::Get().FindAction(
+      kActionShowDownloads, BrowserActions::From(browser)->root_action_item());
+  CHECK(action_item_);
+  action_item_->SetTooltipText(tooltip_texts_.at(0));
+  primary_view_mode_ = DownloadBubbleMode::kComplete;
+  is_dormant_ = false;
+  state_ = IconState::kComplete;
+  active_ = IconActive::kInactive;
+  progress_info_ = ProgressInfo();
+  redraw_progress_soon_ = false;
+  has_pending_download_started_animation_ = false;
+  aux_live_bubble_widgets_.clear();
+  aux_live_animation_widgets_.clear();
+
+  // The existing constructors read real target update/offline services and
+  // initialize display state from their genuine current download information.
+  bubble_controller_ = std::make_unique<DownloadBubbleUIController>(browser);
+  controller_ = std::make_unique<DownloadDisplayController>(
+      this, browser, bubble_controller_.get());
+  controller_->ListenToFullScreenChanges();
+  browser_collection_observation_.Observe(
+      ProfileBrowserCollection::GetForProfile(target_profile));
+  UpdateIconDormant();
+  UpdateIcon();
+  aux_profile_switch_prepared_ = false;
+}
+#endif
+
