+bool GlicIphController::CanPrepareForAuxProfileSwitch() const {
+  if (aux_profile_switch_prepared_ || aux_callback_depth_ ||
+      aux_pending_promo_results_ || glic_service_->profile() != window_->GetProfile()) {
+    return false;
+  }
+  auto* education = BrowserUserEducationInterface::From(&*window_);
+  if (!education) {
+    return false;
+  }
+  for (const auto* feature : {&feature_engagement::kIPHGlicTryItFeature,
+                             &feature_engagement::kIPHGlicPromoFeature}) {
+    if (education->IsFeaturePromoQueued(*feature) ||
+        education->IsFeaturePromoActive(*feature)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void GlicIphController::PrepareForAuxProfileSwitch() {
+  CHECK(CanPrepareForAuxProfileSwitch());
+  aux_source_profile_ = window_->GetProfile();
+  aux_profile_switch_prepared_ = true;
+  // Keep the physical window's existing timer and cadence, including the
+  // genuine blocked-this-instance stopped state. A tick during prepare is
+  // ignored; neither a new timer episode nor a promo result is synthesized.
+}
+
+void GlicIphController::RebindForAuxProfileSwitch(GlicKeyedService& service) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK_EQ(service.profile(), window_->GetProfile());
+  CHECK_EQ(aux_pending_promo_results_, 0);
+  glic_service_ = service;
+}
+
+void GlicIphController::FinishAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK_EQ(glic_service_->profile(), window_->GetProfile());
+  aux_profile_switch_prepared_ = false;
+  aux_source_profile_ = nullptr;
+}
+
+void GlicIphController::AbortAuxProfileSwitch() {
+  // The owner only aborts before identity commit, after source tabs return.
+  CHECK_EQ(aux_source_profile_, window_->GetProfile());
+  FinishAuxProfileSwitch();
+}
