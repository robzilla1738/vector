+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+bool LensOverlayEntryPointController::CanRebindForAuxProfileSwitch() const {
+  if (aux_profile_switch_prepared_ || !browser_window_interface_ ||
+      From(browser_window_interface_) != this ||
+      browser_window_interface_->GetType() !=
+          BrowserWindowInterface::TYPE_NORMAL ||
+      !browser_window_interface_->GetProfile()->IsRegularProfile()) {
+    return false;
+  }
+  auto* model = browser_window_interface_->GetTabStripModel();
+  if (!model) {
+    return false;
+  }
+  // Tab-owned overlays/results carry real transient WebUI/capture state. Do
+  // not force-close them or pretend they were migrated by an entry-point hook.
+  for (int index = 0; index < model->count(); ++index) {
+    auto* search = LensSearchController::From(model->GetTabAtIndex(index));
+    if (search && !search->IsOff()) {
+      return false;
+    }
+  }
+  auto* region = LensRegionSearchController::From(browser_window_interface_);
+  return !region || region->CanReleaseForAuxProfileSwitch();
+}
+
+void LensOverlayEntryPointController::PrepareForAuxProfileSwitch() {
+  CHECK(CanRebindForAuxProfileSwitch());
+  aux_was_initialized_ = !!fullscreen_subscription_;
+  aux_location_bar_ = location_bar_observation_.GetSource();
+  aux_profile_switch_prepared_ = true;
+  location_bar_observation_.Reset();
+  fullscreen_subscription_ = {};
+  template_url_service_observation_.Reset();
+  pref_change_registrar_.Reset();
+  optimization_guide_decider_ = nullptr;
+}
+
+void LensOverlayEntryPointController::RebindForAuxProfileSwitch(
+    Profile* target_profile) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK_EQ(browser_window_interface_->GetProfile(), target_profile);
+  CHECK_EQ(From(browser_window_interface_), this);
+  CHECK(browser_window_interface_->GetTabStripModel()->empty());
+  aux_profile_switch_prepared_ = false;
+  if (aux_was_initialized_) {
+    CHECK(command_updater_);
+    // The owner retains/rebinds the same real location bar and command updater.
+    // Existing initialization gets actual target prefs/DSE/optimization service
+    // and subscribes to the real current window fullscreen controller.
+    Initialize(browser_window_interface_, command_updater_, aux_location_bar_);
+  }
+  aux_location_bar_ = nullptr;
+  aux_was_initialized_ = false;
+}
+#endif
 
