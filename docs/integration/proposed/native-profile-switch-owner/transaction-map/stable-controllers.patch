+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+void BrowserWindowThemeObserver::RebindForAuxProfileSwitch(
+    BrowserWindowInterface* browser) {
+  CHECK(browser);
+  CHECK_EQ(From(browser), this);
+  CHECK_EQ(browser->GetType(), BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(browser->GetProfile()->IsRegularProfile());
+  theme_service_observation_.Reset();
+  theme_service_observation_.Observe(
+      ThemeServiceFactory::GetForProfile(browser->GetProfile()));
+  // Existing BrowserView theme subscribers survive and read the real new
+  // profile. Invoke only after the model/controllers are coherent again.
+  OnThemeChanged();
+}
+#endif
