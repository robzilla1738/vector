+bool SkillsUiWindowController::CanRebindForAuxProfileSwitch() const {
+  if (aux_profile_switch_prepared_ || aux_callback_depth_ ||
+      !pending_deletions_.empty() || !skills_v2_delete_callbacks_.empty() ||
+      From(browser_window_interface_) != this ||
+      browser_window_interface_->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !browser_window_interface_->GetProfile()->IsRegularProfile()) {
+    return false;
+  }
+  if (auto* toast = ToastController::From(browser_window_interface_);
+      toast && toast->HasPendingToastWork()) {
+    return false;
+  }
+  auto* model = browser_window_interface_->GetTabStripModel();
+  if (!model) {
+    return false;
+  }
+  for (int i = 0; i < model->count(); ++i) {
+    if (auto* controller = SkillsUiTabControllerInterface::From(
+            model->GetTabAtIndex(i));
+        controller && controller->IsShowing()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void SkillsUiWindowController::PrepareForAuxProfileSwitch() {
+  CHECK(CanRebindForAuxProfileSwitch());
+  aux_switch_source_profile_ = browser_window_interface_->GetProfile();
+  aux_profile_switch_prepared_ = true;
+  identity_manager_observation_.Reset();
+  pref_registrar_.Reset();
+  // Cold boundary proves no live toast/deletion callback is being discarded.
+  // Only this controller's now-detached pref/identity private tasks are retired.
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+void SkillsUiWindowController::RebindForAuxProfileSwitch(Profile* target_profile) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(aux_switch_source_profile_);
+  CHECK(!aux_callback_depth_);
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK_EQ(browser_window_interface_->GetProfile(), target_profile);
+  CHECK(browser_window_interface_->GetTabStripModel()->empty());
+  CHECK(pending_deletions_.empty());
+  CHECK(skills_v2_delete_callbacks_.empty());
+  // These are UI action metadata, not saved Skill objects. A source toast must
+  // never later invoke/delete a same-ID object through target profile services.
+  last_saved_skill_id_.clear();
+  last_saved_skill_name_.clear();
+  last_saved_skill_icon_.clear();
+  last_deleted_skill_id_.clear();
+  action_clicked_ = false;
+  BindProfileSources(target_profile);
+  aux_switch_source_profile_ = nullptr;
+  aux_profile_switch_prepared_ = false;
+}
+
+void SkillsUiWindowController::AbortForAuxProfileSwitch(Profile* source_profile) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(!aux_callback_depth_);
+  CHECK(aux_switch_source_profile_);
+  CHECK_EQ(source_profile, aux_switch_source_profile_);
+  CHECK_EQ(browser_window_interface_->GetProfile(), source_profile);
+  CHECK(pending_deletions_.empty());
+  CHECK(skills_v2_delete_callbacks_.empty());
+  auto* model = browser_window_interface_->GetTabStripModel();
+  CHECK(model);
+  for (int i = 0; i < model->count(); ++i) {
+    CHECK_EQ(model->GetWebContentsAt(i)->GetBrowserContext(), source_profile);
+  }
+  // Real source action metadata survives a failed pre-identity transfer.
+  BindProfileSources(source_profile);
+  aux_switch_source_profile_ = nullptr;
+  aux_profile_switch_prepared_ = false;
+}
