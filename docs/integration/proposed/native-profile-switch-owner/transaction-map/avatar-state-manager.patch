+bool AvatarToolbarButtonStateManager::CanRebindForAuxProfileSwitch() const {
+  auto* menu = ProfileMenuCoordinator::From(browser_);
+  return !aux_profile_switch_prepared_ && !is_updating_ && !is_initializing_ &&
+         browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         profile_->IsRegularProfile() && &profile_.get() == browser_->GetProfile() &&
+         !HasExplicitButtonState() && (!menu || !menu->IsShowing());
+}
+
+void AvatarToolbarButtonStateManager::PrepareForAuxProfileSwitch() {
+  CHECK(CanRebindForAuxProfileSwitch());
+  CHECK(states_.contains(ButtonState::kNormal));
+  aux_profile_switch_prepared_ = true;
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  scoped_identity_manager_observation_.Reset();
+  profile_observation_.Reset();
+  subscription_service_observation_.Reset();
+  gaia_id_for_signin_choice_remembered_ = GaiaId();
+
+  // Remove only old-profile coordinators/reporters, not outside observers.
+  std::erase_if(state_manager_observers_, [this](const auto& observer) {
+    return std::ranges::any_of(profile_state_manager_observers_,
+                              [&observer](const auto& profile_observer) {
+      return &observer.get() == &profile_observer.get();
+    });
+  });
+  profile_state_manager_observers_.clear();
+  base::AutoReset<bool> initializing_reset(&is_initializing_, true);
+  // Keep the existing real NormalStateProvider during the synchronous cold
+  // interval so view/animation getters remain valid. It has no subscriptions.
+  // All profile-observing providers and their timers/weak callbacks are retired.
+  auto normal = std::move(states_.at(ButtonState::kNormal));
+  current_active_state_pair_ = nullptr;
+  states_.clear();
+  states_.emplace(ButtonState::kNormal, std::move(normal));
+  current_active_state_pair_ = &*states_.find(ButtonState::kNormal);
+  was_update_requested_ = false;
+}
+
+void AvatarToolbarButtonStateManager::RebindForAuxProfileSwitch(
+    Profile* target_profile) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK_EQ(browser_->GetProfile(), target_profile);
+  CHECK(!scoped_identity_manager_observation_.IsObserving());
+  CHECK(!profile_observation_.IsObserving());
+  CHECK(!subscription_service_observation_.IsObserving());
+  current_active_state_pair_ = nullptr;
+  states_.clear();
+  profile_ = raw_ref<Profile>(*target_profile);
+  aux_profile_switch_prepared_ = false;
+  // Existing factory and initialization order bind actual target identity,
+  // sync, signin, passkeys, management, preferences and subscription services.
+  InitializeStates();
+  UpdateAvatarButton();
+}
