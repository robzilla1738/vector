+bool MostRecentSharedTabUpdateStore::CanBeginAuxProfileSwitch() const {
+  if (aux_profile_switch_paused_ || aux_callback_depth_ ||
+      From(browser_window_) != this ||
+      browser_window_->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !browser_window_->GetProfile()->IsRegularProfile()) {
+    return false;
+  }
+  auto* model = browser_window_->GetTabStripModel();
+  if (!model || !model->SupportsTabGroups() ||
+      model->profile() != browser_window_->GetProfile() ||
+      !TabGroupSyncServiceFactory::GetForProfile(browser_window_->GetProfile())) {
+    return false;
+  }
+  auto* education = BrowserUserEducationInterface::From(browser_window_);
+  const auto& feature = feature_engagement::kIPHTabGroupsSharedTabChangedFeature;
+  return !education || (!education->IsFeaturePromoQueued(feature) &&
+                         !education->IsFeaturePromoActive(feature));
+}
+
 uint64_t MostRecentSharedTabUpdateStore::BeginAuxProfileSwitch() {
+  CHECK(CanBeginAuxProfileSwitch());
+  aux_switch_source_profile_ = browser_window_->GetProfile();
+  aux_profile_switch_committed_ = false;
   CHECK_EQ(browser_window_->GetType(), BrowserWindowInterface::TYPE_NORMAL);
   CHECK(browser_window_->GetProfile()->IsRegularProfile());
   aux_profile_switch_paused_ = true;
