+  CHECK_EQ(browser_window_->GetProfile(), target_profile);
+  auto* model = browser_window_->GetTabStripModel();
+  CHECK(model->empty());
+  CHECK(model->SupportsTabGroups());
+  CHECK_EQ(model->profile(), target_profile);
+  CHECK(TabGroupSyncServiceFactory::GetForProfile(target_profile));
   last_updated_tab_.reset();
