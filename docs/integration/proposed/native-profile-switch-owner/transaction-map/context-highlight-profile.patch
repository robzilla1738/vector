+bool ContextHighlightWindowFeature::CanPauseForAuxProfileSwitch() const {
+  return !aux_profile_switch_prepared_ && !aux_update_depth_ &&
+         From(browser_) == this &&
+         browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         browser_->GetProfile()->IsRegularProfile();
+}
+
+void ContextHighlightWindowFeature::PrepareForAuxProfileSwitch() {
+  CHECK(CanPauseForAuxProfileSwitch());
+  aux_profile_switch_prepared_ = true;
+  // Keep the actual tab renderer observations and shared window overlay alive.
+  // Only hide the stale source geometry during collection transfer.
+  if (context_highlight_view_tracker_.view()) {
+    auto* host = BrowserElementsViews::From(browser_)->GetView(
+        kContextHighlightViewElementId);
+    CHECK(host);
+    host->SetVisible(false);
+  }
+}
+
+void ContextHighlightWindowFeature::FinishForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(!aux_update_depth_);
+  CHECK(From(browser_) == this);
