+bool GlicButtonController::CanPrepareForAuxProfileSwitch() const {
+  return !aux_profile_switch_prepared_ && !aux_callback_depth_ &&
+         From(&browser_.get()) == this &&
+         browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         profile_ && profile_->IsRegularProfile() &&
+         browser_->GetProfile() == profile_ &&
+         GlicSplitButtonController::From(&browser_.get()) == split_button_controller_ &&
+         browser_->GetTabStripModel()->profile() == profile_ &&
+         glic_keyed_service_ && glic_keyed_service_->profile() == profile_ &&
+         glic_keyed_service_ == GlicKeyedService::Get(profile_) &&
+         pref_registrar_.prefs() == profile_->GetPrefs() &&
+         subscriptions_.size() == 2 &&
+         !glic_keyed_service_->IsPanelShowingForBrowser(*browser_);
+}
+
+void GlicButtonController::PrepareForAuxProfileSwitch() {
+  CHECK(CanPrepareForAuxProfileSwitch());
+  aux_source_profile_ = profile_->GetWeakPtr();
+  aux_source_service_ = glic_keyed_service_->GetWeakPtr();
+  aux_profile_switch_prepared_ = true;
+  aux_profile_switch_rebound_ = false;
+  pref_registrar_.Reset();
+  subscriptions_.clear();
+}
+
+void GlicButtonController::RebindForAuxProfileSwitch(GlicKeyedService& service) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(!aux_profile_switch_rebound_);
+  CHECK(!aux_callback_depth_);
+  CHECK(service.profile());
+  CHECK(service.profile()->IsRegularProfile());
+  CHECK_EQ(browser_->GetProfile(), service.profile());
+  CHECK_EQ(GlicKeyedService::Get(service.profile()), &service);
+  CHECK_EQ(browser_->GetTabStripModel()->profile(), service.profile());
+  CHECK(browser_->GetTabStripModel()->empty());
+  CHECK(!pref_registrar_.prefs());
+  CHECK(subscriptions_.empty());
+  profile_ = service.profile();
+  glic_keyed_service_ = &service;
+  BindAuxProfileSources();
+  aux_profile_switch_rebound_ = true;
+}
+
+void GlicButtonController::FinishForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(aux_profile_switch_rebound_);
+  CHECK(!aux_callback_depth_);
+  CHECK_EQ(browser_->GetProfile(), profile_);
+  CHECK_EQ(glic_keyed_service_->profile(), profile_);
+  CHECK_EQ(pref_registrar_.prefs(), profile_->GetPrefs());
+  aux_profile_switch_prepared_ = false;
+  aux_profile_switch_rebound_ = false;
+  aux_source_profile_.reset();
+  aux_source_service_.reset();
+  // Last effect: the unchanged delegate update may close this real window.
+  UpdateButton();
+}
+
+void GlicButtonController::AbortForAuxProfileSwitch(Profile* source_profile) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(!aux_profile_switch_rebound_);
+  CHECK(!aux_callback_depth_);
+  CHECK(aux_source_profile_);
+  CHECK(aux_source_service_);
+  CHECK_EQ(source_profile, aux_source_profile_.get());
+  CHECK_EQ(profile_, source_profile);
+  CHECK_EQ(glic_keyed_service_, aux_source_service_.get());
+  CHECK_EQ(GlicKeyedService::Get(source_profile), glic_keyed_service_);
+  CHECK_EQ(browser_->GetProfile(), source_profile);
+  auto* model = browser_->GetTabStripModel();
+  CHECK_EQ(model->profile(), source_profile);
+  for (int index = 0; index < model->count(); ++index) {
+    CHECK_EQ(model->GetWebContentsAt(index)->GetBrowserContext(), source_profile);
+  }
+  CHECK(!pref_registrar_.prefs());
+  CHECK(subscriptions_.empty());
+  BindAuxProfileSources();
+  aux_profile_switch_prepared_ = false;
+  aux_source_profile_.reset();
+  aux_source_service_.reset();
+  // Preserve source services and apply their genuine current state only.
+  UpdateButton();
+}
+
+base::ScopedClosureRunner GlicButtonController::EnterAuxCallback() {
+  ++aux_callback_depth_;
+  return base::ScopedClosureRunner(base::BindOnce(
+      &GlicButtonController::LeaveAuxCallback, weak_ptr_factory_.GetWeakPtr()));
+}
+
+void GlicButtonController::LeaveAuxCallback() {
+  CHECK_GT(aux_callback_depth_, 0);
+  --aux_callback_depth_;
+}
