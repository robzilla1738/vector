+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+bool BrowserTabMenuModelDelegate::CanRebindForAuxProfileSwitch(
+    BrowserWindowInterface* browser) const {
+  if (!browser || TabMenuModelDelegate::From(browser) != this ||
+      browser->GetSessionID() != session_id_ || app_controller_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !profile_ || !profile_->IsRegularProfile() ||
+      !browser->GetProfile()->IsRegularProfile()) {
+    return false;
+  }
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser);
+  // Query only this actual window's showing Views menu, not unrelated windows.
+  return view && view->GetWidget() &&
+         !views::MenuController::GetForOwnerWidget(view->GetWidget());
+}
+
+void BrowserTabMenuModelDelegate::RebindForAuxProfileSwitch(
+    BrowserWindowInterface* browser,
+    Profile* target_profile) {
+  CHECK(CanRebindForAuxProfileSwitch(browser));
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK_EQ(browser->GetProfile(), target_profile);
+  CHECK(browser->GetTabStripModel());
+  CHECK(browser->GetTabStripModel()->empty());
+  profile_ = target_profile;
+  tab_group_sync_service_ =
+      tab_groups::TabGroupSyncServiceFactory::GetForProfile(target_profile);
+}
+#endif
 
