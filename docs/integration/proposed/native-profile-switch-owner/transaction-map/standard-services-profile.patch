+  CHECK_EQ(browser_->GetProfile(), target_profile);
+  CHECK_EQ(From(&browser_.get()), this);
+  CHECK_EQ(browser_->GetTabStripModel(), &tab_strip_model_.get());
+  CHECK(tab_strip_model_->empty());
+  // Only an unused error handler of an already-closed real flow may remain.
+  // Retire it without inventing an error, success or cancellation callback.
+  on_error_callback_.Reset();
+  aux_error_callback_belongs_to_closed_flow_ = false;
+  aux_retiring_widgets_.clear();
+  profile_ = raw_ref<Profile>(*target_profile);
