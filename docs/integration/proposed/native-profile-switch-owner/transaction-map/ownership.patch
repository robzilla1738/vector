+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool BrowserManagerService::TransferForAuxProfileSwitch(
+    BrowserWindowInterface* browser,
+    Profile* target,
+    base::OnceClosure commit_identity) {
+  if (!browser || !target || !commit_identity || browser->IsDeleteScheduled() ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL)
+    return false;
+  Profile* const previous = browser->GetProfile();
+  if (!previous || previous == target || !previous->IsRegularProfile() ||
+      !target->IsRegularProfile())
+    return false;
+  auto* source = BrowserManagerServiceFactory::GetForProfile(previous);
+  auto* destination = BrowserManagerServiceFactory::GetForProfile(target);
+  if (!source || !destination || source == destination ||
+      !source->browsers_and_subscriptions_for_testing_.empty() ||
+      !destination->browsers_and_subscriptions_for_testing_.empty())
+    return false;
+  auto position =
+      std::ranges::find_if(source->browsers_and_subscriptions_,
+                           [browser](const BrowserAndSubscriptions& entry) {
+                             return entry.browser.get() == browser;
+                           });
+  if (position == source->browsers_and_subscriptions_.end() ||
+      std::ranges::any_of(destination->browsers_and_subscriptions_,
+                          [browser](const BrowserAndSubscriptions& entry) {
+                            return entry.browser.get() == browser;
+                          }))
+    return false;
+
+  // Reserve before extracting ownership. No observer runs until identity,
+  // ownership, subscriptions and both collection lists are coherent again.
+  destination->browsers_and_subscriptions_.reserve(
+      destination->browsers_and_subscriptions_.size() + 1);
+  destination->browsers_activation_order_.reserve(
+      destination->browsers_activation_order_.size() + 1);
+  ScopedProfileKeepAlive source_keep_alive(
+      previous, ProfileKeepAliveOrigin::kBrowserWindow);
+  ScopedProfileKeepAlive target_keep_alive(
+      target, ProfileKeepAliveOrigin::kBrowserWindow);
+  BrowserAndSubscriptions moved = std::move(*position);
+  source->browsers_and_subscriptions_.erase(position);
+  std::erase(source->browsers_activation_order_, browser);
+  moved.activated_subscription = {};
+  moved.deactivated_subscription = {};
+  moved.closed_subscription = {};
+  std::move(commit_identity).Run();
+  CHECK_EQ(browser->GetProfile(), target);
+  CHECK(!browser->IsDeleteScheduled());
+
+  destination->browsers_and_subscriptions_.push_back(BrowserAndSubscriptions(
+      std::move(moved.browser),
+      browser->RegisterDidBecomeActive(
+          base::BindRepeating(&BrowserManagerService::OnBrowserActivated,
+                              base::Unretained(destination))),
+      browser->RegisterDidBecomeInactive(
+          base::BindRepeating(&BrowserManagerService::OnBrowserDeactivated,
+                              base::Unretained(destination))),
+      browser->RegisterBrowserDidClose(
+          base::BindRepeating(&BrowserManagerService::OnBrowserClosed,
+                              base::Unretained(destination)))));
+  // Supplied0456847c appends the existing browser to the destination's
+  // profile activation order without synthesizing a native activation.
+  destination->browsers_activation_order_.push_back(browser);
+  // Supplied04568238/0456847c deliberately do NOT emit collection create,
+  // close, activation or deactivation notifications during transfer. The
+  // same global browser identity/order and window remain alive throughout.
+  return true;
+}
+#endif
 
