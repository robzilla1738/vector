+uint64_t VerticalTabStripStateController::BeginAuxProfileSwitch() {
+  CHECK_EQ(browser_window_->GetType(), BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(browser_window_->GetProfile()->IsRegularProfile());
+  CHECK_EQ(pref_service_, browser_window_->GetProfile()->GetPrefs());
+  CHECK_EQ(browser_window_->GetTabStripModel()->profile(),
+           browser_window_->GetProfile());
+  if (!aux_profile_switch_paused_) {
+    aux_profile_switch_previous_mode_ = is_vertical_tabs_enabled_;
+    aux_profile_switch_previous_hover_ = is_expand_on_hover_enabled_;
+  }
+  aux_profile_switch_paused_ = true;
+  return ++aux_profile_switch_generation_;
+}
+
+void VerticalTabStripStateController::RebindAuxProfileSwitch(
+    SessionService* target_session_service) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK(browser_window_->GetProfile()->IsRegularProfile());
+  CHECK(browser_window_->GetTabStripModel()->empty());
+  CHECK_EQ(browser_window_->GetTabStripModel()->profile(),
+           browser_window_->GetProfile());
+  CHECK(!target_session_service ||
+        target_session_service->profile() == browser_window_->GetProfile());
+  if (session_service_) {
+    session_service_->RemoveObserver(this);
+  }
+  browser_collection_observation_.Reset();
+  session_service_ = target_session_service;
+  pref_change_registrar_.Reset();
+  pref_service_ = browser_window_->GetProfile()->GetPrefs();
+  const bool previous_mode = is_vertical_tabs_enabled_;
+  InitProfilePrefObservers();
+  if (enable_state_lock_count_ > 0) {
+    is_vertical_tabs_enabled_ = previous_mode;
+  }
+  ObserveSessionService();
+  // Preserve state_. The original cache factory forces its own expanded
+  // preview geometry; copying that state or startup prefs into this live
+  // window would incorrectly reset its collapse/width.
+}
+
+void VerticalTabStripStateController::EndAuxProfileSwitch(uint64_t generation) {
+  if (generation != aux_profile_switch_generation_) {
+    return;
+  }
+  CHECK(aux_profile_switch_paused_);
+  CHECK_EQ(pref_service_, browser_window_->GetProfile()->GetPrefs());
+  CHECK_EQ(browser_window_->GetTabStripModel()->profile(),
+           browser_window_->GetProfile());
+  CHECK(!browser_window_->GetTabStripModel()->empty());
+  if (enable_state_lock_count_ == 0) {
+    is_vertical_tabs_enabled_ =
+        pref_service_->GetBoolean(prefs::kVerticalTabsEnabled);
+  }
+  is_expand_on_hover_enabled_ =
+      IsVerticalTabsExpandOnHoverFeatureEnabled() &&
+      pref_service_->GetBoolean(prefs::kVerticalTabsExpandOnHoverEnabled);
+  aux_profile_switch_paused_ = false;
+  if (is_vertical_tabs_enabled_ != aux_profile_switch_previous_mode_) {
+    NotifyModeChanged();
+  }
+  if (is_expand_on_hover_enabled_ != aux_profile_switch_previous_hover_) {
+    NotifyExpandOnHoverEnabledChanged();
+  }
+  UpdateCollapseActionItem();
+  UpdateSessionService();
+  UpdatePrefService();
+}
