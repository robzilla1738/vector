+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+void SidePanelToolbarPinningController::PrepareForAuxProfileSwitch() {
+  CHECK_EQ(browser_->GetType(), BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(browser_->GetProfile()->IsRegularProfile());
+  CHECK(!aux_profile_switch_prepared_);
+  aux_profile_switch_prepared_ = true;
+  pinned_model_observation_.Reset();
+  extensions_model_observation_.Reset();
+}
+
+void SidePanelToolbarPinningController::RebindForAuxProfileSwitch(
+    Profile* target_profile) {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK_EQ(browser_->GetProfile(), target_profile);
+  CHECK(!pinned_model_observation_.IsObserving());
+  CHECK(!extensions_model_observation_.IsObserving());
+  pinned_model_observation_.Observe(
+      PinnedToolbarActionsModel::Get(target_profile));
+  extensions_model_observation_.Observe(ToolbarActionsModel::Get(target_profile));
+  aux_profile_switch_prepared_ = false;
+  // Preserve existing observers (including live side-panel header views) and
+  // let them read the actual target models. Do not set any pin preference.
+  OnActionsChanged();
+}
+#endif
+
 void SidePanelToolbarPinningController::OnActionsChanged() {
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+  if (aux_profile_switch_prepared_) {
+    return;
+  }
+#endif
   pin_state_change_observers_.Notify(&Observer::OnPinStateChanged);
   ReevaluateActiveState();
 }
 
 void SidePanelToolbarPinningController::OnToolbarPinnedActionsChanged() {
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+  if (aux_profile_switch_prepared_) {
+    return;
+  }
+#endif
   pin_state_change_observers_.Notify(&Observer::OnPinStateChanged);
   ReevaluateActiveState();
 }
