+struct SavedTabGroupModelListener::AuxProfileModelTransfer::State {
+  struct Window {
+    base::WeakPtr<BrowserWindowInterface> window;
+    raw_ptr<Profile> source_profile;
+  };
+  struct Group {
+    TabGroupId id;
+    std::vector<tabs::TabHandle> tabs;
+  };
+  struct Listener {
+    base::WeakPtr<SavedTabGroupModelListener> listener;
+    std::vector<Group> groups;
+  };
+  std::vector<Window> windows;
+  std::vector<Listener> listeners;
+  bool finished = false;
+};
+
+bool SavedTabGroupModelListener::CanPrepareAuxProfileModelTransfer(
+    base::span<BrowserWindowInterface* const> windows) {
+  if (windows.empty()) {
+    return false;
+  }
+  base::flat_set<BrowserWindowInterface*> seen;
+  for (auto* window : windows) {
+    if (!window || !seen.insert(window).second ||
+        window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        !window->GetProfile()->IsRegularProfile() ||
+        !IsRegisteredWindowForProfile(window, window->GetProfile())) {
+      return false;
+    }
+    auto* model = window->GetTabStripModel();
+    if (!model || model->profile() != window->GetProfile()) {
+      return false;
+    }
+    auto* service = TabGroupSyncServiceFactory::GetForProfile(model->profile());
+    if (!service) {
+      auto stale = AuxListeners().find(model->profile());
+      if (stale != AuxListeners().end() && stale->second) {
+        return false;
+      }
+      continue;
+    }
+    auto it = AuxListeners().find(model->profile());
+    if (it == AuxListeners().end() || !it->second) {
+      return false;
+    }
+    auto* listener = it->second.get();
+    if (listener->service_ != service || listener->aux_model_transfer_active_ ||
+        listener->aux_callback_depth_ ||
+        !listener->aux_observed_models_.contains(model)) {
+      return false;
+    }
+    if (model->SupportsTabGroups()) {
+      for (auto group : model->group_model()->ListTabGroups()) {
+        auto tracked = listener->local_tab_group_listeners_.find(group);
+        if (tracked == listener->local_tab_group_listeners_.end()) {
+          continue;
+        }
+        if (tracked->second.IsTrackingPaused()) {
+          return false;
+        }
+        auto saved = service->GetGroup(tracked->second.saved_guid());
+        auto tabs = model->GetTabsAtIndices(
+            model->group_model()->GetTabGroup(group)->ListTabs().ToIntVector());
+        if (!saved || saved->saved_tabs().size() != tabs.size()) {
+          return false;
+        }
+        for (auto* tab : tabs) {
+          if (std::ranges::none_of(saved->saved_tabs(), [&](const auto& saved_tab) {
+                return saved_tab.local_tab_id() == tab->GetHandle().raw_value();
+              })) {
+            return false;
+          }
+        }
+      }
+    }
+  }
+  return true;
+}
+
+std::unique_ptr<SavedTabGroupModelListener::AuxProfileModelTransfer>
+SavedTabGroupModelListener::PrepareAuxProfileModelTransfer(
+    base::span<BrowserWindowInterface* const> windows) {
+  if (!CanPrepareAuxProfileModelTransfer(windows)) {
+    return nullptr;
+  }
+  auto state = std::make_unique<AuxProfileModelTransfer::State>();
+  for (auto* window : windows) {
+    auto* model = window->GetTabStripModel();
+    state->windows.push_back({window->GetWeakPtr(), window->GetProfile()});
+    auto found = AuxListeners().find(window->GetProfile());
+    if (found == AuxListeners().end() || !found->second) {
+      CHECK(!TabGroupSyncServiceFactory::GetForProfile(window->GetProfile()));
+      continue;
+    }
+    auto* listener = found->second.get();
+    auto entry = std::ranges::find_if(state->listeners, [&](const auto& item) {
+      return item.listener.get() == listener;
+    });
+    if (entry == state->listeners.end()) {
+      state->listeners.push_back({found->second, {}});
+      entry = std::prev(state->listeners.end());
+      listener->aux_model_transfer_active_ = true;
+    }
+    if (model->SupportsTabGroups()) {
+      for (auto group : model->group_model()->ListTabGroups()) {
+        auto tracked = listener->local_tab_group_listeners_.find(group);
+        if (tracked == listener->local_tab_group_listeners_.end()) {
+          continue;
+        }
+        AuxProfileModelTransfer::State::Group snapshot{group, {}};
+        for (auto* tab : model->GetTabsAtIndices(
+                 model->group_model()->GetTabGroup(group)->ListTabs().ToIntVector())) {
+          snapshot.tabs.push_back(tab->GetHandle());
+        }
+        tracked->second.PauseTracking();
+        entry->groups.push_back(std::move(snapshot));
+      }
+    }
+    // This is the actual per-model subscription, not a BrowserClosed event.
+    model->RemoveObserver(listener);
+    CHECK_EQ(listener->aux_observed_models_.erase(model), 1u);
+  }
+  return std::unique_ptr<AuxProfileModelTransfer>(
+      new AuxProfileModelTransfer(std::move(state)));
+}
+
+SavedTabGroupModelListener::AuxProfileModelTransfer::AuxProfileModelTransfer(
+    std::unique_ptr<State> state) : state_(std::move(state)) {}
+
+SavedTabGroupModelListener::AuxProfileModelTransfer::~AuxProfileModelTransfer() {
+  // The owner must explicitly finish against actual final or restored models.
+  // There is no fake-success destructor rollback with unknown collections.
+  CHECK(state_->finished);
+}
+
+bool SavedTabGroupModelListener::AuxProfileModelTransfer::CanFinish(
+    bool source_rollback) const {
+  if (state_->finished) {
+    return false;
+  }
+  base::flat_set<Profile*> original_profiles;
+  for (const auto& entry : state_->windows) {
+    original_profiles.insert(entry.source_profile);
+  }
+  for (const auto& entry : state_->windows) {
+    auto* window = entry.window.get();
+    if (!window || !original_profiles.contains(window->GetProfile()) ||
+        (source_rollback && window->GetProfile() != entry.source_profile) ||
+        !IsRegisteredWindowForProfile(window, window->GetProfile())) {
+      return false;
+    }
+    auto* model = window->GetTabStripModel();
+    if (!model || model->profile() != window->GetProfile()) {
+      return false;
+    }
+    for (int i = 0; i < model->count(); ++i) {
+      if (model->GetWebContentsAt(i)->GetBrowserContext() != model->profile()) {
+        return false;
+      }
+    }
+    for (const auto& [profile, listener] : AuxListeners()) {
+      if (listener && listener->aux_observed_models_.contains(model)) {
+        return false;
+      }
+    }
+    if (auto* service = TabGroupSyncServiceFactory::GetForProfile(model->profile())) {
+      auto it = AuxListeners().find(model->profile());
+      if (it == AuxListeners().end() || !it->second ||
+          it->second->service_ != service || !it->second->aux_model_transfer_active_) {
+        return false;
+      }
+    }
+  }
+  for (const auto& entry : state_->listeners) {
+    auto* listener = entry.listener.get();
+    if (!listener || !listener->aux_model_transfer_active_ ||
+        listener->aux_callback_depth_) {
+      return false;
+    }
+    for (const auto& group : entry.groups) {
+      auto tracked = listener->local_tab_group_listeners_.find(group.id);
+      if (tracked == listener->local_tab_group_listeners_.end() ||
+          !tracked->second.IsTrackingPaused()) {
+        return false;
+      }
+      TabStripModel* actual_model = nullptr;
+      for (const auto& window : state_->windows) {
+        auto* model = window.window->GetTabStripModel();
+        if (model->profile() == listener->profile_ && model->SupportsTabGroups() &&
+            model->group_model()->ContainsTabGroup(group.id)) {
+          if (actual_model) {
+            return false;
+          }
+          actual_model = model;
+        }
+      }
+      if (!actual_model) {
+        return false;
+      }
+      auto tabs = actual_model->GetTabsAtIndices(
+          actual_model->group_model()->GetTabGroup(group.id)->ListTabs().ToIntVector());
+      if (tabs.size() != group.tabs.size()) {
+        return false;
+      }
+      for (auto* tab : tabs) {
+        if (!std::ranges::contains(group.tabs, tab->GetHandle())) {
+          return false;
+        }
+      }
+    }
+  }
+  return true;
+}
+
+void SavedTabGroupModelListener::AuxProfileModelTransfer::Commit() {
+  Finish(false);
+}
+void SavedTabGroupModelListener::AuxProfileModelTransfer::Abort() {
+  Finish(true);
+}
+void SavedTabGroupModelListener::AuxProfileModelTransfer::Finish(
+    bool source_rollback) {
+  CHECK(CanFinish(source_rollback));
+  for (const auto& entry : state_->windows) {
+    auto* window = entry.window.get();
+    auto found = AuxListeners().find(window->GetProfile());
+    if (found == AuxListeners().end() || !found->second) {
+      CHECK(!TabGroupSyncServiceFactory::GetForProfile(window->GetProfile()));
+      continue;
+    }
+    auto* listener = found->second.get();
+    auto* model = window->GetTabStripModel();
+    CHECK(listener->aux_observed_models_.insert(model).second);
+    model->AddObserver(listener);
+  }
+  for (const auto& entry : state_->listeners) {
+    auto* listener = entry.listener.get();
+    for (const auto& group : entry.groups) {
+      // Existing stock method verifies real saved/local tab identity 1:1.
+      listener->local_tab_group_listeners_.at(group.id).ResumeTracking();
+    }
+    listener->aux_model_transfer_active_ = false;
+  }
+  state_->finished = true;
+}
+#endif
