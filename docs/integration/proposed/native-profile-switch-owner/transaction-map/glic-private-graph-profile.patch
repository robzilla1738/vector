+
+void GlicNudgeControllerImpl::FinishForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  aux_profile_switch_prepared_ = false;
+}
+
+void GlicNudgeControllerImpl::PostAuxNudgeActivity(
+    GlicNudgeActivityCallback callback, GlicNudgeActivity activity) {
+  ++aux_pending_activity_callbacks_;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+          [](base::WeakPtr<GlicNudgeControllerImpl> self,
+             GlicNudgeActivityCallback callback, GlicNudgeActivity activity) {
+            if (self) {
+              --self->aux_pending_activity_callbacks_;
+              auto leave = self->EnterAuxProfileCallback();
+              callback.Run(activity);
+            } else {
+              // Preserve the original independent posted outcome even if its
+              // window controller is destroyed before the callback runs.
+              callback.Run(activity);
+            }
+          }, aux_mutation_weak_factory_.GetWeakPtr(), std::move(callback), activity));
+}
+
 void GlicNudgeControllerImpl::SetNudgeActivityCallbackForTesting() {
   nudge_activity_callback_ = base::DoNothing();
