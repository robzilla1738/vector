+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+void BookmarkBarView::PrepareForAuxProfileSwitch() {
+  CHECK(!aux_profile_switch_prepared_);
+  CHECK_EQ(browser_->GetType(), BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(browser_->GetProfile()->IsRegularProfile());
+  aux_profile_switch_prepared_ = true;
+  aux_profile_switch_previous_enabled_ = GetEnabled();
+  SetEnabled(false);
+  weak_ptr_factory_.InvalidateWeakPtrs();
+  drop_weak_ptr_factory_.InvalidateWeakPtrs();
+  StopShowFolderDropMenuTimer();
+  drop_info_.reset();
+  // Menus can outlive cancellation. Detach their raw View/observer pointers
+  // BEFORE cancelling, while their actual old profile is still retained.
+  if (bookmark_menu_) {
+    BookmarkMenuController* menu = bookmark_menu_;
+    bookmark_menu_ = nullptr;
+    menu->set_observer(nullptr);
+    menu->clear_bookmark_bar();
+    menu->Cancel();
+  }
+  if (bookmark_drop_menu_) {
+    BookmarkMenuController* menu = bookmark_drop_menu_;
+    bookmark_drop_menu_ = nullptr;
+    menu->set_observer(nullptr);
+    menu->clear_bookmark_bar();
+    menu->Cancel();
+  }
+  // This private controller owns old pref/model adapters, async clipboard
+  // checks and its context menu. Destroy those sources before identity moves.
+  controller_.reset();
+  context_menu_highlight_.reset();
+  if (bookmark_service_) {
+    bookmark_service_->RemoveObserver(this);
+    bookmark_service_ = nullptr;
+  }
+  managed_ = nullptr;
+  RemoveAllBookmarkButtons();
+  if (saved_tab_group_bar_) {
+    saved_tab_group_bar_->PrepareForAuxProfileSwitch();
+    saved_tab_group_bar_->SetVisible(false);
+    saved_tab_groups_separator_view_->SetVisible(false);
+  }
+  bookmark_service_loaded_signal_processed_ = false;
+  extensive_bookmarks_changes_ongoing_ = false;
+  needs_layout_update_after_extensive_changes_ = false;
+  managed_bookmarks_pref_visible_ = false;
+  managed_bookmarks_button_->SetText(std::u16string());
+  managed_bookmarks_button_->GetViewAccessibility().SetName(std::u16string());
+  managed_bookmarks_button_->SetVisible(false);
+  managed_bookmarks_button_->SetEnabled(false);
+  all_bookmarks_button_->SetVisible(false);
+  all_bookmarks_button_->SetEnabled(false);
+  overflow_button_->SetVisible(false);
+  UpdateBookmarksSeparatorVisibility();
+  LayoutAndPaint();
+}
+
+void BookmarkBarView::RebindForAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(browser_->GetProfile()->IsRegularProfile());
+  CHECK_EQ(browser_->GetTabStripModel()->profile(), browser_->GetProfile());
+  auto* factory = UIControllerFactory::From(browser_);
+  CHECK(factory);
+  // The existing factory retains only Browser identity; it constructs REAL
+  // target-pref/model/action adapters from the now-authoritative profile.
+  auto controller = factory->CreateBookmarkBarController();
+  CHECK(controller);
+  bookmark_service_ = BookmarkMergedSurfaceServiceFactory::GetForProfile(
+      browser_->GetProfile());
+  managed_ =
+      ManagedBookmarkServiceFactory::GetForProfile(browser_->GetProfile());
+  CHECK(bookmark_service_);
+  CHECK(managed_);
+  if (tab_groups::SavedTabGroupUtils::IsEnabledForProfile(
+          browser_->GetProfile())) {
+    if (saved_tab_group_bar_) {
+      saved_tab_group_bar_->RebindForAuxProfileSwitch();
+    } else {
+      size_t index = GetIndexOf(managed_bookmarks_button_).value() + 1;
+      saved_tab_group_bar_ = AddChildViewAt(
+          std::make_unique<tab_groups::SavedTabGroupBar>(browser_,
+                                                        animations_enabled),
+          index++);
+      saved_tab_groups_separator_view_ =
+          AddChildViewAt(std::make_unique<ButtonSeparatorView>(), index);
+    }
+    saved_tab_group_bar_->SetVisible(
+        chrome::ShouldShowTabGroupsInBookmarkBar(browser_->GetProfile()));
+    saved_tab_groups_separator_view_->SetVisible(true);
+  }
+  // Keep the original static controls and child order. Never call Init again.
+  bookmark_service_->AddObserver(this);
+  if (bookmark_service_->loaded()) {
+    BookmarkMergedSurfaceServiceLoaded();
+  }
+  controller_ = std::move(controller);
+  controller_->Bind(this);
+  aux_profile_switch_prepared_ = false;
+  SetEnabled(aux_profile_switch_previous_enabled_);
+  UpdateAppearanceForTheme();
+  LayoutAndPaint();
+}
+#endif
