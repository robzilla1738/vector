 // Forwards the early teardown request to both the embedded and detached WebUI
 // toolbar web views to stop renderer script execution before IPC disconnection.
+#if BUILDFLAG(ENABLE_AUX_BROWSER) && BUILDFLAG(IS_MAC)
+bool ToolbarView::CanRebindOwnedActionsForAuxProfileSwitch() const {
+  return !aux_owned_actions_prepared_ && initialized_ &&
+         display_mode_ == DisplayMode::kNormal &&
+         browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+         browser_->GetProfile()->IsRegularProfile() && !toolbar_webview_ &&
+         !detached_toolbar_webview_ && !features::IsWebUIToolbarEnabled() &&
+         !features::IsWebUIExtensionsContainerEnabled() &&
+         !features::IsWebUIPinnedToolbarActionsEnabled() &&
+         extensions_container_ && extensions_container_->parent() == this &&
+         pinned_toolbar_actions_container_ &&
+         pinned_toolbar_actions_container_->parent() == this &&
+         pinned_toolbar_actions_.get() == pinned_toolbar_actions_container_.get() &&
+         overflow_button_ &&
+         (!toolbar_controller_ || !toolbar_controller_->IsMenuRunning());
+}
+
+void ToolbarView::PrepareOwnedActionsForAuxProfileSwitch() {
+  CHECK(CanRebindOwnedActionsForAuxProfileSwitch());
+  aux_owned_actions_prepared_ = true;
+  aux_extensions_child_index_ = GetIndexOf(extensions_container_);
+  aux_pinned_actions_child_index_ = GetIndexOf(pinned_toolbar_actions_container_);
+  CHECK(aux_extensions_child_index_.has_value());
+  CHECK(aux_pinned_actions_child_index_.has_value());
+
+  // No callback may dereference the retiring pinned subtree. PrefMember::Init
+  // is one-shot, so destroy actual old members and construct fresh ones later.
+  show_forward_button_.reset();
+  show_home_button_.reset();
+  show_chrome_labs_button_.reset();
+  aux_overflow_button_was_enabled_ = overflow_button_->GetEnabled();
+  overflow_button_->SetEnabled(false);
+  overflow_button_->set_toolbar_controller(nullptr);
+  toolbar_controller_.reset();
+  extensions_toolbar_coordinator_.reset();
+
+  // The caller has already deregistered window extension side-panel entries,
+  // releasing their old BrowserActions references. Destructors close the real
+  // anchored extension widgets and remove old model/user-data observations.
+  auto* const extensions = extensions_container_.get();
+  extensions_container_ = nullptr;
+  auto* const pinned = pinned_toolbar_actions_container_.get();
+  pinned_toolbar_actions_container_ = nullptr;
+  pinned_toolbar_actions_ = nullptr;
+  RemoveChildViewT(extensions).reset();
+  RemoveChildViewT(pinned).reset();
+}
+
+void ToolbarView::RebindOwnedActionsForAuxProfileSwitch(Profile* target_profile) {
+  CHECK(aux_owned_actions_prepared_);
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK_EQ(browser_->GetProfile(), target_profile);
+  CHECK(browser_->GetTabStripModel());
+  CHECK(browser_->GetTabStripModel()->empty());
+  CHECK(!extensions_container_);
+  CHECK(!pinned_toolbar_actions_container_);
+  CHECK(!pinned_toolbar_actions_);
+  CHECK(!extensions_toolbar_coordinator_);
+  CHECK(!toolbar_controller_);
+
+  // Preserve the actual accessible child positions. The constructors read the
+  // real committed target profile and register fresh target model/user-data.
+  auto add_extensions = [&] {
+    extensions_container_ = AddChildViewAt(
+        std::make_unique<ExtensionsToolbarDesktop>(browser_),
+        *aux_extensions_child_index_);
+    extensions_toolbar_coordinator_ =
+        std::make_unique<ExtensionsToolbarCoordinator>(extensions_container_);
+  };
+  auto add_pinned = [&] {
+    pinned_toolbar_actions_container_ = AddChildViewAt(
+        std::make_unique<PinnedToolbarActionsContainer>(browser_view_, this),
+        *aux_pinned_actions_child_index_);
+    pinned_toolbar_actions_ = pinned_toolbar_actions_container_;
+  };
+  if (*aux_extensions_child_index_ < *aux_pinned_actions_child_index_) {
+    add_extensions();
+    add_pinned();
+  } else {
+    add_pinned();
+    add_extensions();
+  }
+
+  PrefService* const prefs = target_profile->GetPrefs();
+  show_forward_button_ = std::make_unique<BooleanPrefMember>();
+  show_forward_button_->Init(
+      prefs::kShowForwardButton, prefs,
+      base::BindRepeating(&ToolbarView::OnShowForwardButtonChanged,
+                          base::Unretained(this)));
+  show_home_button_ = std::make_unique<BooleanPrefMember>();
+  show_home_button_->Init(
+      prefs::kShowHomeButton, prefs,
+      base::BindRepeating(&ToolbarView::OnShowHomeButtonChanged,
+                          base::Unretained(this)));
+  show_chrome_labs_button_ = std::make_unique<BooleanPrefMember>();
+  if (IsChromeLabsEnabled() && ShouldShowChromeLabsUI(target_profile)) {
+    show_chrome_labs_button_->Init(
+        chrome_labs_prefs::kBrowserLabsEnabledEnterprisePolicy, prefs,
+        base::BindRepeating(&ToolbarView::OnChromeLabsPrefChanged,
+                            base::Unretained(this)));
+    pinned_toolbar_actions_container_->GetActionItemFor(kActionShowChromeLabs)
+        ->SetVisible(show_chrome_labs_button_->GetValue());
+  }
+  SetForwardButtonVisibility(show_forward_button_->GetValue());
+  if (home_) {
+    home_->SetVisible(show_home_button_->GetValue());
+  }
+  // Existing InitLayout replaces the layout/controller and their target model
+  // binding. It does not construct the permanent toolbar child controls.
+  InitLayout();
+  aux_extensions_child_index_.reset();
+  aux_pinned_actions_child_index_.reset();
+  aux_owned_actions_prepared_ = false;
+  overflow_button_->SetEnabled(aux_overflow_button_was_enabled_);
+}
+#endif
