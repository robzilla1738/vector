--- /dev/null
+++ b/content/public/browser/aux_renderer_navigation_admission.h
@@ -0,0 +1,30 @@
+#ifndef CONTENT_PUBLIC_BROWSER_AUX_RENDERER_NAVIGATION_ADMISSION_H_
+#define CONTENT_PUBLIC_BROWSER_AUX_RENDERER_NAVIGATION_ADMISSION_H_
+
+#include <cstddef>
+#include <cstdint>
+#include "content/common/content_export.h"
+
+namespace content::aux_migration {
+
+// Process-local component observations, never renderer exit/storage drain proof.
+struct RendererNavigationAdmissionSnapshot {
+  uint64_t generation;  // 1 open -> 2 permanently closed.
+  bool closed;
+  size_t active_renderer_init_calls;
+  size_t pending_renderer_launches;
+  size_t unresolved_renderer_launches;
+  size_t late_renderer_launch_callbacks;
+  size_t active_navigation_dispatches;
+  size_t live_navigation_requests;
+  size_t unresolved_navigation_cleanups;
+  size_t unsupported_navigation_cancellations;
+};
+
+// Permanent native close. No reset, scope selector, environment or JS grant.
+CONTENT_EXPORT void CloseRendererNavigationAdmissionForMigration();
+CONTENT_EXPORT RendererNavigationAdmissionSnapshot
+InspectRendererNavigationAdmissionForMigration();
+
+}  // namespace content::aux_migration
+#endif
diff --git a/content/browser/renderer_host/aux_renderer_navigation_admission.h b/content/browser/renderer_host/aux_renderer_navigation_admission.h
new file mode 100644
--- /dev/null
+++ b/content/browser/renderer_host/aux_renderer_navigation_admission.h
@@ -0,0 +1,50 @@
+#ifndef CONTENT_BROWSER_RENDERER_HOST_AUX_RENDERER_NAVIGATION_ADMISSION_H_
+#define CONTENT_BROWSER_RENDERER_HOST_AUX_RENDERER_NAVIGATION_ADMISSION_H_
+
+#include <cstdint>
+#include "content/public/browser/aux_renderer_navigation_admission.h"
+
+namespace content::aux_migration {
+
+class ScopedRendererInitAdmission final {
+ public:
+  ScopedRendererInitAdmission();
+  ~ScopedRendererInitAdmission();
+  ScopedRendererInitAdmission(const ScopedRendererInitAdmission&) = delete;
+  ScopedRendererInitAdmission& operator=(const ScopedRendererInitAdmission&) = delete;
+  bool admitted() const { return admitted_; }
+ private:
+  const bool admitted_;
+};
+
+// Starts the observation before any launch/reentrant embedder callback.
+void ObserveRendererLaunchStarted(const void* host, bool in_process);
+void ObserveRendererHostDestruction(const void* host);
+class ScopedRendererLaunchCallback final {
+ public:
+  explicit ScopedRendererLaunchCallback(const void* host);
+  ~ScopedRendererLaunchCallback();
+  ScopedRendererLaunchCallback(const ScopedRendererLaunchCallback&) = delete;
+  ScopedRendererLaunchCallback& operator=(const ScopedRendererLaunchCallback&) = delete;
+ private:
+  const uintptr_t host_identity_;
+  const uint64_t token_;
+};
+
+// Native owner-keyed entry/resume acquisition. Repeated queued resumes retain
+// the same request observation; closure cannot be reopened by a new request.
+class ScopedNavigationAdmission final {
+ public:
+  ScopedNavigationAdmission(const void* request, bool first_entry);
+  ~ScopedNavigationAdmission();
+  ScopedNavigationAdmission(const ScopedNavigationAdmission&) = delete;
+  ScopedNavigationAdmission& operator=(const ScopedNavigationAdmission&) = delete;
+  bool admitted() const { return admitted_; }
+ private:
+  const bool admitted_;
+};
+void ObserveNavigationDestruction(const void* request);
+void ObserveUnsupportedNavigationCancellation();
+
+}  // namespace content::aux_migration
+#endif
diff --git a/content/browser/renderer_host/aux_renderer_navigation_admission.cc b/content/browser/renderer_host/aux_renderer_navigation_admission.cc
new file mode 100644
--- /dev/null
+++ b/content/browser/renderer_host/aux_renderer_navigation_admission.cc
@@ -0,0 +1,157 @@
+#include "content/browser/renderer_host/aux_renderer_navigation_admission.h"
+
+#include <limits>
+#include <map>
+#include <mutex>
+#include <set>
+
+namespace content::aux_migration {
+namespace {
+struct Launch {
+  uint64_t token;
+  bool in_process;
+};
+struct State {
+  State();
+  ~State();
+  std::mutex mutex;
+  bool closed = false;
+  size_t active_init = 0;
+  size_t unresolved_launches = 0;
+  size_t late_callbacks = 0;
+  size_t active_navigation = 0;
+  size_t unresolved_navigation = 0;
+  size_t unsupported_navigation = 0;
+  uint64_t next_token = 0;
+  std::map<const void*, Launch> launches;
+  std::set<const void*> navigations;
+};
+State::State() = default;
+State::~State() = default;
+State& Current() {
+  static State* const state = new State;
+  return *state;
+}
+void Increment(size_t& count) {
+  if (count != std::numeric_limits<size_t>::max())
+    ++count;
+}
+bool AcquireInit() {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.closed || state.active_init == std::numeric_limits<size_t>::max())
+    return false;
+  ++state.active_init;
+  return true;
+}
+bool AcquireNavigation(const void* request, bool first_entry) {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.closed || !request ||
+      state.active_navigation == std::numeric_limits<size_t>::max())
+    return false;
+  if (!state.navigations.contains(request)) {
+    if (!first_entry)
+      Increment(state.unsupported_navigation);
+    state.navigations.insert(request);
+  }
+  ++state.active_navigation;
+  return true;
+}
+uint64_t BeginLaunchCallback(const void* host) {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.closed)
+    Increment(state.late_callbacks);
+  auto found = state.launches.find(host);
+  if (found == state.launches.end()) {
+    Increment(state.unresolved_launches);
+    return 0;
+  }
+  return found->second.token;
+}
+}  // namespace
+
+void CloseRendererNavigationAdmissionForMigration() {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  state.closed = true;
+}
+RendererNavigationAdmissionSnapshot
+InspectRendererNavigationAdmissionForMigration() {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  return {state.closed ? uint64_t{2} : uint64_t{1}, state.closed,
+          state.active_init, state.launches.size(), state.unresolved_launches,
+          state.late_callbacks, state.active_navigation, state.navigations.size(),
+          state.unresolved_navigation, state.unsupported_navigation};
+}
+ScopedRendererInitAdmission::ScopedRendererInitAdmission()
+    : admitted_(AcquireInit()) {}
+ScopedRendererInitAdmission::~ScopedRendererInitAdmission() {
+  if (admitted_) {
+    auto& state = Current();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    --state.active_init;
+  }
+}
+void ObserveRendererLaunchStarted(const void* host, bool in_process) {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (!host || state.next_token == std::numeric_limits<uint64_t>::max() ||
+      state.launches.contains(host)) {
+    Increment(state.unresolved_launches);
+    return;
+  }
+  state.launches.emplace(host, Launch{++state.next_token, in_process});
+}
+void ObserveRendererHostDestruction(const void* host) {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.launches.erase(host))
+    Increment(state.unresolved_launches);
+}
+ScopedRendererLaunchCallback::ScopedRendererLaunchCallback(const void* host)
+    : host_identity_(reinterpret_cast<uintptr_t>(host)),
+      token_(BeginLaunchCallback(host)) {}
+ScopedRendererLaunchCallback::~ScopedRendererLaunchCallback() {
+  if (!token_)
+    return;
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  auto found = state.launches.find(reinterpret_cast<const void*>(host_identity_));
+  if (found == state.launches.end() || found->second.token != token_) {
+    Increment(state.unresolved_launches);
+    return;
+  }
+  // The in-process route calls OnProcessLaunched before starting its thread;
+  // that synthetic callback cannot prove launch completion or thread custody.
+  if (found->second.in_process)
+    Increment(state.unresolved_launches);
+  state.launches.erase(found);
+}
+ScopedNavigationAdmission::ScopedNavigationAdmission(const void* request,
+                                                     bool first_entry)
+    : admitted_(AcquireNavigation(request, first_entry)) {}
+ScopedNavigationAdmission::~ScopedNavigationAdmission() {
+  if (admitted_) {
+    auto& state = Current();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    --state.active_navigation;
+  }
+}
+void ObserveNavigationDestruction(const void* request) {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  if (state.navigations.erase(request)) {
+    // Destructor entry is not member/backend teardown completion. Retain that
+    // gap explicitly rather than treating request deletion as writer drain.
+    Increment(state.unresolved_navigation);
+  }
+}
+void ObserveUnsupportedNavigationCancellation() {
+  auto& state = Current();
+  std::lock_guard<std::mutex> lock(state.mutex);
+  Increment(state.unsupported_navigation);
+}
+}  // namespace content::aux_migration
