{
  "name": "@aux/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts",
    "install-model": "tsx src/install-model.ts"
  },
  "dependencies": {
    "@aux/agent": "workspace:*",
    "onnxruntime-node": "1.30.0",
    "ai": "^7.0.143",
    "zod": "^4.3.6",
    "@huggingface/tokenizers": "0.2.0"
  },
  "files": [
    "dist",
    "models/manifest.json",
    "models/NOTICE.md",
    "models/LICENSE-APACHE-2.0.txt"
  ]
}
