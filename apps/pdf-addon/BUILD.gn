# Aux's aux-pdf.node: the Sources/ module linked against the Chromium checkout's PDFium.
# Loaded by build.sh as a system-absolute root target; the checkout itself is only read.
declare_args() {
  # Directory holding node_api.h.
  aux_node_include = ""
}

loadable_module("aux_pdf_four") {
  output_extension = "node"
  sources = [
    "Sources/AuxPdfFour.cc",
    "Sources/RecoveredPdfPageSelection.cc",
    "Sources/RecoveredPdfPageSelectionNapi.cc",
    "Sources/RecoveredPngCodec.cc",
  ]
  include_dirs = [ aux_node_include, "//third_party/pdfium/public" ]
  defines = [ "NAPI_VERSION=8" ]
  configs -= [
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
    "//build/config/compiler:no_unresolved_symbols",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:rtti",
    "//build/config/compiler:no_exit_time_destructors",
  ]
  cflags_cc = [ "-Wno-deprecated-declarations" ]
  ldflags = [ "-Wl,-undefined,dynamic_lookup" ]
  deps = [ "//third_party/pdfium:pdfium", "//third_party/zlib" ]
}
