{
  "name": "@aux/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/store/db.d.ts",
      "import": "./dist/store/db.js"
    },
    "./repository": {
      "types": "./dist/store/repo.d.ts",
      "import": "./dist/store/repo.js"
    }
  },
  "bin": {
    "aux-runtime": "./dist/main.js"
  },
  "scripts": {
    "build": "node ../../scripts/gen-runtime-schema.mjs && tsc -b",
    "typecheck": "node ../../scripts/gen-runtime-schema.mjs && tsc -b --force",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.48",
    "@ai-sdk/gateway": "4.0.75",
    "@ai-sdk/google": "4.0.64",
    "@ai-sdk/openai": "4.0.60",
    "@ai-sdk/provider-utils": "5.0.36",
    "@aux/chromium-driver": "workspace:*",
    "@aux/contracts": "workspace:*",
    "@aux/filter-lists": "workspace:*",
    "@github/copilot-sdk": "1.0.16",
    "@jitl/quickjs-wasmfile-release-asyncify": "0.31.0",
    "@modelcontextprotocol/client": "2.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@vercel/sandbox": "3.5.1",
    "ai": "7.0.93",
    "docx": "9.7.2",
    "email-addresses": "5.0.0",
    "exceljs": "4.4.0",
    "jose": "6.2.12",
    "parse5": "7.3.0",
    "pngjs": "^7.0.0",
    "pptxgenjs": "4.0.1",
    "quickjs-emscripten-core": "0.31.0",
    "rrule-temporal": "2.2.8",
    "smol-toml": "1.9.0",
    "tar": "7.5.22",
    "vega": "6.4.0",
    "vega-lite": "6.4.3",
    "ws": "8.21.3",
    "yaml": "2.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "catalog:"
  },
  "imports": {
    "#rrule-temporal": "rrule-temporal",
    "#aux-copilot-install-worker": "./dist/services/copilot-install-worker.js"
  }
}
