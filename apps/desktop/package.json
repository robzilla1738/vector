{
  "name": "@vector/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.main.json tsconfig.preload.json && node bundle.mjs && vite build",
    "typecheck": "tsc -b tsconfig.main.json tsconfig.preload.json --force && tsc -p tsconfig.renderer.json",
    "dev": "electron .",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "test": "vitest run renderer"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@vector/contracts": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "6.1.200",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "43.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.0",
    "jsdom": "26.1.0",
    "node-api-headers": "1.9.0",
    "parse5": "7.3.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  }
}
