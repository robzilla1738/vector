{
  "name": "@vector/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.main.json tsconfig.preload.json && node bundle.mjs && vite build",
    "typecheck": "tsc -b tsconfig.main.json tsconfig.preload.json --force && tsc -p tsconfig.renderer.json",
    "dev": "electron .",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "test": "vitest run renderer"
  },
  "dependencies": {
    "@vector/contracts": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "43.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.0",
    "jsdom": "26.1.0",
    "lucide-react": "^1.46.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  }
}
