# Aux reads no .env file. These are optional process variables for development.
# Keys and secrets never go here: add provider keys in Settings > Models.

# Chromium checkout, when it isn't at the default path in scripts/aux_chromium.py.
# AUX_CHROMIUM_SRC=

# State home for the development launcher (scripts/aux.mjs). Default: ~/.aux
# AUX_HOME=
