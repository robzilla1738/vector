# Aux runtime configuration. Legacy VECTOR_* names remain supported.
# Nonempty AUX_* values win within a source; process env wins over .env files.

# Vercel AI Gateway key. Required for `runs.start` (agent goals) and
# `sets.map --goal`. Not needed for programs, observations, or sets with
# a saved program.
AI_GATEWAY_API_KEY=

# Override the runtime data directory (SQLite db, artifacts, runtime.json).
# New macOS installs: ~/Library/Application Support/Aux Browser
# Existing legacy installations remain in place until explicitly migrated.
AUX_DATA_DIR=

# Desktop browser profile override (absolute path, set in the launch environment).
# Existing profiles are retained; ambiguous profiles require explicit selection.
# This is independent of the runtime database/artifact directory above.
AUX_PROFILE_DIR=

# Set to 0 for an isolated launch that must not read any .env files.
AUX_LOAD_DOTENV=1

# Pin the loopback API port. Default: 0 (ephemeral; see runtime.json for
# the actual port + bearer token).
AUX_API_PORT=

# Electron CDP endpoint — set automatically by the desktop shell when it
# forks the runtime. Leave empty for standalone mode.
AUX_ELECTRON_CDP=

# Model id passed to the AI Gateway planner when Settings has none.
# Default: alibaba/qwen3.8-27b (Cerebras). Fast GPT Luna: openai/gpt-5.6-luna-fast
# AUX_PLANNER_MODEL=alibaba/qwen3.8-27b

# Optional provider pin (cerebras, openai, …). Leave unset so Qwen and Luna Fast both route.
# AUX_GATEWAY_ONLY=cerebras

# Stronger model used for the last repair attempt on a failing run.
# Default: none (last repair uses the planner model).
AUX_RECOVERY_MODEL=

# Vision-capable model for the screenshot fallback replan (once per run,
# when a chunk fails or the page yields no structured elements).
# Default: unset — vision is skipped (Cerebras cannot take image parts).
AUX_VISION_MODEL=
