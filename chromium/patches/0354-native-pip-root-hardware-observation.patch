+void ObserveNativePipInitializedForMeasurement(
+    views::Widget* widget, NativePipSurfaceKind kind, content::WebContents* opener);
+void ObserveNativePipCreatedForMeasurement(
+    views::Widget* widget, NativePipSurfaceKind kind,
+    NativePipAppearanceRegistry::OwnerReader read_original_owner);
+
+// Arm→created native PiP root hardware upper bound. Root coverage does not
+// claim video/child surface coverage, earliest presentation or input latency.
+class NativePipPresentationFixture final : public content::WebContentsObserver,
+                                          public ui::CompositorObserver,
+                                          public views::WidgetObserver {
+ public:
+  using Reply = base::OnceCallback<void(base::DictValue)>;
+  explicit NativePipPresentationFixture(base::WeakPtr<WebUIBrowserUI> source);
+  ~NativePipPresentationFixture() override;
+  void Prepare(Reply ready);
+  void Complete(Reply completed);
+  void Retire(Reply retired);
+  bool HasRetired() const;
+  void Initialized(views::Widget* widget, NativePipSurfaceKind kind,
+                   content::WebContents* opener);
+  void Created(views::Widget* widget, NativePipSurfaceKind kind,
+               NativePipAppearanceRegistry::OwnerReader read_original_owner);
+  void PrimaryPageChanged(content::Page& page) override;
+  void WebContentsDestroyed() override;
+  void OnWidgetDestroying(views::Widget* widget) override;
+  void OnWidgetDestroyed(views::Widget* widget) override;
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override;
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override;
