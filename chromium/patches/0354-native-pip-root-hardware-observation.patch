+// found in the LICENSE file.
+#ifndef UI_VIEWS_WIDGET_NATIVE_ROOT_PAINT_OBSERVATION_H_
+#define UI_VIEWS_WIDGET_NATIVE_ROOT_PAINT_OBSERVATION_H_
+
+#include "base/functional/callback_forward.h"
+#include "base/time/time.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace views {
+// Actual RootView PaintChildren completion; never a submission/presentation
+// receipt. Caller clocks, geometry, scheduling and ready setters are absent.
+struct NativeRootPaintObservation {
+  base::TimeTicks ready;
+  gfx::Rect recording_bounds_in_pixels;
+  float device_scale_factor = 0;
+  bool entire_client_painted = false;
+};
+using NativeRootPaintCallback =
+    base::OnceCallback<void(NativeRootPaintObservation)>;
+}  // namespace views
+
+#endif  // UI_VIEWS_WIDGET_NATIVE_ROOT_PAINT_OBSERVATION_H_
