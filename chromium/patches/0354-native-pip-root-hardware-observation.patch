+TEST_F(RootViewTest, NativeRootPaintObservedAfterOriginalChildren) {
+  RootViewTestState state(this, {.bounds = gfx::Rect(0, 0, 40, 30)});
+  bool painted = false;
+  state.widget()->SetContentsView(
+      std::make_unique<NativeRootPaintChild>(&painted));
+  std::optional<NativeRootPaintObservation> actual;
+  ASSERT_TRUE(state.widget()->ObserveNativeRootPaintForTesting(base::BindOnce(
+      [](bool* child_painted,
+         std::optional<NativeRootPaintObservation>* result,
+         NativeRootPaintObservation observation) {
+        EXPECT_TRUE(*child_painted);
+        *result = std::move(observation);
+      }, &painted, &actual)));
+  EXPECT_FALSE(actual);
+  // An arbitrary root-view paint is not the actual native Widget entrypoint.
+  auto direct_items = base::MakeRefCounted<cc::DisplayItemList>();
+  state.widget()->GetRootView()->PaintFromPaintRoot(ui::PaintContext(
+      direct_items.get(), 1.f, state.widget()->GetRootView()->GetLocalBounds(),
+      false));
+  EXPECT_FALSE(actual);
+  const auto before = base::TimeTicks::Now();
+  auto items = base::MakeRefCounted<cc::DisplayItemList>();
+  state.widget()->OnNativeWidgetPaint(ui::PaintContext(
+      items.get(), 1.f, state.widget()->GetRootView()->GetLocalBounds(), false));
+  ASSERT_TRUE(actual);
+  EXPECT_GE(actual->ready, before);
+  EXPECT_LE(actual->ready, base::TimeTicks::Now());
+  EXPECT_EQ(actual->recording_bounds_in_pixels,
