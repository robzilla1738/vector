+base::WeakPtr<NativePipPresentationFixture>& ActiveFixture() {
+  static base::NoDestructor<base::WeakPtr<NativePipPresentationFixture>> active;
+  return *active;
+}
+}  // namespace
+void ObserveNativePipInitializedForMeasurement(
+    views::Widget* widget, NativePipSurfaceKind kind, content::WebContents* opener) {
+  if (ActiveFixture()) ActiveFixture()->Initialized(widget, kind, opener);
+}
+void ObserveNativePipCreatedForMeasurement(
+    views::Widget* widget, NativePipSurfaceKind kind,
+    NativePipAppearanceRegistry::OwnerReader reader) {
+  if (ActiveFixture()) ActiveFixture()->Created(widget, kind, std::move(reader));
+}
+NativePipPresentationFixture::NativePipPresentationFixture(
+    base::WeakPtr<WebUIBrowserUI> source) : source_(source) {}
+NativePipPresentationFixture::~NativePipPresentationFixture() {
+  if (ActiveFixture().get() == this) ActiveFixture().reset();
+  weak_factory_.InvalidateWeakPtrs();
+  timeout_.Stop();
+  StopHardware();
+  widget_.Reset();
+  Observe(nullptr);
+  // Retirement is never inferred from fixture/member/receipt destruction.
+}
+bool NativePipPresentationFixture::WithinDeadline() const {
+  return !deadline_.is_null() && base::TimeTicks::Now() < deadline_;
+}
+bool NativePipPresentationFixture::StableShell() {
+  if (!source_ || !source_browser_ || !NativePerformanceObservationEnabled() ||
+      !shell_owner_ || source_->browser() != source_browser_.get() ||
+      !source_browser_->GetProfile() ||
+      source_browser_->GetProfile()->IsOffTheRecord() ||
+      source_browser_->GetProfile() != owner_.profile) return false;
+  const auto weak = weak_factory_.GetWeakPtr();
+  const auto actual = ReadNativeGuestStageShellOwner(source_);
+  return weak && actual == shell_owner_;
+}
+bool NativePipPresentationFixture::StableSource() {
+  if (!StableShell() || !opener_ || opener_->IsBeingDestroyed() ||
+      opener_->GetBrowserContext() != owner_.profile ||
+      !source_browser_->GetTabStripModel() ||
+      source_browser_->GetTabStripModel()->GetActiveWebContents() != opener_.get())
+    return false;
+  auto* frame = opener_document_.AsRenderFrameHostIfValid();
+  auto* identity = PageIdentity::FromWebContents(opener_.get());
+  return frame && frame == opener_->GetPrimaryMainFrame() &&
+      !frame->IsErrorDocument() && frame->IsRenderFrameLive() && identity &&
+      identity->id() == page_id_ && !identity->runtime_owned();
+}
+bool NativePipPresentationFixture::StableTarget(bool require_visible) {
+  if (refused_ || destroying_ || !WithinDeadline() || !StableSource() ||
+      !target_ || !widget_.IsObserving() ||
+      widget_.GetSource() != target_.get() || !compositor_.IsObserving() ||
+      target_->GetCompositor() != compositor_.GetSource() || read_owner_.is_null())
+    return false;
+  const auto weak = weak_factory_.GetWeakPtr();
+  const auto target = target_;
+  const auto actual = read_owner_.Run();
+  if (!weak || !target || !actual || *actual != owner_ ||
+      !owner_.controller || owner_.controller->GetWebContents() != opener_.get() ||
+      owner_.controller->GetChildWebContents() != owner_.child) return false;
+  if (owner_.child) {
+    auto* child_frame = child_document_.AsRenderFrameHostIfValid();
+    if (!child_frame || owner_.child->IsBeingDestroyed() ||
+        owner_.child->GetBrowserContext() != owner_.profile ||
+        child_frame != owner_.child->GetPrimaryMainFrame() ||
+        child_frame->IsErrorDocument() || !child_frame->IsRenderFrameLive())
+      return false;
+  }
+  auto* compositor = compositor_.GetSource();
+  if (display_generation_ &&
+      compositor->native_startup_display_generation() != display_generation_)
+    return false;
+  if (root_.is_valid() &&
+      (root_ != viz::SurfaceId(compositor->frame_sink_id(),
+                              compositor->local_surface_id_from_parent()) ||
+       bounds_ != gfx::Rect(compositor->size()))) return false;
+  const bool visible = !require_visible || target->IsVisible();
+  return weak && target && target_.get() == target.get() && visible;
+}
+void NativePipPresentationFixture::Prepare(Reply ready) {
+  if (used_ || (ActiveFixture() && ActiveFixture().get() != this)) {
+    std::move(ready).Run(Record("refused", "prior_fixture_unretired")); return;
+  }
+  used_ = true;
+  armed_ = base::TimeTicks::Now();
+  deadline_ = armed_ + base::Seconds(5);
+  nonce_ = base::UnguessableToken::Create();
+  if (!source_ || !source_->browser()) {
+    std::move(ready).Run(Record("refused", "unavailable_original_shell")); return;
+  }
+  source_browser_ = source_->browser()->GetWeakPtr();
+  owner_.profile = source_browser_->GetProfile();
+  const auto self = weak_factory_.GetWeakPtr();
+  auto unavailable = Record("refused", "original_shell_retired_during_read");
+  const auto shell = ReadNativeGuestStageShellOwner(source_);
+  if (!self || !source_browser_) {
+    std::move(ready).Run(std::move(unavailable)); return;
+  }
+  shell_owner_ = shell;
+  auto* strip = source_browser_->GetTabStripModel();
+  auto* opener = strip ? strip->GetActiveWebContents() : nullptr;
+  auto* frame = opener ? opener->GetPrimaryMainFrame() : nullptr;
+  auto* identity = opener ? PageIdentity::FromWebContents(opener) : nullptr;
+  if (!frame || !identity || identity->runtime_owned()) {
+    std::move(ready).Run(Record("refused", "unavailable_original_person_page")); return;
+  }
+  opener_ = opener->GetWeakPtr();
+  opener_document_ = frame->GetWeakDocumentPtr();
+  page_id_ = identity->id();
+  unavailable = Record("refused", "original_person_scope_changed");
+  if (!WithinDeadline() || !StableSource()) {
+    std::move(ready).Run(std::move(unavailable)); return;
+  }
+  Observe(opener);
+  ActiveFixture() = weak_factory_.GetWeakPtr();
+  timeout_.Start(FROM_HERE, deadline_ - base::TimeTicks::Now(), base::BindOnce(
+      &NativePipPresentationFixture::Refuse, weak_factory_.GetWeakPtr(),
+      "original_pip_deadline_elapsed"));
+  std::move(ready).Run(Record("ready", "original_native_arm"));
+}
+void NativePipPresentationFixture::Initialized(
+    views::Widget* widget, NativePipSurfaceKind kind, content::WebContents* opener) {
+  const auto self = weak_factory_.GetWeakPtr();
+  if (!used_ || refused_ || consumed_ || !WithinDeadline() || !StableSource() ||
+      !widget || target_ || opener != opener_.get() || widget->IsVisible() ||
+      !widget->GetNativeWindow() || !widget->GetRootView() ||
+      !widget->GetCompositor()) {
+    if (self) Refuse("unavailable_actual_fresh_widget_initialization");
+    return;
+  }
+  // This entry is called only after the actual factory's Widget::Init has
+  // returned. Existing Show/Hide paths cannot mint this creation witness.
+  target_ = widget->GetWeakPtr();
+  kind_ = kind;
+  created_ = base::TimeTicks::Now();
+  widget_receipt_ = base::UnguessableToken::Create();
+  widget_.Observe(widget);
+}
+void NativePipPresentationFixture::Created(
+    views::Widget* widget, NativePipSurfaceKind kind,
+    NativePipAppearanceRegistry::OwnerReader reader) {
+  const auto self = weak_factory_.GetWeakPtr();
+  if (!used_ || refused_ || consumed_ || !WithinDeadline() || !StableSource() ||
+      !widget || !target_ || target_.get() != widget || kind != kind_ ||
+      !widget_.IsObserving() || widget_.GetSource() != widget ||
+      !read_owner_.is_null() || reader.is_null() || widget->IsVisible() ||
+      !widget->GetCompositor()) {
+    if (self) Refuse("unavailable_fresh_pre_show_target");
+    return;
+  }
+  const auto weak = weak_factory_.GetWeakPtr();
+  const auto original_widget = widget->GetWeakPtr();
+  const auto actual = reader.Run();
+  if (!weak || !original_widget) return;
+  if (!actual || actual->profile != owner_.profile ||
+      actual->opener != opener_.get() || !actual->controller ||
+      actual->controller->GetWebContents() != opener_.get() ||
+      actual->controller->GetChildWebContents() != actual->child ||
+      (kind == NativePipSurfaceKind::kVideo && actual->child) ||
+      (kind == NativePipSurfaceKind::kDocument && !actual->child) ||
+      !StableSource() || !self || !original_widget || original_widget->IsVisible()) {
+    if (self) Refuse("original_native_pip_owner_refused");
+    return;
+  }
+  owner_ = *actual;
+  if (owner_.child) {
+    auto* child_frame = owner_.child->GetPrimaryMainFrame();
+    if (!child_frame) { Refuse("unavailable_original_pip_child"); return; }
+    child_document_ = child_frame->GetWeakDocumentPtr();
+  }
+  kind_ = kind;
+  read_owner_ = std::move(reader);
+  target_ = original_widget;
+  compositor_.Observe(widget->GetCompositor());
+  if (!StableTarget(false) || !widget->ObserveNativeRootPaintForTesting(
+      base::BindOnce(&NativePipPresentationFixture::Painted,
+                     weak_factory_.GetWeakPtr()))) {
+    if (self) Refuse("unavailable_original_root_paint_enrollment");
+    return;
+  }
+  compositor_.GetSource()->BeginNativeStockStartupHardwareObservation(nonce_,
+      base::BindOnce(&NativePipPresentationFixture::Registered,
+                     weak_factory_.GetWeakPtr()));
+}
+void NativePipPresentationFixture::Registered(
+    std::optional<base::TimeTicks> actual) {
+  const auto self = weak_factory_.GetWeakPtr();
+  if (!StableTarget(false) || !ready_.is_null() || !registered_.is_null() ||
+      !actual || actual->is_null() || *actual < created_ ||
+      *actual > base::TimeTicks::Now()) {
+    if (self) Refuse("native_display_registration_refused");
+    return;
+  }
+  display_generation_ = compositor_.GetSource()->native_startup_display_generation();
+  if (!display_generation_) { Refuse("unavailable_original_display_generation"); return; }
+  registered_ = *actual;
+}
+void NativePipPresentationFixture::Painted(
+    views::NativeRootPaintObservation actual) {
+  const auto self = weak_factory_.GetWeakPtr();
+  if (!StableTarget(true) || !ready_.is_null() || registered_.is_null() ||
+      !actual.entire_client_painted || actual.ready.is_null() ||
+      actual.ready < registered_ || actual.ready > base::TimeTicks::Now() ||
+      actual.recording_bounds_in_pixels != gfx::Rect(compositor_.GetSource()->size()) ||
+      actual.device_scale_factor != compositor_.GetSource()->device_scale_factor()) {
+    if (self) Refuse("original_full_root_paint_refused");
+    return;
+  }
+  bounds_ = actual.recording_bounds_in_pixels;
+  ready_ = actual.ready;
+  root_ = viz::SurfaceId(compositor_.GetSource()->frame_sink_id(),
+                         compositor_.GetSource()->local_surface_id_from_parent());
+  if (!root_.is_valid() || !StableTarget(true)) {
+    if (self) Refuse("original_root_surface_changed");
+    return;
+  }
+  viz::NativeStockReadyFrame marker;
+  marker.nonce = nonce_; marker.client_bounds = bounds_; marker.ready = ready_;
+  compositor_.GetSource()->QueueNativeStockReadyPaint(marker, base::BindOnce(
+      &NativePipPresentationFixture::Submitted, weak_factory_.GetWeakPtr()));
+}
+void NativePipPresentationFixture::Submitted(
+    std::optional<viz::NativeStockReadyFrame> actual) {
+  const auto self = weak_factory_.GetWeakPtr();
+  if (!StableTarget(true) || submission_ || !actual || actual->nonce != nonce_ ||
+      actual->client_bounds != bounds_ || actual->ready != ready_ ||
+      !actual->frame_token || actual->commit.is_null() || actual->submitted.is_null() ||
+      ready_ > actual->commit || actual->commit > actual->submitted ||
+      actual->submitted > base::TimeTicks::Now()) {
+    if (self) Refuse("original_root_submission_refused");
+    return;
+  }
+  submission_ = std::move(actual);
+  compositor_.GetSource()->CompleteNativeStockStartupHardwareObservation(
+      nonce_, root_, submission_->frame_token, base::BindOnce(
+          &NativePipPresentationFixture::Presented, weak_factory_.GetWeakPtr()));
+}
+void NativePipPresentationFixture::Presented(
+    viz::mojom::NativeStockRootPresentationPtr actual) {
+  const auto self = weak_factory_.GetWeakPtr();
+  const auto now = base::TimeTicks::Now();
+  if (!StableTarget(true) || measured_ || !submission_ || !actual ||
+      actual->nonce != nonce_ || actual->root != root_ ||
+      actual->token != submission_->frame_token || actual->output != bounds_ ||
+      actual->committed_client_bounds != bounds_ || actual->ready != ready_ ||
+      actual->commit != submission_->commit ||
+      actual->submitted != submission_->submitted || actual->draw.is_null() ||
+      actual->swap.swap_start.is_null() || actual->swap.swap_end.is_null() ||
+      actual->feedback.timestamp.is_null() || actual->observed.is_null() ||
+      actual->submitted > actual->draw || actual->draw > actual->swap.swap_start ||
+      actual->swap.swap_start > actual->swap.swap_end ||
+      actual->swap.swap_end > actual->feedback.timestamp ||
+      actual->feedback.timestamp > actual->observed || actual->observed > now ||
+      !(actual->feedback.flags & gfx::PresentationFeedback::kHWCompletion) ||
+      (actual->feedback.flags & gfx::PresentationFeedback::kFailure)) {
+    if (self) Refuse("original_pip_root_hardware_pair_refused");
+    return;
+  }
+  auto record = Record("measured", "created_native_pip_root_hardware_upperbound");
+  record.Set("measured", true);
+  const auto& local = root_.local_surface_id();
+  record.Set("rootSurface", base::DictValue()
+      .Set("frameSink", EncodeNativePresentationSink(root_.frame_sink_id()))
+      .Set("parentSequenceNumber", static_cast<double>(local.parent_sequence_number()))
+      .Set("childSequenceNumber", static_cast<double>(local.child_sequence_number()))
+      .Set("embedToken", local.embed_token().ToString()));
+  record.Set("frameToken", static_cast<double>(actual->token));
+  record.Set("output", base::ListValue().Append(bounds_.x()).Append(bounds_.y())
+      .Append(bounds_.width()).Append(bounds_.height()));
+  record.Set("feedbackFlags", static_cast<double>(actual->feedback.flags));
+  record.Set("alphaReadbackAttempted", actual->alpha_readback_attempted);
+  AppendNativePresentationTick(record, "readyUs", ready_);
+  AppendNativePresentationTick(record, "commitUs", actual->commit);
+  AppendNativePresentationTick(record, "submittedUs", actual->submitted);
+  AppendNativePresentationTick(record, "drawUs", actual->draw);
+  AppendNativePresentationTick(record, "swapStartUs", actual->swap.swap_start);
+  AppendNativePresentationTick(record, "swapEndUs", actual->swap.swap_end);
+  AppendNativePresentationTick(record, "presentedUs", actual->feedback.timestamp);
+  AppendNativePresentationTick(record, "observedUs", actual->observed);
+  record.Set("elapsedUs", base::NumberToString(
+      (actual->feedback.timestamp - armed_).InMicroseconds()));
+  // Leave the original Widget observation and absolute timer installed. A
+  // successful sample alone cannot retire ownership or free the next trial.
+  measured_ = true;
+  record_ = std::move(record);
+  StopHardware();
+  DeliverRecord();
+}
+base::DictValue NativePipPresentationFixture::Record(
+    const char* status, const char* reason) const {
+  auto result = base::DictValue().Set("producer", "aux-native-pip-root-presentation")
+      .Set("version", 1).Set("status", status).Set("reason", reason)
+      .Set("metric", "pip-window").Set("startKind", "native-arm-upperbound")
+      .Set("measured", false).Set("rootHardwareCoverage", true)
+      .Set("videoGuestCoverage", false).Set("earliestPresentationProven", false)
+      .Set("firstFrameProven", false);
+  if (!nonce_.is_empty()) result.Set("requestNonce", nonce_.ToString());
+  if (!page_id_.empty()) result.Set("sourcePageId", page_id_);
+  if (!widget_receipt_.is_empty())
+    result.Set("targetWidgetReceipt", widget_receipt_.ToString());
+  if (shell_owner_) {
+    result.Set("windowId", shell_owner_->window_id);
+    result.Set("widgetRoutingId", shell_owner_->shell_widget_routing_id);
+    result.Set("rendererPid", shell_owner_->shell_renderer_pid);
+    result.Set("shellSink", EncodeNativePresentationSink(shell_owner_->shell_sink));
+    result.Set("displaySink", EncodeNativePresentationSink(shell_owner_->display_sink));
+  }
+  if (!widget_receipt_.is_empty()) result.Set("surfaceKind",
+      kind_ == NativePipSurfaceKind::kVideo ? "video-pip" : "document-pip");
+  if (display_generation_)
+    result.Set("displayGeneration", base::NumberToString(display_generation_));
+  AppendNativePresentationTick(result, "armedUs", armed_);
+  AppendNativePresentationTick(result, "deadlineUs", deadline_);
+  AppendNativePresentationTick(result, "createdUs", created_);
+  AppendNativePresentationTick(result, "registeredUs", registered_);
+  return result;
+}
+void NativePipPresentationFixture::Complete(Reply completed) {
+  auto refusal = Record("refused", "no_current_prepared_pip_sample");
+  if (!used_ || consumed_ || completed_ || !WithinDeadline() || !StableShell()) {
+    std::move(completed).Run(std::move(refusal)); return;
+  }
+  completed_ = std::move(completed);
+  DeliverRecord();
+}
+void NativePipPresentationFixture::DeliverRecord() {
+  if (!record_ || !completed_) return;
+  auto record = std::move(*record_);
+  record_.reset();
+  auto reply = std::move(completed_);
+  consumed_ = true;
+  // Never cross an external RPC callback from an original pre-Show, native
+  // paint, Widget destructor, or compositor observer stack. Original hardware
+  // stamps are retained, and original owner/deadline still bracket delivery.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce([](base::WeakPtr<NativePipPresentationFixture> fixture,
+                       Reply reply, base::DictValue record) {
+        if (!fixture) {
+          record.Set("status", "refused");
+          record.Set("reason", "fixture_retired_before_reply");
+          record.Set("measured", false);
+        } else if (!fixture->WithinDeadline() || !fixture->StableShell() ||
+                   (fixture->measured_ && !fixture->StableSource())) {
+          if (!fixture) {
+            record.Set("status", "refused");
+            record.Set("reason", "fixture_retired_before_reply");
+          } else {
+            record.Set("status", "refused");
+            record.Set("reason", "original_scope_changed_before_reply");
+          }
+          record.Set("measured", false);
+        }
+        std::move(reply).Run(std::move(record));
+      }, weak_factory_.GetWeakPtr(), std::move(reply), std::move(record)));
+}
+void NativePipPresentationFixture::StopHardware() {
+  if (auto* compositor = compositor_.GetSource())
+    compositor->CancelNativeStockStartupHardwareObservation(nonce_);
+  compositor_.Reset();
+}
+void NativePipPresentationFixture::Refuse(const char* reason) {
+  if (refused_ || retired_) return;
+  refused_ = true;
+  measured_ = false;
+  StopHardware();
+  record_ = Record("refused", reason);
+  DeliverRecord();
+  // Keep actual Widget observation/identity and debt even after timeout/failure.
+}
+void NativePipPresentationFixture::PrimaryPageChanged(content::Page&) {
+  Refuse("original_pip_source_document_changed");
+}
+void NativePipPresentationFixture::WebContentsDestroyed() {
+  owner_.opener = nullptr;
+  if (!consumed_ || !measured_) Refuse("original_pip_source_destroyed_before_sample");
+  Observe(nullptr);
+}
+void NativePipPresentationFixture::OnWidgetDestroying(views::Widget* widget) {
+  if (widget_.GetSource() != widget) return;
+  destroying_ = true;
+  // Retire raw owner references before native/controller/child teardown. The
+  // opaque creation identity and exact observed Widget remain for destruction.
+  read_owner_.Reset();
+  owner_.opener = nullptr;
+  owner_.child = nullptr;
+  owner_.controller = nullptr;
+  StopHardware();
+  if (!consumed_ || !measured_) Refuse("original_pip_target_destroying_before_sample");
+}
+void NativePipPresentationFixture::OnWidgetDestroyed(views::Widget* widget) {
+  if (widget_.GetSource() != widget || !destroying_) return;
+  destroyed_ = base::TimeTicks::Now();
+  widget_.Reset();
+  target_.reset();
+  StopHardware();
+  // This genuine native destruction event is the only successful retirement
+  // witness. Hide, receipt replacement and fixture destruction never set it.
+}
+void NativePipPresentationFixture::OnWidgetVisibilityChanged(
+    views::Widget* widget, bool visible) {
+  if (widget_.GetSource() == widget && !visible && !consumed_)
+    Refuse("original_pip_target_hidden_before_sample");
+}
+void NativePipPresentationFixture::OnCompositingShuttingDown(ui::Compositor*) {
+  compositor_.Reset();
+  if (!consumed_) Refuse("original_pip_compositor_destroyed_before_sample");
+}
+void NativePipPresentationFixture::OnCompositorVisibilityChanging(
+    ui::Compositor*, bool visible) {
+  if (!visible && !consumed_) Refuse("original_pip_compositor_hidden_before_sample");
+}
+base::DictValue NativePipPresentationFixture::RetirementRecord(
+    const char* status, const char* reason) const {
+  auto result = Record(status, reason);
+  result.Set("producer", "aux-native-pip-root-retirement");
+  result.Set("nativeWidgetDestroyed", !destroyed_.is_null());
+  AppendNativePresentationTick(result, "destroyedUs", destroyed_);
+  return result;
+}
+bool NativePipPresentationFixture::HasRetired() const { return retired_; }
+void NativePipPresentationFixture::Retire(Reply retired) {
+  auto refusal = RetirementRecord("refused", "original_widget_destruction_not_retired");
+  if (retired_ || !consumed_ || destroyed_.is_null() || !destroying_ ||
+      widget_.IsObserving() || target_ || !WithinDeadline() ||
+      destroyed_ < created_ || destroyed_ >= deadline_ || !StableShell()) {
+    std::move(retired).Run(std::move(refusal));
+    return;
+  }
+  retired_ = true;
+  timeout_.Stop();
+  if (ActiveFixture().get() == this) ActiveFixture().reset();
+  Observe(nullptr);
+  std::move(retired).Run(RetirementRecord("retired", "original_native_widget_destroyed"));
+}
+}  // namespace aux
+#endif
