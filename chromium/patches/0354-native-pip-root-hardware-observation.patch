+  if (!window || window->GetController() != pip_window_controller_) return;
+  const auto original_widget = window->GetWeakPtr();
+  auto* const original_controller = window->GetController();
+  aux::ObserveNativePipCreatedForMeasurement(window, aux::NativePipSurfaceKind::kVideo,
+      base::BindRepeating([](PictureInPictureWindowManager* manager,
+          base::WeakPtr<views::Widget> original_widget,
+          content::PictureInPictureWindowController* original_controller)
+              -> std::optional<aux::NativePipOwner> {
+        if (!original_widget || manager->pip_window_controller_ != original_controller)
+          return std::nullopt;
+        auto* window = static_cast<VideoOverlayWindowViews*>(original_widget.get());
+        if (window->GetController() != original_controller) return std::nullopt;
+        auto* opener = original_controller->GetWebContents();
+        if (!opener || opener->IsBeingDestroyed()) return std::nullopt;
+        return aux::NativePipOwner{Profile::FromBrowserContext(opener->GetBrowserContext()),
+                                  opener, nullptr, original_controller};
+      }, base::Unretained(this), original_widget, original_controller));
+}
+void PictureInPictureWindowManager::ObserveNativeDocumentCreationForMeasurement(
+    DocumentPipHost* host) {
+  if (!host || !host->GetWidget() || !pip_window_controller_ ||
+      host->GetOpenerWebContents() != pip_window_controller_->GetWebContents() ||
+      host->GetChildWebContents() != pip_window_controller_->GetChildWebContents()) return;
+  const auto original_host = host->GetWeakPtr();
+  const auto original_widget = host->GetWidget()->GetWeakPtr();
+  auto* const original_controller = pip_window_controller_.get();
+  aux::ObserveNativePipCreatedForMeasurement(host->GetWidget(),
+      aux::NativePipSurfaceKind::kDocument,
+      base::BindRepeating([](PictureInPictureWindowManager* manager,
+          base::WeakPtr<DocumentPipHost> original_host,
+          base::WeakPtr<views::Widget> original_widget,
+          content::PictureInPictureWindowController* original_controller)
+              -> std::optional<aux::NativePipOwner> {
+        if (!original_host || !original_widget ||
+            manager->pip_window_controller_ != original_controller ||
+            original_host->GetWidget() != original_widget.get() ||
+            original_host->GetOpenerWebContents() != original_controller->GetWebContents() ||
+            original_host->GetChildWebContents() != original_controller->GetChildWebContents())
+          return std::nullopt;
+        return aux::NativePipOwner{original_host->GetProfile(),
+            original_host->GetOpenerWebContents(), original_host->GetChildWebContents(),
+            original_controller};
+      }, base::Unretained(this), original_host, original_widget, original_controller));
+}
