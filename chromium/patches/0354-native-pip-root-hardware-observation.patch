+bool RootView::ObserveNativeRootPaintForTesting(NativeRootPaintCallback callback) {
+  if (native_root_paint_used_ || callback.is_null() || !widget_ ||
+      widget_->GetRootView() != this) {
+    return false;
+  }
+  native_root_paint_used_ = true;
+  native_root_paint_callback_ = std::move(callback);
+  return true;
+}
+
+bool RootView::BeginNativeRootPaintForTesting() {
+  if (native_root_paint_in_progress_) {
+    native_root_paint_ambiguous_ = true;
+    return false;
+  }
+  native_root_paint_in_progress_ = true;
+  return true;
+}
+
+void RootView::PaintChildren(const PaintInfo& info) {
+  if (!native_root_paint_in_progress_ ||
+      native_root_paint_callback_.is_null() || native_root_paint_observation_) {
+    View::PaintChildren(info);
+    return;
+  }
+  const auto self = weak_factory_.GetWeakPtr();
+  const auto original_bounds = GetLocalBounds();
+  const auto recording = info.paint_recording_bounds();
+  const float scale = info.context().device_scale_factor();
+  const bool valid_scale = scale > 0 && std::isfinite(scale);
+  const auto expected_recording_size = valid_scale
+      ? (info.IsPixelCanvas()
+             ? gfx::ScaleToCeiledSize(original_bounds.size(), scale)
+             : original_bounds.size())
+      : gfx::Size();
+  const bool complete = recording.size() == expected_recording_size &&
+      info.ShouldPaint() && recording.origin() == gfx::Point() &&
+      !original_bounds.IsEmpty() &&
+      (!info.context().CanCheckInvalid() ||
+       info.context().InvalidationForTesting().Contains(recording));
+  const auto pixels = valid_scale
+      ? (info.IsPixelCanvas() ? recording.size()
+                             : gfx::ScaleToCeiledSize(recording.size(), scale))
+      : gfx::Size();
+  // Original paint order remains unchanged. No external completion is invoked
+  // while View::PaintFromPaintRoot may still access this view for debug paint.
+  View::PaintChildren(info);
+  if (!self || native_root_paint_callback_.is_null() ||
+      native_root_paint_observation_ || !widget_ ||
+      widget_->GetRootView() != this) {
+    return;
+  }
+  const bool visible = widget_->IsVisible();
+  if (!self || !visible || !widget_ || widget_->GetRootView() != this) {
+    return;
+  }
+  native_root_paint_observation_ = NativeRootPaintObservation{
+      base::TimeTicks(), gfx::Rect(pixels), scale,
+      complete && GetLocalBounds() == original_bounds && valid_scale &&
+          !pixels.IsEmpty()};
+}
+
+void RootView::CompleteNativeRootPaintForTesting() {
+  native_root_paint_in_progress_ = false;
+  if (!native_root_paint_observation_ ||
+      native_root_paint_callback_.is_null()) {
+    return;
+  }
+  auto observation = std::move(*native_root_paint_observation_);
+  observation.ready = base::TimeTicks::Now();
+  observation.entire_client_painted &= !native_root_paint_ambiguous_;
+  native_root_paint_observation_.reset();
+  auto callback = std::move(native_root_paint_callback_);
+  // Widget calls this only after the original whole paint returns. Delivery is
+  // still in the same UpdateLayers pipeline; no member access follows it.
+  std::move(callback).Run(std::move(observation));
+}
