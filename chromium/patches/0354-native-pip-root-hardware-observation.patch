diff --git a/chrome/browser/ui/aux/native_pip_presentation_fixture_unittest.cc b/chrome/browser/ui/aux/native_pip_presentation_fixture_unittest.cc
new file mode 100644
index 0000000..99e2924
--- /dev/null
+++ b/chrome/browser/ui/aux/native_pip_presentation_fixture_unittest.cc
@@ -0,0 +1,131 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_pip_presentation_fixture.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS) && BUILDFLAG(ENABLE_AUX_SHELL)
+#include <memory>
+#include "base/functional/bind.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/views/test/views_test_base.h"
+#include "ui/views/widget/widget.h"
+namespace aux {
+// Actual Widget lifecycle tests with an explicitly synthetic observer binding.
+// There is NO admitted shell/source, ready setter, hardware/frame ACK or sample.
+class NativePipPresentationFixtureLifetimeTest : public views::ViewsTestBase {
+ public:
+  NativePipPresentationFixtureLifetimeTest()
+      : ViewsTestBase(base::test::TaskEnvironment::TimeSource::MOCK_TIME) {}
+ protected:
+  std::unique_ptr<views::Widget> CreateWindow() {
+    auto widget = std::make_unique<views::Widget>();
+    auto params = CreateParams(views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+                              views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.bounds = gfx::Rect(0, 0, 100, 80);
+    widget->Init(std::move(params));
+    widget->SetContentsView(std::make_unique<views::View>());
+    return widget;
+  }
+  void BindLifecycleOnly(NativePipPresentationFixture& fixture,
+                         views::Widget* original) {
+    fixture.target_ = original->GetWeakPtr();
+    fixture.widget_.Observe(original);
+    fixture.created_ = base::TimeTicks::Now();
+    fixture.widget_receipt_ = base::UnguessableToken::Create();
+  }
+  void CheckHiddenIsNotDestruction() {
+    NativePipPresentationFixture fixture{base::WeakPtr<WebUIBrowserUI>()};
+    auto original = CreateWindow();
+    BindLifecycleOnly(fixture, original.get());
+    original->Show();
+    original->Hide();
+    EXPECT_TRUE(fixture.destroyed_.is_null());
+    EXPECT_TRUE(fixture.target_);
+    EXPECT_TRUE(fixture.widget_.IsObserving());
+    original.reset();
+    EXPECT_FALSE(fixture.destroyed_.is_null());
+    EXPECT_TRUE(fixture.destroying_);
+    EXPECT_FALSE(fixture.target_);
+    EXPECT_FALSE(fixture.widget_.IsObserving());
+    base::test::TestFuture<base::DictValue> reply;
+    fixture.Retire(reply.GetCallback());
+    // The real destruction alone never fabricates source/sample authority.
+    EXPECT_EQ(reply.Get().FindBool("nativeWidgetDestroyed"), true);
+    EXPECT_EQ(*reply.Get().FindString("status"), "refused");
+  }
+  void CheckForeignWindowCannotRetireOriginal() {
+    NativePipPresentationFixture fixture{base::WeakPtr<WebUIBrowserUI>()};
+    auto original = CreateWindow();
+    auto foreign = CreateWindow();
+    BindLifecycleOnly(fixture, original.get());
+    foreign.reset();
+    EXPECT_TRUE(fixture.destroyed_.is_null());
+    EXPECT_EQ(fixture.widget_.GetSource(), original.get());
+    original.reset();
+    EXPECT_FALSE(fixture.destroyed_.is_null());
+  }
+  void CheckReceiptDestructionIsNotWindowDestruction() {
+    auto original = CreateWindow();
+    const auto original_weak = original->GetWeakPtr();
+    auto fixture = std::make_unique<NativePipPresentationFixture>(
+        base::WeakPtr<WebUIBrowserUI>());
+    BindLifecycleOnly(*fixture, original.get());
+    EXPECT_TRUE(fixture->destroyed_.is_null());
+    fixture.reset();
+    EXPECT_TRUE(original_weak);
+    original.reset();
+    EXPECT_FALSE(original_weak);
+  }
+  void CheckExactOriginalDeadline() {
+    NativePipPresentationFixture fixture{base::WeakPtr<WebUIBrowserUI>()};
+    // Pure original-clock predicate control, not an admitted trial.
+    fixture.armed_ = base::TimeTicks::Now();
+    fixture.deadline_ = fixture.armed_ + base::Seconds(5);
+    EXPECT_TRUE(fixture.WithinDeadline());
+    task_environment()->FastForwardBy(base::Seconds(5));
+    EXPECT_FALSE(fixture.WithinDeadline());
+    task_environment()->FastForwardBy(base::Seconds(1));
+    EXPECT_FALSE(fixture.WithinDeadline());
+  }
+};
+TEST_F(NativePipPresentationFixtureLifetimeTest, HideIsNotNativeWidgetDestruction) {
+  CheckHiddenIsNotDestruction();
+}
+TEST_F(NativePipPresentationFixtureLifetimeTest, ForeignWindowDestructionCannotRetireOriginal) {
+  CheckForeignWindowCannotRetireOriginal();
+}
+TEST_F(NativePipPresentationFixtureLifetimeTest, ReceiptDestructionKeepsOriginalWidgetAlive) {
+  CheckReceiptDestructionIsNotWindowDestruction();
+}
+TEST_F(NativePipPresentationFixtureLifetimeTest, ExactFiveSecondDeadlineNeverRefreshes) {
+  CheckExactOriginalDeadline();
+}
+TEST_F(NativePipPresentationFixtureLifetimeTest, MissingSourceNeverInventsReadyOrHardware) {
+  NativePipPresentationFixture fixture{base::WeakPtr<WebUIBrowserUI>()};
+  base::test::TestFuture<base::DictValue> ready;
+  fixture.Prepare(ready.GetCallback());
+  EXPECT_EQ(*ready.Get().FindString("status"), "refused");
+  EXPECT_EQ(ready.Get().FindBool("measured"), false);
+  EXPECT_FALSE(ready.Get().contains("targetWidgetReceipt"));
+  EXPECT_FALSE(ready.Get().contains("elapsedUs"));
+  base::test::TestFuture<base::DictValue> complete;
+  fixture.Complete(complete.GetCallback());
+  EXPECT_EQ(*complete.Get().FindString("status"), "refused");
+  EXPECT_EQ(complete.Get().FindBool("measured"), false);
+}
+TEST_F(NativePipPresentationFixtureLifetimeTest, ReadyRefusalMayDestroyFixture) {
+  auto fixture = std::make_unique<NativePipPresentationFixture>(
+      base::WeakPtr<WebUIBrowserUI>());
+  unsigned replies = 0;
+  fixture->Prepare(base::BindOnce(
+      [](std::unique_ptr<NativePipPresentationFixture>* owner,
+         unsigned* replies, base::DictValue actual) {
+        ++*replies;
+        EXPECT_EQ(*actual.FindString("status"), "refused");
+        owner->reset();
+      }, &fixture, &replies));
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(fixture);
+  EXPECT_EQ(replies, 1u);
+}
+}  // namespace aux
+#endif
