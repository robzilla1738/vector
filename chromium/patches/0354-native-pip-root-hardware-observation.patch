+  void Refuse(const char* reason);
+  void StopHardware();
+  void DeliverRecord();
+  base::DictValue Record(const char* status, const char* reason) const;
+  base::DictValue RetirementRecord(const char* status, const char* reason) const;
+
+  base::WeakPtr<WebUIBrowserUI> source_;
+  base::WeakPtr<BrowserWindowInterface> source_browser_;
+  std::optional<NativeGuestStageOwnedSnapshot> shell_owner_;
+  base::WeakPtr<content::WebContents> opener_;
+  content::WeakDocumentPtr opener_document_, child_document_;
+  std::string page_id_;
+  NativePipOwner owner_;
+  NativePipAppearanceRegistry::OwnerReader read_owner_;
+  NativePipSurfaceKind kind_ = NativePipSurfaceKind::kVideo;
+  base::WeakPtr<views::Widget> target_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> widget_{this};
+  base::ScopedObservation<ui::Compositor, ui::CompositorObserver> compositor_{this};
+  base::UnguessableToken nonce_, widget_receipt_;
+  viz::SurfaceId root_;
+  gfx::Rect bounds_;
