+      !RegisterIsolation(page, isolation_id, run_id, String(params, "taskId"), revision,
+                         ancestry, connection_generation, true))
+    return Fault("Original Profile partition admission failed");
+  borrowed_sessions_.emplace(page_id, std::make_pair(token, std::move(original_current)));
