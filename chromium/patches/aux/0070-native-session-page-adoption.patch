+  const std::string run_id = String(params, "runId");
+  const std::string token = String(params, "token");
+  const int revision = params.FindInt("taskRevision").value_or(-1);
+  if (!page || page->GetBrowserContext() != profile_ || profile_->IsOffTheRecord() ||
+      !original_current || !original_current.Run() || !source || !chain ||
+      run_id.empty() || token.empty() || revision < 0)
+    return Fault("Original session admission is unavailable");
+  auto before = Context(base::DictValue().Set("tabId", String(*source, "tabId"))
+      .Set("expectedUrl", String(*source, "expectedUrl")));
+  const auto* context = before.FindDict("result");
+  if (!context || context->FindBool("personControlled").value_or(true) ||
+      String(*context, "documentToken") != String(*source, "documentToken"))
+    return Fault("Original session document changed");
+  const std::string page_id = String(*source, "tabId");
+  std::vector<std::string> ancestry;
+  for (const auto& value : *chain) {
+    if (!value.is_string()) return Fault("Original ancestry is invalid");
+    ancestry.push_back(value.GetString());
+  }
+  if (context->FindDict("isolation")) {
+    const auto borrowed = borrowed_sessions_.find(page_id);
