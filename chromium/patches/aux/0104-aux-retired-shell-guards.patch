-void WebUIBrowserUI::ReleaseAuxEvidenceDocuments(
-    const std::string& selection_id,
-    const std::shared_ptr<std::atomic_bool>& runtime_owner) {
-  if (!evidence_document_selection_ ||
-      evidence_document_selection_->id != selection_id ||
-      (runtime_owner &&
-       (!evidence_document_selection_->snapshot ||
-        !evidence_document_selection_->snapshot->OwnsRead(runtime_owner)))) {
-    return;
-  }
-  // Detach the selection before settling its callback: a replacement picker or
-  // read started from that callback must never inherit the retired selection.
-  auto retired = std::move(evidence_document_selection_);
-  evidence_document_selection_.reset();
-  retired.reset();
-}
