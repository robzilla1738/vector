-void WebUIBrowserUI::ReadAuxEvidenceDocument(
-    const std::string& selection_id,
-    double index,
-    std::optional<std::string> cursor,
-    RequestCallback callback,
-    std::shared_ptr<std::atomic_bool> runtime_owner) {
-  if (!EvidenceDocumentsCurrent(selection_id)) {
-    ReleaseAuxEvidenceDocuments(selection_id);
-    std::move(callback).Run(false, "", "ref_stale",
-                            "Original document selection is unavailable");
-    return;
-  }
-  auto& selection = *evidence_document_selection_;
-  if (!std::isfinite(index) || index < 0 || std::floor(index) != index ||
-      index > 9007199254740991.0 ||
-      index >= static_cast<double>(selection.paths.size())) {
-    std::move(callback).Run(false, "", "invalid_argument",
-                            "Document selection index is out of range");
-    return;
-  }
-  const size_t selected = static_cast<size_t>(index);
-  if (selection.current_index && selected < *selection.current_index) {
-    std::move(callback).Run(false, "", "ref_stale",
-                            "Original document snapshot retired");
-    return;
-  }
-  if (!selection.current_index || *selection.current_index != selected) {
-    if (cursor) {
-      std::move(callback).Run(false, "", "ref_stale",
-                              "Original document cursor retired");
-      return;
-    }
-    auto retired_snapshot = std::move(selection.snapshot);
-    selection.current_index = selected;
-    selection.snapshot = std::make_unique<aux::EvidenceDocumentSnapshot>(
-        web_ui()->GetWebContents(), selection.paths[selected],
-        base::BindRepeating(
-            [](base::WeakPtr<WebUIBrowserUI> owner, std::string id,
-               size_t selected) {
-              return owner && owner->EvidenceDocumentsCurrent(id) &&
-                     owner->evidence_document_selection_->current_index ==
-                         selected;
-            },
-            weak_factory_.GetWeakPtr(), selection_id, selected));
-    const auto weak = weak_factory_.GetWeakPtr();
-    retired_snapshot.reset();
-    if (!weak || !EvidenceDocumentsCurrent(selection_id) ||
-        evidence_document_selection_->current_index != selected) {
-      std::move(callback).Run(false, "", "ref_stale",
-                              "Original document selection retired");
-      return;
-    }
-  }
-  evidence_document_selection_->snapshot->Read(cursor, std::move(callback),
-                                               std::move(runtime_owner));
-}
-void WebUIBrowserUI::ReadAuxEvidenceDocumentBytes(
-    const std::string& selection_id, double index,
-    const std::string& snapshot_id, const std::string& source_sha256,
-    uint32_t offset, RequestCallback callback,
-    std::shared_ptr<std::atomic_bool> runtime_owner) {
-  if (!EvidenceDocumentsCurrent(selection_id) || !std::isfinite(index) || index < 0 ||
-      std::floor(index) != index || index > 9007199254740991.0 ||
-      !evidence_document_selection_->current_index ||
-      static_cast<double>(*evidence_document_selection_->current_index) != index ||
-      !evidence_document_selection_->snapshot) {
-    std::move(callback).Run(false, "", "ref_stale", "Original document selection is unavailable");
-    return;
-  }
-  evidence_document_selection_->snapshot->ReadOriginal(
-      snapshot_id, source_sha256, offset, std::move(callback), std::move(runtime_owner));
