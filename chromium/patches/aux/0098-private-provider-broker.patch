+void AuxRuntimeHost::InvalidatePrivateProviders() {
+  if (profile_->IsOffTheRecord()) return;
+  // Do not create a host or reconnect a retired private worker to send an invalidation.
+  for (auto* profile : profile_->GetAllOffTheRecordProfiles()) {
+    auto* host = static_cast<AuxRuntimeHost*>(profile->GetUserData(&kAuxRuntimeHostKey));
+    if (host && host->runtime_connected_ && !host->shutting_down_ &&
+        host->profile_->GetOriginalProfile() == profile_) {
+      host->worker_.AsyncCall(&Worker::SendPrivateProviderChanged)
+          .WithArgs(host->admitted_native_generation_);
+    }
+  }
+}
