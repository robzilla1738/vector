+void AuxRuntimeHost::HandlePrivateProviderCall(const base::DictValue& params, uint64_t generation,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (!profile_->IsOffTheRecord() || private_session_id_.empty() ||
+      !DeviceConfirmationConnectionCurrent(generation)) {
+    std::move(callback).Run(NativeFault("permission_denied", "An original private runtime is required")); return;
+  }
+  const auto* operation = params.FindString("operation");
+  if (!operation || ((*operation != "describe" || params.size() != 1) &&
+      (*operation != "credential" || params.size() != 2 || !params.FindString("revision")))) {
+    std::move(callback).Run(NativeFault("invalid_params", "Exact private credential request is required")); return;
+  }
+  auto* original = ForProfile(profile_->GetOriginalProfile());
+  if (!original) { std::move(callback).Run(NativeFault("cancelled", "Original credential Profile is unavailable")); return; }
+  const auto json = base::WriteJson(base::DictValue().Set("sessionId", private_session_id_).Set("request", params.Clone()));
+  original->CallInternal("provider.private", *json, base::BindOnce(
+      [](base::WeakPtr<AuxRuntimeHost> owner, base::WeakPtr<AuxRuntimeHost> original, uint64_t generation,
+         base::OnceCallback<void(base::DictValue)> callback, Response response) {
+        if (!owner || !original || !owner->DeviceConfirmationConnectionCurrent(generation) ||
+            owner->profile_->GetOriginalProfile() != original->profile_ || original->shutting_down_) {
+          std::move(callback).Run(NativeFault("cancelled", "Original private credential ownership retired")); return;
+        }
+        if (!response.ok) {
+          std::move(callback).Run(NativeFault(response.error_code, response.error_message)); return;
+        }
+        auto result = base::JSONReader::Read(response.result_json, base::JSON_PARSE_RFC);
+        if (!result || !result->is_dict()) {
+          std::move(callback).Run(NativeFault("backend_unavailable", "Original provider returned an invalid credential reply")); return;
+        }
+        std::move(callback).Run(NativeResult(std::move(*result)));
+      }, weak_factory_.GetWeakPtr(), original->GetWeakPtr(), generation, std::move(callback)));
 }
 
