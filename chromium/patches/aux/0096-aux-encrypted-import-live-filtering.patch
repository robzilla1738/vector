+bool BlockWebSocket(content::RenderFrameHost* frame, const GURL& url) {
+  if (!frame) {
+    return false;
+  }
+  auto* service = FilterService::Get(
+      Profile::FromBrowserContext(frame->GetBrowserContext()));
+  if (!service->ready()) {
+    return true;
+  }
+  const auto decision = service->Evaluate(
+      MakeRequest(url, frame->GetLastCommittedOrigin().GetURL(), "websocket"));
+  // A WebSocket cannot safely consume resource redirects or query rewrites.
+  return decision.block || !decision.redirect.empty() ||
+         !decision.rewritten_url.empty();
+}
