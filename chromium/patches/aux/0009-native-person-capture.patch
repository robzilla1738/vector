+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_PERSON_CAPTURE_CONTROLLER_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_PERSON_CAPTURE_CONTROLLER_H_
+#include <string>
+#include <vector>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+namespace aux {
+// Only the authenticated runtime host may supply this original native guard.
+// One outstanding operation owns all masks until their same-document cleanup.
+class NativePersonCaptureController final : public content::WebContentsObserver,
+    public content::WebContentsUserData<NativePersonCaptureController> {
+ public:
+  using Reply = base::OnceCallback<void(base::DictValue)>;
+  ~NativePersonCaptureController() override;
+  void Capture(base::DictValue identity, base::RepeatingCallback<bool()> current, Reply reply);
+  void Retire();
+  base::WeakPtr<NativePersonCaptureController> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+ private:
+  friend class NativePersonCaptureControllerTestPeer;
+  friend class content::WebContentsUserData<NativePersonCaptureController>;
+  explicit NativePersonCaptureController(content::WebContents* contents);
+  bool Current();
+  void Dispatch(const std::string& phase);
+  void ScriptDone(std::string phase, size_t index, bool accepted);
+  void Paint();
+  void PaintRoot();
+  void Submitted(size_t index, base::WeakPtr<content::RenderWidgetHostImpl> widget, uint32_t token);
+  void Activated(size_t index, base::WeakPtr<content::RenderWidgetHostImpl> widget, uint32_t token, base::TimeTicks time);
+  void Painted(bool accepted);
+  void Copy();
+  void Copied(const content::CopyFromSurfaceResult& result);
+  void Cleanup();
+  void Deadline();
+  void Finish();
+  void WebContentsDestroyed() override;
+  std::vector<content::WeakDocumentPtr> frames_;
+  std::vector<viz::SurfaceId> surfaces_;
+  std::vector<uint32_t> submission_tokens_;
+  std::vector<gfx::Size> widget_viewports_;
+  std::vector<gfx::Size> widget_pixel_viewports_;
+  std::vector<base::WeakPtr<content::RenderWidgetHostImpl>> widgets_;
+  std::string capture_id_;
+  base::DictValue identity_;
+  base::RepeatingCallback<bool()> current_;
+  Reply reply_;
+  size_t pending_ = 0;
+  bool failed_ = false;
+  bool cleanup_debt_ = false;
+  bool restoring_ = false;
+  bool root_submission_ = false;
+  std::string png_;
+  int width_ = 0, height_ = 0;
+  int viewport_width_ = 0, viewport_height_ = 0;
+  gfx::Size viewport_pixels_;
+  double scale_ = 0;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<NativePersonCaptureController> weak_factory_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+}
+#endif
diff --git a/chrome/common/aux_person_capture_mask.h b/chrome/common/aux_person_capture_mask.h
new file mode 100644
index 0000000000..2f893ea57a
--- /dev/null
+++ b/chrome/common/aux_person_capture_mask.h
@@ -0,0 +1,102 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_COMMON_AUX_PERSON_CAPTURE_MASK_H_
+#define CHROME_COMMON_AUX_PERSON_CAPTURE_MASK_H_
+namespace aux::person_capture_mask {
+inline constexpr char16_t kProgram[] = uR"AUXMASK(// Fixed browser-owned isolated-world program; no caller script or selector.
+// Browser must retain each original frame WeakDocument, wait for its paint ACK,
+// and restore these same documents before exporting any captured pixels.
+(function(operation, captureId) {
+  'use strict';
+  const key = '__auxPersonCaptureOriginalMask';
+  if (!/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/.test(captureId)) return false;
+  if (operation === 'begin') {
+    if (globalThis[key]) return false;
+    if (!document.documentElement || document.designMode.toLowerCase() !== 'off') return false;
+    const elements = [], roots = [document], allRoots = [];
+    let examined = 0;
+    while (roots.length) {
+      const root = roots.pop(); allRoots.push(root);
+      for (const node of root.querySelectorAll('*')) {
+        if (++examined > 10000 || elements.length >= 2000 || allRoots.length > 64) return false;
+        if (node.shadowRoot) roots.push(node.shadowRoot);
+        // Custom elements may contain closed shadow roots. Mask the entire
+        // host conservatively; its descendants cannot override group opacity.
+        if (node.matches('input,textarea,select,[contenteditable]') || node.localName.includes('-')) {
+          if (getComputedStyle(node).display === 'contents') return false;
+          elements.push(node);
+        }
+      }
+    }
+    const originals = elements.map(node => ({node, style:node.getAttribute('style'), maskedStyle:node.getAttribute('style'), foreignStyle:false}));
+    const state = {captureId, originals, dirty:false, observer:null};
+    const foreign = records => {
+      if (records.length) state.dirty = true;
+      for (const record of records) if (record.type === 'attributes' && record.attributeName === 'style') {
+        const item = originals.find(item => item.node === record.target);
+        if (item) item.foreignStyle = true;
+      }
+    };
+    state.foreign = foreign;
+    globalThis[key] = state;
+    try {
+      // Start before a style write may synchronously invoke author custom
+      // element callbacks. Only the exact single original style mutation is
+      // our write; every other begin-time mutation refuses pixel export.
+      state.observer = new MutationObserver(foreign);
+      for (const root of allRoots) state.observer.observe(root,{subtree:true,childList:true,attributes:true,attributeOldValue:true,characterData:true});
+      for (const item of originals) {
+        const before = item.node.getAttribute('style');
+        const maskStyle = document.createElement('span').style;
+        maskStyle.cssText = before || '';
+        for (const [property,value] of [['transition','none'],['animation','none'],['opacity','0']]) maskStyle.setProperty(property,value,'important');
+        // A real attribute write invokes the original custom-element reactions.
+        // Build all three masking declarations off-node so no intermediate
+        // transition or animation can escape before the original write.
+        item.node.setAttribute('style',maskStyle.cssText);
+        const records = state.observer.takeRecords();
+        const ownIndex = records.findIndex(record => record.type === 'attributes' && record.attributeName === 'style' && record.target === item.node && record.oldValue === before);
+        foreign(records.filter((record,index) => index !== ownIndex));
+        item.maskedStyle = item.node.getAttribute('style');
+        for (const property of ['transition','animation','opacity']) if (item.node.style.getPropertyPriority(property) !== 'important') { state.dirty = true; item.foreignStyle = true; }
+      }
+      return !state.dirty && originals.every(item => getComputedStyle(item.node).opacity === '0');
+    } catch {
