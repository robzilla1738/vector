+void ChromeContentBrowserClient::ReviewNativePopupCreation(
+    content::RenderFrameHost* opener,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    bool effective_user_gesture,
+    bool opener_suppressed,
+    base::OnceCallback<void(bool)> callback) {
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+  if (!opener) {
+    std::move(callback).Run(false);
+    return;
+  }
+  // The compiler's hidden resource-only isolate has no popup/window authority.
+  if (aux::IsSemanticFilterPartition(
+          opener->GetProcess()->GetStoragePartition()->GetConfig())) {
+    std::move(callback).Run(false);
+    return;
+  }
+  const GURL& root_url = opener->GetOutermostMainFrame()->GetLastCommittedURL();
+  // The original native Aux shell is browser UI, not list-filtered page
+  // content.
+  if (root_url.SchemeIs(content::kChromeUIScheme) &&
+      root_url.host() == chrome::kChromeUIAuxHost) {
+    std::move(callback).Run(true);
+    return;
+  }
+  aux::ContentBlockingController::ForProfile(
+      Profile::FromBrowserContext(opener->GetBrowserContext()))
+      ->ReviewPopupCreation(opener, target_url, disposition,
+                            std::move(callback));
+#else
+  std::move(callback).Run(true);
+#endif
+}
