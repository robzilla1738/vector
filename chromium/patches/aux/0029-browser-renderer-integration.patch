+      GetAuxZapStylesheets().Update(
+          origin, sequence, stylesheet,
+          AuxZapStylesheetRegistry::Clock::now()) !=
+          AuxZapStylesheetRegistry::Result::kAccepted) {
+    std::move(callback).Run(false, false);
+    return;
+  }
+  WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame || frame->GetDocument().IsNull() ||
+      frame->GetDocument().GetSecurityOrigin().ToString().Utf8() != origin) {
+    std::move(callback).Run(true, false);
+    return;
+  }
+  std::move(callback).Run(true, ApplyAuxZapStylesheet());
+}
+
+bool ChromeRenderFrameObserver::ApplyAuxZapStylesheet() {
+  WebLocalFrame* frame = render_frame()->GetWebFrame();
+  if (!frame)
+    return false;
+  blink::WebDocument document = frame->GetDocument();
+  if (document.IsNull())
+    return false;
+  if (!aux_zap_applied_origin_.empty()) {
+    document.RemoveInsertedStyleSheet(aux_zap_applied_key_,
+                                      blink::WebCssOrigin::kUser);
+    aux_zap_applied_origin_.clear();
+    aux_zap_applied_key_ = blink::WebStyleSheetKey();
+  }
+  const std::string origin =
+      document.GetSecurityOrigin().ToString().Utf8();
+  const std::string* stylesheet = GetAuxZapStylesheets().Find(origin);
+  if (!stylesheet)
+    return false;
+  aux_zap_applied_key_ = document.InsertStyleSheet(
+      WebString::FromUtf8(*stylesheet), nullptr,
+      blink::WebCssOrigin::kUser);
+  aux_zap_applied_origin_ = origin;
+  return true;
+}
