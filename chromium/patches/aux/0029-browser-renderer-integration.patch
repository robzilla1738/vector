+bool IsProtectedPage(Profile* profile, content::WebContents* contents,
+                     bool presenting_stage = false) {
+  auto* identity = contents ? aux::PageIdentity::FromWebContents(contents) : nullptr;
+  if (!identity || identity->runtime_owned() || !contents->GetPrimaryMainFrame()) return true;
+  aux::EgressRequestContext context;
+  context.page_id = aux::PageIdentity::GetOrCreate(profile, contents);
+  context.document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  auto* controller = aux::EgressController::ForProfile(profile);
+  // Presentation does not grant request/DOM authority. The exact human tab
+  // remains visible after borrowing, while retained credential guards stay set.
+  if (presenting_stage && controller->CanPresentHumanSessionDocument(context))
+    return false;
+  return controller->IsProtected(context);
+}
+using Reply = base::OnceCallback<void(bool, const std::string&,
+                                     const std::string&, const std::string&)>;
+
+// The callback completes on the real media transition, not script scheduling.
+class PictureInPictureRequest final
+    : public content::WebContentsObserver,
+      public std::enable_shared_from_this<PictureInPictureRequest> {
+ public:
+  PictureInPictureRequest(content::WebContents* contents, bool enter,
+                          Reply reply)
+      : content::WebContentsObserver(contents), enter_(enter),
+        document_(contents->GetPrimaryMainFrame()->GetWeakDocumentPtr()),
+        reply_(std::move(reply)) {}
+
+  void Start() {
+    timer_.Start(FROM_HERE, base::Seconds(2),
+                 base::BindOnce(&PictureInPictureRequest::Finish,
+                                shared_from_this(), "picture-in-picture-timeout"));
+    if (!enter_) {
+      if (!PictureInPictureWindowManager::GetInstance()->ExitPictureInPicture())
+        Finish("picture-in-picture-exit-failed");
+      return;
+    }
+    auto* session = content::MediaSession::GetIfExists(web_contents());
+    if (session) {
+      const auto actions = session->GetMediaSessionActionsSync();
+      if (std::ranges::find(actions,
+              media_session::mojom::MediaSessionAction::kEnterPictureInPicture) !=
+          actions.end()) {
+        session->EnterPictureInPicture();
+        return;
+      }
+    }
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    if (!frame) { Finish("page-changed"); return; }
+    frame->NotifyUserActivation(
+        blink::mojom::UserActivationNotificationType::kInteraction);
+    frame->ExecuteJavaScriptInIsolatedWorld(
+        uR"JS((() => {
+          const candidates = [...document.querySelectorAll('video')]
+            .filter(video => !video.paused && !video.ended && video.readyState >= 2
+              && !video.disablePictureInPicture)
+            .map(video => ({ video, rect: video.getBoundingClientRect() }))
+            .filter(({video, rect}) => rect.width > 0 && rect.height > 0
+              && rect.bottom > 0 && rect.right > 0 && rect.top < innerHeight
+              && rect.left < innerWidth && getComputedStyle(video).visibility !== 'hidden'
+              && getComputedStyle(video).display !== 'none')
+            .sort((a, b) => b.rect.width * b.rect.height - a.rect.width * a.rect.height);
+          if (!candidates.length) return 'no-playing-video';
+          candidates[0].video.requestPictureInPicture().catch(() => {});
+          return 'requested';
+        })())JS",
+        base::BindOnce(&PictureInPictureRequest::ScriptScheduled,
+                       shared_from_this()),
+        ISOLATED_WORLD_ID_CHROME_INTERNAL);
+  }
+
+ private:
+  void ScriptScheduled(base::Value result) {
+    if (result.is_string() && result.GetString() == "no-playing-video")
+      Finish("no-playing-video");
+  }
+  void MediaPictureInPictureChanged(bool) override {
+    const bool active = web_contents()->HasPictureInPictureVideo() ||
+                        web_contents()->HasPictureInPictureDocument();
+    if (active == enter_) Finish("");
+  }
+  void PrimaryPageChanged(content::Page&) override { Finish("page-changed"); }
+  void WebContentsDestroyed() override { Finish("page-closed"); }
+  void Finish(std::string reason) {
+    if (!reply_) return;
+    auto keep_alive = shared_from_this();
+    timer_.Stop();
+    const bool unchanged = document_.AsRenderFrameHostIfValid() != nullptr;
+    const bool active = web_contents() &&
+        (web_contents()->HasPictureInPictureVideo() ||
+         web_contents()->HasPictureInPictureDocument());
+    base::DictValue result;
+    result.Set("active", active);
+    if (!reason.empty()) result.Set("reason", std::move(reason));
+    else if (!unchanged) result.Set("reason", "page-changed");
+    Observe(nullptr);
+    std::move(reply_).Run(true, *base::WriteJson(result), "", "");
+  }
+  bool enter_;
+  content::WeakDocumentPtr document_;
+  Reply reply_;
+  base::OneShotTimer timer_;
+};
