+void ChromeContentBrowserClient::CheckWebSocketConnection(content::RenderFrameHost* frame, content::ChildProcessId process_id, const GURL& url,
+    const url::Origin& original_origin, const net::IsolationInfo& original_isolation,
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> headers,
+    WebSocketConnectionCheck callback) {
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+  auto* process = content::RenderProcessHost::FromID(process_id);
+  if (process && aux::IsSemanticFilterPartition(
+                     process->GetStoragePartition()->GetConfig())) {
+    std::move(callback).Run(false, {}, {});
+    return;
+  }
+  auto* owner = process ? aux::ContentBlockingController::ForProfile(
+      Profile::FromBrowserContext(process->GetBrowserContext())) : nullptr;
+  if (!owner) {
+    std::move(callback).Run(false, {}, {});
+    return;
+  }
+  const bool had_frame = frame != nullptr;
+  const auto original_document = frame ? frame->GetWeakDocumentPtr() : content::WeakDocumentPtr();
+  owner->AdmitWebSocket(
+      frame, process_id.GetUnsafeValue(), original_origin, original_isolation,
+      url,
+      base::BindOnce(
+          [](ChromeContentBrowserClient* client,
+             content::ChildProcessId process_id,
+             content::WeakDocumentPtr original_document, bool had_frame,
+             mojo::PendingRemote<network::mojom::TrustedHeaderClient> headers,
+             WebSocketConnectionCheck callback,
+             aux::ContentBlockingController::OwnerCurrent engine_current,
+             base::WeakPtr<aux::SemanticFilterBridge> semantic_bridge,
+             aux::CaptureSemanticHeaderRequest semantic_capture,
+             GURL routed_url) {
+            auto* process = content::RenderProcessHost::FromID(process_id);
+            auto* frame = original_document.AsRenderFrameHostIfValid();
+            if (!process || (had_frame && !frame) || !engine_current ||
+                !engine_current.Run()) {
+              std::move(callback).Run(false, {}, {});
+              return;
+            }
+            // Engine and Project/egress are independent guards. Recheck the
+            // exact original Engine scope after an asynchronous Project
+            // admission too.
+            auto guarded_reply = base::BindOnce(
+                [](aux::ContentBlockingController::OwnerCurrent engine_current,
+                   base::WeakPtr<aux::SemanticFilterBridge> bridge,
+                   aux::CaptureSemanticHeaderRequest capture, GURL routed_url,
+                   WebSocketConnectionCheck callback, bool allowed,
+                   mojo::PendingRemote<network::mojom::TrustedHeaderClient>
+                       headers) {
+                  if (!allowed || !engine_current.Run()) {
+                    std::move(callback).Run(false, {}, {});
+                    return;
+                  }
+                  if (!bridge || !capture) {
+                    std::move(callback).Run(false, {}, {});
+                    return;
+                  }
+                  std::move(callback).Run(
+                      true,
+                      aux::WrapSemanticTrustedHeaders(
+                          *bridge, std::move(capture), std::move(headers)),
+                      routed_url);
+                },
+                std::move(engine_current), std::move(semantic_bridge),
+                std::move(semantic_capture), routed_url, std::move(callback));
+            const GURL actual_url = routed_url;
+            auto* partition = process->GetStoragePartition();
+            if (aux::NativeProjectPreview::IsPreviewPartition(partition)) {
+              auto preview = aux::NativeProjectPreview::ForPartition(partition);
+              if (!preview) {
+                std::move(guarded_reply).Run(false, {});
+                return;
+              }
+              preview->Admit(
+                  actual_url, false,
+                  base::BindOnce(
+                      [](base::WeakPtr<aux::NativeProjectPreview> preview,
+                         mojo::PendingRemote<
+                             network::mojom::TrustedHeaderClient> headers,
+                         base::OnceCallback<void(
+                             bool, mojo::PendingRemote<
+                                       network::mojom::TrustedHeaderClient>)>
+                             callback,
+                         bool allowed) {
+                        if (!allowed || !preview || !preview->Current()) {
+                          std::move(callback).Run(false, {});
+                          return;
+                        }
+                        std::move(callback).Run(
+                            true, aux::NativeProjectPreview::WrapHeaders(
+                                      preview, std::move(headers)));
+                      },
+                      preview, std::move(headers), std::move(guarded_reply)));
+              return;
+            }
+            const bool allowed = client->AllowUninspectableNetworkTransport(
+                process->GetBrowserContext(), frame, "websocket");
+            std::move(guarded_reply).Run(allowed, std::move(headers));
+          },
+          this, process_id, original_document, had_frame, std::move(headers),
+          std::move(callback)));
+#else
+  auto* original_process = content::RenderProcessHost::FromID(process_id);
+  const bool allowed = original_process && AllowUninspectableNetworkTransport(original_process->GetBrowserContext(), frame, "websocket");
+  std::move(callback).Run(allowed, std::move(headers), url);
+#endif
+}
