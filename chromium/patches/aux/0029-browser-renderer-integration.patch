+DocumentScriptTool ToolInfo(const blink::mojom::ScriptTool& tool) {
+  DocumentScriptTool info;
+  info.name = tool.name;
+  info.description = tool.description;
+  if (tool.title) {
+    info.title = tool.title;
+  }
+  if (tool.annotations) {
+    info.read_only = tool.annotations->read_only;
+    info.consequential = tool.annotations->consequential;
+  }
