+
+bool WebUIBrowserUI::CanDispatchAuxMenuShortcut(const std::string& command_id) const {
+  if (command_id != "new-chat" && command_id != "split-side-by-side" &&
+      command_id != "split-stacked")
+    return false;
+  if (!IsAuthorizedAuxDocument() || !shell_host_client_.is_bound() ||
+      browser_->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+      aux::IsQuickAskWindow(browser_) || aux::IsLittleWindow(browser_) ||
+      !browser_->GetTabStripModel()->GetActiveWebContents())
+    return false;
+  if (command_id == "new-chat")
+    return !browser_->GetProfile()->IsOffTheRecord();
+  return browser_->GetProfile()->GetOriginalProfile()->GetPrefs()
+      ->GetDict(aux::kLibraryFeatureOverridesPref)
+      .FindBool("splitView").value_or(true);
 }
 
