 bool BrowserCommandController::IsCommandEnabled(int id) const {
+#if BUILDFLAG(ENABLE_AUX_SHELL) && BUILDFLAG(IS_MAC)
+  if ((id == IDC_AUX_NEW_CHAT || id == IDC_AUX_SPLIT_SIDE_BY_SIDE ||
+       id == IDC_AUX_SPLIT_STACKED) && !CanExecuteAuxMenuCommand(id))
+    return false;
+#endif
   return command_updater_->IsCommandEnabled(id);
 }
+
+#if BUILDFLAG(ENABLE_AUX_SHELL) && BUILDFLAG(IS_MAC)
+namespace {
+const char* AuxMenuShortcut(int command) {
+  switch (command) {
+    case IDC_AUX_NEW_CHAT:
+      return "new-chat";
+    case IDC_AUX_SPLIT_SIDE_BY_SIDE:
+      return "split-side-by-side";
+    case IDC_AUX_SPLIT_STACKED:
+      return "split-stacked";
+    default:
+      return nullptr;
+  }
+}
+}  // namespace
+
+bool BrowserCommandController::CanExecuteAuxMenuCommand(int command_id) const {
+  const char* shortcut = AuxMenuShortcut(command_id);
+  auto* window = WebUIBrowserWindow::FromBrowser(browser_);
+  auto* ui = window ? window->GetWebUIBrowserUI() : nullptr;
+  return shortcut && ui && ui->CanDispatchAuxMenuShortcut(shortcut);
+}
+
+bool BrowserCommandController::DispatchAuxMenuCommand(int command_id) {
+  if (!IsCommandEnabled(command_id))
+    return false;
+  auto* window = WebUIBrowserWindow::FromBrowser(browser_);
+  auto* ui = window ? window->GetWebUIBrowserUI() : nullptr;
+  const char* shortcut = AuxMenuShortcut(command_id);
+  return ui && shortcut && ui->DispatchAuxShortcut(shortcut, true);
+}
+
+void BrowserCommandController::UpdateAuxMenuCommands() {
+  UpdateCommandAndActionEnabled(IDC_AUX_NEW_CHAT, kActionAuxNewChat,
+                               CanExecuteAuxMenuCommand(IDC_AUX_NEW_CHAT));
+  UpdateCommandAndActionEnabled(
+      IDC_AUX_SPLIT_SIDE_BY_SIDE, kActionAuxSplitSideBySide,
+      CanExecuteAuxMenuCommand(IDC_AUX_SPLIT_SIDE_BY_SIDE));
+  UpdateCommandAndActionEnabled(IDC_AUX_SPLIT_STACKED, kActionAuxSplitStacked,
+                               CanExecuteAuxMenuCommand(IDC_AUX_SPLIT_STACKED));
+}
