@@ -131,6 +131,14 @@
   }
 
   private onCbdDialogClosed_() {
+    // Aux Library opens this native dialog directly. Keep its dismissal in the
+    // Library instead of exposing unrelated Chromium account/privacy settings.
+    if (loadTimeData.getBoolean('isAux') &&
+        new URLSearchParams(window.location.search).get('auxReturn') ===
+            'history') {
+      window.location.replace('chrome://history/');
+      return;
+    }
     Router.getInstance().navigateTo(routes.CLEAR_BROWSER_DATA.parent!);
 
     if (this.shouldShowDbdDeletionConfirmationToast_) {
