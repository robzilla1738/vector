+std::optional<base::DictValue> ContentBlockingController::Begin(
+    const base::DictValue& params,
+    std::string* error) {
+  if (commit_in_progress_) {
+    *error = "Content blocking snapshot commit is in progress";
+    return std::nullopt;
+  }
+  if (profile_->IsOffTheRecord()) {
+    *error = "Private Profiles cannot install filter lists";
+    return std::nullopt;
+  }
+  const std::string* profile_id = params.FindString("profileId");
+  const std::string* digest = params.FindString("hostsDigest");
+  const auto generation = params.FindDouble("generation");
+  const auto host_count = params.FindInt("hostCount");
+  const auto enabled = params.FindBool("enabled");
+  const base::ListValue* allowed = params.FindList("allowedSiteHosts");
+  const base::Value* guard_value = params.Find("siteGuard");
+  const base::DictValue* guard = params.FindDict("siteGuard");
+  if (!profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() || !digest ||
+      !ValidDigest(*digest) || !ValidGeneration(generation) ||
+      *generation <= rules_->generation || !host_count || *host_count < 0 ||
+      *host_count > static_cast<int>(kMaxHosts) || !enabled || !allowed ||
+      allowed->size() > kMaxAllowed) {
+    *error = "Invalid content blocking snapshot header";
+    return std::nullopt;
+  }
+  if (guard_value && (!guard || !SiteGuardMatches(profile_, *guard))) {
+    *error = "Content blocking page changed";
+    return std::nullopt;
+  }
+  auto staged = std::make_unique<Staging>();
+  staged->generation = *generation;
+  staged->digest = *digest;
+  staged->host_count = *host_count;
+  staged->enabled = *enabled;
+  staged->hosts.reserve(*host_count);
+  if (guard) {
+    staged->site_guard = guard->Clone();
+  }
+  for (const base::Value& value : *allowed) {
+    const std::string* host = value.GetIfString();
+    if (!host || !IsAllowedSiteHost(*host)) {
+      *error = "Invalid content blocking site exception";
+      return std::nullopt;
+    }
+    staged->allowed.insert(*host);
+  }
+  staging_ = std::move(staged);
+  return Accepted();
+}
+
+std::optional<base::DictValue> ContentBlockingController::Append(
+    const base::DictValue& params,
+    std::string* error) {
+  if (commit_in_progress_) {
+    *error = "Content blocking snapshot commit is in progress";
+    return std::nullopt;
+  }
+  const auto generation = params.FindDouble("generation");
+  const auto offset = params.FindInt("offset");
+  const std::string* profile_id = params.FindString("profileId");
+  const base::ListValue* hosts = params.FindList("hosts");
+  if (!staging_ || !profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() ||
+      !generation || *generation != staging_->generation || !offset ||
+      *offset != static_cast<int>(staging_->hosts.size()) || !hosts ||
+      hosts->empty() || hosts->size() > 1024 ||
+      staging_->hosts.size() + hosts->size() > staging_->host_count) {
+    staging_.reset();
+    *error = "Invalid content blocking snapshot chunk";
+    return std::nullopt;
+  }
+  for (const base::Value& value : *hosts) {
+    const std::string* host = value.GetIfString();
+    if (!host || !IsBlockingHost(*host) ||
+        (!staging_->hosts.empty() && staging_->hosts.back() >= *host)) {
+      staging_.reset();
+      *error = "Invalid content blocking host order";
+      return std::nullopt;
+    }
+    staging_->hosts.push_back(*host);
+  }
+  return Accepted();
+}
+
+bool ContentBlockingController::Persist(const base::FilePath& path,
+                                        const Staging& staging) {
+  base::DictValue root;
+  root.Set("generation", staging.generation);
+  root.Set("hostsDigest", staging.digest);
+  root.Set("enabled", staging.enabled);
+  base::ListValue hosts;
+  for (const auto& host : staging.hosts) {
+    hosts.Append(host);
+  }
+  root.Set("hosts", std::move(hosts));
+  base::ListValue allowed;
+  for (const auto& host : staging.allowed) {
+    allowed.Append(host);
+  }
+  root.Set("allowedSiteHosts", std::move(allowed));
+  const auto encoded = base::WriteJson(root);
+  const base::FilePath temp = path.AddExtension(FILE_PATH_LITERAL("tmp"));
+  if (!encoded || encoded->size() > kMaxSnapshotBytes ||
+      !base::CreateDirectory(path.DirName()) ||
+      !base::SetPosixFilePermissions(path.DirName(), 0700) ||
+      !base::WriteFile(temp, *encoded) ||
+      !base::SetPosixFilePermissions(temp, 0600) ||
+      !base::ReplaceFile(temp, path, nullptr)) {
+    base::DeleteFile(temp);
+    return false;
+  }
+  return true;
+}
+
+void ContentBlockingController::Commit(
+    const base::DictValue& params,
+    CommitCallback callback) {
+  const auto generation = params.FindDouble("generation");
+  const std::string* digest = params.FindString("hostsDigest");
+  const std::string* profile_id = params.FindString("profileId");
+  if (commit_in_progress_ || !staging_ || !generation ||
+      *generation != staging_->generation ||
+      !digest || *digest != staging_->digest || !profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() ||
+      staging_->hosts.size() != staging_->host_count ||
+      !IncludesBuiltInHosts(staging_->hosts) ||
+      Digest(JoinHosts(staging_->hosts)) != staging_->digest) {
+    staging_.reset();
+    std::move(callback).Run(std::nullopt,
+                            "Content blocking snapshot digest mismatch");
+    return;
+  }
+  if (staging_->site_guard &&
+      !SiteGuardMatches(profile_, *staging_->site_guard)) {
+    staging_.reset();
+    std::move(callback).Run(std::nullopt, "Content blocking page changed");
+    return;
+  }
+  Staging staging = std::move(*staging_);
+  staging_.reset();
+  commit_in_progress_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath path, Staging staging) {
+            const bool persisted = Persist(path, staging);
+            return std::make_pair(std::move(staging), persisted);
+          },
+          SnapshotPath(profile_), std::move(staging)),
+      base::BindOnce(
+          [](base::WeakPtr<ContentBlockingController> owner,
+             CommitCallback callback, std::pair<Staging, bool> result) {
+            if (!owner) {
+              std::move(callback).Run(std::nullopt,
+                                      "Content blocking Profile closed");
+              return;
+            }
+            owner->commit_in_progress_ = false;
+            if (!result.second) {
+              std::move(callback).Run(
+                  std::nullopt,
+                  "Chromium could not persist the filter snapshot");
+              return;
+            }
+            Staging& staging = result.first;
+            auto next = std::make_shared<Rules>();
+            next->generation = staging.generation;
+            next->digest = staging.digest;
+            next->enabled = staging.enabled;
+            next->blocked = BlockingHosts(staging.hosts.begin(),
+                                          staging.hosts.end());
+            next->allowed = std::move(staging.allowed);
+            const int count = static_cast<int>(next->blocked.size());
+            owner->rules_ = std::move(next);
+            base::DictValue receipt;
+            receipt.Set("backend", "subresource_filter");
+            receipt.Set("generation", staging.generation);
+            receipt.Set("hostsDigest", staging.digest);
+            receipt.Set("installedRules", count);
+            std::move(callback).Run(std::move(receipt), "");
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+std::unique_ptr<blink::URLLoaderThrottle>
+ContentBlockingController::CreateThrottle(
+    const network::ResourceRequest& request,
+    std::string top_site_host) {
+  SyncPrivateRules();
+  if (!rules_->enabled) {
+    return nullptr;
+  }
+  const bool main_frame = request.is_outermost_main_frame;
+  return std::make_unique<BlockingThrottle>(
+      rules_, base::ToLowerASCII(top_site_host), main_frame,
+      base::BindPostTask(
+          base::SequencedTaskRunner::GetCurrentDefault(),
+          base::BindRepeating(&ContentBlockingController::NoteBlocked,
+                              weak_factory_.GetWeakPtr())));
+}
+
+std::unique_ptr<blink::URLLoaderThrottle>
+ContentBlockingController::CreateKeepAliveThrottle(std::string top_site_host) {
+  SyncPrivateRules();
+  if (!rules_->enabled) {
+    return nullptr;
+  }
+  return std::make_unique<BlockingThrottle>(
+      rules_, base::ToLowerASCII(top_site_host), false,
+      base::BindPostTask(
+          base::SequencedTaskRunner::GetCurrentDefault(),
+          base::BindRepeating(&ContentBlockingController::NoteBlocked,
+                              weak_factory_.GetWeakPtr())));
+}
+
+bool ContentBlockingController::ShouldBlockNetworkRequest(
+    const network::ResourceRequest& request) {
+  return ShouldBlockURL(request.url, TopSiteHost(request));
+}
+
+bool ContentBlockingController::ShouldBlockURL(
+    const GURL& url, std::string_view top_site_host) {
+  SyncPrivateRules();
+  // This proxy is installed only on subresource factories. The request's
+  // is_outermost_main_frame flag describes its owning frame, not its type.
+  if (!ShouldBlockSubresource(url, top_site_host,
+                              /*main_frame=*/false,
+                              rules_->enabled, rules_->blocked,
+                              rules_->allowed)) {
+    return false;
+  }
+  NoteBlocked(std::string(top_site_host));
+  return true;
+}
+
+void ContentBlockingController::NoteBlocked(std::string site_host) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  ++total_blocked_;
+  if (!site_host.empty() &&
+      (by_site_.contains(site_host) || by_site_.size() < kMaxAllowed)) {
+    int& count = by_site_[site_host];
+    if (count < std::numeric_limits<int>::max()) {
+      ++count;
+    }
+  }
+}
+
+bool ContentBlockingController::enabled() {
+  SyncPrivateRules();
+  return rules_->enabled;
+}
+bool ContentBlockingController::IsAllowed(std::string_view site_host) {
+  SyncPrivateRules();
+  return BlockingHostMatches(rules_->allowed, site_host);
+}
+double ContentBlockingController::generation() const {
+  return rules_->generation;
+}
+int ContentBlockingController::blocked_count() const {
+  return static_cast<int>(
+      std::min<uint64_t>(total_blocked_, std::numeric_limits<int>::max()));
+}
+int ContentBlockingController::BlockedForSite(
+    std::string_view site_host) const {
+  auto it = by_site_.find(std::string(site_host));
+  return it == by_site_.end() ? 0 : it->second;
+}
+std::vector<std::string> ContentBlockingController::allowed_hosts() {
+  SyncPrivateRules();
+  std::vector<std::string> hosts(rules_->allowed.begin(),
+                                 rules_->allowed.end());
+  std::sort(hosts.begin(), hosts.end());
+  return hosts;
+}
+bool ContentBlockingController::SetPrivateSiteAllowed(std::string_view host,
+                                                      bool allowed) {
+  if (!profile_->IsOffTheRecord() || !IsAllowedSiteHost(host) ||
+      (private_site_overrides_.size() >= kMaxAllowed &&
+       !private_site_overrides_.contains(std::string(host)))) {
+    return false;
+  }
+  SyncPrivateRules();
+  auto next = std::make_shared<Rules>(*rules_);
+  if (allowed) {
+    if (next->allowed.size() >= kMaxAllowed &&
+        !next->allowed.contains(std::string(host))) {
+      return false;
+    }
+    next->allowed.insert(std::string(host));
+  } else {
+    next->allowed.erase(std::string(host));
+  }
+  private_site_overrides_[std::string(host)] = allowed;
+  rules_ = std::move(next);
+  return true;
+}
+
+bool ContentBlockingController::SetPrivateEnabled(bool enabled) {
+  if (!profile_->IsOffTheRecord()) {
+    return false;
+  }
+  SyncPrivateRules();
+  auto next = std::make_shared<Rules>(*rules_);
+  next->enabled = enabled;
+  private_enabled_override_ = enabled;
+  rules_ = std::move(next);
+  return true;
+}
+
+}  // namespace aux
