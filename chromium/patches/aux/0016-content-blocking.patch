+class BlockingThrottle final : public blink::URLLoaderThrottle {
+ public:
+  BlockingThrottle(
+      std::shared_ptr<const ContentBlockingController::Rules> rules,
+      std::string top_site_host,
+      bool main_frame,
+      base::RepeatingCallback<void(std::string)> on_blocked)
+      : rules_(std::move(rules)),
+        top_site_host_(std::move(top_site_host)),
+        main_frame_(main_frame),
+        on_blocked_(std::move(on_blocked)) {}
+  ~BlockingThrottle() override = default;
+
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override {
+    MaybeBlock(request->url);
+  }
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override {
+    MaybeBlock(redirect_info->new_url);
+  }
+
+ private:
+  void MaybeBlock(const GURL& url) {
+    if (!ShouldBlockSubresource(url, top_site_host_, main_frame_,
+                                rules_->enabled, rules_->blocked,
+                                rules_->allowed)) {
+      return;
+    }
+    on_blocked_.Run(top_site_host_);
+    delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT,
+                               "Aux content filter");
+  }
+
+  std::shared_ptr<const ContentBlockingController::Rules> rules_;
+  const std::string top_site_host_;
+  const bool main_frame_;
+  base::RepeatingCallback<void(std::string)> on_blocked_;
+};
