+void WebUIBrowserUI::HandleAuxBlockingRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  const base::ListValue* list = &args;
+  const bool blocking_method =
+      method == "filterLists" || method == "updateFilters" ||
+      method == "addFilterSource" || method == "removeFilterSource" ||
+      method == "setFilterSourceEnabled" || method == "privacy" ||
+      method == "setTrackerBlock" || method == "removeAllowedHost";
+  if (blocking_method) {
+    if (browser_->GetProfile()->IsOffTheRecord()) {
+      auto* blocker =
+          aux::ContentBlockingController::ForProfile(browser_->GetProfile());
+      if ((method == "privacy" && list->empty()) ||
+          (method == "setTrackerBlock" && list->size() == 1 &&
+           (*list)[0].is_bool()) ||
+          (method == "removeAllowedHost" && list->size() == 1 &&
+           (*list)[0].is_string())) {
+        const bool previous_enabled = blocker->enabled();
+        const std::string changed_host = method == "removeAllowedHost"
+            ? (*list)[0].GetString() : "";
+        const bool previous_allowed = !changed_host.empty() &&
+            blocker->IsAllowed(changed_host);
+        if (method == "setTrackerBlock" &&
+            !blocker->SetPrivateEnabled((*list)[0].GetBool())) {
+          std::move(callback).Run(false, "", "invalid_argument",
+                                  "Invalid private blocking preference");
+          return;
+        }
+        if (method == "removeAllowedHost" &&
+            !blocker->SetPrivateSiteAllowed(changed_host, false)) {
+          std::move(callback).Run(false, "", "invalid_argument",
+                                  "Invalid private site exception");
+          return;
+        }
+        std::string result_json;
+        if (method == "removeAllowedHost") {
+          base::ListValue allowed;
+          for (const auto& host : blocker->allowed_hosts()) {
+            allowed.Append(host);
+          }
+          result_json = *base::WriteJson(allowed);
+        } else {
+          base::DictValue privacy;
+          privacy.Set("trackerBlock", blocker->enabled());
+          privacy.Set("blocked", blocker->blocked_count());
+          privacy.Set("httpsUpgrade",
+                      base::FeatureList::IsEnabled(features::kHttpsUpgrades) &&
+                          browser_->GetProfile()->GetPrefs()->GetBoolean(
+                              aux::kHttpsUpgradesEnabled) &&
+                          browser_->GetProfile()->GetPrefs()->GetBoolean(
+                              prefs::kHttpsUpgradesEnabled));
+          base::ListValue allowed;
+          for (const auto& host : blocker->allowed_hosts()) {
+            allowed.Append(host);
+          }
+          privacy.Set("allowedHosts", std::move(allowed));
+          result_json = *base::WriteJson(privacy);
+        }
+        if (method == "privacy") {
+          std::move(callback).Run(true, result_json, "", "");
+          return;
+        }
+        aux::ZapController::ForProfile(browser_->GetProfile())
+            ->RefreshCosmetic(base::BindOnce(
+                [](base::WeakPtr<WebUIBrowserUI> owner,
+                   std::string changed_host, bool previous_allowed,
+                   bool previous_enabled, std::string result_json,
+                   RequestCallback callback, bool applied) {
+                  if (!owner) return;
+                  if (applied) {
+                    std::move(callback).Run(true, result_json, "", "");
+                    return;
+                  }
+                  auto* profile = owner->browser_->GetProfile();
+                  auto* blocker = aux::ContentBlockingController::ForProfile(profile);
+                  if (changed_host.empty())
+                    blocker->SetPrivateEnabled(previous_enabled);
+                  else
+                    blocker->SetPrivateSiteAllowed(changed_host, previous_allowed);
+                  aux::ZapController::ForProfile(profile)->RefreshCosmetic(
+                      base::BindOnce(
+                          [](RequestCallback callback, bool) {
+                            std::move(callback).Run(
+                                false, "", "backend_unavailable",
+                                "An active document rejected cosmetic styles");
+                          }, std::move(callback)));
+                }, weak_factory_.GetWeakPtr(), changed_host,
+                previous_allowed, previous_enabled, std::move(result_json),
+                std::move(callback)));
+        return;
+      }
+      std::move(callback).Run(false, "", "forbidden",
+                              "Private windows use temporary site exceptions");
+      return;
+    }
+    const char* internal = nullptr;
+    base::DictValue params;
+    if (method == "filterLists" || method == "privacy" ||
+        method == "updateFilters") {
+      if (list->size() != 0) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Unexpected arguments");
+        return;
+      }
+      internal = method == "filterLists" ? "blocking.status"
+                 : method == "privacy"   ? "blocking.privacy"
+                                         : "blocking.update";
+    } else if (method == "setTrackerBlock") {
+      if (list->size() != 1 || !(*list)[0].is_bool()) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Invalid blocking preference");
+        return;
+      }
+      params.Set("enabled", (*list)[0].GetBool());
+      internal = "blocking.setEnabled";
+    } else if (method == "addFilterSource") {
+      if (list->size() < 2 || list->size() > 3 || !(*list)[0].is_string() ||
+          !(*list)[1].is_string() ||
+          (list->size() == 3 && !(*list)[2].is_string())) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Invalid filter source");
+        return;
+      }
+      params.Set("name", (*list)[0].GetString());
+      params.Set("url", (*list)[1].GetString());
+      params.Set("kind", list->size() == 3 ? (*list)[2].GetString() : "hosts");
+      internal = "blocking.add";
+    } else if (method == "setFilterSourceEnabled") {
+      if (list->size() != 2 || !(*list)[0].is_string() ||
+          !(*list)[1].is_bool()) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Invalid filter source change");
+        return;
+      }
+      params.Set("id", (*list)[0].GetString());
+      params.Set("enabled", (*list)[1].GetBool());
+      internal = "blocking.setSourceEnabled";
+    } else {
+      if (list->size() != 1 || !(*list)[0].is_string()) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Invalid filter identifier");
+        return;
+      }
+      params.Set(method == "removeAllowedHost" ? "hostname" : "id",
+                 (*list)[0].GetString());
+      internal = method == "removeAllowedHost" ? "blocking.removeAllowedHost"
+                                               : "blocking.remove";
+    }
+    AuxRuntimeHost::ForProfile(browser_->GetProfile())
+        ->CallInternal(
+            internal, *base::WriteJson(params),
+            base::BindOnce(
+                [](base::WeakPtr<WebUIBrowserUI> ui, bool with_count,
+                   bool with_https,
+                   RequestCallback callback,
+                   AuxRuntimeHost::Response response) {
+                  if (!ui || !ui->IsAuthorizedAuxDocument()) {
+                    std::move(callback).Run(
+                        false, "", "forbidden",
+                        "The Aux shell is no longer active");
+                    return;
+                  }
+                  if (response.ok && with_count) {
+                    auto value = base::JSONReader::ReadDict(
+                        response.result_json, base::JSON_PARSE_RFC);
+                    if (!value) {
+                      std::move(callback).Run(false, "", "backend_unavailable",
+                                              "Invalid blocking state");
+                      return;
+                    }
+                    value->Set("blocked",
+                               aux::ContentBlockingController::ForProfile(
+                                   ui->browser_->GetProfile())
+                                   ->blocked_count());
+                    if (with_https) {
+                      auto* pref_service =
+                          ui->browser_->GetProfile()->GetPrefs();
+                      value->Set("httpsUpgrade",
+                                 base::FeatureList::IsEnabled(
+                                     features::kHttpsUpgrades) &&
+                                     pref_service->GetBoolean(
+                                         aux::kHttpsUpgradesEnabled) &&
+                                     pref_service->GetBoolean(
+                                         prefs::kHttpsUpgradesEnabled));
+                    }
+                    response.result_json = *base::WriteJson(*value);
+                  }
+                  std::move(callback).Run(response.ok, response.result_json,
+                                          response.error_code,
+                                          response.error_message);
+                },
+                weak_factory_.GetWeakPtr(),
+                method == "privacy" || method == "setTrackerBlock",
+                method == "privacy",
+                std::move(callback)));
+    return;
+  }
+  std::move(callback).Run(false, "", "not_found",
+                          "Unsupported Aux shell method: " + method);
+}
