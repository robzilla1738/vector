@@ -0,0 +1,580 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/cosmetic_controller.h"
+
+#include <algorithm>
+#include <cmath>
+#include <ranges>
+#include <string_view>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/content_blocking_controller.h"
+#include "chrome/browser/ui/aux/content_blocking_policy.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "chrome/browser/ui/aux/zap_controller.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "crypto/sha2.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace aux {
+namespace {
+const char kCosmeticKey = 0;
+constexpr size_t kMaxRules = 10000;
+constexpr size_t kMaxRulesFileBytes = 8 * 1024 * 1024;
+constexpr size_t kMaxStyleBytes = 4 * 1024 * 1024;
+
+std::string RuleLine(const CosmeticRule& rule) {
+  std::string line;
+  for (const auto& domain : rule.domains) {
+    if (!line.empty()) {
+      line.push_back(',');
+    }
+    line.append(domain);
+  }
+  line.append("##");
+  line.append(rule.selector);
+  return line;
+}
+
+bool Alpha(char c) {
+  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+bool Alnum(char c) {
+  return Alpha(c) || (c >= '0' && c <= '9');
+}
+bool NameChar(char c) {
+  return Alnum(c) || c == '_' || c == '-';
+}
+
+bool ValidSelector(std::string_view selector) {
+  if (selector.empty() || selector.size() > 300) {
+    return false;
+  }
+  size_t i = 0;
+  int terms = 0;
+  while (i < selector.size()) {
+    if (++terms > 4) {
+      return false;
+    }
+    if (selector[i] == '.' || selector[i] == '#') {
+      ++i;
+      if (i == selector.size() || !Alpha(selector[i++])) {
+        return false;
+      }
+      while (i < selector.size() && NameChar(selector[i])) {
+        ++i;
+      }
+    } else if (selector.substr(i, 6) == "[data-") {
+      i += 6;
+      if (i == selector.size() || !Alpha(selector[i++])) {
+        return false;
+      }
+      while (i < selector.size() && NameChar(selector[i])) {
+        ++i;
+      }
+      if (i < selector.size() && selector[i] != ']') {
+        if (selector[i] == '~' || selector[i] == '|' || selector[i] == '^' ||
+            selector[i] == '$' || selector[i] == '*') {
+          ++i;
+        }
+        if (i == selector.size() || selector[i++] != '=') {
+          return false;
+        }
+        char quote = 0;
+        if (i < selector.size() &&
+            (selector[i] == '\'' || selector[i] == '"')) {
+          quote = selector[i++];
+        }
+        size_t value_start = i;
+        while (i < selector.size() &&
+               (Alnum(selector[i]) || selector[i] == '_' ||
+                selector[i] == '-' || selector[i] == ' ')) {
+          ++i;
+        }
+        if (i == value_start || i - value_start > 80) {
+          return false;
+        }
+        if (quote && (i == selector.size() || selector[i++] != quote)) {
+          return false;
+        }
+      }
+      if (i == selector.size() || selector[i++] != ']') {
+        return false;
+      }
+    } else {
+      return false;
+    }
+    if (i == selector.size()) {
+      return true;
+    }
+    if (selector[i] != ' ' && selector[i] != '>') {
+      return false;
+    }
+    while (i < selector.size() && selector[i] == ' ') {
+      ++i;
+    }
+    if (i < selector.size() && selector[i] == '>') {
+      ++i;
+      while (i < selector.size() && selector[i] == ' ') {
+        ++i;
+      }
+    }
+    if (i == selector.size() || (selector[i] != '.' && selector[i] != '#' &&
+                                 selector.substr(i, 6) != "[data-")) {
+      return false;
+    }
+  }
+  return false;
+}
+
+bool ValidDigest(std::string_view digest) {
+  return digest.size() == 64 && std::ranges::all_of(digest, [](char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+
+bool ValidGeneration(std::optional<double> value) {
+  return value && std::isfinite(*value) && *value >= 1 &&
+         *value <= 9007199254740991.0 && std::floor(*value) == *value;
+}
+
+base::FilePath SnapshotPath(Profile* profile) {
+  return profile->GetPath()
+      .Append(FILE_PATH_LITERAL("Aux Blocking"))
+      .Append(FILE_PATH_LITERAL("cosmetic.json"));
+}
+
+std::optional<CosmeticRule> ReadRule(const base::Value& value) {
+  const base::DictValue* object = value.GetIfDict();
+  if (!object) {
+    return std::nullopt;
+  }
+  const base::ListValue* domains = object->FindList("domains");
+  const std::string* selector = object->FindString("selector");
+  if (!domains || !selector || domains->size() > 16) {
+    return std::nullopt;
+  }
+  CosmeticRule rule;
+  rule.selector = *selector;
+  for (const base::Value& item : *domains) {
+    const std::string* domain = item.GetIfString();
+    if (!domain) {
+      return std::nullopt;
+    }
+    rule.domains.push_back(*domain);
+  }
+  return ValidCosmeticRule(rule) ? std::optional(std::move(rule))
+                                 : std::nullopt;
+}
+
+base::ListValue WriteRules(const std::vector<CosmeticRule>& rules) {
+  base::ListValue list;
+  for (const auto& rule : rules) {
+    base::DictValue value;
+    base::ListValue domains;
+    for (const auto& domain : rule.domains) {
+      domains.Append(domain);
+    }
+    value.Set("domains", std::move(domains));
+    value.Set("selector", rule.selector);
+    list.Append(std::move(value));
+  }
+  return list;
+}
+
+bool SiteGuardMatches(Profile* profile, const base::DictValue& guard) {
+  const std::string* page_id = guard.FindString("pageId");
+  const std::string* expected_url = guard.FindString("expectedUrl");
+  const auto navigation_id = guard.FindInt("navigationId");
+  if (!page_id || !expected_url || !navigation_id || page_id->size() > 128 ||
+      !GURL(*expected_url).SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  auto* catalog = TabCatalog::GetForProfile(profile);
+  auto* contents = catalog ? catalog->FindPage(*page_id) : nullptr;
+  const content::NavigationEntry* entry =
+      contents ? contents->GetController().GetLastCommittedEntry() : nullptr;
+  return contents && entry &&
+         contents->GetLastCommittedURL() == GURL(*expected_url) &&
+         entry->GetUniqueID() == *navigation_id;
+}
+
+base::DictValue Accepted() {
+  base::DictValue result;
+  result.Set("accepted", true);
+  return result;
+}
+
+}  // namespace
+
+bool ValidCosmeticRule(const CosmeticRule& rule) {
+  if (!ValidSelector(rule.selector) || rule.domains.size() > 16 ||
+      RuleLine(rule).size() > 512) {
+    return false;
+  }
+  std::string previous;
+  for (const auto& domain : rule.domains) {
+    if (!IsBlockingHost(domain) || (!previous.empty() && previous >= domain)) {
+      return false;
+    }
+    previous = domain;
+  }
+  return true;
+}
+
+std::string CosmeticRulesDigest(const std::vector<CosmeticRule>& rules) {
+  std::string lines;
+  for (const auto& rule : rules) {
+    if (!lines.empty()) {
+      lines.push_back('\n');
+    }
+    lines.append(RuleLine(rule));
+  }
+  return base::ToLowerASCII(base::HexEncode(crypto::SHA256HashString(lines)));
+}
+
+std::string CosmeticStyleForHost(const std::vector<CosmeticRule>& rules,
+                                 std::string_view host) {
+  std::string style;
+  for (const auto& rule : rules) {
+    bool matches = rule.domains.empty();
+    for (const auto& domain : rule.domains) {
+      if (host == domain ||
+          (host.size() > domain.size() && host.ends_with("." + domain))) {
+        matches = true;
+        break;
+      }
+    }
+    if (!matches) {
+      continue;
+    }
+    if (style.size() + rule.selector.size() + 25 > kMaxStyleBytes) {
+      return {};
+    }
+    style.append(rule.selector).append("{display:none!important}\n");
+  }
+  return style;
+}
+
+struct CosmeticController::Staging {
+  double generation = 0;
+  std::string digest;
+  int rule_count = 0;
+  std::vector<CosmeticRule> rules;
+  std::optional<base::DictValue> site_guard;
+};
+struct CosmeticController::Previous {
+  std::vector<CosmeticRule> rules;
+  double generation;
+  std::string digest;
+};
+
+CosmeticController* CosmeticController::ForProfile(Profile* profile) {
+  if (!profile) {
+    return nullptr;
+  }
+  auto* controller =
+      static_cast<CosmeticController*>(profile->GetUserData(&kCosmeticKey));
+  if (!controller) {
+    auto created =
+        std::unique_ptr<CosmeticController>(new CosmeticController(profile));
+    controller = created.get();
+    profile->SetUserData(&kCosmeticKey, std::move(created));
+  }
+  return controller;
+}
+
+CosmeticController::CosmeticController(Profile* profile) : profile_(profile) {
+  if (!profile_->IsOffTheRecord()) {
+    Load();
+  }
+}
+CosmeticController::~CosmeticController() = default;
+
+const std::vector<CosmeticRule>& CosmeticController::ActiveRules() const {
+  if (profile_->IsOffTheRecord()) {
+    return ForProfile(profile_->GetOriginalProfile())->rules_;
+  }
+  return rules_;
+}
+
+std::string CosmeticController::StyleForOrigin(
+    const std::string& origin) const {
+  const GURL url(origin);
+  if (!url.SchemeIsHTTPOrHTTPS() ||
+      url::Origin::Create(url).Serialize() != origin) {
+    return {};
+  }
+  auto* blocker = ContentBlockingController::ForProfile(profile_);
+  if (!blocker || !blocker->enabled() || blocker->IsAllowed(url.host())) {
+    return {};
+  }
+  return CosmeticStyleForHost(ActiveRules(), url.host());
+}
+
+void CosmeticController::Load() {
+  struct Loaded {
+    std::vector<CosmeticRule> rules;
+    double generation;
+    std::string digest;
+  };
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([](base::FilePath path) -> std::optional<Loaded> {
+        std::string text;
+        if (!base::ReadFileToStringWithMaxSize(path, &text,
+                                               kMaxRulesFileBytes)) {
+          return std::nullopt;
+        }
+        auto root = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+        if (!root) return std::nullopt;
+        const auto generation = root->FindDouble("generation");
+        const std::string* digest = root->FindString("rulesDigest");
+        const base::ListValue* list = root->FindList("rules");
+        if (!ValidGeneration(generation) || !digest || !ValidDigest(*digest) ||
+            !list || list->size() > kMaxRules) return std::nullopt;
+        std::vector<CosmeticRule> parsed;
+        std::string previous;
+        for (const auto& value : *list) {
+          auto rule = ReadRule(value);
+          if (!rule || (!previous.empty() && previous >= RuleLine(*rule))) {
+            return std::nullopt;
+          }
+          previous = RuleLine(*rule);
+          parsed.push_back(std::move(*rule));
+        }
+        if (CosmeticRulesDigest(parsed) != *digest) return std::nullopt;
+        return Loaded{std::move(parsed), *generation, *digest};
+      }, SnapshotPath(profile_)),
+      base::BindOnce(
+          [](base::WeakPtr<CosmeticController> owner,
+             std::optional<Loaded> loaded) {
+            if (!owner || !loaded ||
+                loaded->generation <= owner->generation_) return;
+            owner->rules_ = std::move(loaded->rules);
+            owner->generation_ = loaded->generation;
+            owner->digest_ = std::move(loaded->digest);
+            ZapController::ForProfile(owner->profile_)
+                ->RefreshCosmetic(base::BindOnce([](bool) {}));
+          }, weak_factory_.GetWeakPtr()));
+}
+
+std::optional<base::DictValue> CosmeticController::Begin(
+    const base::DictValue& params,
+    std::string* error) {
+  if (commit_in_progress_) {
+    *error = "Cosmetic snapshot commit is in progress";
+    return std::nullopt;
+  }
+  const auto generation = params.FindDouble("generation");
+  const auto count = params.FindInt("ruleCount");
+  const std::string* profile_id = params.FindString("profileId");
+  const std::string* digest = params.FindString("rulesDigest");
+  const auto enabled = params.FindBool("enabled");
+  const base::ListValue* allowed = params.FindList("allowedSiteHosts");
+  const base::Value* guard_value = params.Find("siteGuard");
+  const base::DictValue* guard = params.FindDict("siteGuard");
+  auto* blocker = ContentBlockingController::ForProfile(profile_);
+  if (profile_->IsOffTheRecord() || previous_ || !blocker || !profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() ||
+      !ValidGeneration(generation) || *generation <= generation_ ||
+      *generation != blocker->generation() || !count || *count < 0 ||
+      *count > static_cast<int>(kMaxRules) || !digest ||
+      !ValidDigest(*digest) || !enabled || *enabled != blocker->enabled() ||
+      !allowed || allowed->size() != blocker->allowed_hosts().size()) {
+    *error = "Invalid cosmetic snapshot header";
+    return std::nullopt;
+  }
+  const auto expected = blocker->allowed_hosts();
+  for (size_t i = 0; i < expected.size(); ++i) {
+    if (!(*allowed)[i].is_string() ||
+        (*allowed)[i].GetString() != expected[i]) {
+      *error = "Cosmetic site policy does not match network policy";
+      return std::nullopt;
+    }
+  }
+  if (guard_value && (!guard || !SiteGuardMatches(profile_, *guard))) {
+    *error = "Content blocking page changed";
+    return std::nullopt;
+  }
+  staging_ = std::make_unique<Staging>();
+  staging_->generation = *generation;
+  staging_->digest = *digest;
+  staging_->rule_count = *count;
+  if (guard) {
+    staging_->site_guard = guard->Clone();
+  }
+  return Accepted();
+}
+
+std::optional<base::DictValue> CosmeticController::Append(
+    const base::DictValue& params,
+    std::string* error) {
+  if (commit_in_progress_) {
+    *error = "Cosmetic snapshot commit is in progress";
+    return std::nullopt;
+  }
+  const auto generation = params.FindDouble("generation");
+  const auto offset = params.FindInt("offset");
+  const std::string* profile_id = params.FindString("profileId");
+  const base::ListValue* list = params.FindList("rules");
+  if (!staging_ || !generation || *generation != staging_->generation ||
+      !profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() || !offset ||
+      *offset != static_cast<int>(staging_->rules.size()) || !list ||
+      list->empty() || list->size() > 128 ||
+      staging_->rules.size() + list->size() >
+          static_cast<size_t>(staging_->rule_count)) {
+    staging_.reset();
+    *error = "Invalid cosmetic snapshot chunk";
+    return std::nullopt;
+  }
+  for (const auto& value : *list) {
+    auto rule = ReadRule(value);
+    if (!rule || (!staging_->rules.empty() &&
+                  RuleLine(staging_->rules.back()) >= RuleLine(*rule))) {
+      staging_.reset();
+      *error = "Invalid cosmetic rule or rule order";
+      return std::nullopt;
+    }
+    staging_->rules.push_back(std::move(*rule));
+  }
+  return Accepted();
+}
+
+bool CosmeticController::Persist(const base::FilePath& path,
+                                 const std::vector<CosmeticRule>& rules,
+                                 double generation,
+                                 const std::string& digest) {
+  base::DictValue root;
+  root.Set("generation", generation);
+  root.Set("rulesDigest", digest);
+  root.Set("rules", WriteRules(rules));
+  const auto encoded = base::WriteJson(root);
+  const auto temp = path.AddExtension(FILE_PATH_LITERAL("tmp"));
+  if (!encoded || encoded->size() > kMaxRulesFileBytes ||
+      !base::CreateDirectory(path.DirName()) ||
+      !base::SetPosixFilePermissions(path.DirName(), 0700) ||
+      !base::WriteFile(temp, *encoded) ||
+      !base::SetPosixFilePermissions(temp, 0600) ||
+      !base::ReplaceFile(temp, path, nullptr)) {
+    base::DeleteFile(temp);
+    return false;
+  }
+  return true;
+}
+
+void CosmeticController::Commit(
+    const base::DictValue& params,
+    CommitCallback callback) {
+  const auto generation = params.FindDouble("generation");
+  const std::string* digest = params.FindString("rulesDigest");
+  const std::string* profile_id = params.FindString("profileId");
+  if (commit_in_progress_ || !staging_ || !generation ||
+      *generation != staging_->generation ||
+      !digest || *digest != staging_->digest || !profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() ||
+      staging_->rules.size() != static_cast<size_t>(staging_->rule_count) ||
+      CosmeticRulesDigest(staging_->rules) != *digest ||
+      (staging_->site_guard &&
+       !SiteGuardMatches(profile_, *staging_->site_guard))) {
+    staging_.reset();
+    std::move(callback).Run(std::nullopt,
+                            "Cosmetic snapshot digest or page review mismatch");
+    return;
+  }
+  Staging staging = std::move(*staging_);
+  staging_.reset();
+  commit_in_progress_ = true;
+  const std::string committed_profile_id = *profile_id;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath path, Staging staging) {
+            const bool persisted = Persist(path, staging.rules,
+                                           staging.generation, staging.digest);
+            return std::make_pair(std::move(staging), persisted);
+          }, SnapshotPath(profile_), std::move(staging)),
+      base::BindOnce(
+          [](base::WeakPtr<CosmeticController> owner,
+             std::string profile_id, CommitCallback callback,
+             std::pair<Staging, bool> result) {
+            if (!owner) {
+              std::move(callback).Run(std::nullopt,
+                                      "Cosmetic Profile closed");
+              return;
+            }
+            owner->commit_in_progress_ = false;
+            if (!result.second) {
+              std::move(callback).Run(
+                  std::nullopt,
+                  "Chromium could not persist the cosmetic snapshot");
+              return;
+            }
+            Staging& staged = result.first;
+            owner->previous_ = std::make_unique<Previous>(
+                Previous{owner->rules_, owner->generation_, owner->digest_});
+            owner->rules_ = std::move(staged.rules);
+            owner->generation_ = staged.generation;
+            owner->digest_ = staged.digest;
+            base::DictValue receipt;
+            receipt.Set("backend", "isolated_world_stylesheet");
+            receipt.Set("profileId", profile_id);
+            receipt.Set("private", false);
+            receipt.Set("generation", staged.generation);
+            receipt.Set("rulesDigest", staged.digest);
+            receipt.Set("installedRules", static_cast<int>(owner->rules_.size()));
+            receipt.Set("phase", "document_start");
+            receipt.Set("futureDocuments", true);
+            std::move(callback).Run(std::move(receipt), "");
+          }, weak_factory_.GetWeakPtr(), committed_profile_id,
+          std::move(callback)));
+}
+
+void CosmeticController::Rollback(base::OnceCallback<void(bool)> callback) {
+  if (!previous_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  const Previous snapshot = *previous_;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath path, Previous previous) {
+            return previous.generation == 0
+                       ? base::DeleteFile(path)
+                       : Persist(path, previous.rules, previous.generation,
+                                 previous.digest);
+          }, SnapshotPath(profile_), snapshot),
+      base::BindOnce(
+          [](base::WeakPtr<CosmeticController> owner,
+             base::OnceCallback<void(bool)> callback, bool persisted) {
+            if (owner && persisted && owner->previous_) {
+              owner->rules_ = std::move(owner->previous_->rules);
+              owner->generation_ = owner->previous_->generation;
+              owner->digest_ = std::move(owner->previous_->digest);
+              owner->previous_.reset();
+            }
+            std::move(callback).Run(owner && persisted);
+          }, weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void CosmeticController::Confirm() {
+  previous_.reset();
+}
+
+}  // namespace aux
