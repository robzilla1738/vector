+// Renderer-created subresources do not pass through the browser's
+// CreateURLLoaderThrottles hook. Keep a browser-process gate on their factory
+// so Profile rule changes also apply to already-open tabs.
+class BlockingProxyFactory final : public network::SelfDeletingURLLoaderFactory {
+ public:
+  BlockingProxyFactory(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target,
+      base::WeakPtr<ContentBlockingController> blocker,
+      base::SelfDeletingPassKey pass_key)
+      : network::SelfDeletingURLLoaderFactory(std::move(receiver), pass_key),
+        blocker_(std::move(blocker)) {
+    target_.Bind(std::move(target));
+    target_.set_disconnect_handler(base::BindOnce(
+        &BlockingProxyFactory::OnTargetError, base::Unretained(this)));
+  }
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override {
+    if (blocker_ && blocker_->ShouldBlockNetworkRequest(request)) {
+      mojo::Remote<network::mojom::URLLoaderClient> blocked_client(
+          std::move(client));
+      blocked_client->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+    auto guard = std::make_unique<BlockingRequest>(
+        std::move(loader_receiver), std::move(client), blocker_,
+        TopSiteHost(request));
+    auto target_loader = guard->BindTargetLoader();
+    mojo::PendingRemote<network::mojom::URLLoaderClient> target_client;
+    mojo::MakeSelfOwnedReceiver(
+        std::move(guard), target_client.InitWithNewPipeAndPassReceiver());
+    target_->CreateLoaderAndStart(std::move(target_loader), request_id, options,
+                                  request, std::move(target_client),
+                                  traffic_annotation);
+  }
+
+ private:
+  ~BlockingProxyFactory() override = default;
+  void OnTargetError() { DisconnectReceiversAndDestroy(); }
+
+  mojo::Remote<network::mojom::URLLoaderFactory> target_;
+  base::WeakPtr<ContentBlockingController> blocker_;
+};
+
+ContentBlockingController* ContentBlockingController::ForProfile(
+    Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile) {
+    return nullptr;
+  }
+  auto* owner = static_cast<ContentBlockingController*>(
+      profile->GetUserData(&kContentBlockingKey));
+  if (!owner) {
+    auto created = std::unique_ptr<ContentBlockingController>(
+        new ContentBlockingController(profile));
+    owner = created.get();
+    profile->SetUserData(&kContentBlockingKey, std::move(created));
+  }
+  owner->SyncPrivateRules();
+  return owner;
+}
+
+// static
+void ContentBlockingController::MaybeProxySubresourceFactory(
+    Profile* profile, network::URLLoaderFactoryBuilder& factory_builder) {
+  auto* blocker = ForProfile(profile);
+  if (!blocker) {
+    return;
+  }
+  auto [receiver, target] = factory_builder.Append();
+  base::MakeSelfDeleting<BlockingProxyFactory>(
+      std::move(receiver), std::move(target),
+      blocker->weak_factory_.GetWeakPtr());
+}
+
+ContentBlockingController::ContentBlockingController(Profile* profile)
+    : profile_(profile), rules_(std::make_shared<Rules>()) {
+  if (!profile->IsOffTheRecord()) {
+    Load();
+  }
+}
+ContentBlockingController::~ContentBlockingController() = default;
+
+void ContentBlockingController::Load() {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([](base::FilePath path) -> std::shared_ptr<Rules> {
+        std::string text;
+        if (!base::ReadFileToStringWithMaxSize(path, &text,
+                                               kMaxSnapshotBytes)) {
+          return nullptr;
+        }
+        const auto root = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+        if (!root) return nullptr;
+        const auto generation = root->FindDouble("generation");
+        const std::string* digest = root->FindString("hostsDigest");
+        const base::ListValue* host_list = root->FindList("hosts");
+        const base::ListValue* allowed_list = root->FindList("allowedSiteHosts");
+        const auto enabled = root->FindBool("enabled");
+        if (!ValidGeneration(generation) || !digest || !ValidDigest(*digest) ||
+            !host_list || !allowed_list || !enabled ||
+            allowed_list->size() > kMaxAllowed) return nullptr;
+        std::vector<std::string> hosts;
+        if (!IsSortedHostList(*host_list, host_list->size(), &hosts) ||
+            !IncludesBuiltInHosts(hosts) ||
+            Digest(JoinHosts(hosts)) != *digest) return nullptr;
+        auto next = std::make_shared<Rules>();
+        next->generation = *generation;
+        next->digest = *digest;
+        next->enabled = *enabled;
+        next->blocked = BlockingHosts(hosts.begin(), hosts.end());
+        for (const base::Value& value : *allowed_list) {
+          const std::string* host = value.GetIfString();
+          if (!host || !IsAllowedSiteHost(*host)) return nullptr;
+          next->allowed.insert(*host);
+        }
+        return next;
+      }, SnapshotPath(profile_)),
+      base::BindOnce(
+          [](base::WeakPtr<ContentBlockingController> owner,
+             std::shared_ptr<Rules> loaded) {
+            if (owner && loaded &&
+                loaded->generation > owner->rules_->generation) {
+              owner->rules_ = std::move(loaded);
+            }
+          }, weak_factory_.GetWeakPtr()));
+}
+
+void ContentBlockingController::SyncPrivateRules() {
+  if (!profile_->IsOffTheRecord()) {
+    return;
+  }
+  auto* original = ForProfile(profile_->GetOriginalProfile());
+  if (original && original->rules_->generation > rules_->generation) {
+    auto next = std::make_shared<Rules>(*original->rules_);
+    for (const auto& [host, allowed] : private_site_overrides_) {
+      if (allowed) {
+        next->allowed.insert(host);
+      } else {
+        next->allowed.erase(host);
+      }
+    }
+    if (private_enabled_override_) {
+      next->enabled = *private_enabled_override_;
+    }
+    rules_ = std::move(next);
+  }
+}
