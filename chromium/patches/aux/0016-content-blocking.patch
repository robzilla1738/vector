+struct ContentBlockingController::Rules {
+  double generation = 0;
+  std::string digest;
+  bool enabled = true;
+  BlockingHosts blocked = BuiltInHosts();
+  BlockingHosts allowed;
+};
+
+struct ContentBlockingController::Staging {
+  double generation = 0;
+  std::string digest;
+  size_t host_count = 0;
+  bool enabled = true;
+  std::vector<std::string> hosts;
+  BlockingHosts allowed;
+  std::optional<base::DictValue> site_guard;
+};
