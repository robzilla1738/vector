+
+class Profile;
+
+namespace aux {
+
+struct CosmeticRule {
+  std::vector<std::string> domains;
+  std::string selector;
+};
+
+// The native parser is independent of the runtime parser. A compromised worker
+// cannot turn a downloaded selector into script or arbitrary CSS.
+bool ValidCosmeticRule(const CosmeticRule& rule);
+std::string CosmeticRulesDigest(const std::vector<CosmeticRule>& rules);
+std::string CosmeticStyleForHost(const std::vector<CosmeticRule>& rules,
+                                 std::string_view host);
+
+class CosmeticController final : public base::SupportsUserData::Data {
+ public:
+  static CosmeticController* ForProfile(Profile* profile);
+  ~CosmeticController() override;
+
+  std::optional<base::DictValue> Begin(const base::DictValue& params,
+                                       std::string* error);
+  std::optional<base::DictValue> Append(const base::DictValue& params,
+                                        std::string* error);
+  using CommitCallback = base::OnceCallback<void(
+      std::optional<base::DictValue>, std::string)>;
+  void Commit(const base::DictValue& params, CommitCallback callback);
+  void Rollback(base::OnceCallback<void(bool)> callback);
+  void Confirm();
+  std::string StyleForOrigin(const std::string& origin) const;
+
+ private:
+  struct Staging;
+  struct Previous;
+  explicit CosmeticController(Profile* profile);
+  void Load();
+  static bool Persist(const base::FilePath& path,
+                      const std::vector<CosmeticRule>& rules,
+                      double generation,
+                      const std::string& digest);
+  const std::vector<CosmeticRule>& ActiveRules() const;
+
+  raw_ptr<Profile> profile_;
+  std::vector<CosmeticRule> rules_;
+  double generation_ = 0;
+  std::string digest_;
+  std::unique_ptr<Staging> staging_;
+  std::unique_ptr<Previous> previous_;
+  bool commit_in_progress_ = false;
+  base::WeakPtrFactory<CosmeticController> weak_factory_{this};
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_COSMETIC_CONTROLLER_H_
