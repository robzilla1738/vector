+
+namespace views {
+class View;
+}  // namespace views
+
+// Local state dictionary: profile directory name -> icon name.
+inline constexpr char kAuxProfileIconsPref[] = "aux.profile_icons";
+
+// Shows Aside's profile editor popup anchored to `anchor`: a grid of 16 icons
+// plus a name field. Done persists the icon (see below), renames the profile
+// and runs `on_saved`. Dismissing the popup discards the edits.
+void ShowAuxIconPicker(views::View* anchor,
+                       const base::FilePath& profile_path,
+                       base::OnceClosure on_saved = base::OnceClosure());
+
+// The icon name chosen for `profile_path`, or an empty string when none was
+// chosen (or the stored value is not one of the known names).
+std::string GetAuxProfileIconName(const base::FilePath& profile_path);
+
+// A circular `size` x `size` image of the chosen icon (white-ish glyph on
+// neutral gray), or an empty ImageModel when no icon was chosen.
+ui::ImageModel AuxProfileIconImage(const base::FilePath& profile_path,
+                                   int size);
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_AUX_ICON_PICKER_H_
