+#ifndef CHROME_BROWSER_AUX_PROFILE_STATE_H_
+#define CHROME_BROWSER_AUX_PROFILE_STATE_H_
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+namespace aux {
+// Pure identity of ProfileManager's registered absolute profile path.
+std::string ProfileIdForPath(const base::FilePath& path);
+struct ProfileSecurityState {
+  std::optional<int> account_id;
+  bool bound = false;
+  bool configured = false;
+  bool locked = true;
+  bool onboarding_complete = false;
+  std::string error;
+  bool allows_browsing() const {
+    return bound && configured && !locked && onboarding_complete;
+  }
+};
+// Blocking; call on a MayBlock task. Atomic metadata reads fail closed.
+ProfileSecurityState ReadProfileSecurity(const base::FilePath& home,
+                                         const base::FilePath& profile_path);
+}  // namespace aux
+#endif
diff --git a/chrome/browser/aux/profile_state.cc b/chrome/browser/aux/profile_state.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/aux/profile_state.cc
@@ -0,0 +1,105 @@
+// Copyright 2026 Aux Authors. All rights reserved.
+#include "chrome/browser/aux/profile_state.h"
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "base/containers/span.h"
+#include "base/files/scoped_file.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "crypto/hash.h"
+namespace aux {
+namespace {
+std::optional<base::DictValue> ReadMetadata(const base::FilePath& path,
+                                            size_t limit) {
+  base::ScopedFD fd(
+      open(path.value().c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+  struct stat info;
+  if (!fd.is_valid() || fstat(fd.get(), &info) || !S_ISREG(info.st_mode) ||
+      info.st_uid != geteuid() || (info.st_mode & 0077) || info.st_size < 0 ||
+      static_cast<uint64_t>(info.st_size) > limit) {
+    return std::nullopt;
+  }
+  std::string text(static_cast<size_t>(info.st_size), '\0');
+  size_t offset = 0;
+  while (offset < text.size()) {
+    const auto bytes =
+        read(fd.get(), base::as_writable_byte_span(text).subspan(offset).data(),
+             text.size() - offset);
+    if (bytes <= 0) {
+      return std::nullopt;
+    }
+    offset += bytes;
+  }
+  return base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+}
+}  // namespace
+std::string ProfileIdForPath(const base::FilePath& path) {
+  return "aux-profile:" + base::HexEncode(crypto::hash::Sha256(
+                              path.StripTrailingSeparators().value()));
+}
+ProfileSecurityState ReadProfileSecurity(const base::FilePath& home,
+                                         const base::FilePath& path) {
+  ProfileSecurityState result;
+  auto registry =
+      ReadMetadata(home.AppendASCII("accounts.json"), 4 * 1024 * 1024);
+  if (!registry) {
+    result.error = "Local account registry is not ready";
+    return result;
+  }
+  const auto* bindings = registry->FindList("profileBindings");
+  if (!bindings) {
+    return result;
+  }
+  const auto id = ProfileIdForPath(path);
+  for (const auto& value : *bindings) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const auto& binding = value.GetDict();
+    const auto* bound_path = binding.FindString("profilePath");
+    const auto* bound_id = binding.FindString("profileId");
+    if (!bound_path || *bound_path != path.value()) {
+      continue;
+    }
+    if (!bound_id || *bound_id != id) {
+      result.error =
+          "This profile requires an explicit account binding migration";
+      return result;
+    }
+    auto account = binding.FindInt("accountId");
+    if (!account || *account < 0) {
+      return result;
+    }
+    result.account_id = *account;
+    result.bound = true;
+    if (const auto* accounts = registry->FindList("accounts")) {
+      for (const auto& item : *accounts) {
+        if (!item.is_dict() || item.GetDict().FindInt("id") != account) {
+          continue;
+        }
+        result.onboarding_complete =
+            item.GetDict().FindDouble("onboardingCompletedAt").value_or(0) > 0;
+        break;
+      }
+    }
+    auto security =
+        ReadMetadata(home.AppendASCII("u")
+                         .AppendASCII(base::NumberToString(*account))
+                         .AppendASCII("security-state.json"),
+                     16384);
+    if (!security || security->FindInt("version") != 1 ||
+        security->FindInt("accountId") != account ||
+        !security->FindBool("configured") || !security->FindBool("locked") ||
+        !security->FindDouble("updatedAt")) {
+      return result;
+    }
+    result.configured = security->FindBool("configured").value();
+    result.locked = !result.configured || security->FindBool("locked").value();
+    return result;
+  }
+  return result;
+}
+}  // namespace aux
diff --git a/chrome/browser/aux/profile_state_probe.cc b/chrome/browser/aux/profile_state_probe.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/aux/profile_state_probe.cc
@@ -0,0 +1,85 @@
+// Copyright 2026 Aux Authors. All rights reserved.
+#include <iostream>
+
+#include "base/check.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_writer.h"
+#include "chrome/browser/aux/profile_state.h"
+namespace {
+void Save(const base::FilePath& path, const base::DictValue& value) {
+  CHECK(base::WriteFile(path, base::WriteJson(value).value()));
+  CHECK(base::SetPosixFilePermissions(path, 0600));
+}
+}  // namespace
+int main() {
+  base::ScopedTempDir temp;
+  CHECK(temp.CreateUniqueTempDir());
+  const auto home = temp.GetPath();
+  const auto profile = home.AppendASCII("browser/Default");
+  CHECK(!aux::ReadProfileSecurity(home, profile).allows_browsing());
+  CHECK(aux::ProfileIdForPath(profile) !=
+        aux::ProfileIdForPath(home.AppendASCII("other/Default")));
+  base::DictValue binding;
+  binding.Set("profileId", aux::ProfileIdForPath(profile));
+  binding.Set("profilePath", profile.value());
+  binding.Set("accountId", 4);
+  base::ListValue bindings;
+  bindings.Append(binding.Clone());
+  base::DictValue account;
+  account.Set("id", 4);
+  base::ListValue accounts;
+  accounts.Append(account.Clone());
+  base::DictValue registry;
+  registry.Set("version", 1);
+  registry.Set("profileBindings", std::move(bindings));
+  registry.Set("accounts", std::move(accounts));
+  Save(home.AppendASCII("accounts.json"), registry);
+  CHECK(aux::ReadProfileSecurity(home, profile).bound);
+  CHECK(aux::ReadProfileSecurity(home, profile).locked);
+  const auto statehome = home.AppendASCII("u/4");
+  CHECK(base::CreateDirectory(statehome));
+  const auto file = statehome.AppendASCII("security-state.json");
+  base::DictValue state;
+  state.Set("version", 1);
+  state.Set("accountId", 4);
+  state.Set("configured", true);
+  state.Set("locked", false);
+  state.Set("updatedAt", 1234567890123.0);
+  Save(file, state);
+  CHECK(!aux::ReadProfileSecurity(home, profile).allows_browsing());
+  registry.FindList("accounts")
+      ->front()
+      .GetDict()
+      .Set("onboardingCompletedAt", 1234567890123.0);
+  Save(home.AppendASCII("accounts.json"), registry);
+  CHECK(aux::ReadProfileSecurity(home, profile).allows_browsing());
+  state.Set("locked", true);
+  Save(file, state);
+  CHECK(!aux::ReadProfileSecurity(home, profile).allows_browsing());
+  state.Set("locked", false);
+  state.Set("accountId", 5);
+  Save(file, state);
+  CHECK(!aux::ReadProfileSecurity(home, profile).allows_browsing());
+  state.Set("accountId", 4);
+  Save(file, state);
+  CHECK(base::SetPosixFilePermissions(file, 0644));
+  CHECK(!aux::ReadProfileSecurity(home, profile).allows_browsing());
+  Save(file, state);
+  auto moved = statehome.AppendASCII("other.json");
+  CHECK(base::Move(file, moved));
+  CHECK(base::CreateSymbolicLink(moved, file));
+  CHECK(!aux::ReadProfileSecurity(home, profile).allows_browsing());
+  CHECK(base::DeleteFile(file));
+  CHECK(base::Move(moved, file));
+  registry.FindList("profileBindings")
+      ->front()
+      .GetDict()
+      .Set("profileId", "Default");
+  Save(home.AppendASCII("accounts.json"), registry);
+  const auto legacy = aux::ReadProfileSecurity(home, profile);
+  CHECK(!legacy.bound);
+  CHECK(!legacy.error.empty());
+  std::cout << "Profile identity, setup/unlock/onboarding gate, metadata "
+               "ownership and migration checks passed\n";
+}
