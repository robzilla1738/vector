diff --git a/chrome/browser/aux/profile_gate.h b/chrome/browser/aux/profile_gate.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/aux/profile_gate.h
@@ -0,0 +1,22 @@
+// Copyright 2026 Aux Authors. All rights reserved.
+#ifndef CHROME_BROWSER_AUX_PROFILE_GATE_H_
+#define CHROME_BROWSER_AUX_PROFILE_GATE_H_
+#include <memory>
+
+#include "base/functional/callback.h"
+class Profile;
+class GURL;
+namespace content {
+class WebContents;
+}
+namespace aux {
+// UI-sequence visibility guard. First call starts authenticated binding and an
+// asynchronous account-state read; pending and invalid state deny visibility.
+bool CanShowBrowser(
+    Profile* profile,
+    base::RepeatingCallback<void(content::WebContents*)> initialize_tab = {});
+std::unique_ptr<content::WebContents> TakePreloadedNewTab(Profile* profile,
+                                                          const GURL& url);
+void ShutdownProfileGates();
+}  // namespace aux
+#endif
