+void PictureInPictureServiceImpl::DispatchAutomaticSession(
+    const base::UnguessableToken& ticket, std::unique_ptr<PendingSession> pending) {
+  auto* contents = WebContents::FromRenderFrameHost(&render_frame_host());
+  auto authority = contents ? MediaSessionImpl::Get(contents)
+      ->TakeAutoPictureInPictureAuthority(
+          ticket, &render_frame_host(), pending->player_id)
+      : base::OnceCallback<bool()>();
+  // PendingSession owns an exact negative completion, including destruction
+  // or cancellation of a held continuation. No automatic/manual fallback.
+  if (!authority) return;
+  immersive_confirmation_weak_factory_.InvalidateWeakPtrs();
+  pending->automatic_authority = std::move(authority);
+  StartSessionInternal(std::move(pending), std::nullopt);
+}
