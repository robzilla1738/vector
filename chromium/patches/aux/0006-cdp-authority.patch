+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_CDP_BROKER_H_
+#define CHROME_BROWSER_UI_AUX_CDP_BROKER_H_
+
+#include <map>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+
+class Profile;
+
+namespace aux {
+
+// Only page-scoped protocol domains are exposed to the Aux runtime. Browser,
+// Target, Storage and cookie commands must go through the native controllers.
+bool IsCdpMethodAllowed(const std::string& method);
+
+// A single DevTools client per catalog page in one regular Profile. Calls and
+// protocol events run on Chromium's UI sequence; no TCP listener is involved.
+class CdpBroker final {
+ public:
+  using MessageCallback =
+      base::RepeatingCallback<void(uint64_t, const std::string&,
+                                   const std::string&)>;
+
+  using NavigationCallback = base::RepeatingCallback<void(
+      uint64_t, const std::string&, const std::string&, int,
+      const std::string&, bool)>;
+  CdpBroker(Profile* profile, MessageCallback on_message,
+            NavigationCallback on_navigation);
+  ~CdpBroker();
+  CdpBroker(const CdpBroker&) = delete;
+  CdpBroker& operator=(const CdpBroker&) = delete;
+
+  base::DictValue Catalog(uint64_t connection_generation);
+  base::DictValue Attach(const std::string& page_id,
+                         const std::string& scope,
+                         const std::string& lease_id,
+                         double acknowledged_expires_at,
+                         uint64_t connection_generation);
+  void WaitForAttachment(const std::string& page_id,
+      const std::string& lease_id, double acknowledged_expires_at,
+      uint64_t connection_generation,
+      base::RepeatingCallback<bool()> caller_current,
+      base::OnceCallback<void(base::DictValue)> callback);
+  base::DictValue Dispatch(const std::string& page_id,
+                             const std::string& attachment_id,
+                             const std::string& message,
+                             double acknowledged_expires_at,
+                             uint64_t connection_generation);
+  base::DictValue StartControlledNavigation(const std::string& page_id,
+      const std::string& attachment_id, int command_id, const std::string& url,
+      double acknowledged_expires_at, uint64_t connection_generation);
+  base::DictValue TakeReadyNavigationReceipt(const std::string& page_id,
+      const std::string& attachment_id, int command_id,
+      uint64_t connection_generation);
+  void WaitForNavigationReceipt(const std::string& page_id,
+      const std::string& attachment_id, int command_id,
+      uint64_t connection_generation,
+      base::RepeatingCallback<bool()> caller_current,
+      base::OnceCallback<void(base::DictValue)> callback);
+  void DetachAll();
+
+ private:
+  class Session;
+  void RetireSession(const std::string& page_id);
+  raw_ptr<Profile> profile_;
+  MessageCallback on_message_;
+  NavigationCallback on_navigation_;
+  uint64_t connection_generation_ = 0;
+  std::map<std::string, std::unique_ptr<Session>> sessions_;
+  bool destroying_ = false;
+  base::WeakPtrFactory<CdpBroker> weak_factory_{this};
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_CDP_BROKER_H_
