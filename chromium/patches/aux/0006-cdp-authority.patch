+namespace {
+base::DictValue NativeFault(std::string code, std::string message) {
+  base::DictValue error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::DictValue reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+base::DictValue NativeResult(base::Value value) {
+  base::DictValue reply;
+  reply.Set("result", std::move(value));
+  return reply;
+}
+}  // namespace
+
+base::DictValue AuxRuntimeHost::HandleNativeCdpCall(
+    const std::string& method, const base::DictValue& params,
+    uint64_t connection_generation) {
+  if (shutting_down_ || !connection_generation ||
+      connection_generation != admitted_native_generation_) {
+    return NativeFault("permission_denied", "Original CDP runtime connection is retired");
+  }
+  if (method == "native.cdpReset") {
+    if (!params.empty()) {
+      return NativeFault("invalid_params", "CDP reset takes no arguments");
+    }
+    cdp_broker_->DetachAll();
+    return NativeResult(base::Value(base::DictValue()));
+  }
+  if (method == "native.cdpCatalog") {
+    if (!params.empty())
+      return NativeFault("invalid_params", "CDP catalog takes no arguments");
+    return cdp_broker_->Catalog(connection_generation);
+  }
+  if (method == "native.cdpStartNavigation") {
+    const auto* page_id = params.FindString("pageId");
+    const auto* attachment_id = params.FindString("attachmentId");
+    const auto* url = params.FindString("url");
+    const auto command_id = params.FindInt("commandId");
+    const auto expiry = params.FindDouble("acknowledgedExpiresAt");
+    if (params.size() != 5 || !page_id || !attachment_id || !url ||
+        !command_id || *command_id < 1 || !expiry || url->size() > 2048)
+      return NativeFault("invalid_params", "Invalid fixed navigation request");
+    return cdp_broker_->StartControlledNavigation(*page_id, *attachment_id,
+        *command_id, *url, *expiry, connection_generation);
+  }
+  if (method == "native.cdpAttach") {
+    return NativeFault("permission_denied", "Attachment requires original asynchronous caller authority");
+  }
+  if (method == "native.cdpDispatch") {
+    const std::string* page_id = params.FindString("pageId");
+    const std::string* attachment_id = params.FindString("attachmentId");
+    const std::string* message = params.FindString("message");
+    const auto acknowledged_expiry = params.FindDouble("acknowledgedExpiresAt");
+    if (!acknowledged_expiry || !std::isfinite(*acknowledged_expiry) ||
+        *acknowledged_expiry <= 0 || *acknowledged_expiry > 9007199254740991.0 ||
+        std::floor(*acknowledged_expiry) != *acknowledged_expiry ||
+        params.size() != 4 || !page_id || page_id->empty() ||
+        !attachment_id || attachment_id->empty() || !message) {
+      return NativeFault("invalid_params", "Invalid CDP dispatch envelope");
+    }
+    return cdp_broker_->Dispatch(*page_id, *attachment_id, *message,
+                                  *acknowledged_expiry, connection_generation);
+  }
+  if (method == "native.cdpTakeNavigationReceipt") {
+    return NativeFault("permission_denied", "Navigation receipt requires original asynchronous caller authority");
+  }
+  if (method == "native.cdpVersion") {
+    base::DictValue result;
+    result.Set("version", version_info::GetVersionNumber());
+    return NativeResult(base::Value(std::move(result)));
+  }
+  return NativeFault("backend_unavailable",
+                     "Native method is unavailable in this build");
+}
