new file mode 100644
--- /dev/null
+++ b/chrome/browser/aux/auth_probe.cc
@@ -0,0 +1,110 @@
+// Copyright 2026 Aux Authors. All rights reserved.
+// Disposable-home integration probe; never prints keys, signatures or tokens.
+#include "base/at_exit.h"
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "chrome/browser/aux/installation_auth.h"
+#include "chrome/browser/devtools/aux_cdp_authority.h"
+#include "net/base/ip_address.h"
+int main(int argc, char** argv) {
+  base::AtExitManager at_exit;
+  base::CommandLine::Init(argc, argv);
+  const auto home =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath("home");
+  if (home.empty()) {
+    return 1;
+  }
+  std::string fixture;
+  if (!base::ReadFileToString(home.AppendASCII("input.json"), &fixture)) {
+    return 2;
+  }
+  auto input = base::JSONReader::ReadDict(fixture, base::JSON_PARSE_RFC);
+  if (!input) {
+    return 3;
+  }
+  const auto* challenge = input->FindString("challenge");
+  const auto* signature = input->FindString("signature");
+  if (!challenge || !signature) {
+    return 4;
+  }
+  auto key = aux::LoadInstallationPublicKey(home);
+  if (!key || !aux::VerifyInstallationChallenge(*key, *challenge, *signature)) {
+    return 5;
+  }
+  auto native_signature = aux::SignDaemonChallenge(home, *challenge);
+  if (!native_signature ||
+      !base::WriteFile(home.AppendASCII("native-signature"),
+                       *native_signature) ||
+      !base::SetPosixFilePermissions(home.AppendASCII("native-signature"),
+                                     0600)) {
+    return 6;
+  }
+  aux::CdpAuthority authority(*key, 45203, {});
+  net::HttpServerRequestInfo request;
+  request.peer = net::IPEndPoint(net::IPAddress::IPv4Localhost(), 40000);
+  request.method = "GET";
+  request.path = "/json/challenge";
+  request.headers["host"] = "127.0.0.1:45203";
+  auto response = authority.Filter(request, false);
+  if (!response || response->status != 200) {
+    return 7;
+  }
+  auto issued =
+      base::JSONReader::ReadDict(response->body, base::JSON_PARSE_RFC);
+  if (!issued) {
+    return 8;
+  }
+  auto signed_challenge =
+      aux::SignDaemonChallenge(home, *issued->FindString("challenge"));
+  if (!signed_challenge) {
+    return 9;
+  }
+  base::DictValue session;
+  session.Set("challengeId", *issued->FindString("challengeId"));
+  session.Set("signedChallenge", *signed_challenge);
+  request.method = "POST";
+  request.path = "/json/auth/session";
+  request.data = base::WriteJson(session).value_or("");
+  response = authority.Filter(request, false);
+  if (!response || response->status != 200) {
+    return 10;
+  }
+  auto token = base::JSONReader::ReadDict(response->body, base::JSON_PARSE_RFC);
+  if (!token || !token->FindString("access_token")) {
+    return 11;
+  }
+  response = authority.Filter(request, false);
+  if (!response || response->status != 401) {
+    return 12;
+  }
+  request.method = "GET";
+  request.path = "/json/version?test=1";
+  request.data.clear();
+  response = authority.Filter(request, false);
+  if (!response || response->status != 401) {
+    return 13;
+  }
+  request.headers["authorization"] =
+      "AuxSessionToken " + *token->FindString("access_token");
+  if (authority.Filter(request, false)) {
+    return 14;
+  }
+  request.path = "/devtools/browser/disposable";
+  if (authority.Filter(request, true)) {
+    return 15;
+  }
+  request.headers["host"] = "evil.example";
+  response = authority.Filter(request, true);
+  if (!response || response->status != 403) {
+    return 16;
+  }
+  request.headers["host"] = "127.0.0.1:45203";
+  request.headers["origin"] = "https://evil.example";
+  response = authority.Filter(request, false);
+  if (!response || response->status != 403) {
+    return 17;
+  }
+  return 0;
+}
diff --git a/chrome/browser/devtools/aux_cdp_authority.h b/chrome/browser/devtools/aux_cdp_authority.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/devtools/aux_cdp_authority.h
@@ -0,0 +1,53 @@
+// Copyright 2026 Aux Authors. All rights reserved.
+// Independent native CDP authorization, platform.md P4.
+#ifndef CHROME_BROWSER_DEVTOOLS_AUX_CDP_AUTHORITY_H_
+#define CHROME_BROWSER_DEVTOOLS_AUX_CDP_AUTHORITY_H_
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/synchronization/lock.h"
+#include "base/time/time.h"
+#include "crypto/keypair.h"
+#include "net/server/http_server_request_info.h"
+#include "net/server/http_server_response_info.h"
+namespace aux {
+struct CdpResponse {
+  int status;
+  std::string body;
+  std::string mime_type = "application/json";
+};
+// Construct with a key loaded on a MayBlock worker. Safe on server or UI
+// sequence.
+class CdpAuthority {
+ public:
+  CdpAuthority(crypto::keypair::PublicKey key,
+               uint16_t port,
+               std::set<std::string> origins);
+  ~CdpAuthority();
+  // nullopt means authorized; a response must be sent before ordinary routing.
+  std::optional<CdpResponse> Filter(const net::HttpServerRequestInfo& request,
+                                    bool websocket);
+
+ private:
+  struct Challenge {
+    std::string bytes;
+    base::TimeTicks expires;
+  };
+  void Prune(base::TimeTicks now) EXCLUSIVE_LOCKS_REQUIRED(lock_);
+  const crypto::keypair::PublicKey key_;
+  const uint16_t port_;
+  const std::set<std::string> origins_;
+  base::Lock lock_;
+  std::map<std::string, Challenge> challenges_ GUARDED_BY(lock_);
+  std::map<std::string, base::TimeTicks> sessions_ GUARDED_BY(lock_);
+};
+using CdpRequestFilter = base::RepeatingCallback<std::optional<
+    net::HttpServerResponseInfo>(const net::HttpServerRequestInfo&, bool)>;
+CdpRequestFilter CreateCdpRequestFilter(
+    std::shared_ptr<CdpAuthority> authority);
+}  // namespace aux
+#endif
diff --git a/chrome/browser/devtools/aux_cdp_authority.cc b/chrome/browser/devtools/aux_cdp_authority.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/devtools/aux_cdp_authority.cc
@@ -0,0 +1,138 @@
+// Copyright 2026 Aux Authors. All rights reserved.
+#include "chrome/browser/devtools/aux_cdp_authority.h"
+
+#include "base/base64.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/uuid.h"
+#include "chrome/browser/aux/installation_auth.h"
+#include "crypto/random.h"
+namespace aux {
+namespace {
+CdpResponse Error(int status, std::string_view code, std::string_view message) {
+  base::DictValue error;
+  error.Set("code", code);
+  error.Set("message", message);
+  base::DictValue body;
+  body.Set("error", std::move(error));
+  return {status, base::WriteJson(body).value_or("{}")};
+}
+bool ValidHost(std::string_view host, uint16_t port) {
+  for (std::string_view name : {"localhost", "127.0.0.1", "[::1]"}) {
+    if (host == name ||
+        host == std::string(name) + ":" + base::NumberToString(port)) {
+      return true;
+    }
+  }
+  return false;
+}
+}  // namespace
+CdpAuthority::CdpAuthority(crypto::keypair::PublicKey key,
+                           uint16_t port,
+                           std::set<std::string> origins)
+    : key_(std::move(key)), port_(port), origins_(std::move(origins)) {}
+CdpAuthority::~CdpAuthority() = default;
+void CdpAuthority::Prune(base::TimeTicks now) {
+  std::erase_if(challenges_,
+                [now](const auto& item) { return item.second.expires <= now; });
+  std::erase_if(sessions_,
+                [now](const auto& item) { return item.second <= now; });
+}
+std::optional<CdpResponse> CdpAuthority::Filter(
+    const net::HttpServerRequestInfo& request,
+    bool websocket) {
+  if (!request.peer.address().IsLoopback() ||
+      !ValidHost(request.GetHeaderValue("host"), port_)) {
+    return Error(403, "FORBIDDEN", "Loopback host required");
+  }
+  const auto origin = request.GetHeaderValue("origin");
+  if (!origin.empty() && !origins_.contains(origin)) {
+    return Error(403, "FORBIDDEN", "Origin is not allowed");
+  }
+  const auto query = request.path.find('?');
+  const std::string path = request.path.substr(0, query);
+  base::AutoLock guard(lock_);
+  const auto now = base::TimeTicks::Now();
+  Prune(now);
+  if (!websocket && path == "/json/challenge") {
+    if (request.method != "GET") {
+      return Error(400, "BAD_REQUEST", "GET required");
+    }
+    if (challenges_.size() >= 1024) {
+      auto oldest =
+          std::min_element(challenges_.begin(), challenges_.end(),
+                           [](const auto& a, const auto& b) {
+                             return a.second.expires < b.second.expires;
+                           });
+      challenges_.erase(oldest);
+    }
+    const std::string id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    const std::string bytes = base::Base64Encode(crypto::RandBytesAsVector(32));
+    challenges_.emplace(id, Challenge{bytes, now + base::Seconds(30)});
+    base::DictValue body;
+    body.Set("challengeId", id);
+    body.Set("challenge", bytes);
+    return CdpResponse{200, base::WriteJson(body).value_or("{}")};
+  }
+  if (!websocket && path == "/json/auth/session") {
+    if (request.method != "POST" || request.data.size() > 16384) {
+      return Error(400, "BAD_REQUEST", "Invalid session request");
+    }
+    auto input = base::JSONReader::ReadDict(request.data, base::JSON_PARSE_RFC);
+    const std::string* id = input ? input->FindString("challengeId") : nullptr;
+    const std::string* signature =
+        input ? input->FindString("signedChallenge") : nullptr;
+    if (!id || !signature) {
+      return Error(400, "BAD_REQUEST", "Challenge and signature required");
+    }
+    auto found = challenges_.find(*id);
+    if (found == challenges_.end()) {
+      return Error(401, "UNAUTHORIZED", "Challenge is invalid or expired");
+    }
+    const auto challenge = std::move(found->second);
+    challenges_.erase(found);
+    if (!VerifyInstallationChallenge(key_, challenge.bytes, *signature)) {
+      return Error(401, "UNAUTHORIZED", "Signature could not be verified");
+    }
+    if (sessions_.size() >= 1024) {
+      return Error(503, "SERVICE_UNAVAILABLE", "Session capacity reached");
+    }
+    const std::string token = base::Base64Encode(crypto::RandBytesAsVector(32));
+    sessions_[token] = now + base::Hours(24);
+    base::DictValue body;
+    body.Set("token_type", "AuxSessionToken");
+    body.Set("access_token", token);
+    body.Set("expiresInSeconds", 86400);
+    return CdpResponse{200, base::WriteJson(body).value_or("{}")};
+  }
+  const std::string authorization = request.GetHeaderValue("authorization");
+  constexpr std::string_view prefix = "AuxSessionToken ";
+  if (!base::StartsWith(authorization, prefix) ||
+      !sessions_.contains(authorization.substr(prefix.size()))) {
+    return Error(401, "UNAUTHORIZED", "Browser authorization required");
+  }
+  return std::nullopt;
+}
+CdpRequestFilter CreateCdpRequestFilter(
+    std::shared_ptr<CdpAuthority> authority) {
+  return base::BindRepeating(
+      [](std::shared_ptr<CdpAuthority> authority,
+         const net::HttpServerRequestInfo& request,
+         bool websocket) -> std::optional<net::HttpServerResponseInfo> {
+        auto result = authority->Filter(request, websocket);
+        if (!result) {
+          return std::nullopt;
+        }
+        net::HttpServerResponseInfo response(
+            static_cast<net::HttpStatusCode>(result->status));
+        response.AddHeader("Cache-Control", "no-store");
+        response.AddHeader("Content-Security-Policy", "default-src 'none'");
+        response.SetBody(result->body, result->mime_type);
+        return response;
+      },
+      std::move(authority));
+}
+}  // namespace aux
