+bool AuxRuntimeHost::TurnContextCurrent(const TurnContextOwner& owner) const {
+  auto* frame = owner.document.AsRenderFrameHostIfValid();
+  auto* shell = frame ? WebUIBrowserWindow::FromWebShellWebContents(content::WebContents::FromRenderFrameHost(frame)) : nullptr;
+  return shell && shell->browser() == owner.window.get() && !shutting_down_ && owner.window && frame &&
+      owner.window->GetProfile() == profile_ && !profile_->IsOffTheRecord() &&
+      owner.generation && owner.generation == admitted_native_generation_ &&
+      owner.generation > retired_native_generation_ &&
+      frame->GetLastCommittedURL().SchemeIs(content::kChromeUIScheme) &&
+      frame->GetLastCommittedURL().host() == chrome::kChromeUIAuxHost;
+}
+void AuxRuntimeHost::CallApiFromWindow(base::WeakPtr<BrowserWindowInterface> window,
+    content::WeakDocumentPtr document, std::string method,
+    std::string params_json, ResponseCallback callback) {
+  // One opaque capability per live original document, never a renderer window ID.
+  std::erase_if(turn_contexts_, [this](const auto& entry) { return !TurnContextCurrent(entry.second); });
+  TurnContextOwner original{std::move(window), std::move(document), admitted_native_generation_};
+  if (!TurnContextCurrent(original)) {
+    std::move(callback).Run({false, "", "ref_stale", "Original turn window is unavailable"}); return;
+  }
+  std::string key;
+  for (const auto& [token, owner] : turn_contexts_)
+    if (owner.window.get() == original.window.get() &&
+        owner.document.AsRenderFrameHostIfValid() == original.document.AsRenderFrameHostIfValid()) { key = token; break; }
+  if (key.empty()) {
+    if (turn_contexts_.size() >= 64) { std::move(callback).Run({false, "", "backend_unavailable", "Too many original turn windows"}); return; }
+    key = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    turn_contexts_.emplace(key, std::move(original));
+  }
+  CallApi(std::move(method), std::move(params_json), std::move(callback), std::move(key));
+}
