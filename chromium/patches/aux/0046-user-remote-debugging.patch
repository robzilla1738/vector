+// UI-owned completion state survives cancellation during listener startup.
+struct DevToolsServerLifecycle {
+  explicit DevToolsServerLifecycle(base::OnceCallback<void(std::string)> callback)
+      : on_started(std::move(callback)) {}
+  void Started(std::string address) {
+    starting = false;
+    if (on_started) std::move(on_started).Run(std::move(address));
+  }
+  void Stopped() {
+    if (stopped) return;
+    stopped = true;
+    if (on_stopped) std::move(on_stopped).Run();
+  }
+  bool starting = true;
+  bool termination_scheduled = false;
+  bool stopped = false;
+  base::OnceCallback<void(std::string)> on_started;
+  base::OnceClosure on_stopped;
+};
