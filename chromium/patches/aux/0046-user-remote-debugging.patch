+void RemoteDebuggingServer::ObserveAuxPreferences(PrefService* local_state) {
+  g_aux_remote_debugging_server = this;
+  pref_change_registrar_ = std::make_unique<PrefChangeRegistrar>();
+  pref_change_registrar_->Init(local_state);
+  for (const char* pref : {prefs::kDevToolsRemoteDebuggingEnabled,
+                           prefs::kDevToolsRemoteDebuggingAllowed}) {
+    pref_change_registrar_->Add(pref, base::BindRepeating(
+        &RemoteDebuggingServer::ReconcileAuxServer, weak_factory_.GetWeakPtr()));
+  }
+  ReconcileAuxServer();
+}
+base::DictValue RemoteDebuggingServer::AuxState() {
+  base::DictValue result;
+  auto* server = g_aux_remote_debugging_server;
+  if (!server || !server->pref_change_registrar_) {
+    result.Set("available", false); result.Set("enabled", false);
+    result.Set("managed", false); result.Set("allowed", false); result.Set("canChange", false);
+    result.Set("state", "unavailable"); result.Set("address", base::Value());
+    result.Set("port", base::Value()); return result;
+  }
+  auto* prefs_service = server->pref_change_registrar_->prefs();
+  const bool allowed = prefs_service->GetBoolean(prefs::kDevToolsRemoteDebuggingAllowed);
+  const bool enabled = prefs_service->GetBoolean(prefs::kDevToolsRemoteDebuggingEnabled);
+  const bool managed = prefs_service->FindPreference(prefs::kDevToolsRemoteDebuggingAllowed)->IsManaged() ||
+      prefs_service->FindPreference(prefs::kDevToolsRemoteDebuggingEnabled)->IsManaged();
+  const std::string address = content::DevToolsAgentHost::GetRemoteDebuggingServerAddress();
+  const GURL endpoint("http://" + address);
+  const bool listening = server->aux_phase_ == AuxPhase::kListening &&
+      endpoint.is_valid() && endpoint.IntPort() > 0;
+  result.Set("available", true); result.Set("enabled", enabled);
+  result.Set("managed", managed); result.Set("allowed", allowed);
+  result.Set("canChange", !prefs_service->FindPreference(prefs::kDevToolsRemoteDebuggingEnabled)->IsManaged() &&
+      (enabled || allowed || !prefs_service->FindPreference(prefs::kDevToolsRemoteDebuggingAllowed)->IsManaged()));
+  result.Set("state", managed && !allowed ? "managed-disabled" :
+      server->aux_phase_ == AuxPhase::kStarting ? "starting" :
+      server->aux_phase_ == AuxPhase::kStopping ? "stopping" :
+      server->aux_phase_ == AuxPhase::kFailed ? "failed" : listening ? "listening" : "off");
+  result.Set("address", listening ? base::Value(address) : base::Value());
+  result.Set("port", listening ? base::Value(endpoint.IntPort()) : base::Value());
+  return result;
+}
+void RemoteDebuggingServer::SetAuxEnabled(bool enabled, base::OnceCallback<void(bool)> callback) {
+  auto* server = g_aux_remote_debugging_server;
+  if (!server || server->aux_requests_.size() >= 64) { std::move(callback).Run(false); return; }
+  auto* local_state = server->pref_change_registrar_->prefs();
+  const auto* allowed_pref = local_state->FindPreference(prefs::kDevToolsRemoteDebuggingAllowed);
+  const auto* enabled_pref = local_state->FindPreference(prefs::kDevToolsRemoteDebuggingEnabled);
+  if ((enabled && allowed_pref->IsManaged() && !local_state->GetBoolean(prefs::kDevToolsRemoteDebuggingAllowed)) ||
+      (enabled_pref->IsManaged() && enabled != local_state->GetBoolean(prefs::kDevToolsRemoteDebuggingEnabled))) {
+    std::move(callback).Run(false); return;
+  }
+  server->aux_requests_.push_back({enabled, std::move(callback)});
+  server->aux_mutating_prefs_ = true;
+  if (enabled && !allowed_pref->IsManaged())
+    local_state->SetBoolean(prefs::kDevToolsRemoteDebuggingAllowed, true);
+  local_state->SetBoolean(prefs::kDevToolsRemoteDebuggingEnabled, enabled);
+  if (!enabled && !allowed_pref->IsManaged())
+    local_state->SetBoolean(prefs::kDevToolsRemoteDebuggingAllowed, false);
+  server->aux_mutating_prefs_ = false;
+  server->ReconcileAuxServer();
+}
+void RemoteDebuggingServer::CompleteAuxRequests() {
+  const bool desired = pref_change_registrar_->prefs()->GetBoolean(prefs::kDevToolsRemoteDebuggingEnabled) &&
+      pref_change_registrar_->prefs()->GetBoolean(prefs::kDevToolsRemoteDebuggingAllowed);
+  if (aux_phase_ == AuxPhase::kStarting || aux_phase_ == AuxPhase::kStopping) return;
+  auto requests = std::move(aux_requests_);
+  for (auto& request : requests)
+    std::move(request.callback).Run(request.enabled == desired &&
+        (desired ? aux_phase_ == AuxPhase::kListening : aux_phase_ == AuxPhase::kOff));
+}
+void RemoteDebuggingServer::ReconcileAuxServer() {
+  if (aux_mutating_prefs_) return;
+  const bool desired = pref_change_registrar_->prefs()->GetBoolean(prefs::kDevToolsRemoteDebuggingEnabled) &&
+      pref_change_registrar_->prefs()->GetBoolean(prefs::kDevToolsRemoteDebuggingAllowed);
+  if (aux_phase_ == AuxPhase::kStopping) return;
+  if (!desired && aux_phase_ != AuxPhase::kOff) {
+    aux_phase_ = AuxPhase::kStopping;
+    const uint64_t epoch = ++aux_epoch_;
+    content::DevToolsAgentHost::StopRemoteDebuggingServer(base::BindOnce(
+        [](base::WeakPtr<RemoteDebuggingServer> server, uint64_t epoch) {
+          if (!server || server->aux_epoch_ != epoch) return;
+          server->aux_phase_ = AuxPhase::kOff;
+          server->ReconcileAuxServer();
+        }, weak_factory_.GetWeakPtr(), epoch));
+    return;
+  }
+  if (desired && aux_phase_ == AuxPhase::kOff) {
+    aux_phase_ = AuxPhase::kStarting;
+    const uint64_t epoch = ++aux_epoch_;
+    content::DevToolsAgentHost::StartRemoteDebuggingServer(
+        std::make_unique<TCPServerSocketFactory>(kDefaultDevToolsPort),
+        base::FilePath(), base::FilePath(),
+        content::DevToolsAgentHost::RemoteDebuggingServerMode::kDefault,
+        base::BindOnce([](base::WeakPtr<RemoteDebuggingServer> server,
+                         uint64_t epoch, std::string address) {
+          if (!server || server->aux_epoch_ != epoch) return;
+          if (address.empty()) {
+            // A failed bind may still own a handler thread. Drain it before
+            // reporting failure or allowing another toggle to start a listener.
+            server->aux_phase_ = AuxPhase::kStopping;
+            content::DevToolsAgentHost::StopRemoteDebuggingServer(base::BindOnce(
+                [](base::WeakPtr<RemoteDebuggingServer> owner, uint64_t epoch) {
+                  if (!owner || owner->aux_epoch_ != epoch) return;
+                  owner->aux_phase_ = AuxPhase::kFailed;
+                  if (!owner->pref_change_registrar_->prefs()->GetBoolean(prefs::kDevToolsRemoteDebuggingEnabled) ||
+                      !owner->pref_change_registrar_->prefs()->GetBoolean(prefs::kDevToolsRemoteDebuggingAllowed))
+                    owner->aux_phase_ = AuxPhase::kOff;
+                  owner->CompleteAuxRequests();
+                }, server, epoch));
+          } else {
+            server->aux_phase_ = AuxPhase::kListening;
+            server->CompleteAuxRequests();
+          }
+        }, weak_factory_.GetWeakPtr(), epoch));
+    return;
+  }
+  CompleteAuxRequests();
 }
