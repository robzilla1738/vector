+base::DictValue ProfileLibrary::FolderSnapshot() const {
+  base::ListValue folders;
+  auto walk = [&](auto&& self, const bookmarks::BookmarkNode* node,
+                  const base::ListValue& path) -> void {
+    const bool permanent = bookmarks_->is_permanent_node(node);
+    base::DictValue folder;
+    folder.Set("nodeId", NodeId(node));
+    folder.Set("parentId",
+               permanent ? base::Value() : base::Value(NodeId(node->parent())));
+    folder.Set(
+        "index",
+        permanent ? 0
+                  : static_cast<int>(node->parent()->GetIndexOf(node).value()));
+    folder.Set("title", base::UTF16ToUTF8(node->GetTitle()));
+    folder.Set("path", path.Clone());
+    folder.Set("permanent", permanent);
+    folder.Set("childIds", ChildIds(node));
+    folders.Append(std::move(folder));
+    for (const auto& child : node->children()) {
+      if (!child->is_folder()) {
+        continue;
+      }
+      base::ListValue child_path = path.Clone();
+      child_path.Append(base::UTF16ToUTF8(child->GetTitle()));
+      self(self, child.get(), child_path);
+    }
+  };
+  walk(walk, bookmarks_->bookmark_bar_node(), base::ListValue());
+  for (const auto& [root, name] : RootAliases()) {
+    base::ListValue path;
+    path.Append(name);
+    walk(walk, root, path);
+  }
+  return base::DictValue()
+      .Set("rootId", NodeId(bookmarks_->bookmark_bar_node()))
+      .Set("editable", profile_->GetPrefs()->GetBoolean(
+                           bookmarks::prefs::kEditBookmarksEnabled))
+      .Set("folders", std::move(folders));
+}
+
+base::DictValue ProfileLibrary::ChangeFolder(const base::DictValue& operation) {
+  if (!profile_->GetPrefs()->GetBoolean(
+          bookmarks::prefs::kEditBookmarksEnabled)) {
+    return Fault("forbidden",
+                 "Bookmark editing is managed by your organization");
+  }
+  const std::string* kind = operation.FindString("kind");
+  if (!kind || (*kind != "create" && *kind != "rename" && *kind != "move" &&
+                *kind != "remove")) {
+    return Fault("invalid_params", "Invalid folder operation");
+  }
+  const bookmarks::BookmarkNode* source = nullptr;
+  if (*kind != "create") {
+    const base::DictValue* expected = operation.FindDict("source");
+    source = expected ? FolderById(bookmarks_, expected->FindString("nodeId"))
+                      : nullptr;
+    if (!source || bookmarks_->is_permanent_node(source) ||
+        *expected != NodeSource(source)) {
+      return Fault("conflict",
+                   "The folder changed. Open its menu and try again.");
+    }
+  }
+  const bookmarks::BookmarkNode* parent = nullptr;
+  size_t index = 0;
+  if (*kind == "create" || *kind == "move") {
+    const base::DictValue* destination = operation.FindDict("destination");
+    parent = destination
+                 ? FolderById(bookmarks_, destination->FindString("parentId"))
+                 : nullptr;
+    const base::ListValue* expected =
+        destination ? destination->FindList("expectedChildren") : nullptr;
+    const std::optional<int> requested_index =
+        destination ? destination->FindInt("index") : std::nullopt;
+    if (!parent || !expected || *expected != ChildIds(parent) ||
+        !requested_index || *requested_index < 0 ||
+        static_cast<size_t>(*requested_index) > parent->children().size()) {
+      return Fault("conflict", "The destination changed. Choose it again.");
+    }
+    index = static_cast<size_t>(*requested_index);
+    if (source && parent->HasAncestor(source)) {
+      return Fault(
+          "invalid_params",
+          "A folder cannot be moved into itself or one of its children");
+    }
+  }
+  base::Value undo;
+  if (*kind == "create") {
+    const std::string* title = operation.FindString("title");
+    if (!title) {
+      return Fault("invalid_params", "A folder name is required");
+    }
+    if (const std::string* absent_id = operation.FindString("absentNodeId")) {
+      int64_t id = 0;
+      if (!base::StringToInt64(*absent_id, &id) || id <= 0 ||
+          bookmarks::GetBookmarkNodeByID(bookmarks_, id)) {
+        return Fault("conflict", "The original folder was already restored");
+      }
+    }
+    const auto* created =
+        bookmarks_->AddFolder(parent, index, base::UTF8ToUTF16(*title));
+    undo = base::Value(base::DictValue()
+                           .Set("kind", "remove")
+                           .Set("source", NodeSource(created)));
+  } else if (*kind == "rename") {
+    const std::string* title = operation.FindString("title");
+    if (!title) {
+      return Fault("invalid_params", "A folder name is required");
+    }
+    const std::string previous = base::UTF16ToUTF8(source->GetTitle());
+    if (*title != previous) {
+      bookmarks_->SetTitle(source, base::UTF8ToUTF16(*title),
+                           bookmarks::metrics::BookmarkEditSource::kUser);
+      undo = base::Value(base::DictValue()
+                             .Set("kind", "rename")
+                             .Set("source", NodeSource(source))
+                             .Set("title", previous));
+    }
+  } else if (*kind == "move") {
+    if (auto inverse = MoveNode(bookmarks_, source, parent, index)) {
+      inverse->Set("kind", "move");
+      undo = base::Value(std::move(*inverse));
+    }
+  } else {
+    if (!source->children().empty()) {
+      return Fault("conflict",
+                   "Remove the folder's contents before removing the folder");
+    }
+    const auto* previous_parent = source->parent();
+    const size_t previous_index = previous_parent->GetIndexOf(source).value();
+    const std::string previous_title = base::UTF16ToUTF8(source->GetTitle());
+    const std::string previous_id = NodeId(source);
+    bookmarks_->Remove(source, bookmarks::metrics::BookmarkEditSource::kUser,
+                       FROM_HERE);
+    undo =
+        base::Value(base::DictValue()
+                        .Set("kind", "create")
+                        .Set("destination",
+                             FolderDestination(previous_parent, previous_index))
+                        .Set("title", previous_title)
+                        .Set("absentNodeId", previous_id));
+  }
+  return Result(base::Value(base::DictValue()
+                                .Set("snapshot", FolderSnapshot())
+                                .Set("undo", std::move(undo))));
+}
+
+base::DictValue ProfileLibrary::PlaceBookmark(const base::DictValue& params) {
+  if (!profile_->GetPrefs()->GetBoolean(
+          bookmarks::prefs::kEditBookmarksEnabled)) {
+    return Fault("forbidden",
+                 "Bookmark editing is managed by your organization");
+  }
+  const base::DictValue* expected_source = params.FindDict("source");
+  const auto* source =
+      expected_source ? FindBookmark(*expected_source, "url") : nullptr;
+  if (!source || bookmarks_->client()->IsNodeManaged(source) ||
+      *expected_source != NodeSource(source)) {
+    return Fault("conflict",
+                 "The bookmark changed. Open its menu and try again.");
+  }
+  const base::DictValue* destination = params.FindDict("destination");
+  const auto* parent =
+      destination ? FolderById(bookmarks_, destination->FindString("parentId"))
+                  : nullptr;
+  const base::ListValue* expected_children =
+      destination ? destination->FindList("expectedChildren") : nullptr;
+  const std::optional<int> index =
+      destination ? destination->FindInt("index") : std::nullopt;
+  if (!parent || !expected_children || *expected_children != ChildIds(parent) ||
+      !index || *index < 0 ||
+      static_cast<size_t>(*index) > parent->children().size()) {
+    return Fault("conflict", "The destination changed. Choose it again.");
+  }
+  auto inverse =
+      MoveNode(bookmarks_, source, parent, static_cast<size_t>(*index));
+  return Result(
+      base::Value(base::DictValue()
+                      .Set("snapshot", FolderSnapshot())
+                      .Set("undo", inverse ? base::Value(std::move(*inverse))
+                                           : base::Value())));
+}
