+std::string NodeId(const bookmarks::BookmarkNode* node) {
+  return base::NumberToString(node->id());
+}
+
+base::ListValue ChildIds(const bookmarks::BookmarkNode* node) {
+  base::ListValue children;
+  for (const auto& child : node->children()) {
+    children.Append(NodeId(child.get()));
+  }
+  return children;
+}
+
+base::DictValue NodeSource(const bookmarks::BookmarkNode* node) {
+  base::DictValue source =
+      base::DictValue()
+          .Set("nodeId", NodeId(node))
+          .Set("parentId", NodeId(node->parent()))
+          .Set("index",
+               static_cast<int>(node->parent()->GetIndexOf(node).value()))
+          .Set("title", base::UTF16ToUTF8(node->GetTitle()));
+  if (node->is_url())
+    source.Set("url", node->url().spec());
+  return source;
+}
+
+const bookmarks::BookmarkNode* FolderById(bookmarks::BookmarkModel* model,
+                                          const std::string* node_id) {
+  int64_t id = 0;
+  if (!node_id || !base::StringToInt64(*node_id, &id) || id <= 0) {
+    return nullptr;
+  }
+  const auto* node = bookmarks::GetBookmarkNodeByID(model, id);
+  return node && node->is_folder() && !model->client()->IsNodeManaged(node)
+             ? node
+             : nullptr;
+}
+
+base::DictValue FolderDestination(const bookmarks::BookmarkNode* parent,
+                                  size_t index) {
+  return base::DictValue()
+      .Set("parentId", NodeId(parent))
+      .Set("index", static_cast<int>(index))
+      .Set("expectedChildren", ChildIds(parent));
+}
+
+std::optional<base::DictValue> MoveNode(bookmarks::BookmarkModel* model,
+                                        const bookmarks::BookmarkNode* source,
+                                        const bookmarks::BookmarkNode* parent,
+                                        size_t index) {
+  const auto* previous_parent = source->parent();
+  const size_t previous_index = previous_parent->GetIndexOf(source).value();
+  if (parent == previous_parent &&
+      (index == previous_index || index == previous_index + 1)) {
+    return std::nullopt;
+  }
+  model->Move(source, parent, index);
+  const size_t current_index = parent->GetIndexOf(source).value();
+  // BookmarkModel takes the insertion index before removing a same-parent node.
+  const size_t restore_index =
+      previous_index +
+      (parent == previous_parent && previous_index > current_index ? 1 : 0);
+  return base::DictValue()
+      .Set("source", NodeSource(source))
+      .Set("destination", FolderDestination(previous_parent, restore_index));
+}
