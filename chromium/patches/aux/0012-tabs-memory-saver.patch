+
+void TabCatalog::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::kReplaced) {
+    const auto* replacement = change.GetReplace();
+    if (auto* identity =
+            PageIdentity::FromWebContents(replacement->old_contents)) {
+      ++generations_[identity->id()];
+    }
+    PageIdentity::Transfer(replacement->old_contents,
+                           replacement->new_contents);
+  }
+  // Discard/replacement may change contents without selecting a different tab.
+  if (change.type() != TabStripModelChange::kReplaced &&
+      selection.active_tab_changed() && selection.new_contents) {
+    last_active_at_[PageIdentity::GetOrCreate(profile_, selection.new_contents)] =
+        NowMs();
+  }
+  Changed();
+}
