+base::DictValue TabCatalog::Reject(const std::string& command_id,
+                                     std::string code,
+                                     std::string message) const {
+  base::DictValue error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::DictValue ack;
+  ack.Set("commandId", command_id);
+  ack.Set("status", "rejected");
+  ack.Set("catalogVersion", version_);
+  ack.Set("error", std::move(error));
+  return ack;
+}
+
+bool TabCatalog::IsMemorySaverMinutes(int minutes) {
+  return minutes == 0 || minutes == 1 || minutes == 15 || minutes == 30 ||
+         minutes == 60;
+}
+
+base::DictValue TabCatalog::MemorySaverGet() const {
+  const auto* prefs = profile_->GetPrefs();
+  const int stored = prefs->GetInteger(kMemorySaverMinutesPref);
+  base::DictValue result;
+  result.Set("minutes", IsMemorySaverMinutes(stored) ? stored : 30);
+  result.Set("managed",
+             prefs->FindPreference(kMemorySaverMinutesPref)->IsManaged());
+  return result;
+}
+
+bool TabCatalog::MemorySaverSet(int minutes) {
+  if (!profile_ || profile_->IsOffTheRecord() || profile_->IsGuestSession() ||
+      !IsMemorySaverMinutes(minutes) ||
+      profile_->GetPrefs()
+          ->FindPreference(kMemorySaverMinutesPref)
+          ->IsManaged()) {
+    return false;
+  }
+  profile_->GetPrefs()->SetInteger(kMemorySaverMinutesPref, minutes);
+  return true;
+}
+
+std::optional<base::TimeTicks> TabCatalog::MemorySaverDeadline(
+    TabStripModel* model,
+    int index,
+    base::TimeTicks now) {
+  auto* contents = model->GetWebContentsAt(index);
+  const auto* identity = PageIdentity::FromWebContents(contents);
+  if (!identity) {
+    return std::nullopt;
+  }
+  const auto& page_id = identity->id();
+  auto seen = memory_saver_seen_at_.try_emplace(page_id, now).first;
+  if (contents->GetVisibility() != content::Visibility::HIDDEN ||
+      model->GetActiveWebContents() == contents) {
+    seen->second = now;
+    memory_saver_retry_at_.erase(page_id);
+    return std::nullopt;
+  }
+  if (model->IsTabPinned(index) || model->GetSplitForTab(index) ||
+      contents->IsLoading() || contents->IsCrashed() ||
+      !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  auto* lifecycle =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(contents);
+  if (!lifecycle ||
+      lifecycle->GetTabState() != mojom::LifecycleUnitState::ACTIVE) {
+    return std::nullopt;
+  }
+  auto page =
+      performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(
+          contents);
+  if (!page || !page->GetPrimaryMainFrameNode()) {
+    return std::nullopt;
+  }
+  const int minutes = MemorySaverGet().FindInt("minutes").value();
+  auto deadline = std::max(seen->second, page->GetLastVisibilityChangeTime()) +
+                  base::Minutes(minutes);
+  if (auto retry = memory_saver_retry_at_.find(page_id);
+      retry != memory_saver_retry_at_.end()) {
+    deadline = std::max(deadline, retry->second);
+  }
+  return deadline;
+}
+
+void TabCatalog::ScheduleMemorySaver() {
+  if (!profile_ || profile_->IsOffTheRecord() || profile_->IsGuestSession() ||
+      !browsers_ || !performance_manager::PerformanceManager::IsAvailable() ||
+      MemorySaverGet().FindInt("minutes") == 0) {
+    memory_saver_timer_.Stop();
+    return;
+  }
+  const auto now = base::TimeTicks::Now();
+  std::optional<base::TimeTicks> next;
+  std::set<std::string> present;
+  browsers_->ForEach([&](BrowserWindowInterface* browser) {
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        IsQuickAskWindow(browser) || IsLittleWindow(browser)) {
+      return true;
+    }
+    auto* model = browser->GetTabStripModel();
+    if (!model) {
+      return true;
+    }
+    for (int index = 0; index < model->count(); ++index) {
+      if (const auto* identity =
+              PageIdentity::FromWebContents(model->GetWebContentsAt(index))) {
+        present.insert(identity->id());
+      }
+      auto deadline = MemorySaverDeadline(model, index, now);
+      if (deadline && (!next || *deadline < *next)) {
+        next = deadline;
+      }
+    }
+    return true;
+  });
+  std::erase_if(memory_saver_seen_at_, [&](const auto& entry) {
+    return !present.contains(entry.first);
+  });
+  std::erase_if(memory_saver_retry_at_, [&](const auto& entry) {
+    return !present.contains(entry.first);
+  });
+  if (!next) {
+    memory_saver_timer_.Stop();
+    return;
+  }
+  const auto deadline = std::max(*next, now + base::Milliseconds(1));
+  if (memory_saver_timer_.IsRunning() &&
+      memory_saver_timer_.desired_run_time() == deadline) {
+    return;
+  }
+  memory_saver_timer_.Start(
+      FROM_HERE, deadline - now,
+      base::BindOnce(&TabCatalog::RunMemorySaver, weak_factory_.GetWeakPtr()));
+}
+
+void TabCatalog::RunMemorySaver() {
+  if (!profile_ || !browsers_ ||
+      !performance_manager::PerformanceManager::IsAvailable() ||
+      MemorySaverGet().FindInt("minutes") == 0) {
+    return;
+  }
+  const auto now = base::TimeTicks::Now();
+  BrowserWindowInterface* owner = nullptr;
+  std::string page_id;
+  std::string url;
+  browsers_->ForEach([&](BrowserWindowInterface* browser) {
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        IsQuickAskWindow(browser) || IsLittleWindow(browser)) {
+      return true;
+    }
+    auto* model = browser->GetTabStripModel();
+    if (!model) {
+      return true;
+    }
+    for (int index = 0; index < model->count(); ++index) {
+      auto deadline = MemorySaverDeadline(model, index, now);
+      if (!deadline || *deadline > now) {
+        continue;
+      }
+      auto* contents = model->GetWebContentsAt(index);
+      owner = browser;
+      page_id = PageIdentity::FromWebContents(contents)->id();
+      url = contents->GetLastCommittedURL().spec();
+      return false;
+    }
+    return true;
+  });
+  if (owner) {
+    // One discard per UI task; protected/unknown pages get a bounded retry.
+    memory_saver_retry_at_[page_id] = now + base::Minutes(1);
+    auto weak = weak_factory_.GetWeakPtr();
+    SleepTab(owner, page_id, url);
+    if (!weak) {
+      return;
+    }
+  }
+  ScheduleMemorySaver();
+}
+
+base::DictValue TabCatalog::SleepTab(BrowserWindowInterface* issuer,
+                                      const std::string& page_id,
+                                      const std::string& expected_url) {
+  auto refused = [](std::string reason) {
+    base::DictValue result;
+    result.Set("slept", false);
+    result.Set("reason", std::move(reason));
+    return result;
+  };
+  if (!issuer || !profile_ || profile_->IsOffTheRecord())
+    return refused("Sleeping tabs is unavailable in this window.");
+  BrowserWindowInterface* owner = nullptr;
+  content::WebContents* contents = FindPage(page_id, &owner);
+  if (!contents || owner != issuer ||
+      contents->GetLastCommittedURL().spec() != expected_url ||
+      !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS())
+    return refused("The tab changed or moved. Review it again.");
+  TabStripModel* model = issuer->GetTabStripModel();
+  const int index = model->GetIndexOfWebContents(contents);
+  if (index < 0 || contents->GetVisibility() != content::Visibility::HIDDEN ||
+      model->GetActiveWebContents() == contents || contents->IsLoading() ||
+      contents->IsCrashed()) {
+    return refused("Only a loaded background tab can sleep.");
+  }
+  const PageIdentity* identity = PageIdentity::FromWebContents(contents);
+  if (!identity) return refused("This tab has no stable identity.");
+  if (!EgressController::ForProfile(profile_)->CanDiscardPage(contents)) {
+    return refused("This tab still has active or resumable work.");
+  }
+  if (contents->IsCurrentlyAudible()) return refused("Playing audio keeps this tab awake.");
+  auto capture = MediaCaptureDevicesDispatcher::GetInstance()->GetMediaStreamCaptureIndicator();
+  if (capture->IsCapturingUserMedia(contents) || capture->IsBeingMirrored(contents) ||
+      capture->IsCapturingTab(contents) || capture->IsCapturingWindow(contents) ||
+      capture->IsCapturingDisplay(contents))
+    return refused("Captured tabs stay awake.");
+  if (contents->NeedToFireBeforeUnloadOrUnloadEvents())
+    return refused("This tab has unload handlers and stays awake.");
+  if (model->IsTabPinned(index)) return refused("Pinned tabs stay awake.");
+  if (model->GetSplitForTab(index)) {
+    return refused("Split tabs stay awake.");
+  }
+  std::string organization_error;
+  const auto organization =
+      OrganizationStore::ProfileSnapshot(profile_, &organization_error);
+  if (!organization) {
+    return refused("Tab organization is unavailable.");
+  }
+  if (const auto* shared = organization->FindDict("shared")) {
+    for (const auto pins : *shared->FindDict("pins")) {
+      for (const auto& pin : pins.second.GetList()) {
+        if (const auto* bound = pin.GetDict().FindString("pageId");
+            bound && *bound == page_id) {
+          return refused("Pinned tabs stay awake.");
+        }
+      }
+    }
+    for (const auto& split : *shared->FindList("splitGroups")) {
+      if (std::ranges::any_of(*split.GetDict().FindList("panes"),
+                              [&](const base::Value& pane) {
+                                return pane.GetString() == page_id;
+                              })) {
+        return refused("Split tabs stay awake.");
+      }
+    }
+  }
+  if (!performance_manager::PerformanceManager::IsAvailable()) {
+    return refused("Chromium cannot verify this tab's discard safety.");
+  }
+  auto page =
+      performance_manager::PerformanceManager::GetPrimaryPageNodeForWebContents(
+          contents);
+  auto* policy =
+      performance_manager::policies::DiscardEligibilityPolicy::GetFromGraph(
+          performance_manager::PerformanceManager::GetGraph());
+  bool frames_live = true;
+  contents->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+    frames_live = frames_live && frame->IsRenderFrameLive();
+  });
+  if (!frames_live || !page || !policy ||
+      !performance_manager::PageLiveStateDecorator::Data::FromPageNode(
+          page.get()) ||
+      policy->CanDiscard(page.get(),
+                         mojom::LifecycleUnitDiscardReason::PROACTIVE,
+                         /*ignore_recent_visibility=*/true) !=
+          performance_manager::policies::CanDiscardResult::kEligible) {
+    return refused("This tab has protected or unverified work.");
+  }
+  const uint64_t estimate_kib =
+      performance_manager::user_tuning::GetDiscardedMemoryEstimateForPage(
+          page.get())
+          .InKiB();
+  auto* lifecycle = resource_coordinator::TabLifecycleUnitExternal::FromWebContents(contents);
+  auto weak = weak_factory_.GetWeakPtr();
+  if (!lifecycle || !lifecycle->IsAutoDiscardable() ||
+      lifecycle->GetTabState() != mojom::LifecycleUnitState::ACTIVE ||
+      !lifecycle->DiscardTab(mojom::LifecycleUnitDiscardReason::PROACTIVE, estimate_kib))
+    return refused("Chromium kept this tab active.");
+  if (weak) {
+    Changed();
+  }
+  base::DictValue result;
+  result.Set("slept", true);
+  if (estimate_kib > 0)
+    result.Set("estimatedSavedBytes", static_cast<double>(estimate_kib) * 1024.0);
+  return result;
+}
+
+base::DictValue TabCatalog::Command(BrowserWindowInterface* issuer,
+                                      const std::string& command_id,
+                                      const base::DictValue& command,
+                                      std::optional<int> expected_version) {
+  if (auto existing = command_acks_.find(command_id);
+      existing != command_acks_.end()) {
+    base::DictValue ack = existing->second.Clone();
+    ack.Set("status", "duplicate");
+    return ack;
+  }
+  if (!issuer || issuer->GetProfile() != profile_ ||
+      issuer->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return Reject(command_id, "forbidden",
+                  "The tab command has no owning window");
+  }
+  if (expected_version && *expected_version != version_) {
+    return Reject(command_id, "stale_tab",
+                  "The tab catalog changed; refresh before retrying");
+  }
+  const std::string* kind = command.FindString("kind");
+  if (!kind) {
+    return Reject(command_id, "invalid_params", "Missing tab command kind");
+  }
+  executing_command_ = true;
+  base::ScopedClosureRunner finish_command(
+      base::BindOnce(&TabCatalog::FinishCommand, base::Unretained(this)));
+  TabStripModel* model = issuer->GetTabStripModel();
+  std::string result_page_id;
+  if (*kind == "open") {
+    const std::string* requested_id = command.FindString("pageId");
+    if (requested_id &&
+        (!PageIdentity::IsValid(*requested_id) || FindPage(*requested_id))) {
+      return Reject(command_id, "invalid_params",
+                    "Requested page ID is invalid or already in use");
+    }
+    const std::string* url_text = command.FindString("url");
+    const GURL url(url_text ? *url_text : "");
+    if (url_text && !url_text->empty() && !url.is_valid()) {
+      return Reject(command_id, "invalid_params", "Invalid tab URL");
+    }
+    std::set<content::WebContents*> before;
+    for (int index = 0; index < model->count(); ++index) {
+      before.insert(model->GetWebContentsAt(index));
+    }
+    const int position = command.FindInt("index").value_or(-1);
+    const bool foreground =
+        command.FindBool("activate")
+            .value_or(!command.FindBool("background").value_or(false));
+    model->delegate()->AddTabAt(url, position, foreground);
+    for (int index = 0; index < model->count(); ++index) {
+      content::WebContents* candidate = model->GetWebContentsAt(index);
+      if (!before.contains(candidate)) {
+        if (requested_id) {
+          PageIdentity::Assign(profile_, candidate, *requested_id);
+        }
+        result_page_id = PageIdentity::GetOrCreate(profile_, candidate);
+        Changed();
+        break;
+      }
+    }
+    if (result_page_id.empty()) {
+      return Reject(command_id, "backend_unavailable",
+                    "Chromium did not create the tab");
+    }
+  } else if (*kind == "split") {
+    const auto* ids = command.FindList("pageIds");
+    const auto* layout = command.FindString("layout");
+    const auto ratio = command.FindDouble("ratio");
+    if (!ids || ids->size() != 2 || !(*ids)[0].is_string() || !(*ids)[1].is_string() ||
+        (*ids)[0].GetString() == (*ids)[1].GetString() || !layout ||
+        (*layout != "row" && *layout != "column") || !ratio || !std::isfinite(*ratio) ||
+        *ratio < .1 || *ratio > .9) return Reject(command_id, "invalid_params", "Invalid split pair");
+    std::vector<int> indices;
+    for (const auto& value : *ids) {
+      BrowserWindowInterface* owner = nullptr;
+      auto* contents = FindPage(value.GetString(), &owner);
+      const auto* identity = contents ? PageIdentity::FromWebContents(contents) : nullptr;
+      if (!contents || owner != issuer || !identity || identity->runtime_owned())
+        return Reject(command_id, "forbidden", "Split panes must belong to this window");
+      EgressRequestContext context;
+      context.page_id = value.GetString();
+      context.document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+      if (EgressController::ForProfile(profile_)->IsProtected(context))
+        return Reject(command_id, "forbidden", "Aux is working in this tab");
+      indices.push_back(model->GetIndexOfWebContents(contents));
+    }
+    auto first = model->GetSplitForTab(indices[0]);
+    auto second = model->GetSplitForTab(indices[1]);
+    const auto shape = *layout == "row" ? split_tabs::SplitTabLayout::kSideBySide : split_tabs::SplitTabLayout::kStacked;
+    if (first && first == second) {
+      const auto* data = model->GetSplitData(*first);
+      if (static_cast<int>(data->GetIndexRange().start()) != indices[0]) model->ReverseTabsInSplit(*first);
+      model->UpdateSplitLayout(*first, shape); model->UpdateSplitRatio(*first, *ratio);
+    } else {
+      if (first || second) return Reject(command_id, "conflict", "Separate existing split tabs first");
+      model->AddToNewSplit(indices, split_tabs::SplitTabVisualData(shape, *ratio), split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+    }
+    result_page_id = (*ids)[0].GetString();
+  } else if (*kind == "claim" || *kind == "move") {
+    const std::string* page_id = command.FindString("pageId");
+    BrowserWindowInterface* source = nullptr;
+    content::WebContents* contents = page_id ? FindPage(*page_id, &source) : nullptr;
+    if (!contents || !source || source->GetProfile() != profile_ ||
+        source->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        profile_->IsOffTheRecord() || IsQuickAskWindow(source) || IsQuickAskWindow(issuer) || IsLittleWindow(source) || IsLittleWindow(issuer)) {
+      return Reject(command_id, "forbidden", "Only normal tabs in this Profile can move");
+    }
+    BrowserWindowInterface* destination = issuer;
+    if (*kind == "move") {
+      if (source != issuer) return Reject(command_id, "forbidden", "Move must originate in the owning window");
+      if (const std::string* window_id = command.FindString("windowId")) {
+        int parsed = 0;
+        destination = base::StringToInt(*window_id, &parsed) && parsed > 0
+            ? browsers_->FindBrowserWithID(SessionID::FromSerializedValue(parsed)) : nullptr;
+        if (!destination || destination->GetProfile() != profile_ ||
+            destination->GetType() != BrowserWindowInterface::TYPE_NORMAL || IsQuickAskWindow(destination) || IsLittleWindow(destination)) {
+          return Reject(command_id, "forbidden", "Destination must be a normal window in this Profile");
+        }
+      } else {
+        destination = nullptr;
+      }
+    }
+    TabStripModel* source_model = source->GetTabStripModel();
+    const int source_index = source_model->GetIndexOfWebContents(contents);
+    if (source_index < 0 || contents->GetUserData(kAnchorKey))
+      return Reject(command_id, "not_found", "This tab cannot move");
+    std::set<std::string> shared_members;
+    std::string organization_error;
+    auto organization = OrganizationStore::Snapshot(profile_, WindowId(source), &organization_error);
+    if (!organization) {
+      return Reject(command_id, "backend_unavailable", organization_error.empty()
+          ? "The Profile organization is unavailable; no tabs were moved"
+          : organization_error);
+    }
+    {
+      const auto* layout = organization->FindDict("layout");
+      const auto* shared = layout ? layout->FindDict("shared") : nullptr;
+      const auto* groups = shared ? shared->FindList("splitGroups") : nullptr;
+      if (groups) for (const auto& group : *groups) {
+        const auto* panes = group.is_dict() ? group.GetDict().FindList("panes") : nullptr;
+        if (!panes) continue;
+        bool member = false;
+        for (const auto& pane : *panes) if (pane.is_string() && pane.GetString() == *page_id) member = true;
+        if (member) for (const auto& pane : *panes) {
+          if (!pane.is_string()) return Reject(command_id, "invalid_params", "Invalid split group");
+          BrowserWindowInterface* owner = nullptr;
+          if (!FindPage(pane.GetString(), &owner) || owner != source)
+            return Reject(command_id, "conflict", "The split group no longer belongs to one window");
+          shared_members.insert(pane.GetString());
+        }
+      }
+    }
+    std::vector<int> indices;
+    std::vector<std::string> moved_ids;
+    const auto split = source_model->GetSplitForTab(source_index);
+    for (int index = 0; index < source_model->count(); ++index) {
+      auto* member = source_model->GetWebContentsAt(index);
+      if (index != source_index && (!split || source_model->GetSplitForTab(index) != split) && !shared_members.contains(PageIdentity::GetOrCreate(profile_, member))) continue;
+      const auto* identity = PageIdentity::FromWebContents(member);
+      EgressRequestContext context;
+      context.document = member->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+      context.page_id = PageIdentity::GetOrCreate(profile_, member);
+      if ((identity && identity->runtime_owned()) || EgressController::ForProfile(profile_)->IsProtected(context))
+        return Reject(command_id, "forbidden", "Aux is working in this tab. Show its window instead");
+      indices.push_back(index);
+      moved_ids.push_back(context.page_id);
+    }
+    if (!destination) {
+      BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_NORMAL, profile_, true);
+      destination = CreateBrowserWindow(std::move(params));
+      if (!destination) return Reject(command_id, "backend_unavailable", "Aux could not create a window");
+    }
+    if (source != destination) {
+      if (indices.size() == static_cast<size_t>(source_model->count())) {
+        const int previous_count = source_model->count();
+        chrome::AddTabAt(source, GURL("about:blank"), -1, false);
+        if (source_model->count() != previous_count + 1)
+          return Reject(command_id, "backend_unavailable", "Aux could not preserve the source window");
+        auto* anchor = source_model->GetWebContentsAt(previous_count);
+        if (!anchor || std::ranges::find(moved_ids, PageIdentity::GetOrCreate(profile_, anchor)) != moved_ids.end())
+          return Reject(command_id, "backend_unavailable", "Aux could not preserve the source window");
+        anchor->SetUserData(kAnchorKey, std::make_unique<base::SupportsUserData::Data>());
+        PageIdentity::MarkEphemeralTask(profile_, anchor);
+      }
+      chrome::MoveTabsToExistingWindow(source, destination, indices);
+    }
+    BrowserWindowInterface* actual = nullptr;
+    if (FindPage(*page_id, &actual) != contents || actual != destination)
+      return Reject(command_id, "backend_unavailable", "Chromium did not preserve the moved tab");
+    if (command.FindBool("activate").value_or(true)) {
+      destination->GetTabStripModel()->ActivateTabAt(destination->GetTabStripModel()->GetIndexOfWebContents(contents));
+      destination->GetWindow()->Show();
+      destination->GetWindow()->Activate();
+    }
+    for (const auto& moved_id : moved_ids) {
+      if (auto* moved = FindPage(moved_id)) {
+        const auto* identity = PageIdentity::FromWebContents(moved);
+        if (!identity->space_id().empty()) BindSpace(moved_id, identity->space_id(), identity->workspace_id());
+      }
+    }
+    auto* destination_model = destination->GetTabStripModel();
+    for (int index = destination_model->count() - 1; index >= 0; --index) {
+      if (destination_model->GetWebContentsAt(index)->GetUserData(kAnchorKey))
+        destination_model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+    }
+    result_page_id = *page_id;
+  } else if (*kind == "reorder") {
+    const base::ListValue* order = command.FindList("order");
+    size_t visible_count = 0;
+    for (int index = 0; index < model->count(); ++index) {
+      if (!model->GetWebContentsAt(index)->GetUserData(kAnchorKey))
+        ++visible_count;
+    }
+    if (!order || order->size() != visible_count) {
+      return Reject(command_id, "invalid_params",
+                    "Tab order must contain every tab in this window");
+    }
+    std::set<std::string> unique;
+    for (const base::Value& value : *order) {
+      if (!value.is_string() || !unique.insert(value.GetString()).second) {
+        return Reject(command_id, "invalid_params",
+                      "Duplicate or invalid tab in order");
+      }
+      BrowserWindowInterface* owner = nullptr;
+      auto* ordered = FindPage(value.GetString(), &owner);
+      if (!ordered || owner != issuer || ordered->GetUserData(kAnchorKey)) {
+        return Reject(command_id, "forbidden", "Tab order crosses a window");
+      }
+    }
+    for (size_t destination = 0; destination < order->size(); ++destination) {
+      content::WebContents* contents =
+          FindPage((*order)[destination].GetString());
+      const int source = model->GetIndexOfWebContents(contents);
+      if (source != static_cast<int>(destination)) {
+        model->MoveWebContentsAt(source, static_cast<int>(destination), false);
+      }
+    }
+  } else {
+    const std::string* page_id = command.FindString("pageId");
+    BrowserWindowInterface* owner = nullptr;
+    content::WebContents* contents =
+        page_id ? FindPage(*page_id, &owner) : nullptr;
+    if (!contents || !owner || owner != issuer) {
+      return Reject(command_id, "not_found", "Tab is not in this window");
+    }
+    result_page_id = *page_id;
+    const int index = model->GetIndexOfWebContents(contents);
+    if (*kind == "activate") {
+      model->ActivateTabAt(index);
+      // The Aux shell can keep an already-selected restored tab hidden behind
+      // chat, so activation alone need not trigger Chromium's normal load.
+      LoadPersonRestoredTab(profile_, contents);
+    } else if (*kind == "unsplit") {
+      const auto* identity = PageIdentity::FromWebContents(contents);
+      if (!identity || identity->runtime_owned()) return Reject(command_id, "forbidden", "A runtime tab cannot be split");
+      EgressRequestContext context;
+      context.page_id = *page_id;
+      context.document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+      if (EgressController::ForProfile(profile_)->IsProtected(context))
+        return Reject(command_id, "forbidden", "Aux is working in this tab");
+      if (const auto split = model->GetSplitForTab(index)) model->RemoveSplit(*split);
+    } else if (*kind == "close") {
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    } else if (*kind == "navigate") {
+      const std::string* url_text = command.FindString("url");
+      const GURL url(url_text ? *url_text : "");
+      if (!url.is_valid()) {
+        return Reject(command_id, "invalid_params", "Invalid navigation URL");
+      }
+      content::NavigationController::LoadURLParams load(url);
+      contents->GetController().LoadURLWithParams(load);
+    } else if (*kind == "back") {
+      if (contents->GetController().CanGoBack()) {
+        contents->GetController().GoBack();
+      }
+    } else if (*kind == "forward") {
+      if (contents->GetController().CanGoForward()) {
+        contents->GetController().GoForward();
+      }
+    } else if (*kind == "reload") {
+      contents->GetController().Reload(
+          command.FindBool("hard").value_or(false)
+              ? content::ReloadType::BYPASSING_CACHE
+              : content::ReloadType::NORMAL,
+          true);
+    } else if (*kind == "stop") {
+      contents->Stop();
+    } else if (*kind == "setMuted") {
+      const std::optional<bool> muted = command.FindBool("muted");
+      if (!muted) {
+        return Reject(command_id, "invalid_params", "Missing muted state");
+      }
+      contents->SetAudioMuted(*muted);
+    } else {
+      return Reject(command_id, "not_found", "Unsupported tab command");
+    }
+  }
+  finish_command.RunAndReset();
+  base::DictValue ack;
+  ack.Set("commandId", command_id);
+  ack.Set("status", "applied");
+  ack.Set("catalogVersion", version_);
+  ack.Set("pageId", result_page_id);
+  BrowserWindowInterface* result_owner = nullptr;
+  if (FindPage(result_page_id, &result_owner) && result_owner) ack.Set("windowId", WindowId(result_owner));
+  command_acks_[command_id] = ack.Clone();
+  ack_order_.push_back(command_id);
+  if (ack_order_.size() > 1024) {
+    command_acks_.erase(ack_order_.front());
+    ack_order_.pop_front();
+  }
+  return ack;
+}
+
+}  // namespace aux
