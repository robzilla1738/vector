+namespace {
+base::DictValue NativeFault(std::string code, std::string message) {
+  base::DictValue error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::DictValue reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+base::DictValue NativeResult(base::Value value) {
+  base::DictValue reply;
+  reply.Set("result", std::move(value));
+  return reply;
+}
+}  // namespace
+
+base::DictValue AuxRuntimeHost::HandleNativeTabsCall(
+    const std::string& method, const base::DictValue& params,
+    uint64_t connection_generation) {
+  auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+  if (method == "native.spaceBindingsSet") {
+    if (profile_->IsOffTheRecord())
+      return NativeFault("forbidden",
+                         "Private tabs do not bind to saved Spaces");
+    if (shutting_down_ || !connection_generation ||
+        admitted_native_generation_ != connection_generation ||
+        connection_generation <= retired_native_generation_)
+      return NativeFault("ref_stale", "Original native connection was retired");
+    const auto* entries = params.FindList("bindings");
+    if (!entries || params.size() != 1)
+      return NativeFault("invalid_params", "Invalid native Space bindings");
+    std::map<std::string, std::string> bindings;
+    for (const auto& value : *entries) {
+      const auto* entry = value.GetIfDict();
+      const auto* space = entry ? entry->FindString("spaceId") : nullptr;
+      const auto* workspace =
+          entry ? entry->FindString("workspaceId") : nullptr;
+      if (!space || !workspace || entry->size() != 2 || space->empty() ||
+          workspace->empty() || space->size() > 128 ||
+          workspace->size() > 128 ||
+          !bindings.emplace(*space, *workspace).second)
+        return NativeFault("invalid_params",
+                           "Invalid native Space binding identity");
+    }
+    catalog->SetRuntimeSpaceBindings(std::move(bindings));
+    return NativeResult(base::Value(base::DictValue().Set("accepted", true)));
+  }
+  if (method == "native.listPages") {
+    base::DictValue snapshot = catalog->Snapshot();
+    base::ListValue pages;
+    const base::ListValue* tabs = snapshot.FindList("tabs");
+    const base::ListValue* windows = snapshot.FindList("windows");
+    for (const base::Value& value : *tabs) {
+      const base::DictValue& tab = value.GetDict();
+      const std::string& page_id = *tab.FindString("pageId");
+      base::DictValue page;
+      page.Set("pageId", page_id);
+      page.Set("windowId", *tab.FindString("windowId"));
+      page.Set("marker", "atab-" + page_id);
+      page.Set("url", *tab.FindString("url"));
+      page.Set("title", *tab.FindString("title"));
+      if (const std::string* lifecycle = tab.FindString("lifecycle"))
+        page.Set("lifecycle", *lifecycle);
+      bool active = false;
+      for (const base::Value& window_value : *windows) {
+        const base::DictValue& window = window_value.GetDict();
+        const std::string* active_id = window.FindString("activePageId");
+        if (active_id && *active_id == page_id) {
+          active = true;
+          break;
+        }
+      }
+      page.Set("active", active);
+      const std::string* lifecycle = tab.FindString("lifecycle");
+      if (!lifecycle || (*lifecycle != "placeholder" && *lifecycle != "discarded")) {
+        if (content::WebContents* contents = catalog->FindPage(page_id)) {
+          page.Set("cdpTargetId",
+                   content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId());
+        }
+      }
+      pages.Append(std::move(page));
+    }
+    base::DictValue result;
+    result.Set("pages", std::move(pages));
+    return NativeResult(base::Value(std::move(result)));
+  }
+  if (method == "native.creatorCleanupProof") {
+    if (shutting_down_ || !connection_generation || admitted_native_generation_ != connection_generation ||
+        connection_generation <= retired_native_generation_)
+      return NativeFault("ref_stale", "Original native connection was retired");
+    return aux::EgressController::ForProfile(profile_)->CreatorCleanupProof(params, connection_generation);
+  }
+  if (method == "native.createAgentPage") {
+    if (shutting_down_ || !connection_generation || admitted_native_generation_ != connection_generation ||
+        connection_generation <= retired_native_generation_)
+      return NativeFault("ref_stale", "Original native creation connection was retired");
+    const std::string* profile_id = params.FindString("profileId");
+    const std::string* run_id = params.FindString("runId");
+    const std::string* window_id = params.FindString("windowId");
+    const std::string* mode = params.FindString("mode");
+    if (!mode || (*mode != "session" && *mode != "private"))
+      return NativeFault("permission_denied", "Invalid Agent storage mode");
+    const bool session = *mode == "session";
+    const int revision = params.FindInt("taskRevision").value_or(-1);
+    const std::string task_id = params.FindString("taskId")
+                                    ? *params.FindString("taskId") : "";
+    if (!profile_id || *profile_id != ProfileId(profile_) || !run_id ||
+        run_id->empty() || !window_id || revision < 0) {
+      return NativeFault("permission_denied", "Invalid task-tab authority");
+    }
+    const auto* original_ancestry = params.FindList("ancestry");
+    std::vector<std::string> ancestry;
+    if (!original_ancestry || original_ancestry->empty() || original_ancestry->size() > 32)
+      return NativeFault("permission_denied", "Original task ancestry is missing");
+    for (const auto& value : *original_ancestry) {
+      if (!value.is_string() || value.GetString().empty() || value.GetString().size() > 160)
+        return NativeFault("permission_denied", "Original task ancestry is invalid");
+      ancestry.push_back(value.GetString());
+    }
+    if (ancestry.front() != *run_id || std::set<std::string>(ancestry.begin(), ancestry.end()).size() != ancestry.size())
+      return NativeFault("permission_denied", "Original task ancestry is ambiguous");
+    auto* browsers = ProfileBrowserCollection::GetForProfile(profile_);
+    BrowserWindowInterface* issuer = nullptr;
+    if (browsers && *window_id == "main") {
+      issuer = browsers->FindTabbedBrowser();
+    } else if (browsers) {
+      int parsed_id = 0;
+      if (base::StringToInt(*window_id, &parsed_id) && parsed_id > 0) {
+        issuer = browsers->FindBrowserWithID(
+            SessionID::FromSerializedValue(parsed_id));
+      }
+    }
+    if (!issuer || issuer->GetProfile() != profile_ ||
+        issuer->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+      return NativeFault("not_found", "Task tab needs a regular Profile window");
+    }
+    auto* egress = aux::EgressController::ForProfile(profile_);
+    const base::DictValue* source = params.FindDict("source");
+    if (source) {
+      auto current = egress->Context(*source);
+      const auto* result = current.FindDict("result");
+      const auto* actual_token = result ? result->FindString("documentToken") : nullptr;
+      const auto* expected_token = source->FindString("documentToken");
+      if (!actual_token || !expected_token ||
+          *actual_token != *expected_token ||
+          !source->FindString("expectedUrl") ||
+          !GURL(*source->FindString("expectedUrl")).SchemeIsHTTPOrHTTPS()) {
+        egress->IsolationReceipt("refused", *run_id, "none", "none", nullptr,
+                                 "source_document_changed");
+        return NativeFault("permission_denied", "Selected source page changed");
+      }
+    }
+    auto [isolation_id, partition] = egress->ReserveIsolation(
+        *run_id, task_id, revision, session);
+    if (isolation_id.empty()) {
+      return NativeFault("permission_denied", "Task isolation is unavailable");
+    }
+    auto site = session ? content::SiteInstance::Create(profile_)
+        : content::SiteInstance::CreateForFixedStoragePartition(
+              profile_, GURL("https://aux.invalid/"), partition);
+    if (!site) {
+      return NativeFault("backend_unavailable", "Task partition could not be created");
+    }
+    content::WebContents::CreateParams create(profile_, site);
+    create.opener_suppressed = true;
+    auto contents = content::WebContents::Create(create);
+    if (!contents) {
+      return NativeFault("backend_unavailable", "Task tab could not be created");
+    }
+    auto original_host = weak_factory_.GetWeakPtr();
+    auto original_owner = issuer->GetWeakPtr();
+    auto original_controller = egress->GetWeakPtr();
+    auto original_page = contents->GetWeakPtr();
+    auto* raw = contents.get();
+    const std::string page_id = aux::PageIdentity::GetOrCreate(profile_, raw);
+    // Validate the exact selected partition while the original construction still
+    // owns the unpublished contents. Failure destroys only that construction.
+    if (!egress->RegisterIsolation(raw, isolation_id, *run_id, task_id, revision, ancestry, connection_generation, session))
+      return NativeFault("permission_denied", "Task tab partition identity failed");
+    if (!original_host || !original_owner || !original_controller || !original_page)
+      return NativeFault("ref_stale", "Original task construction was retired");
+    aux::PageIdentity::MarkRuntimeOwned(profile_, raw);
+    aux::PageIdentity::MarkEphemeralTask(profile_, raw);
+    auto creation = egress->RegisterCreatorPage(raw, 0, connection_generation, source, issuer);
+    const auto* creation_result = creation.FindDict("result");
+    const auto* creation_id_value = creation_result ? creation_result->FindString("creationId") : nullptr;
+    if (!creation_id_value) return creation;
+    const std::string creation_id = *creation_id_value;
+    auto* model = issuer->GetTabStripModel();
+    model->InsertWebContentsAt(model->count(), std::move(contents),
+        params.FindBool("background").value_or(false) ? ADD_NONE : ADD_ACTIVE);
+    if (!original_host || !original_owner || !original_controller || !original_page)
+      return NativeFault("ref_stale", "Original task tab was retired during publication");
+    if (!original_controller->GroupAgentPage(original_page.get(), original_owner.get()))
+      return NativeFault("ref_stale", "Original Agent tab group changed during publication");
+    if (!original_host || !original_owner || !original_controller || !original_page)
+      return NativeFault("ref_stale", "Original Agent group owner was retired");
+    content::NavigationController::LoadURLParams blank(GURL("about:blank"));
+    blank.source_site_instance = site;
+    blank.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+    auto navigation = original_page->GetController().LoadURLWithParams(blank);
+    if (!original_host || !original_owner || !original_controller || !original_page)
+      return NativeFault("ref_stale", "Original task tab was retired during navigation");
+    const auto original_document = original_page->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+    const bool bound = navigation && original_controller->BindCreatorBlankNavigation(
+        page_id, creation_id, connection_generation, navigation->GetNavigationId());
+    // Binding may synchronously complete Ready and destroy any original owner.
+    // Never dereference the pre-callback raw controller/page/model afterward.
+    if (!original_host || !original_owner || !original_controller || !original_page ||
+        original_host->shutting_down_ ||
+        original_host->admitted_native_generation_ != connection_generation ||
+        original_host->retired_native_generation_ >= connection_generation)
+      return NativeFault("ref_stale", "Original task owner was retired during blank binding");
+    auto* current_frame = original_document.AsRenderFrameHostIfValid();
+    auto* current_catalog = aux::TabCatalog::GetForProfile(original_host->profile_);
+    BrowserWindowInterface* current_owner = nullptr;
+    const auto* current_identity = aux::PageIdentity::FromWebContents(original_page.get());
+    if (!current_identity || !current_frame || !current_catalog || current_catalog->FindPage(page_id, &current_owner) != original_page.get() ||
+        current_owner != original_owner.get() || original_owner->GetProfile() != original_host->profile_ ||
+        original_page->GetBrowserContext() != original_host->profile_ ||
+        original_page->GetPrimaryMainFrame() != current_frame ||
+        !current_identity->runtime_owned())
+      return NativeFault("ref_stale", "Original creation document changed during blank binding");
+    auto cleanup = original_controller->CreatorCleanupProof(base::DictValue()
+        .Set("pageId", page_id).Set("creationId", creation_id), connection_generation);
+    const auto* current_proof = cleanup.FindDict("result");
+    if (!bound || !current_proof || !current_proof->FindString("creationId") ||
+        *current_proof->FindString("creationId") != creation_id ||
+        current_proof->FindDouble("connectionGeneration") != static_cast<double>(connection_generation) ||
+        current_proof->FindInt("taskRevision") != revision ||
+        !current_proof->FindString("isolationId") || *current_proof->FindString("isolationId") != isolation_id ||
+        !current_proof->FindString("runId") || *current_proof->FindString("runId") != *run_id ||
+        (current_proof->FindString("taskId") ? *current_proof->FindString("taskId") : "") != task_id) {
+      auto failure = NativeFault("ref_stale", "Original blank navigation was unavailable");
+      if (current_proof) failure.Set("_creatorCleanup", current_proof->Clone());
+      return failure;
+    }
+    if (source) {
+      auto source_now = original_controller->Context(*source);
+      const auto* source_value = source_now.FindDict("result");
+      const auto* current_token = source_value ? source_value->FindString("documentToken") : nullptr;
+      const auto* expected_token = source->FindString("documentToken");
+      if (!current_token || !expected_token || *current_token != *expected_token) {
+        auto failure = NativeFault("ref_stale", "Original selected source changed during blank binding");
+        failure.Set("_creatorCleanup", current_proof->Clone());
+        return failure;
+      }
+    }
+    base::DictValue scope;
+    scope.Set("isolationId", isolation_id);
+    scope.Set("runId", *run_id);
+    if (!task_id.empty()) scope.Set("taskId", task_id);
+    scope.Set("taskRevision", revision);
+    scope.Set("mode", *mode);
+    scope.Set("inMemory", !session);
+    scope.Set("cookies", session ? "profile" : "empty");
+    base::DictValue result;
+    result.Set("pageId", page_id);
+    result.Set("creationId", creation_id);
+    auto target = content::DevToolsAgentHost::GetOrCreateFor(original_page.get());
+    if (!original_host || !original_owner || !original_controller || !original_page || !target ||
+        original_document.AsRenderFrameHostIfValid() != original_page->GetPrimaryMainFrame() ||
+        original_host->admitted_native_generation_ != connection_generation ||
+        original_host->retired_native_generation_ >= connection_generation ||
+        original_host->shutting_down_ || target->GetWebContents() != original_page.get() ||
+        target->GetBrowserContext() != original_host->profile_)
+      return NativeFault("ref_stale", "Original task target changed during publication");
+    BrowserWindowInterface* final_owner = nullptr;
+    auto* final_catalog = aux::TabCatalog::GetForProfile(original_host->profile_);
+    const auto* final_identity = aux::PageIdentity::FromWebContents(original_page.get());
+    if (!final_catalog || final_catalog != current_catalog ||
+        final_catalog->FindPage(page_id, &final_owner) != original_page.get() ||
+        final_owner != original_owner.get() || !final_identity ||
+        final_identity != current_identity || !final_identity->runtime_owned())
+      return NativeFault("ref_stale", "Original task catalog changed during target publication");
+    auto final_cleanup = original_controller->CreatorCleanupProof(base::DictValue()
+        .Set("pageId", page_id).Set("creationId", creation_id), connection_generation);
+    const auto* final_proof = final_cleanup.FindDict("result");
+    if (!final_proof || *final_proof != *current_proof)
+      return NativeFault("ref_stale", "Original task creation scope changed during target publication");
+    result.Set("targetId", target->GetId());
+    result.Set("isolation", std::move(scope));
+    if (source) result.Set("source", source->Clone());
+    return NativeResult(base::Value(std::move(result)));
+  }
+  if (method == "native.tabCommand") {
+    const std::string* command_id = params.FindString("commandId");
+    const std::string* window_id = params.FindString("windowId");
+    const base::DictValue* command = params.FindDict("command");
+    if (!command_id || command_id->size() < 8 || command_id->size() > 128 ||
+        !window_id || !command) {
+      return NativeFault("invalid_params", "Invalid tab command envelope");
+    }
+    auto* browsers = ProfileBrowserCollection::GetForProfile(profile_);
+    if (!browsers) {
+      return NativeFault("backend_unavailable",
+                         "No browser window is available");
+    }
+    BrowserWindowInterface* issuer = nullptr;
+    if (*window_id == "main") {
+      issuer = browsers->FindTabbedBrowser();
+    } else {
+      int parsed_id = 0;
+      if (!base::StringToInt(*window_id, &parsed_id) || parsed_id <= 0) {
+        return NativeFault("invalid_params", "Invalid window identifier");
+      }
+      issuer = browsers->FindBrowserWithID(
+          SessionID::FromSerializedValue(parsed_id));
+    }
+    base::DictValue ack = catalog->Command(issuer, *command_id, *command,
+                                             params.FindInt("catalogVersion"));
+    if (const std::string* page_id = ack.FindString("pageId")) {
+      if (const std::string* kind = command->FindString("kind");
+          kind && *kind == "open") {
+        if (command->FindBool("runtimeOwned").value_or(false) &&
+            ack.FindString("status") &&
+            *ack.FindString("status") == "applied") {
+          catalog->MarkRuntimeOwned(*page_id);
+          ack.Set("catalogVersion",
+                  catalog->Snapshot().FindInt("version").value_or(0));
+        }
+        if (content::WebContents* contents = catalog->FindPage(*page_id)) {
+          ack.Set(
+              "targetId",
+              content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId());
+        }
+      }
+    }
+    return NativeResult(base::Value(std::move(ack)));
+  }
+  if (method == "native.movePage") {
+    const std::string* page_id = params.FindString("pageId");
+    BrowserWindowInterface* source = nullptr;
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id, &source) : nullptr;
+    if (!contents || !source || source->GetProfile() != profile_ ||
+        source->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+      return NativeFault("not_found", "Page is not in a regular window in this Profile");
+    }
+    TabStripModel* source_model = source->GetTabStripModel();
+    const int source_index = source_model->GetIndexOfWebContents(contents);
+    if (source_index < 0) {
+      return NativeFault("not_found", "Page is no longer in its window");
+    }
+    const std::string source_window_id =
+        base::NumberToString(source->GetSessionID().id());
+    const std::string* requested_window_id = params.FindString("windowId");
+    BrowserWindowInterface* target = nullptr;
+    std::string previous_target_page_id;
+    if (requested_window_id && !requested_window_id->empty()) {
+      int target_id = 0;
+      if (!base::StringToInt(*requested_window_id, &target_id) ||
+          target_id <= 0) {
+        return NativeFault("invalid_params", "Invalid destination window");
+      }
+      auto* browsers = ProfileBrowserCollection::GetForProfile(profile_);
+      target = browsers ? browsers->FindBrowserWithID(
+                              SessionID::FromSerializedValue(target_id))
+                        : nullptr;
+      if (!target || target->GetProfile() != profile_ ||
+          target->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+        return NativeFault("not_found", "Destination window is not in this Profile");
+      }
+      if (target == source) {
+        base::DictValue result;
+        result.Set("windowId", source_window_id);
+        base::Value active;
+        if (content::WebContents* selected =
+                source_model->GetActiveWebContents()) {
+          active = base::Value(aux::PageIdentity::GetOrCreate(profile_, selected));
+        }
+        result.Set("sourceActivePageId", active.Clone());
+        result.Set("activePageId", std::move(active));
+        return NativeResult(base::Value(std::move(result)));
+      }
+      if (content::WebContents* active =
+              target->GetTabStripModel()->GetActiveWebContents()) {
+        previous_target_page_id =
+            aux::PageIdentity::GetOrCreate(profile_, active);
+      }
+    }
+
+    // Chromium's own transfer path preserves the TabModel, group and split
+    // metadata. The Aux page identity remains attached to the WebContents.
+    if (target) {
+      chrome::MoveTabsToExistingWindow(source, target, {source_index});
+    } else {
+      if (!chrome::CanMoveTabsToNewWindow(source, {source_index})) {
+        return NativeFault("conflict", "This window has no other tab to leave behind");
+      }
+      chrome::MoveTabsToNewWindow(source, {source_index});
+    }
+    BrowserWindowInterface* actual_target = nullptr;
+    content::WebContents* moved = catalog->FindPage(*page_id, &actual_target);
+    if (moved != contents || !actual_target ||
+        actual_target->GetProfile() != profile_ ||
+        actual_target->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        (target && actual_target != target)) {
+      return NativeFault("backend_unavailable", "Chromium did not preserve the moved page");
+    }
+    if (!params.FindBool("activate").value_or(true) &&
+        !previous_target_page_id.empty()) {
+      if (content::WebContents* previous =
+              catalog->FindPage(previous_target_page_id)) {
+        TabStripModel* model = actual_target->GetTabStripModel();
+        const int index = model->GetIndexOfWebContents(previous);
+        if (index >= 0) {
+          model->ActivateTabAt(index);
+        }
+      }
+    }
+    const std::string destination_window_id =
+        base::NumberToString(actual_target->GetSessionID().id());
+    base::DictValue result;
+    result.Set("windowId", destination_window_id);
+    base::Value source_active;
+    base::Value destination_active;
+    base::DictValue snapshot = catalog->Snapshot();
+    for (const base::Value& window_value : *snapshot.FindList("windows")) {
+      const base::DictValue& window = window_value.GetDict();
+      const std::string* id = window.FindString("windowId");
+      if (!id) {
+        continue;
+      }
+      const base::Value* active = window.Find("activePageId");
+      if (*id == source_window_id && active) {
+        source_active = active->Clone();
+      }
+      if (*id == destination_window_id && active) {
+        destination_active = active->Clone();
+      }
+    }
+    result.Set("sourceActivePageId", std::move(source_active));
+    result.Set("activePageId", std::move(destination_active));
+    return NativeResult(base::Value(std::move(result)));
+  }
+  if (method == "native.focusPage" || method == "native.stopPage" ||
+      method == "native.recoverPage") {
+    const std::string* page_id = params.FindString("pageId");
+    BrowserWindowInterface* owner = nullptr;
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id, &owner) : nullptr;
+    if (!contents || !owner) {
+      return NativeFault("not_found", "Page is not in this Profile");
+    }
+    if (method == "native.focusPage") {
+      TabStripModel* model = owner->GetTabStripModel();
+      model->ActivateTabAt(model->GetIndexOfWebContents(contents));
+    } else if (method == "native.stopPage") {
+      contents->Stop();
+    } else {
+      const std::string* url_text = params.FindString("url");
+      const GURL url(url_text ? *url_text : "");
+      if (!url.is_valid() ||
+          (!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIs("about"))) {
+        return NativeFault("invalid_params", "Invalid recovery URL");
+      }
+      content::NavigationController::LoadURLParams load(url);
+      contents->GetController().LoadURLWithParams(load);
+    }
+    base::DictValue result;
+    result.Set("ok", true);
+    return NativeResult(base::Value(std::move(result)));
+  }
+  if (method == "native.acquireStage" || method == "native.releaseStage") {
+    const std::string* page_id = params.FindString("pageId");
+    BrowserWindowInterface* owner = nullptr;
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id, &owner) : nullptr;
+    if (!contents || !owner)
+      return NativeFault("not_found", "Page is not in this Profile");
+    const bool active =
+        owner->GetTabStripModel()->GetActiveWebContents() == contents;
+    if (method == "native.acquireStage") {
+      const auto original_host = GetWeakPtr();
+      const auto original_page = contents->GetWeakPtr();
+      const auto original_owner = owner->GetWeakPtr();
+      const auto original_generation = admitted_native_generation_;
+      if (params.FindBool("requiresVisible").value_or(false) && !active)
+        return NativeFault("conflict", "The page must be active for pointer input");
+      if (contents->GetSize().IsEmpty()) {
+        gfx::Size size = owner->GetWindow()->GetBounds().size();
+        if (size.IsEmpty())
+          return NativeFault("backend_unavailable", "Page stage has no size");
+        contents->Resize(gfx::Rect(size));
+      }
+      if (!original_host || !original_page || !original_owner)
+        return NativeFault("ref_stale", "Original stage owner retired");
+      base::ScopedClosureRunner capturer;
+      auto previous = staged_pages_.find(*page_id);
+      if (previous == staged_pages_.end() || !previous->second.capturer) {
+        capturer = contents->IncrementCapturerCount(
+            gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/false,
+            /*is_activity=*/false);
+      }
+      if (!original_host || !original_page || !original_owner)
+        return NativeFault("ref_stale", "Original stage owner retired");
+      if (admitted_native_generation_ != original_generation ||
+          original_owner->GetTabStripModel()->GetIndexOfWebContents(original_page.get()) ==
+              TabStripModel::kNoTab)
+        return NativeFault("ref_stale", "Original stage owner changed");
+      const bool still_active = original_owner->GetTabStripModel()->GetActiveWebContents() ==
+          original_page.get();
+      if (params.FindBool("requiresVisible").value_or(false) && !still_active)
+        return NativeFault("conflict", "The page must remain active for pointer input");
+      stage_release_timers_.erase(*page_id);
+      auto [it, inserted] = staged_pages_.try_emplace(*page_id);
+      auto& lease = it->second;
+      if (!inserted && (lease.contents.get() != contents || lease.owner.get() != owner)) {
+        if (lease.count > 0)
+          return NativeFault("ref_stale", "Original stage owner changed");
+        lease = StageLease();
+      }
+      lease.contents = contents->GetWeakPtr();
+      lease.owner = owner->GetWeakPtr();
+      if (!lease.capturer) lease.capturer = std::move(capturer);
+      if (++lease.count == 1 && !still_active)
+        contents->UpdateWebContentsVisibility(content::Visibility::VISIBLE);
+    } else {
+      auto it = staged_pages_.find(*page_id);
+      if (it != staged_pages_.end() && it->second.count > 0) {
+        if (it->second.contents.get() != contents || it->second.owner.get() != owner)
+          return NativeFault("ref_stale", "Original stage owner changed");
+        if (--it->second.count == 0) {
+          auto timer = std::make_unique<base::OneShotTimer>();
+          timer->Start(FROM_HERE, base::Seconds(2), base::BindOnce(
+              &AuxRuntimeHost::FinishStageRelease, GetWeakPtr(), *page_id));
+          stage_release_timers_[*page_id] = std::move(timer);
+        }
+      }
+    }
+    base::DictValue result;
+    result.Set("ok", true);
+    return NativeResult(base::Value(std::move(result)));
+  }
+  return NativeFault("backend_unavailable",
+                     "Native method is unavailable in this build");
+}
