+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_PAGE_IDENTITY_H_
+#define CHROME_BROWSER_UI_AUX_PAGE_IDENTITY_H_
+
+#include <map>
+#include <string>
+
+#include "content/public/browser/web_contents_user_data.h"
+
+class Profile;
+
+namespace content {
+class WebContents;
+}
+
+namespace aux {
+
+// Stable Aux page identity, separate from Chromium's session and DevTools IDs.
+// Session restore persists it in tab extra data; native tab replacement can
+// explicitly transfer it to the new WebContents.
+class PageIdentity : public content::WebContentsUserData<PageIdentity> {
+ public:
+  PageIdentity(const PageIdentity&) = delete;
+  PageIdentity& operator=(const PageIdentity&) = delete;
+  ~PageIdentity() override;
+
+  static std::string GetOrCreate(Profile* profile,
+                                 content::WebContents* contents);
+  static bool IsValid(const std::string& id);
+  static bool Assign(Profile* profile,
+                     content::WebContents* contents,
+                     const std::string& id);
+  static void Transfer(content::WebContents* from, content::WebContents* to);
+  static void MarkRuntimeOwned(Profile* profile,
+                               content::WebContents* contents);
+  static void MarkEphemeralTask(Profile* profile,
+                                content::WebContents* contents);
+  static bool IsEphemeralTaskExtraData(
+      const std::map<std::string, std::string>& extra_data);
+  static void RestoreFromExtraData(
+      content::WebContents* contents,
+      const std::map<std::string, std::string>& extra_data);
+
+  const std::string& id() const { return id_; }
+  bool runtime_owned() const { return runtime_owned_; }
+  // Native discard proof only; never grants page access or survives restart.
+  bool runtime_work_retired() const { return runtime_work_retired_; }
+  void set_runtime_work_retired(bool retired) {
+    runtime_work_retired_ = retired;
+  }
+  const std::string& space_id() const { return space_id_; }
+  const std::string& workspace_id() const { return workspace_id_; }
+  void BindSpace(Profile* profile, content::WebContents* contents,
+                 std::string space_id, std::string workspace_id);
+
+ private:
+  friend class content::WebContentsUserData<PageIdentity>;
+  PageIdentity(content::WebContents* contents, std::string id);
+  void Persist(Profile* profile, content::WebContents* contents);
+  std::string id_;
+  std::string space_id_;
+  std::string workspace_id_;
+  bool persisted_ = false;
+  bool runtime_owned_ = false;
+  bool runtime_work_retired_ = false;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_PAGE_IDENTITY_H_
