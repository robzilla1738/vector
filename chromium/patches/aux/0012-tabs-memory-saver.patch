+
+base::DictValue TabCatalog::TabRecord(BrowserWindowInterface* browser,
+                                        content::WebContents* contents) {
+  if (!ReadableCapture::FromWebContents(contents)) {
+    ReadableCapture::CreateForWebContents(contents);
+  }
+  WatchPageShellEvents(contents);
+  const std::string id = PageIdentity::GetOrCreate(profile_, contents);
+  const int64_t now = NowMs();
+  created_at_.try_emplace(id, now);
+  base::DictValue tab;
+  tab.Set("pageId", id);
+  tab.Set("windowId", WindowId(browser));
+  tab.Set("anchor", contents->GetUserData(kAnchorKey) != nullptr);
+  tab.Set("windowKind", profile_->IsOffTheRecord() ? "private" : IsQuickAskWindow(browser) ? "quick-ask" : IsLittleWindow(browser) ? "little" : "normal");
+  tab.Set("url", contents->GetLastCommittedURL().spec());
+  if (const base::DictValue* error = PageNavigationError(contents)) {
+    tab.Set("navigationError", error->Clone());
+    if (const std::string* failed_url = error->FindString("url")) {
+      tab.Set("url", *failed_url);
+    }
+  }
+  tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  if (std::optional<SkColor> theme_color = contents->GetThemeColor()) {
+    tab.Set("themeColor", base::StringPrintf("#%02x%02x%02x",
+        SkColorGetR(*theme_color), SkColorGetG(*theme_color),
+        SkColorGetB(*theme_color)));
+  }
+  if (auto* model = browser->GetTabStripModel()) {
+    const int index = model->GetIndexOfWebContents(contents);
+    if (const auto split = model->GetSplitForTab(index)) {
+      const auto* data = model->GetSplitData(*split);
+      base::DictValue metadata;
+      metadata.Set("id", split->ToString());
+      metadata.Set("index", index - static_cast<int>(data->GetIndexRange().start()));
+      tab.Set("split", std::move(metadata));
+    }
+  }
+  tab.Set("loading", contents->IsLoading());
+  tab.Set("muted", contents->IsAudioMuted());
+  tab.Set("audible", contents->IsCurrentlyAudible());
+  tab.Set("canGoBack", contents->GetController().CanGoBack());
+  tab.Set("canGoForward", contents->GetController().CanGoForward());
+  tab.Set("popup", false);
+  tab.Set("crashed", contents->IsCrashed());
+  tab.Set("runtimeOwned",
+          PageIdentity::FromWebContents(contents)->runtime_owned());
+  const auto* identity = PageIdentity::FromWebContents(contents);
+  if (!identity->space_id().empty()) {
+    tab.Set("spaceId", identity->space_id());
+    if (!identity->workspace_id().empty())
+      tab.Set("workspaceId", identity->workspace_id());
+  }
+  const auto* lifecycle =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(contents);
+  if (lifecycle &&
+      lifecycle->GetTabState() == mojom::LifecycleUnitState::DISCARDED) {
+    tab.Set("lifecycle", "discarded");
+  } else if (lifecycle &&
+             lifecycle->GetTabState() == mojom::LifecycleUnitState::FROZEN) {
+    tab.Set("lifecycle", "frozen");
+  } else if (!contents->GetPrimaryMainFrame()->IsRenderFrameLive() &&
+             contents->GetController().GetEntryCount() > 0) {
+    tab.Set("lifecycle", "placeholder");
+  } else {
+    tab.Set("lifecycle", "live");
+  }
+  tab.Set("generation", generations_[id]);
+  tab.Set("createdAt", static_cast<double>(created_at_.at(id)));
+  tab.Set(
+      "lastActiveAt",
+      static_cast<double>(last_active_at_.try_emplace(id, now).first->second));
+  return tab;
+}
+
+void TabCatalog::BindSpace(const std::string& page_id,
+                           const std::string& space_id,
+                           const std::string& workspace_id) {
+  if (auto* contents = FindPage(page_id)) {
+    PageIdentity::GetOrCreate(profile_, contents);
+    PageIdentity::FromWebContents(contents)->BindSpace(
+        profile_, contents, space_id, workspace_id);
+    PublishTabPlacement(profile_, contents, space_id, workspace_id);
+    Changed();
+  }
+}
+
+std::optional<base::DictValue> TabCatalog::BindOrganizationSpace(
+    BrowserWindowInterface* issuer,
+    const std::string& page_id,
+    const std::string& space_id,
+    std::string* error) {
+  BrowserWindowInterface* owner = nullptr;
+  auto* contents = FindPage(page_id, &owner);
+  const auto* identity =
+      contents ? PageIdentity::FromWebContents(contents) : nullptr;
+  if (!issuer || issuer->GetProfile() != profile_ ||
+      profile_->IsOffTheRecord() || owner != issuer || !identity ||
+      identity->runtime_owned()) {
+    *error = "That tab is unavailable in this browser window";
+    return std::nullopt;
+  }
+  const std::string window_id = WindowId(issuer);
+  auto snapshot = OrganizationStore::Snapshot(profile_, window_id, error);
+  auto* layout = snapshot ? snapshot->FindDict("layout") : nullptr;
+  auto* shared = layout ? layout->FindDict("shared") : nullptr;
+  if (!shared || !HasActiveSpace(*shared, space_id)) {
+    *error = "That Space is no longer available";
+    return std::nullopt;
+  }
+  auto* placements = shared->FindDict("tabSpace");
+  placements->Set(page_id, space_id);
+  if (!OrganizationStore::Commit(
+          profile_, window_id, *snapshot->FindInt("revision"), *layout, error))
+    return std::nullopt;
+  ReconcileSpaceBindings();
+  contents = FindPage(page_id, &owner);
+  identity = contents ? PageIdentity::FromWebContents(contents) : nullptr;
+  if (owner != issuer || !identity || identity->runtime_owned() ||
+      identity->space_id() != space_id) {
+    *error = "The tab or Space changed. Select it again.";
+    return std::nullopt;
+  }
+  base::DictValue binding;
+  binding.Set("spaceId", space_id);
+  if (!identity->workspace_id().empty())
+    binding.Set("workspaceId", identity->workspace_id());
+  return binding;
+}
+
+void TabCatalog::SetRuntimeSpaceBindings(
+    std::map<std::string, std::string> bindings) {
+  runtime_space_bindings_ = std::move(bindings);
+  received_runtime_space_bindings_ = true;
+  ReconcileSpaceBindings();
+}
+
+void TabCatalog::ReconcileSpaceBindings() {
+  if (!profile_ || profile_->IsOffTheRecord() || !browsers_)
+    return;
+  std::string error;
+  const auto organization =
+      OrganizationStore::ProfileSnapshot(profile_, &error);
+  const auto* shared =
+      organization ? organization->FindDict("shared") : nullptr;
+  if (!shared) {
+    ScheduleMemorySaver();
+    return;
+  }
+  const auto* placements = shared->FindDict("tabSpace");
+  bool changed = false;
+  browsers_->ForEach([&](BrowserWindowInterface* browser) {
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL)
+      return true;
+    auto* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      auto* contents = model->GetWebContentsAt(index);
+      auto* identity = PageIdentity::FromWebContents(contents);
+      if (!identity || identity->runtime_owned())
+        continue;
+      const auto* selected = placements->FindString(identity->id());
+      const std::string space_id = selected ? *selected : identity->space_id();
+      if (!HasActiveSpace(*shared, space_id)) {
+        if (!identity->workspace_id().empty()) {
+          identity->BindSpace(profile_, contents, identity->space_id(), "");
+          changed = true;
+        }
+        continue;
+      }
+      std::string workspace_id;
+      const auto known = runtime_space_bindings_.find(space_id);
+      if (known != runtime_space_bindings_.end()) {
+        workspace_id = known->second;
+      } else if (!received_runtime_space_bindings_ &&
+                 identity->space_id() == space_id) {
+        // Session-restored native provenance survives runtime unavailability.
+        workspace_id = identity->workspace_id();
+      }
+      if (identity->space_id() == space_id &&
+          identity->workspace_id() == workspace_id)
+        continue;
+      identity->BindSpace(profile_, contents, space_id, workspace_id);
+      PublishTabPlacement(profile_, contents, space_id, workspace_id);
+      changed = true;
+    }
+    return true;
+  });
+  if (changed)
+    Changed();
+  else
+    ScheduleMemorySaver();
+}
+
+base::DictValue TabCatalog::Snapshot() {
+  base::ListValue tabs;
+  base::ListValue windows;
+  std::set<std::string> seen_pages;
+  if (browsers_) {
+    browsers_->ForEach([&](BrowserWindowInterface* browser) {
+      if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+        return true;
+      }
+      TabStripModel* model = browser->GetTabStripModel();
+      base::ListValue order;
+      base::Value active;
+      for (int index = 0; index < model->count(); ++index) {
+        content::WebContents* contents = model->GetWebContentsAt(index);
+        base::DictValue record = TabRecord(browser, contents);
+        if (!seen_pages.insert(*record.FindString("pageId")).second) {
+          std::string replacement_id;
+          do {
+            replacement_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+          } while (seen_pages.contains(replacement_id));
+          PageIdentity::Assign(profile_, contents, replacement_id);
+          record = TabRecord(browser, contents);
+          seen_pages.insert(*record.FindString("pageId"));
+        }
+        const std::string* id = record.FindString("pageId");
+        order.Append(*id);
+        if (index == model->active_index()) {
+          active = base::Value(*id);
+        }
+        tabs.Append(std::move(record));
+      }
+      base::DictValue window;
+      window.Set("windowId", WindowId(browser));
+      window.Set("windowKind", profile_->IsOffTheRecord() ? "private" : IsQuickAskWindow(browser) ? "quick-ask" : IsLittleWindow(browser) ? "little" : "normal");
+      window.Set("order", std::move(order));
+      window.Set("activePageId", std::move(active));
+      windows.Append(std::move(window));
+      return true;
+    });
+  }
+  base::DictValue snapshot;
+  snapshot.Set("version", version_);
+  snapshot.Set("batterySaverActive",
+               performance_manager::user_tuning::BatterySaverModeManager::HasInstance() &&
+                   performance_manager::user_tuning::BatterySaverModeManager::GetInstance()
+                       ->IsBatterySaverActive());
+  snapshot.Set("tabs", std::move(tabs));
+  snapshot.Set("windows", std::move(windows));
+  return snapshot;
+}
