+void LoadPersonRestoredTab(Profile* profile, content::WebContents* contents) {
+  const auto* identity = PageIdentity::FromWebContents(contents);
+  if (identity && identity->runtime_owned()) return;
+  auto& controller = contents->GetController();
+  const auto* entry = controller.GetLastCommittedEntry();
+  auto* frame = contents->GetPrimaryMainFrame();
+  // Starting a restored navigation clears NeedsReload before it commits. If
+  // that first load was interrupted, restore the cached entry without inventing
+  // a new URL or replacing a loaded document.
+  if (!controller.NeedsReload() && !contents->IsLoading() && frame &&
+      frame->GetLastCommittedURL().is_empty() && entry && entry->IsRestored() &&
+      !entry->IsInitialEntry() && entry->GetURL().SchemeIsHTTPOrHTTPS()) {
+    EgressRequestContext context;
+    context.document = frame->GetWeakDocumentPtr();
+    context.page_id = PageIdentity::GetOrCreate(profile, contents);
+    if (!EgressController::ForProfile(profile)->IsProtected(context))
+      controller.SetNeedsReload();
+  }
+  controller.LoadIfNecessary();
+}
+
+class TabCatalogFactory final : public ProfileKeyedServiceFactory {
+ public:
+  static TabCatalogFactory* GetInstance() {
+    static base::NoDestructor<TabCatalogFactory> factory;
+    return factory.get();
+  }
+
+  TabCatalogFactory(const TabCatalogFactory&) = delete;
+  TabCatalogFactory& operator=(const TabCatalogFactory&) = delete;
+
+  TabCatalog* Get(Profile* profile) {
+    return static_cast<TabCatalog*>(
+        GetServiceForBrowserContext(profile, /*create=*/true));
+  }
+
+ private:
+  friend base::NoDestructor<TabCatalogFactory>;
+
+  TabCatalogFactory()
+      : ProfileKeyedServiceFactory(
+            "AuxTabCatalog",
+            ProfileSelections::BuildForRegularAndIncognito()) {
+    DependsOn(BrowserManagerServiceFactory::GetInstance());
+  }
+  ~TabCatalogFactory() override = default;
+
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override {
+    return std::make_unique<TabCatalog>(Profile::FromBrowserContext(context));
+  }
+};
+
+bool HasActiveSpace(const base::DictValue& shared,
+                    const std::string& space_id) {
+  const auto* spaces = shared.FindList("spaces");
+  if (!spaces)
+    return false;
+  for (const auto& value : *spaces) {
+    const auto& space = value.GetDict();
+    const auto* id = space.FindString("id");
+    if (id && *id == space_id && !space.FindBool("archived").value_or(false))
+      return true;
+  }
+  return false;
+}
+
+constexpr char kAnchorKey[] = "aux-window-anchor";
+
+int64_t NowMs() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+}  // namespace
+
+void TabCatalog::EnsureFactoryBuilt() {
+  TabCatalogFactory::GetInstance();
+}
+
+TabCatalog* TabCatalog::GetForProfile(Profile* profile) {
+  return profile ? TabCatalogFactory::GetInstance()->Get(profile) : nullptr;
+}
+
+TabCatalog::TabCatalog(Profile* profile)
+    : profile_(profile),
+      browsers_(ProfileBrowserCollection::GetForProfile(profile)) {
+  StartShellEvents(profile_);
+  if (performance_manager::user_tuning::BatterySaverModeManager::HasInstance()) {
+    battery_observation_.Observe(
+        performance_manager::user_tuning::BatterySaverModeManager::GetInstance());
+  }
+  if (browsers_) {
+    browser_observation_.Observe(browsers_);
+    browsers_->ForEach([this](BrowserWindowInterface* browser) {
+      ObserveBrowser(browser);
+      return true;
+    });
+  }
+  base::DictValue initial = Snapshot();
+  for (const base::Value& value : *initial.FindList("tabs")) {
+    published_pages_.insert(*value.GetDict().FindString("pageId"));
+  }
+  if (!profile_->IsOffTheRecord() && !profile_->IsGuestSession()) {
+    preference_registrar_.Init(profile_->GetPrefs());
+    preference_registrar_.Add(
+        kMemorySaverMinutesPref,
+        base::BindRepeating(&TabCatalog::ScheduleMemorySaver,
+                            weak_factory_.GetWeakPtr()));
+    preference_registrar_.Add(
+        kOrganizationPref,
+        base::BindRepeating(&TabCatalog::ReconcileSpaceBindings,
+                            weak_factory_.GetWeakPtr()));
+    authority_subscription_ =
+        EgressController::ForProfile(profile_)->ObserveAuthority(
+            base::BindRepeating(&TabCatalog::ScheduleMemorySaver,
+                                weak_factory_.GetWeakPtr()));
+    ScheduleMemorySaver();
+  }
+}
+
+TabCatalog::~TabCatalog() {
+  Shutdown();
+}
+
+void TabCatalog::Shutdown() {
+  weak_factory_.InvalidateWeakPtrs();
+  memory_saver_timer_.Stop();
+  preference_registrar_.RemoveAll();
+  authority_subscription_ = {};
+  battery_observation_.Reset();
+  browser_observation_.Reset();
+  for (TabStripModel* model : observed_) {
+    model->RemoveObserver(this);
+  }
+  observed_.clear();
+  browsers_ = nullptr;
+  profile_ = nullptr;
+}
+
+void TabCatalog::ObserveBrowser(BrowserWindowInterface* browser) {
+  if (!browser || browser->GetProfile() != profile_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  if (model && observed_.insert(model).second) {
+    model->AddObserver(this);
+    if (auto* active = model->GetActiveWebContents())
+      LoadPersonRestoredTab(profile_, active);
+  }
+}
+
+void TabCatalog::ForgetBrowser(BrowserWindowInterface* browser) {
+  TabStripModel* model = browser->GetTabStripModel();
+  if (model && observed_.erase(model)) {
+    model->RemoveObserver(this);
+  }
+}
+
+void TabCatalog::Changed() {
+  if (executing_command_) {
+    pending_change_ = true;
+    return;
+  }
+  const int previous_version = version_;
+  ++version_;
+  base::DictValue snapshot = Snapshot();
+  ScheduleMemorySaver();
+  base::ListValue ops;
+  std::set<std::string> current_pages;
+  for (const base::Value& value : *snapshot.FindList("tabs")) {
+    const base::DictValue& tab = value.GetDict();
+    current_pages.insert(*tab.FindString("pageId"));
+    base::DictValue operation;
+    operation.Set("op", "upsert");
+    operation.Set("tab", tab.Clone());
+    ops.Append(std::move(operation));
+  }
+  for (const std::string& page_id : published_pages_) {
+    if (!current_pages.contains(page_id)) {
+      base::DictValue operation;
+      operation.Set("op", "remove");
+      operation.Set("pageId", page_id);
+      ops.Append(std::move(operation));
+    }
+  }
+  published_pages_ = std::move(current_pages);
+  for (const base::Value& value : *snapshot.FindList("windows")) {
+    base::DictValue operation;
+    operation.Set("op", "window");
+    operation.Set("window", value.GetDict().Clone());
+    ops.Append(std::move(operation));
+  }
+  if (ops.empty()) {
+    return;
+  }
+  base::DictValue patch;
+  patch.Set("version", version_);
+  patch.Set("baseVersion", previous_version);
+  patch.Set("batterySaverActive",
+            performance_manager::user_tuning::BatterySaverModeManager::HasInstance() &&
+                performance_manager::user_tuning::BatterySaverModeManager::GetInstance()
+                    ->IsBatterySaverActive());
+  patch.Set("ops", std::move(ops));
+  patch.Set("ts", static_cast<double>(NowMs()));
+  if (auto json = base::WriteJson(patch)) {
+    observers_.Notify(*json);
+  }
+}
+
+void TabCatalog::FinishCommand() {
+  executing_command_ = false;
+  if (pending_change_) {
+    pending_change_ = false;
+    Changed();
+  }
+}
+
+void TabCatalog::MarkRuntimeOwned(const std::string& page_id) {
+  if (content::WebContents* contents = FindPage(page_id)) {
+    if (PageIdentity::FromWebContents(contents)->runtime_owned()) {
+      return;
+    }
+    PageIdentity::MarkRuntimeOwned(profile_, contents);
+    Changed();
+  }
+}
