+class WebContents;
+}
+
+namespace aux {
+
+// Chromium tab state for one Profile. All reads and commands run on the UI
+// sequence, and IDs belong to the tab rather than a DevTools target.
+class TabCatalog final : public KeyedService,
+                         public BrowserCollectionObserver,
+                         public TabStripModelObserver,
+                         public performance_manager::user_tuning::BatterySaverModeManager::Observer {
+ public:
+  static void EnsureFactoryBuilt();
+  static TabCatalog* GetForProfile(Profile* profile);
+
+  explicit TabCatalog(Profile* profile);
+  ~TabCatalog() override;
+  TabCatalog(const TabCatalog&) = delete;
+  TabCatalog& operator=(const TabCatalog&) = delete;
+
+  base::DictValue Snapshot();
+  base::DictValue MemorySaverGet() const;
+  bool MemorySaverSet(int minutes);
+  static bool IsMemorySaverMinutes(int minutes);
+  base::DictValue SleepTab(BrowserWindowInterface* issuer,
+                           const std::string& page_id,
+                           const std::string& expected_url);
+  base::DictValue Command(BrowserWindowInterface* issuer,
+                            const std::string& command_id,
+                            const base::DictValue& command,
+                            std::optional<int> expected_version);
+  content::WebContents* FindPage(const std::string& page_id,
+                                 BrowserWindowInterface** owner = nullptr);
+  void BindSpace(const std::string& page_id, const std::string& space_id,
+                 const std::string& workspace_id);
+  std::optional<base::DictValue> BindOrganizationSpace(
+      BrowserWindowInterface* issuer, const std::string& page_id,
+      const std::string& space_id, std::string* error);
+  void SetRuntimeSpaceBindings(std::map<std::string, std::string> bindings);
+  void MarkRuntimeOwned(const std::string& page_id);
+  void RefreshPage();
+  base::CallbackListSubscription ObserveChanges(
+      base::RepeatingCallback<void(const std::string&)> callback);
+
+  void Shutdown() override;
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+  void OnBrowserActivated(BrowserWindowInterface* browser) override;
+  void OnTabStripModelChanged(
+      TabStripModel* model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+  void OnTabStripModelDestroyed(TabStripModel* model) override;
+  void OnBatterySaverActiveChanged(bool is_active) override;
+  void OnBatterySaverModeManagerDestroyed() override;
+
+ private:
+  void ObserveBrowser(BrowserWindowInterface* browser);
+  void ForgetBrowser(BrowserWindowInterface* browser);
+  void Changed();
+  void ReconcileSpaceBindings();
+  void FinishCommand();
+  void ScheduleMemorySaver();
+  void RunMemorySaver();
+  std::optional<base::TimeTicks> MemorySaverDeadline(TabStripModel* model,
+                                                     int index,
+                                                     base::TimeTicks now);
+  std::string WindowId(const BrowserWindowInterface* browser) const;
+  base::DictValue TabRecord(BrowserWindowInterface* browser,
+                              content::WebContents* contents);
+  base::DictValue Reject(const std::string& command_id,
+                           std::string code,
+                           std::string message) const;
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<ProfileBrowserCollection> browsers_ = nullptr;
+  base::ScopedObservation<ProfileBrowserCollection, BrowserCollectionObserver>
+      browser_observation_{this};
+  base::ScopedObservation<performance_manager::user_tuning::BatterySaverModeManager,
+                          performance_manager::user_tuning::BatterySaverModeManager::Observer>
+      battery_observation_{this};
+  std::set<TabStripModel*> observed_;
+  std::map<std::string, int64_t> created_at_;
+  std::map<std::string, int64_t> last_active_at_;
+  std::map<std::string, int> generations_;
+  std::map<std::string, std::string> runtime_space_bindings_;
+  bool received_runtime_space_bindings_ = false;
+  std::map<std::string, base::DictValue> command_acks_;
+  std::deque<std::string> ack_order_;
+  std::set<std::string> published_pages_;
+  base::RepeatingCallbackList<void(const std::string&)> observers_;
+  PrefChangeRegistrar preference_registrar_;
+  base::CallbackListSubscription authority_subscription_;
+  base::OneShotTimer memory_saver_timer_;
+  std::map<std::string, base::TimeTicks> memory_saver_seen_at_;
+  std::map<std::string, base::TimeTicks> memory_saver_retry_at_;
+  int version_ = 0;
+  bool executing_command_ = false;
+  bool pending_change_ = false;
+  base::WeakPtrFactory<TabCatalog> weak_factory_{this};
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_TAB_CATALOG_H_
