+
+content::WebContents* TabCatalog::FindPage(const std::string& page_id,
+                                           BrowserWindowInterface** owner) {
+  content::WebContents* found = nullptr;
+  if (!browsers_) {
+    return nullptr;
+  }
+  browsers_->ForEach([&](BrowserWindowInterface* browser) {
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+      return true;
+    }
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      content::WebContents* contents = model->GetWebContentsAt(index);
+      if (PageIdentity::GetOrCreate(profile_, contents) == page_id) {
+        found = contents;
+        if (owner) {
+          *owner = browser;
+        }
+        return false;
+      }
+    }
+    return true;
+  });
+  return found;
+}
