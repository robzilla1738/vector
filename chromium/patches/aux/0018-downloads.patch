@@ -0,0 +1,350 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/download_naming.h"
+#include <cerrno>
+#include <stdio.h>
+#include <fcntl.h>
+#include <libproc.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <memory>
+#include <map>
+#include "base/supports_user_data.h"
+#include "third_party/icu/source/common/unicode/uchar.h"
+#include <vector>
+#include "base/memory/weak_ptr.h"
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/download/public/common/download_item.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/download_manager.h"
+#include "content/public/browser/download_item_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "base/strings/utf_string_conversions.h"
+namespace aux {
+namespace {
+constexpr char kReceipts[] = "aux.download_renames";
+constexpr int64_t kUndoMs = 24 * 60 * 60 * 1000;
+using Item = download::DownloadItem;
+base::DictValue Result(base::Value value) { base::DictValue out; out.Set("result", std::move(value)); return out; }
+base::DictValue Refusal(std::string status, std::string filename = {}) {
+  base::DictValue out; out.Set("status", std::move(status));
+  if (!filename.empty()) out.Set("filename", std::move(filename));
+  return Result(base::Value(std::move(out)));
+}
+base::DictValue Failed(std::string filename, std::string reason) {
+  base::DictValue out; out.Set("renamed", false); out.Set("filename", std::move(filename)); out.Set("reason", std::move(reason)); return Result(base::Value(std::move(out)));
+}
+bool SafeName(const std::string& value) {
+  if (value.empty() || value.size() > 400 || !base::IsStringUTF8(value) || value[0] == '.' || base::TrimWhitespaceASCII(value, base::TRIM_ALL) != value) return false;
+  const auto utf16 = base::UTF8ToUTF16(value);
+  if (utf16.size() > 100) return false;
+  for (char16_t c : utf16) if (u_charType(c) == U_CONTROL_CHAR || u_charType(c) == U_FORMAT_CHAR || c == '/' || c == ':' || c == '\\') return false;
+  return true;
+}
+std::optional<base::DictValue> Fingerprint(const base::FilePath& path) {
+  struct stat info;
+  if (lstat(path.value().c_str(), &info) || !S_ISREG(info.st_mode)) return std::nullopt;
+  base::DictValue out;
+  out.Set("device", base::NumberToString(info.st_dev)); out.Set("inode", base::NumberToString(info.st_ino));
+  out.Set("size", base::NumberToString(info.st_size)); out.Set("modifiedSeconds", base::NumberToString(info.st_mtimespec.tv_sec)); out.Set("modifiedNanos", base::NumberToString(info.st_mtimespec.tv_nsec));
+  return out;
+}
+bool FileUnused(const base::FilePath& path) {
+  // A non-null buffer runs the path scan; a sizing call only counts processes.
+  // One PID suffices: any matching process refuses the move, regardless of
+  // whether additional matches would fill a larger buffer. Errors refuse too.
+  int pid = 0;
+  return proc_listpidspath(PROC_ALL_PIDS, 0, path.value().c_str(), 0,
+                          &pid, sizeof(pid)) == 0;
+}
+Item* Find(Profile* profile, const std::string& guid) {
+  return profile->GetDownloadManager()->GetDownloadByGuid(guid);
+}
+bool Same(const base::FilePath& path, const base::DictValue& fingerprint) {
+  const auto current = Fingerprint(path); return current && *current == fingerprint;
+}
+Item::DownloadRenameResult Move(const base::DictValue& fingerprint,
+                               const base::FilePath& expected,
+                               const base::FilePath& source,
+                               const base::FilePath& destination) {
+  if (source != expected || source.DirName() != destination.DirName() || !Same(source, fingerprint) || !FileUnused(source)) return Item::DownloadRenameResult::FAILURE_UNAVAILABLE;
+  if (renamex_np(source.value().c_str(), destination.value().c_str(), RENAME_EXCL)) return errno == EEXIST ? Item::DownloadRenameResult::FAILURE_NAME_CONFLICT : Item::DownloadRenameResult::FAILURE_UNKNOWN;
+  return Item::DownloadRenameResult::SUCCESS;
+}
+Item::DownloadRenameResult RecoverMove(const base::DictValue& fingerprint,
+                                      const base::FilePath& source,
+                                      const base::FilePath& destination) {
+  return source.DirName() == destination.DirName() && !base::PathExists(source) &&
+      Same(destination, fingerprint) && FileUnused(destination)
+      ? Item::DownloadRenameResult::SUCCESS : Item::DownloadRenameResult::FAILURE_UNAVAILABLE;
+}
+struct ReceiptRequest : std::enable_shared_from_this<ReceiptRequest> {
+  base::WeakPtr<Profile> profile;
+  std::vector<std::pair<std::string, base::DictValue>> entries;
+  base::ListValue result;
+  size_t index = 0;
+  base::OnceCallback<void(base::DictValue)> callback;
+  void Next() {
+    if (!profile || index == entries.size()) { std::move(callback).Run(Result(base::Value(std::move(result)))); return; }
+    const auto& [id, receipt] = entries[index];
+    const auto* guid = receipt.FindString("downloadId"); const auto* filename = receipt.FindString("filename");
+    const auto* original = receipt.FindString("originalName"); const auto* fingerprint = receipt.FindDict("fingerprint");
+    const auto deadline = receipt.FindDouble("expiresAt");
+    Item* item = guid ? Find(profile.get(), *guid) : nullptr;
+    if (!item || !filename || !original || !fingerprint || !deadline ||
+        *deadline <= base::Time::Now().InMillisecondsSinceUnixEpoch() || item->GetState() != Item::COMPLETE) { ++index; Next(); return; }
+    if (item->GetTargetFilePath().BaseName().AsUTF8Unsafe() == *filename) {
+      base::DictValue visible = receipt.Clone(); visible.Remove("fingerprint"); visible.Set("receiptId", id);
+      result.Append(std::move(visible)); ++index; Next(); return;
+    }
+    if (EligibleDownloadName(profile.get(), item) && item->GetTargetFilePath().BaseName().AsUTF8Unsafe() == *original) {
+      item->RenameWithMove(base::FilePath::FromUTF8Unsafe(*filename), base::BindOnce(&RecoverMove, fingerprint->Clone()),
+        base::BindOnce([](std::shared_ptr<ReceiptRequest> request, Item::DownloadRenameResult result) {
+          if (result != Item::DownloadRenameResult::SUCCESS) ++request->index;
+          request->Next();
+        }, shared_from_this()));
+      return;
+    }
+    ++index; Next();
+  }
+};
+
+struct RenameRequest : std::enable_shared_from_this<RenameRequest> {
+  base::WeakPtr<Profile> profile;
+  std::string guid, original, stem;
+  base::FilePath path;
+  base::DictValue fingerprint;
+  base::OnceCallback<void(base::DictValue)> callback;
+  int attempt = 1;
+  std::string receipt_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  std::string filename;
+  void RemoveReceipt() {
+    if (profile) { ScopedDictPrefUpdate update(profile->GetPrefs(), kReceipts); update->Remove(receipt_id); }
+  }
+  void Start() {
+    Item* item = profile ? Find(profile.get(), guid) : nullptr;
+    if (!EligibleDownloadName(profile.get(), item) || item->GetTargetFilePath() != path ||
+        base::Time::Now() < item->GetEndTime() || base::Time::Now() - item->GetEndTime() >= base::Seconds(30)) {
+      RemoveReceipt(); std::move(callback).Run(Failed(original, "download-changed")); return;
+    }
+    filename = stem + (attempt == 1 ? "" : " (" + base::NumberToString(attempt) + ")") + path.Extension();
+    const base::Time now = base::Time::Now();
+    base::DictValue receipt;
+    receipt.Set("downloadId", guid); receipt.Set("originalName", original); receipt.Set("filename", filename);
+    receipt.Set("fingerprint", fingerprint.Clone()); receipt.Set("renamedAt", static_cast<double>(now.InMillisecondsSinceUnixEpoch()));
+    receipt.Set("expiresAt", static_cast<double>((now + base::Milliseconds(kUndoMs)).InMillisecondsSinceUnixEpoch()));
+    {
+      ScopedDictPrefUpdate update(profile->GetPrefs(), kReceipts);
+      std::vector<std::string> expired;
+      for (const auto [id, value] : *update) {
+        const auto* existing = value.GetIfDict();
+        const auto deadline = existing ? existing->FindDouble("expiresAt") : std::nullopt;
+        if (!deadline || *deadline <= now.InMillisecondsSinceUnixEpoch()) expired.emplace_back(id);
+      }
+      for (const auto& id : expired) update->Remove(id);
+      if (update->size() >= 1000 && !update->contains(receipt_id)) { std::move(callback).Run(Failed(original, "receipt-capacity")); return; }
+      update->Set(receipt_id, std::move(receipt));
+    }
+    profile->GetPrefs()->CommitPendingWrite(base::BindOnce(&RenameRequest::MoveAfterReceipt, shared_from_this()));
+  }
+  void MoveAfterReceipt() {
+    Item* item = profile ? Find(profile.get(), guid) : nullptr;
+    if (!EligibleDownloadName(profile.get(), item) || item->GetTargetFilePath() != path ||
+        base::Time::Now() < item->GetEndTime() || base::Time::Now() - item->GetEndTime() >= base::Seconds(30)) {
+      RemoveReceipt(); std::move(callback).Run(Failed(original, "download-changed")); return;
+    }
+    item->RenameWithMove(base::FilePath::FromUTF8Unsafe(filename), base::BindOnce(&RenameDownloadFileConditional, fingerprint.Clone(), path),
+      base::BindOnce(&RenameRequest::Done, shared_from_this()));
+  }
+  void Done(Item::DownloadRenameResult result) {
+    if (result == Item::DownloadRenameResult::FAILURE_NAME_CONFLICT && attempt < 20) { ++attempt; Start(); return; }
+    if (result != Item::DownloadRenameResult::SUCCESS) RemoveReceipt();
+    base::DictValue out; out.Set("renamed", result == Item::DownloadRenameResult::SUCCESS); out.Set("filename", filename);
+    if (result == Item::DownloadRenameResult::SUCCESS) out.Set("receiptId", receipt_id);
+    else out.Set("reason", "file-changed-or-name-taken");
+    std::move(callback).Run(Result(base::Value(std::move(out))));
+  }
+};
+
+}
+std::optional<base::DictValue> FingerprintDownloadFile(const base::FilePath& path) { return Fingerprint(path); }
+Item::DownloadRenameResult RenameDownloadFileConditional(const base::DictValue& fingerprint,
+    const base::FilePath& expected, const base::FilePath& source, const base::FilePath& destination) {
+  return Move(fingerprint, expected, source, destination);
+}
+
+bool CanNameDownload(const DownloadNamingEligibility& state) {
+  return state.complete && !state.prompted && !state.forced_path && !state.save_package &&
+      !state.dangerous && !state.insecure && !state.opened && !state.open_when_complete &&
+      !state.private_profile && !state.removed && state.has_end_time && state.web_source;
+}
+bool EligibleDownloadName(Profile* profile, Item* item) {
+  if (!profile || !item) return false;
+  return CanNameDownload({
+    .complete = item->GetState() == Item::COMPLETE,
+    .prompted = item->GetTargetDisposition() == Item::TARGET_DISPOSITION_PROMPT,
+    .forced_path = !item->GetForcedFilePath().empty(), .save_package = item->IsSavePackageDownload(),
+    .dangerous = item->IsDangerous(), .insecure = item->GetInsecureDownloadStatus() != Item::SAFE,
+    .opened = item->GetOpened(), .open_when_complete = item->GetOpenWhenComplete(),
+    .private_profile = profile->IsOffTheRecord(), .removed = item->GetFileExternallyRemoved(),
+    .has_end_time = !item->GetEndTime().is_null(), .web_source = item->GetURL().SchemeIsHTTPOrHTTPS(),
+  });
+}
+
+namespace {
+bool FreshDownload(Profile* profile, Item* item) {
+  if (!EligibleDownloadName(profile, item)) return false;
+  const auto age = base::Time::Now() - item->GetEndTime();
+  return age >= base::TimeDelta() && age < base::Seconds(30);
+}
+}
+
+namespace {
+constexpr char kCandidateKey = 0;
+struct Candidate {
+  base::FilePath path;
+  base::DictValue fingerprint;
+  base::DictValue metadata;
+  base::Time expires_at;
+};
+struct Candidates : base::SupportsUserData::Data {
+  std::map<std::string, Candidate> downloads;
+};
+Candidates* CandidatesFor(Profile* profile, bool create = false) {
+  if (!profile || profile->IsOffTheRecord()) return nullptr;
+  auto* state = static_cast<Candidates*>(profile->GetUserData(&kCandidateKey));
+  if (!state && create) {
+    auto owned = std::make_unique<Candidates>();
+    state = owned.get();
+    profile->SetUserData(&kCandidateKey, std::move(owned));
+  }
+  return state;
+}
+const Candidate* CandidateFor(Profile* profile, Item* item) {
+  auto* state = CandidatesFor(profile);
+  if (!state || !FreshDownload(profile, item)) return nullptr;
+  const auto found = state->downloads.find(item->GetGuid());
+  if (found == state->downloads.end()) return nullptr;
+  const auto& candidate = found->second;
+  return candidate.expires_at > base::Time::Now() && candidate.path == item->GetTargetFilePath() &&
+      Same(candidate.path, candidate.fingerprint) ? &candidate : nullptr;
+}
+}
+
+base::DictValue DownloadNamingMetadata(Item* item) {
+  base::DictValue out;
+  out.Set("id", item->GetGuid()); out.Set("filename", item->GetTargetFilePath().BaseName().AsUTF8Unsafe());
+  out.Set("mime", item->GetMimeType().substr(0, 200)); out.Set("sourceHost", item->GetURL().host());
+  std::string title;
+  if (auto* contents = content::DownloadItemUtils::GetWebContents(item)) title = base::UTF16ToUTF8(contents->GetTitle());
+  out.Set("tabTitle", std::string(base::TruncateUTF8ToByteSize(title, 500)));
+  if (!item->GetTabReferrerUrl().host().empty()) out.Set("referrerHost", item->GetTabReferrerUrl().host());
+  out.Set("endedAt", static_cast<double>(item->GetEndTime().InMillisecondsSinceUnixEpoch())); return out;
+}
+std::optional<base::DictValue> RecordDownloadNamingCandidate(Profile* profile, Item* item) {
+  if (!FreshDownload(profile, item)) return std::nullopt;
+  auto fingerprint = Fingerprint(item->GetTargetFilePath());
+  if (!fingerprint) return std::nullopt;
+  auto* state = CandidatesFor(profile, true);
+  std::erase_if(state->downloads, [](const auto& entry) { return entry.second.expires_at <= base::Time::Now(); });
+  if (state->downloads.size() >= 1000) return std::nullopt;
+  auto [found, inserted] = state->downloads.emplace(item->GetGuid(), Candidate{
+      item->GetTargetFilePath(), std::move(*fingerprint), DownloadNamingMetadata(item),
+      item->GetEndTime() + base::Seconds(30)});
+  if (!inserted) return std::nullopt;
+  return found->second.metadata.Clone();
+}
+std::optional<base::DictValue> DownloadNamingCandidate(Profile* profile, Item* item) {
+  const auto* candidate = CandidateFor(profile, item);
+  return candidate ? std::make_optional(candidate->metadata.Clone()) : std::nullopt;
+}
+void HandleDownloadNaming(Profile* profile, const std::string& method,
+                          const base::DictValue& params,
+                          base::OnceCallback<void(base::DictValue)> callback) {
+  if (!profile || profile->IsOffTheRecord()) {
+    if (method == "native.downloadNamingCandidate") std::move(callback).Run(Result(base::Value()));
+    else if (method == "native.downloadRenameReceipts") std::move(callback).Run(Result(base::Value(base::ListValue())));
+    else if (method == "native.downloadPreviewText") { base::DictValue empty; empty.Set("text", ""); std::move(callback).Run(Result(base::Value(std::move(empty)))); }
+    else if (method == "native.renameDownload") std::move(callback).Run(Failed({}, "private-profile"));
+    else std::move(callback).Run(Refusal("expired"));
+    return;
+  }
+  if (method == "native.downloadRenameReceipts") {
+    auto request = std::make_shared<ReceiptRequest>(); request->profile = profile->GetWeakPtr(); request->callback = std::move(callback);
+    for (const auto [id, value] : profile->GetPrefs()->GetDict(kReceipts)) {
+      if (const auto* receipt = value.GetIfDict()) request->entries.emplace_back(id, receipt->Clone());
+      if (request->entries.size() == 1000) break;
+    }
+    request->Next(); return;
+  }
+  const std::string* guid = params.FindString("downloadId");
+  if (method == "native.undoDownloadRename") {
+    const std::string* id = params.FindString("receiptId");
+    const auto& receipts = profile->GetPrefs()->GetDict(kReceipts);
+    const auto* receipt = id ? receipts.FindDict(*id) : nullptr;
+    const std::string* saved_guid = receipt ? receipt->FindString("downloadId") : nullptr;
+    const std::string* original = receipt ? receipt->FindString("originalName") : nullptr;
+    const std::string* filename = receipt ? receipt->FindString("filename") : nullptr;
+    const auto* fingerprint = receipt ? receipt->FindDict("fingerprint") : nullptr;
+    const std::optional<double> expires = receipt ? receipt->FindDouble("expiresAt") : std::nullopt;
+    if (!saved_guid || !original || !filename || !fingerprint || !expires || base::Time::Now().InMillisecondsSinceUnixEpoch() >= *expires) { std::move(callback).Run(Refusal("expired")); return; }
+    Item* item = Find(profile, *saved_guid);
+    if (!item || item->GetState() != Item::COMPLETE || item->GetTargetFilePath().BaseName().AsUTF8Unsafe() != *filename || item->GetOpened() || item->GetOpenWhenComplete()) { std::move(callback).Run(Refusal("conflict")); return; }
+    const std::string receipt_id = *id, original_name = *original;
+    item->RenameWithMove(base::FilePath::FromUTF8Unsafe(original_name),
+        base::BindOnce(&RenameDownloadFileConditional, fingerprint->Clone(), item->GetTargetFilePath()),
+        base::BindOnce([](base::WeakPtr<Profile> owner, std::string id, std::string original, base::OnceCallback<void(base::DictValue)> done, Item::DownloadRenameResult result) {
+          if (result == Item::DownloadRenameResult::SUCCESS && owner) { ScopedDictPrefUpdate update(owner->GetPrefs(), kReceipts); update->Remove(id); }
+          std::move(done).Run(Refusal(result == Item::DownloadRenameResult::SUCCESS ? "restored" : "conflict", original));
+        }, profile->GetWeakPtr(), receipt_id, original_name, std::move(callback)));
+    return;
+  }
+  Item* item = guid ? Find(profile, *guid) : nullptr;
+  if (method == "native.downloadNamingCandidate") {
+    auto candidate = DownloadNamingCandidate(profile, item);
+    std::move(callback).Run(Result(candidate ? base::Value(std::move(*candidate)) : base::Value())); return;
+  }
+  const auto* candidate = CandidateFor(profile, item);
+  if (!candidate) {
+    if (method == "native.downloadPreviewText") {
+      base::DictValue empty; empty.Set("text", "");
+      std::move(callback).Run(Result(base::Value(std::move(empty))));
+    } else std::move(callback).Run(Failed({}, "ineligible"));
+    return;
+  }
+  if (method == "native.downloadPreviewText") {
+    base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+        base::BindOnce([](base::FilePath path, std::string mime, base::DictValue fingerprint) {
+          if (!Same(path, fingerprint)) return std::string();
+          std::string text = DownloadPreviewText(path, mime);
+          return Same(path, fingerprint) ? text : std::string();
+        }, candidate->path, item->GetMimeType(), candidate->fingerprint.Clone()),
+        base::BindOnce([](base::WeakPtr<Profile> owner, std::string guid,
+                         base::OnceCallback<void(base::DictValue)> done, std::string text) {
+          if (!owner || !CandidateFor(owner.get(), Find(owner.get(), guid))) text.clear();
+          base::DictValue out; out.Set("text", std::move(text));
+          std::move(done).Run(Result(base::Value(std::move(out))));
+        }, profile->GetWeakPtr(), *guid, std::move(callback)));
+    return;
+  }
+  const std::string* expected = params.FindString("expectedName"), *stem = params.FindString("stem");
+  const std::string* mode = params.FindString("mode");
+  const base::TimeDelta age = base::Time::Now() - item->GetEndTime();
+  if (!mode || (*mode != "unclear" && *mode != "all") || !expected || !stem || !SafeName(*stem) || age < base::TimeDelta() || age >= base::Seconds(30) || item->GetTargetFilePath().BaseName().AsUTF8Unsafe() != *expected) { std::move(callback).Run(Failed({}, "download-changed")); return; }
+  const base::FilePath path = item->GetTargetFilePath();
+  const auto& fingerprint = candidate->fingerprint;
+  if (!Same(path, fingerprint) || !FileUnused(path)) { std::move(callback).Run(Failed(*expected, "file-changed-or-open")); return; }
+  auto request = std::make_shared<RenameRequest>();
+  request->profile = profile->GetWeakPtr(); request->guid = *guid; request->original = *expected;
+  request->stem = *stem; request->path = path; request->fingerprint = fingerprint.Clone();
+  request->callback = std::move(callback); request->Start();
+}
+}
