+#ifndef CHROME_BROWSER_UI_AUX_DOWNLOAD_NAMING_H_
+#define CHROME_BROWSER_UI_AUX_DOWNLOAD_NAMING_H_
+#include <string>
+#include <optional>
+#include "components/download/public/common/download_item.h"
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/values.h"
+namespace download { class DownloadItem; }
+class Profile;
+namespace aux {
+struct DownloadNamingEligibility {
+  bool complete = false, prompted = false, forced_path = false, save_package = false;
+  bool dangerous = false, insecure = false, opened = false, open_when_complete = false;
+  bool private_profile = false, removed = false, has_end_time = false, web_source = false;
+};
