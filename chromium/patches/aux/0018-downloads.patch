--- /dev/null
+++ b/content/browser/download/download_item_utils_unittest.cc
@@ -0,0 +1,40 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "content/public/browser/download_item_utils.h"
+
+#include "components/download/public/common/mock_download_item.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/test/test_renderer_host.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "url/gurl.h"
+
+namespace content {
+namespace {
+class NativeDownloadNavigationIdentityTest : public RenderViewHostTestHarness {
+};
+TEST_F(NativeDownloadNavigationIdentityTest,
+       ExactOriginalIdentityRetiresOnDocumentReplacement) {
+  NavigateAndCommit(GURL("https://fixture.invalid/original"));
+  testing::NiceMock<download::MockDownloadItem> item;
+  DownloadItemUtils::AttachInfo(&item, browser_context(), web_contents(),
+                                main_rfh()->GetGlobalId(), 123456);
+  EXPECT_EQ(DownloadItemUtils::GetNavigationId(&item), 123456);
+  EXPECT_EQ(DownloadItemUtils::GetRenderFrameHost(&item), main_rfh());
+  EXPECT_EQ(DownloadItemUtils::GetBrowserContext(&item), browser_context());
+  NavigateAndCommit(GURL("https://fixture.invalid/replacement"));
+  EXPECT_FALSE(DownloadItemUtils::GetNavigationId(&item));
+  EXPECT_EQ(DownloadItemUtils::GetRenderFrameHost(&item), nullptr);
+  EXPECT_EQ(DownloadItemUtils::GetWebContents(&item), nullptr);
+  EXPECT_EQ(DownloadItemUtils::GetOriginalWebContents(&item), web_contents());
+}
+TEST_F(NativeDownloadNavigationIdentityTest,
+       OrdinaryDownloadDoesNotAcquireNavigationIdentity) {
+  NavigateAndCommit(GURL("https://fixture.invalid/original"));
+  testing::NiceMock<download::MockDownloadItem> item;
+  DownloadItemUtils::AttachInfo(&item, browser_context(), web_contents(),
+                                main_rfh()->GetGlobalId());
+  EXPECT_FALSE(DownloadItemUtils::GetNavigationId(&item));
+}
+}  // namespace
+}  // namespace content
