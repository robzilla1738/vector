+download::DownloadItem::DownloadRenameResult RenameDownloadFileConditional(
+    const base::DictValue& fingerprint, const base::FilePath& expected,
+    const base::FilePath& source, const base::FilePath& destination);
+bool EligibleDownloadName(Profile* profile, download::DownloadItem* item);
+base::DictValue DownloadNamingMetadata(download::DownloadItem* item);
+std::optional<base::DictValue> RecordDownloadNamingCandidate(Profile* profile, download::DownloadItem* item);
