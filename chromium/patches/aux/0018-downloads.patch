@@ -0,0 +1,29 @@
+// Copyright 2026 The Aux Authors
+#import <Foundation/Foundation.h>
+#import <PDFKit/PDFKit.h>
+#include "chrome/browser/ui/aux/download_naming.h"
+#include "base/files/file_util.h"
+#include "base/strings/string_util.h"
+namespace aux {
+std::string DownloadPreviewText(const base::FilePath& path, const std::string& mime) {
+  @autoreleasepool {
+    std::string text;
+    if (mime == "application/pdf") {
+      NSURL* url = [NSURL fileURLWithPath:[NSString stringWithUTF8String:path.value().c_str()]];
+      PDFDocument* document = [[PDFDocument alloc] initWithURL:url];
+      if (document.pageCount) {
+        NSString* first = [[document pageAtIndex:0] string];
+        if (first) text = first.UTF8String;
+      }
+    } else if (base::StartsWith(mime, "text/")) {
+      base::ReadFileToStringWithMaxSize(path, &text, 2048);
+    }
+    if (text.size() > 2048) {
+      size_t end = 2048;
+      while (end && (static_cast<unsigned char>(text[end]) & 0xc0) == 0x80) --end;
+      text.resize(end);
+    }
+    return base::IsStringUTF8(text) ? text : std::string();
+  }
+}
+}
