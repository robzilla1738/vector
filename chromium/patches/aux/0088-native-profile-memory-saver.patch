+bool EgressController::CanDiscardPage(content::WebContents* page) const {
+  if (!page || page->GetBrowserContext() != profile_ ||
+      owner_mutations_.pending() || page->IsBeingCaptured()) {
+    return false;
+  }
+  if (content::DevToolsAgentHost::HasFor(page) &&
+      content::DevToolsAgentHost::GetOrCreateFor(page)->IsAttached()) {
+    return false;
+  }
+  if (auto host = content::DevToolsAgentHost::GetForTab(page);
+      host && host->IsAttached()) {
+    return false;
+  }
+  const auto* identity = PageIdentity::FromWebContents(page);
+  const std::string page_id = identity ? identity->id() : std::string();
+  const auto state = pages_.find(page_id);
+  if (state != pages_.end() &&
+      (!state->second->lease.empty() ||
+       !state->second->acknowledged_context.empty() ||
+       !state->second->navigation_transition_id.empty())) {
+    return false;
+  }
+  if (std::ranges::any_of(pending_,
+                          [&](const auto& request) {
+                            return request->context.page_id == page_id;
+                          }) ||
+      std::ranges::any_of(in_flight_,
+                          [&](const auto& request) {
+                            return request.second->context.page_id == page_id;
+                          }) ||
+      std::ranges::any_of(person_resumes_, [&](const auto& resume) {
+        return resume.second->page_id == page_id;
+      })) {
+    return false;
+  }
+  const auto owner = isolation_run_by_page_.find(page_id);
+  if (owner != isolation_run_by_page_.end()) {
+    const auto isolation = isolations_by_run_.find(owner->second);
+    if (isolation == isolations_by_run_.end()) {
+      return false;
+    }
+    const auto& registration = *isolation->second;
+    // Chromium recreates a discarded tab in the Profile's default partition.
+    // A private task tab must retain its original partition and cleanup owner.
+    if (!registration.session || !registration.config.is_default() ||
+        registration.ancestry.empty() ||
+        registration.terminal_ancestors.size() !=
+            registration.ancestry.size() ||
+        !std::ranges::any_of(
+            registration.registered_pages,
+            [page](const auto& original) { return original.get() == page; })) {
+      return false;
+    }
+    for (const auto& [id, resume] : run_resumes_) {
+      if (std::ranges::find(registration.ancestry, resume->run_id) !=
+          registration.ancestry.end()) {
+        return false;
+      }
+    }
