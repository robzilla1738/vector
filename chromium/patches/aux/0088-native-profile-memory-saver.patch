+    return identity->runtime_work_retired();
+  }
+  if (state != pages_.end() && state->second->guarded) {
+    return false;
+  }
+  auto* frame = page->GetPrimaryMainFrame();
+  const auto* document =
+      frame ? EgressDocument::GetForCurrentDocument(frame) : nullptr;
+  if (document && document->protected_document &&
