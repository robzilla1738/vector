@@ -2799,6 +2806,17 @@ void AuxRuntimeHost::Worker::SendNavigationError(std::string payload_json) {
 void AuxRuntimeHost::Worker::ForwardNote(const base::DictValue& data) {
   const std::string* type = data.FindString("type");
   const base::Value* payload = data.Find("payload");
+  if (type && *type == "startupPhase") {
+    const auto* status = payload ? payload->GetIfDict() : nullptr;
+    const auto* phase = status ? status->FindString("phase") : nullptr;
+    if (!private_session_id_.empty() && data.size() == 3 && status &&
+        status->size() == 1 && phase &&
+        (*phase == "connected" || *phase == "proof" || *phase == "settings" ||
+         *phase == "services" || *phase == "ready")) {
+      private_startup_phase_ = *phase;
+    }
+    return;
+  }
   if (!type || *type != "event" || !payload) {
     return;
   }
