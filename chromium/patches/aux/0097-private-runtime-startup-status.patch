@@ -2230,10 +2233,14 @@ bool AuxRuntimeHost::Worker::Disconnect() {
   read_buffer_.clear();
   auto pending = std::move(pending_requests_);
   pending_requests_.clear();
+  const std::string disconnected =
+      private_startup_phase_.empty()
+          ? "The runtime connection ended before this request was acknowledged"
+          : "Private AI disconnected after the " + private_startup_phase_ +
+                " startup stage.";
   for (auto& [id, request] : pending) {
