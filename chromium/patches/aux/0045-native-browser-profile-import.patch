new file mode 100644
index 000000000..c309089d7
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_profile_key_provider.mm
@@ -0,0 +1,99 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_profile_key_provider.h"
+#include <Security/Security.h>
+#include <array>
+#include <vector>
+#include <utility>
+#include "base/apple/scoped_cftyperef.h"
+#include "base/apple/foundation_util.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/task/thread_pool.h"
+#include "components/os_crypt/async/common/algorithm.mojom.h"
+#include "crypto/apple/keychain_v2.h"
+#include "crypto/kdf.h"
+#include "crypto/secure_util.h"
+#include "crypto/subtle_passkey.h"
+namespace aux {
+namespace {
+const char* Service(BrowserProfileBrand source) {
+  switch (source) {
+    case BrowserProfileBrand::kChrome: return "Chrome Safe Storage";
+    case BrowserProfileBrand::kChromium: return "Chromium Safe Storage";
+    case BrowserProfileBrand::kEdge: return "Microsoft Edge Safe Storage";
+    case BrowserProfileBrand::kBrave: return "Brave Safe Storage";
+    case BrowserProfileBrand::kArc: return "Arc Safe Storage";
+    case BrowserProfileBrand::kDia: return "Dia Safe Storage";
+    case BrowserProfileBrand::kComet: return "Comet Safe Storage";
+  }
+  return nullptr;
+}
+base::expected<os_crypt_async::Encryptor::Key, os_crypt_async::KeyProvider::KeyError>
+ReadSourceKey(BrowserProfileBrand source, std::shared_ptr<std::atomic_bool> cancelled,
+              crypto::SubtlePassKey passkey) {
+  using Error = os_crypt_async::KeyProvider::KeyError;
+  if (cancelled->load()) return base::unexpected(Error::kTemporarilyUnavailable);
+  const char* name = Service(source);
+  if (!name) return base::unexpected(Error::kTemporarilyUnavailable);
+  base::apple::ScopedCFTypeRef<CFStringRef> service(
+      CFStringCreateWithCString(kCFAllocatorDefault, name, kCFStringEncodingUTF8));
+  const void* keys[] = {kSecClass, kSecAttrService, kSecMatchLimit,
+                         kSecReturnAttributes, kSecReturnData};
+  const void* values[] = {kSecClassGenericPassword, service.get(), kSecMatchLimitAll,
+                           kCFBooleanTrue, kCFBooleanTrue};
+  base::apple::ScopedCFTypeRef<CFDictionaryRef> query(CFDictionaryCreate(
+      kCFAllocatorDefault, keys, values, std::size(keys),
+      &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks));
+  base::apple::ScopedCFTypeRef<CFTypeRef> result;
+  // Read-only query: missing/ambiguous/auth-denied keys refuse this category.
+  // Stock KeychainPassword::GetPassword would create a missing source key.
+  if (crypto::apple::KeychainV2::GetInstance().ItemCopyMatching(
+          query.get(), result.InitializeInto()) != errSecSuccess || !result ||
+      CFGetTypeID(result.get()) != CFArrayGetTypeID())
+    return base::unexpected(Error::kTemporarilyUnavailable);
+  if (cancelled->load()) return base::unexpected(Error::kTemporarilyUnavailable);
+  auto array = static_cast<CFArrayRef>(result.get());
+  if (CFArrayGetCount(array) != 1)
+    return base::unexpected(Error::kTemporarilyUnavailable);
+  auto item = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(array, 0));
+  if (!item || CFGetTypeID(item) != CFDictionaryGetTypeID())
+    return base::unexpected(Error::kTemporarilyUnavailable);
+  auto data = static_cast<CFDataRef>(CFDictionaryGetValue(item, kSecValueData));
+  if (!data || CFGetTypeID(data) != CFDataGetTypeID() || CFDataGetLength(data) <= 0 ||
+      CFDataGetLength(data) > 4096)
+    return base::unexpected(Error::kTemporarilyUnavailable);
+  const auto bytes = base::apple::CFDataToSpan(data);
+  std::vector<uint8_t> password(bytes.begin(), bytes.end());
+  // The same persisted macOS v10 codec parameters used by Chromium's provider.
+  constexpr auto salt = std::to_array<uint8_t>({'s','a','l','t','y','s','a','l','t'});
+  std::array<uint8_t, 16> key_bytes;
+  crypto::kdf::Pbkdf2HmacSha1({.iterations = 1003}, password, salt, key_bytes, passkey);
+  crypto::SecureZeroBuffer(password);
+  os_crypt_async::Encryptor::Key key(key_bytes,
+                                    os_crypt_async::mojom::Algorithm::kAES128CBC);
+  crypto::SecureZeroBuffer(key_bytes);
+  return key;
+}
+}  // namespace
+BrowserProfileKeyProvider::BrowserProfileKeyProvider(BrowserProfileBrand source,
+    std::shared_ptr<std::atomic_bool> cancelled)
+    : source_(source), cancelled_(std::move(cancelled)) {}
+BrowserProfileKeyProvider::~BrowserProfileKeyProvider() = default;
+void BrowserProfileKeyProvider::GetKey(KeyCallback callback) {
+  auto replies = base::SplitOnceCallback(std::move(callback));
+  const bool posted = base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&ReadSourceKey, source_, cancelled_, crypto::SubtlePassKey{}),
+      base::BindOnce(std::move(replies.first), "v10"));
+  if (!posted) std::move(replies.second).Run("v10",
+      base::unexpected(KeyError::kTemporarilyUnavailable));
+}
+bool BrowserProfileKeyProvider::UseForEncryption() {
+  // Only a disposable native copy may need codec/schema migration encryption.
+  return true;
+}
+}  // namespace aux
