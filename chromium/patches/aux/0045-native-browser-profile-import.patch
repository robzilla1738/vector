+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_KEY_PROVIDER_H_
+#define CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_KEY_PROVIDER_H_
+#include <atomic>
+#include <memory>
+#include "components/os_crypt/async/browser/key_provider.h"
+namespace aux {
+enum class BrowserProfileBrand { kChrome, kChromium, kEdge, kBrave, kArc, kDia, kComet };
+// A separate OSCryptAsync instance decodes only this native disposable snapshot.
+// Never changes Aux's global key, exports a key, or creates a source Keychain item.
+class BrowserProfileKeyProvider final : public os_crypt_async::KeyProvider {
+ public:
+  BrowserProfileKeyProvider(BrowserProfileBrand source,
+                            std::shared_ptr<std::atomic_bool> cancelled);
+  ~BrowserProfileKeyProvider() override;
+  void GetKey(KeyCallback callback) override;
+  bool UseForEncryption() override;
+ private:
+  BrowserProfileBrand source_;
+  std::shared_ptr<std::atomic_bool> cancelled_;
+};
+}  // namespace aux
+#endif
