+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_IMPORTER_H_
+#define CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_IMPORTER_H_
+#include <atomic>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+class Profile;
+class BrowserWindowInterface;
+class ScopedProfileKeepAlive;
+namespace base { class SingleThreadTaskRunner; }
+namespace aux {
+class ProfileLibrary;
+// Owned by the original native runtime host. Discover/Begin receive authority
+// derived there from its actual WeakDocumentPtr + window + socket generation.
+// Poll/Cancel only reduce known jobs, including after owner retirement.
+class BrowserProfileImporter {
+ public:
+  using Reply = base::OnceCallback<void(base::DictValue)>;
+  using Current = base::RepeatingCallback<bool()>;
+  BrowserProfileImporter(Profile* profile, std::shared_ptr<ProfileLibrary> library);
+  ~BrowserProfileImporter();
+  BrowserProfileImporter(const BrowserProfileImporter&) = delete;
+  BrowserProfileImporter& operator=(const BrowserProfileImporter&) = delete;
+  void Discover(const std::string& owner_token,
+                base::WeakPtr<BrowserWindowInterface> window,
+                Current current, Reply callback);
+  // Idempotence is exact operation ID + original owner/source/category tuple.
+  // The caller persists operation_id before this method can accept any effect.
+  base::DictValue Begin(const std::string& owner_token,
+                       const std::string& operation_id,
+                       const std::string& source_handle,
+                       const std::vector<std::string>& categories);
+  base::DictValue Poll(const std::string& operation_id) const;
+  base::DictValue Cancel(const std::string& operation_id);
+  void RetireOwner(const std::string& owner_token);
+  // A callback is an actual join: no decoding work, prompt, accepted installer
+  // or backend batch remains. It is not a rollback of accepted import effects.
+  void Close(base::OnceClosure joined);
+ private:
+  struct Source;
+  struct Job;
+  void Decode(const std::shared_ptr<Job>& job);
+  void Dispatch(const std::shared_ptr<Job>& job);
+  void ScheduleDispatch(const std::shared_ptr<Job>& job);
+  void OnHistory(const std::shared_ptr<Job>& job, base::DictValue result);
+  void OnPasswords(const std::shared_ptr<Job>& job, size_t total,
+                   int status, size_t imported);
+  void OnExtension(const std::shared_ptr<Job>& job, bool success);
+  void Finish(const std::shared_ptr<Job>& job, const std::string& error);
+  void MaybeJoined();
+  bool CurrentJob(const Job& job) const;
+  raw_ptr<Profile> profile_;
+  std::shared_ptr<ProfileLibrary> library_;
+  std::unique_ptr<ScopedProfileKeepAlive> profile_keep_alive_;
+  bool closed_ = false;
+  scoped_refptr<base::SingleThreadTaskRunner> worker_;
+  std::string discovery_owner_;
+  std::shared_ptr<std::atomic_bool> discovery_cancelled_;
+  size_t discoveries_in_flight_ = 0;
+  std::map<std::string, std::shared_ptr<Source>> sources_;
+  std::map<std::string, std::shared_ptr<Job>> jobs_;
+  std::vector<base::OnceClosure> joins_;
+  base::WeakPtrFactory<BrowserProfileImporter> weak_factory_{this};
+};
+}  // namespace aux
+#endif
