diff --git a/chrome/browser/ui/aux/browser_profile_decode.cc b/chrome/browser/ui/aux/browser_profile_decode.cc
new file mode 100644
index 000000000..af493660d
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_profile_decode.cc
@@ -0,0 +1,58 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_profile_decode.h"
+#include <algorithm>
+#include <utility>
+#include "components/os_crypt/async/common/encryptor.h"
+namespace aux {
+DecodedBrowserProfile DecodeBrowserProfile(
+    const base::FilePath& source, const std::vector<std::string>& categories,
+    scoped_refptr<os_crypt_async::Encryptor> source_encryptor,
+    const base::RepeatingCallback<bool()>& cancelled) {
+  DecodedBrowserProfile result;
+  auto selected = [&](const char* name) {
+    return std::ranges::find(categories, name) != categories.end();
+  };
+  std::vector<std::string> files;
+  if (selected("bookmarks")) files.push_back("Bookmarks");
+  if (selected("history")) {
+    for (const char* suffix : {"", "-wal", "-shm", "-journal"})
+      files.push_back(std::string("History") + suffix);
+  }
+  if (selected("passwords")) {
+    for (const char* database : {"Login Data", "Login Data For Account"})
+      for (const char* suffix : {"", "-wal", "-shm", "-journal"})
+        files.push_back(std::string(database) + suffix);
+  }
+  if (selected("extensions")) files.insert(files.end(), {"Preferences", "Secure Preferences"});
+  auto snapshot = BrowserProfileSnapshot::Capture(source, files, selected("tabs"), cancelled);
+  if (!snapshot.has_value()) {
+    result.snapshot_error = snapshot.error();
+    return result;
+  }
+  result.snapshot = std::move(*snapshot);
+  auto read = [&](const char* name, auto reader, auto& destination) {
+    if (!selected(name)) return;
+    if (cancelled.Run()) {
+      result.errors.emplace(name, "Browser import was cancelled.");
+      return;
+    }
+    auto decoded = reader();
+    if (!decoded.has_value()) result.errors.emplace(name, decoded.error());
+    else destination = std::move(*decoded);
+  };
+  read("bookmarks", [&] { return ReadProfileBookmarks(*result.snapshot); }, result.bookmarks);
+  read("history", [&] { return ReadProfileHistory(*result.snapshot); }, result.history);
+  read("tabs", [&] { return ReadProfileTabs(*result.snapshot, source_encryptor); }, result.tabs);
+  read("passwords", [&] { return ReadProfilePasswords(*result.snapshot, source_encryptor); }, result.passwords);
+  read("extensions", [&] { return ReadProfileStoreExtensions(*result.snapshot); }, result.extensions);
+  if (cancelled.Run() || !result.snapshot->OriginalIsCurrent()) {
+    result.snapshot_error = cancelled.Run() ? "Browser import was cancelled." :
+        "The original browser changed. Close it and refresh the preview.";
+    // Never retain decrypted passwords when admission cannot be reached.
+    result.passwords.clear();
+  }
+  return result;
+}
+}  // namespace aux
