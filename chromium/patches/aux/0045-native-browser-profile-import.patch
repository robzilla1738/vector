+base::DictValue ProfileLibrary::ImportNativeBookmarks(
+    const std::vector<NativeBookmarkImportEntry>& entries,
+    std::map<size_t, base::Uuid>& accepted_folders,
+    base::RepeatingCallback<bool()> current) {
+  if (!bookmarks_ || !bookmarks_->loaded() || !current || entries.size() > 500)
+    return Fault("backend_unavailable", "Native bookmark import is unavailable");
+  int added = 0, skipped = 0;
+  bool retired = false;
+  for (const auto& entry : entries) {
+    if (!current.Run()) { retired = true; break; }
+    const bookmarks::BookmarkNode* parent = bookmarks_->bookmark_bar_node();
+    if (entry.parent_source_id) {
+      auto found = accepted_folders.find(entry.parent_source_id);
+      parent = found == accepted_folders.end() ? nullptr : bookmarks_->GetNodeByUuid(
+          found->second, bookmarks::BookmarkModel::NodeTypeForUuidLookup::kLocalOrSyncableNodes);
+    }
+    if (!parent || !parent->is_folder() || entry.title.size() > 1000 ||
+        !entry.source_id || entry.source_id == entry.parent_source_id) {
+      retired = true;
+      break;
+    }
+    if (entry.url.is_empty()) {
+      if (accepted_folders.contains(entry.source_id)) { retired = true; break; }
+      const auto* folder = bookmarks_->AddFolder(parent, parent->children().size(), entry.title);
+      accepted_folders.emplace(entry.source_id, folder->uuid());
+    } else if (!ValidWebUrl(entry.url.spec())) {
+      ++skipped;
+    } else if (!bookmarks_->GetNodesByURL(entry.url).empty()) {
+      ++skipped;
+    } else {
+      bookmarks_->AddNewURL(parent, parent->children().size(), entry.title, entry.url);
+      ++added;
+    }
+  }
+  base::DictValue result;
+  result.Set("added", added);
+  result.Set("skipped", skipped);
+  result.Set("retired", retired);
+  return Result(base::Value(std::move(result)));
