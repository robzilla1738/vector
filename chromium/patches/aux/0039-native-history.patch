+// One SQL page lives on the history sequence. A long text search yields to
+// other history work between pages and retains only the requested matches.
+class HistoryReadTask final : public history::HistoryDBTask {
+ public:
+  HistoryReadTask(const base::DictValue& params,
+                  std::optional<size_t> limit,
+                  base::OnceCallback<void(base::DictValue)> callback)
+      : limit_(limit), callback_(std::move(callback)) {
+    // Public identities are whole milliseconds; fractional range bounds must
+    // select the same identities as the runtime projection.
+    begin_ = base::Time::FromMillisecondsSinceUnixEpoch(
+        std::ceil(params.FindDouble("since").value_or(0)));
+    if (limit) {
+      if (const auto* cursor = params.FindDict("before")) {
+        const double at = *cursor->FindDouble("visitedAt");
+        before_ = std::make_pair(
+            base::Time::FromMillisecondsSinceUnixEpoch(std::ceil(at)),
+            at == std::floor(at) ? *cursor->FindString("url") : std::string());
+      }
+    } else if (const auto end = params.FindDouble("before")) {
+      end_ = base::Time::FromMillisecondsSinceUnixEpoch(std::ceil(*end));
+    }
+    if (const auto* query = params.FindString("query")) {
+      query_ = base::i18n::ToLower(base::UTF8ToUTF16(*query));
+    }
+  }
+  bool RunOnDBThread(history::HistoryBackend*,
+                     history::HistoryDatabase* db) override {
+    if (!db) {
+      return true;
+    }
+    if (!limit_) {
+      int64_t count = 0;
+      if (!db->CountVisibleVisitIdentities(begin_, end_, &count)) {
+        return true;
+      }
+      base::DictValue result;
+      result.Set("count", static_cast<double>(count));
+      result_ = Result(base::Value(std::move(result)));
+      return true;
+    }
+    history::QueryResults page;
+    if (!db->GetVisibleVisitPage(begin_, end_, before_, kHistoryBatchSize,
+                                 &page)) {
+      return true;
+    }
+    for (const auto& row : page) {
+      if (!query_.empty() &&
+          base::i18n::ToLower(row.title()).find(query_) ==
+              std::u16string::npos &&
+          base::i18n::ToLower(base::UTF8ToUTF16(row.url().spec()))
+                  .find(query_) == std::u16string::npos) {
+        continue;
+      }
+      matches_.Append(VisitValue(
+          row.url().spec(), base::UTF16ToUTF8(row.title().substr(0, 4096)),
+          row.visit_time().InMillisecondsSinceUnixEpoch()));
+      if (matches_.size() == *limit_) {
+        break;
+      }
+    }
+    if (matches_.size() == *limit_ || page.size() < kHistoryBatchSize) {
+      result_ = Result(base::Value(std::move(matches_)));
+      return true;
+    }
+    before_ =
+        std::make_pair(page.back().visit_time(), page.back().url().spec());
+    return false;
+  }
+  void DoneRunOnMainThread() override {
+    std::move(callback_).Run(std::move(result_));
+  }
+
+ private:
+  base::Time begin_, end_;
+  std::optional<std::pair<base::Time, std::string>> before_;
+  std::optional<size_t> limit_;
+  std::u16string query_;
+  base::ListValue matches_;
+  base::DictValue result_ =
+      Fault("backend_unavailable", "Chromium history could not be read");
+  base::OnceCallback<void(base::DictValue)> callback_;
+};
+
