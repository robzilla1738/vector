+constexpr char kVisibleVisitIdentities[] =
+    " FROM visits v JOIN urls u ON u.id=v.url LEFT JOIN visit_source source ON "
+    "source.id=v.id "
+    "WHERE v.visit_time>=? AND v.visit_time<? "
+    "AND (v.transition & ?) != 0 AND (v.transition & ?) NOT IN (?,?,?) "
