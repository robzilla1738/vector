+void ProfileLibrary::HistoryCall(
+    const std::string& method,
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback,
+    base::RepeatingCallback<bool()> current) {
+  if (!history_ || !current.Run()) {
+    std::move(callback).Run(
+        Fault("ref_stale", "Original history window is unavailable"));
+    return;
+  }
+  if (method == "history.clear") {
+    ClearHistory(params, std::move(callback), std::move(current));
+    return;
+  }
+  if (method == "history.remove") {
+    RemoveVisit(params, std::move(callback), std::move(current));
+    return;
+  }
+  const bool list = method == "history.list";
+  if (!list && method != "history.count") {
+    std::move(callback).Run(
+        Fault("unsupported", "Unknown native history method"));
+    return;
+  }
+  history_->ScheduleDBTask(FROM_HERE,
+                           std::make_unique<HistoryReadTask>(
+                               params,
+                               list ? std::make_optional<size_t>(
+                                          params.FindInt("limit").value_or(100))
+                                    : std::nullopt,
+                               std::move(callback)),
+                           &tracker_);
+}
