+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_export_picker.h"
+#import <Cocoa/Cocoa.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+#include "base/apple/foundation_util.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/single_thread_task_runner.h"
+namespace aux {
+namespace {
+class MacBrowserExportPicker final : public BrowserExportPicker {
+ public:
+  MacBrowserExportPicker(NSWindow* window, BrowserExportFormat format, Selected selected)
+      : selected_(std::move(selected)) {
+    panel_ = [NSOpenPanel openPanel];
+    panel_.allowsMultipleSelection = NO;
+    panel_.canChooseDirectories = NO;
+    panel_.canChooseFiles = YES;
+    panel_.resolvesAliases = NO;
+    panel_.prompt = @"Review export";
+    panel_.message = @"Choose a browser export. Aux reads a private snapshot; it does not modify this file or the original browser.";
+    NSString* extension = format == BrowserExportFormat::kSafariArchive ? @"zip" :
+        format == BrowserExportFormat::kPasswordsCsv ? @"csv" : @"html";
+    UTType* type = [UTType typeWithFilenameExtension:extension];
+    if (type) panel_.allowedContentTypes = @[type];
+    auto weak = weak_factory_.GetWeakPtr();
+    [panel_ beginSheetModalForWindow:window completionHandler:^(NSModalResponse response) {
+      if (!weak) return;
+      auto callback = std::move(weak->selected_);
+      base::expected<base::FilePath, std::string> result =
+          base::unexpected("Browser export selection was cancelled.");
+      if (response == NSModalResponseOK && weak->panel_.URL.isFileURL)
+        result = base::apple::NSURLToFilePath(weak->panel_.URL);
+      weak->panel_ = nil;
+      // The owner may destroy the panel object in this callback. Dispatch it
+      // after Cocoa has returned from the original sheet completion stack.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+          base::BindOnce(std::move(callback), std::move(result)));
+    }];
+  }
+  ~MacBrowserExportPicker() override {
+    weak_factory_.InvalidateWeakPtrs();
+    Cancel();
+  }
+  void Cancel() override { if (panel_) [panel_ cancel:nil]; }
+ private:
+  NSOpenPanel* __strong panel_ = nil;
+  Selected selected_;
+  base::WeakPtrFactory<MacBrowserExportPicker> weak_factory_{this};
+};
+}  // namespace
+std::unique_ptr<BrowserExportPicker> BrowserExportPicker::Show(
+    gfx::NativeWindow original_window, BrowserExportFormat format, Selected selected) {
+  NSWindow* window = original_window.GetNativeNSWindow();
+  if (!window || !window.isVisible) return nullptr;
+  return std::make_unique<MacBrowserExportPicker>(window, format, std::move(selected));
+}
+}  // namespace aux
