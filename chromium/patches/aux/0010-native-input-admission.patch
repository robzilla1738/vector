+void RenderWidgetHostViewMac::RetireNativeInputBinding() {
+  ++native_input_epoch_;
+  RetireEmbeddedNativeInputAdmission(nullptr);
+  native_input_ready_ = false;
+  native_input_binding_.clear();
+  native_input_document_ = {};
+  FinishNativeInputAdmissionWaiters(false);
+  if (ns_view_)
+    ns_view_->SetNativeInputDocumentBinding({}, base::DoNothing());
+}
+
+bool RenderWidgetHostViewMac::EmbeddedNativeInputDocumentCurrent(
+    RenderWidgetHostViewBase* child,
+    const WeakDocumentPtr& document) const {
+  auto* frame = document.AsRenderFrameHostIfValid();
+  auto* widget = child
+                     ? RenderWidgetHostImpl::From(child->GetRenderWidgetHost())
+                     : nullptr;
+  auto* contents =
+      widget ? WebContentsImpl::FromRenderWidgetHostImpl(widget) : nullptr;
+  return ns_view_ && child && child != this && child->GetRootView() == this &&
+         widget && widget->GetView() == child && frame && contents &&
+         frame->GetRenderWidgetHost() == widget &&
+         contents->GetPrimaryMainFrame() == frame && frame->IsActive() &&
+         frame->IsRenderFrameLive();
+}
+
+bool RenderWidgetHostViewMac::HasEmbeddedNativeInputAdmission(
+    RenderWidgetHostViewBase* child,
+    const WeakDocumentPtr& document) const {
+  if (!EmbeddedNativeInputDocumentCurrent(child, document)) {
+    return false;
+  }
+  for (const auto& [binding, entry] : embedded_native_input_bindings_) {
+    if (entry->child.get() == child && entry->epoch == native_input_epoch_ &&
+        entry->ready &&
+        entry->document.AsRenderFrameHostIfValid() ==
+            document.AsRenderFrameHostIfValid()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void RenderWidgetHostViewMac::RetireEmbeddedNativeInputBinding(
+    const std::string& binding) {
+  auto found = embedded_native_input_bindings_.find(binding);
+  if (found == embedded_native_input_bindings_.end()) {
+    return;
+  }
+  auto entry = std::move(found->second);
+  embedded_native_input_bindings_.erase(found);
+  entry->timer.Stop();
+  if (ns_view_) {
+    ns_view_->SetEmbeddedNativeInputDocumentBinding(binding, false,
+                                                    base::DoNothing());
+  }
+  for (auto& callback : entry->callbacks) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), false));
+  }
+}
+
+void RenderWidgetHostViewMac::RetireEmbeddedNativeInputAdmission(
+    RenderWidgetHostViewBase* child) {
+  std::vector<std::string> retired;
+  for (const auto& [binding, entry] : embedded_native_input_bindings_) {
+    if (!child || !entry->child || entry->child.get() == child) {
+      retired.push_back(binding);
+    }
+  }
+  for (const auto& binding : retired) {
+    RetireEmbeddedNativeInputBinding(binding);
+  }
+}
+
+void RenderWidgetHostViewMac::FinishEmbeddedNativeInputBinding(
+    const std::string& binding,
+    bool ready) {
+  auto found = embedded_native_input_bindings_.find(binding);
+  if (found == embedded_native_input_bindings_.end()) {
+    return;
+  }
+  auto& entry = *found->second;
+  if (!ready || entry.epoch != native_input_epoch_ ||
+      !EmbeddedNativeInputDocumentCurrent(entry.child.get(), entry.document)) {
+    RetireEmbeddedNativeInputBinding(binding);
+    return;
+  }
+  entry.ready = true;
+  entry.timer.Stop();
+  auto callbacks = std::move(entry.callbacks);
+  for (auto& callback : callbacks) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<RenderWidgetHostViewMac> root,
+               base::WeakPtr<RenderWidgetHostViewBase> child,
+               WeakDocumentPtr document, std::string binding,
+               base::OnceCallback<void(bool)> callback) {
+              std::move(callback).Run(
+                  root && child &&
+                  root->embedded_native_input_bindings_.contains(binding) &&
+                  root->HasEmbeddedNativeInputAdmission(child.get(), document));
+            },
+            weak_factory_.GetWeakPtr(), entry.child, entry.document, binding,
+            std::move(callback)));
+  }
+}
+
+void RenderWidgetHostViewMac::AwaitEmbeddedNativeInputAdmission(
+    RenderWidgetHostViewBase* child,
+    const WeakDocumentPtr& document,
+    base::OnceCallback<void(bool)> callback) {
+  if (!EmbeddedNativeInputDocumentCurrent(child, document)) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (HasEmbeddedNativeInputAdmission(child, document)) {
+    std::move(callback).Run(true);
+    return;
+  }
+  for (const auto& [binding, entry] : embedded_native_input_bindings_) {
+    if (entry->child.get() == child && entry->epoch == native_input_epoch_ &&
+        entry->document.AsRenderFrameHostIfValid() ==
+            document.AsRenderFrameHostIfValid()) {
+      if (entry->callbacks.size() < 8) {
+        entry->callbacks.push_back(std::move(callback));
+      } else {
+        std::move(callback).Run(false);
+      }
+      return;
+    }
+  }
+  RetireEmbeddedNativeInputAdmission(child);
+  const std::string binding = base::UnguessableToken::Create().ToString();
+  auto entry = std::make_unique<EmbeddedNativeInputBinding>();
+  entry->child = child->GetWeakPtr();
+  entry->document = document;
+  entry->epoch = native_input_epoch_;
+  entry->callbacks.push_back(std::move(callback));
+  entry->timer.Start(
+      FROM_HERE, base::Seconds(8),
+      base::BindOnce(&RenderWidgetHostViewMac::FinishEmbeddedNativeInputBinding,
+                     weak_factory_.GetWeakPtr(), binding, false));
+  embedded_native_input_bindings_.emplace(binding, std::move(entry));
+  // This independent token is acknowledged by the actual hosting NSView. It
+  // never admits a child using the Aux shell's primary-document token.
+  ns_view_->SetEmbeddedNativeInputDocumentBinding(
+      binding, true,
+      base::BindOnce(&RenderWidgetHostViewMac::FinishEmbeddedNativeInputBinding,
+                     weak_factory_.GetWeakPtr(), binding, true));
+}
+
+bool RenderWidgetHostViewMac::HasNativeInputAdmissionForDocument(
+    const content::WeakDocumentPtr& document) const {
+  auto* frame = document.AsRenderFrameHostIfValid();
+  return native_input_ready_ && ns_view_ && frame &&
+         native_input_document_.AsRenderFrameHostIfValid() == frame;
+}
+
+void RenderWidgetHostViewMac::AwaitNativeInputAdmissionForDocument(
+    const content::WeakDocumentPtr& document,
+    base::OnceCallback<void(bool)> callback) {
+  auto* frame = document.AsRenderFrameHostIfValid();
+  if (!frame || native_input_document_.AsRenderFrameHostIfValid() != frame ||
+      native_input_binding_.empty() || !ns_view_ ||
+      native_input_waiters_.size() >= 8) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (HasNativeInputAdmissionForDocument(document)) {
+    std::move(callback).Run(true);
+    return;
+  }
+  const auto id = base::UnguessableToken::Create().ToString();
+  auto waiter = std::make_unique<NativeInputAdmissionWaiter>();
+  waiter->binding = native_input_binding_;
+  waiter->document = document;
+  waiter->callback = std::move(callback);
+  waiter->timer.Start(FROM_HERE, base::Seconds(8), base::BindOnce(
+      &RenderWidgetHostViewMac::FinishNativeInputAdmissionWaiter,
+      weak_factory_.GetWeakPtr(), id));
+  native_input_waiters_.emplace(id, std::move(waiter));
+}
+
+void RenderWidgetHostViewMac::FinishNativeInputAdmissionWaiter(
+    const std::string& id) {
+  auto found = native_input_waiters_.find(id);
+  if (found == native_input_waiters_.end()) return;
+  auto waiter = std::move(found->second);
+  native_input_waiters_.erase(found);
+  waiter->timer.Stop();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(waiter->callback), false));
+}
+
+void RenderWidgetHostViewMac::FinishNativeInputAdmissionWaiters(bool ready) {
+  auto waiters = std::move(native_input_waiters_);
+  native_input_waiters_.clear();
+  const auto weak = weak_factory_.GetWeakPtr();
+  for (auto& [id, waiter] : waiters) {
+    waiter->timer.Stop();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+            [](base::WeakPtr<RenderWidgetHostViewMac> view, bool ready,
+               std::string binding, content::WeakDocumentPtr document,
+               base::OnceCallback<void(bool)> callback) {
+              const bool admitted = ready && view &&
+                  view->native_input_binding_ == binding &&
+                  view->HasNativeInputAdmissionForDocument(document);
+              std::move(callback).Run(admitted);
+            }, weak, ready, std::move(waiter->binding), waiter->document,
+            std::move(waiter->callback)));
+  }
+}
+
+void RenderWidgetHostViewMac::PublishNativeInputBinding() {
+  auto* contents = WebContentsImpl::FromRenderWidgetHostImpl(host());
+  auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+  // Both post-commit entrypoints report one genuine document. Do not replace
+  // its pending associated ACK. Navigation/BFCache/bridge retirement clears
+  // the original binding before any new document can reach this fast path.
+  if (ns_view_ && frame && frame->IsActive() && frame->IsRenderFrameLive() &&
+      !native_input_binding_.empty() &&
+      native_input_document_.AsRenderFrameHostIfValid() == frame)
+    return;
+  RetireNativeInputBinding();
+  if (!ns_view_ || !frame || !frame->IsActive() || !frame->IsRenderFrameLive())
+    return;
+  native_input_binding_ = base::UnguessableToken::Create().ToString();
+  native_input_document_ = frame->GetWeakDocumentPtr();
+  ns_view_->SetNativeInputDocumentBinding(
+      native_input_binding_, base::BindOnce(
+          [](base::WeakPtr<RenderWidgetHostViewMac> view, std::string binding,
+             content::WeakDocumentPtr document) {
+            auto* frame = document.AsRenderFrameHostIfValid();
+            if (!view || !frame || binding != view->native_input_binding_ ||
+                view->native_input_document_.AsRenderFrameHostIfValid() != frame)
+              return;
+            auto complete = base::BindOnce(
+                [](base::WeakPtr<RenderWidgetHostViewMac> original_view,
+                   std::string original_binding,
+                   content::WeakDocumentPtr original_document) {
+                  auto* original_frame =
+                      original_document.AsRenderFrameHostIfValid();
+                  if (!original_view || !original_frame ||
+                      original_view->native_input_binding_ != original_binding ||
+                      original_view->native_input_document_
+                              .AsRenderFrameHostIfValid() != original_frame)
+                    return;
+                  auto* contents = WebContentsImpl::FromRenderWidgetHostImpl(
+                      original_view->host());
+                  if (!contents ||
+                      contents->GetPrimaryMainFrame() != original_frame ||
+                      !original_frame->IsActive() ||
+                      !original_frame->IsRenderFrameLive())
+                    return;
+                  original_view->native_input_ready_ = true;
+                  original_view->FinishNativeInputAdmissionWaiters(true);
+                }, view, binding, document);
+            std::move(complete).Run();
+          }, weak_factory_.GetWeakPtr(), native_input_binding_, native_input_document_));
+}
+
+void RenderWidgetHostViewMac::AdmitNativeInputEvent(
+    remote_cocoa::mojom::NativeInputEventPtr native_input) {
+  if (!native_input || !in_keyboard_event_) {
+    return;
+  }
+  AdmitNativeInputToWidget(GetWidgetForKeyboardEvent(), *native_input);
+}
+
+base::OnceCallback<void(input::RenderWidgetHostViewInput*)>
+RenderWidgetHostViewMac::NativeInputDispatch(
+    remote_cocoa::mojom::NativeInputEventPtr native_input) {
+  if (!native_input) {
+    return {};
+  }
+  return base::BindOnce(
+      [](base::WeakPtr<RenderWidgetHostViewMac> root, uint64_t epoch,
+         remote_cocoa::mojom::NativeInputEventPtr native_input,
+         input::RenderWidgetHostViewInput* target) {
+        if (!root || root->native_input_epoch_ != epoch || !target ||
+            target->GetRootView() != root.get()) {
+          return;
+        }
+        auto* view = static_cast<RenderWidgetHostViewBase*>(target);
+        root->AdmitNativeInputToWidget(
+            RenderWidgetHostImpl::From(view->GetRenderWidgetHost()),
+            *native_input);
+      },
+      weak_factory_.GetWeakPtr(), native_input_epoch_, std::move(native_input));
+}
+
+void RenderWidgetHostViewMac::AdmitNativeInputToWidget(
+    RenderWidgetHostImpl* widget,
+    const remote_cocoa::mojom::NativeInputEvent& native_input) {
+  if (!widget || native_input.event_data.empty() ||
+      native_input.event_data.size() > 8192) {
+    return;
+  }
+  auto native_event =
+      base::apple::OwnedNSEvent(ui::EventFromData(native_input.event_data));
+  if (!native_event.Get()) {
+    return;
+  }
+  const auto type = [native_event.Get() type];
+  const bool keyboard = type == NSEventTypeKeyDown ||
+                        type == NSEventTypeKeyUp ||
+                        type == NSEventTypeFlagsChanged;
+  const bool mouse = type == NSEventTypeLeftMouseDown ||
+                     type == NSEventTypeRightMouseDown ||
+                     type == NSEventTypeOtherMouseDown ||
+                     type == NSEventTypeLeftMouseUp ||
+                     type == NSEventTypeRightMouseUp ||
+                     type == NSEventTypeOtherMouseUp ||
+                     type == NSEventTypeLeftMouseDragged ||
+                     type == NSEventTypeRightMouseDragged ||
+                     type == NSEventTypeOtherMouseDragged ||
+                     type == NSEventTypeScrollWheel;
+  if (!keyboard && !mouse) {
+    return;
+  }
+  auto* contents = WebContentsImpl::FromRenderWidgetHostImpl(widget);
+  auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+  auto* target_view = widget->GetView();
+  auto* primary_widget = frame ? frame->GetRenderWidgetHost() : nullptr;
+  auto* primary_view = primary_widget ? primary_widget->GetView() : nullptr;
+  if (!frame || !target_view || !primary_view ||
+      target_view->GetRootView() != this) {
+    return;
+  }
+  const auto document = frame->GetWeakDocumentPtr();
+  if (primary_view == this) {
+    if (native_input.binding.empty() ||
+        native_input.binding != native_input_binding_ ||
+        !HasNativeInputAdmissionForDocument(document)) {
+      return;
+    }
+  } else {
+    auto* child = static_cast<RenderWidgetHostViewBase*>(primary_view);
+    if (!HasEmbeddedNativeInputAdmission(child, document)) {
+      return;
+    }
+    bool admitted = false;
+    for (const auto& binding : native_input.embedded_bindings) {
+      auto found = embedded_native_input_bindings_.find(binding);
+      if (found != embedded_native_input_bindings_.end() &&
+          found->second->ready && found->second->epoch == native_input_epoch_ &&
+          found->second->child.get() == child &&
+          found->second->document.AsRenderFrameHostIfValid() == frame) {
+        admitted = true;
+        break;
+      }
+    }
+    if (!admitted) {
+      return;
+    }
+  }
+  // Retire only the actual queued/focused target's document, before forwarding.
+  // Generic WebInputEvent flags and synthetic helpers never create this
+  // evidence.
+  const NativePlatformInputAdmission admission(
+      contents->GetWeakPtr(), widget->GetWeakPtr(), document, native_event);
+  GetContentClient()->browser()->WillDispatchNativeInput(admission);
+}
