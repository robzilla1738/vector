+void RenderWidgetHostViewMac::RetireNativeInputBinding() {
+  native_input_ready_ = false;
+  native_input_binding_.clear();
+  native_input_document_ = {};
+  FinishNativeInputAdmissionWaiters(false);
+  if (ns_view_)
+    ns_view_->SetNativeInputDocumentBinding({}, base::DoNothing());
+}
+
+bool RenderWidgetHostViewMac::HasNativeInputAdmissionForDocument(
+    const content::WeakDocumentPtr& document) const {
+  auto* frame = document.AsRenderFrameHostIfValid();
+  return native_input_ready_ && ns_view_ && frame &&
+         native_input_document_.AsRenderFrameHostIfValid() == frame;
+}
+
+void RenderWidgetHostViewMac::AwaitNativeInputAdmissionForDocument(
+    const content::WeakDocumentPtr& document,
+    base::OnceCallback<void(bool)> callback) {
+  auto* frame = document.AsRenderFrameHostIfValid();
+  if (!frame || native_input_document_.AsRenderFrameHostIfValid() != frame ||
+      native_input_binding_.empty() || !ns_view_ ||
+      native_input_waiters_.size() >= 8) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (HasNativeInputAdmissionForDocument(document)) {
+    std::move(callback).Run(true);
+    return;
+  }
+  const auto id = base::UnguessableToken::Create().ToString();
+  auto waiter = std::make_unique<NativeInputAdmissionWaiter>();
+  waiter->binding = native_input_binding_;
+  waiter->document = document;
+  waiter->callback = std::move(callback);
+  waiter->timer.Start(FROM_HERE, base::Seconds(8), base::BindOnce(
+      &RenderWidgetHostViewMac::FinishNativeInputAdmissionWaiter,
+      weak_factory_.GetWeakPtr(), id));
+  native_input_waiters_.emplace(id, std::move(waiter));
+}
+
+void RenderWidgetHostViewMac::FinishNativeInputAdmissionWaiter(
+    const std::string& id) {
+  auto found = native_input_waiters_.find(id);
+  if (found == native_input_waiters_.end()) return;
+  auto waiter = std::move(found->second);
+  native_input_waiters_.erase(found);
+  waiter->timer.Stop();
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(waiter->callback), false));
+}
+
+void RenderWidgetHostViewMac::FinishNativeInputAdmissionWaiters(bool ready) {
+  auto waiters = std::move(native_input_waiters_);
+  native_input_waiters_.clear();
+  const auto weak = weak_factory_.GetWeakPtr();
+  for (auto& [id, waiter] : waiters) {
+    waiter->timer.Stop();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+            [](base::WeakPtr<RenderWidgetHostViewMac> view, bool ready,
+               std::string binding, content::WeakDocumentPtr document,
+               base::OnceCallback<void(bool)> callback) {
+              const bool admitted = ready && view &&
+                  view->native_input_binding_ == binding &&
+                  view->HasNativeInputAdmissionForDocument(document);
+              std::move(callback).Run(admitted);
+            }, weak, ready, std::move(waiter->binding), waiter->document,
+            std::move(waiter->callback)));
+  }
+}
+
+void RenderWidgetHostViewMac::PublishNativeInputBinding() {
+  auto* contents = WebContentsImpl::FromRenderWidgetHostImpl(host());
+  auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+  // Both post-commit entrypoints report one genuine document. Do not replace
+  // its pending associated ACK. Navigation/BFCache/bridge retirement clears
+  // the original binding before any new document can reach this fast path.
+  if (ns_view_ && frame && frame->IsActive() && frame->IsRenderFrameLive() &&
+      !native_input_binding_.empty() &&
+      native_input_document_.AsRenderFrameHostIfValid() == frame)
+    return;
+  RetireNativeInputBinding();
+  if (!ns_view_ || !frame || !frame->IsActive() || !frame->IsRenderFrameLive())
+    return;
+  native_input_binding_ = base::UnguessableToken::Create().ToString();
+  native_input_document_ = frame->GetWeakDocumentPtr();
+  ns_view_->SetNativeInputDocumentBinding(
+      native_input_binding_, base::BindOnce(
+          [](base::WeakPtr<RenderWidgetHostViewMac> view, std::string binding,
+             content::WeakDocumentPtr document) {
+            auto* frame = document.AsRenderFrameHostIfValid();
+            if (!view || !frame || binding != view->native_input_binding_ ||
+                view->native_input_document_.AsRenderFrameHostIfValid() != frame)
+              return;
+            auto complete = base::BindOnce(
+                [](base::WeakPtr<RenderWidgetHostViewMac> original_view,
+                   std::string original_binding,
+                   content::WeakDocumentPtr original_document) {
+                  auto* original_frame =
+                      original_document.AsRenderFrameHostIfValid();
+                  if (!original_view || !original_frame ||
+                      original_view->native_input_binding_ != original_binding ||
+                      original_view->native_input_document_
+                              .AsRenderFrameHostIfValid() != original_frame)
+                    return;
+                  auto* contents = WebContentsImpl::FromRenderWidgetHostImpl(
+                      original_view->host());
+                  if (!contents ||
+                      contents->GetPrimaryMainFrame() != original_frame ||
+                      !original_frame->IsActive() ||
+                      !original_frame->IsRenderFrameLive())
+                    return;
+                  original_view->native_input_ready_ = true;
+                  original_view->FinishNativeInputAdmissionWaiters(true);
+                }, view, binding, document);
+            std::move(complete).Run();
+          }, weak_factory_.GetWeakPtr(), native_input_binding_, native_input_document_));
+}
+
+void RenderWidgetHostViewMac::AdmitNativeInputEvent(
+    const std::string& binding,
+    const std::vector<uint8_t>& native_event_data) {
+  if (binding.empty() || binding != native_input_binding_ ||
+      !HasNativeInputAdmissionForDocument(native_input_document_) ||
+      native_event_data.empty() || native_event_data.size() > 8192)
+    return;
+  auto native_event = base::apple::OwnedNSEvent(
+      ui::EventFromData(native_event_data));
+  if (!native_event.Get())
+    return;
+  const auto type = [native_event.Get() type];
+  const bool keyboard = type == NSEventTypeKeyDown ||
+                        type == NSEventTypeKeyUp ||
+                        type == NSEventTypeFlagsChanged;
+  const bool mouse = type == NSEventTypeLeftMouseDown ||
+                     type == NSEventTypeRightMouseDown ||
+                     type == NSEventTypeOtherMouseDown ||
+                     type == NSEventTypeLeftMouseUp ||
+                     type == NSEventTypeRightMouseUp ||
+                     type == NSEventTypeOtherMouseUp ||
+                     type == NSEventTypeLeftMouseDragged ||
+                     type == NSEventTypeRightMouseDragged ||
+                     type == NSEventTypeOtherMouseDragged ||
+                     type == NSEventTypeScrollWheel;
+  if (!keyboard && !mouse)
+    return;
+  auto* widget = keyboard ? GetWidgetForKeyboardEvent() : host();
+  auto* contents = widget ? WebContentsImpl::FromRenderWidgetHostImpl(widget)
+                          : nullptr;
+  auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+  if (!widget || !contents || !frame ||
+      native_input_document_.AsRenderFrameHostIfValid() != frame)
+    return;
+  const auto document = native_input_document_;
+  // No generic WebInputEvent flags are promoted to person provenance. Chrome
+  // receives the original decoded OS event on the owned native view endpoint.
+  const NativePlatformInputAdmission admission(
+      contents->GetWeakPtr(), widget->GetWeakPtr(), document, native_event);
+  GetContentClient()->browser()->WillDispatchNativeInput(admission);
+}
