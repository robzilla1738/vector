+  NativeMouseLinkObservation& operator=(NativeMouseLinkObservation&&);
+  ~NativeMouseLinkObservation();
+  base::UnguessableToken nonce;
+  DocumentToken document;
+  std::string href;
+};
+// Main-thread input-dispatch stack only. No JS endpoint can create a capture or
+// nonce; nested input restores its original enclosing capture on retirement.
+class BLINK_COMMON_EXPORT NativeMouseLinkCapture final {
+ public:
+  explicit NativeMouseLinkCapture(base::UnguessableToken browser_nonce);
+  ~NativeMouseLinkCapture();
+  NativeMouseLinkCapture(const NativeMouseLinkCapture&) = delete;
+  NativeMouseLinkCapture& operator=(const NativeMouseLinkCapture&) = delete;
+  static std::optional<NativeMouseLinkObservation> CurrentObservation();
+  static void Record(DocumentToken original_document, std::string actual_href);
+  std::optional<NativeMouseLinkObservation> Take();
+
+ private:
+  static thread_local NativeMouseLinkCapture* current_;
+  raw_ptr<NativeMouseLinkCapture> previous_;
+  const base::UnguessableToken nonce_;
+  std::optional<NativeMouseLinkObservation> observed_;
+};
+}  // namespace blink
+#endif
