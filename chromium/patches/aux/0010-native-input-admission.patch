@@ -0,0 +1,48 @@
+// Copyright 2026 The Aux Authors. BSD-3-Clause.
+#include "third_party/blink/public/common/input/native_mouse_link_capture.h"
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/strings/string_util.h"
+namespace blink {
+NativeMouseLinkObservation::NativeMouseLinkObservation(
+    base::UnguessableToken value,
+    DocumentToken original,
+    std::string url)
+    : nonce(value), document(original), href(std::move(url)) {}
+NativeMouseLinkObservation::NativeMouseLinkObservation(
+    const NativeMouseLinkObservation&) = default;
+NativeMouseLinkObservation::NativeMouseLinkObservation(
+    NativeMouseLinkObservation&&) = default;
+NativeMouseLinkObservation& NativeMouseLinkObservation::operator=(
+    const NativeMouseLinkObservation&) = default;
+NativeMouseLinkObservation& NativeMouseLinkObservation::operator=(
+    NativeMouseLinkObservation&&) = default;
+NativeMouseLinkObservation::~NativeMouseLinkObservation() = default;
+thread_local NativeMouseLinkCapture* NativeMouseLinkCapture::current_ = nullptr;
+NativeMouseLinkCapture::NativeMouseLinkCapture(base::UnguessableToken nonce)
+    : previous_(current_), nonce_(nonce) {
+  current_ = this;
+}
+NativeMouseLinkCapture::~NativeMouseLinkCapture() {
+  CHECK_EQ(current_, this);
+  current_ = previous_;
+}
+std::optional<NativeMouseLinkObservation>
+NativeMouseLinkCapture::CurrentObservation() {
+  return current_ ? current_->observed_ : std::nullopt;
+}
+void NativeMouseLinkCapture::Record(DocumentToken document, std::string href) {
+  if (!current_ || current_->nonce_.is_empty() || current_->observed_ ||
+      href.empty() || href.size() > 65536 ||
+      href.find('\0') != std::string::npos || !base::IsStringUTF8(href)) {
+    return;
+  }
+  current_->observed_ =
+      NativeMouseLinkObservation{current_->nonce_, document, std::move(href)};
+}
+std::optional<NativeMouseLinkObservation> NativeMouseLinkCapture::Take() {
+  return std::move(observed_);
+}
+}  // namespace blink
