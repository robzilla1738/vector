+// The responder delegate sees the original modifier event before Chromium
+// suppresses KeyUp following a browser-handled RawKeyDown on the same host.
+bool WebUIBrowserWindow::HandleAuxTabPreviewKeyEvent(
+    const input::NativeWebKeyboardEvent& event,
+    content::WebContents* event_contents) {
+  NSEvent* physical = event.os_event.Get();
+  if (!physical || !aux_tab_preview_release_) return false;
+  auto* shell = GetWebUIBrowserUI();
+  auto* contents = aux_tab_preview_release_->contents.get();
+  NSWindow* owner = aux_tab_preview_release_->window.GetNativeNSWindow();
+  auto* frame = event_contents ? event_contents->GetFocusedFrame() : nullptr;
+  if (!owner || GetNativeWindow().GetNativeNSWindow() != owner ||
+      NSApp.keyWindow != owner || (physical.window && physical.window != owner) ||
+      !shell || !contents || shell->web_ui()->GetWebContents() != contents ||
+      !IsAuxShortcutDocument(contents, aux_tab_preview_release_->navigation_id,
+                             aux_tab_preview_release_->url) ||
+      event_contents != contents || !frame ||
+      content::WebContents::FromRenderFrameHost(frame) != contents) {
+    aux_tab_preview_release_.reset();
+    return false;
+  }
+  if (physical.type == NSEventTypeKeyDown) {
+    const auto accelerator = ui::GetAcceleratorFromNativeWebKeyboardEvent(event);
+    const auto found = aux_shortcuts_.find(accelerator);
+    if (accelerator.key_code() != ui::VKEY_TAB ||
+        !(accelerator.modifiers() & ui::EF_CONTROL_DOWN) ||
+        found == aux_shortcuts_.end() ||
+        (found->second.first != "tab-next" && found->second.first != "tab-previous"))
+      aux_tab_preview_release_.reset();
+    return false;
+  }
+  if (physical.type != NSEventTypeFlagsChanged ||
+      (physical.keyCode != 59 && physical.keyCode != 62) ||
+      (physical.modifierFlags & NSEventModifierFlagControl))
+    return false;
+  auto release = std::exchange(aux_tab_preview_release_, std::nullopt);
+  if (physical.timestamp < release->pressed_at) return false;
+  return shell->DispatchAuxControlRelease();
+}
