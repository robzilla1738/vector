+bool IsOwnerOnlyDirectory(const base::FilePath& path) {
+  struct stat metadata;
+  return lstat(path.value().c_str(), &metadata) == 0 &&
+         S_ISDIR(metadata.st_mode) && metadata.st_uid == geteuid() &&
+         (metadata.st_mode & 0777) == 0700;
+}
