+#include <cstdint>
+namespace aux {
+struct OwnedHeadlessSetupMessage {
+  uint32_t kind;
+  int32_t error;
+};
+inline constexpr uint32_t kOwnedHeadlessReady = 1;
+inline constexpr uint32_t kOwnedHeadlessFailed = 2;
+inline constexpr uint32_t kOwnedHeadlessSandboxApplied = 3;
