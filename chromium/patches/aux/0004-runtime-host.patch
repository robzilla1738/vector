+
+base::DictValue AuxRuntimeHost::HandleNativeCall(
+    const std::string& method,
+    const base::DictValue& params,
+    uint64_t connection_generation) {
+  if (method == "native.remoteDebuggingGet") {
+    const auto* token = params.FindString("token");
+    if (params.size() != 1 || !token || !RemoteDebuggingOwnerCurrent(*token, connection_generation))
+      return NativeFault("ref_stale", "Original Developers window retired");
+    return NativeResult(base::Value(RemoteDebuggingServer::AuxState()));
+  }
+  if (method == "native.credentialContext") return CredentialContext(params, connection_generation);
+  if (method == "native.credentialAdmit") return HandleCredentialAdmission(params, connection_generation);
+  if (method == "native.turnSourceContext") {
+    const auto* token = params.FindString("token");
+    auto found = token ? turn_contexts_.find(*token) : turn_contexts_.end();
+    if (params.size() != 1 || !token || found == turn_contexts_.end() ||
+        found->second.generation != connection_generation || !TurnContextCurrent(found->second)) {
+      if (found != turn_contexts_.end()) turn_contexts_.erase(found);
+      return NativeFault("ref_stale", "Original turn context retired");
+    }
+    auto* window = found->second.window.get();
+    const std::string window_id = base::NumberToString(window->GetSessionID().id());
+    std::string error;
+    std::optional<base::DictValue> snapshot;
+    if (profile_->IsOffTheRecord()) {
+      snapshot =
+          base::DictValue().Set("revision", 0).Set("layout", base::Value());
+    } else {
+      snapshot = aux::OrganizationStore::Snapshot(profile_, window_id, &error);
+    }
+    if (!snapshot) return NativeFault("backend_unavailable", error);
+    // UI initialization may project a first-Space default. It is not source authority
+    // until this original window has committed its actual organization state.
+    if (!profile_->IsOffTheRecord()) {
+      const auto* windows = profile_->GetPrefs()
+                                ->GetDict(aux::kOrganizationPref)
+                                .FindDict("windows");
+      if (!windows || !windows->FindDict(window_id))
+        snapshot->Set("layout", base::Value());
+    }
+    snapshot->Set("windowId", window_id);
+    auto* active = window->GetTabStripModel()->GetActiveWebContents();
+    snapshot->Set("activePageId", active ? base::Value(aux::PageIdentity::GetOrCreate(profile_, active)) : base::Value());
+    return NativeResult(base::Value(std::move(*snapshot)));
+  }
+  auto* egress = aux::EgressController::ForProfile(profile_);
+  if (method == "native.permissionRetire") {
+    const auto* tab = params.FindString("tabId");
+    const auto* batch = params.FindString("batchId");
+    const auto* reservation = params.FindString("reservationId");
+    if (!tab || tab->empty() || !batch || batch->empty() || !reservation || reservation->size() != 36)
+      return NativeFault("invalid_params", "Exact permission retirement identity is required");
+    auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+    auto* page = catalog ? catalog->FindPage(*tab) : nullptr;
+    if (page) {
+      auto* broker = aux::PermissionBroker::FromWebContents(page);
+      if (broker) broker->RetireReservation(*batch, *reservation);
+    }
+    return base::DictValue().Set("result", base::DictValue().Set("accepted", true));
+  }
+  if (method == "native.egressRunTerminal") {
+    const auto* run_id = params.FindString("runId");
+    if (!run_id || params.size() != 1)
+      return NativeFault("invalid_params", "An exact original terminal run is required");
+    return egress->RetireTerminalRun(*run_id, connection_generation);
+  }
+  if (method == "native.egressCheckRunResume") {
+    const auto* run_id = params.FindString("runId");
+    if (!run_id || params.size() != 1)
+      return NativeFault("invalid_params", "An exact original run is required");
+    return egress->CheckRunResume(*run_id, connection_generation);
+  }
+  if (method == "native.egressResumeRun") {
+    const auto* run_id = params.FindString("runId");
+    const auto* ticket_id = params.FindString("ticketId");
+    if (!run_id || !ticket_id || params.size() != 2)
+      return NativeFault("invalid_params", "Original run and local invocation are required");
+    return egress->ConsumeRunResume(*run_id, *ticket_id, connection_generation);
+  }
+  if (method == "native.egressResumePerson") {
+    const auto* page_id = params.FindString("pageId");
+    const auto* ticket_id = params.FindString("ticketId");
+    if (params.size() != 2 || !page_id || page_id->empty() || !ticket_id || ticket_id->empty())
+      return NativeFault("invalid_params", "An exact original held page and person invocation are required");
+    return egress->ConsumePersonResume(*page_id, *ticket_id, connection_generation);
+  }
+  if (method == "native.adoptSessionPage") {
+    const auto* token = params.FindString("token");
+    const auto* source = params.FindDict("source");
+    const auto* profile_id = params.FindString("profileId");
+    const auto* run_id = params.FindString("runId");
+    const auto* chain = params.FindList("ancestry");
+    auto original = token ? turn_contexts_.find(*token) : turn_contexts_.end();
+    if (!token || !source || !profile_id || !run_id || !chain ||
+        params.size() != (params.contains("taskId") ? 7u : 6u) ||
+        source->size() != 3 || *profile_id != ProfileId(profile_) ||
+        original == turn_contexts_.end() ||
+        original->second.generation != connection_generation ||
+        !TurnContextCurrent(original->second))
+      return NativeFault("permission_denied", "Exact original session window is required");
+    const auto* tab_id = source->FindString("tabId");
+    const auto* expected_url = source->FindString("expectedUrl");
+    const auto* document_token = source->FindString("documentToken");
+    auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+    BrowserWindowInterface* window = nullptr;
+    auto* page = tab_id && catalog ? catalog->FindPage(*tab_id, &window) : nullptr;
+    auto* frame = page ? page->GetPrimaryMainFrame() : nullptr;
+    const auto* identity = page ? aux::PageIdentity::FromWebContents(page) : nullptr;
+    if (!identity || identity->runtime_owned() || !frame || !frame->IsActive() || !frame->IsRenderFrameLive() || !expected_url || !document_token ||
+        window != original->second.window.get() || page->GetBrowserContext() != profile_ ||
+        page->GetLastCommittedURL().spec() != *expected_url ||
+        !page->GetLastCommittedURL().SchemeIsHTTPOrHTTPS())
+      return NativeFault("ref_stale", "Original borrowed session document changed");
+    return egress->AdoptSessionPage(page, params, connection_generation,
+        base::BindRepeating([](base::WeakPtr<AuxRuntimeHost> host, TurnContextOwner owner) {
+          return host && host->TurnContextCurrent(owner);
+        }, weak_factory_.GetWeakPtr(), original->second));
+  }
+  if (method == "native.egressContext") return egress->Context(params);
+  if (method == "native.egressInstall") return egress->Install(params);
+  if (method == "native.egressRevoke") return egress->Revoke(params);
+  const auto group = aux::AuxMethodRegistry::Get().RuntimeGroup(method);
+  if ((group == aux::AuxRuntimeMethodGroup::kCdp ||
+       group == aux::AuxRuntimeMethodGroup::kTabs ||
+       group == aux::AuxRuntimeMethodGroup::kPageControls) &&
+      !aux::TabCatalog::GetForProfile(profile_)) {
+    return NativeFault("backend_unavailable", "Tab catalog is unavailable");
+  }
+  switch (group) {
+    case aux::AuxRuntimeMethodGroup::kPower:
+      return HandleNativePowerCall(method, params);
+    case aux::AuxRuntimeMethodGroup::kLibrary:
+      return HandleNativeLibraryCall(method, params, connection_generation);
+    case aux::AuxRuntimeMethodGroup::kBlocking:
+      return HandleNativeBlockingCall(method, params, connection_generation);
+    case aux::AuxRuntimeMethodGroup::kCdp:
+      return HandleNativeCdpCall(method, params, connection_generation);
+    case aux::AuxRuntimeMethodGroup::kTabs:
+      return HandleNativeTabsCall(method, params, connection_generation);
+    case aux::AuxRuntimeMethodGroup::kPageControls:
+      return HandleNativePageControlsCall(method, params,
+                                          connection_generation);
+    case aux::AuxRuntimeMethodGroup::kAsync:
+    case aux::AuxRuntimeMethodGroup::kWorker:
+    case aux::AuxRuntimeMethodGroup::kNone:
+      return NativeFault("backend_unavailable",
+                         "Native method is unavailable in this build");
+  }
+  return NativeFault("backend_unavailable",
+                     "Native method is unavailable in this build");
+}
+
+void AuxRuntimeHost::HandleRecoveryOwnerAuth(
+    const base::DictValue& params,
+    std::shared_ptr<std::atomic_bool> cancelled,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  const std::string* purpose = params.FindString("purpose");
+  if (params.FindInt("version") != 1 || !purpose ||
+      (*purpose != "export" && *purpose != "restore") ||
+      profile_->IsOffTheRecord() || !runtime_connected_) {
+    std::move(callback).Run(NativeFault(
+        "permission_denied", "Protected recovery requires an active regular Profile"));
+    return;
+  }
+  if (recovery_auth_pending_) {
+    std::move(callback).Run(NativeFault(
+        "conflict", "Another recovery authentication is in progress"));
+    return;
+  }
+  recovery_authenticator_ = ChromeDeviceAuthenticatorFactory::GetForProfile(
+      profile_, device_reauth::DeviceAuthParams(
+                    base::Seconds(0),
+                    device_reauth::DeviceAuthSource::kPasswordManager));
+  if (!recovery_authenticator_ ||
+      !recovery_authenticator_->CanAuthenticateWithBiometricOrScreenLock()) {
+    std::move(callback).Run(NativeFault(
+        "permission_denied", "Device authentication is unavailable"));
+    return;
+  }
+  recovery_auth_pending_ = true;
+  const std::u16string message = *purpose == "export"
+      ? u"Approve creating an Aux recovery package"
+      : u"Approve restoring an Aux recovery package";
+  recovery_authenticator_->AuthenticateWithMessage(
+      message,
+      base::BindOnce(
+          [](base::WeakPtr<AuxRuntimeHost> host,
+             std::shared_ptr<std::atomic_bool> cancelled,
+             base::OnceCallback<void(base::DictValue)> callback,
+             bool approved) {
+            if (host) host->recovery_auth_pending_ = false;
+            if (!host || cancelled->load() || !approved ||
+                !host->runtime_connected_) {
+              std::move(callback).Run(NativeFault(
+                  "permission_denied", "Recovery device authentication was not approved"));
+              return;
+            }
+            base::DictValue result;
+            result.Set("approved", true);
+            std::move(callback).Run(NativeResult(base::Value(std::move(result))));
+          }, weak_factory_.GetWeakPtr(), std::move(cancelled),
+          std::move(callback)));
+}
+
+AuxRuntimeHost::Worker::Worker(
+    base::FilePath profile_path,
+    std::string profile_id,
+    std::string private_session_id,
+    scoped_refptr<base::SequencedTaskRunner> ui_runner,
+    base::WeakPtr<AuxRuntimeHost> owner)
+    : profile_path_(std::move(profile_path)),
+      profile_id_(std::move(profile_id)),
+      private_session_id_(std::move(private_session_id)),
+      ui_runner_(std::move(ui_runner)),
+      owner_(std::move(owner)) {}
+
+AuxRuntimeHost::Worker::~Worker() {
+  if (Disconnect())
+    return;
+  // Preserve directory ownership until the exact launched child exits, even if
+  // normal termination was not acknowledged. Never delete beneath a live child.
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(
+          [](base::Process process, std::shared_ptr<base::ScopedTempDir> private_data,
+             base::FilePath transport) {
+            if (process.IsValid() && !process.WaitForExit(nullptr)) {
+              if (private_data) private_data->Take();
+              LOG(ERROR) << "Aux runtime cleanup could not confirm child exit";
+              return;
+            }
+            const bool private_removed = !private_data || private_data.use_count() > 1 ||
+                !private_data->IsValid() || private_data->Delete();
+            const bool transport_removed =
+                transport.empty() || base::DeletePathRecursively(transport);
+            if (!private_removed || !transport_removed) {
+              LOG(ERROR) << "Aux runtime temporary directory cleanup failed";
+            }
+          },
+          std::move(process_), std::move(private_data_directory_),
+          socket_directory_.Take()));
+}
+
+bool AuxRuntimeHost::Worker::Connect(std::string* error) {
+  if (connection_fd_ >= 0) {
+    return true;
+  }
+  // This worker is already bound to the original Profile and child. Unix
+  // transport paths must not inherit arbitrary Profile path length: macOS
+  // temporary Profiles commonly exceed sockaddr_un::sun_path by themselves.
+  // The short POSIX temp root contains only a fresh private worker-owned
+  // directory, never a shared socket or a Profile/data-directory fallback.
+  if (!Disconnect()) {
+    *error = "Previous runtime transport cleanup is not acknowledged";
+    return false;
+  }
+  private_startup_phase_.clear();
+  if (!private_session_id_.empty()) {
+    private_data_directory_ = std::shared_ptr<base::ScopedTempDir>(new base::ScopedTempDir(), [](base::ScopedTempDir* directory) {
+      base::ThreadPool::PostTask(FROM_HERE, {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+          base::BindOnce([](std::unique_ptr<base::ScopedTempDir>) {}, std::unique_ptr<base::ScopedTempDir>(directory)));
+    });
+  }
+  if (!private_session_id_.empty() &&
+      (!private_data_directory_->CreateUniqueTempDirUnderPath(
+           base::FilePath("/tmp"), "aux-private-") ||
+       !IsOwnerOnlyDirectory(private_data_directory_->GetPath()))) {
+    *error = "Cannot create an owner-only private runtime directory";
+    Disconnect();
+    return false;
+  }
+  if (!socket_directory_.CreateUniqueTempDirUnderPath(
+          base::FilePath("/tmp"), "aux-runtime-") ||
+      !IsOwnerOnlyDirectory(socket_directory_.GetPath())) {
+    *error = "Cannot create an owner-only runtime transport directory";
+    Disconnect();
+    return false;
+  }
+  std::array<uint8_t, 32> random_bytes;
+  base::RandBytes(random_bytes);
+  token_ = base::HexEncode(random_bytes);
+  socket_path_ = socket_directory_.GetPath().Append("host.sock");
+  if (socket_path_.value().size() >= sizeof(sockaddr_un{}.sun_path)) {
+    *error = "Native runtime transport path exceeds the Unix socket bound";
+    Disconnect();
+    return false;
+  }
+
+  listener_fd_ = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (listener_fd_ < 0) {
+    *error = "Cannot create the runtime socket";
+    Disconnect();
+    return false;
+  }
+  if (fcntl(listener_fd_, F_SETFD, FD_CLOEXEC) != 0) {
+    *error = "Cannot secure the runtime listener descriptor";
+    Disconnect();
+    return false;
+  }
+  sockaddr_un address = {};
+  address.sun_family = AF_UNIX;
+  const std::string& path = socket_path_.value();
+  base::span(address.sun_path).first(path.size()).copy_from(base::span(path));
+  base::span(address.sun_path)[path.size()] = '\0';
+  if (bind(listener_fd_, reinterpret_cast<sockaddr*>(&address),
+           sizeof(address)) != 0 ||
+      chmod(socket_path_.value().c_str(), 0600) != 0 ||
+      listen(listener_fd_, 1) != 0) {
+    *error = "Cannot bind the private runtime socket";
+    Disconnect();
+    return false;
+  }
+
+  base::FilePath executable;
+  if (!base::PathService::Get(base::FILE_EXE, &executable)) {
+    *error = "Cannot find the Aux application bundle";
+    Disconnect();
+    return false;
+  }
+  const base::FilePath contents = executable.DirName().DirName();
+  const base::FilePath node = contents.Append("Helpers").Append("Aux Runtime");
+  const base::FilePath entry = contents.Append("Resources")
+                                   .Append("aux-runtime")
+                                   .Append("dist")
+                                   .Append("main.js");
+  if (!base::PathExists(node) || !base::PathExists(entry)) {
+    *error = "The signed Aux Runtime helper is missing from the app bundle";
+    Disconnect();
+    return false;
+  }
+  const base::FilePath icu_directory = contents.Append("Resources")
+                                          .Append("aux-runtime")
+                                          .Append("vendor")
+                                          .Append("icu");
+  const base::FilePath icu_data = icu_directory.Append("icudt78l.dat");
+  base::File::Info icu_info;
+  if (!base::GetFileInfo(icu_data, &icu_info) || icu_info.is_directory ||
+      base::IsLink(icu_data) || icu_info.size != 33105536) {
+    *error = "The pinned Aux Runtime ICU data is missing from the app bundle";
+    Disconnect();
+    return false;
+  }
+  base::CommandLine command(node);
+  command.AppendArg("--icu-data-dir=" + icu_directory.value());
+  command.AppendArgPath(entry);
+  base::LaunchOptions options;
+  base::ScopedFD private_output;
+  if (!private_session_id_.empty()) {
+    private_output.reset(open("/dev/null", O_WRONLY | O_CLOEXEC));
+    if (!private_output.is_valid()) {
+      *error = "Cannot isolate private runtime output";
+      Disconnect();
+      return false;
+    }
+    options.fds_to_remap.emplace_back(private_output.get(), STDOUT_FILENO);
+    options.fds_to_remap.emplace_back(private_output.get(), STDERR_FILENO);
+  }
+  options.environment["AUX_HOST_SOCKET"] = socket_path_.value();
+  options.environment["AUX_HOST_TOKEN"] = token_;
+  const std::string expected_generation =
+      std::to_string(connection_generation_ + 1);
+  options.environment["AUX_HOST_GENERATION"] = expected_generation;
+  options.environment["AUX_BROWSER_PROFILE_ID"] = profile_id_;
+  options.environment["AUX_PRIVATE_SESSION"] = private_session_id_;
+  options.environment["AUX_PRIVATE_SETTINGS_PATH"] = "";
+  options.environment["AUX_DATA_DIR"] =
+      (private_session_id_.empty() ? profile_path_
+                                   : private_data_directory_->GetPath())
+          .Append("Aux Runtime Data")
+          .value();
+  if (!private_session_id_.empty()) {
+    options.environment["AUX_PRIVATE_SETTINGS_PATH"] =
+        profile_path_.Append("Aux Runtime Data")
+            .Append("settings.json")
+            .value();
+    options.environment["AUX_LOAD_DOTENV"] = "0";
+  }
+  process_ = base::LaunchProcess(command, options);
+  if (!process_.IsValid()) {
+    *error = "Cannot start the Aux Runtime helper";
+    Disconnect();
+    return false;
+  }
+
+  pollfd pending = {listener_fd_, POLLIN, 0};
+  if (poll(&pending, 1, kConnectTimeoutMs) != 1 ||
+      !(pending.revents & POLLIN)) {
+    *error = "Aux Runtime did not connect in time";
+    Disconnect();
+    return false;
+  }
+  connection_fd_ = accept(listener_fd_, nullptr, nullptr);
+  int no_sigpipe = 1;
+  uid_t peer_uid;
+  gid_t peer_gid;
+  pid_t peer_pid = -1;
+  socklen_t peer_pid_size = sizeof(peer_pid);
+  if (connection_fd_ < 0 || fcntl(connection_fd_, F_SETFD, FD_CLOEXEC) != 0 ||
+      setsockopt(connection_fd_, SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe,
+                 sizeof(no_sigpipe)) != 0 ||
+      getpeereid(connection_fd_, &peer_uid, &peer_gid) != 0 ||
+      peer_uid != geteuid() ||
+      getsockopt(connection_fd_, SOL_LOCAL, LOCAL_PEERPID,
+                 &peer_pid, &peer_pid_size) != 0 ||
+      peer_pid_size != sizeof(peer_pid) ||
+      peer_pid != process_.Pid()) {
+    *error = "Aux Runtime socket peer is not the launched helper";
+    Disconnect();
+    return false;
+  }
+  std::array<char, PROC_PIDPATHINFO_MAXSIZE> peer_path = {};
+  std::array<char, PROC_PIDPATHINFO_MAXSIZE> expected_path = {};
+  if (proc_pidpath(peer_pid, peer_path.data(), peer_path.size()) <= 0 ||
+      !realpath(node.value().c_str(), expected_path.data()) ||
+      std::string(peer_path.data()) != expected_path.data()) {
+    *error = "Aux Runtime socket peer executable changed";
+    Disconnect();
+    return false;
+  }
+  std::string hello_frame;
+  if (!ReadFrame(&hello_frame, kConnectTimeoutMs)) {
+    *error = "Aux Runtime did not authenticate";
+    Disconnect();
+    return false;
+  }
+  const auto hello = base::JSONReader::Read(hello_frame, base::JSON_PARSE_RFC);
+  const base::DictValue* data = hello ? hello->GetIfDict() : nullptr;
+  const std::string* kind = data ? data->FindString("kind") : nullptr;
+  const std::string* protocol = data ? data->FindString("protocol") : nullptr;
+  const std::string* nonce = data ? data->FindString("nonce") : nullptr;
+  const std::string* presented_token =
+      data ? data->FindString("token") : nullptr;
+  const std::string* generation =
+      data ? data->FindString("generation") : nullptr;
+  if (!kind || *kind != "hello" || !protocol || *protocol != "aux-host-v1" ||
+      !nonce || nonce->size() != 64 ||
+      !std::all_of(nonce->begin(), nonce->end(), [](unsigned char ch) {
+        return std::isxdigit(ch);
+      }) || !generation || *generation != expected_generation ||
+      !presented_token ||
+      *presented_token != token_) {
+    *error = "Aux Runtime authentication failed";
+    Disconnect();
+    return false;
+  }
+  base::DictValue ack;
+  ack.Set("kind", "hello-ack");
+  ack.Set("protocol", "aux-host-v1");
+  ack.Set("nonce", *nonce);
+  ack.Set("generation", expected_generation);
+  const auto ack_json = base::WriteJson(ack);
+  if (!ack_json || !SendFrame(*ack_json)) {
+    *error = "Cannot acknowledge the Aux Runtime connection";
+    Disconnect();
+    return false;
+  }
+  close(listener_fd_);
+  listener_fd_ = -1;
+  ++connection_generation_;
+  if (!private_session_id_.empty())
+    private_startup_phase_ = "connected";
+  // Same sequenced UI endpoint: admission precedes every posted native request.
+  ui_runner_->PostTask(FROM_HERE, base::BindOnce(
+      &AuxRuntimeHost::NativeConnectionPublished, owner_, connection_generation_, private_data_directory_));
+  // Authentication may have read ahead into the first runtime request.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&Worker::DrainSocket, weak_factory_.GetWeakPtr()));
+  return true;
+}
+
+bool AuxRuntimeHost::Worker::Disconnect() {
+  socket_watcher_.reset();
+  request_deadline_timer_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  if (connection_fd_ >= 0 && connection_generation_)
+    ui_runner_->PostTask(FROM_HERE, base::BindOnce(
+        &AuxRuntimeHost::NativeConnectionRetired, owner_, connection_generation_));
+  if (connection_fd_ >= 0) {
+    close(connection_fd_);
+    connection_fd_ = -1;
+  }
+  if (listener_fd_ >= 0) {
+    close(listener_fd_);
+    listener_fd_ = -1;
+  }
+  // Run on the dedicated sequenced transport worker, never browser UI. Do
+  // not discard the original child handle or directory before its actual exit
+  // and filesystem cleanup have been acknowledged. Failed cleanup is retained
+  // as debt and blocks a subsequent connection; no new child adopts this socket.
+  const bool child_stopped = !process_.IsValid() ||
+      process_.WaitForExitWithTimeout(base::TimeDelta(), nullptr) ||
+      process_.Terminate(0, true);
+  if (child_stopped && process_.IsValid()) process_.Close();
+  bool socket_removed = socket_path_.empty();
+  if (!socket_removed && (unlink(socket_path_.value().c_str()) == 0 || errno == ENOENT)) {
+    socket_path_.clear(); socket_removed = true;
+  }
+  const bool directory_removed = child_stopped && socket_removed &&
+      (!socket_directory_.IsValid() || socket_directory_.Delete());
+  const bool private_data_removed =
+      child_stopped &&
+      (!private_data_directory_ || private_data_directory_.use_count() > 1 ||
+       !private_data_directory_->IsValid() || private_data_directory_->Delete());
+  if (private_data_removed) private_data_directory_.reset();
+  token_.clear();
+  read_buffer_.clear();
+  auto pending = std::move(pending_requests_);
+  pending_requests_.clear();
+  const std::string disconnected =
+      private_startup_phase_.empty()
+          ? "The runtime connection ended before this request was acknowledged"
+          : "Private AI disconnected after the " + private_startup_phase_ +
+                " startup stage.";
+  for (auto& [id, request] : pending) {
+    std::move(request.callback)
+        .Run({false, "", "operation_uncertain", disconnected});
+  }
+  return child_stopped && socket_removed && directory_removed &&
+         private_data_removed;
+}
+
+bool AuxRuntimeHost::Worker::SendFrame(const std::string& frame) {
+  if (frame.size() >= kMaxFrameBytes || connection_fd_ < 0) {
+    return false;
+  }
+  const std::string line = frame + "\n";
+  size_t offset = 0;
+  while (offset < line.size()) {
+    const auto remaining = base::span(line).subspan(offset);
+    const ssize_t written =
+        write(connection_fd_, remaining.data(), remaining.size());
+    if (written <= 0) {
+      if (written < 0 && errno == EINTR) {
+        continue;
+      }
+      return false;
+    }
+    offset += written;
+  }
+  return true;
+}
+
+bool AuxRuntimeHost::Worker::ReadFrame(std::string* frame, int timeout_ms) {
+  while (true) {
+    const size_t newline = read_buffer_.find('\n');
+    if (newline != std::string::npos) {
+      *frame = read_buffer_.substr(0, newline);
+      read_buffer_.erase(0, newline + 1);
+      return true;
+    }
+    if (read_buffer_.size() >= kMaxFrameBytes) {
+      return false;
+    }
+    pollfd pending = {connection_fd_, POLLIN, 0};
+    if (poll(&pending, 1, timeout_ms) != 1 || !(pending.revents & POLLIN)) {
+      return false;
+    }
+    std::array<char, 4096> chunk;
+    const ssize_t count = read(connection_fd_, chunk.data(), chunk.size());
+    if (count <= 0) {
+      if (count < 0 && errno == EINTR) {
+        continue;
+      }
+      return false;
+    }
+    read_buffer_.append(chunk.data(), count);
+  }
+}
+
+base::DictValue AuxRuntimeHost::Worker::DispatchNative(
+    const std::string& method,
+    base::DictValue params) {
+  auto state = std::make_shared<NativeReplyState>();
+  auto foundation_admission =
+      std::make_shared<std::atomic<aux::FoundationAdmission>>(
+          aux::FoundationAdmission::kPending);
+  auto copilot_admission =
+      std::make_shared<std::atomic<aux::OwnedHeadlessAdmission>>(
+          aux::OwnedHeadlessAdmission::kPending);
+  ui_runner_->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<AuxRuntimeHost> owner, std::string method,
+                        base::DictValue params, uint64_t connection_generation,
+                        std::shared_ptr<NativeReplyState> state,
+                        std::shared_ptr<std::atomic<aux::FoundationAdmission>>
+                            foundation_admission,
+                        std::shared_ptr<std::atomic<
+                            aux::OwnedHeadlessAdmission>> copilot_admission) {
+#if BUILDFLAG(IS_MAC)
+                       if (owner &&
+                           method.starts_with("native.foundationModels")) {
+                         owner->HandleNativeFoundationCall(
+                             method, params, connection_generation,
+                             foundation_admission,
+                             base::BindOnce(
+                                 [](std::shared_ptr<NativeReplyState> state,
+                                    base::DictValue reply) {
+                                   state->reply = std::move(reply);
+                                   state->ready.Signal();
+                                 },
+                                 state));
+                         return;
+                       }
+#endif
+                       if (owner && method.starts_with("native.copilot")) {
+                         owner->HandleNativeCopilotCall(
+                             method, params, connection_generation,
+                             copilot_admission,
+                             base::BindOnce(
+                                 [](std::shared_ptr<NativeReplyState> state,
+                                    base::DictValue reply) {
+                                   state->reply = std::move(reply);
+                                   state->ready.Signal();
+                                 },
+                                 state));
+                         return;
+                       }
+                       if (owner &&
+                           method.starts_with("native.browserImport")) {
+                         owner->HandleNativeBrowserImportCall(method, params, connection_generation, state->cancelled,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method.starts_with("native.project")) {
+                         owner->HandleNativeProjectCall(method, params, connection_generation,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.privateProvider") {
+                         owner->HandlePrivateProviderCall(params, connection_generation,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && (method == "native.cloudPreview" || method == "native.cloudPreviewClose")) {
+                         owner->HandleNativeCloudPreviewCall(method, params, connection_generation,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method.starts_with("native.terminal")) {
+                         owner->HandleNativeTerminalCall(method, params, connection_generation,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.cdpAttach") {
+                         owner->HandleNativeCdpAttachment(params, connection_generation, state->cancelled,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.cdpTakeNavigationReceipt") {
+                         owner->HandleNativeCdpNavigationReceipt(params, connection_generation, state->cancelled,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.createAgentPage") {
+                         owner->HandleNativeCreatorCreateCall(params, connection_generation, state->cancelled,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.closeCreatedPage") {
+                         owner->HandleNativeCreatorCloseCall(params, connection_generation, state->cancelled,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state, base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && (method == "native.personRead" || method == "native.personReadContext" || method == "native.personCapture")) {
+                         owner->HandleNativePersonReadCall(method, params, connection_generation,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state,
+                                               base::DictValue reply) {
+                               state->reply = std::move(reply);
+                               state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && (method == "native.recorderStart" ||
+                                     method == "native.recorderDrain" ||
+                                     method == "native.recorderStop")) {
+                         owner->HandleNativeRecorderCall(method, params, connection_generation,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state,
+                                               base::DictValue reply) {
+                               state->reply = std::move(reply);
+                               state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.setCookies") {
+                         aux::ImportCookies(owner->profile_, params, base::BindOnce(
+                             [](std::shared_ptr<NativeReplyState> state,
+                                base::DictValue reply) {
+                               state->reply = std::move(reply);
+                               state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && (method == "native.downloadRenameReceipts" ||
+                                     method == "native.downloadNamingCandidate" ||
+                                     method == "native.downloadPreviewText" ||
+                                     method == "native.renameDownload" ||
+                                     method == "native.undoDownloadRename")) {
+                         owner->HandleDownloadNamingRequest(method, params,
+                             base::BindOnce([](std::shared_ptr<NativeReplyState> state,
+                                              base::DictValue reply) {
+                               state->reply = std::move(reply); state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.captureReadablePage") {
+                         owner->HandleReadableCapture(params, base::BindOnce(
+                             [](std::shared_ptr<NativeReplyState> state,
+                                base::DictValue reply) {
+                               state->reply = std::move(reply);
+                               state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.fillSavedPassword") {
+                         owner->HandleCredentialFill(params, state->cancelled,
+                             base::BindOnce(
+                             [](std::shared_ptr<NativeReplyState> state,
+                                base::DictValue reply) {
+                               state->reply = std::move(reply);
+                               state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.recoveryOwnerAuth") {
+                         owner->HandleRecoveryOwnerAuth(params, state->cancelled,
+                             base::BindOnce(
+                                 [](std::shared_ptr<NativeReplyState> state,
+                                    base::DictValue reply) {
+                                   state->reply = std::move(reply);
+                                   state->ready.Signal();
+                                 }, state));
+                         return;
+                       }
+                       if (owner && method == "native.zapInstallStylesheet") {
+                         owner->HandleZapInstall(params, base::BindOnce(
+                             [](std::shared_ptr<NativeReplyState> state,
+                                base::DictValue reply) {
+                               state->reply = std::move(reply);
+                               state->ready.Signal();
+                             }, state));
+                         return;
+                       }
+                       if (owner && method == "native.findInPage") {
+                         owner->native_find_->Find(params, base::BindOnce(
+                             [](std::shared_ptr<NativeReplyState> state,
+                                base::DictValue reply) {
+                               state->reply = std::move(reply);
+                               state->ready.Signal();
+                             }, state), true, owner.get());
+                         return;
+                       }
+                       if (owner && method == "native.remoteDebuggingSet") {
+                         const auto* token = params.FindString("token");
+                         const auto enabled = params.FindBool("enabled");
+                         if (params.size() != 2 || !token || !enabled ||
+                             state->cancelled->load(std::memory_order_acquire) ||
+                             !owner->RemoteDebuggingOwnerCurrent(*token, connection_generation)) {
+                           state->reply = NativeFault("ref_stale", "Original Developers window retired");
+                           state->ready.Signal();
+                           return;
+                         }
+                         RemoteDebuggingServer::SetAuxEnabled(*enabled, base::BindOnce(
+                             [](base::WeakPtr<AuxRuntimeHost> owner,
+                                std::shared_ptr<NativeReplyState> state,
+                                std::string token, uint64_t connection, bool settled) {
+                               if (!owner || state->cancelled->load(std::memory_order_acquire) ||
+                                   !owner->RemoteDebuggingOwnerCurrent(token, connection))
+                                 state->reply = NativeFault("ref_stale", "Original Developers window retired");
+                               else if (!settled)
+                                 state->reply = NativeFault("backend_unavailable", "Remote debugging listener did not reach its requested state");
+                               else
+                                 state->reply = NativeResult(base::Value(RemoteDebuggingServer::AuxState()));
+                               state->ready.Signal();
+                             }, owner, state, *token, connection_generation));
+                         return;
+                       }
+                       if (owner && (method == "native.contentBlockState" || method == "native.contentBlockCommit")) {
+                         if (!owner->DeviceConfirmationConnectionCurrent(connection_generation) || state->cancelled->load()) {
+                           state->reply = NativeFault("conflict", "The original native connection retired");
+                           state->ready.Signal();
+                           return;
+                         }
+                         auto* blocker = aux::ContentBlockingController::ForProfile(owner->profile_);
+                         owner->native_content_blocker_ = blocker->GetWeakPtr();
+                         auto current = base::BindRepeating([](base::WeakPtr<AuxRuntimeHost> owner,
+                             uint64_t generation, std::shared_ptr<std::atomic_bool> cancelled) {
+                           return owner && !cancelled->load() && owner->DeviceConfirmationConnectionCurrent(generation);
+                         }, owner, connection_generation, state->cancelled);
+                         auto reply = base::BindOnce([](std::shared_ptr<NativeReplyState> state,
+                             base::RepeatingCallback<bool()> current, std::optional<base::DictValue> result, std::string error) {
+                           state->reply = result && current.Run() ? NativeResult(base::Value(std::move(*result)))
+                               : NativeFault("conflict", error.empty() ? "The original native connection retired" : std::move(error));
+                           state->ready.Signal();
+                         }, state, current);
+                         if (method == "native.contentBlockState")
+                           blocker->State(std::move(reply));
+                         else
+                           blocker->Commit(params, connection_generation,
+                                           std::move(current),
+                                           std::move(reply));
+                         return;
+                       }
+                       if (owner && (method == "native.webmcpList" ||
+                                     method == "native.webmcpCall")) {
+                         auto done = base::BindOnce(
+                             [](std::shared_ptr<NativeReplyState> state,
+                                base::DictValue reply) {
+                               state->reply = std::move(reply);
+                               state->ready.Signal();
+                             },
+                             state);
+                         if (method == "native.webmcpList") {
+                           aux::ListWebmcpTools(owner->profile_, params,
+                                                std::move(done));
+                         } else {
+                           aux::CallWebmcpTool(owner->profile_, params,
+                                               std::move(done));
+                         }
+                         return;
+                       }
+                       if (owner && (method == "native.historyClear" ||
+                                     method == "native.historyImport" ||
+                                     method == "native.historyRemove")) {
+                         owner->HandleHistoryMutation(
+                             method, params, base::BindOnce(
+                                 [](std::shared_ptr<NativeReplyState> state,
+                                    base::DictValue reply) {
+                                   state->reply = std::move(reply);
+                                   state->ready.Signal();
+                                 }, state));
+                         return;
+                       }
+                       state->reply =
+                           owner ? owner->HandleNativeCall(
+                                       method, params, connection_generation)
+                                 : NativeFault(
+                                       "backend_unavailable",
+                                       "The owning browser Profile closed");
+                       state->ready.Signal();
+                     },
+                     owner_, method, std::move(params), connection_generation_,
+                     state, foundation_admission, copilot_admission));
+  if (!state->ready.TimedWait(
+          base::Seconds(method == "native.recoveryOwnerAuth"   ? 120
+                        : method == "native.fillSavedPassword" ? 60
+                                                               : 30))) {
+    state->cancelled->store(true);
+    foundation_admission->store(aux::FoundationAdmission::kRetired,
+                                std::memory_order_release);
+    copilot_admission->exchange(aux::OwnedHeadlessAdmission::kRetired,
+                                std::memory_order_acq_rel);
+    return NativeFault("backend_unavailable",
+                       "The browser did not answer the native request");
+  }
+  return std::move(state->reply);
+}
