+base::DictValue AuxRuntimeHost::CallBookmarksForUser(
+    const std::string& method,
+    const base::DictValue& params) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return profile_library_
+             ? profile_library_->BookmarkCall(method, params)
+             : NativeFault("forbidden",
+                           "Private windows do not persist bookmarks");
+}
+
+void AuxRuntimeHost::CallHistoryForUser(
+    const std::string& method,
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback,
+    base::RepeatingCallback<bool()> current) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile_library_) {
+    std::move(callback).Run(NativeFault(
+        "forbidden", "Private windows do not expose saved history"));
+    return;
+  }
+  profile_library_->HistoryCall(method, params, std::move(callback),
+                                std::move(current));
+}
