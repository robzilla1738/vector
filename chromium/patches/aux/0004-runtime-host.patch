+// Copyright 2026 The Aux Authors. BSD-style license in LICENSE.
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_FOUNDATION_MODELS_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_FOUNDATION_MODELS_H_
+
+#include <atomic>
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted_delete_on_sequence.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_observer.h"
+class ScopedProfileKeepAlive;
+class ScopedKeepAlive;
+namespace aux {
+enum class FoundationAdmission { kPending, kAccepted, kRetired };
+std::string NativeFoundationAvailability();
+// All entry points, observations and Swift completions run on the UI sequence.
+class NativeFoundationRequest final
+    : public base::RefCountedDeleteOnSequence<NativeFoundationRequest>,
+      public content::WebContentsObserver {
+ public:
+  NativeFoundationRequest(
+      content::WebContents* original,
+      std::string token,
+      std::string request_id,
+      uint64_t generation,
+      base::RepeatingCallback<bool()> current,
+      std::shared_ptr<std::atomic<FoundationAdmission>> admission);
+  bool Start(const std::string& instructions,
+             const std::string& prompt,
+             int maximum_tokens,
+             std::shared_ptr<std::atomic<FoundationAdmission>> admission,
+             std::unique_ptr<ScopedProfileKeepAlive> lease);
+  void Retire();
+  base::DictValue Receipt(const char* state) const;
+  base::DictValue Read();
+  bool executed() const { return executed_; }
+  bool releasable() const { return joined_ && retired_ && !current_.Run(); }
+  const std::string& token() const { return token_; }
+  const std::string& task_id() const { return task_id_; }
+  uint64_t generation() const { return generation_; }
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<NativeFoundationRequest>;
+  friend class base::DeleteHelper<NativeFoundationRequest>;
+  ~NativeFoundationRequest() override;
+  class SwiftState;
+  void CheckSource();
+  void Complete(std::string text, std::string error);
+  void PrimaryPageChanged(content::Page& page) override;
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override;
+  void WebContentsDestroyed() override;
+  const std::string token_;
+  const std::string request_id_;
+  const std::string task_id_;
+  const uint64_t generation_;
+  const base::RepeatingCallback<bool()> current_;
+  std::shared_ptr<std::atomic<FoundationAdmission>> admission_;
+  std::unique_ptr<SwiftState> swift_;
+  std::unique_ptr<ScopedProfileKeepAlive> profile_lease_;
+  std::unique_ptr<ScopedKeepAlive> app_lease_;
+  base::RepeatingTimer source_timer_;
+  bool executed_ = false;
+  bool joined_ = true;
+  bool retired_ = false;
+  std::string text_;
+  std::string error_;
+};
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/aux/native_foundation_models.mm b/chrome/browser/ui/aux/native_foundation_models.mm
new file mode 100644
index 0000000..7fbb60f
--- /dev/null
+++ b/chrome/browser/ui/aux/native_foundation_models.mm
@@ -0,0 +1,182 @@
+// Copyright 2026 The Aux Authors. BSD-style license in LICENSE.
+#include "chrome/browser/ui/aux/native_foundation_models.h"
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
+#include "chrome/browser/ui/aux/foundation_models_swift.h"
+#include "components/keep_alive_registry/keep_alive_types.h"
+#include "components/keep_alive_registry/scoped_keep_alive.h"
+#include "content/public/browser/browser_thread.h"
+
+namespace aux {
+class NativeFoundationRequest::SwiftState {
+ public:
+  SwiftState();
+  ~SwiftState();
+  AuxFoundationRequest* __strong request;
+};
+NativeFoundationRequest::SwiftState::SwiftState()
+    : request([[AuxFoundationRequest alloc] init]) {}
+NativeFoundationRequest::SwiftState::~SwiftState() = default;
+std::string NativeFoundationAvailability() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return base::SysNSStringToUTF8([AuxFoundationRequest availability]);
+}
+NativeFoundationRequest::NativeFoundationRequest(
+    content::WebContents* original,
+    std::string token,
+    std::string request_id,
+    uint64_t generation,
+    base::RepeatingCallback<bool()> current,
+    std::shared_ptr<std::atomic<FoundationAdmission>> admission)
+    : base::RefCountedDeleteOnSequence<NativeFoundationRequest>(
+          base::SequencedTaskRunner::GetCurrentDefault()),
+      content::WebContentsObserver(original),
+      token_(std::move(token)),
+      request_id_(std::move(request_id)),
+      task_id_(base::UnguessableToken::Create().ToString()),
+      generation_(generation),
+      current_(std::move(current)),
+      admission_(std::move(admission)) {
+  source_timer_.Start(FROM_HERE, base::Milliseconds(100), this,
+                      &NativeFoundationRequest::CheckSource);
+}
+NativeFoundationRequest::~NativeFoundationRequest() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  CHECK(joined_);
+}
+bool NativeFoundationRequest::Start(
+    const std::string& instructions,
+    const std::string& prompt,
+    int maximum_tokens,
+    std::shared_ptr<std::atomic<FoundationAdmission>> admission,
+    std::unique_ptr<ScopedProfileKeepAlive> lease) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (executed_ || retired_ || !current_.Run() || !g_browser_process ||
+      g_browser_process->IsShuttingDown() ||
+      admission_->load(std::memory_order_acquire) !=
+          FoundationAdmission::kPending) {
+    return false;
+  }
+  // Allocate original resources before acceptance; no awaited work separates
+  // this CAS from dispatch. Timeout/retirement shares THIS execute RPC word.
+  auto swift = std::make_unique<SwiftState>();
+  FoundationAdmission expected = FoundationAdmission::kPending;
+  if (!admission->compare_exchange_strong(expected,
+                                          FoundationAdmission::kAccepted,
+                                          std::memory_order_acq_rel)) {
+    return false;
+  }
+  admission_ = std::move(admission);
+  profile_lease_ = std::move(lease);
+  app_lease_ = std::make_unique<ScopedKeepAlive>(
+      KeepAliveOrigin::AUX_FOUNDATION_MODELS, KeepAliveRestartOption::DISABLED);
+  swift_ = std::move(swift);
+  executed_ = true;
+  joined_ = false;
+  // The terminal completion retains this SAME original owner, including both
+  // leases, through cancellation and host destruction. No UI-thread wait.
+  scoped_refptr<NativeFoundationRequest> original(this);
+  [swift_->request beginWithInstructions:base::SysUTF8ToNSString(instructions)
+      prompt:base::SysUTF8ToNSString(prompt)
+      maximumResponseTokens:maximum_tokens
+      current:^BOOL {
+        return !original->retired_ && original->current_.Run() &&
+               original->admission_->load(std::memory_order_acquire) ==
+                   FoundationAdmission::kAccepted;
+      }
+      completion:^(NSString* text, NSString* error) {
+        original->Complete(
+            text ? base::SysNSStringToUTF8(text) : std::string(),
+            error ? base::SysNSStringToUTF8(error) : std::string());
+      }];
+  source_timer_.Start(FROM_HERE, base::Milliseconds(100), this,
+                      &NativeFoundationRequest::CheckSource);
+  return true;
+}
+void NativeFoundationRequest::CheckSource() {
+  if (!current_.Run() ||
+      (admission_ && admission_->load(std::memory_order_acquire) ==
+                         FoundationAdmission::kRetired)) {
+    Retire();
+  }
+}
+void NativeFoundationRequest::Retire() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  retired_ = true;
+  text_.clear();
+  if (joined_) {
+    source_timer_.Stop();
+  }
+  if (admission_) {
+    admission_->store(FoundationAdmission::kRetired, std::memory_order_release);
+  }
+  if (swift_) {
+    [swift_->request retire];
+  }
+}
+void NativeFoundationRequest::Complete(std::string text, std::string error) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  // Swift has awaited the original generation Task.result before this callback.
+  joined_ = true;
+  source_timer_.Stop();
+  if (!retired_ && current_.Run() &&
+      admission_->load(std::memory_order_acquire) ==
+          FoundationAdmission::kAccepted) {
+    if (text.size() <= 65536u) {
+      text_ = std::move(text);
+    } else {
+      error = "result_too_large";
+    }
+    error_ = std::move(error);
+  } else {
+    retired_ = true;
+    error_ = "cancelled";
+  }
+  // Swift's observer callback is still on stack; postpone release of its
+  // captured owner/leases to the next UI task, after the callback returns.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](scoped_refptr<NativeFoundationRequest> original) {
+                       original->swift_.reset();
+                       original->profile_lease_.reset();
+                       original->app_lease_.reset();
+                     },
+                     scoped_refptr<NativeFoundationRequest>(this)));
+}
+base::DictValue NativeFoundationRequest::Receipt(const char* state) const {
+  base::DictValue result;
+  result.Set("requestId", request_id_);
+  result.Set("taskId", task_id_);
+  result.Set("state", state);
+  result.Set("joined", joined_);
+  return result;
+}
+base::DictValue NativeFoundationRequest::Read() {
+  CheckSource();
+  auto result = Receipt(!joined_   ? "pending"
+                        : retired_ ? "cancelled"
+                                   : "completed");
+  if (joined_ && !retired_) {
+    result.Set("text", text_);
+    if (!error_.empty()) {
+      result.Set("error", error_);
+    }
+  }
+  return result;
+}
+void NativeFoundationRequest::PrimaryPageChanged(content::Page&) {
+  CheckSource();
+}
+void NativeFoundationRequest::RenderFrameDeleted(content::RenderFrameHost*) {
+  CheckSource();
+}
+void NativeFoundationRequest::WebContentsDestroyed() {
+  Retire();
+}
