+base::DictValue AuxRuntimeHost::Capabilities() const {
+  auto capabilities = aux::AuxMethodRegistry::Get().Capabilities();
+  if (!private_session_id_.empty()) {
+    capabilities.Set("privateSession",
+                     base::DictValue().Set("id", private_session_id_));
+    capabilities.FindList("methods")->EraseIf([](const base::Value& method) {
+      return !SupportsPrivateMethod(method.GetString());
+    });
+  }
+  return capabilities;
+}
