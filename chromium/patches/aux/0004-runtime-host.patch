+
+void AuxRuntimeHost::NativeConnectionPublished(uint64_t generation,
+    std::shared_ptr<base::ScopedTempDir> private_directory) {
+  if (shutting_down_ || !generation || generation <= retired_native_generation_ ||
+      generation <= admitted_native_generation_)
+    return;
+  if (admitted_native_generation_) {
+    const auto weak = weak_factory_.GetWeakPtr();
+    NativeConnectionRetired(admitted_native_generation_);
+    if (!weak || shutting_down_ || admitted_native_generation_ ||
+        generation <= retired_native_generation_)
+      return;
+  }
+  auto* original_egress = aux::EgressController::ForProfile(profile_);
+  if (!original_egress->AdmitRuntimeConnection(generation, native_owner_incarnation_))
+    return;
+  native_connection_egress_ = original_egress->GetWeakPtr();
+  admitted_native_generation_ = generation;
+  private_runtime_directory_ = std::move(private_directory);
+  native_person_connection_id_ = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  runtime_connected_ = true;
+  observers_.Notify("onRuntimeStatus", "{\"connected\":true}");
+}
+void AuxRuntimeHost::HandleNativeBrowserImportCall(const std::string& method,
+    const base::DictValue& params, uint64_t generation,
+    std::shared_ptr<std::atomic_bool> cancelled,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (shutting_down_ || !generation || generation != admitted_native_generation_ ||
+      generation <= retired_native_generation_ || cancelled->load()) {
+    std::move(callback).Run(NativeFault("ref_stale", "Original import connection retired")); return;
+  }
+  if (method == "native.browserImportExportPoll" || method == "native.browserImportExportCancel") {
+    const auto* selection = params.FindString("selectionId");
+    if (params.size() != 1 || !selection || selection->size() < 16 || selection->size() > 128) {
+      std::move(callback).Run(NativeFault("invalid_params", "The original export selection is required")); return;
+    }
+    if (!browser_importer_) {
+      base::DictValue result;
+      result.Set("selectionId", *selection);
+      result.Set("unknown", true);
+      std::move(callback).Run(base::DictValue().Set("result", std::move(result))); return;
+    }
+    std::move(callback).Run(method == "native.browserImportExportPoll" ?
+        browser_importer_->PollExport(*selection) : browser_importer_->CancelExport(*selection)); return;
+  }
+  if (method == "native.browserImportPoll" || method == "native.browserImportCancel") {
+    const auto* operation = params.FindString("operationId");
+    if (params.size() != 1 || !operation || operation->size() < 16 || operation->size() > 128) {
+      std::move(callback).Run(NativeFault("invalid_params", "An original import operation is required")); return;
+    }
+    // Authenticated same-Profile reduction only: no new source reads or effects.
+    if (!browser_importer_) {
+      base::DictValue result;
+      result.Set("operationId", *operation);
+      result.Set("unknown", true);
+      std::move(callback).Run(base::DictValue().Set("result", std::move(result))); return;
+    }
+    std::move(callback).Run(method == "native.browserImportPoll" ?
+        browser_importer_->Poll(*operation) : browser_importer_->Cancel(*operation)); return;
+  }
+  const auto* token = params.FindString("token");
+  auto owner = token ? turn_contexts_.find(*token) : turn_contexts_.end();
+  if (!token || owner == turn_contexts_.end() || owner->second.generation != generation ||
+      !TurnContextCurrent(owner->second)) {
+    std::move(callback).Run(NativeFault("ref_stale", "The original human import window retired")); return;
+  }
+  if (!browser_importer_) browser_importer_ =
+      std::make_shared<aux::BrowserProfileImporter>(profile_, profile_library_);
+  if (method == "native.browserImportDiscover" && params.size() == 1) {
+    const auto original = owner->second;
+    browser_importer_->Discover(*token, original.window, base::BindRepeating(
+        [](base::WeakPtr<AuxRuntimeHost> host, TurnContextOwner original,
+           std::shared_ptr<std::atomic_bool> cancelled) {
+          return host && !cancelled->load() && host->TurnContextCurrent(original);
+        }, weak_factory_.GetWeakPtr(), original, cancelled), std::move(callback)); return;
+  }
+  if (method == "native.browserImportExtensionReview" && params.size() == 2) {
+    const auto* handle = params.FindString("sourceHandle");
+    if (!handle || handle->size() > 128) {
+      std::move(callback).Run(NativeFault("invalid_params", "Choose the original extension source")); return;
+    }
+    browser_importer_->ReviewExtensions(*token, *handle, std::move(callback)); return;
+  }
+  if (method == "native.browserImportSelectWindow" && params.size() == 2) {
+    const auto* source = params.FindString("sourceId");
+    if (!source || *source != "safari") {
+      std::move(callback).Run(NativeFault("invalid_params", "Choose the actual native Safari window source")); return;
+    }
+    const auto original = owner->second;
+    browser_importer_->SelectSafariWindow(*token, original.window, base::BindRepeating(
+        [](base::WeakPtr<AuxRuntimeHost> host, TurnContextOwner original,
+           std::shared_ptr<std::atomic_bool> cancelled) {
+          return host && !cancelled->load() && host->TurnContextCurrent(original);
+        }, weak_factory_.GetWeakPtr(), original, cancelled), std::move(callback)); return;
+  }
+  if (method == "native.browserImportSelectExport" && params.size() == 3) {
+    const auto* source = params.FindString("sourceId");
+    const auto* type = params.FindString("format");
+    std::optional<aux::BrowserExportFormat> format;
+    if (type && *type == "safari-archive") format = aux::BrowserExportFormat::kSafariArchive;
+    else if (type && *type == "bookmarks-html") format = aux::BrowserExportFormat::kBookmarksHtml;
+    else if (type && *type == "passwords-csv") format = aux::BrowserExportFormat::kPasswordsCsv;
+    else if (type && *type == "tabs-html") format = aux::BrowserExportFormat::kTabsHtml;
+    if (!source || source->size() > 32 || !format) {
+      std::move(callback).Run(NativeFault("invalid_params", "Choose a supported original browser export format")); return;
+    }
+    const auto original = owner->second;
+    browser_importer_->SelectExport(*token, original.window, base::BindRepeating(
+        [](base::WeakPtr<AuxRuntimeHost> host, TurnContextOwner original,
+           std::shared_ptr<std::atomic_bool> cancelled) {
+          return host && !cancelled->load() && host->TurnContextCurrent(original);
+        }, weak_factory_.GetWeakPtr(), original, cancelled), *source, *format, std::move(callback)); return;
+  }
+  if (method == "native.browserImportBegin" && params.size() == 5) {
+    const auto* operation = params.FindString("operationId");
+    const auto* source = params.FindString("sourceHandle");
+    const auto* choices = params.FindList("categories");
+    const auto* review = params.FindDict("extensionReview");
+    if (review && operation && source && source->size() <= 128 && choices &&
+        !choices->empty() && choices->size() <= 5) {
+      std::vector<std::string> categories;
+      for (const auto& value : *choices) {
+        if (!value.is_string() || value.GetString().size() > 32) {
+          std::move(callback).Run(NativeFault("invalid_params", "Exact original import categories are required")); return;
+        }
+        categories.push_back(value.GetString());
+      }
+      std::move(callback).Run(browser_importer_->Begin(*token, *operation, *source, categories, *review)); return;
+    }
+  }
+  std::move(callback).Run(NativeFault("invalid_params", "Exact original import parameters are required"));
+}
+void AuxRuntimeHost::HandleNativeProjectCall(const std::string& method, const base::DictValue& params,
+    uint64_t generation, base::OnceCallback<void(base::DictValue)> callback) {
+  const auto fail = [&](const char* message) { std::move(callback).Run(NativeFault("permission_denied", message)); };
+  const auto* token = params.FindString("token");
+  const auto* id = params.FindString("operationId");
+  if (!token || !id || !base::Uuid::ParseLowercase(*id).is_valid() ||
+      generation != admitted_native_generation_ || generation <= retired_native_generation_) {
+    fail("Original Project connection retired"); return;
+  }
+  auto operation = native_projects_.find(*id);
+  if (method == "native.projectCancel") {
+    if (params.size() != 2) { fail("Exact original Project cancellation is required"); return; }
+    if (operation == native_projects_.end()) {
+      auto original = turn_contexts_.find(*token);
+      if (original == turn_contexts_.end() || original->second.generation != generation) {
+        fail("Original Project cancellation generation is unavailable"); return;
+      }
+      std::move(callback).Run(base::DictValue().Set("result", base::DictValue().Set("closed", true))); return;
+    }
+    if (operation->second->token() != *token) { fail("Original Project cancellation owner changed"); return; }
+    operation->second->Close(std::move(callback)); return;
+  }
+  if (method != "native.projectFiles" && method != "native.projectFile" && method != "native.projectChanges") {
+    fail("Unknown Project operation"); return;
+  }
+  auto owner = turn_contexts_.find(*token);
+  if (owner == turn_contexts_.end() || owner->second.generation != generation || !TurnContextCurrent(owner->second)) {
+    fail("Original Project document retired"); return;
+  }
+  const auto* cwd = params.FindString("cwd");
+  const auto* device = params.FindString("rootDevice");
+  const auto* inode = params.FindString("rootInode");
+  const auto* workspace = params.FindString("workspaceId");
+  const auto* folder = params.FindString("folderId");
+  if (params.size() != 9 || operation != native_projects_.end() || !cwd || cwd->empty() || cwd->front() != '/' ||
+      !device || !inode || !workspace || workspace->empty() || !folder || !base::Uuid::ParseLowercase(*folder).is_valid() ||
+      !params.FindList("deniedRoots") ||
+      (method == "native.projectChanges" ? !params.FindString("sandboxProfile") : !params.FindString("path"))) {
+    fail("Exact original Project scope is required"); return;
+  }
+  std::erase_if(native_projects_, [](const auto& entry) { return entry.second->Finished(); });
+  if (native_projects_.size() >= 64) { fail("Too many original Project operations"); return; }
+  auto* frame = owner->second.document.AsRenderFrameHostIfValid();
+  auto project = std::make_unique<aux::NativeProject>(content::WebContents::FromRenderFrameHost(frame), owner->second.document, *token, params.Clone());
+  auto* controller = project.get();
+  native_projects_.emplace(*id, std::move(project));
+  controller->Start(method, std::move(callback));
+}
+
+#if BUILDFLAG(IS_MAC)
+void AuxRuntimeHost::HandleNativeFoundationCall(
+    const std::string& method,
+    const base::DictValue& params,
+    uint64_t generation,
+    std::shared_ptr<std::atomic<aux::FoundationAdmission>> admission,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  auto fail = [&callback](const char* code, const char* message) {
+    std::move(callback).Run(NativeFault(code, message));
+  };
+  const auto* token = params.FindString("token");
+  if (!token || !base::Uuid::ParseLowercase(*token).is_valid()) {
+    fail("invalid_params", "Original Foundation Models owner is required");
+    return;
+  }
+  auto current = base::BindRepeating(
+      [](base::WeakPtr<AuxRuntimeHost> host, std::string token,
+         uint64_t generation) {
+        if (!host || host->shutting_down_) {
+          return false;
+        }
+        auto found = host->turn_contexts_.find(token);
+        return found != host->turn_contexts_.end() &&
+               found->second.generation == generation &&
+               host->TurnContextCurrent(found->second) &&
+               found->second.document.AsRenderFrameHostIfValid()
+                   ->IsRenderFrameLive();
+      },
+      weak_factory_.GetWeakPtr(), *token, generation);
+  if (method == "native.foundationModelsStatus") {
+    if (params.size() != 1u || !current.Run()) {
+      fail("ref_stale", "Original Foundation Models owner retired");
+      return;
+    }
+    base::DictValue result;
+    result.Set("availability", aux::NativeFoundationAvailability());
+    std::move(callback).Run(NativeResult(base::Value(std::move(result))));
+    return;
+  }
+  const auto* id = params.FindString("requestId");
+  if (!id || !base::Uuid::ParseLowercase(*id).is_valid()) {
+    fail("invalid_params", "Original Foundation Models request is required");
+    return;
+  }
+  auto found = native_foundation_.find(*id);
+  const auto prepare = params.FindBool("prepare");
+  if (method == "native.foundationModelsStart" && prepare == true) {
+    if (params.size() != 3u || !current.Run() ||
+        found != native_foundation_.end() ||
+        admission->load(std::memory_order_acquire) !=
+            aux::FoundationAdmission::kPending) {
+      fail("ref_stale",
+           "Original Foundation Models reservation is unavailable");
+      return;
+    }
+    // Only joined, irreversibly retired originals can be released. A current
+    // acknowledged handle is never displaced to make capacity.
+    std::erase_if(native_foundation_,
+                  [](const auto& entry) { return entry.second->releasable(); });
+    if (native_foundation_.size() >= 64u) {
+      fail("backend_unavailable", "Foundation Models cleanup is still pending");
+      return;
+    }
+    auto owner = turn_contexts_.find(*token);
+    auto* contents = content::WebContents::FromRenderFrameHost(
+        owner->second.document.AsRenderFrameHostIfValid());
+    auto* active =
+        owner->second.window->GetTabStripModel()->GetActiveWebContents();
+    auto active_contents =
+        active ? active->GetWeakPtr() : base::WeakPtr<content::WebContents>();
+    auto active_document =
+        active ? active->GetPrimaryMainFrame()->GetWeakDocumentPtr()
+               : content::WeakDocumentPtr();
+    auto task_current = base::BindRepeating(
+        [](base::RepeatingCallback<bool()> owner_current,
+           base::WeakPtr<BrowserWindowInterface> window,
+           base::WeakPtr<content::WebContents> original_active,
+           content::WeakDocumentPtr document, bool had_active) {
+          if (!owner_current.Run() || !window) {
+            return false;
+          }
+          auto* active_now = window->GetTabStripModel()->GetActiveWebContents();
+          auto* original_frame = document.AsRenderFrameHostIfValid();
+          return had_active
+                     ? original_active && active_now == original_active.get() &&
+                           original_frame &&
+                           original_frame->IsRenderFrameLive() &&
+                           original_frame ==
+                               original_active->GetPrimaryMainFrame()
+                     : active_now == nullptr;
+        },
+        current, owner->second.window, active_contents, active_document,
+        active != nullptr);
+    auto record = base::MakeRefCounted<aux::NativeFoundationRequest>(
+        contents, *token, *id, generation, task_current, admission);
+    native_foundation_.emplace(*id, record);
+    std::move(callback).Run(
+        NativeResult(base::Value(record->Receipt("prepared"))));
+    return;
+  }
+  // A lost prepare ACK owns a reservation, not an executing task. Reduction
+  // may recover only that exact unexecuted record; it cannot adopt a task.
+  if (method == "native.foundationModelsCancel" && prepare == true) {
+    if (params.size() != 3u || found == native_foundation_.end() ||
+        found->second->token() != *token ||
+        found->second->generation() != generation ||
+        found->second->executed()) {
+      fail("ref_stale",
+           "Original unexecuted Foundation reservation is unavailable");
+      return;
+    }
+    found->second->Retire();
+    auto receipt = found->second->Receipt("cancelled");
+    std::move(callback).Run(NativeResult(base::Value(std::move(receipt))));
+    return;
+  }
+  const auto* handle = params.FindString("taskId");
+  if (found == native_foundation_.end() || !handle ||
+      found->second->token() != *token || found->second->task_id() != *handle ||
+      found->second->generation() != generation) {
+    fail("ref_stale",
+         "The acknowledged original Foundation Models handle is required");
+    return;
+  }
+  auto record = found->second;
+  if (method == "native.foundationModelsCancel") {
+    const auto reconcile = params.FindBool("reconcile");
+    if (params.size() != (reconcile.has_value() ? 4u : 3u) ||
+        (reconcile.has_value() && !*reconcile)) {
+      fail("invalid_params", "Unexpected cancellation fields");
+      return;
+    }
+    record->Retire();
+    auto receipt = record->Receipt("cancelled");
+    if (reconcile == true && receipt.FindBool("joined") == true) {
+      native_foundation_.erase(found);
+    }
+    std::move(callback).Run(NativeResult(base::Value(std::move(receipt))));
+    return;
+  }
+  if (!current.Run()) {
+    record->Retire();
+    fail("ref_stale", "Original Foundation Models owner retired");
+    return;
+  }
+  if (method == "native.foundationModelsRead") {
+    if (!record->executed()) {
+      fail("invalid_params", "The original on-device task has not executed");
+      return;
+    }
+    if (params.size() != 3u) {
+      fail("invalid_params", "Unexpected result fields");
+      return;
+    }
+    std::move(callback).Run(NativeResult(base::Value(record->Read())));
+    return;
+  }
+  const auto* instructions = params.FindString("instructions");
+  const auto* prompt = params.FindString("prompt");
+  auto maximum = params.FindInt("maxResponseTokens");
+  if (method != "native.foundationModelsStart" || params.size() != 6u ||
+      !instructions || !prompt || instructions->size() > 16384u ||
+      prompt->empty() || prompt->size() > 32768u ||
+      !base::IsStringUTF8(*instructions) || !base::IsStringUTF8(*prompt) ||
+      !maximum || *maximum < 1 || *maximum > 1024 || record->executed()) {
+    fail("invalid_params",
+         "A bounded original Foundation Models request is required");
+    return;
+  }
+  if (shutting_down_ || profile_->IsOffTheRecord() ||
+      aux::NativeFoundationAvailability() != "available") {
+    record->Retire();
+    fail("backend_unavailable", "On-device Foundation Models is unavailable");
+    return;
+  }
+  auto lease = ScopedProfileKeepAlive::TryAcquire(
+      profile_, ProfileKeepAliveOrigin::kAuxFoundationModels);
+  if (!lease) {
+    record->Retire();
+    fail("ref_stale", "Original Foundation Models Profile is retiring");
+    return;
+  }
+  if (!record->Start(*instructions, *prompt, *maximum, admission,
+                     std::move(lease))) {
+    fail("ref_stale", "Original Foundation Models acceptance retired");
+    return;
+  }
+  std::move(callback).Run(
+      NativeResult(base::Value(record->Receipt("started"))));
+}
+
+#endif
+void AuxRuntimeHost::HandleNativeCopilotCall(
+    const std::string& method,
+    const base::DictValue& params,
+    uint64_t generation,
+    std::shared_ptr<std::atomic<aux::OwnedHeadlessAdmission>> admission,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  const auto* token = params.FindString("token");
+  const auto* request = params.FindString("requestId");
+  scoped_refptr<aux::NativeCopilotSession> start_record;
+  auto fail = [&callback, &start_record](std::string code,
+                                         std::string message) {
+    if (start_record) {
+      start_record->Retire();
+    }
+    std::move(callback).Run(NativeFault(std::move(code), std::move(message)));
+  };
+  if (!token || !request || !base::Uuid::ParseLowercase(*token).is_valid() ||
+      !base::Uuid::ParseLowercase(*request).is_valid()) {
+    fail("invalid_params", "Original Copilot request identity is required");
+    return;
+  }
+  auto found = native_copilots_.find(*request);
+  if (method == "native.copilotStop") {
+    const auto* handle = params.FindString("helperId");
+    // Reduction remains callable after original document/socket retirement.
+    // The authenticated runtime cannot adopt arbitrary processes: saved token
+    // and request are mandatory and a supplied handle must match exactly.
+    const auto reconcile = params.FindBool("reconcile");
+    if (params.size() !=
+            (handle ? 3u : 2u) + (reconcile.has_value() ? 1u : 0u) ||
+        (reconcile.has_value() && (!*reconcile || !handle)) ||
+        found == native_copilots_.end() || found->second->token() != *token ||
+        (handle && *handle != found->second->helper_id()) ||
+        (!handle && found->second->execution_requested()) ||
+        (reconcile.value_or(false) && !found->second->joined())) {
+      fail("ref_stale", "Original Copilot cleanup receipt is unavailable");
+      return;
+    }
+    if (reconcile.value_or(false)) {
+      found->second->Reconcile();
+    }
+    found->second->Stop(std::move(callback));
+    return;
+  }
+  const auto prepare = params.FindBool("prepare");
+  if (method == "native.copilotStart" && prepare.value_or(false)) {
+    if (params.size() != 6 || found != native_copilots_.end() || !generation ||
+        generation != admitted_native_generation_ || shutting_down_) {
+      fail("ref_stale", "Original Copilot reservation cannot be admitted");
+      return;
+    }
+    // Close retired scopes irreversibly before pruning acknowledged records.
+    // Restored documents must obtain a fresh original native turn token.
+    std::erase_if(turn_contexts_, [this](const auto& entry) {
+      return !TurnContextCurrent(entry.second);
+    });
+    std::erase_if(native_copilots_, [this](const auto& entry) {
+      const auto& record = entry.second;
+      auto owner = turn_contexts_.find(record->token());
+      const bool retired =
+          owner == turn_contexts_.end() ||
+          owner->second.generation != record->original_generation();
+      return record->joined() && record->reconciled() && retired;
+    });
+    if (native_copilots_.size() >= 64) {
+      fail("backend_unavailable",
+           "Original Copilot reservation registry is full");
+      return;
+    }
+    const auto* account = params.FindString("accountId");
+    const auto* authorization = params.FindString("authorizationGeneration");
+    const auto* credential = params.FindString("credentialRevision");
+    const bool valid_account =
+        account && account->size() == 64 &&
+        std::ranges::all_of(*account, [](char c) {
+          return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+        });
+    auto original = turn_contexts_.find(*token);
+    if (!valid_account || !authorization || !credential ||
+        !base::Uuid::ParseLowercase(*authorization).is_valid() ||
+        !base::Uuid::ParseLowercase(*credential).is_valid() ||
+        original == turn_contexts_.end() ||
+        !TurnContextCurrent(original->second) ||
+        admission->load(std::memory_order_acquire) !=
+            aux::OwnedHeadlessAdmission::kPending) {
+      fail("ref_stale", "Original Copilot reservation scope retired");
+      return;
+    }
+    for (const auto& [id, record] : native_copilots_) {
+      if (!record->joined() && record->account_id() == *account) {
+        fail("operation_uncertain",
+             "Reduce the original account reservation before another prepare");
+        return;
+      }
+    }
+    auto current = base::BindRepeating(
+        [](base::WeakPtr<AuxRuntimeHost> host, std::string token,
+           uint64_t generation) {
+          if (!host) {
+            return false;
+          }
+          auto original = host->turn_contexts_.find(token);
+          return original != host->turn_contexts_.end() &&
+                 original->second.generation == generation &&
+                 host->TurnContextCurrent(original->second);
+        },
+        weak_factory_.GetWeakPtr(), *token, generation);
+    start_record = base::MakeRefCounted<aux::NativeCopilotSession>(
+        content::WebContents::FromRenderFrameHost(
+            original->second.document.AsRenderFrameHostIfValid()),
+        *token, *request, generation, *account, *authorization, *credential,
+        admission, std::move(current));
+    native_copilots_.emplace(*request, start_record);
+    // No token, installation, Home, launch or gate acceptance reaches worker.
+    // A lost prepare ACK cannot execute; no native handle reached the caller.
+    start_record->Prepare(std::move(callback));
+    return;
+  }
+  if (method == "native.copilotStart") {
+    const auto* handle = params.FindString("helperId");
+    if (prepare.has_value() || !handle || found == native_copilots_.end() ||
+        found->second->token() != *token ||
+        found->second->helper_id() != *handle ||
+        found->second->original_generation() != generation ||
+        !found->second->prepared() || found->second->execution_requested()) {
+      fail("ref_stale",
+           "The acknowledged original Copilot reservation is required");
+      return;
+    }
+    start_record = found->second;
+  }
+  auto original = turn_contexts_.find(*token);
+  if (shutting_down_ || !generation ||
+      generation != admitted_native_generation_ ||
+      original == turn_contexts_.end() ||
+      !TurnContextCurrent(original->second) ||
+      admission->load(std::memory_order_acquire) ==
+          aux::OwnedHeadlessAdmission::kRetired) {
+    fail("ref_stale", "Original Copilot window/document retired");
+    return;
+  }
+  if (method == "native.copilotEndpoint") {
+    const auto* handle = params.FindString("helperId");
+    if (params.size() != 3 || !handle || found == native_copilots_.end() ||
+        found->second->token() != *token ||
+        found->second->helper_id() != *handle || !found->second->Current()) {
+      fail("ref_stale", "Original Copilot helper receipt retired");
+      return;
+    }
+    found->second->Endpoint(std::move(callback));
+    return;
+  }
+  if (method != "native.copilotStart") {
+    fail("unsupported", "Unknown Copilot native operation");
+    return;
+  }
+  const auto* account = params.FindString("accountId");
+  const auto* authorization = params.FindString("authorizationGeneration");
+  const auto* credential = params.FindString("credentialRevision");
+  const auto* access = params.FindString("accessToken");
+  const auto* connection = params.FindString("connectionToken");
+  auto decimal = [&params](const char* name) -> std::optional<uint64_t> {
+    const auto* value = params.FindString(name);
+    uint64_t parsed = 0;
+    if (!value || !base::StringToUint64(*value, &parsed) || !parsed ||
+        base::NumberToString(parsed) != *value) {
+      return std::nullopt;
+    }
+    return parsed;
+  };
+  const auto runtime_device = decimal("runtimeDevice");
+  const auto runtime_inode = decimal("runtimeInode");
+  const auto executable_device = decimal("executableDevice");
+  const auto executable_inode = decimal("executableInode");
+  const auto home_device = decimal("homeDevice");
+  const auto home_inode = decimal("homeInode");
+  const auto is_account = [](const std::string& value) {
+    return value.size() == 64 && std::ranges::all_of(value, [](char c) {
+             return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+           });
+  };
+  const auto connection_valid = [](const std::string& value) {
+    return value.size() == 43 && std::ranges::all_of(value, [](char c) {
+             return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                    (c >= '0' && c <= '9') || c == '-' || c == '_';
+           });
+  };
+  if (params.size() != 14 || !start_record || !account ||
+      !is_account(*account) || !authorization || !credential ||
+      !base::Uuid::ParseLowercase(*authorization).is_valid() ||
+      !base::Uuid::ParseLowercase(*credential).is_valid() || !access ||
+      access->empty() || access->size() > 8192 ||
+      access->find_first_of("\r\n") != std::string::npos || !connection ||
+      !connection_valid(*connection) || !runtime_device || !runtime_inode ||
+      !executable_device || !executable_inode || !home_device || !home_inode ||
+      start_record->account_id() != *account ||
+      start_record->authorization_generation() != *authorization ||
+      start_record->credential_revision() != *credential ||
+      !start_record->Current()) {
+    fail("invalid_params",
+         "Immutable Copilot installation/account receipt is required");
+    return;
+  }
+  for (const auto& [id, session] : native_copilots_) {
+    if (session.get() != start_record.get() && !session->joined() &&
+        session->account_id() == *account) {
+      fail("operation_uncertain",
+           "Join the original account helper before another launch");
+      return;
+    }
+  }
+  auto profile_lease = ScopedProfileKeepAlive::TryAcquire(
+      profile_->GetOriginalProfile(), ProfileKeepAliveOrigin::kAuxCopilotHelper);
+  if (!profile_lease || !TurnContextCurrent(original->second)) {
+    fail("ref_stale", "Original Copilot Profile is retiring");
+    return;
+  }
+  aux::OwnedCopilotLaunch launch;
+  // The installed payload is read-only. Only the original OTR host supplies its temporary home root.
+  const auto data = profile_->GetOriginalProfile()->GetPath().Append("Aux Runtime Data");
+  if (profile_->IsOffTheRecord() && (!private_runtime_directory_ || !private_runtime_directory_->IsValid())) {
+    fail("ref_stale", "Original private Copilot storage retired"); return;
+  }
+  const auto homes = profile_->IsOffTheRecord()
+      ? private_runtime_directory_->GetPath().Append("Aux Runtime Data") : data;
+  launch.runtime_root =
+      data.Append("provider-runtimes").Append("copilot-1.0.16-darwin-arm64");
+  launch.executable = launch.runtime_root.Append("prebuilds")
+                          .Append("darwin-arm64")
+                          .Append("copilot-runtime");
+  launch.private_home = homes.Append("copilot-homes").Append(*request);
+  launch.working_directory = launch.private_home;
+  launch.runtime_device = *runtime_device;
+  launch.runtime_inode = *runtime_inode;
+  launch.executable_device = *executable_device;
+  launch.executable_inode = *executable_inode;
+  launch.home_device = *home_device;
+  launch.home_inode = *home_inode;
+  launch.working_device = *home_device;
+  launch.working_inode = *home_inode;
+  launch.access_token = *access;
+  launch.connection_token = *connection;
+  start_record->Start(std::move(launch), std::move(profile_lease), admission,
+                      private_runtime_directory_, std::move(callback));
+}
+
+void AuxRuntimeHost::InvalidatePrivateProviders() {
+  if (profile_->IsOffTheRecord()) return;
+  // Do not create a host or reconnect a retired private worker to send an invalidation.
+  for (auto* profile : profile_->GetAllOffTheRecordProfiles()) {
+    auto* host = static_cast<AuxRuntimeHost*>(profile->GetUserData(&kAuxRuntimeHostKey));
+    if (host && host->runtime_connected_ && !host->shutting_down_ &&
+        host->profile_->GetOriginalProfile() == profile_) {
+      host->worker_.AsyncCall(&Worker::SendPrivateProviderChanged)
+          .WithArgs(host->admitted_native_generation_);
+    }
+  }
+}
+
+void AuxRuntimeHost::HandlePrivateProviderCall(const base::DictValue& params, uint64_t generation,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (!profile_->IsOffTheRecord() || private_session_id_.empty() ||
+      !DeviceConfirmationConnectionCurrent(generation)) {
+    std::move(callback).Run(NativeFault("permission_denied", "An original private runtime is required")); return;
+  }
+  const auto* operation = params.FindString("operation");
+  if (!operation || ((*operation != "describe" || params.size() != 1) &&
+      (*operation != "credential" || params.size() != 2 || !params.FindString("revision")) &&
+      (*operation != "budget" || params.size() != 2 || !params.FindDict("budget")) &&
+      (*operation != "cloud" || params.size() != 2 || !params.FindDict("cloud")))) {
+    std::move(callback).Run(NativeFault("invalid_params", "Exact private credential request is required")); return;
+  }
+  auto* original = ForProfile(profile_->GetOriginalProfile());
+  if (!original) { std::move(callback).Run(NativeFault("cancelled", "Original credential Profile is unavailable")); return; }
+  const auto json = base::WriteJson(base::DictValue().Set("sessionId", private_session_id_).Set("request", params.Clone()));
+  original->CallInternal("provider.private", *json, base::BindOnce(
+      [](base::WeakPtr<AuxRuntimeHost> owner, base::WeakPtr<AuxRuntimeHost> original, uint64_t generation,
+         base::OnceCallback<void(base::DictValue)> callback, Response response) {
+        if (!owner || !original || !owner->DeviceConfirmationConnectionCurrent(generation) ||
+            owner->profile_->GetOriginalProfile() != original->profile_ || original->shutting_down_) {
+          std::move(callback).Run(NativeFault("cancelled", "Original private credential ownership retired")); return;
+        }
+        if (!response.ok) {
+          std::move(callback).Run(NativeFault(response.error_code, response.error_message)); return;
+        }
+        auto result = base::JSONReader::Read(response.result_json, base::JSON_PARSE_RFC);
+        if (!result || !result->is_dict()) {
+          std::move(callback).Run(NativeFault("backend_unavailable", "Original provider returned an invalid credential reply")); return;
+        }
+        std::move(callback).Run(NativeResult(std::move(*result)));
+      }, weak_factory_.GetWeakPtr(), original->GetWeakPtr(), generation, std::move(callback)));
+}
+
+void AuxRuntimeHost::HandleNativeCloudPreviewCall(
+    const std::string& method, const base::DictValue& params, uint64_t generation,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  const auto fail = [&](const std::string& message) { std::move(callback).Run(NativeFault("permission_denied", message)); };
+  const auto* token = params.FindString("token");
+  const auto* id = params.FindString("previewId");
+  if (!token || !id || !base::Uuid::ParseLowercase(*id).is_valid() ||
+      generation != admitted_native_generation_ || generation <= retired_native_generation_) {
+    fail("Original cloud Preview connection retired"); return;
+  }
+  auto entry = native_cloud_previews_.find(*id);
+  if (method == "native.cloudPreviewClose") {
+    if (params.size() != 2) { fail("Exact cloud Preview close identity is required"); return; }
+    // This authenticated connection owns the complete guest inventory. Absence is an unstarted or acknowledged close.
+    if (entry == native_cloud_previews_.end()) { std::move(callback).Run(NativeResult(base::Value(base::DictValue().Set("closed", true)))); return; }
+    if (entry->second.token != *token) { fail("Original cloud Preview close owner changed"); return; }
+    if (!entry->second.preview) { std::move(callback).Run(NativeResult(base::Value(base::DictValue().Set("closed", true)))); return; }
+    entry->second.preview->Close(base::BindOnce([](base::WeakPtr<AuxRuntimeHost> host, std::string id, std::string token,
+        base::OnceCallback<void(base::DictValue)> callback, bool closed) {
+      if (!closed || !host) { std::move(callback).Run(NativeFault("backend_unavailable", "Original cloud Preview retirement is not acknowledged")); return; }
+      const auto entry = host->native_cloud_previews_.find(id);
+      if (entry == host->native_cloud_previews_.end() || entry->second.token != token) {
+        std::move(callback).Run(NativeFault("ref_stale", "Original cloud Preview close owner changed")); return;
+      }
+      entry->second.preview.reset();
+      std::move(callback).Run(NativeResult(base::Value(base::DictValue().Set("closed", true))));
+    }, weak_factory_.GetWeakPtr(), *id, *token, std::move(callback))); return;
+  }
+  const auto owner = turn_contexts_.find(*token);
+  const auto* process = params.FindString("processId"), *url = params.FindString("url");
+  const auto* execution = params.FindDict("execution"), *listener = params.FindDict("listener");
+  if (method != "native.cloudPreview" || params.size() != 6 || !process || !base::Uuid::ParseLowercase(*process).is_valid() ||
+      !url || !execution || execution->size() != 7 || !listener || listener->size() != 5 ||
+      owner == turn_contexts_.end() || owner->second.generation != generation || !TurnContextCurrent(owner->second) ||
+      entry != native_cloud_previews_.end()) { fail("Exact original cloud listener binding is required"); return; }
+  const auto* backend = execution->FindString("backend");
+  const auto* resource = execution->FindString("resourceId"), *sandbox = execution->FindString("sandboxName"),
+      *session = execution->FindString("sessionId"), *command = execution->FindString("commandId"), *root = execution->FindString("root");
+  const auto* supervisor = execution->FindDict("supervisor");
+  if (!backend || *backend != "cloud" || !resource || resource->empty() || !sandbox || sandbox->empty() ||
+      !session || session->empty() || !command || command->empty() || !root || *root != "/vercel/sandbox/project" ||
+      !supervisor || supervisor->size() != 4 || !listener->FindInt("port") || !listener->FindInt("pid") ||
+      !listener->FindInt("fd") || !listener->FindString("inode") || !listener->FindString("startTicks") ||
+      !supervisor->FindInt("pid") || !supervisor->FindInt("groupPid") || !supervisor->FindString("startTicks") ||
+      !supervisor->FindString("groupStartTicks")) { fail("Original cloud command and socket proof is required"); return; }
+  const auto port = listener->FindInt("port"), pid = listener->FindInt("pid"), fd = listener->FindInt("fd");
+  const auto supervisor_pid = supervisor->FindInt("pid"), group_pid = supervisor->FindInt("groupPid");
+  const auto decimal = [](const std::string* value) { return value && !value->empty() && value->size() <= 32 && base::ContainsOnlyChars(*value, "0123456789"); };
+  if (!port || *port < 1 || *port > 65535 || !pid || *pid <= 0 || !fd || *fd < 0 ||
+      !supervisor_pid || *supervisor_pid <= 0 || !group_pid || *group_pid <= 0 ||
+      !decimal(listener->FindString("inode")) || !decimal(listener->FindString("startTicks")) ||
+      !decimal(supervisor->FindString("startTicks")) || !decimal(supervisor->FindString("groupStartTicks"))) {
+    fail("Invalid original process or socket identity"); return;
+  }
+  const GURL origin(*url);
+  if (!origin.is_valid() || !origin.SchemeIs("https") || origin.EffectiveIntPort() != 443 || origin.HostIsIPAddress() ||
+      origin.has_username() || origin.has_password() || origin.path() != "/" || origin.has_query() || origin.has_ref()) {
+    fail("An exact public HTTPS Preview origin is required"); return;
+  }
+  if (native_cloud_previews_.size() >= 128) std::erase_if(native_cloud_previews_, [](const auto& item) { return !item.second.preview; });
+  if (native_cloud_previews_.size() >= 128) { fail("Close an original cloud Preview first"); return; }
+  auto current = base::BindRepeating([](base::WeakPtr<AuxRuntimeHost> host, uint64_t generation, std::string token) {
+    if (!host || host->admitted_native_generation_ != generation || generation <= host->retired_native_generation_) return false;
+    const auto owner = host->turn_contexts_.find(token);
+    return owner != host->turn_contexts_.end() && host->TurnContextCurrent(owner->second);
+  }, weak_factory_.GetWeakPtr(), generation, *token);
+  auto review = base::BindRepeating([](base::WeakPtr<AuxRuntimeHost> host, uint64_t generation, std::string token,
+      std::string id, base::OnceCallback<void(bool)> callback) {
+    if (!host || host->admitted_native_generation_ != generation || generation <= host->retired_native_generation_) { std::move(callback).Run(false); return; }
+    const auto owner = host->turn_contexts_.find(token);
+    const auto entry = host->native_cloud_previews_.find(id);
+    if (owner == host->turn_contexts_.end() || !host->TurnContextCurrent(owner->second) || entry == host->native_cloud_previews_.end() || entry->second.token != token || !entry->second.preview) { std::move(callback).Run(false); return; }
+    const auto json = base::WriteJson(base::DictValue().Set("previewId", id).Set("token", token));
+    host->CallInternal("projects.cloudPreview.admit", *json, base::BindOnce([](base::WeakPtr<AuxRuntimeHost> host,
+        uint64_t generation, std::string token, std::string id, base::OnceCallback<void(bool)> callback, Response response) {
+      if (!host || host->admitted_native_generation_ != generation || generation <= host->retired_native_generation_) { std::move(callback).Run(false); return; }
+      const auto owner = host->turn_contexts_.find(token);
+      const auto entry = host->native_cloud_previews_.find(id);
+      const auto result = base::JSONReader::Read(response.result_json, base::JSON_PARSE_RFC);
+      std::move(callback).Run(response.ok && result && result->is_bool() && result->GetBool() && owner != host->turn_contexts_.end() &&
+          host->TurnContextCurrent(owner->second) && entry != host->native_cloud_previews_.end() && entry->second.token == token && !!entry->second.preview);
+    }, host, generation, token, id, std::move(callback)));
+  }, weak_factory_.GetWeakPtr(), generation, *token, *id);
+  auto* frame = owner->second.document.AsRenderFrameHostIfValid();
+  auto preview = std::make_unique<aux::NativeProjectPreview>(content::WebContents::FromRenderFrameHost(frame), owner->second.document,
+      origin, std::move(current), std::move(review), aux::NativeProjectPreview::OriginKind::kPublicHttps);
+  auto [inserted, ok] = native_cloud_previews_.emplace(*id, NativeCloudPreview{*token, params.Clone(), std::move(preview)});
+  if (!ok || !inserted->second.preview->Open()) { fail("Cannot attach the original cloud Preview"); return; }
+  auto result = inserted->second.preview->Describe();
+  result.Set("previewId", *id);
+  result.Set("processId", *process);
+  std::move(callback).Run(NativeResult(base::Value(std::move(result))));
+}
+
+void AuxRuntimeHost::HandleNativeTerminalCall(
+    const std::string& method,
+    const base::DictValue& params,
+    uint64_t generation,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  const auto fail = [&](const std::string& message) { std::move(callback).Run(NativeFault("permission_denied", message)); };
+  const auto* token = params.FindString("token");
+  const auto* id = params.FindString("terminalId");
+  if (!token || !id || !base::Uuid::ParseLowercase(*id).is_valid() ||
+      generation != admitted_native_generation_ || generation <= retired_native_generation_) {
+    fail("Original terminal connection retired"); return;
+  }
+  auto session = native_terminals_.find(*id);
+  if (method == "native.terminalPreviewClose") {
+    const auto* preview_id = params.FindString("previewId");
+    if (params.size() != 3 || !preview_id || !base::Uuid::ParseLowercase(*preview_id).is_valid() ||
+        session == native_terminals_.end() || session->second->token() != *token) { fail("Original Preview close owner changed"); return; }
+    session->second->ClosePreview(*preview_id, std::move(callback)); return;
+  }
+  if (method == "native.terminalClose") {
+    if (params.size() != 2 || session == native_terminals_.end() || session->second->token() != *token) {
+      fail("Original terminal close owner changed"); return;
+    }
+    session->second->Close(std::move(callback)); return;
+  }
+  auto owner = turn_contexts_.find(*token);
+  if (owner == turn_contexts_.end() || owner->second.generation != generation || !TurnContextCurrent(owner->second)) {
+    fail("Original terminal document retired"); return;
+  }
+  if (method == "native.terminalStart") {
+    const auto* executable = params.FindString("executable"), *cwd = params.FindString("cwd"),
+        *workspace = params.FindString("workspaceId"), *folder = params.FindString("folderId"), *device = params.FindString("rootDevice"), *inode = params.FindString("rootInode");
+    const auto cols = params.FindInt("cols"), rows = params.FindInt("rows");
+    if (params.size() != 10 || !device || !inode || session != native_terminals_.end() || !executable || !cwd || !workspace || workspace->empty() ||
+        !folder || !base::Uuid::ParseLowercase(*folder).is_valid() ||
+        !cols || *cols < 2 || *cols > 500 || !rows || *rows < 1 || *rows > 300) { fail("Exact terminal launch is required"); return; }
+    if (native_terminals_.size() >= 64) std::erase_if(native_terminals_, [](const auto& entry) { return *entry.second->Session().FindString("state") == "closed"; });
+    if (native_terminals_.size() >= 64) { fail("Close an existing terminal first"); return; }
+    auto* frame = owner->second.document.AsRenderFrameHostIfValid();
+    auto terminal = std::make_unique<aux::NativeTerminal>(content::WebContents::FromRenderFrameHost(frame), owner->second.document, *token,
+        base::DictValue().Set("terminalId", *id).Set("workspaceId", *workspace).Set("folderId", *folder).Set("cols", *cols).Set("rows", *rows).Set("state", "running"));
+    std::string error;
+    if (!terminal->Start(*executable, *cwd, *device, *inode, &error)) { native_terminals_.emplace(*id, std::move(terminal)); fail(error); return; }
+    auto result = terminal->Session(); native_terminals_.emplace(*id, std::move(terminal));
+    std::move(callback).Run(NativeResult(base::Value(std::move(result)))); return;
+  }
+  if (session == native_terminals_.end() || session->second->token() != *token || !session->second->Current()) {
+    fail("Original terminal session retired"); return;
+  }
+  if (method == "native.terminalListeners") {
+    if (params.size() != 2) { fail("Exact terminal listener owner is required"); return; }
+    session->second->Listeners(std::move(callback)); return;
+  }
+  if (method == "native.terminalPreview") {
+    const auto* listener = params.FindString("listenerId"), *preview = params.FindString("previewId"), *protocol = params.FindString("protocol");
+    if (params.size() != 5 || !listener || !preview || !protocol ||
+        !base::Uuid::ParseLowercase(*listener).is_valid() || !base::Uuid::ParseLowercase(*preview).is_valid()) {
+      fail("Exact original Project listener is required"); return;
+    }
+    auto review = base::BindRepeating([](base::WeakPtr<AuxRuntimeHost> host, uint64_t generation,
+        std::string token, std::string terminal_id, std::string preview_id, base::OnceCallback<void(bool)> callback) {
+      if (!host || host->admitted_native_generation_ != generation || generation <= host->retired_native_generation_) {
+        std::move(callback).Run(false); return;
+      }
+      auto owner = host->turn_contexts_.find(token);
+      if (owner == host->turn_contexts_.end() || !host->TurnContextCurrent(owner->second)) {
+        std::move(callback).Run(false); return;
+      }
+      const auto json = base::WriteJson(base::DictValue().Set("terminalId", terminal_id).Set("previewId", preview_id).Set("token", token));
+      host->CallInternal("projects.preview.admit", *json, base::BindOnce([](base::WeakPtr<AuxRuntimeHost> host,
+          uint64_t generation, std::string token, base::OnceCallback<void(bool)> callback, Response response) {
+        if (!host || host->admitted_native_generation_ != generation || generation <= host->retired_native_generation_) {
+          std::move(callback).Run(false); return;
+        }
+        const auto owner = host->turn_contexts_.find(token);
+        const auto result = base::JSONReader::Read(response.result_json, base::JSON_PARSE_RFC);
+        std::move(callback).Run(response.ok && result && result->is_bool() && result->GetBool() &&
+            owner != host->turn_contexts_.end() && host->TurnContextCurrent(owner->second));
+      }, host, generation, token, std::move(callback)));
+    }, weak_factory_.GetWeakPtr(), generation, *token, *id, *preview);
+    std::move(callback).Run(session->second->Preview(*listener, *preview, *protocol, std::move(review))); return;
+  }
+  const auto integer = [&](const char* name) -> std::optional<uint64_t> {
+    auto value = params.FindDouble(name);
+    if (!value) { auto number = params.FindInt(name); if (number) value = static_cast<double>(*number); }
+    if (!value || !std::isfinite(*value) || *value < 0 || *value > 9007199254740991.0 || std::floor(*value) != *value) return std::nullopt;
+    return static_cast<uint64_t>(*value);
+  };
+  if (method == "native.terminalRead") {
+    auto offset = integer("offset"); if (params.size() != 3 || !offset) { fail("Exact terminal output offset is required"); return; }
+    std::move(callback).Run(session->second->Read(*offset)); return;
+  }
+  if (method == "native.terminalInput") {
+    auto sequence = integer("sequence"); const auto* data = params.FindString("data");
+    if (params.size() != 4 || !sequence || !data) { fail("Exact terminal input sequence is required"); return; }
+    std::move(callback).Run(session->second->Input(*sequence, *data)); return;
+  }
+  if (method == "native.terminalResize") {
+    auto cols = params.FindInt("cols"), rows = params.FindInt("rows");
+    if (params.size() != 4 || !cols || !rows) { fail("Exact terminal dimensions are required"); return; }
+    std::move(callback).Run(session->second->Resize(*cols, *rows)); return;
+  }
+  fail("Unknown terminal method");
+}
+
+void AuxRuntimeHost::FinishStageRelease(const std::string& page_id) {
+  stage_release_timers_.erase(page_id);
+  auto it = staged_pages_.find(page_id);
+  if (it == staged_pages_.end() || it->second.count > 0) return;
+  auto lease = std::move(it->second);
+  staged_pages_.erase(it);
+  if (!lease.contents || !lease.owner || lease.owner->GetProfile() != profile_ ||
+      lease.contents->GetBrowserContext() != profile_) return;
+  auto* model = lease.owner->GetTabStripModel();
+  if (model->GetIndexOfWebContents(lease.contents.get()) == TabStripModel::kNoTab ||
+      model->GetActiveWebContents() == lease.contents.get()) return;
+  lease.contents->UpdateWebContentsVisibility(content::Visibility::HIDDEN);
+}
+
+void AuxRuntimeHost::RetireStageLeases() {
+  stage_release_timers_.clear();
+  auto leases = std::move(staged_pages_);
+  staged_pages_.clear();
+  const auto weak = GetWeakPtr();
+  for (const auto& [page_id, lease] : leases) {
+    if (!lease.contents || !lease.owner || lease.owner->GetProfile() != profile_ ||
+        lease.contents->GetBrowserContext() != profile_) continue;
+    auto* model = lease.owner->GetTabStripModel();
+    if (model->GetIndexOfWebContents(lease.contents.get()) == TabStripModel::kNoTab ||
+        model->GetActiveWebContents() == lease.contents.get()) continue;
+    lease.contents->UpdateWebContentsVisibility(content::Visibility::HIDDEN);
+    if (!weak) return;
+  }
+}
+
+void AuxRuntimeHost::NativeConnectionRetired(uint64_t generation) {
+  if (!generation)
+    return;
+  retired_native_generation_ = std::max(retired_native_generation_, generation);
+  if (admitted_native_generation_ != generation)
+    return;
+  admitted_native_generation_ = 0;
+  runtime_connected_ = false;
+  credential_admissions_.clear();
+  if (native_content_blocker_) native_content_blocker_->RetireConnection(generation);
+  native_content_blocker_.reset();
+  InvalidatePrivateProviders();
+  const auto retirement_weak = weak_factory_.GetWeakPtr();
+  RetireStageLeases();
+  if (!retirement_weak) return;
+  // Profile teardown has already removed its user-data map. Retire only the
+  // original admitting controller, if it still exists; never recreate it.
+  auto original_egress = native_connection_egress_;
+  native_connection_egress_.reset();
+  // Detach every original host slot before Disconnect notifies observers.
+  // A retirement callback may synchronously publish a replacement connection.
+  native_person_connection_id_.clear();
+  native_projects_.clear();
+  native_terminals_.clear();
+  native_cloud_previews_.clear();
+  private_runtime_directory_.reset();
+  // Retire acceptance synchronously; blocking process/group join stays on the
+  // separate BLOCK_SHUTDOWN sequence. Keep original unjoined debts in registry.
+  for (const auto& [id, session] : native_copilots_) {
+    session->Retire();
+  }
+  if (browser_importer_) {
+    std::vector<std::string> import_owners;
+    for (const auto& [token, owner] : turn_contexts_)
+      if (owner.generation == generation) import_owners.push_back(token);
+    for (const auto& token : import_owners) browser_importer_->RetireOwner(token);
+  }
+#if BUILDFLAG(IS_MAC)
+  for (const auto& [id, request] : native_foundation_) {
+    request->Retire();
+  }
+#endif
+  turn_contexts_.clear();
+  ++native_recorder_session_generation_;
+  auto recorder = native_recorder_;
+  native_recorder_.reset();
+  native_recorder_page_id_.clear();
+  auto reads = std::move(native_person_reads_);
+  native_person_reads_.clear();
+  const auto weak = weak_factory_.GetWeakPtr();
+  auto captures = std::move(native_person_captures_);
+  native_person_captures_.clear();
+  if (original_egress)
+    original_egress->Disconnect();
+  if (!retirement_weak) return;
+  for (const auto& [id, capture] : captures) {
+    if (capture) capture->Retire();
+    if (!weak) return;
+  }
+  for (const auto& [id, reader] : reads) {
+    if (reader)
+      reader->Disconnect(generation);
+    if (!weak)
+      return;
+  }
+  if (recorder)
+    recorder->Disconnect(generation);
+  if (!weak || admitted_native_generation_) return;
+  FailOwnerMutations();
+  if (!weak || admitted_native_generation_) return;
+  cdp_broker_->DetachAll();
+  if (!weak || admitted_native_generation_) return;
+  if (profile_library_)
+    profile_library_->OnRuntimeDisconnected();
+  if (!weak || admitted_native_generation_) return;
+  observers_.Notify("onRuntimeStatus", "{\"connected\":false}");
+}
+void AuxRuntimeHost::HandleNativePersonReadCall(
+    const std::string& method, const base::DictValue& params, uint64_t connection_generation,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (shutting_down_ || !connection_generation ||
+      admitted_native_generation_ != connection_generation ||
+      connection_generation <= retired_native_generation_ || native_person_connection_id_.empty()) {
+    std::move(callback).Run(NativeFault("target_detached", "Page connection retired"));
+    return;
+  }
+  const auto* page_id = params.FindString("pageId");
+  const auto* request = params.FindDict("request");
+  const bool describe = method == "native.personReadContext";
+  const bool capture = method == "native.personCapture";
+  if (params.size() != (describe ? 1u : capture ? 6u : 2u) || !page_id || !aux::PageIdentity::IsValid(*page_id) ||
+      (!describe && !capture && (method != "native.personRead" || !request))) {
+    std::move(callback).Run(NativeFault("invalid_params", "Invalid fixed page read"));
+    return;
+  }
+  if (!describe && native_person_reads_.size() >= 8) {
+    std::move(callback).Run(NativeFault("conflict", "Too many pending page reads"));
+    return;
+  }
+  auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+  BrowserWindowInterface* original_window = nullptr;
+  auto* page = catalog ? catalog->FindPage(*page_id, &original_window) : nullptr;
+  auto* authority = aux::EgressController::ForProfile(profile_);
+  auto receipt = page && authority ? authority->CapturePersonRead(page) : std::nullopt;
+  if (!receipt || receipt->page_id() != *page_id) {
+    std::move(callback).Run(NativeFault("permission_denied", "This page could not be read"));
+    return;
+  }
+  auto context = aux::NativePersonObserverController::Describe(*receipt, native_person_connection_id_);
+  auto* identity = context.FindDict("result");
+  const auto* session_id = identity ? identity->FindString("sessionId") : nullptr;
+  if (!session_id || !authority->MayReadPerson(*receipt)) {
+    std::move(callback).Run(NativeFault("target_detached", "Page read context retired"));
+    return;
+  }
+  if (describe) {
+    std::move(callback).Run(std::move(context));
+    return;
+  }
+  if (capture) {
+    if (!original_window || native_person_captures_.size() >= 8) {
+      std::move(callback).Run(NativeFault("conflict", "Original page capture is unavailable")); return;
+    }
+    const auto current = base::BindRepeating([](base::WeakPtr<AuxRuntimeHost> owner,
+        base::WeakPtr<aux::EgressController> authority, aux::NativePersonReadReceipt receipt,
+        base::WeakPtr<BrowserWindowInterface> original_window, uint64_t generation, const base::DictValue& identity) {
+      if (!owner || !authority || !original_window || owner->shutting_down_ ||
+          owner->admitted_native_generation_ != generation || generation <= owner->retired_native_generation_ ||
+          owner->native_person_connection_id_.empty() || !authority->MayReadPerson(receipt)) return false;
+      auto* frame = receipt.document().AsRenderFrameHostIfValid();
+      auto* page = frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+      auto* catalog = aux::TabCatalog::GetForProfile(owner->profile_);
+      BrowserWindowInterface* observed_window = nullptr;
+      if (!page || !catalog || catalog->FindPage(receipt.page_id(), &observed_window) != page || observed_window != original_window.get()) return false;
+      const auto* page_id = identity.FindString("pageId");
+      const auto* window_id = identity.FindString("windowId");
+      const auto* target_id = identity.FindString("targetId");
+      const auto* url = identity.FindString("url");
+      if (!page_id || *page_id != receipt.page_id() || !window_id ||
+          *window_id != base::NumberToString(original_window->GetSessionID().id()) ||
+          !target_id || *target_id != "atab-" + receipt.page_id() || !url || *url != frame->GetLastCommittedURL().spec()) return false;
+      const auto described = aux::NativePersonObserverController::Describe(receipt, owner->native_person_connection_id_);
+      if (!owner || !authority || !original_window || !authority->MayReadPerson(receipt)) return false;
+      const auto* context = described.FindDict("result");
+      for (const auto* key : {"pageId", "documentId", "sessionId", "url"}) {
+        const auto* wanted = identity.FindString(key);
+        const auto* actual = context ? context->FindString(key) : nullptr;
+        if (!wanted || !actual || *wanted != *actual) return false;
+      }
+      return true;
+    }, weak_factory_.GetWeakPtr(), authority->GetWeakPtr(), *receipt,
+       original_window->GetWeakPtr(), connection_generation, params.Clone());
+    if (!current.Run()) { std::move(callback).Run(NativeFault("target_detached", "Original page capture identity retired")); return; }
+    aux::NativePersonCaptureController::CreateForWebContents(page);
+    auto controller = aux::NativePersonCaptureController::FromWebContents(page)->GetWeakPtr();
+    const auto operation = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    native_person_captures_.emplace(operation, controller);
+    controller->Capture(params.Clone(), current, base::BindOnce([](base::WeakPtr<AuxRuntimeHost> owner,
+        std::string operation, base::RepeatingCallback<bool()> current,
+        base::OnceCallback<void(base::DictValue)> callback, base::DictValue reply) {
+      const bool original_slot = owner && owner->native_person_captures_.erase(operation) == 1;
+      if (!original_slot || !current.Run()) {
+        if (reply.FindDict("error")) std::move(callback).Run(std::move(reply));
+        else std::move(callback).Run(NativeFault("target_detached", "Original page capture retired"));
+        return;
+      }
+      std::move(callback).Run(std::move(reply));
+    }, weak_factory_.GetWeakPtr(), operation, current, std::move(callback)));
+    return;
+  }
+
+  aux::NativePersonObserverController::CreateForWebContents(page);
+  auto reader = aux::NativePersonObserverController::FromWebContents(page)->GetWeakPtr();
+  // Private operation identity survives controller callback invalidation;
+  // a late original reply must never remove a replacement slot.
+  const auto operation_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  native_person_reads_.emplace(operation_id, reader);
+  reader->Read(connection_generation, request->Clone(), base::BindOnce(
+      [](base::WeakPtr<AuxRuntimeHost> owner,
+         base::WeakPtr<aux::EgressController> authority,
+         aux::NativePersonReadReceipt receipt, std::string operation_id, std::string session_id,
+         uint64_t generation, base::OnceCallback<void(base::DictValue)> callback,
+         base::DictValue reply) {
+        if (!owner) {
+          std::move(callback).Run(NativeFault("target_detached", "Page host closed"));
+          return;
+        }
+        const bool slot = owner->native_person_reads_.erase(operation_id) == 1;
+        if (!slot || owner->shutting_down_ ||
+            owner->admitted_native_generation_ != generation ||
+            generation <= owner->retired_native_generation_ ||
+            !authority || !authority->MayReadPerson(receipt)) {
+          std::move(callback).Run(NativeFault("target_detached", "Page read retired"));
+          return;
+        }
+        if (auto* result = reply.FindDict("result"))
+          result->Set("sessionId", session_id);
+        std::move(callback).Run(std::move(reply));
+      }, weak_factory_.GetWeakPtr(), authority->GetWeakPtr(), std::move(*receipt),
+      operation_id, *session_id, connection_generation, std::move(callback)));
+}
+void AuxRuntimeHost::FailNativeCreatorCreation(base::DictValue failure,
+    base::DictValue proof, uint64_t generation,
+    std::shared_ptr<std::atomic_bool> cancelled,
+    base::OnceCallback<void(base::DictValue)> done) {
+  if (proof.empty() || !generation || generation != admitted_native_generation_ ||
+      generation <= retired_native_generation_ || shutting_down_) {
+    auto* error = failure.FindDict("error");
+    if (error) {
+      const auto* primary = error->FindString("message");
+      error->Set("message", (primary ? *primary : "Original task creation failed") +
+          std::string("; original temporary-page cleanup remains unresolved."));
+    }
+    std::move(done).Run(std::move(failure));
+    return;
+  }
+  aux::EgressController::ForProfile(profile_)->CloseCreatorPage(
+      base::DictValue().Set("proof", std::move(proof)), generation, std::move(cancelled),
+      base::BindOnce([](base::DictValue original_failure,
+          base::OnceCallback<void(base::DictValue)> done, base::DictValue cleanup) {
+        const auto* result = cleanup.FindDict("result");
+        if (!result || !result->FindBool("closed").value_or(false)) {
+          auto* error = original_failure.FindDict("error");
+          if (error) {
+            const auto* primary = error->FindString("message");
+            const auto* cleanup_error = cleanup.FindDict("error");
+            const auto* cleanup_message = cleanup_error ? cleanup_error->FindString("message") : nullptr;
+            error->Set("message", (primary ? *primary : "Original task creation failed") +
+                std::string("; original temporary-page cleanup remains unresolved: ") +
+                (cleanup_message ? *cleanup_message : "native closure was not acknowledged"));
+            error->Set("cleanupFailure", std::move(cleanup));
+          }
+        }
+        std::move(done).Run(std::move(original_failure));
+      }, std::move(failure), std::move(done)));
+}
+void AuxRuntimeHost::HandleNativeCreatorCreateCall(const base::DictValue& params,
+    uint64_t generation, std::shared_ptr<std::atomic_bool> cancelled,
+    base::OnceCallback<void(base::DictValue)> done) {
+  if (cancelled->load() || shutting_down_ || !generation || generation != admitted_native_generation_ ||
+      generation <= retired_native_generation_) {
+    std::move(done).Run(NativeFault("ref_stale", "Original creation connection was retired")); return;
+  }
+  auto reply = HandleNativeTabsCall("native.createAgentPage", params, generation);
+  if (auto* cleanup = reply.FindDict("_creatorCleanup")) {
+    auto proof = cleanup->Clone();
+    reply.Remove("_creatorCleanup");
+    FailNativeCreatorCreation(std::move(reply), std::move(proof), generation,
+        std::move(cancelled), std::move(done));
+    return;
+  }
+  const auto* result = reply.FindDict("result");
+  const auto* page_id = result ? result->FindString("pageId") : nullptr;
+  const auto* creation_id = result ? result->FindString("creationId") : nullptr;
+  if (!page_id || !creation_id) { std::move(done).Run(std::move(reply)); return; }
+  aux::EgressController::ForProfile(profile_)->WaitCreatorReady(*page_id, *creation_id, generation,
+      base::BindOnce([](base::WeakPtr<AuxRuntimeHost> owner, uint64_t generation,
+          std::shared_ptr<std::atomic_bool> cancelled, base::DictValue original_reply,
+          base::OnceCallback<void(base::DictValue)> done, bool ready) {
+        if (!ready || !owner || cancelled->load() || owner->shutting_down_ ||
+            owner->admitted_native_generation_ != generation || generation <= owner->retired_native_generation_) {
+          auto failure = NativeFault("ref_stale", "Original blank creation did not commit under its authority");
+          if (owner) {
+            const auto* result = original_reply.FindDict("result");
+            const auto* page_id = result ? result->FindString("pageId") : nullptr;
+            const auto* creation_id = result ? result->FindString("creationId") : nullptr;
+            base::DictValue proof;
+            if (page_id && creation_id) {
+              auto cleanup = aux::EgressController::ForProfile(owner->profile_)->CreatorCleanupProof(
+                  base::DictValue().Set("pageId", *page_id).Set("creationId", *creation_id), generation);
+              if (const auto* value = cleanup.FindDict("result")) proof = value->Clone();
+            }
+            owner->FailNativeCreatorCreation(std::move(failure), std::move(proof), generation,
+                std::move(cancelled), std::move(done));
+          } else std::move(done).Run(std::move(failure));
+          return;
+        }
+        std::move(done).Run(std::move(original_reply));
+      }, weak_factory_.GetWeakPtr(), generation, std::move(cancelled), std::move(reply), std::move(done)));
+}
+void AuxRuntimeHost::HandleNativeCreatorCloseCall(const base::DictValue& params,
+    uint64_t generation, std::shared_ptr<std::atomic_bool> cancelled,
+    base::OnceCallback<void(base::DictValue)> done) {
+  if (cancelled->load() || shutting_down_ || !generation || generation != admitted_native_generation_ ||
+      generation <= retired_native_generation_) {
+    std::move(done).Run(NativeFault("ref_stale", "Original cleanup connection was retired")); return;
+  }
+  aux::EgressController::ForProfile(profile_)->CloseCreatorPage(params, generation, std::move(cancelled), std::move(done));
+}
+void AuxRuntimeHost::HandleNativeRecorderCall(
+    const std::string& method, const base::DictValue& params,
+    uint64_t connection_generation,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  const auto* page_id = params.FindString("pageId");
+  const auto* recorder_id = params.FindString("recorderId");
+  const bool start = method == "native.recorderStart";
+  if (shutting_down_ || !connection_generation ||
+      admitted_native_generation_ != connection_generation ||
+      connection_generation <= retired_native_generation_) {
+    std::move(callback).Run(NativeFault("target_detached", "Recording connection retired"));
+    return;
+  }
+  if (!page_id || !aux::PageIdentity::IsValid(*page_id) ||
+      params.size() != (start ? 1u : 2u) ||
+      (!start && (!recorder_id || !base::Uuid::ParseLowercase(*recorder_id).is_valid())) ||
+      (!start && method != "native.recorderDrain" && method != "native.recorderStop")) {
+    std::move(callback).Run(NativeFault("invalid_params", "Invalid fixed recording request"));
+    return;
+  }
+  auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+  auto* page = catalog ? catalog->FindPage(*page_id) : nullptr;
+  if (!page) {
+    std::move(callback).Run(NativeFault("target_detached", "Recording tab closed"));
+    return;
+  }
+  if (start) {
+    if (native_recorder_) {
+      std::move(callback).Run(NativeFault("conflict", "This Profile already records a tab"));
+      return;
+    }
+    aux::NativeRecorderController::CreateForWebContents(page);
+    native_recorder_ = aux::NativeRecorderController::FromWebContents(page)->GetWeakPtr();
+    native_recorder_page_id_ = *page_id;
+    ++native_recorder_session_generation_;
+  }
+  if (!native_recorder_ || native_recorder_page_id_ != *page_id ||
+      aux::NativeRecorderController::FromWebContents(page) != native_recorder_.get()) {
+    std::move(callback).Run(NativeFault("target_detached", "Recording receipt changed"));
+    return;
+  }
+  auto recorder = native_recorder_;
+  if (start) {
+    recorder->retired_callback_ = base::BindOnce(
+        [](base::WeakPtr<AuxRuntimeHost> owner,
+           base::WeakPtr<aux::NativeRecorderController> recorder,
+           uint64_t connection, uint64_t recording_generation) {
+          if (!owner || owner->admitted_native_generation_ != connection ||
+              owner->native_recorder_session_generation_ != recording_generation ||
+              owner->native_recorder_.get() != recorder.get()) return;
+          // No external callback here. A new recording increments the generation
+          // before installing, so its slot cannot be cleared by this receipt.
+          owner->native_recorder_.reset();
+          owner->native_recorder_page_id_.clear();
+        }, weak_factory_.GetWeakPtr(), recorder, connection_generation,
+        native_recorder_session_generation_);
+  }
+  auto done = base::BindOnce(
+      [](base::WeakPtr<AuxRuntimeHost> owner,
+         base::WeakPtr<aux::NativeRecorderController> recorder,
+         std::string page_id, uint64_t generation, uint64_t recording_generation, bool start, bool stop,
+         base::OnceCallback<void(base::DictValue)> callback,
+         base::DictValue reply) {
+        if (!owner || owner->shutting_down_ ||
+            owner->admitted_native_generation_ != generation ||
+            owner->native_recorder_session_generation_ != recording_generation) {
+          std::move(callback).Run(NativeFault("target_detached", "Recording connection changed"));
+          return;
+        }
+        const bool current = recorder && owner->native_recorder_.get() == recorder.get() &&
+                             owner->native_recorder_page_id_ == page_id;
+        const bool retired = !owner->native_recorder_ && owner->native_recorder_page_id_.empty();
+        if (!current && !(retired && (reply.Find("error") || stop))) {
+          std::move(callback).Run(NativeFault("target_detached", "Recording receipt changed"));
+          return;
+        }
+        if (!recorder || !recorder->BoundToConnection(generation) ||
+            (start && reply.Find("error")) || (stop && reply.Find("result"))) {
+          owner->native_recorder_.reset();
+          owner->native_recorder_page_id_.clear();
+          ++owner->native_recorder_session_generation_;
+        }
+        std::move(callback).Run(std::move(reply));
+      },
+      weak_factory_.GetWeakPtr(), recorder, *page_id, connection_generation,
+      native_recorder_session_generation_, start, method == "native.recorderStop", std::move(callback));
+  if (start)
+    recorder->Start(connection_generation, std::move(done));
+  else if (method == "native.recorderDrain")
+    recorder->Drain(connection_generation, *recorder_id, std::move(done));
+  else
+    recorder->Stop(connection_generation, *recorder_id, std::move(done));
+}
+
+void AuxRuntimeHost::HandleNativeCdpAttachment(
+    const base::DictValue& params, uint64_t connection_generation,
+    std::shared_ptr<std::atomic_bool> cancelled,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  const auto* page_id = params.FindString("pageId");
+  const auto* lease_id = params.FindString("leaseId");
+  const auto acknowledged_expiry = params.FindDouble("acknowledgedExpiresAt");
+  if (!acknowledged_expiry || !std::isfinite(*acknowledged_expiry) ||
+      *acknowledged_expiry <= 0 || *acknowledged_expiry > 9007199254740991.0 ||
+      std::floor(*acknowledged_expiry) != *acknowledged_expiry || shutting_down_ || cancelled->load() || !connection_generation ||
+      admitted_native_generation_ != connection_generation || params.size() != 3 ||
+      !page_id || page_id->empty() || !lease_id || lease_id->empty()) {
+    std::move(callback).Run(NativeFault("ref_stale", "Original attachment caller is unavailable"));
+    return;
+  }
+  cdp_broker_->WaitForAttachment(*page_id, *lease_id, *acknowledged_expiry, connection_generation,
+      base::BindRepeating([](base::WeakPtr<AuxRuntimeHost> host, uint64_t generation,
+                            std::shared_ptr<std::atomic_bool> cancelled) {
+        return host && !host->shutting_down_ && !cancelled->load() &&
+            host->admitted_native_generation_ == generation;
+      }, weak_factory_.GetWeakPtr(), connection_generation, std::move(cancelled)),
+      std::move(callback));
+}
+
+
+void AuxRuntimeHost::HandleNativeCdpNavigationReceipt(
+    const base::DictValue& params, uint64_t connection_generation,
+    std::shared_ptr<std::atomic_bool> cancelled,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  const auto* page_id = params.FindString("pageId");
+  const auto* attachment_id = params.FindString("attachmentId");
+  const auto command_id = params.FindInt("commandId");
+  if (shutting_down_ || cancelled->load() || !connection_generation ||
+      admitted_native_generation_ != connection_generation ||
+      params.size() != 3 || !page_id || !attachment_id || !command_id || *command_id < 1) {
+    std::move(callback).Run(NativeFault("ref_stale", "Original navigation receipt caller is unavailable"));
+    return;
+  }
+  // Ready-only TAKE never blocks the Worker that processes egress/consent.
+  auto result = cdp_broker_->TakeReadyNavigationReceipt(*page_id, *attachment_id,
+      *command_id, connection_generation);
+  std::move(callback).Run(std::move(result));
+}
