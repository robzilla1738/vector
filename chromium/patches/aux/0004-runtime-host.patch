+++ b/chrome/browser/ui/aux/foundation_models.swift
@@ -0,0 +1,67 @@
+// Copyright 2026 The Aux Authors. BSD-3-Clause.
+import Foundation
+import FoundationModels
+
+@objc(AuxFoundationRequest)
+@MainActor
+public final class AuxFoundationRequest: NSObject {
+  private var operation: Task<String, Error>?
+  private var observer: Task<Void, Never>?
+  private var retired = false
+
+  @objc public static func availability() -> String {
+    guard #available(macOS 26.0, *) else { return "os_unsupported" }
+    switch SystemLanguageModel.default.availability {
+    case .available: return "available"
+    case .unavailable(.deviceNotEligible): return "device_not_eligible"
+    case .unavailable(.appleIntelligenceNotEnabled): return "intelligence_disabled"
+    case .unavailable(.modelNotReady): return "model_not_ready"
+    case .unavailable: return "unavailable"
+    @unknown default: return "unavailable"
+    }
+  }
+
+  @objc(beginWithInstructions:prompt:maximumResponseTokens:current:completion:)
+  public func begin(
+    instructions: String,
+    prompt: String,
+    maximumResponseTokens: Int,
+    current: @escaping () -> Bool,
+    completion: @escaping (String?, String?) -> Void
+  ) {
+    precondition(operation == nil && observer == nil)
+    let original = Task<String, Error> { @MainActor in
+      guard #available(macOS 26.0, *), Self.availability() == "available" else {
+        throw NativeFoundationError.unavailable
+      }
+      try Task.checkCancellation()
+      guard !self.retired && current() else { throw CancellationError() }
+      let session = LanguageModelSession(model: .default, tools: [], instructions: instructions)
+      let options = GenerationOptions(maximumResponseTokens: maximumResponseTokens)
+      let response = try await session.respond(to: prompt, options: options)
+      try Task.checkCancellation()
+      guard !self.retired && current() else { throw CancellationError() }
+      return response.content
+    }
+    operation = original
+    // Await the SAME original Task; cancellation alone is never a join receipt.
+    observer = Task { @MainActor in
+      let result = await original.result
+      self.operation = nil
+      switch result {
+      case .success(let content):
+        completion(content, nil)
+      case .failure(let error):
+        completion(nil, error is CancellationError ? "cancelled" : "backend_unavailable")
+      }
+      self.observer = nil
+    }
+  }
+
+  @objc public func retire() {
+    retired = true
+    operation?.cancel()
+  }
+}
+
+private enum NativeFoundationError: Error { case unavailable }
diff --git a/chrome/browser/ui/aux/native_copilot_session.cc b/chrome/browser/ui/aux/native_copilot_session.cc
new file mode 100644
index 0000000..708ce3c
--- /dev/null
+++ b/chrome/browser/ui/aux/native_copilot_session.cc
@@ -0,0 +1,278 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_copilot_session.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace aux {
+namespace {
+base::DictValue Fault(std::string message) {
+  return base::DictValue().Set("error",
+                               base::DictValue()
+                                   .Set("code", "operation_uncertain")
+                                   .Set("message", std::move(message)));
+}
+}  // namespace
+
+class NativeCopilotSession::Worker {
+ public:
+  Worker(std::string request_id,
+         std::shared_ptr<std::atomic<OwnedHeadlessAdmission>> admission);
+  ~Worker();
+
+  base::DictValue Prepare() {
+    return Identity().Set("state", "prepared").Set("launched", false);
+  }
+  base::DictValue Start(OwnedCopilotLaunch launch,
+                        std::shared_ptr<std::atomic<OwnedHeadlessAdmission>>
+                            execution_admission) {
+    // UI committed the ONE execute admission before this sequential task.
+    // Timeout/source retirement and process acceptance share this exact word.
+    admission_ = std::move(execution_admission);
+    auto started =
+        process_->Start(std::move(launch),
+                        base::TimeTicks::Now() + base::Seconds(20), admission_);
+    launched_ = process_->has_cleanup_debt();
+    if (!started.has_value() || admission_->load(std::memory_order_acquire) ==
+                                    OwnedHeadlessAdmission::kRetired) {
+      const std::string error = started.has_value()
+                                    ? "Original helper owner retired"
+                                    : started.error();
+      auto result = Identity().Set("state", "failed").Set("error", error);
+      auto cleanup = Stop();
+      const auto* receipt = cleanup.FindDict("result");
+      result.Set("joined",
+                 receipt && receipt->FindBool("joined").value_or(false));
+      return result;
+    }
+    return Identity().Set("state", "started").Set("joined", false);
+  }
+  base::DictValue Endpoint() {
+    if (admission_->load(std::memory_order_acquire) !=
+        OwnedHeadlessAdmission::kAccepted) {
+      return Fault("Original helper admission retired");
+    }
+    auto endpoint = process_->LoopbackUri();
+    if (!endpoint.has_value()) {
+      return Fault(endpoint.error());
+    }
+    if (admission_->load(std::memory_order_acquire) !=
+        OwnedHeadlessAdmission::kAccepted) {
+      return Fault("Original helper admission retired");
+    }
+    auto result = Identity().Set("ready", endpoint->has_value());
+    if (endpoint->has_value()) {
+      result.Set("uri", **endpoint);
+    }
+    return base::DictValue().Set("result", std::move(result));
+  }
+  base::DictValue Stop() {
+    admission_->exchange(OwnedHeadlessAdmission::kRetired,
+                         std::memory_order_acq_rel);
+    // No spawn is an explicit reduction receipt, never an invented exit code.
+    if (!launched_) {
+      return base::DictValue().Set(
+          "result", Identity().Set("joined", true).Set("launched", false));
+    }
+    auto joined = process_->Stop(base::TimeTicks::Now() + base::Seconds(10));
+    if (!joined.has_value()) {
+      return Fault(joined.error());
+    }
+    return base::DictValue().Set("result",
+                                 Identity()
+                                     .Set("joined", true)
+                                     .Set("launched", true)
+                                     .Set("exitCode", joined->exit_code)
+                                     .Set("exitSignal", joined->exit_signal));
+  }
+
+ private:
+  base::DictValue Identity() const {
+    return base::DictValue()
+        .Set("requestId", request_id_)
+        .Set("helperId", process_->handle().ToString());
+  }
+  const std::string request_id_;
+  std::shared_ptr<std::atomic<OwnedHeadlessAdmission>> admission_;
+  const scoped_refptr<NativeOwnedHeadlessProcess> process_;
+  bool launched_ = false;
+};
+
+NativeCopilotSession::Worker::Worker(
+    std::string request_id,
+    std::shared_ptr<std::atomic<OwnedHeadlessAdmission>> admission)
+    : request_id_(std::move(request_id)),
+      admission_(std::move(admission)),
+      process_(base::MakeRefCounted<NativeOwnedHeadlessProcess>()) {}
+NativeCopilotSession::Worker::~Worker() = default;
+
+NativeCopilotSession::NativeCopilotSession(
+    content::WebContents* original_contents,
+    std::string token,
+    std::string request_id,
+    uint64_t original_generation,
+    std::string account_id,
+    std::string authorization_generation,
+    std::string credential_revision,
+    std::shared_ptr<std::atomic<OwnedHeadlessAdmission>> admission,
+    base::RepeatingCallback<bool()> source_current)
+    : base::RefCountedDeleteOnSequence<NativeCopilotSession>(
+          base::SequencedTaskRunner::GetCurrentDefault()),
+      content::WebContentsObserver(original_contents),
+      token_(std::move(token)),
+      request_id_(std::move(request_id)),
+      original_generation_(original_generation),
+      account_id_(std::move(account_id)),
+      authorization_generation_(std::move(authorization_generation)),
+      credential_revision_(std::move(credential_revision)),
+      admission_(std::move(admission)),
+      source_current_(std::move(source_current)),
+      worker_(
+          base::ThreadPool::CreateSequencedTaskRunner(
+              {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN}),
+          request_id_,
+          admission_) {}
+NativeCopilotSession::~NativeCopilotSession() = default;
+
+bool NativeCopilotSession::Current() {
+  if (admission_->load(std::memory_order_acquire) ==
+          OwnedHeadlessAdmission::kRetired ||
+      !source_current_.Run()) {
+    Retire();
+    return false;
+  }
+  return true;
+}
+void NativeCopilotSession::Prepare(Reply reply) {
+  CheckSource();
+  worker_.AsyncCall(&Worker::Prepare)
+      .Then(base::BindOnce(
+          [](scoped_refptr<NativeCopilotSession> self, Reply reply,
+             base::DictValue result) {
+            if (!self->Current()) {
+              std::move(reply).Run(
+                  Fault("Original Copilot reservation retired"));
+              return;
+            }
+            const auto* handle = result.FindString("helperId");
+            CHECK(handle);
+            self->helper_id_ = *handle;
+            self->prepared_ = true;
+            std::move(reply).Run(
+                base::DictValue().Set("result", std::move(result)));
+          },
+          base::WrapRefCounted(this), std::move(reply)));
+}
+void NativeCopilotSession::Start(
+    OwnedCopilotLaunch launch,
+    std::unique_ptr<ScopedProfileKeepAlive> profile_lease,
+    std::shared_ptr<std::atomic<OwnedHeadlessAdmission>> execution_admission,
+    std::shared_ptr<base::ScopedTempDir> private_directory,
+    Reply reply) {
+  CHECK(profile_lease && prepared_ && !execution_requested_);
+  execution_requested_ = true;
+  // Only the acknowledged reservation may make this UI-serialized transfer.
+  // Never keep prepare's timed-out request state as execution authority.
+  admission_ = std::move(execution_admission);
+  profile_lease_ = std::move(profile_lease);
+  private_directory_ = std::move(private_directory);
+  retained_ = this;
+  Current();  // Prepare already started the one original-source monitor.
+  worker_.AsyncCall(&Worker::Start)
+      .WithArgs(std::move(launch), admission_)
+      .Then(base::BindOnce(&NativeCopilotSession::OnStart,
+                           base::WrapRefCounted(this), std::move(reply)));
+}
+void NativeCopilotSession::OnStart(Reply reply, base::DictValue result) {
+  if (const auto* handle = result.FindString("helperId")) {
+    helper_id_ = *handle;
+  }
+  joined_ = result.FindBool("joined").value_or(false);
+  if (!Current()) {
+    result.Set("state", "failed");
+  }
+  if (joined_) {
+    private_directory_.reset();
+    profile_lease_.reset();  // UI sequence, only after real reduction receipt.
+    retained_.reset();
+  }
+  std::move(reply).Run(base::DictValue().Set("result", std::move(result)));
+}
+void NativeCopilotSession::Endpoint(Reply reply) {
+  if (!Current()) {
+    std::move(reply).Run(Fault("Original helper owner retired"));
+    return;
+  }
+  worker_.AsyncCall(&Worker::Endpoint)
+      .Then(base::BindOnce(
+          [](scoped_refptr<NativeCopilotSession> self, Reply reply,
+             base::DictValue result) {
+            if (!self->Current()) {
+              result = Fault("Original helper owner retired");
+            }
+            std::move(reply).Run(std::move(result));
+          },
+          base::WrapRefCounted(this), std::move(reply)));
+}
+void NativeCopilotSession::Stop(Reply reply) {
+  admission_->exchange(OwnedHeadlessAdmission::kRetired,
+                       std::memory_order_acq_rel);
+  worker_.AsyncCall(&Worker::Stop)
+      .Then(base::BindOnce(&NativeCopilotSession::OnStop,
+                           base::WrapRefCounted(this), std::move(reply)));
+}
+void NativeCopilotSession::OnStop(Reply reply, base::DictValue result) {
+  if (const auto* receipt = result.FindDict("result")) {
+    if (const auto* handle = receipt->FindString("helperId")) {
+      helper_id_ = *handle;
+    }
+    joined_ = receipt->FindBool("joined").value_or(false);
+  }
+  if (joined_) {
+    Observe(nullptr);
+    private_directory_.reset();
+    profile_lease_.reset();
+    retained_.reset();
+  }
+  // Failure retains the exact process/session and lease. Explicit retry is
+  // reduction-only; no new helper may sidestep this account's unjoined debt.
+  std::move(reply).Run(std::move(result));
+}
+void NativeCopilotSession::Reconcile() {
+  CHECK(joined_);
+  reconciled_ = true;
+}
+void NativeCopilotSession::Retire() {
+  admission_->exchange(OwnedHeadlessAdmission::kRetired,
+                       std::memory_order_acq_rel);
+  if (!retirement_stop_queued_ && !joined_) {
+    retirement_stop_queued_ = true;
+    Stop(base::BindOnce([](base::DictValue) {}));
+  }
+}
+void NativeCopilotSession::CheckSource() {
+  if (!joined_ && Current()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&NativeCopilotSession::CheckSource,
+                       weak_factory_.GetWeakPtr()),
+        base::Milliseconds(50));
+  }
+}
+void NativeCopilotSession::PrimaryPageChanged(content::Page&) {
+  Current();
+}
+void NativeCopilotSession::RenderFrameDeleted(content::RenderFrameHost*) {
+  Current();
+}
+void NativeCopilotSession::WebContentsDestroyed() {
+  Retire();
+}
+}  // namespace aux
