+AuxRuntimeHost* AuxRuntimeHost::ForProfile(Profile* profile) {
+  if (!profile || profile->IsGuestSession()) {
+    return nullptr;
+  }
+  auto* host =
+      static_cast<AuxRuntimeHost*>(profile->GetUserData(&kAuxRuntimeHostKey));
+  if (!host) {
+    if (profile->ShutdownStarted())
+      return nullptr;
+    auto created = std::unique_ptr<AuxRuntimeHost>(new AuxRuntimeHost(profile));
+    host = created.get();
+    profile->SetUserData(&kAuxRuntimeHostKey, std::move(created));
+    // Queue the policy snapshot before any user API can create pages.
+    aux::ZapController::ForProfile(profile)->EnsureReady(
+        base::BindOnce([](bool) {}));
+  }
+  return host;
+}
+
+std::string AuxRuntimeHost::ProfileId(Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile->IsOffTheRecord())
+    return profile->GetPath().BaseName().AsUTF8Unsafe();
+  auto* identity = static_cast<PrivateRuntimeIdentity*>(
+      profile->GetUserData(&kPrivateRuntimeIdentityKey));
+  if (!identity) {
+    auto owned = std::make_unique<PrivateRuntimeIdentity>();
+    identity = owned.get();
+    profile->SetUserData(&kPrivateRuntimeIdentityKey, std::move(owned));
+  }
+  return identity->id;
+}
