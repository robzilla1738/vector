+bool AuxRuntimeHost::SupportsPrivateMethod(std::string_view method) {
+  return method != "bookmarksInvoke" && method != "onBookmarksChanged" &&
+         method != "historyInvoke" && method != "onHistoryChanged" &&
+         method != "memorySaverGet" && method != "memorySaverSet" &&
+         method != "native.memorySaverGet" && method != "native.memorySaverSet" &&
+         method != "organizationSnapshot" && method != "organizationCommit" &&
+         !method.starts_with("native.foundationModels") &&
+         method != "native.spaceBindingsSet" &&
+         !method.starts_with("native.browserImport") &&
+         !method.starts_with("native.recorder") &&
+         !method.starts_with("native.credential") &&
+         method != "native.bookmarksInvoke" &&
+         method != "native.historyClear" && method != "native.historyImport" &&
+         method != "native.historyRemove" &&
+         method != "native.captureReadablePage" &&
+         method != "native.organizationSnapshot" &&
+         method != "native.liveFolderSources" &&
+         method != "native.fillSavedPassword" &&
+         method != "native.setCookies" &&
+         method != "native.profileStorageRoot" &&
+         method != "native.profileStorageFactor" &&
+         method != "native.recoveryOwnerAuth";
+}
