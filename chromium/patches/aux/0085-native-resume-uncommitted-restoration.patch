+void LoadPersonRestoredTab(Profile* profile, content::WebContents* contents) {
+  const auto* identity = PageIdentity::FromWebContents(contents);
+  if (identity && identity->runtime_owned()) return;
+  auto& controller = contents->GetController();
+  const auto* entry = controller.GetLastCommittedEntry();
+  auto* frame = contents->GetPrimaryMainFrame();
+  // Starting a restored navigation clears NeedsReload before it commits. If
+  // that first load was interrupted, restore the cached entry without inventing
+  // a new URL or replacing a loaded document.
+  if (!controller.NeedsReload() && !contents->IsLoading() && frame &&
+      frame->GetLastCommittedURL().is_empty() && entry && entry->IsRestored() &&
+      !entry->IsInitialEntry() && entry->GetURL().SchemeIsHTTPOrHTTPS()) {
+    EgressRequestContext context;
+    context.document = frame->GetWeakDocumentPtr();
+    context.page_id = PageIdentity::GetOrCreate(profile, contents);
+    if (!EgressController::ForProfile(profile)->IsProtected(context))
+      controller.SetNeedsReload();
+  }
+  controller.LoadIfNecessary();
+}
 
