+constexpr int64_t kMaxAuxCopiedImageBytes = 64 * 1024 * 1024;
+
+struct AuxStoredImageBytes {
+  std::vector<uint8_t> bytes;
+  std::string error_code;
+  std::string error_message;
+};
+
+AuxStoredImageBytes ReadAuxStoredImage(
+    base::FilePath root,
+    base::FilePath path,
+    int64_t expected_size,
+    std::string expected_sha256,
+    const std::shared_ptr<std::atomic_bool>& cancelled) {
+  if (cancelled->load())
+    return {{}, "cancelled", "Image copy was cancelled"};
+  if (expected_size <= 0 || expected_size > kMaxAuxCopiedImageBytes) {
+    return {{}, "invalid_argument",
+            "This image is too large to copy. Save the original instead"};
+  }
+  auto source = OpenAuxArtifact(root, path, expected_size);
+  if (!source)
+    return {{}, "io_error", "The original image file is unavailable"};
+  std::vector<uint8_t> bytes(static_cast<size_t>(expected_size));
+  crypto::hash::Hasher hash(crypto::hash::kSha256);
+  size_t offset = 0;
+  while (offset < bytes.size()) {
+    if (cancelled->load())
+      return {{}, "cancelled", "Image copy was cancelled"};
+    const auto part = base::span(bytes).subspan(
+        offset, std::min<size_t>(64 * 1024, bytes.size() - offset));
+    const auto read = source->ReadAtCurrentPos(part);
+    if (!read || !*read)
+      return {{}, "io_error", "The original image file could not be read"};
+    hash.Update(part.first(*read));
+    offset += *read;
+  }
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hash.Finish(digest);
+  if (source->GetLength() != expected_size ||
+      (!expected_sha256.empty() &&
+       base::HexEncodeLower(digest) != expected_sha256)) {
+    return {{}, "ref_stale", "The original image file changed"};
+  }
+  const std::string_view signature(
+      reinterpret_cast<const char*>(bytes.data()), bytes.size());
+  if (!signature.starts_with("\x89PNG\r\n\x1a\n") &&
+      !signature.starts_with("\xff\xd8\xff") &&
+      !(signature.size() >= 12 && signature.starts_with("RIFF") &&
+        signature.substr(8, 4) == "WEBP")) {
+    return {{}, "invalid_argument",
+            "This saved file is not a PNG, JPEG, or WebP image"};
+  }
+  return {std::move(bytes), {}, {}};
+}
