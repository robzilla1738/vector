+void WebUIBrowserUI::BeginAuxImageCopy(std::string artifact_id,
+                                     RequestCallback callback) {
+  auto* runtime = AuxRuntimeHost::ForProfile(browser_->GetProfile());
+  if (!runtime) {
+    std::move(callback).Run(false, "", "backend_unavailable",
+                            "Aux Runtime is unavailable");
+    return;
+  }
+  const auto window = browser_->GetWeakPtr();
+  const auto document = web_ui()->GetRenderFrameHost()->GetWeakDocumentPtr();
+  auto current = base::BindRepeating(
+      [](base::WeakPtr<WebUIBrowserUI> self,
+         base::WeakPtr<BrowserWindowInterface> window,
+         content::WeakDocumentPtr document) {
+        auto* frame = document.AsRenderFrameHostIfValid();
+        return self && window && self->browser_ == window.get() &&
+               !window->IsDeleteScheduled() && frame && frame->IsActive() &&
+               frame->IsRenderFrameLive() &&
+               frame == self->web_ui()->GetRenderFrameHost() &&
+               self->IsAuthorizedAuxDocument();
+      },
+      weak_factory_.GetWeakPtr(), window, document);
+  if (!current.Run()) {
+    std::move(callback).Run(false, "", "ref_stale",
+                            "Original image copy window is unavailable");
+    return;
+  }
+  const auto runtime_owner = runtime->GetWeakPtr();
+  auto next = std::make_unique<AuxStoredImageCopy>(
+      web_ui()->GetWebContents(), window,
+      browser_->GetProfile()->IsOffTheRecord(), std::move(current),
+      std::move(callback));
+  const auto weak_copy = next->GetWeakPtr();
+  auto previous = std::exchange(image_copy_, std::move(next));
+  if (previous)
+    previous->Cancel();
+  // A cancelled callback may reenter and replace this request again.
+  if (!weak_copy)
+    return;
+  if (!runtime_owner) {
+    weak_copy->Cancel();
+    return;
+  }
+  weak_copy->Start(runtime_owner.get(), window, document, std::move(artifact_id));
+}
+
+void WebUIBrowserUI::RetireAuxImageCopy() {
+  auto retired = std::move(image_copy_);
+  if (retired)
+    retired->Cancel();
+}
