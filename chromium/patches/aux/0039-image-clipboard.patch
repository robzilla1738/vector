+// One native human copy owns its source claim, decoder and clipboard witness.
+// No source path or encoded image is sent back through the shell transport.
+class AuxStoredImageCopy final : public content::WebContentsObserver {
+ public:
+  using Callback = aux::mojom::ShellHost::RequestCallback;
+
+  AuxStoredImageCopy(content::WebContents* contents,
+                     base::WeakPtr<BrowserWindowInterface> window,
+                     bool private_profile,
+                     base::RepeatingCallback<bool()> current,
+                     Callback callback)
+      : content::WebContentsObserver(contents),
+        private_profile_(private_profile),
+        current_(std::move(current)),
+        callback_(std::move(callback)),
+        clipboard_sequence_(
+            ui::Clipboard::GetForCurrentThread()->GetSequenceNumber(
+                ui::ClipboardBuffer::kCopyPaste)) {
+    window_closed_ = window->RegisterBrowserDidClose(base::BindRepeating(
+        [](AuxStoredImageCopy* copy, BrowserWindowInterface*) {
+          copy->OwnerRetired();
+        },
+        base::Unretained(this)));
+  }
+
+  ~AuxStoredImageCopy() override { Cancel(); }
+
+  base::WeakPtr<AuxStoredImageCopy> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  void Start(AuxRuntimeHost* runtime,
+             base::WeakPtr<BrowserWindowInterface> window,
+             content::WeakDocumentPtr document,
+             std::string artifact_id) {
+    if (!Current()) {
+      OwnerRetired();
+      return;
+    }
+    deadline_.Start(
+        FROM_HERE, base::Seconds(30),
+        base::BindOnce(&AuxStoredImageCopy::Finish, weak_factory_.GetWeakPtr(),
+                       false, "timeout",
+                       "Image copy timed out. The clipboard was not changed"));
+    runtime->ExportArtifactFromWindow(
+        std::move(window), std::move(document), std::move(artifact_id),
+        base::BindOnce(&AuxStoredImageCopy::OnDescriptor,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void Cancel() { Finish(false, "cancelled", "Image copy was cancelled"); }
+
+ private:
+  bool Current() const { return callback_ && current_.Run(); }
+
+  void OwnerRetired() {
+    Finish(false, "ref_stale", "Original image copy window is unavailable");
+  }
+
+  void PrimaryPageChanged(content::Page&) override {
+    if (!Current())
+      OwnerRetired();
+  }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    OwnerRetired();
+  }
+  void WebContentsDestroyed() override { OwnerRetired(); }
+
+  void OnDescriptor(AuxRuntimeHost::Response response,
+                    base::FilePath root,
+                    base::ScopedClosureRunner release) {
+    if (!Current()) {
+      OwnerRetired();
+      return;
+    }
+    release_ = std::move(release);
+    if (!response.ok) {
+      Finish(false, response.error_code, response.error_message);
+      return;
+    }
+    const auto data = base::JSONReader::ReadDict(
+        response.result_json, base::JSON_PARSE_RFC);
+    const auto* path = data ? data->FindString("path") : nullptr;
+    const auto size = data ? data->FindDouble("size") : std::nullopt;
+    const auto* digest = data ? data->FindString("sha256") : nullptr;
+    if (!path || path->empty() || root.empty() || !size ||
+        !std::isfinite(*size) || std::trunc(*size) != *size || *size <= 0 ||
+        (data->contains("claimId") && !digest) ||
+        (data->contains("sha256") && !digest) ||
+        (digest && (digest->size() != 64 ||
+                    digest->find_first_not_of("0123456789abcdef") !=
+                        std::string::npos))) {
+      Finish(false, "invalid_argument", "Invalid saved image descriptor");
+      return;
+    }
+    if (*size > kMaxAuxCopiedImageBytes) {
+      Finish(false, "invalid_argument",
+             "This image is too large to copy. Save the original instead");
+      return;
+    }
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadAuxStoredImage, std::move(root),
+                       base::FilePath::FromUTF8Unsafe(*path),
+                       static_cast<int64_t>(*size),
+                       digest ? *digest : std::string(), cancelled_),
+        base::BindOnce(&AuxStoredImageCopy::OnRead, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnRead(AuxStoredImageBytes result) {
+    if (!Current()) {
+      OwnerRetired();
+      return;
+    }
+    if (!result.error_code.empty()) {
+      Finish(false, std::move(result.error_code),
+             std::move(result.error_message));
+      return;
+    }
+    decoder_ = std::make_unique<data_decoder::DataDecoder>();
+    decoder_->GetService()->BindImageDecoder(
+        image_decoder_.BindNewPipeAndPassReceiver());
+    image_decoder_.set_disconnect_handler(base::BindOnce(
+        &AuxStoredImageCopy::Finish, weak_factory_.GetWeakPtr(), false,
+        "io_error", "The image decoder is unavailable"));
+    image_decoder_->DecodeImage(
+        base::span<const uint8_t>(result.bytes),
+        data_decoder::mojom::ImageCodec::kDefault,
+        /*shrink_to_fit=*/false, data_decoder::kDefaultMaxSizeInBytes,
+        gfx::Size(),
+        base::BindOnce(&AuxStoredImageCopy::OnDecoded,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnDecoded(const SkBitmap& bitmap) {
+    if (!Current()) {
+      OwnerRetired();
+      return;
+    }
+    if (bitmap.drawsNothing() || !bitmap.getPixels() ||
+        bitmap.colorType() != kN32_SkColorType ||
+        bitmap.computeByteSize() > data_decoder::kDefaultMaxSizeInBytes) {
+      Finish(false, "invalid_argument",
+             "This image could not be decoded at its original size. "
+             "Save the original instead");
+      return;
+    }
+    auto* clipboard = ui::Clipboard::GetForCurrentThread();
+    if (clipboard->GetSequenceNumber(ui::ClipboardBuffer::kCopyPaste) !=
+        clipboard_sequence_) {
+      Finish(false, "conflict",
+             "The clipboard changed while preparing this image. "
+             "Copy again to replace it");
+      return;
+    }
+    // The deadline governs preparation only. There is no asynchronous gap
+    // between this original sequence check and the native clipboard write.
+    deadline_.Stop();
+    const auto weak = weak_factory_.GetWeakPtr();
+    {
+      ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+      if (private_profile_)
+        writer.MarkAsOffTheRecord();
+      writer.WriteImage(bitmap);
+    }
+    if (!weak)
+      return;
+    if (!Current()) {
+      OwnerRetired();
+      return;
+    }
+    const auto written =
+        clipboard->GetSequenceNumber(ui::ClipboardBuffer::kCopyPaste);
+    if (written == clipboard_sequence_) {
+      Finish(false, "io_error", "The image could not be copied");
+      return;
+    }
+    clipboard->GetStandardFormats(
+        ui::ClipboardBuffer::kCopyPaste, std::nullopt,
+        base::BindOnce(&AuxStoredImageCopy::OnWritten,
+                       weak_factory_.GetWeakPtr(), written));
+  }
+
+  void OnWritten(ui::ClipboardSequenceNumberToken written,
+                 std::vector<std::u16string> formats) {
+    if (!Current()) {
+      OwnerRetired();
+      return;
+    }
+    if (ui::Clipboard::GetForCurrentThread()->GetSequenceNumber(
+            ui::ClipboardBuffer::kCopyPaste) != written) {
+      Finish(false, "conflict", "The clipboard changed after copying the image");
+      return;
+    }
+    if (std::ranges::find(formats, u"image/png") == formats.end()) {
+      Finish(false, "io_error", "The image could not be copied");
+      return;
+    }
+    Finish(true, {}, {});
+  }
+
+  void Finish(bool copied, std::string code, std::string message) {
+    if (!callback_)
+      return;
+    auto callback = std::move(callback_);
+    auto release = std::move(release_);
+    cancelled_->store(true);
+    weak_factory_.InvalidateWeakPtrs();
+    Observe(nullptr);
+    window_closed_ = {};
+    deadline_.Stop();
+    image_decoder_.reset();
+    decoder_.reset();
+    current_.Reset();
+    if (release)
+      release.RunAndReset();
+    std::move(callback).Run(copied, copied ? "{\"copied\":true}" : "",
+                            std::move(code), std::move(message));
+  }
+
+  const bool private_profile_;
+  base::RepeatingCallback<bool()> current_;
+  Callback callback_;
+  const ui::ClipboardSequenceNumberToken clipboard_sequence_;
+  base::CallbackListSubscription window_closed_;
+  base::ScopedClosureRunner release_;
+  std::shared_ptr<std::atomic_bool> cancelled_ =
+      std::make_shared<std::atomic_bool>(false);
+  base::OneShotTimer deadline_;
+  std::unique_ptr<data_decoder::DataDecoder> decoder_;
+  mojo::Remote<data_decoder::mojom::ImageDecoder> image_decoder_;
+  base::WeakPtrFactory<AuxStoredImageCopy> weak_factory_{this};
+};
