+namespace {
+class CredentialDocument final : public content::DocumentUserData<CredentialDocument> {
+ public:
+  const base::UnguessableToken token = base::UnguessableToken::Create();
+ private:
+  explicit CredentialDocument(content::RenderFrameHost* frame) : DocumentUserData(frame) {}
+  friend class content::DocumentUserData<CredentialDocument>;
+  DOCUMENT_USER_DATA_KEY_DECL();
+};
+DOCUMENT_USER_DATA_KEY_IMPL(CredentialDocument);
