+
+base::DictValue AuxRuntimeHost::CredentialContext(
+    const base::DictValue& params, uint64_t generation) {
+  const auto* id = params.FindString("pageId");
+  const auto* expected_url = params.FindString("expectedUrl");
+  if (params.size() != 2 || !id || !expected_url ||
+      !DeviceConfirmationConnectionCurrent(generation) || profile_->IsOffTheRecord())
+    return NativeFault("permission_denied", "Original credential context unavailable");
+  auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+  BrowserWindowInterface* owner = nullptr;
+  auto* page = catalog ? catalog->FindPage(*id, &owner) : nullptr;
+  auto* frame = page ? page->GetPrimaryMainFrame() : nullptr;
+  base::DictValue request = params.Clone();
+  request.Set("passwordSelector", "input[type=password]");
+  if (!frame || !frame->IsRenderFrameLive() || !owner || owner->GetProfile() != profile_ || !owner->IsActive() ||
+      owner->GetTabStripModel()->GetActiveWebContents() != page ||
+      page->GetVisibility() != content::Visibility::VISIBLE ||
+      !aux::CredentialFillRequestAllowed(request, page->GetLastCommittedURL(), frame->GetLastCommittedOrigin()))
+    return NativeFault("ref_stale", "Original credential document changed");
+  return base::DictValue().Set("result", base::DictValue()
+      .Set("pageId", *id).Set("expectedUrl", *expected_url)
+      .Set("documentToken", CredentialDocument::GetOrCreateForCurrentDocument(frame)->token.ToString())
+      .Set("windowId", base::NumberToString(owner->GetSessionID().id()))
+      .Set("ownerIncarnation", native_owner_incarnation_)
+      .Set("connectionGeneration", base::NumberToString(generation)));
+}
+
+base::DictValue AuxRuntimeHost::HandleCredentialAdmission(
+    const base::DictValue& params, uint64_t generation) {
+  const auto* target = params.FindDict("target");
+  const auto* run = params.FindString("runId");
+  const auto revision = params.FindInt("policyRevision");
+  const auto* native = target ? target->FindDict("nativeContext") : nullptr;
+  const auto* id = target ? target->FindString("pageId") : nullptr;
+  const auto* url = target ? target->FindString("expectedUrl") : nullptr;
+  const auto* password = target ? target->FindString("passwordSelector") : nullptr;
+  if (params.size() != 3 || !target || !native || !run || run->empty() ||
+      !revision || *revision < 0 || !id || !url || !password)
+    return NativeFault("invalid_params", "Exact credential admission is required");
+  const auto described = CredentialContext(base::DictValue().Set("pageId", *id).Set("expectedUrl", *url), generation);
+  const auto* context = described.FindDict("result");
+  if (!context) return NativeFault("ref_stale", "Credential document changed before admission");
+  auto expected = context->Clone();
+  expected.Remove("pageId"); expected.Remove("expectedUrl");
+  if (*native != expected)
+    return NativeFault("ref_stale", "Credential document identity changed");
+  base::DictValue request;
+  request.Set("pageId", *id); request.Set("expectedUrl", *url);
+  request.Set("passwordSelector", *password);
+  if (const auto* username = target->FindString("usernameSelector"))
+    request.Set("usernameSelector", *username);
+  auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+  BrowserWindowInterface* window = nullptr;
+  auto* page = catalog ? catalog->FindPage(*id, &window) : nullptr;
+  auto* frame = page ? page->GetPrimaryMainFrame() : nullptr;
+  auto* controller = aux::EgressController::ForProfile(profile_);
+  auto lease = frame ? controller->PermissionAuthority(frame) : base::DictValue();
+  const auto* lease_run = lease.FindString("runId");
+  if (!frame || !window || !lease_run || *lease_run != *run ||
+      !aux::CredentialFillRequestAllowed(request, page->GetLastCommittedURL(), frame->GetLastCommittedOrigin()) ||
+      !controller->RecordFinalCdpDispatch({frame->GetWeakDocumentPtr(), *id, "credential"}, lease))
+    return NativeFault("permission_denied", "The original credential lease is unavailable");
+  const auto now = base::TimeTicks::Now();
+  for (auto it = credential_admissions_.begin(); it != credential_admissions_.end();) {
+    if (it->second.expires <= now) it = credential_admissions_.erase(it); else ++it;
+  }
+  if (credential_admissions_.size() >= 64)
+    return NativeFault("conflict", "Too many credential admissions are pending");
+  const std::string receipt = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  credential_admissions_.emplace(receipt, CredentialAdmission{
+      std::move(request), std::move(lease), frame->GetWeakDocumentPtr(),
+      window->GetWeakPtr(), generation, now + base::Seconds(55)});
+  return base::DictValue().Set("result", base::DictValue().Set("receiptId", receipt));
+}
+
+void AuxRuntimeHost::HandleCredentialFill(
+    const base::DictValue& params,
+    std::shared_ptr<std::atomic_bool> cancelled,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (credential_fill_) {
+    std::move(callback).Run(NativeFault(
+        "conflict", "Another password fill is awaiting user approval"));
+    return;
+  }
+  base::DictValue request = params.Clone();
+  base::RepeatingCallback<bool()> admitted;
+  if (const auto* receipt = request.FindString("receiptId")) {
+    const auto it = credential_admissions_.find(*receipt);
+    if (it == credential_admissions_.end()) {
+      std::move(callback).Run(NativeFault("permission_denied", "Credential admission ended")); return;
+    }
+    auto original = std::move(it->second);
+    credential_admissions_.erase(it);
+    request.Remove("receiptId");
+    if (request != original.request) {
+      std::move(callback).Run(NativeFault("permission_denied", "Credential admission target changed")); return;
+    }
+    auto* controller = aux::EgressController::ForProfile(profile_);
+    admitted = base::BindRepeating([](base::WeakPtr<AuxRuntimeHost> owner,
+        base::WeakPtr<aux::EgressController> controller,
+        content::WeakDocumentPtr document, base::WeakPtr<BrowserWindowInterface> window,
+        const base::DictValue& lease, const std::string& page_id, uint64_t generation, base::TimeTicks expires) {
+      auto* frame = document.AsRenderFrameHostIfValid();
+      auto* page = frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+      BrowserWindowInterface* actual_window = nullptr;
+      auto* catalog = owner ? aux::TabCatalog::GetForProfile(owner->profile_) : nullptr;
+      auto* actual_page = catalog ? catalog->FindPage(page_id, &actual_window) : nullptr;
+      return owner && controller && frame && window && actual_window == window.get() &&
+          actual_page == page && page && page->GetPrimaryMainFrame() == frame && window->IsActive() &&
+          owner->DeviceConfirmationConnectionCurrent(generation) &&
+          base::TimeTicks::Now() < expires &&
+          controller->RecordFinalCdpDispatch({document, page_id, "credential"}, lease);
+    }, weak_factory_.GetWeakPtr(), controller->GetWeakPtr(), original.document,
+       original.window, std::move(original.lease), *request.FindString("pageId"),
+       original.generation, original.expires);
+    if (!admitted.Run()) {
+      std::move(callback).Run(NativeFault("permission_denied", "Credential admission retired")); return;
+    }
+  }
+  credential_fill_ = std::make_unique<aux::CredentialFill>(
+      profile_, std::move(request), std::move(cancelled),
+      base::BindOnce(
+          [](base::WeakPtr<AuxRuntimeHost> owner,
+             base::OnceCallback<void(base::DictValue)> callback,
+             base::DictValue reply) {
+            if (owner)
+              owner->credential_fill_.reset();
+            std::move(callback).Run(std::move(reply));
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)), std::move(admitted));
+  credential_fill_->Start();
+}
+
+void AuxRuntimeHost::FillSavedPasswordForUser(
+    const std::string& page_id,
+    const std::string& expected_url,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  base::DictValue request;
+  request.Set("pageId", page_id);
+  request.Set("expectedUrl", expected_url);
+  // This deliberately accepts only a single visible password field. Pages
+  // with ambiguous forms must use Chromium's ordinary password UI.
+  request.Set("passwordSelector", "input[type=password]");
+  HandleCredentialFill(request, std::make_shared<std::atomic_bool>(false),
+                       std::move(callback));
+}
