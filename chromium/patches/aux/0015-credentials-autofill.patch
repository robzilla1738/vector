+
+void WebUIBrowserUI::HandleAuxCredentialsRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  if (method == "passwordExport" || method == "passwordImport") {
+    if (args.size() != 1 || !args[0].is_string() ||
+        args[0].GetString().size() < 12 ||
+        args[0].GetString().size() > 200) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "A transfer passphrase of 12–200 characters is required");
+      return;
+    }
+    if (browser_->GetProfile()->IsOffTheRecord() || !browser_->IsActive()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Password transfer requires an active regular window");
+      return;
+    }
+    if (open_file_dialog_) {
+      std::move(callback).Run(false, "", "conflict",
+                              "A file dialog is already open");
+      return;
+    }
+    auto* active = browser_->GetTabStripModel()->GetActiveWebContents();
+    open_file_dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(active));
+    if (!open_file_dialog_) {
+      std::move(callback).Run(false, "", "not_supported",
+                              "The system file dialog is unavailable");
+      return;
+    }
+    const bool exporting = method == "passwordExport";
+    file_dialog_purpose_ = exporting ? FileDialogPurpose::kPasswordExport
+                                     : FileDialogPurpose::kPasswordImport;
+    file_dialog_callback_ = std::move(callback);
+    password_transfer_passphrase_ = args[0].GetString();
+    ui::SelectFileDialog::FileTypeInfo info{{FILE_PATH_LITERAL("auxvault")}};
+    info.include_all_files = false;
+    base::FilePath directory =
+        browser_->GetProfile()->last_selected_directory();
+    if (directory.empty())
+      directory = base::GetHomeDir();
+    const base::FilePath initial = exporting
+        ? directory.AppendASCII("Aux passwords.auxvault") : directory;
+    open_file_dialog_->SelectFile(
+        exporting ? ui::SelectFileDialog::SELECT_SAVEAS_FILE
+                  : ui::SelectFileDialog::SELECT_OPEN_FILE,
+        exporting ? u"Export encrypted passwords" : u"Import encrypted passwords",
+        initial, &info, 1, info.extensions[0][0],
+        browser_->GetWindow()->GetNativeWindow());
+    return;
+  }
+  if (method == "autofillProfile" || method == "setAutofillProfile" ||
+      method == "autofill") {
+    Profile* profile = browser_->GetProfile();
+    auto* data = profile->IsOffTheRecord() ? nullptr : AuxPersonalData(profile);
+    if (!data) {
+      std::move(callback).Run(false, "", "unavailable",
+                              "Chromium personal info is still loading");
+      return;
+    }
+    const std::string locale = g_browser_process->GetApplicationLocale();
+    const autofill::AutofillProfile* saved = AuxAddressProfile(profile, data);
+    if (method == "autofillProfile") {
+      if (!args.empty()) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "No arguments are expected");
+        return;
+      }
+      if (!saved) {
+        std::move(callback).Run(true, "null", "", "");
+        return;
+      }
+      base::DictValue result;
+      for (const auto& field : kAuxAddressFields) {
+        const std::string value = base::UTF16ToUTF8(
+            saved->GetInfo(field.type, locale));
+        if (!value.empty()) result.Set(field.key, value);
+      }
+      std::move(callback).Run(true, *base::WriteJson(result), "", "");
+      return;
+    }
+    if (method == "setAutofillProfile") {
+      if (args.size() != 1 || !args[0].is_dict()) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "A personal info card is required");
+        return;
+      }
+      const base::DictValue& input = args[0].GetDict();
+      if (input.empty()) {
+        if (saved) data->address_data_manager().RemoveProfile(saved->guid());
+        profile->GetPrefs()->ClearPref(aux::kAutofillProfileGuidPref);
+        std::move(callback).Run(true, "true", "", "");
+        return;
+      }
+      const std::string guid = saved ? saved->guid() :
+          base::Uuid::GenerateRandomV4().AsLowercaseString();
+      autofill::AutofillProfile next = saved ? *saved :
+          autofill::AutofillProfile(guid,
+              autofill::AutofillProfile::RecordType::kLocalOrSyncable,
+              autofill::AddressCountryCode("US"));
+      for (const auto& field : kAuxAddressFields) {
+        const std::string* value = input.FindString(field.key);
+        if (field.type == autofill::ADDRESS_HOME_COUNTRY &&
+            (!value || value->empty()))
+          continue;
+        if (!next.SetInfo(field.type,
+                          base::UTF8ToUTF16(value ? *value : ""), locale)) {
+          std::move(callback).Run(true, "false", "", "");
+          return;
+        }
+      }
+      if (saved) data->address_data_manager().UpdateProfile(next);
+      else data->address_data_manager().AddProfile(next);
+      profile->GetPrefs()->SetString(aux::kAutofillProfileGuidPref, guid);
+      std::move(callback).Run(true, "true", "", "");
+      return;
+    }
+    if (args.size() != 1 || !args[0].is_string()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "An active page is required");
+      return;
+    }
+    BrowserWindowInterface* owner = nullptr;
+    auto* catalog = aux::TabCatalog::GetForProfile(profile);
+    content::WebContents* contents = catalog ?
+        catalog->FindPage(args[0].GetString(), &owner) : nullptr;
+    if (!saved || !browser_->IsActive() || !contents || owner != browser_ ||
+        browser_->GetTabStripModel()->GetActiveWebContents() != contents ||
+        !AuxCanFillAddressOn(contents->GetLastCommittedURL())) {
+      std::move(callback).Run(true, "0", "", "");
+      return;
+    }
+    auto* client = autofill::ContentAutofillClient::FromWebContents(contents);
+    auto* manager = client ? static_cast<autofill::BrowserAutofillManager*>(
+        client->GetAutofillManagerForPrimaryMainFrame()) : nullptr;
+    if (!manager) {
+      std::move(callback).Run(true, "0", "", "");
+      return;
+    }
+    std::optional<autofill::FormGlobalId> form_id;
+    std::optional<autofill::FieldGlobalId> trigger_id;
+    int candidate_count = 0;
+    int matching_forms = 0;
+    manager->ForEachCachedForm([&](const autofill::FormStructure& form) {
+      int count = 0;
+      std::optional<autofill::FieldGlobalId> first;
+      for (const auto& field : form.fields()) {
+        const auto groups = field->Type().GetGroups();
+        if (!(groups.contains(autofill::FieldTypeGroup::kName) ||
+              groups.contains(autofill::FieldTypeGroup::kEmail) ||
+              groups.contains(autofill::FieldTypeGroup::kCompany) ||
+              groups.contains(autofill::FieldTypeGroup::kAddress) ||
+              groups.contains(autofill::FieldTypeGroup::kPhone)) ||
+            saved->GetInfo(field->Type(), locale).empty())
+          continue;
+        if (!first) first = field->global_id();
+        ++count;
+      }
+      if (count > 0) {
+        ++matching_forms;
+        form_id = form.global_id();
+        trigger_id = first;
+        candidate_count = count;
+      }
+    });
+    if (matching_forms != 1 || !form_id || !trigger_id) {
+      std::move(callback).Run(true, "0", "", "");
+      return;
+    }
+    manager->FillOrPreviewForm(
+        autofill::mojom::ActionPersistence::kFill, *form_id, *trigger_id,
+        saved, autofill::AutofillTriggerSource::kPopup, {});
+    std::move(callback).Run(true, std::to_string(candidate_count), "", "");
+    return;
+  }
+  if (method == "vaultFill") {
+    if (args.size() != 1 || !args[0].is_string()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "A page is required");
+      return;
+    }
+    Profile* profile = browser_->GetProfile();
+    BrowserWindowInterface* owner = nullptr;
+    auto* catalog = aux::TabCatalog::GetForProfile(profile);
+    content::WebContents* contents = catalog ?
+        catalog->FindPage(args[0].GetString(), &owner) : nullptr;
+    if (profile->IsOffTheRecord() || !browser_->IsActive() ||
+        !contents || owner != browser_ ||
+        browser_->GetTabStripModel()->GetActiveWebContents() != contents ||
+        !contents->GetLastCommittedURL().SchemeIs("https")) {
+      std::move(callback).Run(true, "false", "", "");
+      return;
+    }
+    auto* runtime = AuxRuntimeHost::ForProfile(profile);
+    if (!runtime) {
+      std::move(callback).Run(true, "false", "", "");
+      return;
+    }
+    runtime->FillSavedPasswordForUser(
+        args[0].GetString(), contents->GetLastCommittedURL().spec(),
+        base::BindOnce(
+            [](RequestCallback callback, base::DictValue reply) {
+              const base::DictValue* result = reply.FindDict("result");
+              const std::string* status = result ?
+                  result->FindString("status") : nullptr;
+              std::move(callback).Run(true,
+                  status && *status == "filled" ? "true" : "false", "", "");
+            },
+            std::move(callback)));
+    return;
+  }
+  if (args.size() != 3 || !args[0].is_string() ||
+      !args[1].is_string() || !args[2].is_string() ||
+      args[2].GetString().empty()) {
+    std::move(callback).Run(false, "", "invalid_argument",
+                            "A page, origin, and pending offer are required");
+    return;
+  }
+  const std::string& page_id = args[0].GetString();
+  const std::string& origin = args[1].GetString();
+  const std::string& offer_id = args[2].GetString();
+  Profile* profile = browser_->GetProfile();
+  BrowserWindowInterface* owner = nullptr;
+  auto* catalog = aux::TabCatalog::GetForProfile(profile);
+  content::WebContents* contents = catalog ?
+      catalog->FindPage(page_id, &owner) : nullptr;
+  auto* controller = contents ?
+      ManagePasswordsUIController::FromWebContents(contents) : nullptr;
+  const auto state = controller ? controller->GetState() :
+      password_manager::ui::INACTIVE_STATE;
+  const bool pending =
+      state == password_manager::ui::PENDING_PASSWORD_STATE ||
+      state == password_manager::ui::PENDING_PASSWORD_UPDATE_STATE;
+  if (profile->IsOffTheRecord() || !browser_->IsActive() ||
+      !contents || owner != browser_ ||
+      browser_->GetTabStripModel()->GetActiveWebContents() != contents ||
+      contents->GetVisibility() != content::Visibility::VISIBLE ||
+      !controller || !pending || controller->GetOrigin().Serialize() != origin ||
+      !aux::ConsumePasswordOffer(contents, origin, offer_id)) {
+    std::move(callback).Run(true, method == "vaultSave" ?
+        "{\"ok\":false,\"updated\":false}" : "false", "", "");
+    return;
+  }
+  if (method == "vaultDismiss") {
+    controller->OnNoInteraction();
+    std::move(callback).Run(true, "true", "", "");
+    return;
+  }
+  const password_manager::PasswordForm& pending_form =
+      controller->GetPendingPassword();
+  const std::u16string username = pending_form.username_value;
+  const auto password = pending_form.password_value;
+  controller->SavePassword(username, password);
+  base::DictValue result;
+  result.Set("ok", true);
+  result.Set("updated",
+             state == password_manager::ui::PENDING_PASSWORD_UPDATE_STATE);
+  std::move(callback).Run(true, *base::WriteJson(result), "", "");
+}
+
+void WebUIBrowserUI::FinishPasswordExport(const base::FilePath& path,
+                                          std::string passphrase,
+                                          RequestCallback callback) {
+  if (password_export_auth_pending_) {
+    CleanseTransferPassphrase(&passphrase);
+    std::move(callback).Run(false, "", "conflict",
+                            "A password export is already awaiting approval");
+    return;
+  }
+  password_export_authenticator_ =
+      ChromeDeviceAuthenticatorFactory::GetForProfile(
+          browser_->GetProfile(),
+          device_reauth::DeviceAuthParams(
+              base::Seconds(0),
+              device_reauth::DeviceAuthSource::kPasswordsCsvDownload));
+  if (!password_export_authenticator_ ||
+      !password_export_authenticator_->CanAuthenticateWithBiometricOrScreenLock()) {
+    CleanseTransferPassphrase(&passphrase);
+    std::move(callback).Run(false, "", "permission_denied",
+                            "Device authentication is required to export passwords");
+    return;
+  }
+  password_export_auth_pending_ = true;
+  password_export_authenticator_->AuthenticateWithMessage(
+      u"Approve exporting Aux passwords",
+      base::BindOnce(&WebUIBrowserUI::OnPasswordExportAuthenticated,
+                     weak_factory_.GetWeakPtr(), path, std::move(passphrase),
+                     std::move(callback)));
+}
+
+void WebUIBrowserUI::OnPasswordExportAuthenticated(
+    base::FilePath path,
+    std::string passphrase,
+    RequestCallback callback,
+    bool authenticated) {
+  password_export_auth_pending_ = false;
+  if (!authenticated || !IsAuthorizedAuxDocument() ||
+      browser_->GetProfile()->IsOffTheRecord() || !browser_->IsActive()) {
+    CleanseTransferPassphrase(&passphrase);
+    std::move(callback).Run(false, "", "permission_denied",
+                            "Password export was not approved");
+    return;
+  }
+  ExportPasswordFile(path, std::move(passphrase), std::move(callback));
+}
+
+void WebUIBrowserUI::ExportPasswordFile(const base::FilePath& path,
+                                        std::string passphrase,
+                                        RequestCallback callback) {
+  auto delegate = extensions::PasswordsPrivateDelegateFactory::
+      GetForBrowserContext(browser_->GetProfile(), true);
+  if (!delegate || !delegate->GetSavedPasswordsPresenter()) {
+    std::move(callback).Run(false, "", "unavailable",
+                            "Chromium saved passwords are still loading");
+    return;
+  }
+  delegate->GetSavedPasswordsList(base::BindOnce(
+      [](base::WeakPtr<WebUIBrowserUI> weak,
+         scoped_refptr<extensions::PasswordsPrivateDelegate> delegate,
+         base::FilePath destination, std::string passphrase,
+         RequestCallback callback,
+         const extensions::PasswordsPrivateDelegate::UiEntries&) {
+        if (!weak || !weak->IsAuthorizedAuxDocument() ||
+            weak->browser_->GetProfile()->IsOffTheRecord()) {
+          std::move(callback).Run(false, "", "forbidden",
+                                  "Password export is no longer available");
+          return;
+        }
+        base::ListValue items;
+        size_t skipped = 0;
+        for (const auto& credential :
+             delegate->GetSavedPasswordsPresenter()->GetSavedPasswords()) {
+          if (credential.password.empty() || credential.facets.empty()) {
+            ++skipped;
+            continue;
+          }
+          const std::string secret =
+              base::UTF16ToUTF8(credential.password);
+          const std::string username =
+              base::UTF16ToUTF8(credential.username);
+          for (const auto& facet : credential.facets) {
+            if (!facet.url.is_valid() ||
+                !facet.url.SchemeIsHTTPOrHTTPS() ||
+                facet.url.has_username() || facet.url.has_password() ||
+                secret.size() > 4096 || username.size() > 200) {
+              ++skipped;
+              continue;
+            }
+            base::DictValue item;
+            const std::string label = facet.display_name.empty()
+                ? std::string(facet.url.host()) : facet.display_name;
+            item.Set("label", label.substr(0, 120));
+            item.Set("kind", "password");
+            item.Set("origin", url::Origin::Create(facet.url).Serialize());
+            item.Set("username", username);
+            item.Set("secret", secret);
+            items.Append(std::move(item));
+          }
+        }
+        if (items.size() > kMaxTransferItems) {
+          std::move(callback).Run(false, "", "too_large",
+                                  "More than 500 passwords require a separate transfer");
+          return;
+        }
+        base::ThreadPool::PostTaskAndReplyWithResult(
+            FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+            base::BindOnce(&WritePasswordTransfer, destination,
+                           std::move(passphrase), std::move(items), skipped),
+            base::BindOnce(
+                [](RequestCallback callback, base::FilePath destination,
+                   TransferWriteResult result) {
+                  if (!result.saved) {
+                    std::move(callback).Run(false, "", "io_error",
+                                            "The encrypted file could not be saved");
+                    return;
+                  }
+                  base::DictValue response;
+                  response.Set("path", destination.AsUTF8Unsafe());
+                  response.Set("exported", static_cast<int>(result.exported));
+                  response.Set("skipped", static_cast<int>(result.skipped));
+                  std::move(callback).Run(true, *base::WriteJson(response),
+                                          "", "");
+                },
+                std::move(callback), destination));
+      },
+      weak_factory_.GetWeakPtr(), std::move(delegate), path,
+      std::move(passphrase), std::move(callback)));
+}
+
+void WebUIBrowserUI::FinishPasswordImport(const base::FilePath& path,
+                                          std::string passphrase,
+                                          RequestCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadPasswordTransfer, path, std::move(passphrase)),
+      base::BindOnce(
+          [](base::WeakPtr<WebUIBrowserUI> weak, RequestCallback callback,
+             TransferReadResult decoded) {
+            if (!weak || !weak->IsAuthorizedAuxDocument() ||
+                weak->browser_->GetProfile()->IsOffTheRecord()) {
+              std::move(callback).Run(false, "", "forbidden",
+                                      "Password import is no longer available");
+              return;
+            }
+            if (!decoded.valid) {
+              std::move(callback).Run(false, "", "invalid_argument",
+                                      "The encrypted file or passphrase is invalid");
+              return;
+            }
+            const size_t total = decoded.passwords.size() + decoded.skipped;
+            if (decoded.passwords.empty()) {
+              base::DictValue response;
+              response.Set("added", 0);
+              response.Set("skipped", static_cast<int>(decoded.skipped));
+              std::move(callback).Run(true, *base::WriteJson(response), "", "");
+              return;
+            }
+            auto delegate = extensions::PasswordsPrivateDelegateFactory::
+                GetForBrowserContext(weak->browser_->GetProfile(), true);
+            auto* presenter = delegate
+                ? delegate->GetSavedPasswordsPresenter() : nullptr;
+            if (!presenter) {
+              std::move(callback).Run(false, "", "unavailable",
+                                      "Chromium saved passwords are unavailable");
+              return;
+            }
+            auto importer =
+                std::make_unique<password_manager::PasswordImporter>(*presenter);
+            auto* importer_ptr = importer.get();
+            importer_ptr->Import(
+                decoded.passwords,
+                password_manager::PasswordForm::Store::kProfileStore,
+                base::BindOnce(&WebUIBrowserUI::OnPasswordImportFinished,
+                               weak, std::move(callback), total,
+                               std::move(importer)));
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+void WebUIBrowserUI::OnPasswordImportFinished(
+    RequestCallback callback,
+    size_t total,
+    std::unique_ptr<password_manager::PasswordImporter> importer,
+    const password_manager::ImportResults& results) {
+  if (results.status == password_manager::ImportResults::CONFLICTS) {
+    auto* importer_ptr = importer.get();
+    importer_ptr->ContinueImport(
+        {}, base::BindOnce(&WebUIBrowserUI::OnPasswordImportFinished,
+                           weak_factory_.GetWeakPtr(), std::move(callback),
+                           total, std::move(importer)));
+    return;
+  }
+  if (results.status != password_manager::ImportResults::SUCCESS ||
+      results.number_imported > total) {
+    std::move(callback).Run(false, "", "invalid_argument",
+                            "Chromium could not import this password package");
+    return;
+  }
+  base::DictValue response;
+  response.Set("added", static_cast<int>(results.number_imported));
+  response.Set("skipped", static_cast<int>(total - results.number_imported));
+  std::move(callback).Run(true, *base::WriteJson(response), "", "");
+}
