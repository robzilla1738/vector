+namespace aux {
+
+// Secrets are bound to the Chromium Profile path and the Aux Keychain service.
+// These methods run only on the runtime worker, never on the WebUI sequence.
+bool StoreSecret(const base::FilePath& profile_path,
+                 const std::string& name,
+                 const std::string& value,
+                 std::string* error);
+bool ReadSecret(const base::FilePath& profile_path,
+                const std::string& name,
+                std::optional<std::string>* value,
+                std::string* error);
+// Atomic across Aux Runtime processes: only a missing item may be created.
+// Locked/unavailable Keychain state never generates a replacement root.
+bool ProfileStorageRoot(const base::FilePath& profile_path,
+                        const std::string& profile_id,
+                        std::string* value,
+                        std::string* error);
+bool ProfileStorageFactor(const base::FilePath& profile_path,
+                          const std::string& profile_id,
+                          std::string* value,
+                          std::string* error);
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_SECRET_STORE_MAC_H_
