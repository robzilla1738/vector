+BEGIN_METADATA(AuxSwitcherRow)
+END_METADATA
+
+// Owns the switcher for one Ctrl-Tab gesture. Destroying it closes the panel.
+class AuxSwitcherSession {
+ public:
+  AuxSwitcherSession(BrowserWindowInterface* browser, bool forward)
+      : browser_(browser) {
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int i = 0; i < model->count(); ++i) {
+      if (content::WebContents* contents = model->GetWebContentsAt(i)) {
+        tabs_.push_back(contents);
+      }
+    }
+    std::stable_sort(tabs_.begin(), tabs_.end(),
+                     [](content::WebContents* a, content::WebContents* b) {
+                       return a->GetLastActiveTime() > b->GetLastActiveTime();
+                     });
+    if (tabs_.size() > kMaxEntries) {
+      tabs_.resize(kMaxEntries);
+    }
+    for (content::WebContents* contents : tabs_) {
+      watchers_.push_back(std::make_unique<Watcher>(this, contents));
+    }
+    selected_ = forward ? 1 : static_cast<int>(tabs_.size()) - 1;
+    close_subscription_ = browser->RegisterBrowserDidClose(base::BindRepeating(
+        [](AuxSwitcherSession* self, BrowserWindowInterface*) {
+          self->Dismiss();
+        },
+        base::Unretained(this)));
+    if (tabs_.size() > 1) {
+      Show();
+      timer_.Start(FROM_HERE, kPollInterval,
+                   base::BindRepeating(&AuxSwitcherSession::Poll,
+                                       base::Unretained(this)));
+    }
+  }
+
+  bool shown() const { return widget_ != nullptr; }
+
+  void Advance(bool forward) {
+    if (tabs_.size() <= 1) {
+      return;
+    }
+    const int count = static_cast<int>(tabs_.size());
+    selected_ = (selected_ + (forward ? 1 : count - 1)) % count;
+    UpdateSelection();
+  }
+
+  // Activates the highlighted tab and closes the panel.
+  void Commit() {
+    timer_.Stop();
+    content::WebContents* target =
+        selected_ >= 0 && selected_ < static_cast<int>(tabs_.size())
+            ? tabs_[selected_].get()
+            : nullptr;
+    Dismiss();
+    if (!target) {
+      return;
+    }
+    TabStripModel* model = browser_->GetTabStripModel();
+    const int index = model->GetIndexOfWebContents(target);
+    if (index != TabStripModel::kNoTab) {
+      model->ActivateTabAt(index);
+    }
+  }
+
+  void Dismiss() {
+    timer_.Stop();
+    rows_.clear();
+    if (widget_) {
+      widget_->Close();
+      widget_.reset();
+    }
+  }
+
+ private:
+  // Clears a tab from the list if it closes while the panel is open.
+  class Watcher : public content::WebContentsObserver {
+   public:
+    Watcher(AuxSwitcherSession* session, content::WebContents* contents)
+        : content::WebContentsObserver(contents), session_(session) {}
+    void WebContentsDestroyed() override { session_->Forget(web_contents()); }
+
+   private:
+    raw_ptr<AuxSwitcherSession> session_;
+  };
+
+  void Forget(content::WebContents* contents) {
+    std::erase(tabs_, contents);
+    selected_ = std::min(selected_, static_cast<int>(tabs_.size()) - 1);
+    if (rows_.size() != tabs_.size()) {
+      Dismiss();
+    }
+  }
+
+  void Poll() {
+    if (!AuxIsControlStillDown()) {
+      Commit();
+    }
+  }
+
+  void Show() {
+    auto panel = std::make_unique<views::View>();
+    panel->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical,
+        gfx::Insets(kPanelPadding), 0));
+    panel->SetBackground(
+        views::CreateRoundedRectBackground(ui::kColorSysSurface, 16));
+    panel->SetBorder(views::CreateRoundedRectBorder(1, 16, ui::kColorSysDivider));
+    for (content::WebContents* contents : tabs_) {
+      ui::ImageModel icon = ui::ImageModel::FromVectorIcon(
+          kGlobeIcon, ui::kColorSysOnSurfaceSubtle, 16);
+      if (auto* driver =
+              favicon::ContentFaviconDriver::FromWebContents(contents)) {
+        const gfx::Image favicon = driver->GetFavicon();
+        if (!favicon.IsEmpty()) {
+          icon = ui::ImageModel::FromImage(favicon);
+        }
+      }
+      std::u16string title = contents->GetTitle();
+      if (title.empty()) {
+        title = base::UTF8ToUTF16(contents->GetVisibleURL().host());
+      }
+      rows_.push_back(panel->AddChildView(
+          std::make_unique<AuxSwitcherRow>(icon, title)));
+    }
+    UpdateSelection();
+
+    const int height =
+        static_cast<int>(tabs_.size()) * kRowHeight + 2 * kPanelPadding;
+    const gfx::Rect window = browser_->GetWindow()->GetBounds();
+    gfx::Rect bounds(0, 0, kPanelWidth, height);
+    bounds.set_origin(gfx::Point(window.x() + (window.width() - kPanelWidth) / 2,
+                                 window.y() + (window.height() - height) / 2));
+
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_POPUP);
+    params.bounds = bounds;
+    if (views::Widget* parent = views::Widget::GetWidgetForNativeWindow(
+            browser_->GetWindow()->GetNativeWindow())) {
+      params.parent = parent->GetNativeView();
+    }
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kDrop;
+    widget_ = std::make_unique<views::Widget>();
+    widget_->Init(std::move(params));
+    widget_->SetContentsView(std::move(panel));
+    widget_->ShowInactive();
+  }
+
+  void UpdateSelection() {
+    for (size_t i = 0; i < rows_.size(); ++i) {
+      rows_[i]->SetSelected(static_cast<int>(i) == selected_);
+    }
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::vector<raw_ptr<content::WebContents>> tabs_;
+  std::vector<std::unique_ptr<Watcher>> watchers_;
+  std::vector<raw_ptr<AuxSwitcherRow>> rows_;
+  int selected_ = 0;
+  std::unique_ptr<views::Widget> widget_;
+  base::RepeatingTimer timer_;
+  base::CallbackListSubscription close_subscription_;
+};
+
+std::unique_ptr<AuxSwitcherSession>& Session() {
+  static base::NoDestructor<std::unique_ptr<AuxSwitcherSession>> session;
+  return *session;
+}
+
+}  // namespace
+
+void AuxCycleTabs(BrowserWindowInterface* browser, bool forward) {
+  if (Session() && Session()->shown()) {
+    Session()->Advance(forward);
+    return;
+  }
+  // Seeds the Control state and installs the event monitor: the first poll
+  // must not see a stale "released" and commit before the panel is usable.
+  AuxIsControlKeyDown();
+  Session() = std::make_unique<AuxSwitcherSession>(browser, forward);
+  if (!Session()->shown()) {
+    // Fewer than two tabs: nothing to switch to.
+    Session().reset();
+  }
+}
diff --git a/chrome/browser/ui/views/frame/aux_tab_switcher_mac.mm b/chrome/browser/ui/views/frame/aux_tab_switcher_mac.mm
