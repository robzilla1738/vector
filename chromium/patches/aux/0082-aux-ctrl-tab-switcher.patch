+
+class BrowserWindowInterface;
+
+// Ctrl-Tab switcher: lists the window's tabs by recent use, advances the
+// selection on every call and activates it once Control is released.
+void AuxCycleTabs(BrowserWindowInterface* browser, bool forward);
+
+// Whether Control is held for the key event being handled right now.
+bool AuxIsControlKeyDown();
