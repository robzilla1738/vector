+namespace {
+
+constexpr int kMaxEntries = 9;
+constexpr int kPanelWidth = 360;
+constexpr int kRowHeight = 36;
+constexpr int kPanelPadding = 8;
+constexpr base::TimeDelta kPollInterval = base::Milliseconds(30);
+
+class AuxSwitcherRow : public views::View {
+  METADATA_HEADER(AuxSwitcherRow, views::View)
+
+ public:
+  AuxSwitcherRow(const ui::ImageModel& icon, const std::u16string& title) {
+    auto* layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal, gfx::Insets::VH(0, 10),
+        10));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto image = std::make_unique<views::ImageView>(icon);
+    image->SetImageSize(gfx::Size(16, 16));
+    AddChildView(std::move(image));
+    auto label = std::make_unique<views::Label>(
+        title, views::style::CONTEXT_MENU, views::style::STYLE_BODY_3);
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetElideBehavior(gfx::ELIDE_TAIL);
+    label->SetEnabledColor(ui::kColorSysOnSurface);
+    layout->SetFlexForView(AddChildView(std::move(label)), 1);
+  }
+
+  void SetSelected(bool selected) {
+    SetBackground(selected ? views::CreateRoundedRectBackground(
+                                 ui::kColorSysSurface5, 10)
+                           : nullptr);
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kPanelWidth - 2 * kPanelPadding, kRowHeight);
+  }
+};
