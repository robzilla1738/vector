+++ b/chrome/browser/ui/views/frame/aux_tab_switcher_mac.mm
@@ -0,0 +1,54 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/aux_tab_switcher.h"
+
+#include "base/logging.h"
+
+#import <AppKit/AppKit.h>
+#import <CoreGraphics/CoreGraphics.h>
+
+namespace {
+
+bool g_control_down = false;
+id g_monitor = nil;
+
+void EnsureMonitor() {
+  if (g_monitor) {
+    return;
+  }
+  // Tracks Control from the events the app actually receives, so the panel
+  // closes when the release is delivered, whatever its source.
+  g_monitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:(NSEventMaskFlagsChanged |
+                                            NSEventMaskKeyDown |
+                                            NSEventMaskKeyUp)
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     g_control_down =
+                                         (event.modifierFlags &
+                                          NSEventModifierFlagControl) != 0;
+                                     return event;
+                                   }];
+}
+
+}  // namespace
+
+bool AuxIsControlKeyDown() {
+  EnsureMonitor();
+  NSEvent* current = [NSApp currentEvent];
+  const bool from_event =
+      current && (current.type == NSEventTypeKeyDown ||
+                  current.type == NSEventTypeFlagsChanged) &&
+      (current.modifierFlags & NSEventModifierFlagControl) != 0;
+  const bool hardware =
+      (CGEventSourceFlagsState(kCGEventSourceStateCombinedSessionState) &
+       kCGEventFlagMaskControl) != 0;
+  g_control_down = from_event || hardware;
+  return g_control_down;
+}
+
+bool AuxIsControlStillDown() {
+  EnsureMonitor();
+  return g_control_down;
+}
