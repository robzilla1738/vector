+    if (params.size() != 2) { fail("Exact original Project cancellation is required"); return; }
+    if (operation == native_projects_.end()) {
+      auto original = turn_contexts_.find(*token);
+      if (original == turn_contexts_.end() || original->second.generation != generation) {
+        fail("Original Project cancellation generation is unavailable"); return;
+      }
+      std::move(callback).Run(base::DictValue().Set("result", base::DictValue().Set("closed", true))); return;
+    }
+    if (operation->second->token() != *token) { fail("Original Project cancellation owner changed"); return; }
+    operation->second->Close(std::move(callback)); return;
+  }
+  if (method != "native.projectFiles" && method != "native.projectFile" && method != "native.projectChanges") {
+    fail("Unknown Project operation"); return;
+  }
+  auto owner = turn_contexts_.find(*token);
+  if (owner == turn_contexts_.end() || owner->second.generation != generation || !TurnContextCurrent(owner->second)) {
+    fail("Original Project document retired"); return;
+  }
+  const auto* cwd = params.FindString("cwd");
+  const auto* device = params.FindString("rootDevice");
+  const auto* inode = params.FindString("rootInode");
+  const auto* workspace = params.FindString("workspaceId");
+  const auto* folder = params.FindString("folderId");
+  if (params.size() != 9 || operation != native_projects_.end() || !cwd || cwd->empty() || cwd->front() != '/' ||
