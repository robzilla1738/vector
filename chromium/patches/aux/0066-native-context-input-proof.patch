+  auto original_view = view_;
+  unsigned retired = 0;
+  auto subscription = view()->ObserveNativeInputAdmissionRetirement(
+      document,
+      base::BindRepeating(
+          [](RenderWidgetHostViewMac* view, WeakDocumentPtr document,
+             unsigned* retired) {
+            ++*retired;
