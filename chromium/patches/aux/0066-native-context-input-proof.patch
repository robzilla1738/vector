+void InputHandler::RegisterAuxContextOwner(
+    const std::string& owner,
+    base::ReadOnlySharedMemoryRegion authority,
+    base::TimeTicks deadline) {
+  std::vector<std::string> expired;
+  for (const auto& entry : aux_context_owners_) {
+    if (entry.second.deadline <= base::TimeTicks::Now()) {
+      expired.push_back(entry.first);
+    }
+  }
+  for (const auto& key : expired) {
+    aux_context_owners_.erase(key);
+  }
+  if (owner.size() != 32 || !authority.IsValid() ||
+      authority.GetSize() != sizeof(base::subtle::Atomic32) ||
+      deadline <= base::TimeTicks::Now() ||
+      deadline > base::TimeTicks::Now() + base::Seconds(2)) {
+    return;
+  }
+  if (aux_context_owners_.size() >= 8 && !aux_context_owners_.contains(owner)) {
+    return;
+  }
+  aux_context_owners_.insert_or_assign(
+      owner, AuxContextOwner{std::move(authority), deadline});
+}
+void InputHandler::PrepareAuxContextAction(
+    std::unique_ptr<Input::AuxContextAction> context,
+    const std::string& owner,
+    std::unique_ptr<PrepareAuxContextActionCallback> callback) {
+  const auto admitted_owner = aux_context_owners_.find(owner);
+  if (!host_ || !web_contents_ || host_->GetParent() ||
+      !host_->GetRenderWidgetHost() ||
+      admitted_owner == aux_context_owners_.end() ||
+      admitted_owner->second.deadline <= base::TimeTicks::Now() ||
+      owner.size() != 32 || context->GetActionId().empty() ||
+      context->GetActionId().size() > 256 ||
+      context->GetSourceDigest().size() != 64 ||
+      context->GetRecipientUrl().size() > 2048 ||
+      context->GetBeforeText().size() > 32000 ||
+      context->GetText().size() > 32000) {
+    callback->sendFailure(
+        Response::ServerError("Original context action source is unavailable"));
+    return;
+  }
+  auto params = blink::mojom::AuxContextActionParams::New();
+  params->root_node_id = context->GetRootNodeId();
+  params->recipient_node_id = context->GetRecipientNodeId();
+  params->editor_node_id = context->GetEditorNodeId();
+  params->action_node_id = context->GetActionNodeId();
+  params->recipient_url = context->GetRecipientUrl();
+  params->before_text = context->GetBeforeText();
+  params->text = context->GetText();
+  params->action_id = context->GetActionId();
+  params->source_digest = context->GetSourceDigest();
+  params->owner = owner;
+  params->input_scale = ScaleFactor();
+  params->authority = admitted_owner->second.authority.Duplicate();
+  params->authority_deadline = admitted_owner->second.deadline;
+  aux_context_owners_.erase(admitted_owner);
+  params->invitation = context->GetInvitation();
+  params->operation = context->GetOperation() == "fill"
+                          ? blink::mojom::AuxContextActionOperation::kFill
+                          : blink::mojom::AuxContextActionOperation::kClick;
+  ExpireAuxContextActions();
+  auto original = host_->GetWeakDocumentPtr();
+  auto widget = host_->GetRenderWidgetHost()->GetWeakPtr();
+  auto authority = params->authority.Map();
+  const auto deadline = params->authority_deadline;
+  host_->GetRenderWidgetHost()
+      ->GetWidgetInputHandler()
+      ->PrepareAuxContextAction(
+          std::move(params),
+          base::BindOnce(
+              [](base::WeakPtr<InputHandler> self,
+                 content::WeakDocumentPtr document,
+                 base::WeakPtr<RenderWidgetHostImpl> widget, std::string owner,
+                 base::ReadOnlySharedMemoryMapping authority,
+                 base::TimeTicks deadline,
+                 std::unique_ptr<PrepareAuxContextActionCallback> done,
+                 const std::string& token) {
+                auto* frame = document.AsRenderFrameHostIfValid();
+                if (!self || !frame || frame != self->host_ || !widget ||
+                    token.empty() || !authority.IsValid() ||
+                    base::subtle::Acquire_Load(
+                        authority.GetMemoryAs<base::subtle::Atomic32>()) != 1 ||
+                    deadline <= base::TimeTicks::Now() ||
+                    self->aux_context_tickets_.size() >= 8) {
+                  if (widget && !token.empty()) {
+                    widget->GetWidgetInputHandler()->RetireAuxContextAction(
+                        token, owner);
+                  }
+                  done->sendFailure(Response::ServerError(
+                      "Exact action context changed or is unsupported"));
+                  return;
+                }
+                self->aux_context_tickets_.emplace(
+                    token, AuxContextTicket{owner, document, widget, deadline,
+                                            std::move(authority)});
+                self->ExpireAuxContextActions();
+                done->sendSuccess(token);
+              },
+              weak_factory_.GetWeakPtr(), original, widget, owner,
+              std::move(authority), deadline, std::move(callback)));
+}
+
+void InputHandler::ApplyAuxContextAction(
+    const std::string& token,
+    const std::string& owner,
+    std::unique_ptr<ApplyAuxContextActionCallback> callback) {
+  ExpireAuxContextActions();
+  auto found = aux_context_tickets_.find(token);
+  if (!host_ || host_->GetParent() || !host_->GetRenderWidgetHost() ||
+      found == aux_context_tickets_.end() || found->second.owner != owner ||
+      found->second.document.AsRenderFrameHostIfValid() != host_ ||
+      found->second.widget.get() != host_->GetRenderWidgetHost() ||
+      !host_->GetRenderWidgetHost()->GetView()) {
+    callback->sendSuccess("refused");
+    return;
+  }
+  // Browser and renderer each consume once before callbacks or any input.
+  auto ticket = std::move(found->second);
+  aux_context_tickets_.erase(found);
+  auto weak = weak_factory_.GetWeakPtr();
+  ticket.widget->Focus();
+  // Focus may re-enter native/page ownership. The original callback remains
+  // owned locally even if that re-entrancy destroys this handler.
+  if (!weak || !ticket.widget || !ticket.widget->GetView() ||
+      ticket.document.AsRenderFrameHostIfValid() != weak->host_) {
+    callback->sendSuccess("uncertain");
+    return;
+  }
+  ticket.widget->GetWidgetInputHandler()->ApplyAuxContextAction(
+      token, owner, weak->ScaleFactor(),
+      gfx::PointF(ticket.widget->GetView()->GetViewBounds().origin()),
+      base::BindOnce(
+          [](std::unique_ptr<ApplyAuxContextActionCallback> done,
+             blink::mojom::AuxContextActionResult result) {
+            done->sendSuccess(
+                result == blink::mojom::AuxContextActionResult::kApplied
+                    ? "applied"
+                    : "uncertain");
+          },
+          std::move(callback)));
+}
+Response InputHandler::RetireAuxContextAction(const std::string& token,
+                                              const std::string& owner) {
+  auto found = aux_context_tickets_.find(token);
+  if (found != aux_context_tickets_.end() && found->second.owner == owner) {
+    auto ticket = std::move(found->second);
+    aux_context_tickets_.erase(found);
+    if (ticket.widget) {
+      ticket.widget->GetWidgetInputHandler()->RetireAuxContextAction(token,
+                                                                     owner);
+    }
+  }
+  return Response::Success();
+}
+void InputHandler::ExpireAuxContextActions() {
+  aux_context_timer_.Stop();
+  std::vector<std::string> expired;
+  std::optional<base::TimeTicks> next;
+  for (const auto& [token, ticket] : aux_context_tickets_) {
+    if (ticket.deadline <= base::TimeTicks::Now() || !ticket.widget ||
+        !ticket.authority.IsValid() ||
+        base::subtle::Acquire_Load(
+            ticket.authority.GetMemoryAs<base::subtle::Atomic32>()) != 1 ||
+        ticket.document.AsRenderFrameHostIfValid() != host_) {
+      expired.push_back(token);
+    } else if (!next || ticket.deadline < *next) {
+      next = ticket.deadline;
+    }
+  }
+  for (const auto& token : expired) {
+    auto ticket = std::move(aux_context_tickets_.at(token));
+    aux_context_tickets_.erase(token);
+    if (ticket.widget) {
+      ticket.widget->GetWidgetInputHandler()->RetireAuxContextAction(
+          token, ticket.owner);
+    }
+  }
+  if (next) {
+    aux_context_timer_.Start(
+        FROM_HERE, *next - base::TimeTicks::Now(),
+        base::BindOnce(&InputHandler::ExpireAuxContextActions,
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+void InputHandler::RetireAuxContextActions() {
+  aux_context_owners_.clear();
+  aux_context_timer_.Stop();
+  auto tickets = std::move(aux_context_tickets_);
+  aux_context_tickets_.clear();
+  for (const auto& [token, ticket] : tickets) {
+    if (ticket.widget) {
+      ticket.widget->GetWidgetInputHandler()->RetireAuxContextAction(
+          token, ticket.owner);
+    }
+  }
+}
