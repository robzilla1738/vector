+// The NSView is retained across destruction so its class/association can always
+// be restored, including when the real view is destroyed before bridge ACK.
+class ScopedNativeInputBindingInterleave {
+ public:
+  ScopedNativeInputBindingInterleave(RenderWidgetHostViewCocoa* view,
+                                     base::OnceClosure callback)
+      : view_(view), original_class_(object_getClass(view)) {
+    auto* interleave = [[NativeInputBindingInterleave alloc] init];
+    interleave->callback = std::move(callback);
+    objc_setAssociatedObject(view_, &kNativeInputBindingInterleave, interleave,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    object_setClass(view_,
+                    [InterleavedNativeInputRenderWidgetHostViewCocoa class]);
+  }
+  ScopedNativeInputBindingInterleave(
+      const ScopedNativeInputBindingInterleave&) = delete;
+  ScopedNativeInputBindingInterleave& operator=(
+      const ScopedNativeInputBindingInterleave&) = delete;
+
+  ~ScopedNativeInputBindingInterleave() {
+    object_setClass(view_, original_class_);
+    objc_setAssociatedObject(view_, &kNativeInputBindingInterleave, nil,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+  }
+
+ private:
+  RenderWidgetHostViewCocoa* __strong view_;
+  Class original_class_;
+};
+
