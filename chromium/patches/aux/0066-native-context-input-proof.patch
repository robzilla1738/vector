+TEST(WebInputEventTest, AuxReleaseTicketSurvivesMojoWithoutMintingPersonAuthority) {
+  for (bool attach_ticket : {false, true}) {
+    WebMouseEvent release(WebInputEvent::Type::kMouseUp,
+                          WebInputEvent::kNoModifiers,
+                          WebInputEvent::GetStaticTimeStampForTests());
+    const auto token = base::UnguessableToken::Create();
+    if (attach_ticket) release.SetAuxInputContinuation(token);
+    auto original = std::make_unique<WebCoalescedInputEvent>(release, ui::LatencyInfo());
+    std::unique_ptr<WebCoalescedInputEvent> decoded;
+    ASSERT_TRUE(mojo::test::SerializeAndDeserialize<blink::mojom::Event>(original, decoded));
+    ASSERT_TRUE(decoded);
+    EXPECT_EQ(decoded->Event().AuxInputContinuation(),
+              attach_ticket ? std::make_optional(token) : std::nullopt);
+    EXPECT_EQ(decoded->Event().GetType(), WebInputEvent::Type::kMouseUp);
+  }
+}
