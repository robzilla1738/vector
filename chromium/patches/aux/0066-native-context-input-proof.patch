+      authority.GetSize() != sizeof(base::subtle::Atomic32) ||
+      deadline <= base::TimeTicks::Now() ||
+      deadline > base::TimeTicks::Now() + base::Seconds(2)) {
+    return;
+  }
+  if (aux_context_owners_.size() >= 8 && !aux_context_owners_.contains(owner)) {
+    return;
+  }
+  aux_context_owners_.insert_or_assign(
+      owner, AuxContextOwner{std::move(authority), deadline});
