+String WebFrameWidgetImpl::PrepareAuxContextAction(
+    mojom::blink::AuxContextActionParamsPtr params) {
+  if (!LocalRootImpl() || !LocalRootImpl()->GetFrame() ||
+      !LocalRootImpl()->GetFrame()->IsMainFrame() || IsProvisional()) {
+    return String();
+  }
+  if (!aux_context_actions_) {
+    aux_context_actions_ = MakeGarbageCollected<AuxContextActions>();
+  }
+  return aux_context_actions_->Prepare(
+      *LocalRootImpl()->GetFrame()->GetDocument(), std::move(params));
+}
+mojom::blink::AuxContextActionResult WebFrameWidgetImpl::ApplyAuxContextAction(
+    const String& token,
+    const String& owner,
+    float input_scale,
+    const gfx::PointF& screen_origin) {
+  using Result = mojom::blink::AuxContextActionResult;
+  if (!aux_context_actions_ || !LocalRootImpl() ||
+      !LocalRootImpl()->GetFrame() || IsProvisional()) {
+    return Result::kRefused;
+  }
+  auto* document = LocalRootImpl()->GetFrame()->GetDocument();
+  return aux_context_actions_->Apply(
+      *document, token, owner,
+      BindOnce(
+          [](WebFrameWidgetImpl* self, Document* document, float input_scale,
+             gfx::PointF screen_origin,
+             const mojom::blink::AuxContextActionParams& params) {
+            if (params.input_scale != input_scale) {
+              return Result::kRefused;
+            }
+            auto* editor = DynamicTo<Element>(
+                DOMNodeIds::NodeForId(params.editor_node_id));
+            auto* action = DynamicTo<Element>(
+                DOMNodeIds::NodeForId(params.action_node_id));
+            if (!editor || !action) {
+              return Result::kRefused;
+            }
+            if (params.operation ==
+                mojom::blink::AuxContextActionOperation::kFill) {
+              // This is the normal IME/editor writer, never
+              // setValue/innerText/JS click.
+              if (!AuxContextActions::MarkActiveInputDispatched()) {
+                return Result::kRefused;
+              }
+              editor->Focus();
+              if (!AuxContextActions::ValidateActiveContext(*document, true)) {
+                return Result::kUncertain;
+              }
+              if (auto* control = DynamicTo<TextControlElement>(editor)) {
+                control->select();
+              } else {
+                document->GetFrame()->Selection().SetSelection(
+                    SelectionInDomTree::Builder()
+                        .SelectAllChildren(*editor)
+                        .Build(),
+                    SetSelectionOptions());
+              }
+              if (!AuxContextActions::ValidateActiveTextContext(*document)) {
+                return Result::kUncertain;
+              }
+              self->CommitText(params.text, {}, gfx::Range::InvalidRange(), 0,
+                               DOMNodeIdType());
+              const String observed = AuxContextActions::EditorText(*editor);
+              return !observed.IsNull() && observed == params.text
+                         ? Result::kApplied
+                         : Result::kUncertain;
+            }
+            const auto can_dispatch_click = [self, document] {
+              return self->LocalRootImpl() &&
+                     self->LocalRootImpl()->GetFrame() &&
+                     self->LocalRootImpl()->GetFrame()->GetDocument() ==
+                         document &&
+                     !self->IsProvisional() && !self->doing_drag_and_drop_ &&
+                     self->GetPage() &&
+                     !self->GetPage()
+                          ->GetPageLifecycleState()
+                          ->is_in_back_forward_cache &&
+                     !self->ShouldIgnoreInputEvents() &&
+                     !self->GetPage()
+                          ->GetPointerLockController()
+                          .IsPointerLocked() &&
+                     !self->mouse_capture_element_;
+            };
+            // Alternate pointer/plugin capture and suppressed input are
+            // unsupported; they must not activate a different target or claim
+            // an applied click.
+            if (!can_dispatch_click()) {
+              return Result::kRefused;
+            }
+            auto* rect = action->GetBoundingClientRect();
+            const float x = rect->x() + rect->width() / 2,
+                        y = rect->y() + rect->height() / 2;
+            auto* hit = document->ElementFromPoint(x, y);
+            if (!hit || !action->contains(hit)) {
+              return Result::kRefused;
+            }
+            WebMouseEvent down(
+                WebInputEvent::Type::kMouseDown,
+                WebInputEvent::kFromDebugger | WebInputEvent::kLeftButtonDown,
+                base::TimeTicks::Now());
+            const gfx::PointF position(x * input_scale, y * input_scale);
+            const gfx::PointF screen(position.x() + screen_origin.x(),
+                                     position.y() + screen_origin.y());
+            down.SetPositionInWidget(position);
+            down.SetPositionInScreen(screen);
+            down.button = WebMouseEvent::Button::kLeft;
+            down.click_count = 1;
+            self->HandleInputEvent(
+                WebCoalescedInputEvent(down, ui::LatencyInfo()));
+            // A mousedown listener can replace recipient, root or action. Never
+            // release-click a substitute.
+            if (!AuxContextActions::DidDispatchActivePress() ||
+                !can_dispatch_click() ||
+                !AuxContextActions::ValidateActiveContext(*document, false)) {
+              if (document->GetFrame()) {
+                document->GetFrame()
+                    ->GetEventHandler()
+                    .ClearMouseEventManager();
+              }
+              return Result::kUncertain;
+            }
+            auto* next_hit = document->ElementFromPoint(x, y);
+            if (!next_hit || !action->contains(next_hit)) {
+              if (document->GetFrame()) {
+                document->GetFrame()
+                    ->GetEventHandler()
+                    .ClearMouseEventManager();
+              }
+              return Result::kUncertain;
+            }
+            WebMouseEvent up(WebInputEvent::Type::kMouseUp,
+                             WebInputEvent::kFromDebugger,
+                             base::TimeTicks::Now());
+            up.SetPositionInWidget(position);
+            up.SetPositionInScreen(screen);
+            up.button = WebMouseEvent::Button::kLeft;
+            up.click_count = 1;
+            self->HandleInputEvent(
+                WebCoalescedInputEvent(up, ui::LatencyInfo()));
+            return Result::kApplied;
+          },
+          WrapPersistent(this), WrapPersistent(document), input_scale,
+          screen_origin));
+}
+void WebFrameWidgetImpl::RetireAuxContextAction(const String& token,
+                                                const String& owner) {
+  if (aux_context_actions_) {
+    aux_context_actions_->Retire(token, owner);
+  }
+}
