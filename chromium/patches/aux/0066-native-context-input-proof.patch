+                          ? blink::mojom::AuxContextActionOperation::kFill
+                          : blink::mojom::AuxContextActionOperation::kClick;
+  ExpireAuxContextActions();
+  auto original = host_->GetWeakDocumentPtr();
+  auto widget = host_->GetRenderWidgetHost()->GetWeakPtr();
+  auto authority = params->authority.Map();
+  const auto deadline = params->authority_deadline;
+  host_->GetRenderWidgetHost()
+      ->GetWidgetInputHandler()
+      ->PrepareAuxContextAction(
+          std::move(params),
+          base::BindOnce(
+              [](base::WeakPtr<InputHandler> self,
+                 content::WeakDocumentPtr document,
+                 base::WeakPtr<RenderWidgetHostImpl> widget, std::string owner,
+                 base::ReadOnlySharedMemoryMapping authority,
+                 base::TimeTicks deadline,
+                 std::unique_ptr<PrepareAuxContextActionCallback> done,
+                 const std::string& token) {
