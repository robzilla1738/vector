+  bool replacement_admitted = false;
+  view()->AwaitNativeInputAdmissionForDocument(
+      document,
+      base::BindOnce([](bool* result, bool admitted) { *result = admitted; },
+                     &replacement_admitted));
+  EXPECT_TRUE(replacement_admitted);
+}
+
+TEST_F(RenderWidgetHostViewMacNativeInputTest,
+       CocoaAckAfterViewDestructionCannotCompleteOriginalAdmission) {
+  const auto document = main_rfh()->GetWeakDocumentPtr();
+  auto admission_results = std::make_shared<std::vector<bool>>();
+  bool setter_ran = false;
+  ScopedNativeInputBindingInterleave interleave(
+      view()->GetInProcessNSView(), base::BindLambdaForTesting([&] {
+        setter_ran = true;
+        EXPECT_FALSE(view()->HasNativeInputAdmissionForDocument(document));
+        view()->AwaitNativeInputAdmissionForDocument(
+            document, base::BindLambdaForTesting(
+                          [results = admission_results](bool admitted) {
+                            results->push_back(admitted);
+                          }));
+        // The genuine Cocoa setter ran; destroy before the bridge returns ACK.
+        view()->DestroyOrDefer();
+      }));
+  view()->MigrateNSViewBridge(nullptr, 0);
+  EXPECT_TRUE(setter_ran);
+  EXPECT_FALSE(view_);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(*admission_results, std::vector<bool>({false}));
+}
+
+TEST_F(RenderWidgetHostViewMacNativeInputTest,
+       CocoaAckAfterNavigationCannotAdmitOriginalDocument) {
+  const auto document = main_rfh()->GetWeakDocumentPtr();
+  const auto original_view = view_;
+  auto admission_results = std::make_shared<std::vector<bool>>();
+  bool setter_ran = false;
+  ScopedNativeInputBindingInterleave interleave(
+      view()->GetInProcessNSView(), base::BindLambdaForTesting([&] {
+        setter_ran = true;
+        EXPECT_FALSE(view()->HasNativeInputAdmissionForDocument(document));
+        view()->AwaitNativeInputAdmissionForDocument(
+            document, base::BindLambdaForTesting(
+                          [results = admission_results](bool admitted) {
+                            results->push_back(admitted);
+                          }));
+        NavigateAndCommit(
+            GURL("https://native-input.test/late-ack-replacement"));
+      }));
+  view()->MigrateNSViewBridge(nullptr, 0);
+  ASSERT_TRUE(setter_ran);
+  if (original_view) {
+    EXPECT_FALSE(static_cast<RenderWidgetHostViewMac*>(original_view.get())
+                     ->HasNativeInputAdmissionForDocument(document));
+  }
+  ASSERT_NO_FATAL_FAILURE(InstallPrimaryMacView());
+  ASSERT_NO_FATAL_FAILURE(AdmitPrimaryDocument());
+  EXPECT_FALSE(view()->HasNativeInputAdmissionForDocument(document));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(*admission_results, std::vector<bool>({false}));
+  EXPECT_TRUE(view()->HasNativeInputAdmissionForDocument(
+      main_rfh()->GetWeakDocumentPtr()));
 }
 
