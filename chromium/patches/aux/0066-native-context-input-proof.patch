+void WidgetInputHandlerImpl::PrepareAuxContextAction(
+    mojom::blink::AuxContextActionParamsPtr params,
+    PrepareAuxContextActionCallback callback) {
+  RunOnMainThread(base::BindOnce(
+      [](base::WeakPtr<WidgetBase> widget,
+         scoped_refptr<base::SingleThreadTaskRunner> runner,
+         mojom::blink::AuxContextActionParamsPtr value,
+         PrepareAuxContextActionCallback done) {
+        auto* frame = widget ? widget->client()->FrameWidget() : nullptr;
+        String token =
+            frame ? frame->PrepareAuxContextAction(std::move(value)) : String();
+        runner->PostTask(FROM_HERE, base::BindOnce(std::move(done), token));
+      },
+      widget_, base::SingleThreadTaskRunner::GetCurrentDefault(),
+      std::move(params), std::move(callback)));
+}
+void WidgetInputHandlerImpl::ApplyAuxContextAction(
+    const String& token,
+    const String& owner,
+    float input_scale,
+    const gfx::PointF& screen_origin,
+    ApplyAuxContextActionCallback callback) {
+  RunOnMainThread(base::BindOnce(
+      [](base::WeakPtr<WidgetBase> widget,
+         scoped_refptr<base::SingleThreadTaskRunner> runner, String token,
+         String owner, float input_scale, gfx::PointF screen_origin,
+         ApplyAuxContextActionCallback done) {
+        auto* frame = widget ? widget->client()->FrameWidget() : nullptr;
+        auto result = frame ? frame->ApplyAuxContextAction(
+                                  token, owner, input_scale, screen_origin)
+                            : mojom::blink::AuxContextActionResult::kRefused;
+        runner->PostTask(FROM_HERE, base::BindOnce(std::move(done), result));
+      },
+      widget_, base::SingleThreadTaskRunner::GetCurrentDefault(), token, owner,
+      input_scale, screen_origin, std::move(callback)));
+}
+void WidgetInputHandlerImpl::RetireAuxContextAction(const String& token,
+                                                    const String& owner) {
