+TEST_F(AuxInputNavigationTest, UntaggedNestedInputCannotBorrowOuterTicket) {
+  const auto token = base::UnguessableToken::Create();
+  AuxInputNavigationScope outer(*MainFrame().GetFrame(), token);
+  {
+    AuxInputNavigationScope untagged(*MainFrame().GetFrame(), std::nullopt);
+    ResourceRequest resource(KURL("https://continuation.test/other"));
+    FrameLoadRequest request(GetDocument().domWindow(), resource);
+    EXPECT_FALSE(request.GetResourceRequest().AuxInputContinuation());
+  }
+  EXPECT_EQ(AuxInputNavigationScope::CurrentToken(), token);
+}
+TEST_F(AuxInputNavigationTest, ScheduledRequestCannotBorrowAReplacementInputTicket) {
+  const auto original = base::UnguessableToken::Create();
+  const auto unrelated = base::UnguessableToken::Create();
+  ResourceRequest resource(KURL("https://continuation.test/save"));
+  resource.SetAuxInputContinuation(original);
+  AuxInputNavigationScope other_input(*MainFrame().GetFrame(), unrelated);
+  FrameLoadRequest scheduled(GetDocument().domWindow(), resource);
+  EXPECT_EQ(scheduled.GetResourceRequest().AuxInputContinuation(), original);
+  EXPECT_EQ(AuxInputNavigationScope::CurrentToken(), unrelated);
+}
