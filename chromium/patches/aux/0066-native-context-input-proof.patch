+    ASSERT_TRUE(authority_.IsValid());
+    base::subtle::Release_Store(
+        authority_.mapping.GetMemoryAs<base::subtle::Atomic32>(), 1);
+  }
+  Element* Node(const char* id) {
+    return GetDocument().getElementById(AtomicString(id));
+  }
+  mojom::blink::AuxContextActionParamsPtr Params(bool fill = true) {
+    auto value = mojom::blink::AuxContextActionParams::New();
+    value->root_node_id = DOMNodeIds::IdForNode(Node("root"));
+    value->recipient_node_id = DOMNodeIds::IdForNode(Node("recipient"));
+    value->editor_node_id = DOMNodeIds::IdForNode(Node("editor"));
+    value->action_node_id =
+        DOMNodeIds::IdForNode(Node(fill ? "editor" : "send"));
+    value->recipient_url = "https://www.linkedin.com/in/alex/";
+    value->before_text = "Old draft";
+    value->text = fill ? "Requested draft" : "Old draft";
+    value->action_id = "original-action";
+    value->source_digest = String::FromUtf8(std::string(64, 'a'));
+    value->owner = owner_;
+    value->input_scale = 1;
+    value->authority = authority_.region.Duplicate();
+    value->authority_deadline = base::TimeTicks::Now() + base::Seconds(2);
+    value->invitation = false;
+    value->operation = fill ? mojom::blink::AuxContextActionOperation::kFill
+                            : mojom::blink::AuxContextActionOperation::kClick;
+    return value;
+  }
+  String Prepare(bool fill = true) {
+    return proofs_->Prepare(GetDocument(), Params(fill));
+  }
+  Result Fill(const String& token) {
+    return proofs_->Apply(
+        GetDocument(), token, owner_,
+        base::BindLambdaForTesting(
+            [this](const mojom::blink::AuxContextActionParams& params) {
+              auto* editor = To<HTMLTextAreaElement>(Node("editor"));
+              if (!AuxContextActions::MarkActiveInputDispatched()) {
+                return Result::kRefused;
+              }
+              editor->Focus();
+              editor->select();
+              const bool applied =
+                  GetFrame().GetInputMethodController().CommitText(params.text,
+                                                                   {}, 0);
+              return applied ? Result::kApplied : Result::kUncertain;
+            }));
+  }
+  Persistent<AuxContextActions> proofs_;
+  base::MappedReadOnlyRegion authority_;
+  String owner_ = String::FromUtf8(std::string(32, 'A'));
+};
