+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_AUX_CONTEXT_ACTIONS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_AUX_CONTEXT_ACTIONS_H_
+
+#include "base/functional/callback.h"
+#include "third_party/blink/public/mojom/input/input_handler.mojom-blink.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/heap/collection_support/heap_hash_map.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+class Document;
+class Element;
+class Node;
+class AuxContextActionRecord;
+// Evidence adjunct only. The widget's existing trusted input implementation is
+// the only writer. A record never authorizes a new document, event or payload.
+class CORE_EXPORT AuxContextActions final
+    : public GarbageCollected<AuxContextActions> {
+ public:
+  using Result = mojom::blink::AuxContextActionResult;
+  enum class InputEvent { kOther, kPress, kRelease, kClick };
+  String Prepare(Document&, mojom::blink::AuxContextActionParamsPtr);
+  Result Apply(
+      Document&,
+      const String& token,
+      const String& owner,
+      base::OnceCallback<Result(const mojom::blink::AuxContextActionParams&)>);
+  void Retire(const String& token, const String& owner);
+  // Called after page beforeinput handlers and before the existing editor
+  // write. Ordinary person/IME input without a scoped context record is
+  // unchanged.
+  static bool ValidateActiveTextContext(Document&);
+  // Inspect the existing editor's filtered/normalized insertion before
+  // mutation.
+  static bool ValidateActiveTextInsertion(Document&, const String&);
+  static bool ValidateActiveContext(Document&, bool focus);
+  static bool ValidateActivePointerTarget(Node*, bool actionable);
+  static bool MarkActiveInputDispatched(InputEvent = InputEvent::kOther);
+  static bool DidDispatchActivePress();
+  static void DidCompleteActiveTextCommand(const String& text);
+  static String EditorText(Element&);
+  void Trace(Visitor*) const;
+
+ private:
+  HeapHashMap<String, Member<AuxContextActionRecord>> records_;
+};
+}  // namespace blink
+#endif
