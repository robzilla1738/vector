+class RenderWidgetHostViewMacNativeInputTest
+    : public RenderViewHostImplTestHarness {
+ public:
+  void SetUp() override {
+    RenderViewHostImplTestHarness::SetUp();
+    window_ = [[CocoaTestHelperWindow alloc] init];
+    window_.releasedWhenClosed = NO;
+    window_.pretendIsKeyWindow = YES;
+    NavigateAndCommit(GURL("https://native-input.test/first"));
+    ASSERT_NO_FATAL_FAILURE(InstallPrimaryMacView());
+  }
+
+  void TearDown() override {
+    DeleteContents();
+    base::RunLoop().RunUntilIdle();
+    [window_ close];
+    window_ = nil;
+    RenderViewHostImplTestHarness::TearDown();
+  }
+
+ protected:
+  void InstallPrimaryMacView() {
+    ASSERT_TRUE(main_rfh()->IsActive());
+    ASSERT_TRUE(main_rfh()->IsRenderFrameLive());
+    auto* widget = contents()->GetPrimaryMainFrame()->GetRenderWidgetHost();
+    if (auto* previous = widget->GetView()) {
+      static_cast<RenderWidgetHostViewBase*>(previous)->DestroyOrDefer();
+    }
+    ASSERT_EQ(widget->GetView(), nullptr);
+    auto* view = new RenderWidgetHostViewMac(widget);
+    view_ = view->GetWeakPtr();
+    auto* cocoa = view->GetInProcessNSView();
+    ASSERT_NE(cocoa, nil);
+    [window_.contentView addSubview:cocoa];
+    [cocoa setFrame:window_.contentView.bounds];
+    view->ShowWithVisibility(PageVisibilityState::kVisible);
+  }
+
+  RenderWidgetHostViewMac* view() {
+    return static_cast<RenderWidgetHostViewMac*>(view_.get());
+  }
+
+  void AdmitPrimaryDocument() {
+    ASSERT_TRUE(view());
+    view()->InitAsChild(gfx::NativeView(window_.contentView));
+    ASSERT_TRUE(view()->HasNativeInputAdmissionForDocument(
+        main_rfh()->GetWeakDocumentPtr()));
+  }
+
+  CocoaTestHelperWindow* __strong window_;
+  base::WeakPtr<RenderWidgetHostViewBase> view_;
+};
