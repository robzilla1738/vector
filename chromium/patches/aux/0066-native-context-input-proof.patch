+// The fixture drives Blink's actual widget and delayed HTML form navigation.
+// It never grants browser authority or infers a result from a matching URL.
+class AuxNavigationFrameHost final : public FakeLocalFrameHost {
+ public:
+  struct Completion { base::UnguessableToken token; DocumentToken document; bool requested; };
+  void DidCompleteAuxInputNavigation(const base::UnguessableToken& token,
+      const DocumentToken& document, bool requested) override {
+    completions.push_back({token, document, requested});
+  }
+  std::vector<Completion> completions;
+};
+class AuxNavigationFrameClient final : public frame_test_helpers::TestWebFrameClient {
+ public:
+  AuxNavigationFrameClient() { host.Init(GetRemoteNavigationAssociatedInterfaces()); }
+  void BeginNavigation(std::unique_ptr<WebNavigationInfo> info) override {
+    if (!capture) { TestWebFrameClient::BeginNavigation(std::move(info)); return; }
+    tokens.push_back(info->url_request.AuxInputContinuation());
+    methods.push_back(info->url_request.HttpMethod().Utf8());
+    during_input.push_back(AuxInputNavigationScope::CurrentToken().has_value());
+  }
+  bool capture = false;
+  AuxNavigationFrameHost host;
+  std::vector<std::optional<base::UnguessableToken>> tokens;
+  std::vector<std::string> methods;
+  std::vector<bool> during_input;
+};
+// Observe actual widget delivery without canceling or replacing default actions.
+class AuxNavigationInputRecorder final : public NativeEventListener {
+ public:
+  void Invoke(ExecutionContext*, Event* event) override {
+    if (event->type() == event_type_names::kMousedown) {
+      ++mouse_down_count;
+    } else if (event->type() == event_type_names::kMouseup) {
+      ++mouse_up_count;
+    } else if (event->type() == event_type_names::kClick) {
+      ++click_count;
+    }
+    all_trusted &= event->isTrusted();
+  }
+
+  unsigned mouse_down_count = 0;
+  unsigned mouse_up_count = 0;
+  unsigned click_count = 0;
+  bool all_trusted = true;
+};
+class AuxInputNavigationTest : public SimTest {
+ protected:
+  std::unique_ptr<frame_test_helpers::TestWebFrameClient> CreateWebFrameClientForMainFrame() override {
+    auto client = std::make_unique<AuxNavigationFrameClient>();
+    client_ = client.get();
+    return client;
+  }
+  void SetUp() override {
+    SimTest::SetUp();
+    ResizeView(gfx::Size(800, 600));
+    SimRequest page("https://continuation.test/start", "text/html");
+    LoadURL("https://continuation.test/start");
+    page.Complete(R"HTML(<style>body { font: 16px/24px sans-serif; }</style>
+      <a id="link" href="/next">Record 15</a>
+      <form action="/filter" method="get"><input name="status" value="approved"><button id="get">Apply filter</button></form>
+      <form action="/save" method="post"><input name="status" value="approved"><button id="post">Save</button></form>
+      <button id="plain">No navigation</button>)HTML");
+    Compositor().BeginFrame();
+    GetWebFrameWidget().UpdateAllLifecyclePhases(DocumentUpdateReason::kTest);
+    GetWebFrameWidget().SetFocus(true);
+    client_->capture = true;
+  }
+  void Click(const char* id, std::optional<base::UnguessableToken> token) {
+    auto* node = GetDocument().getElementById(AtomicString(id));
+    ASSERT_TRUE(node);
+    auto* rect = node->GetBoundingClientRect();
+    const auto* style = node->GetComputedStyle();
+    ASSERT_TRUE(style);
+    const gfx::PointF point(rect->x() + rect->width() / 2,
+                            rect->y() + rect->height() / 2);
+    SCOPED_TRACE(testing::Message()
+                 << "target=" << id << " rect=(" << rect->x() << ","
+                 << rect->y() << "," << rect->width() << "," << rect->height()
+                 << ") center=(" << point.x() << "," << point.y()
+                 << ") computed_font_size=" << style->FontSize());
+    ASSERT_GT(rect->width(), 2);
+    ASSERT_GT(rect->height(), 2);
+    ASSERT_EQ(GetDocument().elementFromPoint(point.x(), point.y()), node);
+    Persistent<AuxNavigationInputRecorder> delivered =
+        MakeGarbageCollected<AuxNavigationInputRecorder>();
+    node->addEventListener(event_type_names::kMousedown, delivered.Get(), false);
+    node->addEventListener(event_type_names::kMouseup, delivered.Get(), false);
+    node->addEventListener(event_type_names::kClick, delivered.Get(), false);
+    for (auto type : {WebInputEvent::Type::kMouseDown, WebInputEvent::Type::kMouseUp}) {
+      WebMouseEvent event(type, type == WebInputEvent::Type::kMouseDown ? WebInputEvent::kLeftButtonDown : WebInputEvent::kNoModifiers,
+                          WebInputEvent::GetStaticTimeStampForTests());
+      event.button = WebPointerProperties::Button::kLeft;
+      event.click_count = 1;
+      event.SetPositionInWidget(point);
+      if (type == WebInputEvent::Type::kMouseUp) event.SetAuxInputContinuation(token);
+      GetWebFrameWidget().HandleInputEvent(WebCoalescedInputEvent(event, ui::LatencyInfo()));
+    }
+    node->removeEventListener(event_type_names::kMousedown, delivered.Get(), false);
+    node->removeEventListener(event_type_names::kMouseup, delivered.Get(), false);
+    node->removeEventListener(event_type_names::kClick, delivered.Get(), false);
+    EXPECT_EQ(delivered->mouse_down_count, 1u);
+    EXPECT_EQ(delivered->mouse_up_count, 1u);
+    EXPECT_EQ(delivered->click_count, 1u);
+    EXPECT_TRUE(delivered->all_trusted);
+  }
+  raw_ptr<AuxNavigationFrameClient> client_ = nullptr;
+};
+TEST_F(AuxInputNavigationTest, RealLinkReleaseCarriesExactTicket) {
+  const auto token = base::UnguessableToken::Create();
