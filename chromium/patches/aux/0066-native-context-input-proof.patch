+TEST_F(RenderWidgetHostViewMacNativeInputTest,
+       OriginalAdmissionRetiresOnceAcrossViewReplacement) {
+  ASSERT_NO_FATAL_FAILURE(AdmitPrimaryDocument());
+  auto document = main_rfh()->GetWeakDocumentPtr();
+  auto original_view = view_;
+  unsigned retired = 0;
+  auto subscription = view()->ObserveNativeInputAdmissionRetirement(
+      document,
+      base::BindRepeating(
+          [](RenderWidgetHostViewMac* view, WeakDocumentPtr document,
+             unsigned* retired) {
+            ++*retired;
+            EXPECT_FALSE(view->HasNativeInputAdmissionForDocument(document));
+            auto reentrant = view->ObserveNativeInputAdmissionRetirement(
+                document, base::DoNothing());
+            EXPECT_FALSE(reentrant);
+          },
+          view(), document, &retired));
+  ASSERT_TRUE(subscription);
+  view()->DestroyOrDefer();
+  EXPECT_FALSE(original_view);
+  EXPECT_EQ(retired, 1u);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(retired, 1u);
+
+  // The same live document may acquire a new native view generation. The old
+  // original subscription must not follow it or fire when the new view retires.
+  ASSERT_NO_FATAL_FAILURE(InstallPrimaryMacView());
+  ASSERT_NO_FATAL_FAILURE(AdmitPrimaryDocument());
+  EXPECT_TRUE(view()->HasNativeInputAdmissionForDocument(document));
+  view()->DestroyOrDefer();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(retired, 1u);
+}
