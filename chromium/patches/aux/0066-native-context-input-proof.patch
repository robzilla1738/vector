+namespace blink {
+namespace {
+AuxInputNavigationScope* active_navigation_input = nullptr;
+}
+AuxInputNavigationScope::AuxInputNavigationScope(
+    LocalFrame& frame, std::optional<base::UnguessableToken> token)
+    : frame_(&frame), document_(frame.GetDocumentToken()), token_(token) {
+  previous_ = active_navigation_input;
+  active_navigation_input = token_ ? this : nullptr;
+}
+AuxInputNavigationScope::~AuxInputNavigationScope() {
+  active_navigation_input = previous_;
+  if (!token_) return;
+  if (frame_->GetPage())
+    frame_->GetLocalFrameHostRemote().DidCompleteAuxInputNavigation(
+        *token_, document_, requested_);
+}
+std::optional<base::UnguessableToken> AuxInputNavigationScope::CurrentToken() {
+  return active_navigation_input ? active_navigation_input->token_ : std::nullopt;
+}
+void AuxInputNavigationScope::NavigationRequested(
+    std::optional<base::UnguessableToken> token) {
+  if (active_navigation_input && token && active_navigation_input->token_ == token)
+    active_navigation_input->requested_ = true;
+}
+namespace {
+// Validate refreshes layout once before inspecting any source node. Walk the
+// flat tree so an invisible shadow host cannot leave a visible-looking editor.
+bool Visible(Element& node) {
+  if (!node.isConnected() || !node.GetLayoutObject() ||
+      !node.GetComputedStyle() ||
+      node.GetComputedStyle()->Visibility() != EVisibility::kVisible) {
+    return false;
+  }
+  unsigned depth = 0;
+  for (Node& ancestor : FlatTreeTraversal::InclusiveAncestorsOf(node)) {
+    if (++depth > 128) {
+      return false;
+    }
+    auto* element = DynamicTo<Element>(ancestor);
+    if (!element) {
+      continue;
+    }
+    const auto* style = element->GetComputedStyle();
+    if (element->hasAttribute(html_names::kInertAttr) ||
+        element->getAttribute(html_names::kAriaHiddenAttr) == "true" ||
+        (style && style->Opacity() == 0.f)) {
+      return false;
+    }
+  }
+  return !node.VisibleBoundsInLocalRoot().IsEmpty();
+}
+bool ExposedEditor(Element& editor) {
+  auto* box = editor.GetBoundingClientRect();
+  if (!box || box->width() <= 0 || box->height() <= 0) {
+    return false;
+  }
+  // Filling must not focus/scroll an offscreen editor or write behind an
+  // overlay. Use the same CSS client coordinates as native click admission;
+  // hit testing enforces viewport and ancestor clips without retargeting.
+  auto* hit = editor.GetTreeScope().ElementFromPoint(
+      box->x() + box->width() / 2, box->y() + box->height() / 2);
+  return hit && editor.contains(hit);
+}
+bool MemberURL(const KURL& url) {
+  return url.ProtocolIs("https") && !url.HasPort() && url.User().empty() &&
+         url.Pass().empty() &&
+         (url.Host() == "www.linkedin.com" || url.Host() == "linkedin.com") &&
+         url.GetPath().starts_with("/in/") && url.GetPath().length() > 4;
+}
+String MemberPath(const KURL& url) {
+  String path = url.GetPath().ToString();
+  return path.ends_with("/") ? path.substr(0, path.length() - 1) : path;
+}
+bool Sensitive(Element& node) {
+  const auto raw_type = node.getAttribute(html_names::kTypeAttr);
+  const auto raw_autocomplete =
+      node.getAttribute(html_names::kAutocompleteAttr);
+  const auto raw_name = node.getAttribute(html_names::kNameAttr);
+  if (raw_type.length() > 32 || raw_autocomplete.length() > 512 ||
+      raw_name.length() > 512) {
+    return true;
+  }
+  const auto type = raw_type.ToAsciiLower();
+  const auto autocomplete = raw_autocomplete.ToAsciiLower();
+  if (type == "password" || type == "hidden" ||
+      autocomplete.contains("password") ||
+      autocomplete.contains("one-time-code") || autocomplete.contains("cc-")) {
+    return true;
+  }
+  const auto name = raw_name.ToAsciiLower();
+  return name.length() > 512 || name.contains("password") ||
+         name.contains("secret") || name.contains("token") ||
+         name.contains("credential") || name.contains("api-key") ||
+         name.contains("api_key") || name.contains("credit") ||
+         name.contains("card-number");
+}
+bool Editable(Element& node) {
+  if (Sensitive(node) || node.IsDisabledFormControl() ||
+      node.hasAttribute(html_names::kReadonlyAttr) ||
+      node.getAttribute(html_names::kAriaReadonlyAttr) == "true") {
+    return false;
+  }
+  if (auto* input = DynamicTo<HTMLInputElement>(node)) {
+    return input->IsTextField();
+  }
+  return DynamicTo<TextControlElement>(node) || IsEditable(node);
+}
+String Caption(Element& action) {
+  String value = action.getAttribute(html_names::kAriaLabelAttr);
+  if (value.empty()) {
+    unsigned nodes = 0;
+    for (Node& node : NodeTraversal::InclusiveDescendantsOf(action)) {
+      if (++nodes > 128) {
+        return String();
+      }
+      if (auto* text = DynamicTo<Text>(node)) {
+        if (value.length() + text->data().length() > 512) {
+          return String();
+        }
+        value = value + text->data();
+      }
+    }
+  }
+  return value.length() > 512 ? String()
+                              : value.StripWhiteSpace().ToAsciiLower();
+}
+bool SendControl(Element& action, bool invitation) {
+  if (!action.HasTagName(html_names::kButtonTag) &&
+      action.getAttribute(html_names::kRoleAttr) != "button") {
+    return false;
+  }
+  if (action.IsDisabledFormControl() ||
+      action.getAttribute(html_names::kAriaDisabledAttr) == "true") {
+    return false;
+  }
+  const auto caption = Caption(action);
+  return invitation ? caption == "send invitation" || caption == "send now"
+                    : caption == "send";
+}
+}  // namespace
+
+class AuxContextActionRecord final
+    : public GarbageCollected<AuxContextActionRecord> {
+ public:
+  explicit AuxContextActionRecord(mojom::blink::AuxContextActionParamsPtr value)
+      : params(std::move(value)),
+        deadline(std::min(params->authority_deadline,
+                          base::TimeTicks::Now() + base::Seconds(2))) {
+    if (params->authority.IsValid() &&
+        params->authority.GetSize() == sizeof(base::subtle::Atomic32)) {
+      authority = params->authority.Map();
+    }
+    root = DynamicTo<Element>(DOMNodeIds::NodeForId(params->root_node_id));
+    recipient =
+        DynamicTo<Element>(DOMNodeIds::NodeForId(params->recipient_node_id));
+    editor = DynamicTo<Element>(DOMNodeIds::NodeForId(params->editor_node_id));
+    action = DynamicTo<Element>(DOMNodeIds::NodeForId(params->action_node_id));
+    document = root ? &root->GetDocument() : nullptr;
+    source_url = document ? document->Url() : KURL();
+  }
+  bool AuthorityCurrent() const {
+    return authority.IsValid() && base::TimeTicks::Now() < deadline &&
+           base::subtle::Acquire_Load(
+               authority.GetMemoryAs<base::subtle::Atomic32>()) == 1;
+  }
+  bool Validate(Document& current,
+                bool focus = false,
+                bool result_text = false) const {
+    if (!AuthorityCurrent() || document != &current ||
+        current.Url() != source_url || !current.GetFrame() ||
+        !current.GetFrame()->IsMainFrame()) {
+      return false;
+    }
+    current.UpdateStyleAndLayout(DocumentUpdateReason::kInput);
+    // Layout work may run lifecycle callbacks: recheck original authority,
+    // document and exact nodes before inspecting the refreshed source.
+    if (!AuthorityCurrent() || current.Url() != source_url || !root ||
+        !recipient || !editor || !action || document != &current ||
+        base::TimeTicks::Now() >= deadline || !current.GetFrame() ||
+        !current.GetFrame()->IsMainFrame() ||
+        !current.Url().ProtocolIs("https") || current.Url().HasPort() ||
+        (current.Url().Host() != "www.linkedin.com" &&
+         current.Url().Host() != "linkedin.com") ||
+        root == current.documentElement() || root == current.body() ||
+        &recipient->GetDocument() != &current ||
+        &editor->GetDocument() != &current ||
+        &action->GetDocument() != &current || !root->contains(recipient) ||
+        !root->contains(editor) || !root->contains(action) || !Visible(*root) ||
+        !Visible(*recipient) || !Visible(*editor) || !Visible(*action) ||
+        !Editable(*editor) || action->IsDisabledFormControl() ||
+        action->getAttribute(html_names::kAriaDisabledAttr) == "true" ||
+        (params->invitation &&
+         root->getAttribute(html_names::kRoleAttr) != "dialog") ||
+        current.GetFrame()->GetInputMethodController().HasComposition() ||
+        current.GetFrame()->GetInputMethodController().GetActiveEditContext() ||
+        editor->editContext() ||
+        (focus && current.FocusedElement() != editor)) {
+      return false;
+    }
+    auto* link = DynamicTo<HTMLAnchorElement>(recipient.Get());
+    KURL expected(params->recipient_url);
+    if (!link || link->getAttribute(html_names::kHrefAttr).length() > 2048 ||
+        !MemberURL(expected) || !MemberURL(link->Href()) ||
+        MemberPath(expected) != MemberPath(link->Href())) {
+      return false;
+    }
+    unsigned nodes = 0, recipient_count = 0, editor_count = 0, action_count = 0;
+    for (Node& descendant : NodeTraversal::InclusiveDescendantsOf(*root)) {
+      if (++nodes > 512) {
+        return false;
+      }
+      auto* element = DynamicTo<Element>(descendant);
+      if (!element) {
+        continue;
+      }
+      Element& node = *element;
+      if (Sensitive(node)) {
+        return false;
+      }
+      if (!Visible(node)) {
+        continue;
+      }
+      if (auto* anchor = DynamicTo<HTMLAnchorElement>(node);
+          anchor &&
+          anchor->getAttribute(html_names::kHrefAttr).length() <= 2048 &&
+          MemberURL(anchor->Href())) {
+        ++recipient_count;
+      }
+      if (Editable(node) &&
+          (!node.parentElement() || !IsEditable(*node.parentElement()))) {
+        ++editor_count;
+      }
+      if (SendControl(node, params->invitation)) {
+        ++action_count;
+      }
+    }
+    if (recipient_count != 1 || editor_count != 1 ||
+        AuxContextActions::EditorText(*editor).IsNull() ||
+        AuxContextActions::EditorText(*editor) !=
+            (result_text ? params->text : params->before_text)) {
+      return false;
+    }
+    if (params->operation == mojom::blink::AuxContextActionOperation::kFill) {
+      return action == editor && ExposedEditor(*editor) && AuthorityCurrent();
+    }
+    return action != editor && action_count == 1 &&
+           params->before_text == params->text &&
+           SendControl(*action, params->invitation) && AuthorityCurrent();
+  }
+
+  void Trace(Visitor* visitor) const {
+    visitor->Trace(root);
+    visitor->Trace(recipient);
+    visitor->Trace(editor);
+    visitor->Trace(action);
+    visitor->Trace(document);
+  }
+  mojom::blink::AuxContextActionParamsPtr params;
+  WeakMember<Element> root, recipient, editor, action;
+  WeakMember<Document> document;
+  base::TimeTicks deadline;
+  base::ReadOnlySharedMemoryMapping authority;
+  KURL source_url;
+  bool refused = false;
+  bool input_dispatched = false;
+  bool press_dispatched = false;
+  bool release_dispatched = false;
+  bool click_dispatched = false;
+  bool text_command_completed = false;
+};
+namespace {
+thread_local AuxContextActionRecord* active_text_context = nullptr;
+}
+
+String AuxContextActions::EditorText(Element& node) {
+  unsigned count = 0, text_length = 0;
+  for (Node& descendant : NodeTraversal::InclusiveDescendantsOf(node)) {
+    if (++count > 512) {
+      return String();
+    }
+    if (auto* element = DynamicTo<Element>(descendant);
+        element && Sensitive(*element)) {
+      return String();
+    }
+    if (auto* text = DynamicTo<Text>(descendant)) {
+      if (text->data().length() > 8000 - text_length) {
+        return String();
+      }
+      text_length += text->data().length();
+    }
+  }
+  String value = DynamicTo<TextControlElement>(node)
+                     ? To<TextControlElement>(node).Value()
+                     : node.innerText();
+  return value.length() <= 8000 ? value : String();
+}
+String AuxContextActions::Prepare(
+    Document& document,
+    mojom::blink::AuxContextActionParamsPtr params) {
+  if (!params || params->owner.length() != 32 || params->action_id.empty() ||
+      params->action_id.length() > 256 ||
+      params->source_digest.length() != 64 ||
+      params->before_text.length() > 8000 || params->text.length() > 8000 ||
+      params->recipient_url.length() > 2048 ||
+      !std::isfinite(params->input_scale) || params->input_scale <= 0 ||
+      params->input_scale > 100) {
+    return String();
+  }
+  Vector<String> stale;
+  for (const auto& entry : records_) {
+    if (!entry.value->Validate(document)) {
+      stale.push_back(entry.key);
+    }
+  }
+  for (const auto& key : stale) {
+    records_.erase(key);
+  }
+  if (records_.size() >= 8) {
+    return String();
+  }
+  auto* record =
+      MakeGarbageCollected<AuxContextActionRecord>(std::move(params));
+  if (!record->Validate(document)) {
+    return String();
+  }
+  String token = String::FromUtf8(base::UnguessableToken::Create().ToString());
+  records_.Set(token, record);
+  return token;
+}
+AuxContextActions::Result AuxContextActions::Apply(
+    Document& document,
+    const String& token,
+    const String& owner,
+    base::OnceCallback<Result(const mojom::blink::AuxContextActionParams&)>
+        input) {
+  auto it = records_.find(token);
+  if (it == records_.end()) {
+    return Result::kRefused;
+  }
+  Persistent<AuxContextActionRecord> record(it->value.Get());
+  // Consume before any focus, event listener, input, callback or re-entrant
+  // apply.
+  records_.erase(it);
+  if (record->params->owner != owner || !record->Validate(document)) {
+    return Result::kRefused;
+  }
+  base::AutoReset<AuxContextActionRecord*> scope(&active_text_context,
+                                                 record.Get());
+  const auto result = std::move(input).Run(*record->params);
+  // A successful transport/handler return is not evidence of the intended
+  // click: drag, lifecycle, inspector and input suppression can return early.
+  const bool incomplete_click =
+      record->params->operation ==
+          mojom::blink::AuxContextActionOperation::kClick &&
+      !(record->press_dispatched && record->release_dispatched &&
+        record->click_dispatched);
+  const bool incomplete_fill =
+      record->params->operation ==
+          mojom::blink::AuxContextActionOperation::kFill &&
+      !record->text_command_completed;
+  // The final event handler may revoke native ownership, replace the source or
+  // redirect the recipient after input began. Effects cannot be undone here;
+  // retain uncertainty without replay and never change the admission payload.
+  const bool changed_after_input =
+      !record->Validate(document,
+                        record->params->operation ==
+                            mojom::blink::AuxContextActionOperation::kFill,
+                        true);
+  return record->refused || incomplete_click || incomplete_fill ||
+                 changed_after_input
+             ? (result == Result::kUncertain || record->input_dispatched
+                    ? Result::kUncertain
+                    : Result::kRefused)
+             : result;
+}
+void AuxContextActions::Retire(const String& token, const String& owner) {
+  auto it = records_.find(token);
+  if (it != records_.end() && it->value->params->owner == owner) {
+    records_.erase(it);
+  }
+}
+bool AuxContextActions::ValidateActiveTextContext(Document& document) {
+  if (!active_text_context) {
+    return true;
+  }
+  if (!ValidateActiveContext(document, true)) {
+    return false;
+  }
+  const auto range =
+      document.GetFrame()->GetInputMethodController().GetSelectionOffsets();
+  const bool valid =
+      !range.IsNull() && range.Start() == 0 &&
+      range.End() == active_text_context->params->before_text.length() &&
+      active_text_context->AuthorityCurrent();
+  active_text_context->refused |= !valid;
+  return valid;
+}
+bool AuxContextActions::ValidateActiveTextInsertion(Document& document,
+                                                    const String& text) {
+  if (!active_text_context) {
+    return true;
+  }
+  // The normal editor may truncate maxlength or rewrite line endings. Never
+  // insert a different payload under an exact-content approval. Literal CR is
+  // unsupported even when the ordinary newline-normalization flag is disabled.
+  const bool valid = ValidateActiveTextContext(document) &&
+                     active_text_context->params->operation ==
+                         mojom::blink::AuxContextActionOperation::kFill &&
+                     active_text_context->params->text == text &&
+                     !text.contains('\r') &&
+                     active_text_context->AuthorityCurrent();
+  active_text_context->refused |= !valid;
+  return valid;
+}
+bool AuxContextActions::ValidateActiveContext(Document& document, bool focus) {
+  if (!active_text_context) {
+    return true;
+  }
+  const bool valid = !active_text_context->refused &&
+                     active_text_context->Validate(document, focus);
+  active_text_context->refused |= !valid;
+  return valid;
+}
+bool AuxContextActions::ValidateActivePointerTarget(Node* target,
+                                                    bool actionable) {
+  if (!active_text_context) {
+    return true;
+  }
+  const bool valid =
+      target && !active_text_context->refused &&
+      active_text_context->Validate(target->GetDocument()) &&
+      (!actionable || active_text_context->action->contains(target));
+  active_text_context->refused |= !valid;
+  return valid;
+}
+bool AuxContextActions::MarkActiveInputDispatched(InputEvent event) {
+  if (!active_text_context) {
+    return true;
+  }
+  // Final acquire-load linearizes this input event's admission against native
+  // owner retirement. It cannot retroactively cancel an already admitted event.
+  if (active_text_context->refused ||
+      !active_text_context->AuthorityCurrent()) {
+    active_text_context->refused = true;
+    return false;
+  }
+  active_text_context->input_dispatched = true;
+  active_text_context->press_dispatched |= event == InputEvent::kPress;
+  active_text_context->release_dispatched |= event == InputEvent::kRelease;
+  active_text_context->click_dispatched |= event == InputEvent::kClick;
+  return true;
+}
+bool AuxContextActions::DidDispatchActivePress() {
+  return active_text_context && active_text_context->press_dispatched;
+}
+void AuxContextActions::DidCompleteActiveTextCommand(const String& text) {
+  if (active_text_context &&
+      active_text_context->params->operation ==
+          mojom::blink::AuxContextActionOperation::kFill &&
+      active_text_context->params->text == text) {
+    active_text_context->text_command_completed = true;
+  }
+}
+void AuxContextActions::Trace(Visitor* visitor) const {
+  visitor->Trace(records_);
+}
+}  // namespace blink
