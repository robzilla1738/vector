+  params->root_node_id = context->GetRootNodeId();
+  params->recipient_node_id = context->GetRecipientNodeId();
+  params->editor_node_id = context->GetEditorNodeId();
+  params->action_node_id = context->GetActionNodeId();
+  params->recipient_url = context->GetRecipientUrl();
+  params->before_text = context->GetBeforeText();
+  params->text = context->GetText();
+  params->action_id = context->GetActionId();
+  params->source_digest = context->GetSourceDigest();
+  params->owner = owner;
+  params->input_scale = ScaleFactor();
+  params->authority = admitted_owner->second.authority.Duplicate();
+  params->authority_deadline = admitted_owner->second.deadline;
+  aux_context_owners_.erase(admitted_owner);
+  params->invitation = context->GetInvitation();
