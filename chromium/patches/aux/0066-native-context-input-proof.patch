+void InputHandler::RegisterAuxContextOwner(
+    const std::string& owner,
+    base::ReadOnlySharedMemoryRegion authority,
+    base::TimeTicks deadline) {
+  std::vector<std::string> expired;
+  for (const auto& entry : aux_context_owners_) {
+    if (entry.second.deadline <= base::TimeTicks::Now()) {
+      expired.push_back(entry.first);
