+                      "Exact action context changed or is unsupported"));
+                  return;
+                }
+                self->aux_context_tickets_.emplace(
+                    token, AuxContextTicket{owner, document, widget, deadline,
+                                            std::move(authority)});
+                self->ExpireAuxContextActions();
+                done->sendSuccess(token);
+              },
+              weak_factory_.GetWeakPtr(), original, widget, owner,
+              std::move(authority), deadline, std::move(callback)));
+}
+
+void InputHandler::ApplyAuxContextAction(
+    const std::string& token,
+    const std::string& owner,
+    std::unique_ptr<ApplyAuxContextActionCallback> callback) {
+  ExpireAuxContextActions();
+  auto found = aux_context_tickets_.find(token);
+  if (!host_ || host_->GetParent() || !host_->GetRenderWidgetHost() ||
+      found == aux_context_tickets_.end() || found->second.owner != owner ||
+      found->second.document.AsRenderFrameHostIfValid() != host_ ||
+      found->second.widget.get() != host_->GetRenderWidgetHost() ||
+      !host_->GetRenderWidgetHost()->GetView()) {
+    callback->sendSuccess("refused");
+    return;
+  }
+  // Browser and renderer each consume once before callbacks or any input.
+  auto ticket = std::move(found->second);
+  aux_context_tickets_.erase(found);
+  auto weak = weak_factory_.GetWeakPtr();
+  ticket.widget->Focus();
+  // Focus may re-enter native/page ownership. The original callback remains
+  // owned locally even if that re-entrancy destroys this handler.
+  if (!weak || !ticket.widget || !ticket.widget->GetView() ||
+      ticket.document.AsRenderFrameHostIfValid() != weak->host_) {
+    callback->sendSuccess("uncertain");
+    return;
+  }
+  ticket.widget->GetWidgetInputHandler()->ApplyAuxContextAction(
+      token, owner, weak->ScaleFactor(),
+      gfx::PointF(ticket.widget->GetView()->GetViewBounds().origin()),
+      base::BindOnce(
+          [](std::unique_ptr<ApplyAuxContextActionCallback> done,
+             blink::mojom::AuxContextActionResult result) {
+            done->sendSuccess(
+                result == blink::mojom::AuxContextActionResult::kApplied
+                    ? "applied"
+                    : "uncertain");
+          },
+          std::move(callback)));
+}
+Response InputHandler::RetireAuxContextAction(const std::string& token,
+                                              const std::string& owner) {
+  auto found = aux_context_tickets_.find(token);
+  if (found != aux_context_tickets_.end() && found->second.owner == owner) {
+    auto ticket = std::move(found->second);
+    aux_context_tickets_.erase(found);
+    if (ticket.widget) {
+      ticket.widget->GetWidgetInputHandler()->RetireAuxContextAction(token,
+                                                                     owner);
+    }
+  }
+  return Response::Success();
+}
+void InputHandler::ExpireAuxContextActions() {
+  aux_context_timer_.Stop();
+  std::vector<std::string> expired;
+  std::optional<base::TimeTicks> next;
+  for (const auto& [token, ticket] : aux_context_tickets_) {
+    if (ticket.deadline <= base::TimeTicks::Now() || !ticket.widget ||
+        !ticket.authority.IsValid() ||
+        base::subtle::Acquire_Load(
+            ticket.authority.GetMemoryAs<base::subtle::Atomic32>()) != 1 ||
+        ticket.document.AsRenderFrameHostIfValid() != host_) {
+      expired.push_back(token);
+    } else if (!next || ticket.deadline < *next) {
+      next = ticket.deadline;
+    }
+  }
+  for (const auto& token : expired) {
+    auto ticket = std::move(aux_context_tickets_.at(token));
+    aux_context_tickets_.erase(token);
+    if (ticket.widget) {
+      ticket.widget->GetWidgetInputHandler()->RetireAuxContextAction(
+          token, ticket.owner);
+    }
+  }
+  if (next) {
+    aux_context_timer_.Start(
+        FROM_HERE, *next - base::TimeTicks::Now(),
+        base::BindOnce(&InputHandler::ExpireAuxContextActions,
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+void InputHandler::RetireAuxContextActions() {
+  aux_context_owners_.clear();
+  aux_context_timer_.Stop();
+  auto tickets = std::move(aux_context_tickets_);
+  aux_context_tickets_.clear();
+  for (const auto& [token, ticket] : tickets) {
+    if (ticket.widget) {
+      ticket.widget->GetWidgetInputHandler()->RetireAuxContextAction(
+          token, ticket.owner);
+    }
+  }
