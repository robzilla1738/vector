+class AuxContextWidgetTest : public SimTest {
+ protected:
+  using Result = mojom::blink::AuxContextActionResult;
+  void SetUp() override {
+    SimTest::SetUp();
+    ResizeView(gfx::Size(800, 600));
+    SimRequest request("https://www.linkedin.com/messaging/", "text/html");
+    LoadURL("https://www.linkedin.com/messaging/");
+    request.Complete(
+        R"HTML(<section id="root"><a id="recipient" href="https://www.linkedin.com/in/alex/">Alex</a><textarea id="editor">Old draft</textarea><button id="send">Send</button></section>)HTML");
+    Compositor().BeginFrame();
+    GetWebFrameWidget().UpdateAllLifecyclePhases(DocumentUpdateReason::kTest);
+    // Match the native InputHandler's real widget focus before editor input.
+    GetWebFrameWidget().SetFocus(true);
+    authority_ = base::ReadOnlySharedMemoryRegion::Create(
+        sizeof(base::subtle::Atomic32));
+    ASSERT_TRUE(authority_.IsValid());
+    base::subtle::Release_Store(
+        authority_.mapping.GetMemoryAs<base::subtle::Atomic32>(), 1);
+    Node("send")->addEventListener(
+        event_type_names::kMousedown,
+        MakeGarbageCollected<MutateOnInput>(
+            base::BindLambdaForTesting([this] { ++presses_; })),
+        false);
+    Node("send")->addEventListener(
+        event_type_names::kMouseup,
+        MakeGarbageCollected<MutateOnInput>(
+            base::BindLambdaForTesting([this] { ++releases_; })),
+        false);
+    Node("send")->addEventListener(
+        event_type_names::kClick,
+        MakeGarbageCollected<MutateOnInput>(
+            base::BindLambdaForTesting([this] { ++clicks_; })),
+        false);
+    CountEditorEvents(*Node("editor"));
+  }
+  void TearDown() override {
+    SetIgnored(false);
+    SimTest::TearDown();
+  }
+  Element* Node(const char* id) {
+    return GetDocument().getElementById(AtomicString(id));
+  }
+  void CountEditorEvents(Element& editor) {
+    editor.addEventListener(
+        event_type_names::kFocus,
+        MakeGarbageCollected<MutateOnInput>(
+            base::BindLambdaForTesting([this] { ++focuses_; })),
+        false);
+    editor.addEventListener(
+        event_type_names::kBeforeinput,
+        MakeGarbageCollected<MutateOnInput>(
+            base::BindLambdaForTesting([this] { ++before_inputs_; })),
+        false);
+    editor.addEventListener(
+        event_type_names::kInput,
+        MakeGarbageCollected<MutateOnInput>(
+            base::BindLambdaForTesting([this] { ++inputs_; })),
+        false);
+  }
+  HTMLInputElement* UseSingleLineEditor() {
+    auto* input = To<HTMLInputElement>(
+        GetDocument().CreateRawElement(html_names::kInputTag));
+    input->setAttribute(html_names::kIdAttr, AtomicString("editor"));
+    input->setAttribute(html_names::kValueAttr, AtomicString("Old draft"));
+    Node("root")->ReplaceChild(input, Node("editor"));
+    CountEditorEvents(*input);
+    return input;
+  }
+  void SetIgnored(bool ignored) {
+    const auto token = WebView().GetPage()->BrowsingContextGroupToken();
+    if (WebFrameWidgetImpl::IgnoreInputEvents(token) != ignored) {
+      WebFrameWidgetImpl::SetIgnoreInputEvents(token, ignored);
+    }
+  }
+  String Prepare(bool fill = false, const String& text = "Requested draft") {
+    auto params = mojom::blink::AuxContextActionParams::New();
+    params->root_node_id = DOMNodeIds::IdForNode(Node("root"));
+    params->recipient_node_id = DOMNodeIds::IdForNode(Node("recipient"));
+    params->editor_node_id = DOMNodeIds::IdForNode(Node("editor"));
+    params->action_node_id =
+        DOMNodeIds::IdForNode(Node(fill ? "editor" : "send"));
+    params->recipient_url = "https://www.linkedin.com/in/alex/";
+    params->before_text = "Old draft";
+    params->text = fill ? text : "Old draft";
+    params->action_id = "original-action";
+    params->source_digest = String::FromUtf8(std::string(64, 'a'));
+    params->owner = owner_;
+    params->input_scale = 1;
+    params->authority = authority_.region.Duplicate();
+    params->authority_deadline = base::TimeTicks::Now() + base::Seconds(2);
+    params->invitation = false;
+    params->operation = fill ? mojom::blink::AuxContextActionOperation::kFill
+                             : mojom::blink::AuxContextActionOperation::kClick;
+    return GetWebFrameWidget().PrepareAuxContextAction(std::move(params));
+  }
+  Result Apply(const String& token) {
+    return GetWebFrameWidget().ApplyAuxContextAction(token, owner_, 1,
+                                                     gfx::PointF());
+  }
+  void CoverEditor() {
+    auto* overlay = GetDocument().CreateRawElement(html_names::kDivTag);
+    overlay->setAttribute(
+        html_names::kStyleAttr,
+        AtomicString("position:fixed;inset:0;z-index:99999;background:black"));
+    GetDocument().body()->AppendChild(overlay);
+  }
+  void ExpectNoFillEvents() {
+    EXPECT_EQ(focuses_, 0u);
+    EXPECT_EQ(before_inputs_, 0u);
+    EXPECT_EQ(inputs_, 0u);
+    EXPECT_EQ(presses_, 0u);
+    EXPECT_EQ(releases_, 0u);
+    EXPECT_EQ(clicks_, 0u);
+    EXPECT_EQ(To<HTMLTextAreaElement>(Node("editor"))->Value(), "Old draft");
+  }
+  base::MappedReadOnlyRegion authority_;
+  String owner_ = String::FromUtf8(std::string(32, 'A'));
+  unsigned presses_ = 0, releases_ = 0, clicks_ = 0;
+  unsigned focuses_ = 0, before_inputs_ = 0, inputs_ = 0;
+};
