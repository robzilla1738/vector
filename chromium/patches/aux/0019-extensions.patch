+void WebUIBrowserUI::HandleAuxExtensionsRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  const base::ListValue* list = &args;
+  if (method == "installUnpackedExtension") {
+    if (!list->empty()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Unpacked install takes no arguments");
+      return;
+    }
+    if (browser_->GetProfile()->IsOffTheRecord()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Extensions require a regular Profile");
+      return;
+    }
+    if (open_file_dialog_) {
+      std::move(callback).Run(false, "", "conflict",
+                              "A file dialog is already open");
+      return;
+    }
+    auto* active = browser_->GetTabStripModel()->GetActiveWebContents();
+    open_file_dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(active));
+    if (!open_file_dialog_) {
+      std::move(callback).Run(false, "", "not_supported",
+                              "The system file dialog is unavailable");
+      return;
+    }
+    file_dialog_purpose_ = FileDialogPurpose::kUnpackedExtension;
+    file_dialog_callback_ = std::move(callback);
+    open_file_dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_FOLDER, std::u16string(),
+        browser_->GetProfile()->last_selected_directory(), nullptr, 0,
+        base::FilePath::StringType(), browser_->GetWindow()->GetNativeWindow());
+    return;
+  }
+  if (aux::HandlesExtensionUI(method)) {
+    aux::HandleExtensionUI(browser_, method, *list,
+        base::BindOnce(
+            [](RequestCallback callback, bool ok, std::string result,
+               std::string code, std::string message) {
+              std::move(callback).Run(ok, result, code, message);
+            }, std::move(callback)));
+    return;
+  }
+  if (aux::ExtensionBridge::Handles(method)) {
+    aux::ExtensionBridge::Handle(
+        browser_->GetProfile(), browser_, browser_window()->GetNativeWindow(),
+        method, *list,
+        base::BindOnce(
+            [](RequestCallback callback, bool ok, std::string result,
+               std::string code, std::string message) {
+              std::move(callback).Run(ok, result, code, message);
+            },
+            std::move(callback)));
+    return;
+  }
+  std::move(callback).Run(false, "", "not_found",
+                          "Unsupported Aux shell method: " + method);
+}
+#endif
