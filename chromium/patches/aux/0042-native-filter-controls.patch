+void ContentBlockingController::UpdateControls(
+    std::optional<bool> enabled, std::string host, bool allowed,
+    OwnerCurrent current, Reply callback) {
+  EnsureReady(base::BindOnce(
+      [](base::WeakPtr<ContentBlockingController> owner,
+         std::optional<bool> enabled, std::string host, bool allowed,
+         OwnerCurrent current, Reply callback, bool ready) {
+        if (!owner || !ready || !current || !current.Run() ||
+            owner->profile_->IsOffTheRecord() || !owner->snapshot_ ||
+            owner->semantic_retired_) {
+          std::move(callback).Run(std::nullopt,
+                                  "Original content blocking window retired");
+          return;
+        }
+        if (owner->commit_in_progress_) {
+          std::move(callback).Run(std::nullopt,
+                                  "A native filter change is being committed");
+          return;
+        }
+        auto staged = std::make_unique<Staging>();
+        staged->base_generation = owner->snapshot_->generation;
+        staged->snapshot = *owner->snapshot_;
+        auto& next = staged->snapshot;
+        if (enabled.has_value()) {
+          next.enabled = *enabled;
+        } else {
+          auto position = std::lower_bound(next.allowed.begin(),
+                                           next.allowed.end(), host);
+          if (allowed && (position == next.allowed.end() || *position != host)) {
+            if (next.allowed.size() >= kMaxAllowed) {
+              std::move(callback).Run(std::nullopt, "Too many site exceptions");
+              return;
+            }
+            next.allowed.insert(position, host);
+          } else if (!allowed && position != next.allowed.end() &&
+                     *position == host) {
+            next.allowed.erase(position);
+          }
+        }
+        if (next.enabled == owner->snapshot_->enabled &&
+            next.allowed == owner->snapshot_->allowed) {
+          std::move(callback).Run(next.Receipt(
+              owner->profile_->GetPath().BaseName().AsUTF8Unsafe()), "");
+          return;
+        }
+        if (!ValidGeneration(next.generation + 1)) {
+          std::move(callback).Run(std::nullopt, "Native filter generation exhausted");
+          return;
+        }
+        ++next.generation;
+        next.digest = FilterPolicyDigest(next.sources, next.enabled, next.allowed);
+        // A runtime upload is only a candidate until Commit. Original human
+        // controls can retire that unaccepted candidate even while Node is paused.
+        owner->staging_.reset();
+        owner->CommitStaged(std::move(staged), std::move(current),
+                            std::move(callback));
+      }, weak_factory_.GetWeakPtr(), enabled, std::move(host), allowed,
+      std::move(current), std::move(callback)));
 }
