+mojom::Failure ExtractPdf(base::span<const uint8_t> bytes,
+                          DocumentSegments& output) {
+  PdfLibrary library;
+  ScopedFPDFDocument document(
+      FPDF_LoadMemDocument64(bytes.data(), bytes.size(), nullptr));
+  if (!document) {
+    return FPDF_GetLastError() == FPDF_ERR_PASSWORD
+               ? mojom::Failure::kEncrypted
+               : mojom::Failure::kInvalidDocument;
+  }
+  if (FPDF_GetSecurityHandlerRevision(document.get()) != -1) {
+    return mojom::Failure::kEncrypted;
+  }
+  const int pages = FPDF_GetPageCount(document.get());
+  if (pages <= 0) {
+    return mojom::Failure::kInvalidDocument;
+  }
+  output.format = mojom::Format::kPdf;
+  output.page_count = pages;
+  size_t characters = 0;
+  for (int page_index = 0; page_index < pages; ++page_index) {
+    ScopedFPDFPage page(FPDF_LoadPage(document.get(), page_index));
+    if (!page) {
+      return mojom::Failure::kInvalidDocument;
+    }
+    ScopedFPDFTextPage text_page(FPDFText_LoadPage(page.get()));
+    if (!text_page) {
+      return mojom::Failure::kInvalidDocument;
+    }
+    const int count = FPDFText_CountChars(text_page.get());
+    if (count < 0) {
+      return mojom::Failure::kInvalidDocument;
+    }
+    if (static_cast<size_t>(count) > kMaxSourceBytes - characters) {
+      return mojom::Failure::kStructureLimit;
+    }
+    characters += count;
+    std::string text;
+    uint32_t unmapped = 0;
+    bool has_text = false;
+    for (int index = 0; index < count; ++index) {
+      unsigned int code = FPDFText_GetUnicode(text_page.get(), index);
+      if (!code) {
+        ++unmapped;
+        code = 0xfffd;
+      } else if (code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) {
+        return mojom::Failure::kInvalidDocument;
+      } else if (code != ' ' && code != '\t' && code != '\r' && code != '\n') {
+        has_text = true;
+      }
+      base::WriteUnicodeCharacter(code, &text);
+      if (text.size() > kMaxTextBytes - output.text_bytes()) {
+        return mojom::Failure::kTextLimit;
+      }
+    }
+    if (unmapped) {
+      output.Warn(mojom::WarningCode::kUnmappedText, unmapped,
+                  mojom::Story::kNone, page_index + 1);
+    }
+    if (!has_text) {
+      output.Warn(mojom::WarningCode::kNoSelectableText, 1, mojom::Story::kNone,
+                  page_index + 1);
+      continue;
+    }
+    base::ReplaceSubstringsAfterOffset(&text, 0, "\r\n", "\n");
+    base::ReplaceSubstringsAfterOffset(&text, 0, "\r", "\n");
+    if (!text.ends_with('\n')) {
+      text.push_back('\n');
+    }
+    size_t start = 0;
+    uint32_t block = 1;
+    while (start < text.size()) {
+      const size_t end = text.find('\n', start) + 1;
+      auto location = mojom::PdfLocator::New();
+      location->page = page_index + 1;
+      location->block = block++;
+      const auto error = output.Add(mojom::Locator::NewPdf(std::move(location)),
+                                    text.substr(start, end - start));
+      if (error != mojom::Failure::kNone) {
+        return error;
+      }
+      start = end;
+    }
+  }
+  return output.text_bytes() ? mojom::Failure::kNone : mojom::Failure::kNoText;
+}
+}  // namespace aux::document
