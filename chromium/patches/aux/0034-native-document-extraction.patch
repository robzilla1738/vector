@@ -0,0 +1,124 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/services/aux_document/document_extractor.h"
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/memory/shared_memory_mapping.h"
+#include "base/process/process.h"
+#include "base/strings/string_util.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/thread_pool.h"
+#include "chrome/services/aux_document/document_segments.h"
+#include "content/public/common/content_switches.h"
+namespace aux::document {
+class DocumentExtractor::Parser {
+ public:
+  mojom::StartResultPtr Start(base::ReadOnlySharedMemoryRegion source,
+                              uint32_t source_bytes) {
+    if (source_bytes > kMaxSourceBytes) {
+      return mojom::StartResult::NewFailure(mojom::Failure::kSourceLimit);
+    }
+    base::ReadOnlySharedMemoryMapping mapping;
+    if (source.IsValid()) {
+      mapping = source.Map();
+    }
+    if ((source_bytes &&
+         (!mapping.IsValid() || mapping.size() != source_bytes)) ||
+        (!source_bytes && source.IsValid())) {
+      return mojom::StartResult::NewFailure(mojom::Failure::kInvalidDocument);
+    }
+    const auto bytes = source_bytes ? mapping.GetMemoryAsSpan<const uint8_t>()
+                                    : base::span<const uint8_t>();
+    const std::string_view text = base::as_string_view(bytes);
+    mojom::Failure failure = mojom::Failure::kNone;
+    if (text.substr(0, 1024).find("%PDF-") != std::string_view::npos) {
+      failure = ExtractPdf(bytes, output_);
+    } else if (text.starts_with("PK\003\004") ||
+               text.starts_with("PK\005\006")) {
+      failure = ExtractDocx(bytes, output_);
+    } else if (text.find('\0') != std::string_view::npos ||
+               !base::IsStringUTF8(text)) {
+      failure = mojom::Failure::kUnsupportedFormat;
+    } else {
+      std::string normalized(text);
+      if (normalized.starts_with("\xef\xbb\xbf")) {
+        normalized.erase(0, 3);
+      }
+      base::ReplaceSubstringsAfterOffset(&normalized, 0, "\r\n", "\n");
+      base::ReplaceSubstringsAfterOffset(&normalized, 0, "\r", "\n");
+      size_t start = 0;
+      uint32_t line = 1;
+      while (start < normalized.size()) {
+        const size_t newline = normalized.find('\n', start);
+        const size_t end =
+            newline == std::string::npos ? normalized.size() : newline + 1;
+        auto locator = mojom::TextLocator::New();
+        locator->line = line++;
+        failure = output_.Add(mojom::Locator::NewText(std::move(locator)),
+                              normalized.substr(start, end - start));
+        if (failure != mojom::Failure::kNone) {
+          break;
+        }
+        start = end;
+      }
+    }
+    if (failure != mojom::Failure::kNone) {
+      return mojom::StartResult::NewFailure(failure);
+    }
+    return mojom::StartResult::NewMetadata(output_.Finish());
+  }
+  mojom::ChunkPtr ReadChunk(uint32_t index) { return output_.Chunk(index); }
+
+ private:
+  DocumentSegments output_;
+};
+DocumentExtractor::DocumentExtractor(
+    mojo::PendingReceiver<mojom::DocumentExtractor> receiver)
+    : receiver_(this, std::move(receiver)),
+      parser_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::TaskPriority::USER_VISIBLE})) {
+  CHECK_EQ(base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+               switches::kProcessType),
+           switches::kUtilityProcess);
+}
+DocumentExtractor::~DocumentExtractor() {
+  // This primordial interface owns an entire dedicated process. Its IO receiver
+  // must reclaim even a parser stuck on the separate parsing sequence. Never
+  // signal a PID: the child itself is the exact process whose owner retired.
+  base::Process::TerminateCurrentProcessImmediately(0);
+}
+void DocumentExtractor::Start(base::ReadOnlySharedMemoryRegion source,
+                              uint32_t source_bytes,
+                              StartCallback callback) {
+  if (started_) {
+    receiver_.ReportBadMessage(
+        "Document extractor accepts one immutable source");
+    return;
+  }
+  started_ = true;
+  parser_.AsyncCall(&Parser::Start)
+      .WithArgs(std::move(source), source_bytes)
+      .Then(base::BindOnce(&DocumentExtractor::Started,
+                           weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+void DocumentExtractor::Started(StartCallback callback,
+                                mojom::StartResultPtr result) {
+  if (result->is_metadata()) {
+    chunk_count_ = result->get_metadata()->chunk_count;
+  }
+  std::move(callback).Run(std::move(result));
+}
+void DocumentExtractor::ReadChunk(uint32_t index, ReadChunkCallback callback) {
+  if (index >= chunk_count_) {
+    receiver_.ReportBadMessage(
+        "Document chunk is outside the immutable snapshot");
+    return;
+  }
+  parser_.AsyncCall(&Parser::ReadChunk)
+      .WithArgs(index)
+      .Then(std::move(callback));
+}
+}  // namespace aux::document
