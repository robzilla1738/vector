@@ -0,0 +1,120 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/services/aux_document/document_segments.h"
+
+#include <array>
+#include <utility>
+
+#include "base/check.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+namespace aux::document {
+namespace {
+uint32_t& Offset(mojom::Locator& locator) {
+  if (locator.is_text()) {
+    return locator.get_text()->offset;
+  }
+  if (locator.is_pdf()) {
+    return locator.get_pdf()->offset;
+  }
+  return locator.get_docx()->offset;
+}
+void HashLength(crypto::hash::Hasher& hash, size_t size) {
+  const std::array<uint8_t, 4> bytes = {
+      static_cast<uint8_t>(size >> 24), static_cast<uint8_t>(size >> 16),
+      static_cast<uint8_t>(size >> 8), static_cast<uint8_t>(size)};
+  hash.Update(bytes);
+}
+}  // namespace
+DocumentSegments::DocumentSegments() {
+  hash_.Update("aux-document-text-v1\n");
+}
+DocumentSegments::~DocumentSegments() = default;
+mojom::Failure DocumentSegments::Add(mojom::LocatorPtr locator,
+                                     std::string text) {
+  if (!base::IsStringUTF8(text) || text.find('\0') != std::string::npos) {
+    return mojom::Failure::kInvalidDocument;
+  }
+  base::ReplaceSubstringsAfterOffset(&text, 0, "\r\n", "\n");
+  base::ReplaceSubstringsAfterOffset(&text, 0, "\r", "\n");
+  if (text.size() > kMaxTextBytes - text_bytes_) {
+    return mojom::Failure::kTextLimit;
+  }
+  size_t offset = 0;
+  while (offset < text.size()) {
+    size_t size = std::min(kMaxSegmentBytes, text.size() - offset);
+    while (offset + size < text.size() &&
+           (static_cast<uint8_t>(text[offset + size]) & 0xc0) == 0x80) {
+      --size;
+    }
+    auto item = mojom::Segment::New();
+    item->locator = locator.Clone();
+    Offset(*item->locator) += offset;
+    item->text = text.substr(offset, size);
+    const std::string key = LocatorKey(*item->locator);
+    const size_t bytes = 8 + key.size() + size;
+    if (bytes > kMaxFramedBytes - framed_bytes_) {
+      return mojom::Failure::kStructureLimit;
+    }
+    if (chunks_.empty() || bytes > kMaxChunkBytes - chunk_bytes_) {
+      auto chunk = mojom::Chunk::New();
+      chunk->index = chunks_.size();
+      chunks_.push_back(std::move(chunk));
+      chunk_bytes_ = 0;
+    }
+    HashLength(hash_, key.size());
+    hash_.Update(key);
+    HashLength(hash_, size);
+    hash_.Update(item->text);
+    chunks_.back()->segments.push_back(std::move(item));
+    chunk_bytes_ += bytes;
+    framed_bytes_ += bytes;
+    text_bytes_ += size;
+    ++segment_count_;
+    offset += size;
+  }
+  return mojom::Failure::kNone;
+}
+void DocumentSegments::Warn(mojom::WarningCode code,
+                            uint32_t count,
+                            mojom::Story story,
+                            uint32_t page,
+                            const std::string& part) {
+  for (auto& warning : warnings_) {
+    if (warning->code == code && warning->story == story) {
+      warning->count += count;
+      return;
+    }
+  }
+  auto warning = mojom::Warning::New();
+  warning->code = code;
+  warning->count = count;
+  warning->story = story;
+  warning->first_page = page;
+  warning->first_part = part;
+  warnings_.push_back(std::move(warning));
+}
+mojom::MetadataPtr DocumentSegments::Finish() {
+  if (chunks_.empty()) {
+    chunks_.push_back(mojom::Chunk::New());
+  }
+  chunks_.back()->final_chunk = true;
+  std::array<uint8_t, crypto::hash::kSha256Size> digest;
+  hash_.Finish(digest);
+  auto result = mojom::Metadata::New();
+  result->format = format;
+  result->page_count = page_count;
+  result->warnings = std::move(warnings_);
+  result->chunk_count = chunks_.size();
+  result->completed = mojom::Completed::New();
+  result->completed->text_sha256 = base::HexEncodeLower(digest);
+  result->completed->text_bytes = text_bytes_;
+  result->completed->segment_count = segment_count_;
+  return result;
+}
+mojom::ChunkPtr DocumentSegments::Chunk(uint32_t index) const {
+  CHECK_LT(index, chunks_.size());
+  return chunks_[index].Clone();
+}
+}  // namespace aux::document
