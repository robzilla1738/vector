+#include "crypto/hash.h"
+#if BUILDFLAG(IS_POSIX)
+#include <fcntl.h>
+#include <sys/stat.h>
+
+#include "base/posix/eintr_wrapper.h"
+#endif
+namespace aux {
+namespace {
+using document::mojom::Format;
+using document::mojom::Story;
+using document::mojom::WarningCode;
+std::string FormatName(Format format) {
+  constexpr std::array<std::string_view, 3> names = {"text", "pdf", "docx"};
+  return std::string(names[static_cast<size_t>(format)]);
+}
+std::string FailureName(document::mojom::Failure failure) {
+  constexpr std::array<std::string_view, 8> names = {
+      "invalid_document", "unsupported_format", "encrypted",
+      "no_text",          "invalid_document",   "source_limit",
+      "text_limit",       "structure_limit"};
+  return std::string(names[static_cast<size_t>(failure)]);
+}
+std::string WarningName(WarningCode code) {
+  constexpr std::array<std::string_view, 5> names = {
+      "no_selectable_text", "unmapped_text", "external_relationships_ignored",
+      "embedded_content_ignored", "unsupported_markup_ignored"};
+  return std::string(names[static_cast<size_t>(code)]);
+}
+std::string StoryName(Story story) {
+  constexpr std::array<std::string_view, 7> names = {
+      "", "body", "header", "footer", "footnote", "endnote", "comment"};
+  return std::string(names[static_cast<size_t>(story)]);
+}
+bool Sha256(const std::string& value) {
+  return value.size() == 64 &&
+         value.find_first_not_of("0123456789abcdef") == std::string::npos;
+}
+std::optional<base::DictValue> Locator(const document::mojom::Locator& locator,
+                                       const std::string& format,
+                                       uint32_t page_count) {
+  base::DictValue result;
+  if (locator.is_text()) {
+    const auto& value = *locator.get_text();
+    if (format != "text" || !value.line) {
+      return std::nullopt;
+    }
+    result.Set("kind", "text")
+        .Set("line", static_cast<double>(value.line))
+        .Set("offset", static_cast<double>(value.offset));
+    return result;
+  }
+  if (locator.is_pdf()) {
+    const auto& value = *locator.get_pdf();
+    if (format != "pdf" || !value.page || value.page > page_count ||
+        !value.block) {
+      return std::nullopt;
+    }
+    result.Set("kind", "pdf")
+        .Set("page", static_cast<double>(value.page))
+        .Set("block", static_cast<double>(value.block))
+        .Set("offset", static_cast<double>(value.offset));
+    return result;
+  }
+  const auto& value = *locator.get_docx();
+  if (format != "docx" || !document::IsStoryPart(value.part) ||
+      !value.paragraph || value.heading_level > 9 ||
+      (value.table == 0) != (value.row == 0) ||
+      (value.table == 0) != (value.column == 0)) {
+    return std::nullopt;
+  }
+  result.Set("kind", "docx")
+      .Set("part", value.part)
+      .Set("paragraph", static_cast<double>(value.paragraph))
+      .Set("offset", static_cast<double>(value.offset));
+  if (value.heading_level) {
+    result.Set("headingLevel", value.heading_level);
+  }
+  if (value.table) {
+    result.Set("table", static_cast<double>(value.table))
+        .Set("row", static_cast<double>(value.row))
+        .Set("column", static_cast<double>(value.column));
+  }
+  if (value.note_id) {
+    int64_t note;
+    if (!base::StringToInt64(*value.note_id, &note) ||
+        base::NumberToString(note) != *value.note_id) {
+      return std::nullopt;
+    }
+    result.Set("noteId", *value.note_id);
+  }
+  return result;
+}
+}  // namespace
+EvidenceDocumentSnapshot::EvidenceDocumentSnapshot(
+    content::WebContents* contents,
+    base::FilePath path,
+    base::RepeatingCallback<bool()> owner_current)
+    : content::WebContentsObserver(contents),
+      path_(std::move(path)),
+      filename_(base::UTF16ToUTF8(path_.BaseName().LossyDisplayName())),
+      snapshot_id_(base::Uuid::GenerateRandomV4().AsLowercaseString()),
+      owner_current_(std::move(owner_current)) {}
+EvidenceDocumentSnapshot::~EvidenceDocumentSnapshot() {
+  runtime_read_owner_.reset();
+  extractor_.reset();
+  if (pending_) {
+    std::move(pending_).Run(false, "", "ref_stale",
+                            "Original document selection retired");
+  }
+}
+void EvidenceDocumentSnapshot::PrimaryPageChanged(content::Page& page) {
+  Current();
+}
+void EvidenceDocumentSnapshot::PrimaryMainFrameRenderProcessGone(
+    base::TerminationStatus status) {
+  Fault("ref_stale", "Original document selection retired");
+}
+void EvidenceDocumentSnapshot::WebContentsDestroyed() {
+  Fault("ref_stale", "Original document selection retired");
+}
+EvidenceDocumentSnapshot::Capture EvidenceDocumentSnapshot::CaptureFile(
+    const base::FilePath& path) {
+  Capture capture;
+  capture.failure = "io_error";
+#if BUILDFLAG(IS_POSIX)
+  base::File file(HANDLE_EINTR(
+      open(path.value().c_str(), O_RDONLY | O_CLOEXEC | O_NONBLOCK)));
+  struct stat status;
+  if (!file.IsValid() || fstat(file.GetPlatformFile(), &status) != 0 ||
+      !S_ISREG(status.st_mode)) {
+    return capture;
+  }
+#else
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+#endif
+  base::File::Info before, after;
+  if (!file.IsValid() || !file.GetInfo(&before) || before.is_directory ||
+      before.size < 0) {
+    return capture;
+  }
+  if (static_cast<uint64_t>(before.size) > document::kMaxSourceBytes) {
+    capture.failure = "source_limit";
+    return capture;
+  }
+  capture.size = before.size;
+  base::MappedReadOnlyRegion region;
+  if (capture.size) {
+    region = base::ReadOnlySharedMemoryRegion::Create(capture.size);
+    if (!region.IsValid() ||
+        !file.ReadAndCheck(0, region.mapping.GetMemoryAsSpan<uint8_t>())) {
+      return capture;
+    }
+  }
+  if (!file.GetInfo(&after) || before.size != after.size ||
+      before.last_modified != after.last_modified) {
+    return capture;
+  }
+  const auto bytes = capture.size
+                         ? region.mapping.GetMemoryAsSpan<const uint8_t>()
+                         : base::span<const uint8_t>();
+  capture.sha256 = base::HexEncodeLower(crypto::hash::Sha256(bytes));
+  if (capture.size) {
+    capture.bytes = std::move(region.region);
+  }
+  capture.failure.clear();
+  return capture;
+}
+bool EvidenceDocumentSnapshot::Current() {
+  if (!retired_ && (!runtime_read_owner_ || !runtime_read_owner_->load()) &&
+      owner_current_.Run()) {
+    return true;
+  }
+  Fault("ref_stale", "Original document selection retired");
+  return false;
+}
+bool EvidenceDocumentSnapshot::OwnsRead(
+    const std::shared_ptr<std::atomic_bool>& runtime_owner) const {
+  return pending_ && runtime_owner && runtime_read_owner_ == runtime_owner;
+}
+void EvidenceDocumentSnapshot::Read(
+    const std::optional<std::string>& cursor,
+    Callback callback,
+    std::shared_ptr<std::atomic_bool> runtime_owner) {
+  if (retired_ || (runtime_owner && runtime_owner->load()) ||
+      !owner_current_.Run()) {
+    std::move(callback).Run(false, "", "ref_stale",
+                            "Original document selection retired");
+    return;
+  }
+  if (pending_) {
+    std::move(callback).Run(false, "", "conflict",
+                            "A document read is already in progress");
+    return;
+  }
+  uint32_t chunk = 0;
+  if (cursor) {
+    const auto found = std::find(cursors_.begin(), cursors_.end(), *cursor);
+    if (found == cursors_.end()) {
+      std::move(callback).Run(false, "", "ref_stale",
+                              "Original document cursor retired");
+      return;
+    }
+    chunk = found - cursors_.begin();
+  }
+  pending_chunk_ = chunk;
+  pending_ = std::move(callback);
+  runtime_read_owner_ = std::move(runtime_owner);
+  if (!failure_.empty()) {
+    Unreadable(failure_);
+    return;
+  }
+  if (!cursors_.empty()) {
+    deadline_.Start(FROM_HERE, base::Seconds(60),
+                    base::BindOnce(&EvidenceDocumentSnapshot::Unreadable,
+                                   weak_factory_.GetWeakPtr(), "timeout"));
+    extractor_->ReadChunk(chunk,
+                          base::BindOnce(&EvidenceDocumentSnapshot::Received,
+                                         weak_factory_.GetWeakPtr()));
+    return;
+  }
+  if (started_) {
+    Fault("ref_stale", "Original document snapshot retired");
+    return;
+  }
+  started_ = true;
+  deadline_.Start(FROM_HERE, base::Seconds(60),
+                  base::BindOnce(&EvidenceDocumentSnapshot::Unreadable,
+                                 weak_factory_.GetWeakPtr(), "timeout"));
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&EvidenceDocumentSnapshot::CaptureFile, path_),
+      base::BindOnce(&EvidenceDocumentSnapshot::Captured,
+                     weak_factory_.GetWeakPtr()));
+}
+void EvidenceDocumentSnapshot::Captured(Capture capture) {
+  if (!Current()) {
+    return;
+  }
+  if (!capture.failure.empty()) {
+    Unreadable(std::move(capture.failure));
+    return;
+  }
+  metadata_.Set("snapshotId", snapshot_id_)
+      .Set("filename", filename_)
+      .Set("sourceSha256", capture.sha256)
+      .Set("sourceBytes", static_cast<double>(capture.size))
+      .Set("extractorVersion", "aux-document-v1");
+  extractor_ =
+      content::ServiceProcessHost::Launch<document::mojom::DocumentExtractor>(
+          content::ServiceProcessHost::Options()
+              .WithDisplayName("Aux document reader")
+              .Pass());
+  extractor_.set_disconnect_handler(
+      base::BindOnce(&EvidenceDocumentSnapshot::Unreadable,
+                     weak_factory_.GetWeakPtr(), "extractor_unavailable"));
+  extractor_->Start(std::move(capture.bytes), capture.size,
+                    base::BindOnce(&EvidenceDocumentSnapshot::Started,
+                                   weak_factory_.GetWeakPtr()));
+}
+void EvidenceDocumentSnapshot::Started(document::mojom::StartResultPtr result) {
+  if (!Current()) {
+    return;
+  }
+  if (result->is_failure()) {
+    Unreadable(FailureName(result->get_failure()));
+    return;
+  }
+  const auto& value = *result->get_metadata();
+  if (!value.chunk_count ||
+      value.chunk_count >
+          document::kMaxFramedBytes / (document::kMaxChunkBytes -
+                                       document::kMaxSegmentBytes - 256) +
+              1 ||
+      (value.format == Format::kPdf) != (value.page_count != 0) ||
+      !Sha256(value.completed->text_sha256) ||
+      value.completed->text_bytes > document::kMaxTextBytes ||
+      value.completed->segment_count > document::kMaxFramedBytes / 8 ||
+      value.warnings.size() > 35) {
+    Unreadable("invalid_document");
+    return;
+  }
+  base::ListValue warnings;
+  std::set<std::pair<WarningCode, Story>> groups;
+  for (const auto& warning : value.warnings) {
+    const bool pdf = warning->code == WarningCode::kNoSelectableText ||
+                     warning->code == WarningCode::kUnmappedText;
+    if (!warning->count ||
+        !groups.insert({warning->code, warning->story}).second ||
+        (pdf &&
+         (value.format != Format::kPdf || warning->story != Story::kNone ||
+          !warning->first_page || warning->first_page > value.page_count ||
+          !warning->first_part.empty())) ||
+        (!pdf && (value.format != Format::kDocx || warning->first_page)) ||
+        (warning->code == WarningCode::kNoSelectableText &&
+         warning->count >= value.page_count) ||
+        (!warning->first_part.empty() &&
+         (!document::IsStoryPart(warning->first_part) ||
+          document::PartStory(warning->first_part) != warning->story))) {
+      Unreadable("invalid_document");
+      return;
+    }
+    base::DictValue item;
+    item.Set("code", WarningName(warning->code))
+        .Set("count", static_cast<double>(warning->count));
+    if (warning->story != Story::kNone) {
+      item.Set("story", StoryName(warning->story));
+    }
+    if (warning->first_page) {
+      item.Set("firstPage", static_cast<double>(warning->first_page));
+    }
+    if (!warning->first_part.empty()) {
+      item.Set("firstPart", warning->first_part);
+    }
+    warnings.Append(std::move(item));
+  }
+  metadata_.Set("format", FormatName(value.format))
+      .Set("warnings", std::move(warnings));
+  if (value.page_count) {
+    metadata_.Set("pageCount", static_cast<double>(value.page_count));
+  }
+  completed_.Set("textSha256", value.completed->text_sha256)
+      .Set("textBytes", static_cast<double>(value.completed->text_bytes))
+      .Set("segmentCount", static_cast<double>(value.completed->segment_count));
+  cursors_.reserve(value.chunk_count);
+  for (uint32_t index = 0; index < value.chunk_count; ++index) {
+    cursors_.push_back(base::Uuid::GenerateRandomV4().AsLowercaseString());
+  }
+  extractor_->ReadChunk(0, base::BindOnce(&EvidenceDocumentSnapshot::Received,
+                                          weak_factory_.GetWeakPtr()));
+}
+void EvidenceDocumentSnapshot::Received(document::mojom::ChunkPtr chunk) {
+  if (!Current()) {
+    return;
+  }
+  if (!pending_ || chunk->index != pending_chunk_ ||
+      chunk->index >= cursors_.size() ||
+      chunk->final_chunk != (chunk->index + 1 == cursors_.size()) ||
+      chunk->segments.size() > document::kMaxChunkBytes / 8) {
+    Unreadable("invalid_document");
+    return;
+  }
+  const std::string& format = *metadata_.FindString("format");
+  const auto pages = metadata_.FindDouble("pageCount").value_or(0);
+  size_t bytes = 0;
+  base::ListValue segments;
+  for (const auto& segment : chunk->segments) {
+    if (segment->text.empty() ||
+        segment->text.size() > document::kMaxSegmentBytes ||
+        segment->text.find('\0') != std::string::npos) {
+      Unreadable("invalid_document");
+      return;
+    }
+    auto locator = Locator(*segment->locator, format, pages);
+    if (!locator) {
+      Unreadable("invalid_document");
+      return;
+    }
+    bytes += 8 + document::LocatorKey(*segment->locator).size() +
+             segment->text.size();
+    if (bytes > document::kMaxChunkBytes) {
+      Unreadable("invalid_document");
+      return;
+    }
+    segments.Append(base::DictValue()
+                        .Set("locator", std::move(*locator))
+                        .Set("text", segment->text));
+  }
+  if (segments.empty() &&
+      (format != "text" || chunk->index || !chunk->final_chunk ||
+       completed_.FindDouble("textBytes").value_or(-1) != 0 ||
+       completed_.FindDouble("segmentCount").value_or(-1) != 0)) {
+    Unreadable("invalid_document");
+    return;
+  }
+  base::DictValue result;
+  result.Set("kind", "chunk")
+      .Set("document", metadata_.Clone())
+      .Set("chunk", base::DictValue()
+                        .Set("index", static_cast<double>(chunk->index))
+                        .Set("segments", std::move(segments)));
+  if (chunk->final_chunk) {
+    result.Set("completed", completed_.Clone());
+  } else {
+    result.Set("nextCursor", cursors_[chunk->index + 1]);
+  }
+  deadline_.Stop();
+  Reply(std::move(result));
+}
+void EvidenceDocumentSnapshot::Unreadable(std::string reason) {
+  failure_ = std::move(reason);
+  deadline_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  extractor_.reset();
+  cursors_.clear();
+  metadata_.clear();
+  completed_.clear();
+  if (pending_) {
+    Reply(base::DictValue()
+              .Set("kind", "unreadable")
+              .Set("filename", filename_)
+              .Set("reason", failure_));
+  }
+}
+void EvidenceDocumentSnapshot::Fault(const std::string& code,
+                                     const std::string& message) {
+  retired_ = true;
+  deadline_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  extractor_.reset();
+  cursors_.clear();
+  metadata_.clear();
+  completed_.clear();
+  runtime_read_owner_.reset();
+  if (pending_) {
+    std::move(pending_).Run(false, "", code, message);
+  }
+}
+void EvidenceDocumentSnapshot::Reply(base::DictValue result) {
+  runtime_read_owner_.reset();
+  auto callback = std::move(pending_);
+  auto json = base::WriteJson(result);
+  if (!json) {
+    std::move(callback).Run(false, "", "io_error",
+                            "Document result could not be encoded");
+    return;
+  }
+  std::move(callback).Run(true, *json, "", "");
+}
+}  // namespace aux
