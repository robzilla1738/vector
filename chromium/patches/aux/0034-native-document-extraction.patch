+void AuxRuntimeHost::Worker::DispatchEvidenceRequest(int id,
+                                                     std::string method,
+                                                     base::DictValue params) {
+  auto request = std::make_unique<EvidenceRequest>();
+  const auto cancelled = request->cancelled;
+  const auto generation = connection_generation_;
