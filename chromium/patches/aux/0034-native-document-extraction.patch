+class DocumentSegments {
+ public:
+  DocumentSegments();
+  ~DocumentSegments();
+  mojom::Failure Add(mojom::LocatorPtr locator, std::string text);
+  void Warn(mojom::WarningCode code,
+            uint32_t count,
+            mojom::Story story = mojom::Story::kNone,
+            uint32_t page = 0,
+            const std::string& part = {});
+  mojom::MetadataPtr Finish();
+  mojom::ChunkPtr Chunk(uint32_t index) const;
