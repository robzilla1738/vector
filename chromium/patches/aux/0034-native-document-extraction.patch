diff --git a/chrome/services/aux_document/public/mojom/document_extractor.mojom b/chrome/services/aux_document/public/mojom/document_extractor.mojom
new file mode 100644
index 0000000..0fa85c3
--- /dev/null
+++ b/chrome/services/aux_document/public/mojom/document_extractor.mojom
@@ -0,0 +1,45 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+module aux.document.mojom;
+import "mojo/public/mojom/base/shared_memory.mojom";
+import "sandbox/policy/mojom/sandbox.mojom";
+
+enum Format { kText, kPdf, kDocx };
+enum Failure {
+  kNone, kUnsupportedFormat, kEncrypted, kNoText, kInvalidDocument,
+  kSourceLimit, kTextLimit, kStructureLimit,
+};
+enum Story { kNone, kBody, kHeader, kFooter, kFootnote, kEndnote, kComment };
+enum WarningCode {
+  kNoSelectableText, kUnmappedText, kExternalRelationshipsIgnored,
+  kEmbeddedContentIgnored, kUnsupportedMarkupIgnored,
+};
+struct TextLocator { uint32 line; uint32 offset; };
+struct PdfLocator { uint32 page; uint32 block; uint32 offset; };
+struct DocxLocator {
+  string part; uint32 paragraph; uint32 offset; uint8 heading_level;
+  uint32 table; uint32 row; uint32 column; string? note_id;
+};
+union Locator { TextLocator text; PdfLocator pdf; DocxLocator docx; };
+struct Segment { Locator locator; string text; };
+struct Warning {
+  WarningCode code; uint32 count; Story story;
+  uint32 first_page; string first_part;
+};
+struct Completed { string text_sha256; uint32 text_bytes; uint32 segment_count; };
+struct Metadata {
+  Format format; uint32 page_count; array<Warning> warnings;
+  Completed completed; uint32 chunk_count;
+};
+struct Chunk { uint32 index; array<Segment> segments; bool final_chunk; };
+union StartResult { Metadata metadata; Failure failure; };
+
+// One dedicated computation-only process per immutable selected file. No paths,
+// Profile handles, credentials, file/network capability or executable actions.
+[ServiceSandbox=sandbox.mojom.Sandbox.kService]
+interface DocumentExtractor {
+  Start(mojo_base.mojom.ReadOnlySharedMemoryRegion? source, uint32 source_bytes)
+      => (StartResult result);
+  ReadChunk(uint32 index) => (Chunk chunk);
+};
