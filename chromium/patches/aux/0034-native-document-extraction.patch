diff --git a/chrome/services/aux_document/public/document_types.cc b/chrome/services/aux_document/public/document_types.cc
new file mode 100644
index 0000000..4a8de3d
--- /dev/null
+++ b/chrome/services/aux_document/public/document_types.cc
@@ -0,0 +1,62 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/services/aux_document/public/document_types.h"
+
+#include "base/strings/string_number_conversions.h"
+namespace aux::document {
+std::string LocatorKey(const mojom::Locator& locator) {
+  if (locator.is_text()) {
+    const auto& value = *locator.get_text();
+    return "text:" + base::NumberToString(value.line) + ":" +
+           base::NumberToString(value.offset);
+  }
+  if (locator.is_pdf()) {
+    const auto& value = *locator.get_pdf();
+    return "pdf:" + base::NumberToString(value.page) + ":" +
+           base::NumberToString(value.block) + ":" +
+           base::NumberToString(value.offset);
+  }
+  const auto& value = *locator.get_docx();
+  return "docx:" + value.part + ":" + base::NumberToString(value.paragraph) +
+         ":" + base::NumberToString(value.offset) + ":" +
+         base::NumberToString(value.heading_level) + ":" +
+         base::NumberToString(value.table) + ":" +
+         base::NumberToString(value.row) + ":" +
+         base::NumberToString(value.column) + ":" + value.note_id.value_or("");
+}
+mojom::Story PartStory(const std::string& part) {
+  if (part == "word/document.xml") {
+    return mojom::Story::kBody;
+  }
+  if (part == "word/footnotes.xml") {
+    return mojom::Story::kFootnote;
+  }
+  if (part == "word/endnotes.xml") {
+    return mojom::Story::kEndnote;
+  }
+  if (part == "word/comments.xml") {
+    return mojom::Story::kComment;
+  }
+  if (part.starts_with("word/header")) {
+    return mojom::Story::kHeader;
+  }
+  if (part.starts_with("word/footer")) {
+    return mojom::Story::kFooter;
+  }
+  return mojom::Story::kNone;
+}
+bool IsStoryPart(const std::string& part) {
+  if (part == "word/document.xml" || part == "word/footnotes.xml" ||
+      part == "word/endnotes.xml" || part == "word/comments.xml") {
+    return true;
+  }
+  if ((!part.starts_with("word/header") && !part.starts_with("word/footer")) ||
+      !part.ends_with(".xml") || part.size() > 80) {
+    return false;
+  }
+  const auto number = std::string_view(part).substr(11, part.size() - 15);
+  return !number.empty() && number.front() >= '1' && number.front() <= '9' &&
+         number.find_first_not_of("0123456789") == std::string_view::npos;
+}
+}  // namespace aux::document
