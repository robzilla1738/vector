+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_EVIDENCE_DOCUMENTS_H_
+#define CHROME_BROWSER_UI_AUX_EVIDENCE_DOCUMENTS_H_
+#include <atomic>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/read_only_shared_memory_region.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "chrome/services/aux_document/public/mojom/document_extractor.mojom.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "mojo/public/cpp/bindings/remote.h"
+namespace aux {
+// A current selected file owns one immutable capture, never a reopen-on-retry.
+class EvidenceDocumentSnapshot : public content::WebContentsObserver {
+ public:
+  using Callback = base::OnceCallback<
+      void(bool, const std::string&, const std::string&, const std::string&)>;
+  EvidenceDocumentSnapshot(content::WebContents* contents,
+                           base::FilePath path,
+                           base::RepeatingCallback<bool()> owner_current);
+  ~EvidenceDocumentSnapshot() override;
+  void Read(const std::optional<std::string>& cursor,
+            Callback callback,
+            std::shared_ptr<std::atomic_bool> runtime_owner);
+  bool OwnsRead(const std::shared_ptr<std::atomic_bool>& runtime_owner) const;
+
+ private:
+  void PrimaryPageChanged(content::Page& page) override;
+  void PrimaryMainFrameRenderProcessGone(
+      base::TerminationStatus status) override;
+  void WebContentsDestroyed() override;
+
+  struct Capture {
+    base::ReadOnlySharedMemoryRegion bytes;
+    uint32_t size = 0;
+    std::string sha256;
+    std::string failure;
+  };
+  static Capture CaptureFile(const base::FilePath& path);
+  void Captured(Capture capture);
+  void Started(document::mojom::StartResultPtr result);
+  void Received(document::mojom::ChunkPtr chunk);
+  void Unreadable(std::string reason);
+  void Fault(const std::string& code, const std::string& message);
+  void Reply(base::DictValue result);
+  bool Current();
+
+  const base::FilePath path_;
+  const std::string filename_;
+  const std::string snapshot_id_;
+  const base::RepeatingCallback<bool()> owner_current_;
+  bool started_ = false;
+  bool retired_ = false;
+  uint32_t pending_chunk_ = 0;
+  std::string failure_;
+  base::DictValue metadata_;
+  base::DictValue completed_;
+  std::vector<std::string> cursors_;
+  Callback pending_;
+  std::shared_ptr<std::atomic_bool> runtime_read_owner_;
+  mojo::Remote<document::mojom::DocumentExtractor> extractor_;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<EvidenceDocumentSnapshot> weak_factory_{this};
+};
+}  // namespace aux
+#endif
