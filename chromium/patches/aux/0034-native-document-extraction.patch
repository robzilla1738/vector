@@ -0,0 +1,729 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include <libxml/xmlreader.h>
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <set>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/services/aux_document/document_segments.h"
+#include "third_party/zlib/google/zip_reader.h"
+namespace aux::document {
+namespace {
+constexpr char kWord[] =
+    "http://schemas.openxmlformats.org/wordprocessingml/2006/main";
+constexpr char kStrictWord[] =
+    "http://purl.oclc.org/ooxml/wordprocessingml/main";
+constexpr char kRelationships[] =
+    "http://schemas.openxmlformats.org/package/2006/relationships";
+constexpr char kContentTypes[] =
+    "http://schemas.openxmlformats.org/package/2006/content-types";
+
+class MemoryReader final : public zip::ReaderDelegate {
+ public:
+  explicit MemoryReader(base::span<const uint8_t> bytes) : bytes_(bytes) {}
+  int64_t ReadBytes(base::span<uint8_t> destination) override {
+    const size_t size = std::min(destination.size(), bytes_.size() - offset_);
+    destination.first(size).copy_from(bytes_.subspan(offset_, size));
+    offset_ += size;
+    return size;
+  }
+  bool Seek(int64_t offset) override {
+    if (offset < 0 || static_cast<uint64_t>(offset) > bytes_.size()) {
+      return false;
+    }
+    offset_ = offset;
+    return true;
+  }
+  int64_t Tell() override { return offset_; }
+  int64_t GetLength() override { return bytes_.size(); }
+
+ private:
+  const base::span<const uint8_t> bytes_;
+  size_t offset_ = 0;
+};
+class XmlWriter final : public zip::WriterDelegate {
+ public:
+  XmlWriter(std::string& text, size_t& remaining)
+      : text_(text), remaining_(remaining) {}
+  bool WriteBytes(base::span<const uint8_t> bytes) override {
+    if (bytes.size() > remaining_) {
+      exceeded = true;
+      return false;
+    }
+    text_.append(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+    remaining_ -= bytes.size();
+    return true;
+  }
+  bool exceeded = false;
+
+ private:
+  std::string& text_;
+  size_t& remaining_;
+};
+std::string XmlString(const xmlChar* value) {
+  return value ? reinterpret_cast<const char*>(value) : "";
+}
+std::string Attribute(xmlTextReaderPtr reader,
+                      const char* name,
+                      const char* uri = nullptr) {
+  xmlChar* value = xmlTextReaderGetAttributeNs(
+      reader, reinterpret_cast<const xmlChar*>(name),
+      reinterpret_cast<const xmlChar*>(uri));
+  std::string result = XmlString(value);
+  xmlFree(value);
+  return result;
+}
+bool WordNamespace(std::string_view value) {
+  return value == kWord || value == kStrictWord;
+}
+std::string WordAttribute(xmlTextReaderPtr reader, const char* name) {
+  auto result = Attribute(reader, name, kWord);
+  return result.empty() ? Attribute(reader, name, kStrictWord) : result;
+}
+class Xml {
+ public:
+  explicit Xml(const std::string& bytes)
+      : reader_(xmlReaderForMemory(bytes.data(),
+                                   bytes.size(),
+                                   nullptr,
+                                   nullptr,
+                                   XML_PARSE_NONET | XML_PARSE_NO_XXE |
+                                       XML_PARSE_NOERROR | XML_PARSE_NOWARNING),
+                &xmlFreeTextReader) {
+    if (!reader_) {
+      return;
+    }
+    xmlTextReaderSetResourceLoader(
+        reader_.get(),
+        [](void*, const char*, const char*, xmlResourceType,
+           xmlParserInputFlags, xmlParserInput** input) {
+          *input = nullptr;
+          return XML_IO_ENOENT;
+        },
+        nullptr);
+    xmlTextReaderSetErrorHandler(
+        reader_.get(),
+        [](void*, const char*, xmlParserSeverities, xmlTextReaderLocatorPtr) {},
+        nullptr);
+  }
+  bool Next() {
+    if (!reader_) {
+      failed_ = true;
+      return false;
+    }
+    const int status = xmlTextReaderRead(reader_.get());
+    if (status < 0) {
+      failed_ = true;
+    }
+    if (status != 1) {
+      return false;
+    }
+    const int type = xmlTextReaderNodeType(reader_.get());
+    if (xmlTextReaderDepth(reader_.get()) > 128 ||
+        type == XML_READER_TYPE_DOCUMENT_TYPE ||
+        type == XML_READER_TYPE_ENTITY ||
+        type == XML_READER_TYPE_ENTITY_REFERENCE ||
+        type == XML_READER_TYPE_END_ENTITY) {
+      failed_ = true;
+      return false;
+    }
+    return true;
+  }
+  bool ok() const { return !failed_; }
+  xmlTextReaderPtr get() const { return reader_.get(); }
+  std::string name() const {
+    return XmlString(xmlTextReaderConstLocalName(get()));
+  }
+  std::string uri() const {
+    return XmlString(xmlTextReaderConstNamespaceUri(get()));
+  }
+  bool element() const {
+    return xmlTextReaderNodeType(get()) == XML_READER_TYPE_ELEMENT;
+  }
+  bool end() const {
+    return xmlTextReaderNodeType(get()) == XML_READER_TYPE_END_ELEMENT;
+  }
+  bool empty() const { return xmlTextReaderIsEmptyElement(get()) == 1; }
+  int depth() const { return xmlTextReaderDepth(get()); }
+
+ private:
+  std::unique_ptr<xmlTextReader, decltype(&xmlFreeTextReader)> reader_{
+      nullptr, &xmlFreeTextReader};
+  bool failed_ = false;
+};
+
+using Parts = std::map<std::string, std::string>;
+struct Relationship {
+  std::string type;
+  std::string target;
+  bool external;
+};
+std::string RelationshipPart(const std::string& part) {
+  return "word/_rels/" + part.substr(5) + ".rels";
+}
+bool IsConsumedPart(const std::string& name) {
+  if (name == "[Content_Types].xml" || name == "_rels/.rels" ||
+      name == "word/styles.xml" || IsStoryPart(name)) {
+    return true;
+  }
+  if (!name.starts_with("word/_rels/") || !name.ends_with(".rels")) {
+    return false;
+  }
+  const std::string owner = "word/" + name.substr(11, name.size() - 16);
+  return IsStoryPart(owner);
+}
+mojom::Failure ReadPackage(base::span<const uint8_t> bytes, Parts& parts) {
+  MemoryReader memory(bytes);
+  zip::ZipReader zip;
+  if (!zip.OpenFromReaderDelegate(&memory)) {
+    return mojom::Failure::kInvalidDocument;
+  }
+  size_t remaining = kMaxSourceBytes;
+  size_t path_bytes = 0;
+  std::set<std::string> names;
+  while (const auto* entry = zip.Next()) {
+    const auto& name = entry->path_in_original_encoding;
+    if (name.empty() || name.size() > 1024 ||
+        name.size() > kMaxSourceBytes - path_bytes) {
+      return mojom::Failure::kStructureLimit;
+    }
+    path_bytes += name.size();
+    if (entry->is_encrypted) {
+      return mojom::Failure::kEncrypted;
+    }
+    if (entry->is_unsafe || entry->is_symbolic_link ||
+        name.find('\\') != std::string::npos ||
+        name.find('\0') != std::string::npos || !names.insert(name).second) {
+      return mojom::Failure::kInvalidDocument;
+    }
+    if (base::ToLowerASCII(name).ends_with("vbaproject.bin")) {
+      return mojom::Failure::kUnsupportedFormat;
+    }
+    if (entry->is_directory || !IsConsumedPart(name)) {
+      continue;
+    }
+    auto& text = parts[name];
+    XmlWriter writer(text, remaining);
+    if (!zip.ExtractCurrentEntry(&writer, remaining + 1)) {
+      return writer.exceeded ? mojom::Failure::kStructureLimit
+                             : mojom::Failure::kInvalidDocument;
+    }
+  }
+  if (!zip.ok()) {
+    return mojom::Failure::kInvalidDocument;
+  }
+  return mojom::Failure::kNone;
+}
+bool ReadTypes(const std::string& bytes,
+               std::map<std::string, std::string>& types,
+               bool& macro) {
+  Xml xml(bytes);
+  bool root = false;
+  while (xml.Next()) {
+    if (!xml.element()) {
+      continue;
+    }
+    if (!root) {
+      if (xml.name() != "Types" || xml.uri() != kContentTypes ||
+          xml.depth() != 0) {
+        return false;
+      }
+      root = true;
+    }
+    if (xml.name() != "Override" && xml.name() != "Default") {
+      continue;
+    }
+    if (xml.uri() != kContentTypes || xml.depth() != 1) {
+      return false;
+    }
+    const auto type = Attribute(xml.get(), "ContentType");
+    if (type.find("macroEnabled") != std::string::npos ||
+        type.find("vbaProject") != std::string::npos) {
+      macro = true;
+    }
+    if (xml.name() == "Override") {
+      const auto part = Attribute(xml.get(), "PartName");
+      if (part.empty() || !types.emplace(part, type).second) {
+        return false;
+      }
+    }
+  }
+  return root && xml.ok();
+}
+bool ReadRelationships(const std::string& bytes,
+                       std::vector<Relationship>& relationships) {
+  Xml xml(bytes);
+  bool root = false;
+  std::set<std::string> ids;
+  while (xml.Next()) {
+    if (!xml.element()) {
+      continue;
+    }
+    if (!root) {
+      if (xml.name() != "Relationships" || xml.uri() != kRelationships ||
+          xml.depth() != 0) {
+        return false;
+      }
+      root = true;
+      continue;
+    }
+    if (xml.name() != "Relationship" || xml.uri() != kRelationships ||
+        xml.depth() != 1) {
+      return false;
+    }
+    auto id = Attribute(xml.get(), "Id");
+    auto type = Attribute(xml.get(), "Type");
+    auto target = Attribute(xml.get(), "Target");
+    auto mode = Attribute(xml.get(), "TargetMode");
+    if (id.empty() || type.empty() || target.empty() || target.size() > 1024 ||
+        (!mode.empty() && mode != "External" && mode != "Internal") ||
+        !ids.insert(id).second) {
+      return false;
+    }
+    relationships.push_back(
+        {std::move(type), std::move(target), mode == "External"});
+  }
+  return root && xml.ok();
+}
+std::string RelationshipType(std::string_view type) {
+  constexpr std::string_view transitional =
+      "http://schemas.openxmlformats.org/officeDocument/2006/relationships/";
+  constexpr std::string_view strict =
+      "http://purl.oclc.org/ooxml/officeDocument/relationships/";
+  if (type.starts_with(transitional)) {
+    return std::string(type.substr(transitional.size()));
+  }
+  if (type.starts_with(strict)) {
+    return std::string(type.substr(strict.size()));
+  }
+  return {};
+}
+std::string StoryType(const std::string& part) {
+  switch (PartStory(part)) {
+    case mojom::Story::kBody:
+      return "document.main";
+    case mojom::Story::kHeader:
+      return "header";
+    case mojom::Story::kFooter:
+      return "footer";
+    case mojom::Story::kFootnote:
+      return "footnotes";
+    case mojom::Story::kEndnote:
+      return "endnotes";
+    case mojom::Story::kComment:
+      return "comments";
+    case mojom::Story::kNone:
+      return {};
+  }
+}
+bool CorrectType(const std::map<std::string, std::string>& types,
+                 const std::string& part) {
+  const auto found = types.find("/" + part);
+  return found != types.end() &&
+         found->second ==
+             "application/vnd.openxmlformats-officedocument.wordprocessingml." +
+                 StoryType(part) + "+xml";
+}
+struct Style {
+  std::string parent;
+  uint8_t heading = 0;
+  bool has_heading = false;
+};
+using Styles = std::map<std::string, Style>;
+bool ReadStyles(const std::string& bytes, Styles& styles) {
+  Xml xml(bytes);
+  std::string id;
+  int depth = -1;
+  bool root = false;
+  while (xml.Next()) {
+    if (!root && xml.element()) {
+      if (xml.name() != "styles" || !WordNamespace(xml.uri()) ||
+          xml.depth() != 0) {
+        return false;
+      }
+      root = true;
+    }
+    if (!WordNamespace(xml.uri())) {
+      continue;
+    }
+    if (xml.element() && xml.name() == "style") {
+      id = WordAttribute(xml.get(), "styleId");
+      if (id.empty() || !styles.emplace(id, Style()).second) {
+        return false;
+      }
+      depth = xml.depth();
+      if (xml.empty()) {
+        id.clear();
+      }
+    } else if (xml.end() && xml.name() == "style" && xml.depth() == depth) {
+      id.clear();
+    } else if (!id.empty() && xml.element()) {
+      if (xml.name() == "basedOn") {
+        styles[id].parent = WordAttribute(xml.get(), "val");
+      }
+      if (xml.name() == "outlineLvl") {
+        unsigned int level;
+        if (!base::StringToUint(WordAttribute(xml.get(), "val"), &level) ||
+            level > 9) {
+          return false;
+        }
+        styles[id].heading = level < 9 ? level + 1 : 0;
+        styles[id].has_heading = true;
+      }
+    }
+  }
+  return root && xml.ok();
+}
+uint8_t Heading(const Styles& styles, std::string id) {
+  std::set<std::string> visited;
+  while (!id.empty() && visited.insert(id).second) {
+    auto found = styles.find(id);
+    if (found == styles.end()) {
+      return 0;
+    }
+    if (found->second.has_heading) {
+      return found->second.heading;
+    }
+    id = found->second.parent;
+  }
+  return 0;
+}
+mojom::Failure ReadStory(const std::string& part,
+                         const std::string& bytes,
+                         const Styles& styles,
+                         DocumentSegments& output,
+                         bool& selectable_text) {
+  Xml xml(bytes);
+  const auto story = PartStory(part);
+  struct Table {
+    uint32_t id;
+    int depth;
+    uint32_t row = 0;
+    uint32_t column = 0;
+    uint32_t next_column = 1;
+    int cell_depth = -1;
+  };
+  std::vector<Table> tables;
+  uint32_t table_id = 0, paragraph_id = 0;
+  int paragraph_depth = -1, text_depth = -1, skip_depth = -1, note_depth = -1;
+  std::optional<std::string> note;
+  mojom::DocxLocatorPtr location;
+  std::string text;
+  bool root = false;
+  auto finish = [&]() {
+    if (!location) {
+      return mojom::Failure::kNone;
+    }
+    const auto paragraph = base::UTF8ToUTF16(text);
+    if (!base::TrimWhitespace(paragraph, base::TRIM_ALL).empty()) {
+      selectable_text = true;
+    }
+    text.push_back('\n');
+    auto result = output.Add(mojom::Locator::NewDocx(std::move(location)),
+                             std::move(text));
+    text.clear();
+    paragraph_depth = text_depth = -1;
+    return result;
+  };
+  while (xml.Next()) {
+    if (!root && xml.element()) {
+      root = true;
+      const std::map<mojom::Story, std::string> roots = {
+          {mojom::Story::kBody, "document"},
+          {mojom::Story::kHeader, "hdr"},
+          {mojom::Story::kFooter, "ftr"},
+          {mojom::Story::kFootnote, "footnotes"},
+          {mojom::Story::kEndnote, "endnotes"},
+          {mojom::Story::kComment, "comments"}};
+      if (!WordNamespace(xml.uri()) || xml.depth() != 0 ||
+          xml.name() != roots.at(story)) {
+        return mojom::Failure::kInvalidDocument;
+      }
+    }
+    if (skip_depth >= 0) {
+      if (xml.end() && xml.depth() == skip_depth) {
+        skip_depth = -1;
+      }
+      continue;
+    }
+    const auto name = xml.name();
+    const bool word = WordNamespace(xml.uri());
+    if (!word && xml.element()) {
+      output.Warn(mojom::WarningCode::kUnsupportedMarkupIgnored, 1, story, 0,
+                  part);
+      if (!xml.empty()) {
+        skip_depth = xml.depth();
+      }
+      continue;
+    }
+    if (word && xml.element()) {
+      if (name == "del" || name == "moveFrom" || name == "drawing" ||
+          name == "pict" || name == "object" || name == "altChunk") {
+        if (name != "del" && name != "moveFrom") {
+          output.Warn(mojom::WarningCode::kEmbeddedContentIgnored, 1, story, 0,
+                      part);
+        }
+        if (!xml.empty()) {
+          skip_depth = xml.depth();
+        }
+        continue;
+      }
+      if (name == "footnote" || name == "endnote" || name == "comment") {
+        auto value = WordAttribute(xml.get(), "id");
+        int64_t id;
+        if (!base::StringToInt64(value, &id) ||
+            base::NumberToString(id) != value) {
+          return mojom::Failure::kInvalidDocument;
+        }
+        if ((name == "footnote" || name == "endnote") &&
+            !WordAttribute(xml.get(), "type").empty()) {
+          if (!xml.empty()) {
+            skip_depth = xml.depth();
+          }
+          continue;
+        }
+        note = value;
+        note_depth = xml.depth();
+      }
+      if (name == "tbl") {
+        ++table_id;
+        if (!xml.empty()) {
+          tables.push_back({table_id, xml.depth()});
+        }
+      }
+      if (!tables.empty() && name == "tr") {
+        ++tables.back().row;
+        tables.back().column = 0;
+        tables.back().next_column = 1;
+        tables.back().cell_depth = -1;
+      }
+      if (!tables.empty() && (name == "gridBefore" || name == "gridSpan")) {
+        uint32_t count;
+        if (!base::StringToUint(WordAttribute(xml.get(), "val"), &count) ||
+            (name == "gridSpan" && !count)) {
+          return mojom::Failure::kInvalidDocument;
+        }
+        auto& table = tables.back();
+        if (count > kMaxSourceBytes || table.column > kMaxSourceBytes - count) {
+          return mojom::Failure::kStructureLimit;
+        }
+        if (name == "gridBefore" && table.cell_depth < 0) {
+          table.next_column = count + 1;
+        }
+        if (name == "gridSpan" && table.cell_depth >= 0) {
+          table.next_column = table.column + count;
+        }
+      }
+      if (!tables.empty() && name == "tc") {
+        auto& table = tables.back();
+        table.column = table.next_column++;
+        table.cell_depth = xml.empty() ? -1 : xml.depth();
+      }
+      if (name == "p") {
+        if (location) {
+          return mojom::Failure::kInvalidDocument;
+        }
+        location = mojom::DocxLocator::New();
+        location->part = part;
+        location->paragraph = ++paragraph_id;
+        location->note_id = note;
+        if (!tables.empty()) {
+          const auto& table = tables.back();
+          if (!table.row || !table.column) {
+            return mojom::Failure::kInvalidDocument;
+          }
+          location->table = table.id;
+          location->row = table.row;
+          location->column = table.column;
+        }
+        paragraph_depth = xml.depth();
+        if (xml.empty()) {
+          const auto error = finish();
+          if (error != mojom::Failure::kNone) {
+            return error;
+          }
+        }
+      }
+      if (location && name == "pStyle") {
+        location->heading_level =
+            Heading(styles, WordAttribute(xml.get(), "val"));
+      }
+      if (location && name == "outlineLvl") {
+        unsigned int level;
+        if (!base::StringToUint(WordAttribute(xml.get(), "val"), &level) ||
+            level > 9) {
+          return mojom::Failure::kInvalidDocument;
+        }
+        location->heading_level = level < 9 ? level + 1 : 0;
+      }
+      if (location && name == "t" && !xml.empty()) {
+        text_depth = xml.depth();
+      }
+      if (location && name == "tab") {
+        text.push_back('\t');
+      }
+      if (location && name == "noBreakHyphen") {
+        text += "\xe2\x80\x91";
+      }
+      if (location && name == "softHyphen") {
+        text += "\xc2\xad";
+      }
+      if (name == "sym") {
+        output.Warn(mojom::WarningCode::kUnsupportedMarkupIgnored, 1, story, 0,
+                    part);
+      }
+      if (location && (name == "br" || name == "cr")) {
+        text.push_back('\n');
+      }
+    } else if (xml.end()) {
+      if (word && name == "t" && xml.depth() == text_depth) {
+        text_depth = -1;
+      }
+      if (word && name == "p" && xml.depth() == paragraph_depth) {
+        const auto error = finish();
+        if (error != mojom::Failure::kNone) {
+          return error;
+        }
+      }
+      if (word && name == "tc" && !tables.empty() &&
+          xml.depth() == tables.back().cell_depth) {
+        tables.back().cell_depth = -1;
+      }
+      if (word && name == "tbl" && !tables.empty() &&
+          xml.depth() == tables.back().depth) {
+        tables.pop_back();
+      }
+      if (xml.depth() == note_depth) {
+        note.reset();
+        note_depth = -1;
+      }
+    } else if (location && text_depth >= 0) {
+      const int type = xmlTextReaderNodeType(xml.get());
+      if (type == XML_READER_TYPE_TEXT || type == XML_READER_TYPE_CDATA ||
+          type == XML_READER_TYPE_WHITESPACE ||
+          type == XML_READER_TYPE_SIGNIFICANT_WHITESPACE) {
+        text += XmlString(xmlTextReaderConstValue(xml.get()));
+      }
+    }
+    if (text.size() > kMaxTextBytes - output.text_bytes()) {
+      return mojom::Failure::kTextLimit;
+    }
+  }
+  return root && xml.ok() && !location && tables.empty()
+             ? mojom::Failure::kNone
+             : mojom::Failure::kInvalidDocument;
+}
+}  // namespace
+mojom::Failure ExtractDocx(base::span<const uint8_t> bytes,
+                           DocumentSegments& output) {
+  Parts parts;
+  auto error = ReadPackage(bytes, parts);
+  if (error != mojom::Failure::kNone) {
+    return error;
+  }
+  if (!parts.contains("[Content_Types].xml") ||
+      !parts.contains("_rels/.rels")) {
+    return mojom::Failure::kUnsupportedFormat;
+  }
+  std::map<std::string, std::string> types;
+  bool macro = false;
+  if (!ReadTypes(parts.at("[Content_Types].xml"), types, macro)) {
+    return mojom::Failure::kInvalidDocument;
+  }
+  if (macro) {
+    return mojom::Failure::kUnsupportedFormat;
+  }
+  std::vector<Relationship> relationships;
+  if (!ReadRelationships(parts.at("_rels/.rels"), relationships)) {
+    return mojom::Failure::kInvalidDocument;
+  }
+  size_t document_count = 0;
+  for (const auto& relationship : relationships) {
+    if (RelationshipType(relationship.type) != "officeDocument") {
+      continue;
+    }
+    if (relationship.external ||
+        (relationship.target != "word/document.xml" &&
+         relationship.target != "/word/document.xml")) {
+      return mojom::Failure::kUnsupportedFormat;
+    }
+    ++document_count;
+  }
+  if (document_count != 1 || !parts.contains("word/document.xml") ||
+      !CorrectType(types, "word/document.xml")) {
+    return mojom::Failure::kUnsupportedFormat;
+  }
+  output.format = mojom::Format::kDocx;
+  std::set<std::string> stories = {"word/document.xml"};
+  bool has_styles = false;
+  if (parts.contains("word/_rels/document.xml.rels")) {
+    relationships.clear();
+    if (!ReadRelationships(parts.at("word/_rels/document.xml.rels"),
+                           relationships)) {
+      return mojom::Failure::kInvalidDocument;
+    }
+    for (const auto& relationship : relationships) {
+      const auto type = RelationshipType(relationship.type);
+      if (relationship.external) {
+        continue;
+      }
+      if (type != "header" && type != "footer" && type != "footnotes" &&
+          type != "endnotes" && type != "comments" && type != "styles") {
+        continue;
+      }
+      const std::string target = relationship.target.starts_with('/')
+                                     ? relationship.target.substr(1)
+                                     : "word/" + relationship.target;
+      if (type == "styles") {
+        if (target != "word/styles.xml" || !parts.contains(target)) {
+          return mojom::Failure::kInvalidDocument;
+        }
+        has_styles = true;
+      } else {
+        if (!IsStoryPart(target) || !parts.contains(target) ||
+            !CorrectType(types, target)) {
+          return mojom::Failure::kInvalidDocument;
+        }
+        stories.insert(target);
+      }
+    }
+  }
+  Styles styles;
+  if (has_styles && !ReadStyles(parts.at("word/styles.xml"), styles)) {
+    return mojom::Failure::kInvalidDocument;
+  }
+  std::vector<std::string> ordered(stories.begin(), stories.end());
+  std::stable_sort(ordered.begin(), ordered.end(),
+                   [](const auto& left, const auto& right) {
+                     return PartStory(left) < PartStory(right);
+                   });
+  bool selectable_text = false;
+  for (const auto& story : ordered) {
+    const auto rels = RelationshipPart(story);
+    if (parts.contains(rels)) {
+      relationships.clear();
+      if (!ReadRelationships(parts.at(rels), relationships)) {
+        return mojom::Failure::kInvalidDocument;
+      }
+      for (const auto& relationship : relationships) {
+        if (relationship.external) {
+          output.Warn(mojom::WarningCode::kExternalRelationshipsIgnored, 1,
+                      PartStory(story), 0, story);
+        }
+      }
+    }
+    error = ReadStory(story, parts.at(story), styles, output, selectable_text);
+    if (error != mojom::Failure::kNone) {
+      return error;
+    }
+  }
+  return selectable_text ? mojom::Failure::kNone : mojom::Failure::kNoText;
+}
+}  // namespace aux::document
