+
+void AuxRuntimeHost::Worker::ReplyEvidenceRequest(
+    int id,
+    uint64_t generation,
+    std::shared_ptr<std::atomic_bool> cancelled,
+    base::DictValue reply) {
+  const auto current = evidence_requests_.find(id);
+  if (connection_fd_ < 0 || generation != connection_generation_ ||
+      current == evidence_requests_.end() ||
+      current->second->cancelled != cancelled) {
+    return;
+  }
+  cancelled->store(true);
+  evidence_requests_.erase(current);
+  reply.Set("kind", "res").Set("id", id);
+  const auto encoded = base::WriteJson(reply);
+  if (!encoded || !SendFrame(*encoded)) {
+    Disconnect();
+  }
