 void BrowserView::CreateTabSearchBubble() {
+  // Aux shows the Aside tab search page (tabs, chats, history, bookmarks) in
+  // place of the stock Chromium tab search.
+  constexpr char kAuxExtensionId[] = "fjdhphbdlfjogobdofoaagnlnkoibdge";
+  if (const extensions::Extension* extension =
+          extensions::ExtensionRegistry::Get(browser()->GetProfile())
+              ->enabled_extensions()
+              .GetByID(kAuxExtensionId)) {
+    if (auto* anchor = GetLocationBarView()) {
+      auto host = extensions::ExtensionViewHostFactory::CreatePopupHost(
+          *extension, extension->GetResourceURL("tabsearch.html"), browser());
+      if (host) {
+        ExtensionPopup::ShowPopup(browser(), std::move(host),
+                                  views::BubbleAnchor(anchor),
+                                  views::BubbleBorder::TOP_CENTER,
+                                  PopupShowAction::kShow, base::DoNothing());
+        return;
+      }
+    }
+  }
   if (auto* tab_search_host = GetTabSearchBubbleHost()) {
     tab_search_host->ShowTabSearchBubble(true);
   }
