+}
+namespace aux::passkeys {
+// Invoke only after content's RP, TLS, permissions-policy and ancestor checks.
+// The dialog preserves Chromium providers through the Other providers action.
+base::OnceClosure ChooseProvider(
+    content::RenderFrameHost* frame,
+    base::OnceCallback<void(bool use_aux)> callback);
+using CreateCallback = content::WebAuthenticationRequestProxy::CreateCallback;
+using GetCallback = content::WebAuthenticationRequestProxy::GetCallback;
+// Selected requests only: no global proxy is installed. Returned id belongs to
+// this exact document and Profile. The caller cancels it on WebAuthn
+// cancellation.
+std::string BeginCreate(
+    content::RenderFrameHost* frame,
+    const url::Origin& caller,
+    const blink::mojom::PublicKeyCredentialCreationOptionsPtr& options,
+    CreateCallback callback);
+std::string BeginGet(
+    content::RenderFrameHost* frame,
+    const url::Origin& caller,
+    const blink::mojom::PublicKeyCredentialRequestOptionsPtr& options,
+    GetCallback callback);
+void Cancel(const std::string& id);
+// Caller-owned cancellation: discard the callback; content completes its own
+// error.
+void Abandon(const std::string& id);
+// Private Vault component only. Every call rechecks document/profile identity;
+// signed request production additionally reads the current disk security gate.
+void ReadRequest(
+    Profile* profile,
+    const std::string& id,
+    base::OnceCallback<void(std::optional<base::DictValue>)> callback);
+void Complete(Profile* profile,
+              const std::string& id,
+              base::Value response,
+              base::OnceCallback<void(std::optional<std::string>)> callback);
+bool Reject(Profile* profile, const std::string& id);
+}  // namespace aux::passkeys
