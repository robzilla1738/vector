+// Reads the account bound to this profile from the daemon's account file.
+std::optional<int> ReadAccountId(const base::FilePath& file,
+                                 const std::string& profile_directory) {
+  std::string contents;
+  if (!base::ReadFileToString(file, &contents)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC);
+  if (!root) {
+    return std::nullopt;
+  }
+  if (const base::DictValue* bindings =
+          root->FindDict("profileAccountBindings")) {
+    if (const base::DictValue* binding =
+            bindings->FindDict(profile_directory)) {
+      if (std::optional<int> id = binding->FindInt("accountId")) {
+        return id;
+      }
+    }
+  }
+  return root->FindInt("currentAccountId");
+}
+
+// Signs the daemon's challenge with this installation's key.
+std::optional<std::string> SignChallenge(const base::FilePath& key_file,
+                                         const std::string& challenge) {
+  std::string pem;
+  if (!base::ReadFileToString(key_file, &pem)) {
+    return std::nullopt;
+  }
+  std::string base64;
+  for (std::string_view line : base::SplitStringPiece(
+           pem, "\r\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (!line.starts_with("-----")) {
+      base64.append(line);
+    }
+  }
+  std::optional<std::vector<uint8_t>> der = base::Base64Decode(base64);
+  if (!der) {
+    return std::nullopt;
+  }
+  std::optional<crypto::keypair::PrivateKey> key =
+      crypto::keypair::PrivateKey::FromPrivateKeyInfo(*der);
+  std::optional<std::vector<uint8_t>> decoded = base::Base64Decode(challenge);
+  if (!key || !decoded) {
+    return std::nullopt;
+  }
+  std::vector<uint8_t> input(std::begin(kSigningPrefix),
+                             std::end(kSigningPrefix));  // Includes the NUL.
+  input.insert(input.end(), decoded->begin(), decoded->end());
+  return base::Base64Encode(
+      crypto::sign::Sign(crypto::sign::ECDSA_SHA256, *key, input));
+}
