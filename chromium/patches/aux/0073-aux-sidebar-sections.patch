+
+void AuxSidebarView::Rebuild() {
+  favicon_tracker_.TryCancelAll();
+  RemoveAllChildViews();
+  AddPinnedTiles();
+
+  // Returns whether the section is expanded.
+  auto add_header = [this](const std::string& key, const std::u16string& text) {
+    const bool collapsed = collapsed_sections_.contains(key);
+    auto* header = AddChildView(std::make_unique<AuxSidebarRow>(
+        base::BindRepeating(&AuxSidebarView::ToggleSection,
+                            base::Unretained(this), key),
+        text, ui::ImageModel(), /*emphasized=*/false));
+    header->SetBorder(
+        views::CreateEmptyBorder(gfx::Insets::TLBR(14, 10, 6, 10)));
+    header->SetImageModel(views::Button::STATE_NORMAL,
+                          ui::ImageModel::FromVectorIcon(
+                              collapsed ? vector_icons::kSubmenuArrowOldIcon
+                                        : vector_icons::kCaretDownOldIcon,
+                              ui::kColorSysOnSurfaceSubtle, 12));
+    header->SetImageLabelSpacing(6);
+    header->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    return !collapsed;
+  };
+
+  // Bookmarks.
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+  if (model && model->loaded() &&
+      !model->bookmark_bar_node()->children().empty()) {
+    const bool bookmarks_open = add_header("bookmarks", u"Bookmarks");
+    favicon::FaviconService* favicons = FaviconServiceFactory::GetForProfile(
+        browser_->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+    for (const auto& node : model->bookmark_bar_node()->children()) {
+      if (!bookmarks_open) {
+        break;
+      }
+      const GURL url = node->url();
+      auto* row = AddChildView(std::make_unique<AuxSidebarRow>(
+          node->is_folder() ? views::Button::PressedCallback()
+                            : base::BindRepeating(&AuxSidebarView::OpenBookmark,
+                                                  base::Unretained(this), url),
+          node->GetTitle().empty() ? base::UTF8ToUTF16(url.host())
+                                   : node->GetTitle(),
+          ui::ImageModel::FromVectorIcon(vector_icons::kStarFilledIcon,
+                                         ui::kColorSysOnSurfaceSubtle,
+                                         kRowIconSize)));
+      if (favicons && !node->is_folder()) {
+        auto tracker = std::make_unique<views::ViewTracker>(row);
+        favicons->GetFaviconImageForPageURL(
+            url,
+            base::BindOnce(
+                [](std::unique_ptr<views::ViewTracker> tracker,
+                   const favicon_base::FaviconImageResult& result) {
+                  if (auto* view = static_cast<AuxSidebarRow*>(tracker->view());
+                      view && !result.image.IsEmpty()) {
+                    view->SetFavicon(result.image.AsImageSkia());
+                  }
+                },
+                std::move(tracker)),
+            &favicon_tracker_);
+      }
+    }
+  }
+
+  // Chats.
+  const bool chats_open = add_header("chats", u"Chats");
+  if (chats_open) {
+    AddChildView(std::make_unique<AuxSidebarRow>(
+        base::BindRepeating(&AuxSidebarView::OpenNewChat,
+                            base::Unretained(this)),
+        u"New Chat",
+        ui::ImageModel::FromVectorIcon(vector_icons::kEditSquareIcon,
+                                       ui::kColorSysOnSurfaceSubtle,
+                                       kRowIconSize)));
+    const size_t shown = show_all_chats_
+                             ? chats_.size()
+                             : std::min(chats_.size(), kMaxChatsShown);
+    for (size_t i = 0; i < shown; ++i) {
+      const Chat& chat = chats_[i];
+      auto* row = AddChildView(std::make_unique<AuxSidebarRow>(
+          base::BindRepeating(&AuxSidebarView::OpenChat, base::Unretained(this),
+                              chat.id),
+          base::UTF8ToUTF16(chat.title), ui::ImageModel(),
+          /*emphasized=*/chat.unread,
+          /*selected=*/chat.id == active_chat_id_));
+      row->set_chat_id(chat.id);
+      row->SetTooltipText(base::UTF8ToUTF16(chat.title));
+      row->set_context_menu_controller(this);
+    }
+    if (chats_.size() > kMaxChatsShown) {
+      AddChildView(std::make_unique<AuxSidebarRow>(
+          base::BindRepeating(&AuxSidebarView::OpenAllChats,
+                              base::Unretained(this)),
+          u"Show all", ui::ImageModel()));
+    }
+  }
+
+  add_header("tabs", u"Tabs");
+  AddChildView(std::make_unique<AuxSidebarRow>(
+      base::BindRepeating(&AuxSidebarView::OpenNewTab, base::Unretained(this)),
+      u"New Tab",
+      ui::ImageModel::FromVectorIcon(vector_icons::kAdd2Icon,
+                                     ui::kColorSysOnSurfaceSubtle,
+                                     kRowIconSize)));
+  InvalidateLayout();
+}
+
+void AuxSidebarView::Poll() {
+  if (in_flight_) {
+    return;
+  }
+  in_flight_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadAccountId, AuxHome().AppendASCII("accounts.json"),
+                     browser_->GetProfile()->GetBaseName().AsUTF8Unsafe()),
+      base::BindOnce(
+          [](base::WeakPtr<AuxSidebarView> self, std::optional<int> id) {
+            if (!self) {
+              return;
+            }
+            self->account_id_ = id;
+            self->EnsureSession(base::BindOnce(
+                &AuxSidebarView::FetchChats, self->weak_factory_.GetWeakPtr()));
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void AuxSidebarView::Load(const GURL& url,
+                          const std::string& post_body,
+                          LoadCallback callback) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = post_body.empty() ? "GET" : "POST";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  if (!authorization_.empty()) {
+    request->headers.SetHeader("Authorization", authorization_);
+  }
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  if (!post_body.empty()) {
+    loader->AttachStringForUpload(post_body, "application/json");
+  }
+  network::SimpleURLLoader* raw_loader = loader.get();
+  raw_loader->DownloadToString(
+      browser_->GetProfile()->GetURLLoaderFactory().get(),
+      base::BindOnce(
+          [](base::WeakPtr<AuxSidebarView> self, LoadCallback callback,
+             std::unique_ptr<network::SimpleURLLoader> loader,
+             std::optional<std::string> body) {
+            const network::mojom::URLResponseHead* info =
+                loader->ResponseInfo();
+            const int code =
+                info && info->headers ? info->headers->response_code() : 0;
+            if (!self) {
+              return;
+            }
+            if (code == 401) {
+              self->authorization_.clear();
+            }
+            std::move(callback).Run(body && code == 200 ? std::move(body)
+                                                        : std::nullopt);
+          },
+          weak_factory_.GetWeakPtr(), std::move(callback), std::move(loader)),
+      1024 * 1024);
+}
+
+void AuxSidebarView::EnsureSession(base::OnceClosure then) {
+  if (!authorization_.empty() &&
+      base::TimeTicks::Now() < authorization_expiry_) {
+    std::move(then).Run();
+    return;
+  }
+  authorization_.clear();
+  Load(DaemonUrl("/auth/daemon/challenge?clientKind=chromium"), std::string(),
+       base::BindOnce(&AuxSidebarView::OnChallengeLoaded,
+                      weak_factory_.GetWeakPtr(), std::move(then)));
+}
+
+void AuxSidebarView::OnChallengeLoaded(base::OnceClosure then,
+                                       std::optional<std::string> body) {
+  std::optional<base::DictValue> parsed =
+      body ? base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC)
+           : std::nullopt;
+  const std::string* id = parsed ? parsed->FindString("challengeId") : nullptr;
+  const std::string* challenge =
+      parsed ? parsed->FindString("challenge") : nullptr;
+  if (!id || !challenge) {
+    in_flight_ = false;
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&SignChallenge,
+                     AuxHome().AppendASCII("install").AppendASCII("sig.pem"),
+                     *challenge),
+      base::BindOnce(&AuxSidebarView::OnSigned, weak_factory_.GetWeakPtr(),
+                     std::move(then), *id));
+}
+
+void AuxSidebarView::OnSigned(base::OnceClosure then,
+                              std::string challenge_id,
+                              std::optional<std::string> signed_challenge) {
+  if (!signed_challenge) {
+    in_flight_ = false;
+    return;
+  }
+  std::string payload;
+  base::JSONWriter::Write(base::DictValue()
+                              .Set("challengeId", challenge_id)
+                              .Set("signedChallenge", *signed_challenge),
+                          &payload);
+  Load(DaemonUrl("/auth/daemon/session"), payload,
+       base::BindOnce(&AuxSidebarView::OnSessionLoaded,
+                      weak_factory_.GetWeakPtr(), std::move(then)));
+}
+
+void AuxSidebarView::OnSessionLoaded(base::OnceClosure then,
+                                     std::optional<std::string> body) {
+  std::optional<base::DictValue> parsed =
+      body ? base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC)
+           : std::nullopt;
+  const std::string* type = parsed ? parsed->FindString("token_type") : nullptr;
+  const std::string* token =
+      parsed ? parsed->FindString("access_token") : nullptr;
+  const std::optional<int> lifetime =
+      parsed ? parsed->FindInt("expiresInSeconds") : std::nullopt;
+  if (!type || !token || *type != "AsideDaemonSessionToken" || !lifetime ||
+      *lifetime <= 0) {
+    in_flight_ = false;
+    return;
+  }
+  authorization_ = base::StrCat({*type, " ", *token});
+  authorization_expiry_ =
+      base::TimeTicks::Now() + base::Seconds(std::max(*lifetime - 30, 1));
+  std::move(then).Run();
+}
+
+void AuxSidebarView::FetchChats() {
+  const std::string account =
+      account_id_ ? base::NumberToString(*account_id_) : "0";
+  Load(DaemonUrl(
+           base::StrCat({"/session/for-chrome/chats?accountId=", account})),
+       std::string(),
+       base::BindOnce(&AuxSidebarView::OnChatsLoaded,
+                      weak_factory_.GetWeakPtr()));
+}
+
+void AuxSidebarView::OnChatsLoaded(std::optional<std::string> body) {
+  in_flight_ = false;
+  std::optional<base::DictValue> parsed =
+      body ? base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC)
+           : std::nullopt;
+  if (!parsed) {
+    return;
+  }
+  std::vector<Chat> chats;
+  for (const char* key : {"pinned", "recents"}) {
+    const base::ListValue* list = parsed->FindList(key);
+    if (!list) {
+      continue;
+    }
+    for (const base::Value& value : *list) {
+      const base::DictValue* item = value.GetIfDict();
+      const std::string* id = item ? item->FindString("id") : nullptr;
+      const std::string* title = item ? item->FindString("title") : nullptr;
+      if (!id) {
+        continue;
+      }
+      Chat chat;
+      chat.id = *id;
+      chat.title = title && !title->empty() ? *title : "New chat";
+      chat.unread = item->FindBool("unread").value_or(false);
+      chat.pinned = item->FindBool("pinned").value_or(false);
+      chat.can_pin = item->FindBool("canPin").value_or(false);
+      const std::string* status = item->FindString("status");
+      chat.running = status && *status == "running";
+      chats.push_back(std::move(chat));
+    }
+  }
+  const auto same = [](const std::vector<Chat>& a, const std::vector<Chat>& b) {
+    return std::ranges::equal(a, b, [](const Chat& x, const Chat& y) {
+      return x.id == y.id && x.title == y.title && x.unread == y.unread &&
+             x.running == y.running && x.pinned == y.pinned &&
+             x.can_pin == y.can_pin;
+    });
+  };
+  if (same(chats, chats_)) {
+    return;
+  }
+  chats_ = std::move(chats);
+  Rebuild();
+}
