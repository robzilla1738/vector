+base::FilePath AuxHome() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  std::string home = env->GetVar("ASIDE_HOME").value_or("");
+  if (!home.empty()) {
+    return base::FilePath::FromUTF8Unsafe(home);
+  }
+  base::FilePath user_home;
+  base::PathService::Get(base::DIR_HOME, &user_home);
+  return user_home.Append(".aux");
+}
+
+int DaemonPort() {
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  int port = 0;
+  if (std::optional<std::string> value = env->GetVar("ASIDE_PORT");
+      value && base::StringToInt(*value, &port) && port > 0) {
+    return port;
+  }
+  return kDefaultDaemonPort;
+}
+
+GURL DaemonUrl(const std::string& path) {
+  return GURL(
+      base::StrCat({kDaemonOrigin, base::NumberToString(DaemonPort()), path}));
+}
