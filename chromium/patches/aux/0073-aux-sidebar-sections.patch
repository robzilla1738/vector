+// One pinned tab, drawn as a rounded tile with its favicon centered.
+class AuxPinnedTile : public views::Button {
+  METADATA_HEADER(AuxPinnedTile, views::Button)
+
+ public:
+  using MoveCallback = base::RepeatingCallback<void(int from, int to)>;
+
+  AuxPinnedTile(PressedCallback callback,
+                MoveCallback move_callback,
+                int tab_index,
+                const ui::ImageModel& icon,
+                const std::u16string& title,
+                bool active)
+      : views::Button(std::move(callback)),
+        move_callback_(std::move(move_callback)),
+        tab_index_(tab_index),
+        active_(active) {
+    auto image = std::make_unique<views::ImageView>(icon);
+    image->SetImageSize(gfx::Size(kTileIconSize, kTileIconSize));
+    image->SetCanProcessEventsWithinSubtree(false);
+    image_ = image.get();
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical))
+        ->set_main_axis_alignment(views::BoxLayout::MainAxisAlignment::kCenter);
+    AddChildView(std::move(image));
+    SetTooltipText(title);
+    GetViewAccessibility().SetName(title);
+    SetFocusBehavior(FocusBehavior::ACCESSIBLE_ONLY);
+    UpdateStyle();
+  }
+
+  int tab_index() const { return tab_index_; }
+
+  // Dragging a tile onto another slot reorders the pinned tabs.
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    press_point_ = event.location();
+    dragging_ = false;
+    return views::Button::OnMousePressed(event);
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    if (!dragging_ && (event.location() - press_point_).Length() > 6) {
+      dragging_ = true;
+      SetPaintToLayer();
+      layer()->SetFillsBoundsOpaquely(false);
+      layer()->SetOpacity(0.5f);
+    }
+    return dragging_ ? true : views::Button::OnMouseDragged(event);
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (!dragging_) {
+      views::Button::OnMouseReleased(event);
+      return;
+    }
+    dragging_ = false;
+    DestroyLayer();
+    views::Button::OnMouseCaptureLost();
+    gfx::Point point = event.location();
+    views::View::ConvertPointToTarget(this, parent(), &point);
+    const int count = static_cast<int>(parent()->children().size());
+    const int column = std::clamp(
+        point.x() * kTilesPerRow / std::max(parent()->width(), 1), 0,
+        kTilesPerRow - 1);
+    const int row = std::max(0, point.y() / (kTileHeight + kTileGap));
+    const int target = std::clamp(row * kTilesPerRow + column, 0, count - 1);
+    if (target != tab_index_) {
+      move_callback_.Run(tab_index_, target);
+    }
+  }
+
+ protected:
+  void StateChanged(views::Button::ButtonState old_state) override {
+    views::Button::StateChanged(old_state);
+    UpdateStyle();
+  }
+
+ private:
+  void UpdateStyle() {
+    const bool hovered = GetState() == views::Button::STATE_HOVERED ||
+                         GetState() == views::Button::STATE_PRESSED;
+    SetBackground(views::CreateRoundedRectBackground(
+        hovered || active_ ? ui::kColorSysStateHoverOnProminent
+                           : ui::kColorSysStateHoverOnSubtle,
+        kTileRadius));
+    SetBorder(views::CreateRoundedRectBorder(
+        1, kTileRadius,
+        active_ ? ui::kColorSysOnSurfaceSubtle : ui::kColorSysDivider));
+    SchedulePaint();
+  }
+
+  const MoveCallback move_callback_;
+  const int tab_index_;
+  const bool active_;
+  gfx::Point press_point_;
+  bool dragging_ = false;
+  raw_ptr<views::ImageView> image_ = nullptr;
+};
