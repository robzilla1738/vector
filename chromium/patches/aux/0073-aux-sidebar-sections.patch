+GURL AuxSidebarView::AgentManagerUrl(const std::string& fragment) const {
+  std::string account = account_id_ ? base::NumberToString(*account_id_) : "0";
+  return GURL(base::StrCat({"chrome-extension://", kAgentManagerId,
+                            "/newtab.html#/u/", account, fragment}));
+}
