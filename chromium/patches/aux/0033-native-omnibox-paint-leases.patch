+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_AUX_OMNIBOX_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_AUX_OMNIBOX_HANDLER_H_
+
+#include <optional>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.h"
+#include "content/public/browser/weak_document_ptr.h"
+
+// Owned by one authorized shell document. Results and navigation use the same
+// native controller; the renderer cannot supply a replacement match.
+class AuxOmniboxHandler final : public SearchboxHandler {
+ public:
+  using Target = base::RepeatingCallback<content::WebContents*()>;
+  using Update = base::RepeatingCallback<void(base::DictValue)>;
+  AuxOmniboxHandler(Profile* profile, content::WebContents* shell,
+                    Target target, Update update);
+  ~AuxOmniboxHandler() override;
+  bool Start(int query_id, const std::u16string& input, bool on_focus);
+  bool Stop(int query_id);
+  bool Open(int query_id, const base::DictValue* selection,
+            WindowOpenDisposition disposition);
+  bool Hint(const std::string& page_id, const GURL& expected_url, const GURL& url);
+  // Aux uses the original window permission UI, without a Realbox Page pipe.
+  // No Lens thumbnail exists in the Aux omnibox, as in the native Realbox.
+  void OnThumbnailRemoved() override {}
+  void OnPermissionPromptChanged(bool is_showing, const gfx::Size& prompt_size) override {}
+  void OnResultChanged(AutocompleteController* controller,
+                       bool default_match_changed) override;
+ private:
+  bool TargetIsCurrent() const;
+  void PredictNavigation(const AutocompleteResult& result);
+  Target target_resolver_;
+  Update update_;
+  base::WeakPtr<content::WebContents> target_;
+  std::optional<content::WeakDocumentPtr> document_;
+  bool live_ = false;
+  base::WeakPtrFactory<AuxOmniboxHandler> weak_factory_{this};
+};
+#endif
