+
+ProfileLibrary::ProfileLibrary(Profile* profile,
+                               RuntimeCall call,
+                               base::RepeatingClosure changed,
+                               base::RepeatingClosure history_changed)
+    : profile_(profile),
+      call_(std::move(call)),
+      changed_(std::move(changed)),
+      history_changed_(std::move(history_changed)) {
+  CHECK(profile && !profile->IsOffTheRecord());
+  history_ = HistoryServiceFactory::GetForProfile(
+      profile, ServiceAccessType::EXPLICIT_ACCESS);
+  if (history_) {
+    history_->AddObserver(this);
+  }
+  bookmarks_ = BookmarkModelFactory::GetForBrowserContext(profile);
+  if (bookmarks_) {
+    bookmarks_->AddObserver(this);
+  }
+}
