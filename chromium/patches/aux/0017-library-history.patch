+void ProfileLibrary::OnHistoryServiceLoaded(history::HistoryService *service) {
+  if (service == history_) {
+    NotifyHistory();
+    RefreshHistory();
+  }
+}
+
+void ProfileLibrary::HistoryServiceBeingDeleted(
+    history::HistoryService *service) {
+  if (service == history_) {
+    history_->RemoveObserver(this);
+    history_ = nullptr;
+    history_ready_ = false;
+  }
+}
+
+void ProfileLibrary::NotifyHistory() {
+  if (history_note_pending_) {
+    return;
+  }
+  history_note_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<ProfileLibrary> self) {
+                       if (!self) {
+                         return;
+                       }
+                       self->history_note_pending_ = false;
+                       self->history_changed_.Run();
+                     },
+                     history_weak_factory_.GetWeakPtr()));
+}
+
+void ProfileLibrary::NotifyBookmarks() {
+  if (bookmark_note_pending_) {
+    return;
+  }
+  bookmark_note_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<ProfileLibrary> self) {
+                       if (!self) {
+                         return;
+                       }
+                       self->bookmark_note_pending_ = false;
+                       if (self->changed_) {
+                         self->changed_.Run();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
