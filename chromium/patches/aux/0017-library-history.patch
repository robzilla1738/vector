+#if BUILDFLAG(ENABLE_AUX_SHELL)
+void WebUIBrowserUI::HandleAuxLibraryRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  const base::ListValue* list = &args;
+  if (method == "historyInvoke") {
+    Profile* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Private windows do not expose saved history");
+      return;
+    }
+    const auto* request = args.size() == 1 ? args[0].GetIfDict() : nullptr;
+    const auto* history_method =
+        request ? request->FindString("method") : nullptr;
+    const auto* params = request ? request->FindDict("params") : nullptr;
+    if (!history_method || !params) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid history request");
+      return;
+    }
+    const auto document =
+        web_ui()->GetWebContents()->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+    auto current = base::BindRepeating(
+        [](base::WeakPtr<WebUIBrowserUI> owner,
+           content::WeakDocumentPtr document) {
+          auto* frame = document.AsRenderFrameHostIfValid();
+          return owner && frame && owner->IsAuthorizedAuxDocument() &&
+                 frame ==
+                     owner->web_ui()->GetWebContents()->GetPrimaryMainFrame();
+        },
+        weak_factory_.GetWeakPtr(), document);
+    AuxRuntimeHost::ForProfile(profile)->CallHistoryForUser(
+        *history_method, *params,
+        base::BindOnce(
+            [](std::string method, base::RepeatingCallback<bool()> current,
+               RequestCallback callback, base::DictValue response) {
+              if (!current.Run()) {
+                std::move(callback).Run(
+                    false, "", "ref_stale",
+                    "Original history window is unavailable");
+                return;
+              }
+              if (auto* result = response.Find("result")) {
+                if (method == "history.clear") {
+                  result->GetDict().Set("ok", true);
+                }
+                base::DictValue envelope;
+                envelope.Set("method", method);
+                envelope.Set("result", result->Clone());
+                std::move(callback).Run(true, *base::WriteJson(envelope), "",
+                                        "");
+                return;
+              }
+              const auto* error = response.FindDict("error");
+              const auto* code = error ? error->FindString("code") : nullptr;
+              const auto* message =
+                  error ? error->FindString("message") : nullptr;
+              std::move(callback).Run(
+                  false, "", code ? *code : "backend_unavailable",
+                  message ? *message : "Chromium history is unavailable");
+            },
+            *history_method, current, std::move(callback)),
+        current);
+    return;
+  }
+  if (method == "bookmarksInvoke") {
+    Profile* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Private windows do not persist bookmarks");
+      return;
+    }
+    const base::DictValue* request =
+        args.size() == 1 ? args[0].GetIfDict() : nullptr;
+    const std::string* bookmark_method =
+        request ? request->FindString("method") : nullptr;
+    const base::DictValue* params =
+        request ? request->FindDict("params") : nullptr;
+    if (!bookmark_method || !params) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid bookmark request");
+      return;
+    }
+    auto* model = BookmarkModelFactory::GetForBrowserContext(profile);
+    if (!model) {
+      std::move(callback).Run(false, "", "backend_unavailable",
+                              "Chromium bookmarks are unavailable");
+      return;
+    }
+    if (!model->loaded()) {
+      const auto document = web_ui()
+                                ->GetWebContents()
+                                ->GetPrimaryMainFrame()
+                                ->GetWeakDocumentPtr();
+      bookmarks::ScheduleCallbackOnBookmarkModelLoad(
+          *model, base::BindOnce(
+                      [](base::WeakPtr<WebUIBrowserUI> owner,
+                         content::WeakDocumentPtr document,
+                         base::ListValue args, RequestCallback callback) {
+                        auto* frame = document.AsRenderFrameHostIfValid();
+                        if (!owner || !frame ||
+                            !owner->IsAuthorizedAuxDocument() ||
+                            frame != owner->web_ui()
+                                         ->GetWebContents()
+                                         ->GetPrimaryMainFrame()) {
+                          std::move(callback).Run(
+                              false, "", "ref_stale",
+                              "Original bookmark window is unavailable");
+                          return;
+                        }
+                        owner->HandleAuxLibraryRequest("bookmarksInvoke", args,
+                                                       std::move(callback));
+                      },
+                      weak_factory_.GetWeakPtr(), document, args.Clone(),
+                      std::move(callback)));
+      return;
+    }
+    if (*bookmark_method == "bookmarks.open") {
+      const std::string* node_id = params->FindString("nodeId");
+      const std::string* url = params->FindString("url");
+      const std::string* disposition = params->FindString("disposition");
+      int64_t id = 0;
+      const auto* node = node_id && base::StringToInt64(*node_id, &id)
+                             ? bookmarks::GetBookmarkNodeByID(model, id)
+                             : nullptr;
+      if (!node || !node->is_url() || !url || node->url().spec() != *url ||
+          !disposition) {
+        std::move(callback).Run(false, "", "conflict", "This bookmark changed");
+        return;
+      }
+      const bool current = *disposition == "current";
+      const bool activated = web_ui()
+                                 ->GetWebContents()
+                                 ->GetPrimaryMainFrame()
+                                 ->HasTransientUserActivation();
+      auto* target = browser_->GetTabStripModel()->GetActiveWebContents();
+      if (current || node->url().SchemeIs("javascript")) {
+        const auto* identity =
+            target ? aux::PageIdentity::FromWebContents(target) : nullptr;
+        const std::string* page_id = params->FindString("pageId");
+        aux::EgressRequestContext context;
+        if (target && target->GetPrimaryMainFrame()) {
+          context.page_id = identity ? identity->id() : "";
+          context.document =
+              target->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+        }
+        if (!current || !activated || !target ||
+            target == web_ui()->GetWebContents() ||
+            target->GetBrowserContext() != profile || !identity ||
+            identity->runtime_owned() || !page_id ||
+            *page_id != identity->id() ||
+            aux::EgressController::ForProfile(profile)->IsProtected(context)) {
+          std::move(callback).Run(
+              false, "", "ref_stale",
+              "Open this bookmark from its current browsing tab");
+          return;
+        }
+      }
+      const std::string* space_id = params->FindString("spaceId");
+      const std::string window_id =
+          base::NumberToString(browser_->GetSessionID().id());
+      std::string placement_error;
+      auto destination = [&]() -> std::optional<base::DictValue> {
+        auto snapshot = aux::OrganizationStore::Snapshot(profile, window_id,
+                                                         &placement_error);
+        const auto* layout = snapshot ? snapshot->FindDict("layout") : nullptr;
+        const auto* shared = layout ? layout->FindDict("shared") : nullptr;
+        const auto* spaces = shared ? shared->FindList("spaces") : nullptr;
+        if (spaces) {
+          for (const auto& value : *spaces) {
+            const auto& space = value.GetDict();
+            if (space.FindString("id") &&
+                *space.FindString("id") == *space_id &&
+                !space.FindBool("archived").value_or(false))
+              return snapshot;
+          }
+        }
+        return std::nullopt;
+      };
+      if (space_id && !current && !destination()) {
+        std::move(callback).Run(false, "", "conflict",
+                                "This bookmark Space is no longer available");
+        return;
+      }
+      NavigateParams navigation(browser_, node->url(),
+                                ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+      navigation.disposition = current ? WindowOpenDisposition::CURRENT_TAB
+                               : *disposition == "background"
+                                   ? WindowOpenDisposition::NEW_BACKGROUND_TAB
+                                   : WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      navigation.source_contents = current ? target : nullptr;
+      navigation.user_gesture = activated;
+      navigation.original_user_gesture = activated;
+      Navigate(&navigation);
+      auto* opened = navigation.navigated_or_inserted_contents.get();
+      const bool opened_here =
+          opened && opened->GetBrowserContext() == profile &&
+          browser_->GetTabStripModel()->GetIndexOfWebContents(opened) !=
+              TabStripModel::kNoTab;
+      const std::string opened_id =
+          opened_here ? aux::PageIdentity::GetOrCreate(profile, opened) : "";
+      if (opened_here && space_id && !current) {
+        auto snapshot = destination();
+        if (!snapshot) {
+          std::move(callback).Run(false, "", "conflict",
+                                  "Bookmark opened, but its Space changed");
+          return;
+        }
+        auto* layout = snapshot->FindDict("layout");
+        layout->FindDict("shared")
+            ->FindDict("tabSpace")
+            ->Set(opened_id, *space_id);
+        if (!aux::OrganizationStore::Commit(
+                profile, window_id, snapshot->FindInt("revision").value(),
+                *layout, &placement_error)) {
+          std::move(callback).Run(false, "", "conflict",
+                                  "Bookmark opened, but its Space changed");
+          return;
+        }
+      }
+      base::DictValue result;
+      result.Set("pageId",
+                 opened_here ? base::Value(opened_id) : base::Value());
+      base::DictValue envelope;
+      envelope.Set("method", *bookmark_method);
+      envelope.Set("result", std::move(result));
+      std::move(callback).Run(true, *base::WriteJson(envelope), "", "");
+      return;
+    }
+    // The generated public schema admits only native bookmark methods and
+    // their exact parameter shapes. Reuse the Profile model's identity and
+    // stale-revision checks instead of introducing a second mutation path.
+    base::DictValue response =
+        AuxRuntimeHost::ForProfile(profile)->CallBookmarksForUser(
+            *bookmark_method, *params);
+    if (const base::Value* result = response.Find("result")) {
+      base::DictValue envelope;
+      envelope.Set("method", *bookmark_method);
+      envelope.Set("result", result->Clone());
+      std::move(callback).Run(true, *base::WriteJson(envelope), "", "");
+      return;
+    }
+    const base::DictValue* error = response.FindDict("error");
+    const std::string* code = error ? error->FindString("code") : nullptr;
+    const std::string* message = error ? error->FindString("message") : nullptr;
+    std::move(callback).Run(
+        false, "", code ? *code : "backend_unavailable",
+        message ? *message : "Chromium bookmarks are unavailable");
+    return;
+  }
+
+  if (method == "organizationSnapshot" || method == "organizationCommit") {
+    if (browser_->GetProfile()->IsOffTheRecord()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Private windows do not persist organization");
+      return;
+    }
+    const std::string window_id =
+        base::NumberToString(browser_->GetSessionID().id());
+    std::string error;
+    std::optional<base::DictValue> snapshot;
+    if (method == "organizationSnapshot" && list->empty()) {
+      snapshot = aux::OrganizationStore::Snapshot(browser_->GetProfile(),
+                                                   window_id, &error);
+    } else if (method == "organizationCommit" && list->size() == 1 &&
+               (*list)[0].is_dict()) {
+      const base::DictValue& input = (*list)[0].GetDict();
+      const std::optional<int> expected = input.FindInt("expectedRevision");
+      const base::DictValue* layout = input.FindDict("layout");
+      if (expected && layout && input.size() == 2) {
+        snapshot = aux::OrganizationStore::Commit(
+            browser_->GetProfile(), window_id, *expected, *layout, &error);
+      }
+    }
+    if (!snapshot) {
+      const bool conflict = error == "Organization revision conflict";
+      std::move(callback).Run(false, "",
+                              conflict ? "conflict" : "invalid_argument",
+                              error.empty() ? "Invalid organization request"
+                                            : error);
+      return;
+    }
+    std::move(callback).Run(true, *base::WriteJson(*snapshot), "", "");
+    return;
+  }
+  std::move(callback).Run(false, "", "not_found",
+                          "Unsupported Aux shell method: " + method);
+}
+#endif
