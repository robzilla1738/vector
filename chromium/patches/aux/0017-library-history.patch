 // Logs a migration failure to UMA and logging. The return value will be
 // what to return from ::Init (to simplify the call sites). Migration failures
 // are almost always fatal since the database can be in an inconsistent state.
@@ -67,6 +88,68 @@ sql::InitStatus LogInitFailure(HistoryDatabase::InitStep what) {
 
 }  // namespace
 
+bool HistoryDatabase::GetVisibleVisitPage(
+    base::Time begin,
+    base::Time end,
+    const std::optional<std::pair<base::Time, std::string>>& before,
+    int limit,
+    QueryResults* result) {
+  std::string query = "SELECT u.url,u.title,(v.visit_time/1000)*1000";
+  query += kVisibleVisitIdentities;
+  if (before) {
+    query += "AND (v.visit_time/1000<? OR (v.visit_time/1000=? AND u.url<?)) ";
+    const base::Time cursor_end = before->first + base::Milliseconds(1);
+    if (end.is_null() || end > cursor_end) {
+      end = cursor_end;
+    }
+  }
+  query +=
+      "GROUP BY v.visit_time/1000,u.url ORDER BY v.visit_time/1000 DESC,u.url "
+      "DESC LIMIT ?";
+  sql::Statement statement(db_.GetUniqueStatement(base::cstring_view(query)));
+  BindVisibleVisitRange(statement, begin, end);
+  int index = 8;
+  if (before) {
+    const int64_t milliseconds =
+        before->first.ToDeltaSinceWindowsEpoch().InMilliseconds();
+    statement.BindInt64(index++, milliseconds);
+    statement.BindInt64(index++, milliseconds);
+    statement.BindString(index++, before->second);
+  }
+  statement.BindInt(index, limit);
+  std::vector<URLResult> rows;
+  while (statement.Step()) {
+    URLResult row(GURL(statement.ColumnString(0)));
+    if (!row.url().is_valid()) {
+      continue;
+    }
+    row.set_title(statement.ColumnString16(1));
+    row.set_visit_time(base::Time::FromDeltaSinceWindowsEpoch(
+        base::Microseconds(statement.ColumnInt64(2))));
+    rows.push_back(std::move(row));
+  }
+  if (!statement.Succeeded()) {
+    return false;
+  }
+  result->SetURLResults(std::move(rows));
+  return true;
+}
+
+bool HistoryDatabase::CountVisibleVisitIdentities(base::Time begin,
+                                                  base::Time end,
+                                                  int64_t* count) {
+  const std::string query = std::string("SELECT count(*) FROM (SELECT 1") +
+                            kVisibleVisitIdentities +
+                            "GROUP BY v.visit_time/1000,u.url)";
+  sql::Statement statement(db_.GetUniqueStatement(base::cstring_view(query)));
+  BindVisibleVisitRange(statement, begin, end);
+  if (!statement.Step()) {
+    return false;
+  }
+  *count = statement.ColumnInt64(0);
+  return statement.Succeeded();
+}
