+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_COOKIE_IMPORT_H_
+#define CHROME_BROWSER_UI_AUX_COOKIE_IMPORT_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+
+class Profile;
+namespace net {
+class CanonicalCookie;
+}
+
+namespace aux {
+
+std::unique_ptr<net::CanonicalCookie> ParseImportedCookie(
+    const base::Value& raw);
+
+// Imports validated cookies only into the authenticated regular Profile.
+// Invalid individual records are skipped; the returned count is the number
+// accepted by Chromium's cookie store, not merely syntactically valid inputs.
+void ImportCookies(Profile* profile,
+                   const base::DictValue& params,
+                   base::OnceCallback<void(base::DictValue)> callback);
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_COOKIE_IMPORT_H_
