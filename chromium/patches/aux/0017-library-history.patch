+std::vector<std::pair<const bookmarks::BookmarkNode *, std::string>>
+ProfileLibrary::RootAliases() const {
+  std::vector<std::pair<const bookmarks::BookmarkNode *, std::string>> roots;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return roots;
+  }
+  std::set<std::string> used;
+  for (const auto &child : bookmarks_->bookmark_bar_node()->children()) {
+    if (child->is_folder()) {
+      used.insert(base::UTF16ToUTF8(child->GetTitle()));
+    }
+  }
+  auto add = [&](const bookmarks::BookmarkNode *root,
+                 const std::string &preferred) {
+    if (!root) {
+      return;
+    }
+    std::string label = preferred;
+    for (int suffix = 2; used.contains(label); ++suffix) {
+      label = preferred + " (" + base::NumberToString(suffix) + ")";
+    }
+    used.insert(label);
+    roots.emplace_back(root, std::move(label));
+  };
+  add(bookmarks_->other_node(), "Other bookmarks");
+  add(bookmarks_->mobile_node(), "Mobile bookmarks");
+  add(bookmarks_->account_bookmark_bar_node(), "Account bookmarks");
+  add(bookmarks_->account_other_node(), "Account other bookmarks");
+  add(bookmarks_->account_mobile_node(), "Account mobile bookmarks");
+  return roots;
+}
+
+base::ListValue ProfileLibrary::ListBookmarks() const {
+  base::ListValue result;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return result;
+  }
+  auto walk = [&](auto &&self, const bookmarks::BookmarkNode *node,
+                  const base::ListValue &path) -> void {
+    for (const auto &child : node->children()) {
+      if (child->is_folder()) {
+        base::ListValue next = path.Clone();
+        next.Append(base::UTF16ToUTF8(child->GetTitle()));
+        self(self, child.get(), next);
+        continue;
+      }
+      base::DictValue bookmark;
+      bookmark.Set("nodeId", NodeId(child.get()));
+      bookmark.Set("parentId", NodeId(node));
+      bookmark.Set("index",
+                   static_cast<int>(node->GetIndexOf(child.get()).value()));
+      bookmark.Set("url", child->url().spec());
+      bookmark.Set("title", base::UTF16ToUTF8(child->GetTitle()));
+      bookmark.Set("folderPath", path.Clone());
+      bookmark.Set("createdAt",
+                   static_cast<double>(
+                       child->date_added().InMillisecondsSinceUnixEpoch()));
+      std::string meta;
+      if (child->GetMetaInfo(kReadingListKey, &meta) && meta == "1") {
+        bookmark.Set("readingList", true);
+        if (child->GetMetaInfo(kReadAtKey, &meta)) {
+          int64_t read_at = 0;
+          if (base::StringToInt64(meta, &read_at) && read_at > 0) {
+            bookmark.Set("readAt", static_cast<double>(read_at));
+          }
+        }
+      }
+      result.Append(std::move(bookmark));
+    }
+  };
+  walk(walk, bookmarks_->bookmark_bar_node(), base::ListValue());
+  for (const auto &[root, name] : RootAliases()) {
+    base::ListValue path;
+    path.Append(name);
+    walk(walk, root, path);
+  }
+  return result;
+}
+
+base::ListValue ProfileLibrary::ListFolders() const {
+  base::ListValue result;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return result;
+  }
+  auto walk = [&](auto &&self, const bookmarks::BookmarkNode *node,
+                  const base::ListValue &path) -> void {
+    for (const auto &child : node->children()) {
+      if (!child->is_folder()) {
+        continue;
+      }
+      base::ListValue next = path.Clone();
+      next.Append(base::UTF16ToUTF8(child->GetTitle()));
+      result.Append(next.Clone());
+      self(self, child.get(), next);
+    }
+  };
+  walk(walk, bookmarks_->bookmark_bar_node(), base::ListValue());
+  for (const auto &[root, name] : RootAliases()) {
+    base::ListValue path;
+    path.Append(name);
+    result.Append(path.Clone());
+    walk(walk, root, path);
+  }
+  return result;
+}
+
+base::DictValue ProfileLibrary::FolderSnapshot() const {
+  base::ListValue folders;
+  auto walk = [&](auto&& self, const bookmarks::BookmarkNode* node,
+                  const base::ListValue& path) -> void {
+    const bool permanent = bookmarks_->is_permanent_node(node);
+    base::DictValue folder;
+    folder.Set("nodeId", NodeId(node));
+    folder.Set("parentId",
+               permanent ? base::Value() : base::Value(NodeId(node->parent())));
+    folder.Set(
+        "index",
+        permanent ? 0
+                  : static_cast<int>(node->parent()->GetIndexOf(node).value()));
+    folder.Set("title", base::UTF16ToUTF8(node->GetTitle()));
+    folder.Set("path", path.Clone());
+    folder.Set("permanent", permanent);
+    folder.Set("childIds", ChildIds(node));
+    folders.Append(std::move(folder));
+    for (const auto& child : node->children()) {
+      if (!child->is_folder()) {
+        continue;
+      }
+      base::ListValue child_path = path.Clone();
+      child_path.Append(base::UTF16ToUTF8(child->GetTitle()));
+      self(self, child.get(), child_path);
+    }
+  };
+  walk(walk, bookmarks_->bookmark_bar_node(), base::ListValue());
+  for (const auto& [root, name] : RootAliases()) {
+    base::ListValue path;
+    path.Append(name);
+    walk(walk, root, path);
+  }
+  return base::DictValue()
+      .Set("rootId", NodeId(bookmarks_->bookmark_bar_node()))
+      .Set("editable", profile_->GetPrefs()->GetBoolean(
+                           bookmarks::prefs::kEditBookmarksEnabled))
+      .Set("folders", std::move(folders));
+}
+
+base::DictValue ProfileLibrary::ChangeFolder(const base::DictValue& operation) {
+  if (!profile_->GetPrefs()->GetBoolean(
+          bookmarks::prefs::kEditBookmarksEnabled)) {
+    return Fault("forbidden",
+                 "Bookmark editing is managed by your organization");
+  }
+  const std::string* kind = operation.FindString("kind");
+  if (!kind || (*kind != "create" && *kind != "rename" && *kind != "move" &&
+                *kind != "remove")) {
+    return Fault("invalid_params", "Invalid folder operation");
+  }
+  const bookmarks::BookmarkNode* source = nullptr;
+  if (*kind != "create") {
+    const base::DictValue* expected = operation.FindDict("source");
+    source = expected ? FolderById(bookmarks_, expected->FindString("nodeId"))
+                      : nullptr;
+    if (!source || bookmarks_->is_permanent_node(source) ||
+        *expected != NodeSource(source)) {
+      return Fault("conflict",
+                   "The folder changed. Open its menu and try again.");
+    }
+  }
+  const bookmarks::BookmarkNode* parent = nullptr;
+  size_t index = 0;
+  if (*kind == "create" || *kind == "move") {
+    const base::DictValue* destination = operation.FindDict("destination");
+    parent = destination
+                 ? FolderById(bookmarks_, destination->FindString("parentId"))
+                 : nullptr;
+    const base::ListValue* expected =
+        destination ? destination->FindList("expectedChildren") : nullptr;
+    const std::optional<int> requested_index =
+        destination ? destination->FindInt("index") : std::nullopt;
+    if (!parent || !expected || *expected != ChildIds(parent) ||
+        !requested_index || *requested_index < 0 ||
+        static_cast<size_t>(*requested_index) > parent->children().size()) {
+      return Fault("conflict", "The destination changed. Choose it again.");
+    }
+    index = static_cast<size_t>(*requested_index);
+    if (source && parent->HasAncestor(source)) {
+      return Fault(
+          "invalid_params",
+          "A folder cannot be moved into itself or one of its children");
+    }
+  }
+  base::Value undo;
+  if (*kind == "create") {
+    const std::string* title = operation.FindString("title");
+    if (!title) {
+      return Fault("invalid_params", "A folder name is required");
+    }
+    if (const std::string* absent_id = operation.FindString("absentNodeId")) {
+      int64_t id = 0;
+      if (!base::StringToInt64(*absent_id, &id) || id <= 0 ||
+          bookmarks::GetBookmarkNodeByID(bookmarks_, id)) {
+        return Fault("conflict", "The original folder was already restored");
+      }
+    }
+    const auto* created =
+        bookmarks_->AddFolder(parent, index, base::UTF8ToUTF16(*title));
+    undo = base::Value(base::DictValue()
+                           .Set("kind", "remove")
+                           .Set("source", NodeSource(created)));
+  } else if (*kind == "rename") {
+    const std::string* title = operation.FindString("title");
+    if (!title) {
+      return Fault("invalid_params", "A folder name is required");
+    }
+    const std::string previous = base::UTF16ToUTF8(source->GetTitle());
+    if (*title != previous) {
+      bookmarks_->SetTitle(source, base::UTF8ToUTF16(*title),
+                           bookmarks::metrics::BookmarkEditSource::kUser);
+      undo = base::Value(base::DictValue()
+                             .Set("kind", "rename")
+                             .Set("source", NodeSource(source))
+                             .Set("title", previous));
+    }
+  } else if (*kind == "move") {
+    if (auto inverse = MoveNode(bookmarks_, source, parent, index)) {
+      inverse->Set("kind", "move");
+      undo = base::Value(std::move(*inverse));
+    }
+  } else {
+    if (!source->children().empty()) {
+      return Fault("conflict",
+                   "Remove the folder's contents before removing the folder");
+    }
+    const auto* previous_parent = source->parent();
+    const size_t previous_index = previous_parent->GetIndexOf(source).value();
+    const std::string previous_title = base::UTF16ToUTF8(source->GetTitle());
+    const std::string previous_id = NodeId(source);
+    bookmarks_->Remove(source, bookmarks::metrics::BookmarkEditSource::kUser,
+                       FROM_HERE);
+    undo =
+        base::Value(base::DictValue()
+                        .Set("kind", "create")
+                        .Set("destination",
+                             FolderDestination(previous_parent, previous_index))
+                        .Set("title", previous_title)
+                        .Set("absentNodeId", previous_id));
+  }
+  return Result(base::Value(base::DictValue()
+                                .Set("snapshot", FolderSnapshot())
+                                .Set("undo", std::move(undo))));
+}
+
+base::DictValue ProfileLibrary::PlaceBookmark(const base::DictValue& params) {
+  if (!profile_->GetPrefs()->GetBoolean(
+          bookmarks::prefs::kEditBookmarksEnabled)) {
+    return Fault("forbidden",
+                 "Bookmark editing is managed by your organization");
+  }
+  const base::DictValue* expected_source = params.FindDict("source");
+  const auto* source = BookmarkBySource(bookmarks_, expected_source);
+  if (!source || bookmarks_->client()->IsNodeManaged(source) ||
+      *expected_source != NodeSource(source)) {
+    return Fault("conflict",
+                 "The bookmark changed. Open its menu and try again.");
+  }
+  const base::DictValue* destination = params.FindDict("destination");
+  const auto* parent =
+      destination ? FolderById(bookmarks_, destination->FindString("parentId"))
+                  : nullptr;
+  const base::ListValue* expected_children =
+      destination ? destination->FindList("expectedChildren") : nullptr;
+  const std::optional<int> index =
+      destination ? destination->FindInt("index") : std::nullopt;
+  if (!parent || !expected_children || *expected_children != ChildIds(parent) ||
+      !index || *index < 0 ||
+      static_cast<size_t>(*index) > parent->children().size()) {
+    return Fault("conflict", "The destination changed. Choose it again.");
+  }
+  auto inverse =
+      MoveNode(bookmarks_, source, parent, static_cast<size_t>(*index));
+  return Result(
+      base::Value(base::DictValue()
+                      .Set("snapshot", FolderSnapshot())
+                      .Set("undo", inverse ? base::Value(std::move(*inverse))
+                                           : base::Value())));
+}
+
+base::DictValue ProfileLibrary::ChangeBookmark(const std::string& method,
+                                               const base::DictValue& params) {
+  if (!profile_->GetPrefs()->GetBoolean(
+          bookmarks::prefs::kEditBookmarksEnabled))
+    return Fault("forbidden",
+                 "Bookmark editing is managed by your organization");
+  if (method == "bookmarks.entries.restore") {
+    const std::string* token = params.FindString("undoToken");
+    auto found = std::find_if(
+        removed_bookmarks_.begin(), removed_bookmarks_.end(),
+        [&](const auto& entry) { return token && entry->token == *token; });
+    if (found == removed_bookmarks_.end())
+      return Fault("not_found", "This bookmark can no longer be restored");
+    const auto& entry = **found;
+    const std::string parent_id = base::NumberToString(entry.parent_id);
+    const auto* parent = FolderById(bookmarks_, &parent_id);
+    if (!parent || bookmarks::GetBookmarkNodeByID(bookmarks_, entry.node_id) ||
+        ChildIds(parent) != entry.expected_children ||
+        entry.index > parent->children().size())
+      return Fault("conflict",
+                   "The original folder changed. Undo is unavailable.");
+    bookmarks_->AddURL(parent, entry.index, entry.title, entry.url, &entry.meta,
+                       entry.created_at);
+    removed_bookmarks_.erase(found);
+    return Result(base::Value(FolderSnapshot()));
+  }
+  const auto* node = BookmarkBySource(bookmarks_, params.FindDict("source"));
+  const bool create = method == "bookmarks.entries.create";
+  if (!node && !create)
+    return Fault("conflict",
+                 "The bookmark changed. Open its menu and try again.");
+  if (method == "bookmarks.entries.remove") {
+    auto entry = std::make_unique<RemovedBookmark>();
+    entry->token = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    entry->node_id = node->id();
+    const auto* parent = node->parent();
+    entry->parent_id = parent->id();
+    entry->index = parent->GetIndexOf(node).value();
+    entry->title = node->GetTitle();
+    entry->url = node->url();
+    entry->created_at = node->date_added();
+    if (const auto* meta = node->GetMetaInfoMap())
+      entry->meta = *meta;
+    bookmarks_->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                       FROM_HERE);
+    entry->expected_children = ChildIds(parent);
+    base::DictValue result = base::DictValue()
+                                 .Set("snapshot", FolderSnapshot())
+                                 .Set("undoToken", entry->token);
+    if (removed_bookmarks_.size() == 32)
+      removed_bookmarks_.pop_front();
+    removed_bookmarks_.push_back(std::move(entry));
+    return Result(base::Value(std::move(result)));
+  }
+  const std::string* title = params.FindString("title");
+  const std::string* url = params.FindString("url");
+  if (!title || !url || !GURL(*url).is_valid())
+    return Fault("invalid_params", "Enter a valid bookmark address");
+  const auto* parent = node ? node->parent() : nullptr;
+  size_t index = node ? parent->GetIndexOf(node).value() : 0;
+  if (const auto* destination = params.FindDict("destination")) {
+    parent = FolderById(bookmarks_, destination->FindString("parentId"));
+    const auto* children = destination->FindList("expectedChildren");
+    const auto proposed = destination->FindInt("index");
+    if (!parent || !children || *children != ChildIds(parent) || !proposed ||
+        *proposed < 0 ||
+        static_cast<size_t>(*proposed) > parent->children().size())
+      return Fault("conflict", "The destination changed. Choose it again.");
+    index = static_cast<size_t>(*proposed);
+  }
+  if (create) {
+    if (!parent)
+      return Fault("invalid_params", "Choose a bookmark folder");
+    bookmarks_->AddURL(parent, index, base::UTF8ToUTF16(*title), GURL(*url));
+    return Result(base::Value(FolderSnapshot()));
+  }
+  // Check every guard before editing either the entry or its placement.
+  bookmarks_->SetTitle(node, base::UTF8ToUTF16(*title),
+                       bookmarks::metrics::BookmarkEditSource::kUser);
+  bookmarks_->SetURL(node, GURL(*url),
+                     bookmarks::metrics::BookmarkEditSource::kUser);
+  MoveNode(bookmarks_, node, parent, index);
+  return Result(base::Value(base::DictValue()
+                                .Set("snapshot", FolderSnapshot())
+                                .Set("source", NodeSource(node))));
+}
+
+const bookmarks::BookmarkNode *
+ProfileLibrary::FindFolder(const base::ListValue &path, bool create) {
+  if (!bookmarks_ || !bookmarks_->loaded() || path.size() > 32) {
+    return nullptr;
+  }
+  const bookmarks::BookmarkNode *node = bookmarks_->bookmark_bar_node();
+  size_t offset = 0;
+  if (!path.empty() && path.front().is_string()) {
+    const std::string &first = path.front().GetString();
+    for (const auto &[root, name] : RootAliases()) {
+      if (first == name) {
+        node = root;
+        offset = 1;
+        break;
+      }
+    }
+  }
+  if (!node) {
+    return nullptr;
+  }
+  for (size_t index = offset; index < path.size(); ++index) {
+    if (!IsFolderName(path[index])) {
+      return nullptr;
+    }
+    const std::u16string title = base::UTF8ToUTF16(path[index].GetString());
+    const bookmarks::BookmarkNode *found = nullptr;
+    for (const auto &child : node->children()) {
+      if (child->is_folder() && child->GetTitle() == title) {
+        found = child.get();
+        break;
+      }
+    }
+    if (!found && create) {
+      found = bookmarks_->AddFolder(node, node->children().size(), title);
+    }
+    if (!found) {
+      return nullptr;
+    }
+    node = found;
+  }
+  return node;
+}
+
+const bookmarks::BookmarkNode *
+ProfileLibrary::FindBookmark(const base::DictValue &params,
+                             const std::string &url_key) const {
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return nullptr;
+  }
+  const std::string *node_id = params.FindString("nodeId");
+  const std::string *url = params.FindString(url_key);
+  if (!url || !ValidWebUrl(*url)) {
+    return nullptr;
+  }
+  const auto candidates = bookmarks_->GetNodesByURL(GURL(*url));
+  if (node_id) {
+    int64_t id = 0;
+    if (!base::StringToInt64(*node_id, &id)) {
+      return nullptr;
+    }
+    for (const auto &candidate : candidates) {
+      if (candidate->id() == id) {
+        return candidate;
+      }
+    }
+    return nullptr;
+  }
+  // Legacy callers identify a bookmark by URL. Prefer the most recent user
+  // node; explicit Library edits carry nodeId and never affect another copy.
+  return bookmarks_->GetMostRecentlyAddedUserNodeForURL(GURL(*url));
+}
+
+base::ListValue
+ProfileLibrary::FolderPath(const bookmarks::BookmarkNode *node) const {
+  std::vector<std::string> names;
+  const bookmarks::BookmarkNode *parent = node->parent();
+  while (parent && !bookmarks_->is_permanent_node(parent)) {
+    names.push_back(base::UTF16ToUTF8(parent->GetTitle()));
+    parent = parent->parent();
+  }
+  for (const auto &[root, name] : RootAliases()) {
+    if (parent == root) {
+      names.push_back(name);
+      break;
+    }
+  }
+  base::ListValue path;
+  for (auto it = names.rbegin(); it != names.rend(); ++it) {
+    path.Append(*it);
+  }
+  return path;
+}
+
+base::DictValue
+ProfileLibrary::BookmarkCall(const std::string &method,
+                             const base::DictValue &params) {
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return Fault("backend_unavailable", "Chromium bookmarks are still loading");
+  }
+  if (method == "bookmarks.entries.remove" ||
+      method == "bookmarks.entries.restore" ||
+      method == "bookmarks.entries.edit" ||
+      method == "bookmarks.entries.create") {
+    return ChangeBookmark(method, params);
+  }
+  if (method == "bookmarks.folders.snapshot") {
+    return Result(base::Value(FolderSnapshot()));
+  }
+  if (method == "bookmarks.folders.placeBookmark") {
+    return PlaceBookmark(params);
+  }
+  if (method == "bookmarks.folders.change") {
+    return ChangeFolder(params);
+  }
+  if (method == "bookmarks.list") {
+    return Result(base::Value(ListBookmarks()));
+  }
+  if (method == "bookmarks.folders.list") {
+    return Result(base::Value(ListFolders()));
+  }
+
+  if (method == "bookmarks.folders.create" ||
+      method == "bookmarks.folders.rename" ||
+      method == "bookmarks.folders.remove") {
+    const base::ListValue *path = params.FindList("path");
+    if (!path || path->empty() || path->size() > 32) {
+      return Fault("invalid_params", "Choose a bookmark folder");
+    }
+    if (method == "bookmarks.folders.create") {
+      if (FindFolder(*path, false)) {
+        return Fault("conflict", "That folder already exists");
+      }
+      base::ListValue parent_path = path->Clone();
+      const std::string *name = parent_path.back().GetIfString();
+      if (!name || name->empty() || name->size() > 200) {
+        return Fault("invalid_params", "Invalid folder name");
+      }
+      const std::string title = *name;
+      parent_path.erase(parent_path.end() - 1);
+      const bookmarks::BookmarkNode *parent = FindFolder(parent_path, false);
+      if (!parent) {
+        return Fault("not_found", "Parent folder no longer exists");
+      }
+      bookmarks_->AddFolder(parent, parent->children().size(),
+                            base::UTF8ToUTF16(title));
+    } else {
+      const bookmarks::BookmarkNode *folder = FindFolder(*path, false);
+      if (!folder || bookmarks_->is_permanent_node(folder)) {
+        return Fault("not_found", "Folder no longer exists");
+      }
+      if (method == "bookmarks.folders.rename") {
+        const std::string *name = params.FindString("name");
+        if (!name || name->empty() || name->size() > 200) {
+          return Fault("invalid_params", "Invalid folder name");
+        }
+        for (const auto &sibling : folder->parent()->children()) {
+          if (sibling.get() != folder && sibling->is_folder() &&
+              sibling->GetTitle() == base::UTF8ToUTF16(*name)) {
+            return Fault("conflict", "That folder already exists");
+          }
+        }
+        bookmarks_->SetTitle(folder, base::UTF8ToUTF16(*name),
+                             bookmarks::metrics::BookmarkEditSource::kUser);
+      } else {
+        if (!folder->children().empty()) {
+          return Fault("conflict", "Remove the folder's bookmarks first");
+        }
+        bookmarks_->Remove(
+            folder, bookmarks::metrics::BookmarkEditSource::kUser, FROM_HERE);
+      }
+    }
+    return Result(base::Value(ListFolders()));
+  }
+
+  if (method == "bookmarks.add" || method == "bookmarks.readingList") {
+    const std::string *url = params.FindString("url");
+    if (!url || !ValidWebUrl(*url)) {
+      return Fault("invalid_params", "Invalid bookmark address");
+    }
+    const bookmarks::BookmarkNode *node =
+        params.FindBool("forceNew").value_or(false) && method == "bookmarks.add"
+            ? nullptr
+            : FindBookmark(params, "url");
+    if (!node) {
+      if (method == "bookmarks.readingList" &&
+          !params.FindBool("readingList").value_or(false)) {
+        return Okay();
+      }
+      const std::string *title = params.FindString("title");
+      if (!title || title->size() > 1000) {
+        return Fault("invalid_params", "A title is required");
+      }
+      const base::ListValue *path = params.FindList("folderPath");
+      const bookmarks::BookmarkNode *folder =
+          path ? FindFolder(*path, true) : bookmarks_->bookmark_bar_node();
+      if (!folder) {
+        return Fault("invalid_params", "Invalid bookmark folder");
+      }
+      node = bookmarks_->AddNewURL(folder, folder->children().size(),
+                                   base::UTF8ToUTF16(*title), GURL(*url));
+    } else if (method == "bookmarks.add") {
+      if (const std::string *title = params.FindString("title")) {
+        bookmarks_->SetTitle(node, base::UTF8ToUTF16(*title),
+                             bookmarks::metrics::BookmarkEditSource::kUser);
+      }
+      if (const base::ListValue *path = params.FindList("folderPath")) {
+        const bookmarks::BookmarkNode *folder = FindFolder(*path, true);
+        if (!folder) {
+          return Fault("invalid_params", "Invalid bookmark folder");
+        }
+        if (folder != node->parent()) {
+          bookmarks_->Move(node, folder, folder->children().size());
+        }
+      }
+    }
+    if (std::optional<bool> reading = params.FindBool("readingList")) {
+      bookmarks_->SetNodeMetaInfo(node, kReadingListKey, *reading ? "1" : "0");
+      if (!*reading) {
+        bookmarks_->DeleteNodeMetaInfo(node, kReadAtKey);
+      }
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.markRead") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "url");
+    std::string reading;
+    if (!node || !node->GetMetaInfo(kReadingListKey, &reading) ||
+        reading != "1") {
+      return Fault("not_found", "This page is not on the reading list");
+    }
+    if (params.FindBool("read").value_or(false)) {
+      bookmarks_->SetNodeMetaInfo(
+          node, kReadAtKey,
+          base::NumberToString(
+              base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    } else {
+      bookmarks_->DeleteNodeMetaInfo(node, kReadAtKey);
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.remove") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "url");
+    if (const base::DictValue *expected = params.FindDict("expected")) {
+      const std::string *title = expected->FindString("title");
+      std::optional<double> created_at = expected->FindDouble("createdAt");
+      if (!node || !title || !created_at ||
+          base::UTF16ToUTF8(node->GetTitle()) != *title ||
+          static_cast<double>(
+              node->date_added().InMillisecondsSinceUnixEpoch()) !=
+              *created_at) {
+        return Fault("conflict", "This bookmark changed since the run");
+      }
+      if (const base::ListValue *folder = expected->FindList("folderPath")) {
+        if (FolderPath(node) != *folder) {
+          return Fault("conflict", "This bookmark moved since the run");
+        }
+      }
+      if (std::optional<bool> reading = expected->FindBool("readingList")) {
+        std::string meta;
+        const bool current = node->GetMetaInfo(kReadingListKey, &meta) &&
+                             meta == "1";
+        if (current != *reading) {
+          return Fault("conflict", "This bookmark changed reading-list state");
+        }
+      }
+    }
+    if (node) {
+      bookmarks_->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                         FROM_HERE);
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.update") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "originalUrl");
+    if (!node) {
+      return Fault("not_found", "This bookmark was removed");
+    }
+    const base::DictValue *expected = params.FindDict("expected");
+    const std::string *title = params.FindString("title");
+    const std::string *url = params.FindString("url");
+    const base::ListValue *path = params.FindList("folderPath");
+    if (!expected || !title || title->empty() || title->size() > 1000 || !url ||
+        !ValidWebUrl(*url)) {
+      return Fault("invalid_params", "Invalid bookmark edit");
+    }
+    const std::string *old_title = expected->FindString("title");
+    const base::ListValue *old_path = expected->FindList("folderPath");
+    if (!old_title || base::UTF16ToUTF8(node->GetTitle()) != *old_title ||
+        (old_path && FolderPath(node) != *old_path)) {
+      return Fault("conflict", "Bookmark changed in another window");
+    }
+    const bookmarks::BookmarkNode *folder =
+        path ? FindFolder(*path, false) : node->parent();
+    if (!folder) {
+      return Fault("not_found", "Destination folder no longer exists");
+    }
+    if (node->url().spec() != *url) {
+      for (const auto &duplicate : bookmarks_->GetNodesByURL(GURL(*url))) {
+        if (duplicate != node) {
+          return Fault("conflict", "That address is already bookmarked");
+        }
+      }
+    }
+    bookmarks_->SetTitle(node, base::UTF8ToUTF16(*title),
+                         bookmarks::metrics::BookmarkEditSource::kUser);
+    if (node->url().spec() != *url) {
+      bookmarks_->SetURL(node, GURL(*url),
+                         bookmarks::metrics::BookmarkEditSource::kUser);
+    }
+    if (folder != node->parent()) {
+      bookmarks_->Move(node, folder, folder->children().size());
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.move") {
+    const base::ListValue *selections = params.FindList("bookmarks");
+    const base::ListValue *path = params.FindList("folderPath");
+    if (!selections || !path || selections->empty() ||
+        selections->size() > 10000) {
+      return Fault("invalid_params", "Invalid bookmark selection");
+    }
+    std::vector<const bookmarks::BookmarkNode *> nodes;
+    nodes.reserve(selections->size());
+    for (const base::Value &item : *selections) {
+      const base::DictValue *entry = item.GetIfDict();
+      const bookmarks::BookmarkNode *node =
+          entry ? FindBookmark(*entry, "url") : nullptr;
+      const base::ListValue *expected =
+          entry ? entry->FindList("folderPath") : nullptr;
+      if (!node || !expected || FolderPath(node) != *expected) {
+        return Fault("conflict", "A selected bookmark moved or was removed");
+      }
+      nodes.push_back(node);
+    }
+    const bool create = params.FindBool("createFolder").value_or(false);
+    if (create && FindFolder(*path, false)) {
+      return Fault("conflict", "That destination folder already exists");
+    }
+    const bookmarks::BookmarkNode *folder = FindFolder(*path, create);
+    if (!folder) {
+      return Fault("not_found", "Destination folder no longer exists");
+    }
+    int moved = 0;
+    for (const bookmarks::BookmarkNode *node : nodes) {
+      if (node->parent() != folder) {
+        bookmarks_->Move(node, folder, folder->children().size());
+        ++moved;
+      }
+    }
+    base::DictValue result;
+    result.Set("moved", moved);
+    return Result(base::Value(std::move(result)));
+  }
+
+  if (method == "bookmarks.import" || method == "bookmarks.saveFolder") {
+    const base::ListValue *items = params.FindList("bookmarks");
+    if (!items || items->size() > 10000) {
+      return Fault("invalid_params", "Invalid bookmark import");
+    }
+    base::ListValue folder_prefix;
+    if (method == "bookmarks.saveFolder") {
+      const std::string *name = params.FindString("name");
+      if (!name || name->empty() || name->size() > 200) {
+        return Fault("invalid_params", "Invalid folder name");
+      }
+      folder_prefix.Append(*name);
+      if (FindFolder(folder_prefix, false)) {
+        return Fault("conflict", "That folder already exists");
+      }
+    }
+    if (const base::ListValue *folders = params.FindList("folders")) {
+      for (const base::Value &value : *folders) {
+        const base::ListValue *path = value.GetIfList();
+        if (!path || !FindFolder(*path, true)) {
+          return Fault("invalid_params", "Invalid imported folder");
+        }
+      }
+    }
+    int added = 0;
+    for (const base::Value &value : *items) {
+      const base::DictValue *entry = value.GetIfDict();
+      if (!entry) {
+        return Fault("invalid_params", "Invalid bookmark entry");
+      }
+      const std::string *url = entry->FindString("url");
+      const std::string *title = entry->FindString("title");
+      if (!url || !ValidWebUrl(*url) || !title || title->size() > 1000) {
+        return Fault("invalid_params", "Invalid bookmark entry");
+      }
+      if (!bookmarks_->GetNodesByURL(GURL(*url)).empty()) {
+        continue;
+      }
+      const base::ListValue *path = entry->FindList("folderPath");
+      const bookmarks::BookmarkNode *folder =
+          method == "bookmarks.saveFolder" ? FindFolder(folder_prefix, true)
+          : path                           ? FindFolder(*path, true)
+                                           : bookmarks_->bookmark_bar_node();
+      if (!folder) {
+        return Fault("invalid_params", "Invalid imported folder");
+      }
+      bookmarks_->AddNewURL(folder, folder->children().size(),
+                            base::UTF8ToUTF16(*title), GURL(*url));
+      ++added;
+    }
+    base::DictValue result;
+    result.Set("added", added);
+    result.Set("skipped", static_cast<int>(items->size()) - added);
+    return Result(base::Value(std::move(result)));
+  }
+  return Fault("not_found", "Unsupported Chromium bookmark method");
+}
+
+base::DictValue ProfileLibrary::ImportNativeBookmarks(
+    const std::vector<NativeBookmarkImportEntry>& entries,
+    std::map<size_t, base::Uuid>& accepted_folders,
+    base::RepeatingCallback<bool()> current) {
+  if (!bookmarks_ || !bookmarks_->loaded() || !current || entries.size() > 500)
+    return Fault("backend_unavailable", "Native bookmark import is unavailable");
+  int added = 0, skipped = 0;
+  bool retired = false;
+  for (const auto& entry : entries) {
+    if (!current.Run()) { retired = true; break; }
+    const bookmarks::BookmarkNode* parent = bookmarks_->bookmark_bar_node();
+    if (entry.parent_source_id) {
+      auto found = accepted_folders.find(entry.parent_source_id);
+      parent = found == accepted_folders.end() ? nullptr : bookmarks_->GetNodeByUuid(
+          found->second, bookmarks::BookmarkModel::NodeTypeForUuidLookup::kLocalOrSyncableNodes);
+    }
+    if (!parent || !parent->is_folder() || entry.title.size() > 1000 ||
+        !entry.source_id || entry.source_id == entry.parent_source_id) {
+      retired = true;
+      break;
+    }
+    if (entry.url.is_empty()) {
+      if (accepted_folders.contains(entry.source_id)) { retired = true; break; }
+      const auto* folder = bookmarks_->AddFolder(parent, parent->children().size(), entry.title);
+      accepted_folders.emplace(entry.source_id, folder->uuid());
+    } else if (!ValidWebUrl(entry.url.spec())) {
+      ++skipped;
+    } else if (!bookmarks_->GetNodesByURL(entry.url).empty()) {
+      ++skipped;
+    } else {
+      bookmarks_->AddNewURL(parent, parent->children().size(), entry.title, entry.url);
+      ++added;
+    }
+  }
+  base::DictValue result;
+  result.Set("added", added);
+  result.Set("skipped", skipped);
+  result.Set("retired", retired);
+  return Result(base::Value(std::move(result)));
+}
+
+void ProfileLibrary::ImportHistory(
+    const base::DictValue &params,
+    base::OnceCallback<void(base::DictValue)> callback,
+    base::RepeatingCallback<bool()> dispatch_guard) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const base::ListValue *rows = params.FindList("visits");
+  if (!rows || rows->empty() || rows->size() > 500) {
+    std::move(callback).Run(Fault("invalid_params", "Invalid history import batch"));
+    return;
+  }
+  auto state = std::make_shared<HistoryImportState>();
+  state->dispatch_guard = std::move(dispatch_guard);
+  state->visits.reserve(rows->size());
+  for (const base::Value &value : *rows) {
+    const base::DictValue *row = value.GetIfDict();
+    const std::string *url = row ? row->FindString("url") : nullptr;
+    const std::string *title = row ? row->FindString("title") : nullptr;
+    const std::optional<double> at = row ? row->FindDouble("visitedAt")
+                                          : std::nullopt;
+    if (!url || !ValidWebUrl(*url) || !title || title->size() > 1000 ||
+        !at || !std::isfinite(*at) || *at < 0 ||
+        *at > static_cast<double>((base::Time::Now() + base::Days(1))
+                                      .InMillisecondsSinceUnixEpoch())) {
+      std::move(callback).Run(Fault("invalid_params", "Invalid history visit"));
+      return;
+    }
+    state->visits.push_back({*url, *title, static_cast<int64_t>(*at)});
+  }
+  state->reply = std::move(callback);
+  ImportHistoryNext(state);
+}
+
+void ProfileLibrary::ImportHistoryNext(
+    std::shared_ptr<HistoryImportState> state) {
+  if (!state->authority_retired && state->dispatch_guard &&
+      !state->dispatch_guard.Run()) {
+    state->authority_retired = true;
+    state->next = state->visits.size();
+  }
+  if (!history_) {
+    std::move(state->reply).Run(
+        Fault("backend_unavailable", "Chromium HistoryService closed"));
+    return;
+  }
+  if (state->next == state->visits.size()) {
+    if (!state->last_added) {
+      base::DictValue result;
+      result.Set("added", state->added);
+      result.Set("skipped", state->skipped);
+      if (state->dispatch_guard) result.Set("retired", state->authority_retired);
+      std::move(state->reply).Run(Result(base::Value(std::move(result))));
+      return;
+    }
+    // A final query is a backend queue barrier. Do not report success before
+    // the last imported visit can be read from this Profile's HistoryService.
+    const Visit last = *state->last_added;
+    history_->QueryURLAndVisits(
+        GURL(last.url), history::VisitQuery404sPolicy::kInclude404s,
+        base::BindOnce(
+            [](base::WeakPtr<ProfileLibrary> self,
+               std::shared_ptr<HistoryImportState> state, Visit last,
+               history::QueryURLAndVisitsResult query) {
+              if (!self || !self->history_ || !query.success ||
+                  !std::any_of(query.visits.begin(), query.visits.end(),
+                               [&](const history::VisitRow &visit) {
+                                 return visit.visit_time.InMillisecondsSinceUnixEpoch() ==
+                                        last.visited_at;
+                               })) {
+                std::move(state->reply).Run(Fault(
+                    "backend_unavailable", "Imported history was not confirmed"));
+                return;
+              }
+              base::DictValue result;
+              result.Set("added", state->added);
+              result.Set("skipped", state->skipped);
+      if (state->dispatch_guard) result.Set("retired", state->authority_retired);
+              std::move(state->reply).Run(Result(base::Value(std::move(result))));
+            },
+            import_weak_factory_.GetWeakPtr(), state, last),
+        &tracker_);
+    return;
+  }
+  const Visit visit = state->visits[state->next++];
+  const auto identity = std::make_pair(visit.url, visit.visited_at);
+  if (state->dispatched.contains(identity)) {
+    ++state->skipped;
+    ImportHistoryNext(state);
+    return;
+  }
+  history_->QueryURLAndVisits(
+      GURL(visit.url), history::VisitQuery404sPolicy::kInclude404s,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self,
+             std::shared_ptr<HistoryImportState> state, Visit visit,
+             history::QueryURLAndVisitsResult query) {
+            if (!self || !self->history_) {
+              std::move(state->reply).Run(Fault(
+                  "backend_unavailable", "Chromium HistoryService closed"));
+              return;
+            }
+            if (state->dispatch_guard && !state->dispatch_guard.Run()) {
+              state->authority_retired = true;
+              state->next = state->visits.size();
+              self->ImportHistoryNext(state);
+              return;
+            }
+            const bool exists = query.success &&
+                std::any_of(query.visits.begin(), query.visits.end(),
+                            [&](const history::VisitRow &row) {
+                              return row.visit_time.InMillisecondsSinceUnixEpoch() ==
+                                     visit.visited_at;
+                            });
+            if (exists) {
+              ++state->skipped;
+            } else {
+              const GURL url(visit.url);
+              self->history_->AddPage(
+                  url, base::Time::FromMillisecondsSinceUnixEpoch(
+                           visit.visited_at),
+                  history::SOURCE_OS_MIGRATION_IMPORTED);
+              self->history_->SetPageTitle(url, base::UTF8ToUTF16(visit.title));
+              state->dispatched.insert({visit.url, visit.visited_at});
+              state->last_added = visit;
+              ++state->added;
+            }
+            self->ImportHistoryNext(state);
+          },
+          import_weak_factory_.GetWeakPtr(), state, visit),
+      &tracker_);
+}
+
+void ProfileLibrary::HistoryCall(
+    const std::string& method,
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback,
+    base::RepeatingCallback<bool()> current) {
+  if (!history_ || !current.Run()) {
+    std::move(callback).Run(
+        Fault("ref_stale", "Original history window is unavailable"));
+    return;
+  }
+  if (method == "history.clear") {
+    ClearHistory(params, std::move(callback), std::move(current));
+    return;
+  }
+  if (method == "history.remove") {
+    RemoveVisit(params, std::move(callback), std::move(current));
+    return;
+  }
+  const bool list = method == "history.list";
+  if (!list && method != "history.count") {
+    std::move(callback).Run(
+        Fault("unsupported", "Unknown native history method"));
+    return;
+  }
+  history_->ScheduleDBTask(FROM_HERE,
+                           std::make_unique<HistoryReadTask>(
+                               params,
+                               list ? std::make_optional<size_t>(
+                                          params.FindInt("limit").value_or(100))
+                                    : std::nullopt,
+                               std::move(callback)),
+                           &tracker_);
+}
+
+void ProfileLibrary::ClearHistory(
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback,
+    base::RepeatingCallback<bool()> current) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const auto since = params.FindDouble("since"),
+             before = params.FindDouble("before");
+  if ((since && (!std::isfinite(*since) || *since < 0)) ||
+      (before && (!std::isfinite(*before) || *before < 0)) ||
+      (since && before && *since > *before)) {
+    std::move(callback).Run(Fault("invalid_params", "Invalid history range"));
+    return;
+  }
+  const auto begin =
+      base::Time::FromMillisecondsSinceUnixEpoch(std::ceil(since.value_or(0)));
+  const auto end =
+      before ? base::Time::FromMillisecondsSinceUnixEpoch(std::ceil(*before))
+             : base::Time();
+  history_->ScheduleDBTask(
+      FROM_HERE,
+      std::make_unique<HistoryReadTask>(
+          params, std::nullopt,
+          base::BindOnce(
+              [](base::WeakPtr<ProfileLibrary> self, base::Time begin,
+                 base::Time end, base::RepeatingCallback<bool()> current,
+                 base::OnceCallback<void(base::DictValue)> callback,
+                 base::DictValue counted) {
+                if (!self || !self->history_ || (current && !current.Run())) {
+                  std::move(callback).Run(Fault(
+                      "ref_stale", "Original history owner is unavailable"));
+                  return;
+                }
+                const auto* result = counted.FindDict("result");
+                const auto count =
+                    result ? result->FindDouble("count") : std::nullopt;
+                if (!count) {
+                  std::move(callback).Run(std::move(counted));
+                  return;
+                }
+                self->history_->ExpireHistoryBetween(
+                    {}, std::nullopt, begin, end, true,
+                    base::BindOnce(
+                        [](base::OnceCallback<void(base::DictValue)> callback,
+                           double count) {
+                          base::DictValue result;
+                          result.Set("removed", count);
+                          std::move(callback).Run(
+                              Result(base::Value(std::move(result))));
+                        },
+                        std::move(callback), *count),
+                    &self->tracker_);
+              },
+              history_weak_factory_.GetWeakPtr(), begin, end,
+              std::move(current), std::move(callback))),
+      &tracker_);
+}
+
+void ProfileLibrary::RemoveVisit(
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback,
+    base::RepeatingCallback<bool()> current) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const std::string *url = params.FindString("url");
+  const std::string *expected_title = params.FindString("expectedTitle");
+  const std::optional<double> at = params.FindDouble("visitedAt");
+  if (!url || !ValidWebUrl(*url) || !at || !std::isfinite(*at) || *at < 0) {
+    std::move(callback).Run(Fault("invalid_params", "Invalid history visit"));
+    return;
+  }
+  if (*at != std::floor(*at)) {
+    base::DictValue result;
+    result.Set("removed", false);
+    std::move(callback).Run(Result(base::Value(std::move(result))));
+    return;
+  }
+  const base::Time begin = base::Time::FromMillisecondsSinceUnixEpoch(*at);
+  const base::Time end = begin + base::Milliseconds(1);
+  history::QueryOptions options;
+  options.begin_time = begin;
+  options.end_time = end;
+  options.duplicate_policy = history::QueryOptions::KEEP_ALL_DUPLICATES;
+  options.policy_for_404_visits = history::VisitQuery404sPolicy::kInclude404s;
+  history_->QueryHistory(
+      u"", options,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self, GURL url, base::Time begin,
+             base::Time end, std::optional<std::string> expected_title,
+             base::RepeatingCallback<bool()> current,
+             base::OnceCallback<void(base::DictValue)> callback,
+             history::QueryResults rows) {
+            if (!self || !self->history_) {
+              std::move(callback).Run(
+                  Fault("backend_unavailable", "HistoryService closed"));
+              return;
+            }
+            if (current && !current.Run()) {
+              std::move(callback).Run(
+                  Fault("ref_stale", "Original history window is unavailable"));
+              return;
+            }
+            const int matching = std::count_if(
+                rows.begin(), rows.end(), [&](const history::URLResult& row) {
+                  return row.url() == url &&
+                         row.visit_time().InMillisecondsSinceUnixEpoch() ==
+                             begin.InMillisecondsSinceUnixEpoch();
+                });
+            const bool found =
+                (expected_title ? matching == 1 : matching > 0) &&
+                std::any_of(
+                    rows.begin(), rows.end(),
+                    [&](const history::URLResult& row) {
+                      return row.url() == url &&
+                             row.visit_time().InMillisecondsSinceUnixEpoch() ==
+                                 begin.InMillisecondsSinceUnixEpoch() &&
+                             (!expected_title ||
+                              base::UTF16ToUTF8(row.title()) ==
+                                  *expected_title);
+                    });
+            if (!found) {
+              base::DictValue result;
+              result.Set("removed", false);
+              std::move(callback).Run(Result(base::Value(std::move(result))));
+              return;
+            }
+            self->history_->ExpireHistoryBetween(
+                {url}, std::nullopt, begin, end, true,
+                base::BindOnce(
+                    [](base::OnceCallback<void(base::DictValue)> callback) {
+                      base::DictValue result;
+                      result.Set("removed", true);
+                      std::move(callback).Run(
+                          Result(base::Value(std::move(result))));
+                    },
+                    std::move(callback)),
+                &self->tracker_);
+          },
+          history_weak_factory_.GetWeakPtr(), GURL(*url), begin, end,
+          expected_title ? std::make_optional(*expected_title) : std::nullopt,
+          std::move(current), std::move(callback)),
+      &tracker_);
+}
+
