+std::vector<std::pair<const bookmarks::BookmarkNode *, std::string>>
+ProfileLibrary::RootAliases() const {
+  std::vector<std::pair<const bookmarks::BookmarkNode *, std::string>> roots;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return roots;
+  }
+  std::set<std::string> used;
+  for (const auto &child : bookmarks_->bookmark_bar_node()->children()) {
+    if (child->is_folder()) {
+      used.insert(base::UTF16ToUTF8(child->GetTitle()));
+    }
+  }
+  auto add = [&](const bookmarks::BookmarkNode *root,
+                 const std::string &preferred) {
+    if (!root) {
+      return;
+    }
+    std::string label = preferred;
+    for (int suffix = 2; used.contains(label); ++suffix) {
+      label = preferred + " (" + base::NumberToString(suffix) + ")";
+    }
+    used.insert(label);
+    roots.emplace_back(root, std::move(label));
+  };
+  add(bookmarks_->other_node(), "Other bookmarks");
+  add(bookmarks_->mobile_node(), "Mobile bookmarks");
+  add(bookmarks_->account_bookmark_bar_node(), "Account bookmarks");
+  add(bookmarks_->account_other_node(), "Account other bookmarks");
+  add(bookmarks_->account_mobile_node(), "Account mobile bookmarks");
+  return roots;
+}
+
+base::ListValue ProfileLibrary::ListBookmarks() const {
+  base::ListValue result;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return result;
+  }
+  auto walk = [&](auto &&self, const bookmarks::BookmarkNode *node,
+                  const base::ListValue &path) -> void {
+    for (const auto &child : node->children()) {
+      if (child->is_folder()) {
+        base::ListValue next = path.Clone();
+        next.Append(base::UTF16ToUTF8(child->GetTitle()));
+        self(self, child.get(), next);
+        continue;
+      }
+      if (!child->url().SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      base::DictValue bookmark;
+      bookmark.Set("nodeId", base::NumberToString(child->id()));
+      bookmark.Set("url", child->url().spec());
+      bookmark.Set("title", base::UTF16ToUTF8(child->GetTitle()));
+      bookmark.Set("folderPath", path.Clone());
+      bookmark.Set("createdAt",
+                   static_cast<double>(
+                       child->date_added().InMillisecondsSinceUnixEpoch()));
+      std::string meta;
+      if (child->GetMetaInfo(kReadingListKey, &meta) && meta == "1") {
+        bookmark.Set("readingList", true);
+        if (child->GetMetaInfo(kReadAtKey, &meta)) {
+          int64_t read_at = 0;
+          if (base::StringToInt64(meta, &read_at) && read_at > 0) {
+            bookmark.Set("readAt", static_cast<double>(read_at));
+          }
+        }
+      }
+      result.Append(std::move(bookmark));
+    }
+  };
+  walk(walk, bookmarks_->bookmark_bar_node(), base::ListValue());
+  for (const auto &[root, name] : RootAliases()) {
+    base::ListValue path;
+    path.Append(name);
+    walk(walk, root, path);
+  }
+  return result;
+}
+
+base::ListValue ProfileLibrary::ListFolders() const {
+  base::ListValue result;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return result;
+  }
+  auto walk = [&](auto &&self, const bookmarks::BookmarkNode *node,
+                  const base::ListValue &path) -> void {
+    for (const auto &child : node->children()) {
+      if (!child->is_folder()) {
+        continue;
+      }
+      base::ListValue next = path.Clone();
+      next.Append(base::UTF16ToUTF8(child->GetTitle()));
+      result.Append(next.Clone());
+      self(self, child.get(), next);
+    }
+  };
+  walk(walk, bookmarks_->bookmark_bar_node(), base::ListValue());
+  for (const auto &[root, name] : RootAliases()) {
+    base::ListValue path;
+    path.Append(name);
+    result.Append(path.Clone());
+    walk(walk, root, path);
+  }
+  return result;
+}
+
+const bookmarks::BookmarkNode *
+ProfileLibrary::FindFolder(const base::ListValue &path, bool create) {
+  if (!bookmarks_ || !bookmarks_->loaded() || path.size() > 32) {
+    return nullptr;
+  }
+  const bookmarks::BookmarkNode *node = bookmarks_->bookmark_bar_node();
+  size_t offset = 0;
+  if (!path.empty() && path.front().is_string()) {
+    const std::string &first = path.front().GetString();
+    for (const auto &[root, name] : RootAliases()) {
+      if (first == name) {
+        node = root;
+        offset = 1;
+        break;
+      }
+    }
+  }
+  if (!node) {
+    return nullptr;
+  }
+  for (size_t index = offset; index < path.size(); ++index) {
+    if (!IsFolderName(path[index])) {
+      return nullptr;
+    }
+    const std::u16string title = base::UTF8ToUTF16(path[index].GetString());
+    const bookmarks::BookmarkNode *found = nullptr;
+    for (const auto &child : node->children()) {
+      if (child->is_folder() && child->GetTitle() == title) {
+        found = child.get();
+        break;
+      }
+    }
+    if (!found && create) {
+      found = bookmarks_->AddFolder(node, node->children().size(), title);
+    }
+    if (!found) {
+      return nullptr;
+    }
+    node = found;
+  }
+  return node;
+}
+
+const bookmarks::BookmarkNode *
+ProfileLibrary::FindBookmark(const base::DictValue &params,
+                             const std::string &url_key) const {
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return nullptr;
+  }
+  const std::string *node_id = params.FindString("nodeId");
+  const std::string *url = params.FindString(url_key);
+  if (!url || !ValidWebUrl(*url)) {
+    return nullptr;
+  }
+  const auto candidates = bookmarks_->GetNodesByURL(GURL(*url));
+  if (node_id) {
+    int64_t id = 0;
+    if (!base::StringToInt64(*node_id, &id)) {
+      return nullptr;
+    }
+    for (const auto &candidate : candidates) {
+      if (candidate->id() == id) {
+        return candidate;
+      }
+    }
+    return nullptr;
+  }
+  // Legacy callers identify a bookmark by URL. Prefer the most recent user
+  // node; explicit Library edits carry nodeId and never affect another copy.
+  return bookmarks_->GetMostRecentlyAddedUserNodeForURL(GURL(*url));
+}
+
+base::ListValue
+ProfileLibrary::FolderPath(const bookmarks::BookmarkNode *node) const {
+  std::vector<std::string> names;
+  const bookmarks::BookmarkNode *parent = node->parent();
+  while (parent && !bookmarks_->is_permanent_node(parent)) {
+    names.push_back(base::UTF16ToUTF8(parent->GetTitle()));
+    parent = parent->parent();
+  }
+  for (const auto &[root, name] : RootAliases()) {
+    if (parent == root) {
+      names.push_back(name);
+      break;
+    }
+  }
+  base::ListValue path;
+  for (auto it = names.rbegin(); it != names.rend(); ++it) {
+    path.Append(*it);
+  }
+  return path;
+}
+
+base::DictValue
+ProfileLibrary::BookmarkCall(const std::string &method,
+                             const base::DictValue &params) {
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return Fault("backend_unavailable", "Chromium bookmarks are still loading");
+  }
+  if (method == "bookmarks.list") {
+    return Result(base::Value(ListBookmarks()));
+  }
+  if (method == "bookmarks.folders.list") {
+    return Result(base::Value(ListFolders()));
+  }
+
+  if (method == "bookmarks.folders.create" ||
+      method == "bookmarks.folders.rename" ||
+      method == "bookmarks.folders.remove") {
+    const base::ListValue *path = params.FindList("path");
+    if (!path || path->empty() || path->size() > 32) {
+      return Fault("invalid_argument", "Choose a bookmark folder");
+    }
+    if (method == "bookmarks.folders.create") {
+      if (FindFolder(*path, false)) {
+        return Fault("conflict", "That folder already exists");
+      }
+      base::ListValue parent_path = path->Clone();
+      const std::string *name = parent_path.back().GetIfString();
+      if (!name || name->empty() || name->size() > 200) {
+        return Fault("invalid_argument", "Invalid folder name");
+      }
+      const std::string title = *name;
+      parent_path.erase(parent_path.end() - 1);
+      const bookmarks::BookmarkNode *parent = FindFolder(parent_path, false);
+      if (!parent) {
+        return Fault("not_found", "Parent folder no longer exists");
+      }
+      bookmarks_->AddFolder(parent, parent->children().size(),
+                            base::UTF8ToUTF16(title));
+    } else {
+      const bookmarks::BookmarkNode *folder = FindFolder(*path, false);
+      if (!folder || bookmarks_->is_permanent_node(folder)) {
+        return Fault("not_found", "Folder no longer exists");
+      }
+      if (method == "bookmarks.folders.rename") {
+        const std::string *name = params.FindString("name");
+        if (!name || name->empty() || name->size() > 200) {
+          return Fault("invalid_argument", "Invalid folder name");
+        }
+        for (const auto &sibling : folder->parent()->children()) {
+          if (sibling.get() != folder && sibling->is_folder() &&
+              sibling->GetTitle() == base::UTF8ToUTF16(*name)) {
+            return Fault("conflict", "That folder already exists");
+          }
+        }
+        bookmarks_->SetTitle(folder, base::UTF8ToUTF16(*name),
+                             bookmarks::metrics::BookmarkEditSource::kUser);
+      } else {
+        if (!folder->children().empty()) {
+          return Fault("conflict", "Remove the folder's bookmarks first");
+        }
+        bookmarks_->Remove(
+            folder, bookmarks::metrics::BookmarkEditSource::kUser, FROM_HERE);
+      }
+    }
+    return Result(base::Value(ListFolders()));
+  }
+
+  if (method == "bookmarks.add" || method == "bookmarks.readingList") {
+    const std::string *url = params.FindString("url");
+    if (!url || !ValidWebUrl(*url)) {
+      return Fault("invalid_argument", "Invalid bookmark address");
+    }
+    const bookmarks::BookmarkNode *node =
+        params.FindBool("forceNew").value_or(false) && method == "bookmarks.add"
+            ? nullptr
+            : FindBookmark(params, "url");
+    if (!node) {
+      if (method == "bookmarks.readingList" &&
+          !params.FindBool("readingList").value_or(false)) {
+        return Okay();
+      }
+      const std::string *title = params.FindString("title");
+      if (!title || title->size() > 1000) {
+        return Fault("invalid_argument", "A title is required");
+      }
+      const base::ListValue *path = params.FindList("folderPath");
+      const bookmarks::BookmarkNode *folder =
+          path ? FindFolder(*path, true) : bookmarks_->bookmark_bar_node();
+      if (!folder) {
+        return Fault("invalid_argument", "Invalid bookmark folder");
+      }
+      node = bookmarks_->AddNewURL(folder, folder->children().size(),
+                                   base::UTF8ToUTF16(*title), GURL(*url));
+    } else if (method == "bookmarks.add") {
+      if (const std::string *title = params.FindString("title")) {
+        bookmarks_->SetTitle(node, base::UTF8ToUTF16(*title),
+                             bookmarks::metrics::BookmarkEditSource::kUser);
+      }
+      if (const base::ListValue *path = params.FindList("folderPath")) {
+        const bookmarks::BookmarkNode *folder = FindFolder(*path, true);
+        if (!folder) {
+          return Fault("invalid_argument", "Invalid bookmark folder");
+        }
+        if (folder != node->parent()) {
+          bookmarks_->Move(node, folder, folder->children().size());
+        }
+      }
+    }
+    if (std::optional<bool> reading = params.FindBool("readingList")) {
+      bookmarks_->SetNodeMetaInfo(node, kReadingListKey, *reading ? "1" : "0");
+      if (!*reading) {
+        bookmarks_->DeleteNodeMetaInfo(node, kReadAtKey);
+      }
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.markRead") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "url");
+    std::string reading;
+    if (!node || !node->GetMetaInfo(kReadingListKey, &reading) ||
+        reading != "1") {
+      return Fault("not_found", "This page is not on the reading list");
+    }
+    if (params.FindBool("read").value_or(false)) {
+      bookmarks_->SetNodeMetaInfo(
+          node, kReadAtKey,
+          base::NumberToString(
+              base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    } else {
+      bookmarks_->DeleteNodeMetaInfo(node, kReadAtKey);
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.remove") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "url");
+    if (const base::DictValue *expected = params.FindDict("expected")) {
+      const std::string *title = expected->FindString("title");
+      std::optional<double> created_at = expected->FindDouble("createdAt");
+      if (!node || !title || !created_at ||
+          base::UTF16ToUTF8(node->GetTitle()) != *title ||
+          static_cast<double>(
+              node->date_added().InMillisecondsSinceUnixEpoch()) !=
+              *created_at) {
+        return Fault("conflict", "This bookmark changed since the run");
+      }
+      if (const base::ListValue *folder = expected->FindList("folderPath")) {
+        if (FolderPath(node) != *folder) {
+          return Fault("conflict", "This bookmark moved since the run");
+        }
+      }
+      if (std::optional<bool> reading = expected->FindBool("readingList")) {
+        std::string meta;
+        const bool current = node->GetMetaInfo(kReadingListKey, &meta) &&
+                             meta == "1";
+        if (current != *reading) {
+          return Fault("conflict", "This bookmark changed reading-list state");
+        }
+      }
+    }
+    if (node) {
+      bookmarks_->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                         FROM_HERE);
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.update") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "originalUrl");
+    if (!node) {
+      return Fault("not_found", "This bookmark was removed");
+    }
+    const base::DictValue *expected = params.FindDict("expected");
+    const std::string *title = params.FindString("title");
+    const std::string *url = params.FindString("url");
+    const base::ListValue *path = params.FindList("folderPath");
+    if (!expected || !title || title->empty() || title->size() > 1000 || !url ||
+        !ValidWebUrl(*url)) {
+      return Fault("invalid_argument", "Invalid bookmark edit");
+    }
+    const std::string *old_title = expected->FindString("title");
+    const base::ListValue *old_path = expected->FindList("folderPath");
+    if (!old_title || base::UTF16ToUTF8(node->GetTitle()) != *old_title ||
+        (old_path && FolderPath(node) != *old_path)) {
+      return Fault("conflict", "Bookmark changed in another window");
+    }
+    const bookmarks::BookmarkNode *folder =
+        path ? FindFolder(*path, false) : node->parent();
+    if (!folder) {
+      return Fault("not_found", "Destination folder no longer exists");
+    }
+    if (node->url().spec() != *url) {
+      for (const auto &duplicate : bookmarks_->GetNodesByURL(GURL(*url))) {
+        if (duplicate != node) {
+          return Fault("conflict", "That address is already bookmarked");
+        }
+      }
+    }
+    bookmarks_->SetTitle(node, base::UTF8ToUTF16(*title),
+                         bookmarks::metrics::BookmarkEditSource::kUser);
+    if (node->url().spec() != *url) {
+      bookmarks_->SetURL(node, GURL(*url),
+                         bookmarks::metrics::BookmarkEditSource::kUser);
+    }
+    if (folder != node->parent()) {
+      bookmarks_->Move(node, folder, folder->children().size());
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.move") {
+    const base::ListValue *selections = params.FindList("bookmarks");
+    const base::ListValue *path = params.FindList("folderPath");
+    if (!selections || !path || selections->empty() ||
+        selections->size() > 10000) {
+      return Fault("invalid_argument", "Invalid bookmark selection");
+    }
+    std::vector<const bookmarks::BookmarkNode *> nodes;
+    nodes.reserve(selections->size());
+    for (const base::Value &item : *selections) {
+      const base::DictValue *entry = item.GetIfDict();
+      const bookmarks::BookmarkNode *node =
+          entry ? FindBookmark(*entry, "url") : nullptr;
+      const base::ListValue *expected =
+          entry ? entry->FindList("folderPath") : nullptr;
+      if (!node || !expected || FolderPath(node) != *expected) {
+        return Fault("conflict", "A selected bookmark moved or was removed");
+      }
+      nodes.push_back(node);
+    }
+    const bool create = params.FindBool("createFolder").value_or(false);
+    if (create && FindFolder(*path, false)) {
+      return Fault("conflict", "That destination folder already exists");
+    }
+    const bookmarks::BookmarkNode *folder = FindFolder(*path, create);
+    if (!folder) {
+      return Fault("not_found", "Destination folder no longer exists");
+    }
+    int moved = 0;
+    for (const bookmarks::BookmarkNode *node : nodes) {
+      if (node->parent() != folder) {
+        bookmarks_->Move(node, folder, folder->children().size());
+        ++moved;
+      }
+    }
+    base::DictValue result;
+    result.Set("moved", moved);
+    return Result(base::Value(std::move(result)));
+  }
+
+  if (method == "bookmarks.import" || method == "bookmarks.saveFolder") {
+    const base::ListValue *items = params.FindList("bookmarks");
+    if (!items || items->size() > 10000) {
+      return Fault("invalid_argument", "Invalid bookmark import");
+    }
+    base::ListValue folder_prefix;
+    if (method == "bookmarks.saveFolder") {
+      const std::string *name = params.FindString("name");
+      if (!name || name->empty() || name->size() > 200) {
+        return Fault("invalid_argument", "Invalid folder name");
+      }
+      folder_prefix.Append(*name);
+      if (FindFolder(folder_prefix, false)) {
+        return Fault("conflict", "That folder already exists");
+      }
+    }
+    if (const base::ListValue *folders = params.FindList("folders")) {
+      for (const base::Value &value : *folders) {
+        const base::ListValue *path = value.GetIfList();
+        if (!path || !FindFolder(*path, true)) {
+          return Fault("invalid_argument", "Invalid imported folder");
+        }
+      }
+    }
+    int added = 0;
+    for (const base::Value &value : *items) {
+      const base::DictValue *entry = value.GetIfDict();
+      if (!entry) {
+        return Fault("invalid_argument", "Invalid bookmark entry");
+      }
+      const std::string *url = entry->FindString("url");
+      const std::string *title = entry->FindString("title");
+      if (!url || !ValidWebUrl(*url) || !title || title->size() > 1000) {
+        return Fault("invalid_argument", "Invalid bookmark entry");
+      }
+      if (!bookmarks_->GetNodesByURL(GURL(*url)).empty()) {
+        continue;
+      }
+      const base::ListValue *path = entry->FindList("folderPath");
+      const bookmarks::BookmarkNode *folder =
+          method == "bookmarks.saveFolder" ? FindFolder(folder_prefix, true)
+          : path                           ? FindFolder(*path, true)
+                                           : bookmarks_->bookmark_bar_node();
+      if (!folder) {
+        return Fault("invalid_argument", "Invalid imported folder");
+      }
+      bookmarks_->AddNewURL(folder, folder->children().size(),
+                            base::UTF8ToUTF16(*title), GURL(*url));
+      ++added;
+    }
+    base::DictValue result;
+    result.Set("added", added);
+    result.Set("skipped", static_cast<int>(items->size()) - added);
+    return Result(base::Value(std::move(result)));
+  }
+  return Fault("not_found", "Unsupported Chromium bookmark method");
+}
+
+void ProfileLibrary::ImportHistory(
+    const base::DictValue &params,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const base::ListValue *rows = params.FindList("visits");
+  if (!rows || rows->empty() || rows->size() > 500) {
+    std::move(callback).Run(Fault("invalid_argument", "Invalid history import batch"));
+    return;
+  }
+  auto state = std::make_shared<HistoryImportState>();
+  state->visits.reserve(rows->size());
+  for (const base::Value &value : *rows) {
+    const base::DictValue *row = value.GetIfDict();
+    const std::string *url = row ? row->FindString("url") : nullptr;
+    const std::string *title = row ? row->FindString("title") : nullptr;
+    const std::optional<double> at = row ? row->FindDouble("visitedAt")
+                                          : std::nullopt;
+    if (!url || !ValidWebUrl(*url) || !title || title->size() > 1000 ||
+        !at || !std::isfinite(*at) || *at < 0 ||
+        *at > static_cast<double>((base::Time::Now() + base::Days(1))
+                                      .InMillisecondsSinceUnixEpoch())) {
+      std::move(callback).Run(Fault("invalid_argument", "Invalid history visit"));
+      return;
+    }
+    state->visits.push_back({*url, *title, static_cast<int64_t>(*at)});
+  }
+  state->reply = std::move(callback);
+  ImportHistoryNext(state);
+}
+
+void ProfileLibrary::ImportHistoryNext(
+    std::shared_ptr<HistoryImportState> state) {
+  if (!history_) {
+    std::move(state->reply).Run(
+        Fault("backend_unavailable", "Chromium HistoryService closed"));
+    return;
+  }
+  if (state->next == state->visits.size()) {
+    if (!state->last_added) {
+      base::DictValue result;
+      result.Set("added", state->added);
+      result.Set("skipped", state->skipped);
+      std::move(state->reply).Run(Result(base::Value(std::move(result))));
+      return;
+    }
+    // A final query is a backend queue barrier. Do not report success before
+    // the last imported visit can be read from this Profile's HistoryService.
+    const Visit last = *state->last_added;
+    history_->QueryURLAndVisits(
+        GURL(last.url), history::VisitQuery404sPolicy::kInclude404s,
+        base::BindOnce(
+            [](base::WeakPtr<ProfileLibrary> self,
+               std::shared_ptr<HistoryImportState> state, Visit last,
+               history::QueryURLAndVisitsResult query) {
+              if (!self || !self->history_ || !query.success ||
+                  !std::any_of(query.visits.begin(), query.visits.end(),
+                               [&](const history::VisitRow &visit) {
+                                 return visit.visit_time.InMillisecondsSinceUnixEpoch() ==
+                                        last.visited_at;
+                               })) {
+                std::move(state->reply).Run(Fault(
+                    "backend_unavailable", "Imported history was not confirmed"));
+                return;
+              }
+              base::DictValue result;
+              result.Set("added", state->added);
+              result.Set("skipped", state->skipped);
+              std::move(state->reply).Run(Result(base::Value(std::move(result))));
+            },
+            weak_factory_.GetWeakPtr(), state, last),
+        &tracker_);
+    return;
+  }
+  const Visit visit = state->visits[state->next++];
+  const auto identity = std::make_pair(visit.url, visit.visited_at);
+  if (state->dispatched.contains(identity)) {
+    ++state->skipped;
+    ImportHistoryNext(state);
+    return;
+  }
+  history_->QueryURLAndVisits(
+      GURL(visit.url), history::VisitQuery404sPolicy::kInclude404s,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self,
+             std::shared_ptr<HistoryImportState> state, Visit visit,
+             history::QueryURLAndVisitsResult query) {
+            if (!self || !self->history_) {
+              std::move(state->reply).Run(Fault(
+                  "backend_unavailable", "Chromium HistoryService closed"));
+              return;
+            }
+            const bool exists = query.success &&
+                std::any_of(query.visits.begin(), query.visits.end(),
+                            [&](const history::VisitRow &row) {
+                              return row.visit_time.InMillisecondsSinceUnixEpoch() ==
+                                     visit.visited_at;
+                            });
+            if (exists) {
+              ++state->skipped;
+            } else {
+              const GURL url(visit.url);
+              self->history_->AddPage(
+                  url, base::Time::FromMillisecondsSinceUnixEpoch(
+                           visit.visited_at),
+                  history::SOURCE_OS_MIGRATION_IMPORTED);
+              self->history_->SetPageTitle(url, base::UTF8ToUTF16(visit.title));
+              state->dispatched.insert({visit.url, visit.visited_at});
+              state->last_added = visit;
+              ++state->added;
+            }
+            self->ImportHistoryNext(state);
+          },
+          weak_factory_.GetWeakPtr(), state, visit),
+      &tracker_);
+}
+
+void ProfileLibrary::ClearHistory(
+    const base::DictValue &params,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const std::optional<double> since = params.FindDouble("since");
+  const std::optional<double> before = params.FindDouble("before");
+  if ((since && (*since < 0 || !std::isfinite(*since))) ||
+      (before && (*before < 0 || !std::isfinite(*before)))) {
+    std::move(callback).Run(Fault("invalid_argument", "Invalid history range"));
+    return;
+  }
+  const base::Time begin = since ? base::Time::FromMillisecondsSinceUnixEpoch(
+                                       static_cast<int64_t>(*since))
+                                 : base::Time();
+  const base::Time end = before ? base::Time::FromMillisecondsSinceUnixEpoch(
+                                      static_cast<int64_t>(*before))
+                                : base::Time();
+  history::QueryOptions options;
+  options.begin_time = begin;
+  options.end_time = end;
+  options.duplicate_policy = history::QueryOptions::KEEP_ALL_DUPLICATES;
+  options.policy_for_404_visits = history::VisitQuery404sPolicy::kInclude404s;
+  history_->QueryHistory(
+      u"", options,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self, base::Time begin,
+             base::Time end,
+             base::OnceCallback<void(base::DictValue)> callback,
+             history::QueryResults rows) {
+            if (!self || !self->history_) {
+              std::move(callback).Run(
+                  Fault("backend_unavailable", "HistoryService closed"));
+              return;
+            }
+            const int count = static_cast<int>(rows.size());
+            self->history_->ExpireHistoryBetween(
+                {}, std::nullopt, begin, end, true,
+                base::BindOnce(
+                    [](base::OnceCallback<void(base::DictValue)> callback,
+                       int count) {
+                      base::DictValue result;
+                      result.Set("removed", count);
+                      std::move(callback).Run(
+                          Result(base::Value(std::move(result))));
+                    },
+                    std::move(callback), count),
+                &self->tracker_);
+          },
+          weak_factory_.GetWeakPtr(), begin, end, std::move(callback)),
+      &tracker_);
+}
+
+void ProfileLibrary::RemoveVisit(
+    const base::DictValue &params,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const std::string *url = params.FindString("url");
+  const std::string *expected_title = params.FindString("expectedTitle");
+  const std::optional<double> at = params.FindDouble("visitedAt");
+  if (!url || !ValidWebUrl(*url) || !at || !std::isfinite(*at) || *at < 0) {
+    std::move(callback).Run(Fault("invalid_argument", "Invalid history visit"));
+    return;
+  }
+  const base::Time begin =
+      base::Time::FromMillisecondsSinceUnixEpoch(static_cast<int64_t>(*at));
+  const base::Time end = begin + base::Milliseconds(1);
+  history::QueryOptions options;
+  options.begin_time = begin;
+  options.end_time = end;
+  options.duplicate_policy = history::QueryOptions::KEEP_ALL_DUPLICATES;
+  options.policy_for_404_visits = history::VisitQuery404sPolicy::kInclude404s;
+  history_->QueryHistory(
+      u"", options,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self, GURL url, base::Time begin,
+             base::Time end, std::optional<std::string> expected_title,
+             base::OnceCallback<void(base::DictValue)> callback,
+             history::QueryResults rows) {
+            if (!self || !self->history_) {
+              std::move(callback).Run(
+                  Fault("backend_unavailable", "HistoryService closed"));
+              return;
+            }
+            const int matching = std::count_if(
+                rows.begin(), rows.end(), [&](const history::URLResult &row) {
+                  return row.url() == url && row.visit_time() == begin;
+                });
+            const bool found = matching == 1 &&
+                std::any_of(rows.begin(), rows.end(), [&](const history::URLResult &row) {
+                  return row.url() == url && row.visit_time() == begin &&
+                         (!expected_title ||
+                          base::UTF16ToUTF8(row.title()) == *expected_title);
+                });
+            if (!found) {
+              base::DictValue result;
+              result.Set("removed", false);
+              std::move(callback).Run(Result(base::Value(std::move(result))));
+              return;
+            }
+            self->history_->ExpireHistoryBetween(
+                {url}, std::nullopt, begin, end, true,
+                base::BindOnce(
+                    [](base::OnceCallback<void(base::DictValue)> callback) {
+                      base::DictValue result;
+                      result.Set("removed", true);
+                      std::move(callback).Run(
+                          Result(base::Value(std::move(result))));
+                    },
+                    std::move(callback)),
+                &self->tracker_);
+          },
+          weak_factory_.GetWeakPtr(), GURL(*url), begin, end,
+          expected_title ? std::make_optional(*expected_title) : std::nullopt,
+          std::move(callback)),
+      &tracker_);
+}
