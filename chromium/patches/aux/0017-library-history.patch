@@ -49,6 +49,27 @@ const char kMayContainForeignVisits[] = "may_contain_foreign_visits";
 const char kDeleteForeignVisitsUntilId[] = "delete_foreign_visits_until_id";
 const char kKnownToSyncVisitsExist[] = "known_to_sync_visits_exist";
 
+constexpr char kVisibleVisitIdentities[] =
+    " FROM visits v JOIN urls u ON u.id=v.url LEFT JOIN visit_source source ON "
+    "source.id=v.id "
+    "WHERE v.visit_time>=? AND v.visit_time<? "
+    "AND (v.transition & ?) != 0 AND (v.transition & ?) NOT IN (?,?,?) "
+    "AND length(u.url)>0 AND length(u.url)<=8192 "
+    "AND (source.source IS NULL OR source.source!=?) ";
+
+void BindVisibleVisitRange(sql::Statement& statement,
+                           base::Time begin,
+                           base::Time end) {
+  statement.BindTime(0, std::max(begin, base::Time::UnixEpoch()));
+  statement.BindTime(1, end.is_null() ? base::Time::Max() : end);
+  statement.BindInt(2, ui::PAGE_TRANSITION_CHAIN_END);
+  statement.BindInt(3, ui::PAGE_TRANSITION_CORE_MASK);
+  statement.BindInt(4, ui::PAGE_TRANSITION_AUTO_SUBFRAME);
+  statement.BindInt(5, ui::PAGE_TRANSITION_MANUAL_SUBFRAME);
+  statement.BindInt(6, ui::PAGE_TRANSITION_KEYWORD_GENERATED);
+  statement.BindInt(7, SOURCE_ACTOR);
+}
