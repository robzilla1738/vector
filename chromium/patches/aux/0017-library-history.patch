+
+void ProfileLibrary::OnRuntimeAvailable() {
+  if (runtime_available_) {
+    if (!snapshotting_ && !history_ready_) {
+      RefreshHistory();
+    }
+    return;
+  }
+  runtime_available_ = true;
+  RefreshHistory();
+  NotifyBookmarks();
+}
+
+void ProfileLibrary::OnRuntimeDisconnected() {
+  runtime_available_ = false;
+  snapshotting_ = false;
+  history_ready_ = false;
+  delta_in_flight_ = false;
+  snapshot_visits_.clear();
+  pending_deltas_.clear();
+  bookmark_note_pending_ = false;
+  weak_factory_.InvalidateWeakPtrs();
+  NotifyBookmarks();
+}
+
+void ProfileLibrary::RefreshHistory() {
+  if (!runtime_available_ || !history_) {
+    return;
+  }
+  if (snapshotting_) {
+    history_dirty_ = true;
+    return;
+  }
+  history_ready_ = false;
+  pending_deltas_.clear();
+  delta_in_flight_ = false;
+  snapshotting_ = true;
+  history_dirty_ = false;
+  sequence_ = 0;
+  generation_ = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  history::QueryOptions options;
+  options.duplicate_policy = history::QueryOptions::KEEP_ALL_DUPLICATES;
+  options.policy_for_404_visits = history::VisitQuery404sPolicy::kInclude404s;
+  history_->QueryHistory(u"", options,
+                         base::BindOnce(&ProfileLibrary::OnHistoryQuery,
+                                        weak_factory_.GetWeakPtr()),
+                         &tracker_);
+}
+
+void ProfileLibrary::OnHistoryQuery(history::QueryResults results) {
+  if (!snapshotting_ || !runtime_available_) {
+    return;
+  }
+  snapshot_visits_.clear();
+  snapshot_visits_.reserve(results.size());
+  for (const history::URLResult &row : results) {
+    const std::string url = row.url().spec();
+    const int64_t at = row.visit_time().InMillisecondsSinceUnixEpoch();
+    if (url.empty() || url.size() > 8192 || at < 0) {
+      continue;
+    }
+    snapshot_visits_.push_back(
+        {url, base::UTF16ToUTF8(row.title().substr(0, 4096)), at});
+  }
+  SendSnapshotBatch(0, 0);
+}
+
+void ProfileLibrary::SendSnapshotBatch(size_t offset, size_t batch_index) {
+  if (!snapshotting_ || !runtime_available_) {
+    return;
+  }
+  base::ListValue visits;
+  const size_t end =
+      std::min(offset + kHistoryBatchSize, snapshot_visits_.size());
+  for (size_t index = offset; index < end; ++index) {
+    const Visit &visit = snapshot_visits_[index];
+    visits.Append(VisitValue(visit.url, visit.title, visit.visited_at));
+  }
+  base::DictValue request;
+  request.Set("profileId", profile_->GetPath().BaseName().AsUTF8Unsafe());
+  request.Set("sourceGeneration", generation_);
+  request.Set("sequence", static_cast<int>(sequence_));
+  request.Set("batchIndex", static_cast<int>(batch_index));
+  request.Set("complete", end == snapshot_visits_.size());
+  request.Set("visits", std::move(visits));
+  const auto json = base::WriteJson(request);
+  if (!json) {
+    snapshotting_ = false;
+    return;
+  }
+  call_.Run("history.projectSnapshot", *json,
+            base::BindOnce(
+                [](base::WeakPtr<ProfileLibrary> self, size_t end,
+                   size_t batch_index, bool success) {
+                  if (!self || !self->snapshotting_) {
+                    return;
+                  }
+                  if (!success) {
+                    self->snapshotting_ = false;
+                    self->history_ready_ = false;
+                    return;
+                  }
+                  if (end < self->snapshot_visits_.size()) {
+                    self->SendSnapshotBatch(end, batch_index + 1);
+                    return;
+                  }
+                  self->snapshot_visits_.clear();
+                  self->snapshotting_ = false;
+                  if (self->history_dirty_) {
+                    self->RefreshHistory();
+                  } else {
+                    self->history_ready_ = true;
+                    self->FlushDelta();
+                  }
+                },
+                weak_factory_.GetWeakPtr(), end, batch_index));
+}
+
+void ProfileLibrary::EnqueueDelta(base::DictValue delta) {
+  if (!runtime_available_) {
+    return;
+  }
+  if (snapshotting_) {
+    pending_deltas_.push_back(std::move(delta));
+    return;
+  }
+  if (!history_ready_) {
+    history_dirty_ = true;
+    return;
+  }
+  pending_deltas_.push_back(std::move(delta));
+  FlushDelta();
+}
+
+void ProfileLibrary::FlushDelta() {
+  if (!history_ready_ || delta_in_flight_ || pending_deltas_.empty()) {
+    return;
+  }
+  delta_in_flight_ = true;
+  base::DictValue request = pending_deltas_.front().Clone();
+  request.Set("profileId", profile_->GetPath().BaseName().AsUTF8Unsafe());
+  request.Set("sourceGeneration", generation_);
+  request.Set("sequence", static_cast<int>(sequence_ + 1));
+  const auto json = base::WriteJson(request);
+  if (!json) {
+    delta_in_flight_ = false;
+    RefreshHistory();
+    return;
+  }
+  const std::string generation = generation_;
+  call_.Run("history.projectDelta", *json,
+            base::BindOnce(
+                [](base::WeakPtr<ProfileLibrary> self,
+                   const std::string &generation, bool success) {
+                  if (!self || self->generation_ != generation) {
+                    return;
+                  }
+                  self->delta_in_flight_ = false;
+                  if (!success) {
+                    self->RefreshHistory();
+                    return;
+                  }
+                  ++self->sequence_;
+                  self->pending_deltas_.pop_front();
+                  self->FlushDelta();
+                },
+                weak_factory_.GetWeakPtr(), generation));
+}
+
+void ProfileLibrary::OnURLVisited(history::HistoryService *service,
+                                  const history::VisitedURLInfo &info) {
+  if (service != history_) {
+    return;
+  }
+  NotifyHistory();
+  const std::string url = info.url_row.url().spec();
+  const int64_t at = info.visit_row.visit_time.InMillisecondsSinceUnixEpoch();
+  if (url.empty() || url.size() > 8192 || at < 0) {
+    return;
+  }
+  base::ListValue upserts;
+  upserts.Append(VisitValue(
+      url, base::UTF16ToUTF8(info.url_row.title().substr(0, 4096)), at));
+  base::DictValue delta;
+  delta.Set("upserts", std::move(upserts));
+  EnqueueDelta(std::move(delta));
+}
+
+void ProfileLibrary::OnURLsModified(history::HistoryService *service,
+                                    const history::URLRows &rows) {
+  if (service != history_) {
+    return;
+  }
+  NotifyHistory();
+  for (size_t offset = 0; offset < rows.size(); offset += kHistoryBatchSize) {
+    base::ListValue updates;
+    for (size_t index = offset;
+         index < std::min(offset + kHistoryBatchSize, rows.size()); ++index) {
+      base::DictValue update;
+      if (rows[index].url().spec().size() > 8192) {
+        continue;
+      }
+      update.Set("url", rows[index].url().spec());
+      update.Set("title",
+                 base::UTF16ToUTF8(rows[index].title().substr(0, 4096)));
+      updates.Append(std::move(update));
+    }
+    base::DictValue delta;
+    delta.Set("titleUpdates", std::move(updates));
+    EnqueueDelta(std::move(delta));
+  }
+}
+
+void ProfileLibrary::OnHistoryDeletions(history::HistoryService *service,
+                                        const history::DeletionInfo &) {
+  if (service == history_) {
+    NotifyHistory();
+    RefreshHistory(); // A deletion may identify visit IDs but not timestamps.
+  }
+}
