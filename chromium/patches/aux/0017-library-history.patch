@@ -0,0 +1,182 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/cookie_import.h"
+
+#include <cmath>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/cookies/cookie_access_result.h"
+#include "net/cookies/cookie_constants.h"
+#include "net/cookies/cookie_options.h"
+#include "net/cookies/cookie_util.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+
+constexpr size_t kMaxCookies = 500;
+constexpr size_t kMaxBatchBytes = 2 * 1024 * 1024;
+
+base::DictValue Fault(const char* code, const char* message) {
+  base::DictValue error;
+  error.Set("code", code);
+  error.Set("message", message);
+  base::DictValue reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+
+struct Batch {
+  explicit Batch(base::OnceCallback<void(base::DictValue)> cb)
+      : callback(std::move(cb)) {}
+  base::OnceCallback<void(base::DictValue)> callback;
+  size_t pending = 0;
+  int accepted = 0;
+};
+
+}  // namespace
+
+std::unique_ptr<net::CanonicalCookie> ParseImportedCookie(
+    const base::Value& raw) {
+  const base::DictValue* item = raw.GetIfDict();
+  if (!item) {
+    return nullptr;
+  }
+  const std::string* name = item->FindString("name");
+  const std::string* value = item->FindString("value");
+  const std::string* domain = item->FindString("domain");
+  const std::string* path = item->FindString("path");
+  if (!name || !value || !domain || name->size() > 256 ||
+      value->size() > 4096 || domain->empty() || domain->size() > 253 ||
+      (path && path->size() > 1024)) {
+    return nullptr;
+  }
+  const bool secure = item->FindBool("secure").value_or(false);
+  const bool http_only = item->FindBool("httpOnly").value_or(false);
+  const std::string* same_site = item->FindString("sameSite");
+  net::CookieSameSite site = net::CookieSameSite::UNSPECIFIED;
+  if (same_site && *same_site == "None") {
+    site = net::CookieSameSite::NO_RESTRICTION;
+  }
+  if (same_site && *same_site == "Lax") {
+    site = net::CookieSameSite::LAX_MODE;
+  }
+  if (same_site && *same_site == "Strict") {
+    site = net::CookieSameSite::STRICT_MODE;
+  }
+  std::string host = *domain;
+  if (host.starts_with('.')) {
+    host.erase(0, 1);
+  }
+  const std::string cookie_path = path && !path->empty() ? *path : "/";
+  const GURL source((secure ? "https://" : "http://") + host + cookie_path);
+  if (!source.is_valid() || !source.SchemeIsHTTPOrHTTPS() ||
+      source.has_username() || source.has_password() || source.host() != host ||
+      cookie_path.front() != '/' || source.path() != cookie_path ||
+      source.has_query() || source.has_ref()) {
+    return nullptr;
+  }
+  const base::Time now = base::Time::Now();
+  base::Time expiry;
+  if (const std::optional<double> seconds = item->FindDouble("expires")) {
+    if (!std::isfinite(*seconds) || *seconds < 0 || *seconds > 253402300799.0) {
+      return nullptr;
+    }
+    expiry = base::Time::FromSecondsSinceUnixEpoch(*seconds);
+  }
+  net::CookieInclusionStatus status;
+  return net::CanonicalCookie::CreateSanitizedCookie(
+      source, *name, *value, *domain, cookie_path, now, expiry, now, secure,
+      http_only, site, net::COOKIE_PRIORITY_DEFAULT, std::nullopt, &status);
+}
+
+void ImportCookies(Profile* profile,
+                   const base::DictValue& params,
+                   base::OnceCallback<void(base::DictValue)> callback) {
+  const base::ListValue* cookies = params.FindList("cookies");
+  if (!profile || profile->IsOffTheRecord() || !cookies ||
+      cookies->size() > kMaxCookies) {
+    std::move(callback).Run(
+        Fault("invalid_argument", "Invalid cookie import batch"));
+    return;
+  }
+  size_t total_bytes = 0;
+  for (const base::Value& raw : *cookies) {
+    if (const base::DictValue* item = raw.GetIfDict()) {
+      for (const auto [key, value] : *item) {
+        total_bytes += key.size();
+        if (const std::string* text = value.GetIfString()) {
+          total_bytes += text->size();
+        }
+      }
+    }
+    if (total_bytes > kMaxBatchBytes) {
+      std::move(callback).Run(
+          Fault("invalid_argument", "Cookie import batch is too large"));
+      return;
+    }
+  }
+  auto* manager = profile->GetDefaultStoragePartition()
+                      ->GetCookieManagerForBrowserProcess();
+  if (!manager) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Profile cookie store is unavailable"));
+    return;
+  }
+  auto batch = std::make_shared<Batch>(std::move(callback));
+  std::vector<std::unique_ptr<net::CanonicalCookie>> valid;
+  valid.reserve(cookies->size());
+  for (const base::Value& raw : *cookies) {
+    auto cookie = ParseImportedCookie(raw);
+    if (cookie) {
+      valid.push_back(std::move(cookie));
+    }
+  }
+  batch->pending = valid.size();
+  if (batch->pending == 0) {
+    base::DictValue outcome;
+    outcome.Set("ok", true);
+    outcome.Set("count", 0);
+    base::DictValue reply;
+    reply.Set("result", std::move(outcome));
+    std::move(batch->callback).Run(std::move(reply));
+    return;
+  }
+  for (const auto& cookie : valid) {
+    const GURL source = net::cookie_util::SimulatedCookieSource(
+        *cookie, cookie->IsSecure() ? "https" : "http");
+    net::CookieOptions options;
+    options.set_include_httponly();
+    manager->SetCanonicalCookie(
+        *cookie, source, options,
+        base::BindOnce(
+            [](std::shared_ptr<Batch> batch, net::CookieAccessResult result) {
+              if (result.status.IsInclude()) {
+                ++batch->accepted;
+              }
+              if (--batch->pending == 0) {
+                base::DictValue outcome;
+                outcome.Set("ok", true);
+                outcome.Set("count", batch->accepted);
+                base::DictValue reply;
+                reply.Set("result", std::move(outcome));
+                std::move(batch->callback).Run(std::move(reply));
+              }
+            },
+            batch));
+  }
+}
+
+}  // namespace aux
