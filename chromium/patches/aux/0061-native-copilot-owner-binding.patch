+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_COPILOT_SESSION_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_COPILOT_SESSION_H_
+
+#include <atomic>
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/ref_counted_delete_on_sequence.h"
+#include "base/memory/weak_ptr.h"
+#include "base/threading/sequence_bound.h"
+#include "base/values.h"
+#include "chrome/browser/ui/aux/native_owned_headless_process.h"
+#include "content/public/browser/web_contents_observer.h"
+
+class ScopedProfileKeepAlive;
+
+namespace aux {
+// UI-owned original source and Profile lease. Only its private worker touches
+// the process, retained leader and sockets. Failed join retains this SAME
+// owner.
+class NativeCopilotSession final
+    : public base::RefCountedDeleteOnSequence<NativeCopilotSession>,
+      public content::WebContentsObserver {
+ public:
+  using Reply = base::OnceCallback<void(base::DictValue)>;
+  NativeCopilotSession(
+      content::WebContents* original_contents,
+      std::string token,
+      std::string request_id,
+      uint64_t original_generation,
+      std::string account_id,
+      std::string authorization_generation,
+      std::string credential_revision,
+      std::shared_ptr<std::atomic<OwnedHeadlessAdmission>> admission,
+      base::RepeatingCallback<bool()> source_current);
+  void Prepare(Reply reply);
+  void Start(
+      OwnedCopilotLaunch launch,
+      std::unique_ptr<ScopedProfileKeepAlive> profile_lease,
+      std::shared_ptr<std::atomic<OwnedHeadlessAdmission>> execution_admission,
+      Reply reply);
+  void Endpoint(Reply reply);
+  void Stop(Reply reply);
+  void Retire();
+  bool Current();
+  bool prepared() const { return prepared_; }
+  bool execution_requested() const { return execution_requested_; }
+  bool joined() const { return joined_; }
+  bool reconciled() const { return reconciled_; }
+  void Reconcile();
+  uint64_t original_generation() const { return original_generation_; }
+  const std::string& token() const { return token_; }
+  const std::string& account_id() const { return account_id_; }
+  const std::string& helper_id() const { return helper_id_; }
+  const std::string& authorization_generation() const {
+    return authorization_generation_;
+  }
+  const std::string& credential_revision() const {
+    return credential_revision_;
+  }
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<NativeCopilotSession>;
+  friend class base::DeleteHelper<NativeCopilotSession>;
+  class Worker;
+  ~NativeCopilotSession() override;
+  void CheckSource();
+  void OnStart(Reply reply, base::DictValue result);
+  void OnStop(Reply reply, base::DictValue result);
+  void PrimaryPageChanged(content::Page& page) override;
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override;
+  void WebContentsDestroyed() override;
+  const std::string token_;
+  const std::string request_id_;
+  const uint64_t original_generation_;
+  const std::string account_id_;
+  const std::string authorization_generation_;
+  const std::string credential_revision_;
+  std::shared_ptr<std::atomic<OwnedHeadlessAdmission>> admission_;
+  const base::RepeatingCallback<bool()> source_current_;
+  std::unique_ptr<ScopedProfileKeepAlive> profile_lease_;
+  base::SequenceBound<Worker> worker_;
+  scoped_refptr<NativeCopilotSession> retained_;
+  std::string helper_id_;
+  bool prepared_ = false;
+  bool execution_requested_ = false;
+  bool joined_ = false;
+  bool reconciled_ = false;
+  bool retirement_stop_queued_ = false;
+  base::WeakPtrFactory<NativeCopilotSession> weak_factory_{this};
+};
+}  // namespace aux
+#endif
