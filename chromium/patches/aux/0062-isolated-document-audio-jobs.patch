+#include "chrome/services/aux_document/media_jobs.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux::document {
+namespace {
+std::vector<uint8_t> Wave() {
+  std::vector<uint8_t> bytes(44 + 3200, 0);
+  auto text = [&](size_t at, std::string_view value) {
+    base::span(bytes)
+        .subspan(at, value.size())
+        .copy_from(base::as_byte_span(value));
+  };
+  auto number = [&](size_t at, uint32_t value, int count) {
+    for (int i = 0; i < count; ++i) {
+      bytes[at + i] = (value >> (i * 8)) & 255;
+    }
+  };
+  text(0, "RIFF");
+  number(4, bytes.size() - 8, 4);
+  text(8, "WAVEfmt ");
+  number(16, 16, 4);
+  number(20, 1, 2);
+  number(22, 1, 2);
+  number(24, 16000, 4);
+  number(28, 32000, 4);
+  number(32, 2, 2);
+  number(34, 16, 2);
+  text(36, "data");
+  number(40, 3200, 4);
+  return bytes;
+}
+TEST(AuxAudioInspection, DecodesWholeImmutableWaveWithoutRetainedSamples) {
+  const auto bytes = Wave();
+  const auto before = bytes;
+  auto result = InspectAudio(bytes, "audio/wav");
+  ASSERT_TRUE(result.failure.empty()) << result.failure;
+  EXPECT_TRUE(result.outputs.empty());
+  const auto* audio = result.report.FindDict("audio");
+  ASSERT_TRUE(audio);
+  EXPECT_EQ(audio->FindDouble("decodedFrames"), 1600);
+  EXPECT_EQ(audio->FindInt("sampleRate"), 16000);
+  EXPECT_EQ(audio->FindInt("channels"), 1);
+  EXPECT_EQ(audio->FindDouble("durationSeconds"), 0.1);
+  EXPECT_TRUE(audio->FindBool("complete").value_or(false));
+  EXPECT_EQ(bytes, before);
+}
+TEST(AuxAudioInspection, RejectsTruncatedOrFalselyDeclaredSources) {
+  auto bytes = Wave();
+  EXPECT_FALSE(InspectAudio(bytes, "audio/mpeg").failure.empty());
+  bytes.pop_back();
+  EXPECT_FALSE(InspectAudio(bytes, "audio/wav").failure.empty());
+  bytes[4] -= 1;
+  EXPECT_FALSE(InspectAudio(bytes, "audio/wav").failure.empty());
+  bytes = Wave();
+  bytes[22] = 3;
+  EXPECT_FALSE(InspectAudio(bytes, "audio/wav").failure.empty());
+  bytes = Wave();
+  bytes[40] -= 2;
+  EXPECT_FALSE(InspectAudio(bytes, "audio/wav").failure.empty());
+  EXPECT_FALSE(InspectAudio({}, "audio/wav").failure.empty());
+}
