+#ifndef CHROME_BROWSER_UI_AUX_DOCUMENT_JOBS_H_
+#define CHROME_BROWSER_UI_AUX_DOCUMENT_JOBS_H_
+#include <atomic>
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/values.h"
+namespace aux {
+// A controller belongs to one authenticated native connection, never a path or
+// a replacement runtime. Each computation has its own sandboxed utility.
+class NativeDocumentJobs {
+ public:
+  NativeDocumentJobs();
+  ~NativeDocumentJobs();
+  void Dispatch(const base::DictValue& params,
+                std::shared_ptr<std::atomic_bool> cancelled,
+                base::OnceCallback<void(base::DictValue)> callback);
+
+ private:
+  class Job;
+  std::map<std::string, scoped_refptr<Job>> jobs_;
+};
+}  // namespace aux
