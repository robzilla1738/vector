index 0000000000000000000000000000000000000000..d0bb3da048d1769d27a6ba9be516b364b518b924
--- /dev/null
+++ b/chrome/services/aux_document/audio_inspection.cc
@@ -0,0 +1,418 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include <algorithm>
+#include <array>
+#include <memory>
+#include <optional>
+#include <string_view>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_view_util.h"
+#include "chrome/services/aux_document/media_jobs.h"
+#include "crypto/hash.h"
+#include "media/ffmpeg/ffmpeg_common.h"
+#include "media/ffmpeg/scoped_av_packet.h"
+#include "media/filters/ffmpeg_glue.h"
+#include "media/filters/in_memory_url_protocol.h"
+namespace aux::document {
+namespace {
+uint32_t Little(base::span<const uint8_t> bytes, size_t offset, size_t count) {
+  uint32_t value = 0;
+  for (size_t i = 0; i < count; ++i) {
+    value |= uint32_t(bytes[offset + i]) << (8 * i);
+  }
+  return value;
+}
+std::optional<uint64_t> WavFrames(base::span<const uint8_t> bytes) {
+  const auto text = base::as_string_view(bytes);
+  if (bytes.size() < 44 || !text.starts_with("RIFF") ||
+      text.substr(8, 4) != "WAVE" ||
+      uint64_t(Little(bytes, 4, 4)) + 8 != bytes.size()) {
+    return std::nullopt;
+  }
+  size_t offset = 12;
+  uint32_t align = 0;
+  std::optional<uint64_t> frames;
+  while (offset < bytes.size()) {
+    if (bytes.size() - offset < 8) {
+      return std::nullopt;
+    }
+    const size_t size = Little(bytes, offset + 4, 4);
+    const auto kind = text.substr(offset, 4);
+    offset += 8;
+    if (size > bytes.size() - offset) {
+      return std::nullopt;
+    }
+    if (kind == "fmt ") {
+      if (align || size < 16 || size > 40) {
+        return std::nullopt;
+      }
+      const auto format = Little(bytes, offset, 2),
+                 channels = Little(bytes, offset + 2, 2);
+      const auto rate = Little(bytes, offset + 4, 4),
+                 bits = Little(bytes, offset + 14, 2);
+      align = Little(bytes, offset + 12, 2);
+      if ((format != 1 && format != 3) || channels < 1 || channels > 2 ||
+          !rate || rate > 192000 ||
+          (bits != 8 && bits != 16 && bits != 24 && bits != 32) ||
+          (format == 3 && bits != 32) || align != channels * bits / 8 ||
+          Little(bytes, offset + 8, 4) != rate * align) {
+        return std::nullopt;
+      }
+    } else if (kind == "data") {
+      if (!align || frames || !size || size % align) {
+        return std::nullopt;
+      }
+      frames = size / align;
+    }
+    offset += size;
+    if (size % 2) {
+      if (offset == bytes.size()) {
+        return std::nullopt;
+      }
+      ++offset;
+    }
+  }
+  return frames;
+}
+uint64_t Big(base::span<const uint8_t> bytes, size_t offset, size_t count) {
+  uint64_t value = 0;
+  for (size_t i = 0; i < count; ++i) {
+    value = (value << 8) | bytes[offset + i];
+  }
+  return value;
+}
+std::optional<uint64_t> FlacFrames(base::span<const uint8_t> bytes) {
+  if (bytes.size() < 42 || base::as_string_view(bytes).substr(0, 4) != "fLaC") {
+    return std::nullopt;
+  }
+  size_t offset = 4;
+  bool last = false;
+  uint64_t frames = 0;
+  while (!last) {
+    if (bytes.size() - offset < 4 || offset > 1024 * 1024) {
+      return std::nullopt;
+    }
+    const uint8_t type = bytes[offset] & 127;
+    last = (bytes[offset] & 128) != 0;
+    const size_t size = Big(bytes, offset + 1, 3);
+    if (size > bytes.size() - offset - 4 || type == 127 ||
+        (offset == 4 ? type != 0 : type == 0)) {
+      return std::nullopt;
+    }
+    offset += 4;
+    if (type == 0) {
+      if (size != 34) {
+        return std::nullopt;
+      }
+      const uint64_t stream = Big(bytes, offset + 10, 8);
+      const uint64_t rate = stream >> 44;
+      const uint64_t channels = ((stream >> 41) & 7) + 1;
+      frames = stream & 0xfffffffffULL;
+      if (!rate || rate > 192000 || channels > 2 || !frames ||
+          frames > rate * 600) {
+        return std::nullopt;
+      }
+    }
+    offset += size;
+  }
+  return offset < bytes.size() && frames ? std::optional(frames) : std::nullopt;
+}
+std::optional<uint64_t> Mp3Frames(base::span<const uint8_t> bytes) {
+  const auto text = base::as_string_view(bytes);
+  size_t offset = 0, end = bytes.size();
+  if (text.starts_with("ID3")) {
+    if (bytes.size() < 10 || bytes[3] < 2 || bytes[3] > 4 || bytes[4] == 255) {
+      return std::nullopt;
+    }
+    size_t length = 0;
+    for (size_t i = 6; i < 10; ++i) {
+      if (bytes[i] & 128) {
+        return std::nullopt;
+      }
+      length = (length << 7) | bytes[i];
+    }
+    offset = 10 + length + ((bytes[3] == 4 && (bytes[5] & 16)) ? 10 : 0);
+    if (offset > bytes.size() || offset > 1024 * 1024) {
+      return std::nullopt;
+    }
+  }
+  if (end >= 128 && text.substr(end - 128, 3) == "TAG") {
+    end -= 128;
+  }
+  constexpr std::array<int, 14> mpeg1 = {32,  40,  48,  56,  64,  80,  96,
+                                         112, 128, 160, 192, 224, 256, 320};
+  constexpr std::array<int, 14> mpeg2 = {8,  16, 24, 32,  40,  48,  56,
+                                         64, 80, 96, 112, 128, 144, 160};
+  constexpr std::array<int, 3> rates = {44100, 48000, 32000};
+  int original_rate = 0, original_channels = 0;
+  uint64_t samples = 0;
+  while (offset < end) {
+    if (end - offset < 4) {
+      return std::nullopt;
+    }
+    const uint32_t header = Big(bytes, offset, 4);
+    const int version = (header >> 19) & 3, layer = (header >> 17) & 3;
+    const int bitrate = (header >> 12) & 15, sampling = (header >> 10) & 3;
+    if ((header & 0xffe00000U) != 0xffe00000U || version == 1 || layer != 1 ||
+        !bitrate || bitrate == 15 || sampling == 3 || (header & 3) == 2) {
+      return std::nullopt;
+    }
+    const int rate = rates[sampling] / (version == 3   ? 1
+                                        : version == 2 ? 2
+                                                       : 4);
+    const int channels = ((header >> 6) & 3) == 3 ? 1 : 2;
+    if (original_rate &&
+        (original_rate != rate || original_channels != channels)) {
+      return std::nullopt;
+    }
+    original_rate = rate;
+    original_channels = channels;
+    const int kbps = (version == 3 ? mpeg1 : mpeg2)[bitrate - 1];
+    const size_t length =
+        (version == 3 ? 144 : 72) * kbps * 1000 / rate + ((header >> 9) & 1);
+    if (length < 4 || length > end - offset) {
+      return std::nullopt;
+    }
+    samples += version == 3 ? 1152 : 576;
+    if (samples > uint64_t(rate) * 601) {
+      return std::nullopt;
+    }
+    offset += length;
+  }
+  return samples ? std::optional(samples) : std::nullopt;
+}
+bool Mp4Container(base::span<const uint8_t> bytes) {
+  const auto text = base::as_string_view(bytes);
+  if (bytes.size() < 24 || text.substr(4, 4) != "ftyp") {
+    return false;
+  }
+  size_t offset = 0;
+  bool movie = false, data = false;
+  unsigned boxes = 0;
+  while (offset < bytes.size()) {
+    if (++boxes > 1024 || bytes.size() - offset < 8) {
+      return false;
+    }
+    uint64_t size = Big(bytes, offset, 4);
+    size_t header = 8;
+    const auto type = text.substr(offset + 4, 4);
+    if (size == 1) {
+      if (bytes.size() - offset < 16) {
+        return false;
+      }
+      size = Big(bytes, offset + 8, 8);
+      header = 16;
+    }
+    // Reject open-ended and fragmented containers. All decoding uses
+    // memory-only IO.
+    if (size < header || size > bytes.size() - offset) {
+      return false;
+    }
+    if (type == "moov") {
+      if (movie) {
+        return false;
+      }
+      movie = true;
+    } else if (type == "mdat") {
+      if (data || size == header) {
+        return false;
+      }
+      data = true;
+    } else if (type != "ftyp" && type != "free" && type != "skip" &&
+               type != "wide") {
+      return false;
+    }
+    if (type == "ftyp" &&
+        (offset || size < header + 8 || (size - header) % 4)) {
+      return false;
+    }
+    offset += static_cast<size_t>(size);
+  }
+  return movie && data;
+}
+// The container must agree with the declared source. Never pass a URL to
+// FFmpeg.
+bool Header(base::span<const uint8_t> bytes, std::string_view type) {
+  const auto text = base::as_string_view(bytes);
+  if (type == "audio/wav" || type == "audio/x-wav" || type == "audio/wave") {
+    return WavFrames(bytes).has_value();
+  }
+  if (type == "audio/ogg" || type == "application/ogg" ||
+      type == "audio/opus") {
+    // A complete final Ogg page must explicitly end its logical bitstream.
+    if (!text.starts_with("OggS")) {
+      return false;
+    }
+    size_t offset = 0;
+    bool ended = false;
+    uint32_t serial = 0, sequence = 0;
+    bool continued = false;
+    while (offset < bytes.size()) {
+      if (bytes.size() - offset < 27 || text.substr(offset, 4) != "OggS" ||
+          bytes[offset + 4] != 0 || ended) {
+        return false;
+      }
+      const size_t segments = bytes[offset + 26];
+      if (bytes.size() - offset < 27 + segments) {
+        return false;
+      }
+      size_t size = 27 + segments;
+      for (size_t i = 0; i < segments; ++i) {
+        size += bytes[offset + 27 + i];
+      }
+      if (size > bytes.size() - offset ||
+          ((bytes[offset + 5] & 1) != 0) != continued ||
+          (offset == 0 ? !(bytes[offset + 5] & 2) : (bytes[offset + 5] & 2))) {
+        return false;
+      }
+      if (!offset) {
+        serial = Little(bytes, offset + 14, 4);
+      }
+      if (Little(bytes, offset + 14, 4) != serial ||
+          Little(bytes, offset + 18, 4) != sequence++) {
+        return false;
+      }
+      uint32_t crc = 0;
+      for (size_t i = 0; i < size; ++i) {
+        const uint8_t value = i >= 22 && i < 26 ? 0 : bytes[offset + i];
+        crc ^= uint32_t(value) << 24;
+        for (int bit = 0; bit < 8; ++bit) {
+          crc = (crc << 1) ^ ((crc & 0x80000000) ? 0x04c11db7 : 0);
+        }
+      }
+      if (crc != Little(bytes, offset + 22, 4)) {
+        return false;
+      }
+      continued = segments && bytes[offset + 26 + segments] == 255;
+      ended = (bytes[offset + 5] & 4) != 0;
+      offset += size;
+    }
+    return ended && !continued;
+  }
+  if (type == "audio/flac" || type == "audio/x-flac") {
+    return FlacFrames(bytes).has_value();
+  }
+  if (type == "audio/mpeg" || type == "audio/mp3") {
+    return Mp3Frames(bytes).has_value();
+  }
+  if (type == "audio/mp4" || type == "audio/x-m4a") {
+    return Mp4Container(bytes);
+  }
+  return false;
+}
+}  // namespace
+JobResult InspectAudio(base::span<const uint8_t> bytes,
+                       const std::string& media_type) {
+  JobResult result;
+  auto fail = [&](std::string reason) {
+    result.failure = std::move(reason);
+    return std::move(result);
+  };
+  if (bytes.empty() || bytes.size() > 20 * 1024 * 1024 ||
+      !Header(bytes, media_type)) {
+    return fail("Unsupported, truncated or falsely declared audio container");
+  }
+  media::InMemoryUrlProtocol protocol(bytes, false);
+  media::FFmpegGlue glue(&protocol);
+  if (!glue.OpenContext()) {
+    return fail("Audio container could not be opened");
+  }
+  auto* format = glue.format_context();
+  format->error_recognition =
+      AV_EF_EXPLODE | AV_EF_CRCCHECK | AV_EF_BITSTREAM | AV_EF_BUFFER;
+  if (avformat_find_stream_info(format, nullptr) < 0) {
+    return fail("Audio stream information is invalid");
+  }
+  const auto streams = media::AVFormatContextToSpan(format);
+  if (streams.size() != 1 ||
+      streams[0]->codecpar->codec_type != AVMEDIA_TYPE_AUDIO) {
+    return fail("Only a single audio stream is supported");
+  }
+  auto context = media::AVStreamToAVCodecContext(streams[0]);
+  if (!context) {
+    return fail("Audio codec configuration is invalid");
+  }
+  const AVCodec* codec = avcodec_find_decoder(context->codec_id);
+  context->thread_count = 1;
+  context->err_recognition =
+      AV_EF_EXPLODE | AV_EF_CRCCHECK | AV_EF_BITSTREAM | AV_EF_BUFFER;
+  if (!codec || avcodec_open2(context.get(), codec, nullptr) < 0) {
+    return fail("This build does not support the audio codec");
+  }
+  const int rate = context->sample_rate,
+            channels = context->ch_layout.nb_channels;
+  if (rate <= 0 || rate > 192000 || channels < 1 || channels > 2) {
+    return fail("Audio rate or channel count exceeds admission bounds");
+  }
+  std::unique_ptr<AVFrame, media::ScopedPtrAVFreeFrame> frame(av_frame_alloc());
+  auto packet = media::ScopedAVPacket::Allocate();
+  if (!frame || !packet) {
+    return fail("Audio decoder allocation failed");
+  }
+  uint64_t frames = 0;
+  bool invalid = false;
+  auto drain = [&]() {
+    int status;
+    while ((status = avcodec_receive_frame(context.get(), frame.get())) >= 0) {
+      if (frame->sample_rate != rate ||
+          frame->ch_layout.nb_channels != channels || frame->nb_samples <= 0 ||
+          frame->decode_error_flags || (frame->flags & AV_FRAME_FLAG_CORRUPT)) {
+        invalid = true;
+      }
+      frames += std::max(frame->nb_samples, 0);
+      av_frame_unref(frame.get());
+      if (invalid || frames > uint64_t(rate) * 600) {
+        return AVERROR_INVALIDDATA;
+      }
+    }
+    return status;
+  };
+  int read;
+  while ((read = av_read_frame(format, packet.get())) >= 0) {
+    if (packet->stream_index != 0 || (packet->flags & AV_PKT_FLAG_CORRUPT) ||
+        avcodec_send_packet(context.get(), packet.get()) < 0) {
+      return fail("Audio packet decoding failed");
+    }
+    av_packet_unref(packet.get());
+    if (drain() != AVERROR(EAGAIN)) {
+      return fail("Audio decoding failed or exceeded limits");
+    }
+  }
+  if (read != AVERROR_EOF ||
+      (format->pb && format->pb->error && format->pb->error != AVERROR_EOF) ||
+      avcodec_send_packet(context.get(), nullptr) < 0 ||
+      drain() != AVERROR_EOF || invalid || !frames) {
+    return fail("Audio did not decode completely");
+  }
+  if ((media_type == "audio/wav" || media_type == "audio/x-wav" ||
+       media_type == "audio/wave") &&
+      WavFrames(bytes) != frames) {
+    return fail("WAV decoded frames do not match its complete sample data");
+  }
+  if ((media_type == "audio/flac" || media_type == "audio/x-flac") &&
+      FlacFrames(bytes) != frames) {
+    return fail("FLAC decoded frames do not match the complete stream receipt");
+  }
+  if (media_type == "audio/mpeg" || media_type == "audio/mp3") {
+    const auto encoded = Mp3Frames(bytes);
+    if (!encoded || frames > *encoded || *encoded - frames > 3456) {
+      return fail("MP3 decoded frames do not match complete frame boundaries");
+    }
+  }
+  const std::string hash = base::HexEncodeLower(crypto::hash::Sha256(bytes));
+  result.report.Set("kind", "audioInspect");
+  result.report.Set("sourceSha256", base::ListValue().Append(hash));
+  result.report.Set("audio",
+                    base::DictValue()
+                        .Set("sourceSha256", hash)
+                        .Set("mediaType", media_type)
+                        .Set("decodedFrames", static_cast<double>(frames))
+                        .Set("sampleRate", rate)
+                        .Set("channels", channels)
+                        .Set("durationSeconds", double(frames) / rate)
+                        .Set("complete", true));
+  return result;
+}
+}  // namespace aux::document
