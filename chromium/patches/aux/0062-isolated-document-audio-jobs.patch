+       Stream(""),
+       "<< /Type /Annot /Subtype /Widget /FT /Tx /T (Owner) /V (Old) "
+       "/Rect [10 50 110 70] /P 3 0 R /F 4 /DA (/Helv 12 Tf 0 g) "
+       "/AP << /N 8 0 R >> " +
+           std::string(extra) + " >>",
+       "<< /Type /Annot /Subtype /Widget /FT /Btn /T (Checked) /V /Off "
+       "/AS /Off /Rect [10 10 30 30] /P 3 0 R /F 4 "
+       "/AP << /N << /Off 9 0 R /Yes 10 0 R >> >> >>",
+       "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
+       Stream("BT /Helv 12 Tf 0 g 2 5 Td (Old) Tj ET",
+              "/Type /XObject /Subtype /Form /BBox [0 0 100 20] "
+              "/Resources << /Font << /Helv 7 0 R >> >>"),
+       Stream("0 G 1 w 1 1 18 18 re S",
+              "/Type /XObject /Subtype /Form /BBox [0 0 20 20]"),
+       Stream("0 G 1 w 1 1 18 18 re S 2 w 4 4 m 16 16 l 4 16 m 16 4 l S",
+              "/Type /XObject /Subtype /Form /BBox [0 0 20 20]")});
+}
+// Object 6 is compressed into an unfiltered object stream. It is reachable
+// outside /Names/JavaScript, so the public JavaScript-count API cannot find it.
+std::vector<uint8_t> ObjectStreamScriptPdf() {
+  const std::vector<std::string> objects = {
+      "<< /Type /Catalog /Pages 2 0 R /AuxMetadata 6 0 R >>",
+      "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+      "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 100 100] /Contents 4 0 R >>",
+      Stream(""),
+      Stream("6 0 << /S /JavaScript /J#53 (app.alert\\(1\\)) >>",
+             "/Type /ObjStm /N 1 /First 4")};
+  std::string pdf = "%PDF-1.7\n";
+  std::vector<size_t> offsets;
+  for (size_t index = 0; index < objects.size(); ++index) {
+    offsets.push_back(pdf.size());
+    pdf += base::NumberToString(index + 1) + " 0 obj\n" + objects[index] +
+           "\nendobj\n";
+  }
+  const size_t xref_offset = pdf.size();
+  std::string xref;
+  auto entry = [&](int type, uint32_t offset, uint16_t generation) {
+    xref.push_back(type);
+    for (int shift : {24, 16, 8, 0}) {
+      xref.push_back((offset >> shift) & 0xff);
+    }
+    xref.push_back(generation >> 8);
+    xref.push_back(generation & 0xff);
+  };
+  entry(0, 0, 65535);
+  for (size_t offset : offsets) {
+    entry(1, offset, 0);
+  }
+  entry(2, 5, 0);
+  entry(1, xref_offset, 0);
+  pdf +=
+      "7 0 obj\n" + Stream(xref, "/Type /XRef /Size 8 /Root 1 0 R /W [1 4 2]") +
+      "\nendobj\nstartxref\n" + base::NumberToString(xref_offset) + "\n%%EOF\n";
+  return {pdf.begin(), pdf.end()};
+}
+base::ListValue PageList(std::initializer_list<int> pages) {
+  base::ListValue list;
+  for (int page : pages) {
+    list.Append(page);
+  }
+  return list;
+}
+JobResult RunPdf(const std::vector<uint8_t>& bytes, base::DictValue options) {
+  return ExecutePdf({base::span(bytes)}, options);
+}
+std::string Text(const std::vector<uint8_t>& bytes) {
+  JobResult result = RunPdf(bytes, base::DictValue().Set("operation", "text"));
+  EXPECT_TRUE(result.failure.empty()) << result.failure;
+  const auto* text = result.report.FindString("text");
+  return text ? *text : "";
+}
+TEST(AuxPdfJobsTest, TextRenderAndEmptyFieldsPreserveInput) {
+  auto source = PagesPdf();
+  const auto original = source;
+  EXPECT_NE(Text(source).find("Page one"), std::string::npos);
+  EXPECT_NE(Text(source).find("Page two"), std::string::npos);
+  JobResult rendered = RunPdf(
+      source,
+      base::DictValue().Set("operation", "render").Set("pages", PageList({2})));
+  ASSERT_TRUE(rendered.failure.empty()) << rendered.failure;
+  ASSERT_EQ(rendered.outputs.size(), 1u);
+  EXPECT_EQ(rendered.outputs[0].media_type, "image/png");
+  ASSERT_GE(rendered.outputs[0].bytes.size(), 8u);
+  EXPECT_EQ(rendered.outputs[0].bytes[0], 0x89);
+  EXPECT_EQ(rendered.outputs[0].bytes[1], 'P');
+  EXPECT_EQ(*rendered.report.FindList("pageMappings")
+                 ->front()
+                 .GetDict()
+                 .FindInt("sourcePage"),
+            2);
+  JobResult fields =
+      RunPdf(source, base::DictValue().Set("operation", "fields"));
+  ASSERT_TRUE(fields.failure.empty()) << fields.failure;
+  EXPECT_TRUE(fields.report.FindList("fields")->empty());
+  EXPECT_EQ(source, original);
+}
+TEST(AuxPdfJobsTest, MergeSplitAndRotateReopenInRequestedOrder) {
+  const auto source = PagesPdf();
+  base::ListValue inputs;
+  inputs.Append(
+      base::DictValue().Set("sourceIndex", 1).Set("pages", PageList({2})));
+  inputs.Append(
+      base::DictValue().Set("sourceIndex", 0).Set("pages", PageList({1})));
+  JobResult merged = ExecutePdf({base::span(source), base::span(source)},
+                                base::DictValue()
+                                    .Set("operation", "merge")
+                                    .Set("inputs", std::move(inputs)));
+  ASSERT_TRUE(merged.failure.empty()) << merged.failure;
+  ASSERT_EQ(merged.outputs.size(), 1u);
+  const auto merged_text = Text(merged.outputs[0].bytes);
+  EXPECT_LT(merged_text.find("Page two"), merged_text.find("Page one"));
+  EXPECT_EQ(*merged.report.FindList("pageMappings")
+                 ->front()
+                 .GetDict()
+                 .FindInt("sourceIndex"),
+            1);
+  base::ListValue groups;
+  groups.Append(PageList({2}));
+  groups.Append(PageList({1}));
+  JobResult split = RunPdf(source, base::DictValue()
+                                       .Set("operation", "split")
+                                       .Set("groups", std::move(groups)));
+  ASSERT_TRUE(split.failure.empty()) << split.failure;
+  ASSERT_EQ(split.outputs.size(), 2u);
+  EXPECT_NE(Text(split.outputs[0].bytes).find("Page two"), std::string::npos);
+  EXPECT_EQ(Text(split.outputs[0].bytes).find("Page one"), std::string::npos);
+  EXPECT_NE(Text(split.outputs[1].bytes).find("Page one"), std::string::npos);
+  JobResult rotated = RunPdf(source, base::DictValue()
+                                         .Set("operation", "rotate")
+                                         .Set("pages", PageList({2}))
+                                         .Set("degrees", 90));
+  ASSERT_TRUE(rotated.failure.empty()) << rotated.failure;
+  ASSERT_EQ(rotated.outputs.size(), 1u);
+  EXPECT_EQ(*rotated.report.FindList("pageMappings")
+                 ->back()
+                 .GetDict()
+                 .FindInt("rotation"),
+            90);
+  JobResult reopened = RunPdf(rotated.outputs[0].bytes,
+                              base::DictValue().Set("operation", "text"));
+  ASSERT_TRUE(reopened.failure.empty()) << reopened.failure;
+  EXPECT_EQ(*reopened.report.FindList("pageMappings")
+                 ->back()
+                 .GetDict()
+                 .FindInt("rotation"),
+            90);
+}
+TEST(AuxPdfJobsTest, FillsTextAndCheckboxAndVerifiesSavedAppearance) {
+  auto source = FormPdf();
+  const auto original = source;
+  base::ListValue values;
+  values.Append(base::DictValue().Set("name", "Owner").Set("value", "Aux"));
+  values.Append(base::DictValue().Set("name", "Checked").Set("value", true));
+  JobResult filled = RunPdf(source, base::DictValue()
+                                        .Set("operation", "fill")
+                                        .Set("values", std::move(values)));
+  ASSERT_TRUE(filled.failure.empty()) << filled.failure;
+  EXPECT_EQ(filled.report.FindBool("appearancesVerified"), true);
+  ASSERT_EQ(filled.outputs.size(), 1u);
+  JobResult reopened = RunPdf(filled.outputs[0].bytes,
+                              base::DictValue().Set("operation", "fields"));
+  ASSERT_TRUE(reopened.failure.empty()) << reopened.failure;
+  const auto* fields = reopened.report.FindList("fields");
+  ASSERT_EQ(fields->size(), 2u);
+  EXPECT_EQ(*fields->front().GetDict().FindString("value"), "Aux");
+  EXPECT_EQ(fields->back().GetDict().FindBool("value"), true);
+  EXPECT_EQ(source, original);
+  // Refilling the existing value must still prove ink against a cleared widget.
+  base::ListValue unchanged;
+  unchanged.Append(base::DictValue().Set("name", "Checked").Set("value", true));
+  JobResult same =
+      RunPdf(filled.outputs[0].bytes, base::DictValue()
+                                          .Set("operation", "fill")
+                                          .Set("values", std::move(unchanged)));
+  EXPECT_TRUE(same.failure.empty()) << same.failure;
+}
+TEST(AuxPdfJobsTest, ClearsFieldsAndRefusesReadOnlyEdits) {
+  base::ListValue checked;
+  checked.Append(base::DictValue().Set("name", "Checked").Set("value", true));
+  JobResult initial = RunPdf(FormPdf(), base::DictValue()
+                                            .Set("operation", "fill")
+                                            .Set("values", std::move(checked)));
+  ASSERT_TRUE(initial.failure.empty()) << initial.failure;
+  base::ListValue cleared;
+  cleared.Append(base::DictValue().Set("name", "Owner").Set("value", ""));
+  cleared.Append(base::DictValue().Set("name", "Checked").Set("value", false));
+  JobResult result =
+      RunPdf(initial.outputs[0].bytes, base::DictValue()
+                                           .Set("operation", "fill")
+                                           .Set("values", std::move(cleared)));
+  ASSERT_TRUE(result.failure.empty()) << result.failure;
+  EXPECT_EQ(result.report.FindBool("appearancesVerified"), true);
+  const auto* fields = result.report.FindList("fields");
+  ASSERT_EQ(fields->size(), 2u);
+  EXPECT_TRUE(fields->front().GetDict().FindString("value")->empty());
+  EXPECT_EQ(fields->back().GetDict().FindBool("value"), false);
+  base::ListValue read_only;
+  read_only.Append(base::DictValue().Set("name", "Owner").Set("value", "Aux"));
+  JobResult refused =
+      RunPdf(FormPdf("/Ff 1"), base::DictValue()
+                                   .Set("operation", "fill")
+                                   .Set("values", std::move(read_only)));
+  EXPECT_NE(refused.failure.find("Read-only"), std::string::npos);
+  EXPECT_TRUE(refused.outputs.empty());
+}
+TEST(AuxPdfJobsTest, RejectsScriptObjectStreamsAndWidgetActions) {
+  JobResult compressed = RunPdf(ObjectStreamScriptPdf(),
+                                base::DictValue().Set("operation", "fields"));
+  EXPECT_NE(compressed.failure.find("scripts"), std::string::npos)
+      << compressed.failure;
+  EXPECT_TRUE(compressed.outputs.empty());
+  for (const auto extra : {"/AA << /K << /S /JavaScript /JS (1) >> >>",
+                           "/A << /S /URI /URI (https://example.invalid) >>",
+                           "/FT /Sig", "/Ff 8192"}) {
+    JobResult active =
+        RunPdf(FormPdf(extra), base::DictValue().Set("operation", "fields"));
+    EXPECT_FALSE(active.failure.empty()) << extra;
+    EXPECT_TRUE(active.outputs.empty());
+  }
+}
+TEST(AuxPdfJobsTest, RejectsInvalidOptionsAndDoesNotPublishPartialOutputs) {
+  const auto source = PagesPdf();
+  EXPECT_FALSE(
+      RunPdf(source,
+             base::DictValue().Set("operation", "fields").Set("extra", 1))
+          .failure.empty());
+  EXPECT_FALSE(RunPdf(source, base::DictValue()
+                                  .Set("operation", "render")
+                                  .Set("pages", PageList({3})))
+                   .failure.empty());
+  EXPECT_FALSE(RunPdf(source, base::DictValue()
+                                  .Set("operation", "render")
+                                  .Set("pages", PageList({1}))
+                                  .Set("scale", 5))
+                   .failure.empty());
+  EXPECT_FALSE(RunPdf(source, base::DictValue()
+                                  .Set("operation", "rotate")
+                                  .Set("pages", PageList({1, 1}))
+                                  .Set("degrees", 90))
+                   .failure.empty());
+  base::ListValue values;
+  values.Append(base::DictValue().Set("name", "Owner").Set("value", "Aux"));
+  values.Append(
+      base::DictValue().Set("name", "Owner").Set("value", "duplicate"));
+  JobResult duplicate =
+      RunPdf(FormPdf(), base::DictValue()
+                            .Set("operation", "fill")
+                            .Set("values", std::move(values)));
+  EXPECT_FALSE(duplicate.failure.empty());
+  EXPECT_TRUE(duplicate.outputs.empty());
+  base::ListValue groups;
+  groups.Append(PageList({1}));
+  groups.Append(PageList({3}));
+  JobResult split = RunPdf(source, base::DictValue()
+                                       .Set("operation", "split")
+                                       .Set("groups", std::move(groups)));
+  EXPECT_FALSE(split.failure.empty());
+  EXPECT_TRUE(split.outputs.empty());
+}
