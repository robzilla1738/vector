+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/services/aux_document/pdf_safety.h"
+
+#include <set>
+#include <utility>
+#include <vector>
+
+// PDFium's private fxcrt types intentionally stay in their own translation
+// unit: the pinned fork shares several include guards with Chromium base.
+#include "third_party/pdfium/core/fpdfapi/parser/cpdf_array.h"
+#include "third_party/pdfium/core/fpdfapi/parser/cpdf_dictionary.h"
+#include "third_party/pdfium/core/fpdfapi/parser/cpdf_document.h"
+#include "third_party/pdfium/core/fpdfapi/parser/cpdf_object.h"
+#include "third_party/pdfium/fpdfsdk/cpdfsdk_helpers.h"
+#include "third_party/pdfium/public/fpdf_javascript.h"
+#include "third_party/pdfium/public/fpdf_signature.h"
+
+namespace aux::document {
+// Traverse parsed objects, including indirect/object-stream dictionaries. Do
+// not inspect byte substrings or assume scripts only live in the name tree.
+bool IsInertPdf(FPDF_DOCUMENT document) {
+  auto *parsed = CPDFDocumentFromFPDFDocument(document);
+  if (!parsed || !parsed->GetRoot() ||
+      FPDFDoc_GetJavaScriptActionCount(document) != 0 ||
+      FPDF_GetSignatureCount(document) != 0) {
+    return false;
+  }
+  std::vector<RetainPtr<const CPDF_Object>> pending;
+  pending.emplace_back(parsed->GetRoot());
+  std::vector<RetainPtr<const CPDF_Object>> retained;
+  std::set<const CPDF_Object *> visited;
+  size_t edges = 0;
+  while (!pending.empty()) {
+    auto object = std::move(pending.back());
+    pending.pop_back();
+    if (!object || !visited.insert(object.Get()).second) {
+      continue;
+    }
+    if (visited.size() > 100000) {
+      return false;
+    }
+    retained.push_back(object);
+    if (object->IsReference()) {
+      auto direct = object->GetDirect();
+      if (!direct) {
+        return false;
+      }
+      pending.push_back(std::move(direct));
+      continue;
+    }
+    if (const auto *array = object->AsArray()) {
+      if (array->size() > 100000 - edges) {
+        return false;
+      }
+      edges += array->size();
+      for (size_t index = 0; index < array->size(); ++index) {
+        pending.push_back(array->GetObjectAt(index));
+      }
+      continue;
+    }
+    auto dictionary = object->GetDict();
+    if (!dictionary) {
+      continue;
+    }
+    if (dictionary->KeyExist("JS") || dictionary->KeyExist("JavaScript") ||
+        dictionary->KeyExist("OpenAction") || dictionary->KeyExist("AA") ||
+        dictionary->KeyExist("XFA") ||
+        dictionary->GetNameFor("Type") == "Sig" ||
+        dictionary->GetNameFor("FT") == "Sig" ||
+        (dictionary->GetNameFor("Subtype") == "Widget" &&
+         dictionary->KeyExist("A")) ||
+        dictionary->GetNameFor("S") == "JavaScript") {
+      return false;
+    }
+    if (dictionary->size() > 100000 - edges) {
+      return false;
+    }
+    edges += dictionary->size();
+    for (const auto &[key, value] : CPDF_DictionaryLocker(dictionary)) {
+      pending.emplace_back(value);
+    }
+  }
+  return true;
+}
+
