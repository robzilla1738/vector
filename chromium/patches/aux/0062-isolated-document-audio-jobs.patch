+class PdfDocument final : public FPDF_FORMFILLINFO {
+ public:
+  PdfDocument() : FPDF_FORMFILLINFO{} {
+    version = 2;
+    m_pJsPlatform = nullptr;
+    xfa_disabled = true;
+    FFI_Invalidate = [](FPDF_FORMFILLINFO*, FPDF_PAGE, double, double, double,
+                        double) {};
+    FFI_GetPage = [](FPDF_FORMFILLINFO* info, FPDF_DOCUMENT,
+                     int index) -> FPDF_PAGE {
+      const auto* self = static_cast<PdfDocument*>(info);
+      return index >= 0 && index < static_cast<int>(self->pages.size())
+                 ? self->pages[index].get()
+                 : nullptr;
+    };
+    FFI_GetCurrentPage = [](FPDF_FORMFILLINFO* info,
+                            FPDF_DOCUMENT) -> FPDF_PAGE {
+      auto* self = static_cast<PdfDocument*>(info);
+      return self->pages.empty() ? nullptr
+                                 : self->pages[self->current_page].get();
+    };
+    FFI_GetRotation = [](FPDF_FORMFILLINFO*, FPDF_PAGE page) {
+      return FPDFPage_GetRotation(page);
+    };
+  }
+  ~PdfDocument() {
+    if (form) {
+      for (const auto& page : pages) {
+        FORM_OnBeforeClosePage(page.get(), form.get());
+      }
+      form.reset();
+    }
+  }
+  bool Load(base::span<const uint8_t> bytes, std::string& failure) {
+    document.reset(FPDF_LoadMemDocument64(bytes.data(), bytes.size(), nullptr));
+    if (!document) {
+      failure = FPDF_GetLastError() == FPDF_ERR_PASSWORD
+                    ? "Encrypted PDFs are unsupported."
+                    : "Invalid PDF input.";
+      return false;
+    }
+    if (FPDF_GetSecurityHandlerRevision(document.get()) != -1) {
+      failure = "Encrypted PDFs are unsupported.";
+      return false;
+    }
+    const int count = FPDF_GetPageCount(document.get());
+    const int form_type = FPDF_GetFormType(document.get());
+    if (count < 1 || count > kPages ||
+        (form_type != FORMTYPE_NONE && form_type != FORMTYPE_ACRO_FORM)) {
+      failure = "Unsupported PDF page count or XFA form.";
+      return false;
+    }
+    if (!IsInertPdf(document.get())) {
+      failure =
+          "PDF scripts, automatic/additional actions, signatures or "
+          "excessive object graphs are unsupported.";
+      return false;
+    }
+    for (int index = 0; index < count; ++index) {
+      ScopedFPDFPage page(FPDF_LoadPage(document.get(), index));
+      if (!page) {
+        failure = "A PDF page could not be loaded.";
+        return false;
+      }
+      pages.push_back(std::move(page));
+    }
+    form.reset(FPDFDOC_InitFormFillEnvironment(document.get(), this));
+    if (!form) {
+      failure = "PDF form environment is unavailable.";
+      return false;
+    }
+    FPDF_SetFormFieldHighlightAlpha(form.get(), 0);
+    for (const auto& page : pages) {
+      FORM_OnAfterLoadPage(page.get(), form.get());
+    }
+    return ReadFields(failure);
+  }
+  bool ReadFields(std::string& failure) {
+    fields.clear();
+    std::set<std::string> names;
+    for (size_t page_index = 0; page_index < pages.size(); ++page_index) {
+      FPDF_PAGE page = pages[page_index].get();
+      const int count = FPDFPage_GetAnnotCount(page);
+      if (count < 0 || count > 10000) {
+        failure = "Invalid or excessive PDF annotations.";
+        return false;
+      }
+      for (int index = 0; index < count; ++index) {
+        ScopedFPDFAnnotation annotation(FPDFPage_GetAnnot(page, index));
+        if (!annotation) {
+          failure = "A PDF annotation could not be read.";
+          return false;
+        }
+        if (FPDFAnnot_GetSubtype(annotation.get()) != FPDF_ANNOT_WIDGET) {
+          continue;
+        }
+        if (fields.size() >= kFields) {
+          failure = "PDF field limit exceeded.";
+          return false;
+        }
+        Field field;
+        field.page = static_cast<int>(page_index);
+        field.annotation = index;
+        field.type = FPDFAnnot_GetFormFieldType(form.get(), annotation.get());
+        field.flags = FPDFAnnot_GetFormFieldFlags(form.get(), annotation.get());
+        if ((field.flags & FPDF_FORMFLAG_TEXT_PASSWORD) ||
+            field.type == FPDF_FORMFIELD_SIGNATURE) {
+          failure = "Password and signature fields are unsupported.";
+          return false;
+        }
+        auto name = ReadString(annotation.get(), true);
+        auto value = ReadString(annotation.get(), false);
+        if (!name || !value || name->empty() || name->size() > 512 ||
+            !names.insert(*name).second ||
+            !FPDFAnnot_GetRect(annotation.get(), &field.rectangle)) {
+          failure =
+              "PDF fields have invalid, excessive or ambiguous names/values.";
+          return false;
+        }
+        field.name = std::move(*name);
+        field.value = field.type == FPDF_FORMFIELD_CHECKBOX
+                          ? base::Value(!!FPDFAnnot_IsChecked(form.get(),
+                                                              annotation.get()))
+                          : base::Value(std::move(*value));
+        fields.push_back(std::move(field));
+      }
+    }
+    return true;
+  }
+  std::optional<std::string> ReadString(FPDF_ANNOTATION annotation, bool name) {
+    auto read = name ? FPDFAnnot_GetFormFieldName : FPDFAnnot_GetFormFieldValue;
+    const unsigned long bytes = read(form.get(), annotation, nullptr, 0);
+    const size_t limit = name ? 512 : 4096;
+    if (bytes < 2 || bytes % 2 || bytes > (limit + 1) * 2) {
+      return std::nullopt;
+    }
+    std::vector<FPDF_WCHAR> buffer(bytes / 2);
+    if (read(form.get(), annotation, buffer.data(), bytes) != bytes ||
+        buffer.back() != 0) {
+      return std::nullopt;
+    }
+    std::u16string text;
+    for (size_t index = 0; index + 1 < buffer.size(); ++index) {
+      if (buffer[index] == 0) {
+        return std::nullopt;
+      }
+      text.push_back(static_cast<char16_t>(buffer[index]));
+    }
+    std::string utf8;
+    if (!base::UTF16ToUTF8(text.data(), text.size(), &utf8) ||
+        utf8.size() > limit) {
+      return std::nullopt;
+    }
+    return utf8;
+  }
+  ScopedFPDFDocument document;
+  std::vector<ScopedFPDFPage> pages;
+  ScopedFPDFFormHandle form;
+  std::vector<Field> fields;
+  size_t current_page = 0;
+};
+
+struct PdfWriter final : FPDF_FILEWRITE {
+  PdfWriter() : FPDF_FILEWRITE{} {
+    version = 1;
+    WriteBlock = [](FPDF_FILEWRITE* writer, const void* data,
+                    unsigned long size) {
+      auto* self = static_cast<PdfWriter*>(writer);
+      if (size > kOutputBytes - self->bytes.size()) {
+        return 0;
+      }
+      // PDFium owns this read-only block for the duration of the callback.
+      const auto block =
+          UNSAFE_BUFFERS(base::span(static_cast<const uint8_t*>(data), size));
+      self->bytes.insert(self->bytes.end(), block.begin(), block.end());
+      return 1;
+    };
+  }
+  std::vector<uint8_t> bytes;
+};
+std::optional<std::vector<uint8_t>> Save(FPDF_DOCUMENT document) {
+  PdfWriter writer;
+  if (!FPDF_SaveAsCopy(document, &writer, FPDF_NO_INCREMENTAL) ||
+      writer.bytes.empty()) {
+    return std::nullopt;
+  }
+  return std::move(writer.bytes);
+}
+
+bool Keys(const base::DictValue& value,
+          std::initializer_list<std::string_view> allowed) {
+  return std::ranges::all_of(value, [&](const auto& entry) {
+    return std::ranges::find(allowed, entry.first) != allowed.end();
+  });
+}
+std::optional<std::vector<int>> Pages(const base::Value* value,
+                                      int count,
+                                      bool all = false) {
+  std::vector<int> result;
+  if (!value && all) {
+    result.resize(count);
+    std::iota(result.begin(), result.end(), 0);
+    return result;
+  }
+  const auto* list = value ? value->GetIfList() : nullptr;
+  if (!list || list->empty() || list->size() > kPages) {
+    return std::nullopt;
+  }
+  for (const auto& item : *list) {
+    auto page = item.GetIfInt();
+    if (!page || *page < 1 || *page > count) {
+      return std::nullopt;
+    }
+    result.push_back(*page - 1);
+  }
+  return result;
+}
+
+struct Raster {
+  ScopedFPDFBitmap bitmap;
+  int width = 0;
+  int height = 0;
+  base::span<const uint8_t> Bytes() const {
+    const int stride = FPDFBitmap_GetStride(bitmap.get());
+    return UNSAFE_BUFFERS(base::span(
+        static_cast<const uint8_t*>(FPDFBitmap_GetBuffer(bitmap.get())),
+        static_cast<size_t>(stride) * height));
+  }
+};
+std::optional<Raster> Render(PdfDocument& document,
+                             int index,
+                             double scale,
+                             const Field* field = nullptr,
+                             bool widgets = true) {
+  FPDF_PAGE page = document.pages[index].get();
+  const double page_width = std::ceil(FPDF_GetPageWidthF(page) * scale);
+  const double page_height = std::ceil(FPDF_GetPageHeightF(page) * scale);
+  if (!std::isfinite(page_width) || !std::isfinite(page_height) ||
+      page_width < 1 || page_height < 1 || page_width > kSide ||
+      page_height > kSide) {
+    return std::nullopt;
+  }
+  const int full_width = static_cast<int>(page_width);
+  const int full_height = static_cast<int>(page_height);
+  int left = 0, top = 0, right = full_width, bottom = full_height;
+  if (field) {
+    const auto& rect = field->rectangle;
+    if (!std::isfinite(rect.left) || !std::isfinite(rect.right) ||
+        !std::isfinite(rect.top) || !std::isfinite(rect.bottom) ||
+        rect.right <= rect.left || rect.top <= rect.bottom) {
+      return std::nullopt;
+    }
+    int x1, y1, x2, y2;
+    if (!FPDF_PageToDevice(page, 0, 0, full_width, full_height, 0, rect.left,
+                           rect.top, &x1, &y1) ||
+        !FPDF_PageToDevice(page, 0, 0, full_width, full_height, 0, rect.right,
+                           rect.bottom, &x2, &y2)) {
+      return std::nullopt;
+    }
+    left = std::min(x1, x2);
+    right = std::max(x1, x2);
+    top = std::min(y1, y2);
+    bottom = std::max(y1, y2);
+    if (left < 0 || top < 0 || right > full_width || bottom > full_height) {
+      return std::nullopt;
+    }
+  }
+  const int width = right - left;
+  const int height = bottom - top;
+  if (width < 1 || height < 1 ||
+      static_cast<int64_t>(width) * height > kPixels) {
+    return std::nullopt;
+  }
+  Raster raster{ScopedFPDFBitmap(FPDFBitmap_Create(width, height, 1)), width,
+                height};
+  if (!raster.bitmap || !FPDFBitmap_FillRect(raster.bitmap.get(), 0, 0, width,
+                                             height, 0xffffffff)) {
+    return std::nullopt;
+  }
+  FPDF_RenderPageBitmap(raster.bitmap.get(), page, -left, -top, full_width,
+                        full_height, 0, field ? 0 : FPDF_ANNOT);
+  if (widgets) {
+    FPDF_FFLDraw(document.form.get(), raster.bitmap.get(), page, -left, -top,
+                 full_width, full_height, 0, 0);
+  }
+  return raster;
+}
+struct Appearance {
+  std::string hash;
+  bool ink = false;
+};
+std::optional<Appearance> WidgetAppearance(PdfDocument& document,
+                                           const Field& field) {
+  auto raster = Render(document, field.page, 1, &field);
+  auto background = Render(document, field.page, 1, &field, false);
+  if (!raster || !background ||
+      raster->Bytes().size() != background->Bytes().size()) {
+    return std::nullopt;
+  }
+  return Appearance{Hash(raster->Bytes()),
+                    !std::ranges::equal(raster->Bytes(), background->Bytes())};
+}
+bool Overlapping(const Field& field, const std::vector<Field>& fields) {
+  return std::ranges::any_of(fields, [&](const Field& other) {
+    return field.name != other.name && field.page == other.page &&
+           std::max(field.rectangle.left, other.rectangle.left) <
+               std::min(field.rectangle.right, other.rectangle.right) &&
+           std::max(field.rectangle.bottom, other.rectangle.bottom) <
+               std::min(field.rectangle.top, other.rectangle.top);
+  });
+}
+base::DictValue FieldReport(const Field& field) {
+  return base::DictValue()
+      .Set("name", field.name)
+      .Set("page", field.page + 1)
+      .Set("type", field.type == FPDF_FORMFIELD_TEXTFIELD  ? "text"
+                   : field.type == FPDF_FORMFIELD_CHECKBOX ? "checkbox"
+                                                           : "unsupported")
+      .Set("readOnly", !!(field.flags & FPDF_FORMFLAG_READONLY))
+      .Set("value", field.value.Clone());
+}
+void Mapping(base::ListValue& mappings,
+             int output,
+             int page,
+             int source,
+             int source_page,
+             int rotation) {
+  mappings.Append(base::DictValue()
+                      .Set("outputIndex", output)
+                      .Set("page", page + 1)
+                      .Set("sourceIndex", source)
+                      .Set("sourcePage", source_page + 1)
+                      .Set("rotation", rotation * 90));
+}
+bool AddOutput(JobResult& result,
+               std::vector<uint8_t> bytes,
+               std::string media_type,
+               std::string label) {
+  size_t total = 0;
+  for (const auto& output : result.outputs) {
+    total += output.bytes.size();
+  }
+  if (result.outputs.size() >= 40 || bytes.empty() ||
+      bytes.size() > kOutputBytes - total) {
+    return false;
+  }
+  result.outputs.push_back(
+      {std::move(bytes), std::move(media_type), std::move(label)});
+  return true;
+}
+
+bool Meaningful(const base::Value& value) {
+  if (value.is_bool()) {
+    return value.GetBool();
+  }
+  return std::ranges::any_of(value.GetString(), [](char ch) {
+    return ch != ' ' && ch != '\n' && ch != '\r' && ch != '\t';
+  });
+}
+bool SetFieldValue(PdfDocument& document,
+                   const Field& field,
+                   const base::Value& value) {
+  document.current_page = field.page;
+  FPDF_PAGE page = document.pages[field.page].get();
+  ScopedFPDFAnnotation annotation(FPDFPage_GetAnnot(page, field.annotation));
+  if (!annotation ||
+      FPDFAnnot_GetFormControlCount(document.form.get(), annotation.get()) !=
+          1 ||
+      !FORM_SetFocusedAnnot(document.form.get(), annotation.get())) {
+    return false;
+  }
+  if (field.type == FPDF_FORMFIELD_TEXTFIELD) {
+    if (!FORM_SelectAllText(document.form.get(), page)) {
+      return false;
+    }
+    std::vector<FPDF_WCHAR> utf16;
+    for (unsigned char ch : value.GetString()) {
+      utf16.push_back(ch);
+    }
+    utf16.push_back(0);
+    FORM_ReplaceSelection(document.form.get(), page, utf16.data());
+  } else if (!!FPDFAnnot_IsChecked(document.form.get(), annotation.get()) !=
+                 value.GetBool() &&
+             !FORM_OnChar(document.form.get(), page, ' ', 0)) {
+    return false;
+  }
+  return FORM_ForceToKillFocus(document.form.get());
+}
+JobResult Fill(PdfDocument& document,
+               const base::DictValue& options,
+               JobResult result) {
+  const auto* values = options.FindList("values");
+  if (!values || values->empty() || values->size() > 100) {
+    return Failed("Fill requires between one and 100 unique field values.");
+  }
+  struct Change {
+    Field original;
+    base::Value value;
+    Appearance before;
+    Appearance blank;
+    Appearance filled;
+  };
+  std::vector<Change> changes;
+  std::set<std::string> names;
+  for (const auto& item : *values) {
+    const auto* value = item.GetIfDict();
+    const auto* name = value ? value->FindString("name") : nullptr;
+    const auto* desired = value ? value->Find("value") : nullptr;
+    if (!value || !Keys(*value, {"name", "value"}) || !name || name->empty() ||
+        name->size() > 512 || name->find('\0') != std::string::npos ||
+        !names.insert(*name).second || !desired) {
+      return Failed("Fill contains an invalid or duplicate field name.");
+    }
+    const auto found = std::ranges::find(document.fields, *name, &Field::name);
+    if (found == document.fields.end()) {
+      return Failed("A requested PDF field does not exist.");
+    }
+    const Field& field = *found;
+    if ((field.flags & FPDF_FORMFLAG_READONLY) ||
+        Overlapping(field, document.fields)) {
+      return Failed("Read-only or overlapping PDF widgets cannot be filled.");
+    }
+    if (field.type == FPDF_FORMFIELD_TEXTFIELD) {
+      const auto* text = desired->GetIfString();
+      if (!text || text->size() > 4096 ||
+          std::ranges::any_of(*text,
+                              [](unsigned char ch) {
+                                return (ch < 32 && ch != '\n' && ch != '\r' &&
+                                        ch != '\t') ||
+                                       ch > 126;
+                              }) ||
+          (!(field.flags & FPDF_FORMFLAG_TEXT_MULTILINE) &&
+           text->find_first_of("\r\n") != std::string::npos)) {
+        return Failed(
+            "This PDF fill supports printable ASCII text and "
+            "multiline field line breaks; unsupported "
+            "fonts/characters require a different document.");
+      }
+    } else if (field.type != FPDF_FORMFIELD_CHECKBOX || !desired->is_bool()) {
+      return Failed(
+          "Only text and checkbox fields with matching value types "
+          "can be filled.");
+    }
+    auto before = WidgetAppearance(document, field);
+    if (!before) {
+      return Failed(
+          "A PDF widget appearance exceeds rendering limits or "
+          "cannot be verified.");
+    }
+    changes.push_back(
+        {Field{field.name, field.page, field.annotation, field.type,
+               field.flags, field.rectangle, field.value.Clone()},
+         desired->Clone(),
+         std::move(*before),
+         {},
+         {}});
+  }
+  std::vector<base::Value> original_values;
+  for (const Field& field : document.fields) {
+    original_values.push_back(field.value.Clone());
+  }
+  for (auto& change : changes) {
+    const base::Value blank =
+        change.value.is_bool() ? base::Value(false) : base::Value("");
+    if (!SetFieldValue(document, change.original, blank)) {
+      return Failed(
+          "The PDF field could not be cleared for appearance verification.");
+    }
+    auto appearance = WidgetAppearance(document, change.original);
+    if (!appearance) {
+      return Failed("The blank PDF widget appearance could not be verified.");
+    }
+    change.blank = std::move(*appearance);
+    if (!SetFieldValue(document, change.original, change.value)) {
+      return Failed("The PDF field edit could not be committed.");
+    }
+  }
+  std::string failure;
+  if (!document.ReadFields(failure)) {
+    return Failed(failure);
+  }
+  for (auto& change : changes) {
+    const auto found =
+        std::ranges::find(document.fields, change.original.name, &Field::name);
+    if (found == document.fields.end() || found->value != change.value) {
+      return Failed("PDFium did not retain the exact requested field value.");
+    }
+    auto filled = WidgetAppearance(document, *found);
+    if (!filled ||
+        (Meaningful(change.value) &&
+         (!filled->ink || filled->hash == change.blank.hash)) ||
+        (change.original.value != change.value &&
+         (Meaningful(change.original.value) || Meaningful(change.value)) &&
+         filled->hash == change.before.hash)) {
+      return Failed(
+          "The filled PDF widget is blank or its expected appearance "
+          "change could not be proven.");
+    }
+    change.filled = std::move(*filled);
+  }
+  auto bytes = Save(document.document.get());
+  if (!bytes) {
+    return Failed("The filled PDF could not be saved within the output limit.");
+  }
+  PdfDocument reopened;
+  if (!reopened.Load(*bytes, failure) ||
+      reopened.pages.size() != document.pages.size() ||
+      reopened.fields.size() != document.fields.size()) {
+    return Failed(
+        "The saved filled PDF could not be reopened with its "
+        "original pages and fields.");
+  }
+  base::ListValue fields;
+  for (size_t index = 0; index < reopened.fields.size(); ++index) {
+    const Field& field = reopened.fields[index];
+    const Field& expected = document.fields[index];
+    if (field.name != expected.name || field.type != expected.type ||
+        field.page != expected.page || field.flags != expected.flags ||
+        field.value != expected.value ||
+        (!names.contains(field.name) &&
+         field.value != original_values[index])) {
+      return Failed(
+          "Saved PDF field verification failed or an unrelated field changed.");
+    }
+    base::DictValue report = FieldReport(field);
+    for (const auto& change : changes) {
+      if (change.original.name != field.name) {
+        continue;
+      }
+      auto appearance = WidgetAppearance(reopened, field);
+      if (!appearance || appearance->hash != change.filled.hash ||
+          (Meaningful(change.value) && !appearance->ink)) {
+        return Failed(
+            "Saved PDF widget appearance does not match the verified "
+            "filled rendering.");
+      }
+      report.Set("appearanceSha256", appearance->hash);
+    }
+    fields.Append(std::move(report));
+  }
+  base::ListValue mappings;
+  for (size_t index = 0; index < reopened.pages.size(); ++index) {
+    const int rotation = FPDFPage_GetRotation(document.pages[index].get());
+    if (rotation < 0 ||
+        FPDFPage_GetRotation(reopened.pages[index].get()) != rotation) {
+      return Failed("Saved PDF page rotation verification failed.");
+    }
+    Mapping(mappings, 0, index, 0, index, rotation);
+  }
+  if (!AddOutput(result, std::move(*bytes), "application/pdf", "filled.pdf")) {
+    return Failed("Filled PDF output limit exceeded.");
+  }
+  result.report.Set("pageMappings", std::move(mappings));
+  result.report.Set("fields", std::move(fields));
+  result.report.Set("appearancesVerified", true);
+  return result;
+}
+
+bool VerifyPages(FPDF_DOCUMENT document,
+                 const std::vector<std::pair<PdfDocument*, int>>& sources) {
+  if (FPDF_GetPageCount(document) != static_cast<int>(sources.size())) {
+    return false;
+  }
+  for (size_t index = 0; index < sources.size(); ++index) {
+    ScopedFPDFPage page(FPDF_LoadPage(document, index));
+    FPDF_PAGE source = sources[index].first->pages[sources[index].second].get();
+    if (!page ||
+        FPDFPage_GetRotation(page.get()) != FPDFPage_GetRotation(source) ||
+        FPDF_GetPageWidthF(page.get()) != FPDF_GetPageWidthF(source) ||
+        FPDF_GetPageHeightF(page.get()) != FPDF_GetPageHeightF(source)) {
+      return false;
+    }
+  }
+  return true;
+}
+}  // namespace
+
+JobResult ExecutePdf(const std::vector<base::span<const uint8_t>>& sources,
+                     const base::DictValue& options) {
+  const auto* operation = options.FindString("operation");
+  if (!operation || sources.empty() || sources.size() > 8) {
+    return Failed("Invalid PDF operation or source count.");
+  }
+  const bool merge = *operation == "merge";
+  if ((!merge && sources.size() != 1) ||
+      (*operation != "render" && *operation != "text" &&
+       *operation != "fields" && *operation != "fill" && !merge &&
+       *operation != "split" && *operation != "rotate")) {
+    return Failed("Unsupported PDF operation or source count.");
+  }
+  if ((*operation == "render" &&
+       !Keys(options, {"operation", "pages", "scale"})) ||
+      (*operation == "text" && !Keys(options, {"operation", "pages"})) ||
+      (*operation == "fields" && !Keys(options, {"operation"})) ||
+      (*operation == "fill" && !Keys(options, {"operation", "values"})) ||
+      (merge && !Keys(options, {"operation", "inputs"})) ||
+      (*operation == "split" && !Keys(options, {"operation", "groups"})) ||
+      (*operation == "rotate" &&
+       !Keys(options, {"operation", "pages", "degrees"}))) {
+    return Failed("Unknown PDF operation options.");
+  }
+  size_t total_bytes = 0;
+  for (const auto& source : sources) {
+    if (source.empty() || source.size() > kSourceBytes - total_bytes) {
+      return Failed("PDF source byte limit exceeded.");
+    }
+    total_bytes += source.size();
+  }
+  PdfLibrary library;
+  std::vector<std::unique_ptr<PdfDocument>> documents;
+  base::ListValue source_hashes;
+  int total_pages = 0;
+  size_t total_fields = 0;
+  std::string failure;
+  for (const auto& source : sources) {
+    auto document = std::make_unique<PdfDocument>();
+    if (!document->Load(source, failure)) {
+      return Failed(failure);
+    }
+    total_pages += document->pages.size();
+    total_fields += document->fields.size();
+    if (total_pages > kPages || total_fields > kFields) {
+      return Failed(
+          "The combined PDF source page or field limit was exceeded.");
+    }
+    source_hashes.Append(Hash(source));
+    documents.push_back(std::move(document));
+  }
+  JobResult result;
+  result.report.Set("kind", "pdf");
+  result.report.Set("sourceSha256", std::move(source_hashes));
+  result.report.Set("pageCount", total_pages);
+  PdfDocument& first = *documents[0];
+  base::ListValue mappings;
+  if (*operation == "fields") {
+    base::ListValue fields;
+    for (const auto& field : first.fields) {
+      fields.Append(FieldReport(field));
+    }
+    result.report.Set("fields", std::move(fields));
+    return result;
+  }
+  if (*operation == "fill") {
+    return Fill(first, options, std::move(result));
+  }
+  if (*operation == "render" || *operation == "text") {
+    auto selected =
+        Pages(options.Find("pages"), first.pages.size(), *operation == "text");
+    if (!selected || (*operation == "render" && selected->size() > 20)) {
+      return Failed("Invalid PDF page selection.");
+    }
+    if (*operation == "render") {
+      const auto scale = options.FindDouble("scale");
+      if ((options.Find("scale") && !scale) ||
+          (scale && (!std::isfinite(*scale) || *scale < 0.25 || *scale > 4))) {
+        return Failed("Invalid PDF render scale.");
+      }
+      for (int index : *selected) {
+        auto raster = Render(first, index, scale.value_or(1));
+        if (!raster) {
+          return Failed(
+              "PDF rendering exceeded the 16MP/16384px bounds or failed.");
+        }
+        auto png = gfx::PNGCodec::Encode(
+            raster->Bytes().data(), gfx::PNGCodec::FORMAT_BGRA,
+            gfx::Size(raster->width, raster->height),
+            FPDFBitmap_GetStride(raster->bitmap.get()), true, {});
+        if (!png ||
+            !AddOutput(result, std::move(*png), "image/png",
+                       "page-" + base::NumberToString(index + 1) + ".png")) {
+          return Failed(
+              "Rendered PDF output limit exceeded or PNG encoding failed.");
+        }
+        const int rotation = FPDFPage_GetRotation(first.pages[index].get());
+        if (rotation < 0) {
+          return Failed("Invalid PDF page rotation.");
+        }
+        Mapping(mappings, result.outputs.size() - 1, 0, 0, index, rotation);
+      }
+    } else {
+      std::string text;
+      for (int index : *selected) {
+        ScopedFPDFTextPage text_page(
+            FPDFText_LoadPage(first.pages[index].get()));
+        const int count = text_page ? FPDFText_CountChars(text_page.get()) : -1;
+        if (count < 0 || count > static_cast<int>(kTextBytes)) {
+          return Failed("PDF text extraction failed or exceeded its limit.");
+        }
+        for (int character = 0; character < count; ++character) {
+          unsigned int code = FPDFText_GetUnicode(text_page.get(), character);
+          if (code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) {
+            return Failed("PDF contains invalid text encoding.");
+          }
+          base::WriteUnicodeCharacter(code ? code : 0xfffd, &text);
+          if (text.size() >= kTextBytes) {
+            return Failed("PDF text exceeds the 2MB limit.");
+          }
+        }
+        if (text.size() >= kTextBytes) {
+          return Failed("PDF text exceeds the 2MB limit.");
+        }
+        text.push_back('\n');
+        const int rotation = FPDFPage_GetRotation(first.pages[index].get());
+        if (rotation < 0) {
+          return Failed("Invalid PDF page rotation.");
+        }
+        Mapping(mappings, 0, mappings.size(), 0, index, rotation);
+      }
+      result.report.Set("text", text);
+      std::vector<uint8_t> bytes(text.begin(), text.end());
+      if (!AddOutput(result, std::move(bytes), "text/plain", "extracted.txt")) {
+        return Failed("PDF text output limit exceeded.");
+      }
+    }
+    result.report.Set("pageMappings", std::move(mappings));
+    return result;
+  }
+  if (*operation == "rotate") {
+    auto selected = Pages(options.Find("pages"), first.pages.size());
+    const auto degrees = options.FindInt("degrees");
+    if (!selected || !degrees ||
+        (*degrees != 90 && *degrees != 180 && *degrees != 270) ||
+        std::set<int>(selected->begin(), selected->end()).size() !=
+            selected->size()) {
+      return Failed("Invalid or duplicate PDF rotation pages/degrees.");
+    }
+    for (int index : *selected) {
+      const int rotation = FPDFPage_GetRotation(first.pages[index].get());
+      if (rotation < 0) {
+        return Failed("Invalid PDF page rotation.");
+      }
+      FPDFPage_SetRotation(first.pages[index].get(),
+                           (rotation + *degrees / 90) % 4);
+    }
+    auto bytes = Save(first.document.get());
+    if (!bytes) {
+      return Failed("Rotated PDF save failed or exceeded its output limit.");
+    }
+    PdfDocument reopened;
+    std::vector<std::pair<PdfDocument*, int>> expected;
+    for (size_t index = 0; index < first.pages.size(); ++index) {
+      expected.emplace_back(&first, index);
+      Mapping(mappings, 0, index, 0, index,
+              FPDFPage_GetRotation(first.pages[index].get()));
+    }
+    if (!reopened.Load(*bytes, failure) ||
+        !VerifyPages(reopened.document.get(), expected) ||
+        !AddOutput(result, std::move(*bytes), "application/pdf",
+                   "rotated.pdf")) {
+      return Failed("Rotated PDF reopening/page verification failed.");
+    }
+    result.report.Set("pageMappings", std::move(mappings));
+    return result;
+  }
+
+  const auto* groups = options.FindList(merge ? "inputs" : "groups");
+  if (!groups || groups->empty() || groups->size() > (merge ? 8u : 20u) ||
+      (merge && groups->size() < 2)) {
+    return Failed("Invalid PDF merge inputs or split groups.");
+  }
+  // PDFium page import does not copy an AcroForm's document-level field tree.
+  // Refuse rather than silently discarding interactive field identity/values.
+  for (const auto& document : documents) {
+    if (!document->fields.empty()) {
+      return Failed(
+          "Merging or splitting interactive forms is unsupported; "
+          "original fields were preserved.");
+    }
+  }
+  ScopedFPDFDocument merged(merge ? FPDF_CreateNewDocument() : nullptr);
+  int output_pages = 0;
+  int destination_page = 0;
+  for (size_t group_index = 0; group_index < groups->size(); ++group_index) {
+    const auto& group = (*groups)[group_index];
+    int source_index = 0;
+    const base::Value* selection = &group;
+    if (merge) {
+      const auto* input = group.GetIfDict();
+      const auto index = input ? input->FindInt("sourceIndex") : std::nullopt;
+      if (!input || !Keys(*input, {"sourceIndex", "pages"}) || !index ||
+          *index < 0 || *index >= static_cast<int>(documents.size())) {
+        return Failed("Invalid PDF merge source identity.");
+      }
+      source_index = *index;
+      selection = input->Find("pages");
+    }
+    PdfDocument& source = *documents[source_index];
+    auto selected = Pages(selection, source.pages.size(), merge);
+    if (!selected ||
+        selected->size() > static_cast<size_t>(kPages - output_pages)) {
+      return Failed("PDF output page selection exceeds its limit.");
+    }
+    output_pages += selected->size();
+    ScopedFPDFDocument split(merge ? nullptr : FPDF_CreateNewDocument());
+    FPDF_DOCUMENT destination = merge ? merged.get() : split.get();
+    if (!destination ||
+        !FPDF_ImportPagesByIndex(destination, source.document.get(),
+                                 selected->data(), selected->size(),
+                                 merge ? destination_page : 0)) {
+      return Failed("PDF page import failed.");
+    }
+    std::vector<std::pair<PdfDocument*, int>> expected;
+    for (int page : *selected) {
+      const int rotation = FPDFPage_GetRotation(source.pages[page].get());
+      if (rotation < 0) {
+        return Failed("Invalid source PDF rotation.");
+      }
+      Mapping(mappings, merge ? 0 : group_index,
+              merge ? destination_page++ : expected.size(), source_index, page,
+              rotation);
+      expected.emplace_back(&source, page);
+    }
+    if (!merge) {
+      auto bytes = Save(destination);
+      PdfDocument reopened;
+      if (!bytes || !reopened.Load(*bytes, failure) ||
+          !VerifyPages(reopened.document.get(), expected) ||
+          !AddOutput(
+              result, std::move(*bytes), "application/pdf",
+              "split-" + base::NumberToString(group_index + 1) + ".pdf")) {
+        return Failed("Split PDF save/reopening/page verification failed.");
+      }
+    }
+  }
+  if (merge) {
+    auto bytes = Save(merged.get());
+    PdfDocument reopened;
+    std::vector<std::pair<PdfDocument*, int>> expected;
+    for (const auto& mapping : mappings) {
+      const auto& entry = mapping.GetDict();
+      expected.emplace_back(documents[*entry.FindInt("sourceIndex")].get(),
+                            *entry.FindInt("sourcePage") - 1);
+    }
+    if (!bytes || !reopened.Load(*bytes, failure) ||
+        !VerifyPages(reopened.document.get(), expected) ||
+        !AddOutput(result, std::move(*bytes), "application/pdf",
+                   "merged.pdf")) {
+      return Failed("Merged PDF save/reopening/page verification failed.");
+    }
+  }
+  result.report.Set("pageCount", output_pages);
+  result.report.Set("pageMappings", std::move(mappings));
+  return result;
+}
