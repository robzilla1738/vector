+base::DictValue LocatedSegment(const mojom::Segment& segment) {
+  base::DictValue locator;
+  if (segment.locator->is_text()) {
+    const auto& value = *segment.locator->get_text();
+    locator.Set("kind", "text");
+    locator.Set("line", static_cast<double>(value.line));
+    locator.Set("offset", static_cast<double>(value.offset));
+  } else if (segment.locator->is_pdf()) {
+    const auto& value = *segment.locator->get_pdf();
+    locator.Set("kind", "pdf");
+    locator.Set("page", static_cast<double>(value.page));
+    locator.Set("block", static_cast<double>(value.block));
+    locator.Set("offset", static_cast<double>(value.offset));
+  } else {
+    const auto& value = *segment.locator->get_docx();
+    locator.Set("kind", "docx");
+    locator.Set("part", value.part);
+    locator.Set("paragraph", static_cast<double>(value.paragraph));
+    locator.Set("offset", static_cast<double>(value.offset));
+    if (value.heading_level) {
+      locator.Set("headingLevel", value.heading_level);
+    }
+    if (value.table) {
+      locator.Set("table", static_cast<double>(value.table));
+      locator.Set("row", static_cast<double>(value.row));
+      locator.Set("column", static_cast<double>(value.column));
+    }
+    if (value.note_id) {
+      locator.Set("noteId", *value.note_id);
+    }
+  }
+  return base::DictValue()
+      .Set("locator", std::move(locator))
+      .Set("text", segment.text);
+}
+base::DictValue LocatedMetadata(const mojom::Metadata& metadata) {
+  constexpr std::array<std::string_view, 3> formats = {"text", "pdf", "docx"};
+  constexpr std::array<std::string_view, 5> codes = {
+      "no_selectable_text", "unmapped_text", "external_relationships_ignored",
+      "embedded_content_ignored", "unsupported_markup_ignored"};
+  constexpr std::array<std::string_view, 7> stories = {
+      "", "body", "header", "footer", "footnote", "endnote", "comment"};
+  base::DictValue result;
+  result.Set("format", formats[static_cast<size_t>(metadata.format)]);
+  if (metadata.page_count) {
+    result.Set("pageCount", static_cast<double>(metadata.page_count));
+  }
+  base::ListValue warnings;
+  for (const auto& warning : metadata.warnings) {
+    base::DictValue value;
+    value.Set("code", codes[static_cast<size_t>(warning->code)]);
+    value.Set("count", static_cast<double>(warning->count));
+    if (warning->story != mojom::Story::kNone) {
+      value.Set("story", stories[static_cast<size_t>(warning->story)]);
+    }
+    if (warning->first_page) {
+      value.Set("firstPage", static_cast<double>(warning->first_page));
+    }
+    if (!warning->first_part.empty()) {
+      value.Set("firstPart", warning->first_part);
+    }
+    warnings.Append(std::move(value));
+  }
+  result.Set("warnings", std::move(warnings));
+  result.Set(
+      "completed",
+      base::DictValue()
+          .Set("textSha256", metadata.completed->text_sha256)
+          .Set("textBytes", static_cast<double>(metadata.completed->text_bytes))
+          .Set("segmentCount",
+               static_cast<double>(metadata.completed->segment_count)));
+  return result;
+}
