+std::string Stream(std::string_view data, std::string_view dictionary = "") {
+  return "<< /Length " + base::NumberToString(data.size()) + " " +
+         std::string(dictionary) + " >>\nstream\n" + std::string(data) +
+         "\nendstream";
+}
+std::vector<uint8_t> Pdf(const std::vector<std::string>& objects) {
+  std::string pdf = "%PDF-1.7\n";
+  std::vector<size_t> offsets;
+  for (size_t index = 0; index < objects.size(); ++index) {
+    offsets.push_back(pdf.size());
+    pdf += base::NumberToString(index + 1) + " 0 obj\n" + objects[index] +
+           "\nendobj\n";
+  }
+  const size_t xref = pdf.size();
+  pdf += "xref\n0 " + base::NumberToString(objects.size() + 1) +
+         "\n0000000000 65535 f \n";
+  for (size_t offset : offsets) {
+    pdf += base::StringPrintf("%010zu 00000 n \n", offset);
+  }
+  pdf += "trailer\n<< /Size " + base::NumberToString(objects.size() + 1) +
+         " /Root 1 0 R >>\nstartxref\n" + base::NumberToString(xref) +
+         "\n%%EOF\n";
+  return {pdf.begin(), pdf.end()};
+}
+std::vector<uint8_t> PagesPdf() {
+  return Pdf({"<< /Type /Catalog /Pages 2 0 R >>",
+              "<< /Type /Pages /Kids [3 0 R 4 0 R] /Count 2 >>",
+              "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 100 100] "
+              "/Resources << /Font << /F1 7 0 R >> >> /Contents 5 0 R >>",
+              "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 100] "
+              "/Resources << /Font << /F1 7 0 R >> >> /Contents 6 0 R >>",
+              Stream("BT /F1 12 Tf 10 50 Td (Page one) Tj ET"),
+              Stream("BT /F1 12 Tf 10 50 Td (Page two) Tj ET"),
+              "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"});
+}
+std::vector<uint8_t> FormPdf(std::string_view extra = "") {
+  return Pdf(
+      {"<< /Type /Catalog /Pages 2 0 R /AcroForm << /Fields [5 0 R 6 0 R] "
+       "/DR << /Font << /Helv 7 0 R >> >> /DA (/Helv 12 Tf 0 g) >> >>",
+       "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
