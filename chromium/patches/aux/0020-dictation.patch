+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_DICTATION_MAC_H_
+#define CHROME_BROWSER_UI_AUX_DICTATION_MAC_H_
+
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace aux {
+
+// Owns only the shell's transient microphone session. Audio and transcription
+// never enter the Aux runtime, browser Profile storage, or a network service.
+class DictationMac final : public content::WebContentsObserver {
+ public:
+  using EventCallback = base::RepeatingCallback<void(const std::string&)>;
+
+  DictationMac(content::WebContents* contents, EventCallback on_event);
+  ~DictationMac() override;
+  DictationMac(const DictationMac&) = delete;
+  DictationMac& operator=(const DictationMac&) = delete;
+
+  static base::DictValue Status();
+  bool Start(const std::string& session_id);
+  bool Stop(const std::string& session_id);
+  bool Cancel(const std::string& session_id);
+  void CancelAll();
+
+ private:
+  struct Impl;
+
+  bool IsCurrent(const std::string& session_id) const;
+  void AuthorizeSpeech(const std::string& session_id);
+  void AuthorizeMicrophone(const std::string& session_id);
+  void BeginCapture(const std::string& session_id);
+  void ReceiveResult(const std::string& session_id,
+                     const std::string& text,
+                     bool final,
+                     bool error);
+  void Finish(const std::string& session_id,
+              const char* type,
+              const char* message = nullptr);
+  void Emit(const std::string& session_id,
+            const char* type,
+            const char* message = nullptr);
+  void StopAudio();
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* handle) override;
+  void OnVisibilityChanged(content::Visibility visibility) override;
+  void WebContentsDestroyed() override;
+
+  EventCallback on_event_;
+  std::string owner_id_;
+  std::string session_id_;
+  std::string text_;
+  bool recording_ = false;
+  bool stopping_ = false;
+  bool tapped_ = false;
+  bool audio_ended_ = false;
+  std::unique_ptr<Impl> impl_;
+  base::OneShotTimer capture_timer_;
+  base::OneShotTimer finish_timer_;
+  base::WeakPtrFactory<DictationMac> weak_factory_{this};
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_DICTATION_MAC_H_
diff --git a/chrome/browser/ui/aux/dictation_mac.mm b/chrome/browser/ui/aux/dictation_mac.mm
new file mode 100644
index 0000000000..b3251b8fdf
--- /dev/null
+++ b/chrome/browser/ui/aux/dictation_mac.mm
@@ -0,0 +1,354 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/dictation_mac.h"
+
+#import <AVFoundation/AVFoundation.h>
+#import <Speech/Speech.h>
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/uuid.h"
+#include "chrome/browser/ui/aux/dictation_session.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+
+namespace aux {
+namespace {
+
+DictationSessionGate& GlobalGate() {
+  static base::NoDestructor<DictationSessionGate> gate;
+  return *gate;
+}
+
+constexpr char kUnavailable[] =
+    "On-device dictation is unavailable for the current language.";
+constexpr char kSpeechDenied[] =
+    "Allow Speech Recognition for Aux in System Settings → Privacy & Security.";
+constexpr char kMicrophoneDenied[] =
+    "Allow Microphone access for Aux in System Settings → Privacy & Security.";
+
+}  // namespace
+
+struct DictationMac::Impl {
+  SFSpeechRecognizer* __strong recognizer = nil;
+  SFSpeechAudioBufferRecognitionRequest* __strong request = nil;
+  SFSpeechRecognitionTask* __strong task = nil;
+  AVAudioEngine* __strong engine = nil;
+};
+
+DictationMac::DictationMac(content::WebContents* contents,
+                           EventCallback on_event)
+    : content::WebContentsObserver(contents),
+      on_event_(std::move(on_event)),
+      owner_id_(base::Uuid::GenerateRandomV4().AsLowercaseString()) {}
+
+DictationMac::~DictationMac() {
+  CancelAll();
+}
+
+base::DictValue DictationMac::Status() {
+  SFSpeechRecognizer* recognizer =
+      [[SFSpeechRecognizer alloc] initWithLocale:[NSLocale currentLocale]];
+  const bool available = recognizer && recognizer.supportsOnDeviceRecognition;
+  base::DictValue result;
+  result.Set("available", available);
+  result.Set("language", base::SysNSStringToUTF8(
+                             recognizer.locale.localeIdentifier ?: @""));
+  if (!available) {
+    result.Set("reason", kUnavailable);
+  }
+  return result;
+}
+
+bool DictationMac::IsCurrent(const std::string& session_id) const {
+  return !session_id_.empty() && session_id_ == session_id &&
+         GlobalGate().IsCurrent(owner_id_, session_id);
+}
+
+bool DictationMac::Start(const std::string& session_id) {
+  if (!web_contents() ||
+      web_contents()->GetVisibility() != content::Visibility::VISIBLE ||
+      !Status().FindBool("available").value_or(false) ||
+      !GlobalGate().Begin(owner_id_, session_id)) {
+    return false;
+  }
+  session_id_ = session_id;
+  text_.clear();
+  recording_ = false;
+  stopping_ = false;
+  audio_ended_ = false;
+  impl_ = std::make_unique<Impl>();
+  impl_->recognizer =
+      [[SFSpeechRecognizer alloc] initWithLocale:[NSLocale currentLocale]];
+  if (!impl_->recognizer || !impl_->recognizer.supportsOnDeviceRecognition) {
+    Finish(session_id, "error", kUnavailable);
+    return false;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&DictationMac::AuthorizeSpeech,
+                                weak_factory_.GetWeakPtr(), session_id));
+  return true;
+}
+
+void DictationMac::AuthorizeSpeech(const std::string& session_id) {
+  const auto status = [SFSpeechRecognizer authorizationStatus];
+  if (status == SFSpeechRecognizerAuthorizationStatusAuthorized) {
+    AuthorizeMicrophone(session_id);
+    return;
+  }
+  if (status != SFSpeechRecognizerAuthorizationStatusNotDetermined) {
+    Finish(session_id, "error", kSpeechDenied);
+    return;
+  }
+  base::WeakPtr<DictationMac> weak = weak_factory_.GetWeakPtr();
+  [SFSpeechRecognizer
+      requestAuthorization:^(SFSpeechRecognizerAuthorizationStatus granted) {
+        dispatch_async(dispatch_get_main_queue(), ^{
+          if (!weak || !weak->IsCurrent(session_id)) {
+            return;
+          }
+          if (granted == SFSpeechRecognizerAuthorizationStatusAuthorized) {
+            weak->AuthorizeMicrophone(session_id);
+          } else {
+            weak->Finish(session_id, "error", kSpeechDenied);
+          }
+        });
+      }];
+}
+
+void DictationMac::AuthorizeMicrophone(const std::string& session_id) {
+  const auto status =
+      [AVCaptureDevice authorizationStatusForMediaType:AVMediaTypeAudio];
+  if (status == AVAuthorizationStatusAuthorized) {
+    BeginCapture(session_id);
+    return;
+  }
+  if (status != AVAuthorizationStatusNotDetermined) {
+    Finish(session_id, "error", kMicrophoneDenied);
+    return;
+  }
+  base::WeakPtr<DictationMac> weak = weak_factory_.GetWeakPtr();
+  [AVCaptureDevice
+      requestAccessForMediaType:AVMediaTypeAudio
+              completionHandler:^(BOOL granted) {
+                dispatch_async(dispatch_get_main_queue(), ^{
+                  if (!weak || !weak->IsCurrent(session_id)) {
+                    return;
+                  }
+                  if (granted) {
+                    weak->BeginCapture(session_id);
+                  } else {
+                    weak->Finish(session_id, "error", kMicrophoneDenied);
+                  }
+                });
+              }];
+}
+
+void DictationMac::BeginCapture(const std::string& session_id) {
+  if (!IsCurrent(session_id) || stopping_ || !web_contents() ||
+      web_contents()->GetVisibility() != content::Visibility::VISIBLE) {
+    CancelAll();
+    return;
+  }
+  if (!impl_->recognizer.isAvailable) {
+    Finish(session_id, "error",
+           "Speech recognition is temporarily unavailable.");
+    return;
+  }
+  impl_->request = [[SFSpeechAudioBufferRecognitionRequest alloc] init];
+  impl_->request.requiresOnDeviceRecognition = YES;
+  impl_->request.shouldReportPartialResults = YES;
+  impl_->engine = [[AVAudioEngine alloc] init];
+  AVAudioInputNode* input = impl_->engine.inputNode;
+  AVAudioFormat* format = [input outputFormatForBus:0];
+  if (!input || !format || format.sampleRate <= 0 || format.channelCount == 0) {
+    Finish(session_id, "error", "No microphone input is available.");
+    return;
+  }
+
+  SFSpeechAudioBufferRecognitionRequest* request = impl_->request;
+  [input installTapOnBus:0
+              bufferSize:1024
+                  format:format
+                   block:^(AVAudioPCMBuffer* buffer, AVAudioTime* when) {
+                     [request appendAudioPCMBuffer:buffer];
+                   }];
+  tapped_ = true;
+
+  base::WeakPtr<DictationMac> weak = weak_factory_.GetWeakPtr();
+  impl_->task = [impl_->recognizer
+      recognitionTaskWithRequest:impl_->request
+                   resultHandler:^(SFSpeechRecognitionResult* result,
+                                   NSError* error) {
+                     NSString* partial =
+                         result.bestTranscription.formattedString;
+                     if (partial.length > 20000) {
+                       partial = [partial substringToIndex:20000];
+                     }
+                     const std::string text =
+                         base::SysNSStringToUTF8(partial ?: @"");
+                     const bool final = result.isFinal;
+                     const bool failed = error != nil;
+                     dispatch_async(dispatch_get_main_queue(), ^{
+                       if (weak) {
+                         weak->ReceiveResult(session_id, text, final, failed);
+                       }
+                     });
+                   }];
+  if (!impl_->task) {
+    Finish(session_id, "error", "On-device dictation could not start.");
+    return;
+  }
+  NSError* start_error = nil;
+  [impl_->engine prepare];
+  if (![impl_->engine startAndReturnError:&start_error]) {
+    Finish(session_id, "error",
+           "The microphone could not start. Check microphone access.");
+    return;
+  }
+  recording_ = true;
+  Emit(session_id, "recording");
+  capture_timer_.Start(
+      FROM_HERE, base::Seconds(60),
+      base::BindOnce(
+          [](base::WeakPtr<DictationMac> weak, std::string id) {
+            if (weak) {
+              weak->Stop(id);
+            }
+          },
+          weak_factory_.GetWeakPtr(), session_id));
+}
+
+void DictationMac::ReceiveResult(const std::string& session_id,
+                                 const std::string& text,
+                                 bool final,
+                                 bool error) {
+  if (!IsCurrent(session_id)) {
+    return;
+  }
+  if (!text.empty()) {
+    text_ = text;
+    Emit(session_id, "transcript");
+  }
+  if (final) {
+    Finish(session_id, "final");
+  } else if (error) {
+    Finish(session_id, stopping_ && !text_.empty() ? "final" : "error",
+           stopping_ && !text_.empty()
+               ? nullptr
+               : "Dictation stopped. Check your microphone and try again.");
+  }
+}
+
+void DictationMac::StopAudio() {
+  if (!impl_ || audio_ended_) {
+    return;
+  }
+  audio_ended_ = true;
+  [impl_->engine stop];
+  if (tapped_) {
+    [impl_->engine.inputNode removeTapOnBus:0];
+    tapped_ = false;
+  }
+  [impl_->request endAudio];
+}
+
+bool DictationMac::Stop(const std::string& session_id) {
+  if (!IsCurrent(session_id) ||
+      !GlobalGate().MarkStopping(owner_id_, session_id)) {
+    return false;
+  }
+  stopping_ = true;
+  capture_timer_.Stop();
+  StopAudio();
+  Emit(session_id, "finishing");
+  if (!recording_) {
+    Finish(session_id, "final");
+    return true;
+  }
+  finish_timer_.Start(
+      FROM_HERE, base::Seconds(3),
+      base::BindOnce(&DictationMac::Finish, weak_factory_.GetWeakPtr(),
+                     session_id, "final", nullptr));
+  return true;
+}
+
+bool DictationMac::Cancel(const std::string& session_id) {
+  if (!IsCurrent(session_id)) {
+    return false;
+  }
+  CancelAll();
+  return true;
+}
+
+void DictationMac::CancelAll() {
+  if (session_id_.empty()) {
+    return;
+  }
+  weak_factory_.InvalidateWeakPtrs();
+  GlobalGate().EndOwner(owner_id_);
+  session_id_.clear();
+  capture_timer_.Stop();
+  finish_timer_.Stop();
+  StopAudio();
+  [impl_->task cancel];
+  impl_.reset();
+  text_.clear();
+  recording_ = false;
+  stopping_ = false;
+  audio_ended_ = false;
+}
+
+void DictationMac::Finish(const std::string& session_id,
+                          const char* type,
+                          const char* message) {
+  if (!IsCurrent(session_id)) {
+    return;
+  }
+  Emit(session_id, type, message);
+  CancelAll();
+}
+
+void DictationMac::Emit(const std::string& session_id,
+                        const char* type,
+                        const char* message) {
+  if (!IsCurrent(session_id) || on_event_.is_null()) {
+    return;
+  }
+  base::DictValue event;
+  event.Set("sessionId", session_id);
+  event.Set("type", type);
+  if (!text_.empty()) {
+    event.Set("text", text_);
+  }
+  if (message) {
+    event.Set("message", message);
+  }
+  on_event_.Run(*base::WriteJson(event));
+}
+
+void DictationMac::DidFinishNavigation(content::NavigationHandle* handle) {
+  if (handle->IsInPrimaryMainFrame() && handle->HasCommitted()) {
+    CancelAll();
+  }
+}
+
+void DictationMac::OnVisibilityChanged(content::Visibility visibility) {
+  if (visibility != content::Visibility::VISIBLE) {
+    CancelAll();
+  }
+}
+
+void DictationMac::WebContentsDestroyed() {
+  CancelAll();
+}
+
+}  // namespace aux
