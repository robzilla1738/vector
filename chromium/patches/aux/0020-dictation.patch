@@ -0,0 +1,55 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/dictation_session.h"
+
+#include "base/uuid.h"
+
+namespace aux {
+
+bool DictationSessionGate::Begin(const std::string& owner,
+                                 const std::string& session_id) {
+  if (!owner_.empty() || !base::Uuid::ParseLowercase(owner).is_valid() ||
+      !base::Uuid::ParseLowercase(session_id).is_valid()) {
+    return false;
+  }
+  owner_ = owner;
+  session_id_ = session_id;
+  stopping_ = false;
+  return true;
+}
+
+bool DictationSessionGate::IsCurrent(const std::string& owner,
+                                     const std::string& session_id) const {
+  return !owner_.empty() && owner_ == owner && session_id_ == session_id;
+}
+
+bool DictationSessionGate::MarkStopping(const std::string& owner,
+                                        const std::string& session_id) {
+  if (!IsCurrent(owner, session_id) || stopping_) {
+    return false;
+  }
+  stopping_ = true;
+  return true;
+}
+
+bool DictationSessionGate::End(const std::string& owner,
+                               const std::string& session_id) {
+  if (!IsCurrent(owner, session_id)) {
+    return false;
+  }
+  EndOwner(owner);
+  return true;
+}
+
+void DictationSessionGate::EndOwner(const std::string& owner) {
+  if (owner_ != owner) {
+    return;
+  }
+  owner_.clear();
+  session_id_.clear();
+  stopping_ = false;
+}
+
+}  // namespace aux
