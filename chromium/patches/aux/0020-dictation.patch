+void WebUIBrowserUI::HandleAuxDictationRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  const base::ListValue* list = &args;
+  if (method == "dictationStatus") {
+    if (!list->empty()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid dictation status request");
+      return;
+    }
+    std::move(callback).Run(
+        true, *base::WriteJson(aux::DictationMac::Status()), "", "");
+    return;
+  }
+  if (method == "startDictation" || method == "stopDictation" ||
+      method == "cancelDictation") {
+    if (list->size() != 1 || !(*list)[0].is_string()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid dictation session request");
+      return;
+    }
+    const std::string& id = (*list)[0].GetString();
+    if (method == "startDictation" && !dictation_) {
+      dictation_ = std::make_unique<aux::DictationMac>(
+          web_ui()->GetWebContents(),
+          base::BindRepeating(
+              [](base::WeakPtr<WebUIBrowserUI> ui,
+                 const std::string& event_json) {
+                if (ui && ui->IsAuthorizedAuxDocument() &&
+                    ui->shell_host_client_.is_bound() &&
+                    ui->web_ui()->GetWebContents()->GetVisibility() ==
+                        content::Visibility::VISIBLE) {
+                  ui->shell_host_client_->OnEvent("onDictation", event_json);
+                }
+              },
+              weak_factory_.GetWeakPtr()));
+    }
+    bool result = false;
+    if (dictation_) {
+      if (method == "startDictation") {
+        result = dictation_->Start(id);
+      } else if (method == "stopDictation") {
+        result = dictation_->Stop(id);
+      } else {
+        result = dictation_->Cancel(id);
+      }
+    }
+    std::move(callback).Run(true, *base::WriteJson(base::Value(result)), "", "");
+    return;
+  }
+  std::move(callback).Run(false, "", "not_found",
+                          "Unsupported Aux shell method: " + method);
+}
