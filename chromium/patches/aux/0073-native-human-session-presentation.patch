+bool EgressController::CanPresentHumanSessionDocument(
+    const EgressRequestContext& context) {
+  if (profile_->IsOffTheRecord() || context.ambiguous) return false;
+  const auto state = pages_.find(context.page_id);
+  auto* frame = context.document.AsRenderFrameHostIfValid();
+  if (state == pages_.end() || !frame ||
+      state->second->human_session_document.AsRenderFrameHostIfValid() != frame)
+    return false;
+  auto* page = content::WebContents::FromRenderFrameHost(frame);
+  const auto* identity = page ? PageIdentity::FromWebContents(page) : nullptr;
+  if (!page || !frame->GetSiteInstance() ||
+      !frame->GetStoragePartition()->GetConfig().is_default() ||
+      !frame->GetSiteInstance()->GetSecurityPrincipal()
+           .GetStoragePartitionConfig().is_default())
+    return false;
+  return page->GetBrowserContext() == profile_ && identity &&
+      identity->id() == context.page_id && !identity->runtime_owned() &&
+      page->GetPrimaryMainFrame() == frame;
+}
