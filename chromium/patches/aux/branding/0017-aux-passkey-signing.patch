+                             '--identity', 'Developer ID Application: Fixture',
+                             '--aux-passkey-team-id', 'ABCDEFGHIJ',
+                             '--aux-passkey-profile', profile.name])
+        self.assertEqual(0, sign_all.call_count)
+
+    def test_aux_passkey_config_accepts_approved_aux_path(self, sign_all, **kwargs):
+        class AuxConfig(test_config.TestConfig):
+            @property
+            def base_bundle_id(self):
+                return 'dev.aux.browser'
+
+        with tempfile.NamedTemporaryFile() as profile:
+            with mock.patch('signing.config_factory.get_class', lambda: AuxConfig):
+                driver.main(['--input', '/input', '--output', '/output',
+                             '--identity', 'Developer ID Application: Fixture',
+                             '--aux-passkey-team-id', 'ABCDEFGHIJ',
+                             '--aux-passkey-profile', profile.name])
+                self.assertEqual(profile.name,
+                                 sign_all.call_args.args[1].aux_passkey_profile)
+
     def test_required_arguments(self, sign_all, **kwargs):
         with self.assertRaises(SystemExit):
             driver.main([])
