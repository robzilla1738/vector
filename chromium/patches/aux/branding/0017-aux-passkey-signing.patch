+    def test_aux_passkey_rejects_partial_or_development_config(self, sign_all, **kwargs):
+        base = ['--input', '/input', '--output', '/output', '--identity', '-']
+        with self.assertRaises(SystemExit):
+            driver.main(base + ['--aux-passkey-team-id', 'ABCDEFGHIJ'])
+        with tempfile.NamedTemporaryFile() as profile:
+            with self.assertRaises(SystemExit):
+                driver.main(base + ['--aux-passkey-team-id', 'ABCDEFGHIJ',
+                                    '--aux-passkey-profile', profile.name])
+        self.assertEqual(0, sign_all.call_count)
+
+    def test_aux_passkey_rejects_other_browser_identity(self, sign_all, **kwargs):
+        with tempfile.NamedTemporaryFile() as profile:
