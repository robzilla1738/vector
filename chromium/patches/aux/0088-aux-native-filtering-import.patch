+// Copyright 2026 Aux Authors. BSD-3-Clause; see //LICENSE.
+// Independent bounded filter engine: docs/spec/native/adblock-import F1-F4.
+#ifndef COMPONENTS_AUX_ADBLOCK_ENGINE_H_
+#define COMPONENTS_AUX_ADBLOCK_ENGINE_H_
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+namespace aux_adblock {
+struct Source {
+  std::string id, text;
+};
+struct Request {
+  GURL url, initiator;
+  std::string type, method = "GET";
+  bool third_party = false;
+};
+struct Decision {
+  bool block = false, important = false, has_filter = false,
+       has_exception = false;
+  std::string filter, exception, redirect, rewritten_url, source_id;
+  int source_line = 0;
+  base::DictValue ToValue() const;
+};
+class Engine {
+ public:
+  static std::shared_ptr<const Engine> Compile(
+      const std::vector<Source>& sources);
+  ~Engine();
+  Engine(const Engine&) = delete;
+  Engine& operator=(const Engine&) = delete;
+  Decision Evaluate(const Request& request) const;
+  base::DictValue Cosmetics(const GURL& document) const;
+  base::ListValue RegexDiagnostics() const;
+  size_t rule_count() const { return rules_.size(); }
+  const base::ListValue& diagnostics() const { return diagnostics_; }
+
+ private:
+  struct Rule;
+  struct Cosmetic;
+  Engine();
+  std::vector<std::unique_ptr<Rule>> rules_;
+  std::map<std::string, std::vector<const Rule*>> host_index_;
+  std::vector<const Rule*> global_rules_;
+  std::vector<std::unique_ptr<Cosmetic>> cosmetics_;
+  base::ListValue diagnostics_;
+};
+bool ValidSubscriptionURL(const GURL& url);
+}  // namespace aux_adblock
+#endif
diff --git a/components/aux_adblock/engine_probe.cc b/components/aux_adblock/engine_probe.cc
new file mode 100644
--- /dev/null
+++ b/components/aux_adblock/engine_probe.cc
@@ -0,0 +1,68 @@
+// Copyright 2026 Aux Authors. BSD-3-Clause; see //LICENSE.
+#include <iostream>
+
+#include "base/check.h"
+#include "components/aux_adblock/engine.h"
+int main() {
+  auto engine = aux_adblock::Engine::Compile(
+      {{"fixture", R"RULES(||ads.test^$script,third-party
+@@||ads.test/allowed^$script
+||ads.test/allowed/critical^$script,important
+||rewrite.test^$removeparam=utm_source
+||noop.test^$script,redirect=noopjs
+example.test##.advert
+example.test##.keep
+example.test#@#.keep
+example.test##article:has-text(Sponsor)
+||unknown.test^$unimplemented-option
+/banner\.js$/
+)RULES"}});
+  auto request = [](const char* url, const char* type = "script",
+                    bool third = true) {
+    return aux_adblock::Request{GURL(url), GURL("https://example.test/"), type,
+                                "GET", third};
+  };
+  CHECK(engine->Evaluate(request("https://ads.test/a.js")).block);
+  CHECK(!engine->Evaluate(request("https://ads.test/a.js", "image")).block);
+  CHECK(!engine->Evaluate(request("https://ads.test/a.js", "script", false))
+             .block);
+  auto exception = engine->Evaluate(request("https://ads.test/allowed/a.js"));
+  CHECK(exception.has_exception);
+  CHECK(!exception.block);
+  auto important =
+      engine->Evaluate(request("https://ads.test/allowed/critical/a.js"));
+  CHECK(important.important);
+  CHECK(important.block);
+  CHECK_EQ(
+      engine
+          ->Evaluate(request("https://rewrite.test/path?a=1&utm_source=x&b=2"))
+          .rewritten_url,
+      "https://rewrite.test/path?a=1&b=2");
+  CHECK_EQ(engine->Evaluate(request("https://noop.test/a.js")).redirect,
+           "noopjs");
+  CHECK(engine->Evaluate(request("https://files.test/banner.js")).block);
+  auto cosmetics = engine->Cosmetics(GURL("https://example.test/"));
+  CHECK_EQ(cosmetics.FindList("selectors")->size(), 1u);
+  CHECK_EQ(cosmetics.FindList("procedural")->size(), 1u);
+  CHECK(engine->Cosmetics(GURL("https://other.test/"))
+            .FindList("selectors")
+            ->empty());
+  CHECK_EQ(engine->diagnostics()[0]
+               .GetDict()
+               .FindInt("parseErrorCount")
+               .value_or(-1),
+           1);
+  CHECK(aux_adblock::ValidSubscriptionURL(
+      GURL("https://filters.example.org/list.txt")));
+  for (const auto* url :
+       {"http://filters.example.org/list", "https://127.0.0.1/list",
+        "https://[::1]/list", "https://10.0.0.1/list",
+        "https://example.local/list", "https://x.localhost/list",
+        "https://user:password@example.org/list",
+        "https://example.org/list#fragment"}) {
+    CHECK(!aux_adblock::ValidSubscriptionURL(GURL(url)));
+  }
+  std::cout << "Native engine "
+               "block/exception/important/type/party/rewrite/redirect/regex/"
+               "cosmetic/procedural/URL checks passed\n";
+}
