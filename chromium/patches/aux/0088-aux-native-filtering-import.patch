diff --git a/components/aux_adblock/renderer_observer.cc b/components/aux_adblock/renderer_observer.cc
new file mode 100644
--- /dev/null
+++ b/components/aux_adblock/renderer_observer.cc
@@ -0,0 +1,64 @@
+// Copyright 2026 Aux Authors. BSD-3-Clause; see //LICENSE.
+#include "components/aux_adblock/renderer_observer.h"
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "content/public/renderer/render_frame.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/web_string.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+namespace aux_adblock {
+RendererObserver::RendererObserver(content::RenderFrame* frame, int world)
+    : content::RenderFrameObserver(frame), world_(world) {}
+RendererObserver::~RendererObserver() = default;
+void RendererObserver::OnDestruct() {
+  delete this;
+}
+void RendererObserver::DidCreateDocumentElement() {
+  weak_.InvalidateWeakPtrs();
+  host_.reset();
+  auto url = render_frame()->GetWebFrame()->GetDocument().Url();
+  if (!url.ProtocolIs("http") && !url.ProtocolIs("https")) {
+    return;
+  }
+  render_frame()->GetBrowserInterfaceBroker().GetInterface(
+      host_.BindNewPipeAndPassReceiver());
+  host_->GetResources(
+      base::BindOnce(&RendererObserver::Apply, weak_.GetWeakPtr()));
+}
+void RendererObserver::Apply(const std::string& rules) {
+  if (rules.size() > 2 * 1024 * 1024) {
+    return;
+  }
+  auto value = base::JSONReader::ReadDict(rules, base::JSON_PARSE_RFC);
+  if (!value) {
+    return;
+  }
+  auto json = base::WriteJson(*value);
+  if (!json) {
+    return;
+  }
+  const std::string code =
+      R"JS((()=>{'use strict';const rules=)JS" + *json + R"JS(;
+ const selectors=Array.isArray(rules.selectors)?rules.selectors.slice(0,10000):[];
+ const procedural=Array.isArray(rules.procedural)?rules.procedural.slice(0,1000):[];
+ let paused=false,timer=0,ruleCursor=0,nodeCursor=0;const style=document.createElement('style');
+ const css=[];for(const selector of selectors){if(typeof selector!=='string'||selector.length>2048||/[{}\0]/.test(selector))continue;try{document.querySelector(selector);css.push(selector+'{display:none!important}')}catch{}}
+ style.textContent=css.join('\n');document.documentElement.append(style);
+ const unquote=s=>s.replace(/^(['"])(.*)\1$/,'$2');
+ function pass(){timer=0;if(paused||document.visibilityState==='hidden')return;const start=performance.now();let visited=0;while(ruleCursor<procedural.length){const rule=procedural[ruleCursor];if(!rule||typeof rule.selector!=='string'||typeof rule.value!=='string'){ruleCursor++;nodeCursor=0;continue}let nodes;try{nodes=document.querySelectorAll(rule.selector)}catch{ruleCursor++;nodeCursor=0;continue}while(nodeCursor<nodes.length){if(visited>0&&(visited>=500||performance.now()-start>6)){schedule();return}const node=nodes[nodeCursor++];visited++;let match=false;const text=unquote(rule.value);if(rule.op===':has-text(')match=(node.textContent||'').includes(text);else if(rule.op===':matches-attr('){const i=text.indexOf('=');const name=i<0?text:text.slice(0,i);if(/^[\w:-]+$/.test(name))match=i<0?node.hasAttribute(name):node.getAttribute(name)===unquote(text.slice(i+1));}else if(rule.op===':matches-css('){const i=text.indexOf(':');const name=text.slice(0,i).trim();if(i>0&&/^[a-zA-Z-]+$/.test(name))match=getComputedStyle(node).getPropertyValue(name).trim()===unquote(text.slice(i+1).trim());}if(match&&(node.style.getPropertyValue('display')!=='none'||node.style.getPropertyPriority('display')!=='important'))node.style.setProperty('display','none','important');}ruleCursor++;nodeCursor=0;}ruleCursor=0;nodeCursor=0;}
+
+ function schedule(){if(!paused&&!timer)timer=setTimeout(pass,50)}
+ const observer=new MutationObserver(()=>{if(!style.isConnected&&document.documentElement)document.documentElement.append(style);schedule()});
+ function resume(){paused=false;observer.observe(document,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['class','id','hidden','style','src','href']});schedule()}
+ function suspend(){paused=true;observer.disconnect();clearTimeout(timer);timer=0}
+ addEventListener('pagehide',suspend);document.addEventListener('freeze',suspend);addEventListener('pageshow',resume);document.addEventListener('resume',resume);document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')schedule()});resume();
+})())JS";
+  render_frame()->GetWebFrame()->ExecuteScriptInIsolatedWorld(
+      world_, blink::WebScriptSource(blink::WebString::FromUtf8(code)),
+      blink::BackForwardCacheAware::kAllow);
+}
+}  // namespace aux_adblock
