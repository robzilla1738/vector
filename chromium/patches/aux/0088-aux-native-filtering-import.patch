+// Copyright 2026 Aux Authors. BSD-3-Clause; see //LICENSE.
+// Independent Chromium/Firefox snapshot migrators: adblock-import I1/I2.
+#include "chrome/browser/extensions/api/aux_browser_import/migrator.h"
