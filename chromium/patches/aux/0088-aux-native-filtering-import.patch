+class Host final : public content::DocumentService<mojom::CosmeticHost> {
+ public:
+  Host(content::RenderFrameHost& frame,
+       mojo::PendingReceiver<mojom::CosmeticHost> receiver)
+      : DocumentService(frame, std::move(receiver)) {}
+  void GetResources(GetResourcesCallback callback) override {
+    const auto url = render_frame_host().GetLastCommittedURL();
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      std::move(callback).Run("{}");
+      return;
+    }
+    auto* profile =
+        Profile::FromBrowserContext(render_frame_host().GetBrowserContext());
+    FilterService::Get(profile)->WhenReady(
+        base::BindOnce(&Host::Reply, weak_.GetWeakPtr(), std::move(callback)));
+  }
+
+ private:
+  void Reply(GetResourcesCallback callback) {
+    const auto url = render_frame_host().GetLastCommittedURL();
+    auto* profile =
+        Profile::FromBrowserContext(render_frame_host().GetBrowserContext());
+    std::move(callback).Run(
+        base::WriteJson(FilterService::Get(profile)->Cosmetics(url))
+            .value_or("{}"));
+  }
+  base::WeakPtrFactory<Host> weak_{this};
+};
+}  // namespace
+void BindCosmeticHost(content::RenderFrameHost* frame,
+                      mojo::PendingReceiver<mojom::CosmeticHost> receiver) {
+  if (frame) {
+    new Host(*frame, std::move(receiver));
+  }
+}
