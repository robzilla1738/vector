diff --git a/components/aux_adblock/engine.cc b/components/aux_adblock/engine.cc
new file mode 100644
--- /dev/null
+++ b/components/aux_adblock/engine.cc
@@ -0,0 +1,420 @@
+// Copyright 2026 Aux Authors. BSD-3-Clause; see //LICENSE.
+#include "components/aux_adblock/engine.h"
+
+#include <algorithm>
+#include <atomic>
+#include <set>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "net/base/ip_address.h"
+#include "third_party/re2/src/re2/re2.h"
+namespace aux_adblock {
+namespace {
+bool DomainMatches(std::string_view host, std::string_view domain) {
+  return host == domain || (host.size() > domain.size() &&
+                            host[host.size() - domain.size() - 1] == '.' &&
+                            base::EndsWith(host, domain));
+}
+bool Applies(const std::vector<std::string>& domains, std::string_view host) {
+  bool positive = false, matched = false;
+  for (const auto& domain : domains) {
+    if (domain.starts_with('~')) {
+      if (DomainMatches(host, std::string_view(domain).substr(1))) {
+        return false;
+      }
+    } else {
+      positive = true;
+      matched |= DomainMatches(host, domain);
+    }
+  }
+  return !positive || matched;
+}
+bool SafeSelector(std::string_view selector) {
+  return !selector.empty() && selector.size() <= 2048 &&
+         selector.find('{') == selector.npos &&
+         selector.find('}') == selector.npos &&
+         selector.find('\0') == selector.npos;
+}
+std::optional<std::string> Pattern(std::string_view pattern) {
+  if (pattern.empty() || pattern.size() > 4096) {
+    return std::nullopt;
+  }
+  if (pattern.size() > 2 && pattern.front() == '/' && pattern.back() == '/') {
+    return std::string(pattern.substr(1, pattern.size() - 2));
+  }
+  std::string regex;
+  if (pattern.starts_with("||")) {
+    regex = "^[a-zA-Z][a-zA-Z0-9+.-]*://(?:[^/?#]*\\.)?";
+    pattern.remove_prefix(2);
+  } else if (pattern.starts_with('|')) {
+    regex = "^";
+    pattern.remove_prefix(1);
+  }
+  for (size_t i = 0; i < pattern.size(); ++i) {
+    char c = pattern[i];
+    if (c == '*') {
+      regex += ".*";
+    } else if (c == '^') {
+      regex += "(?:[^A-Za-z0-9_.%-]|$)";
+    } else if (c == '|' && i + 1 == pattern.size()) {
+      regex += "$";
+    } else {
+      if (std::string_view(".[](){}+?\\$|").find(c) != std::string_view::npos) {
+        regex += '\\';
+      }
+      regex += c;
+    }
+  }
+  return regex;
+}
+constexpr std::string_view kTypes[] = {
+    "script",   "image",       "stylesheet", "xmlhttprequest",
+    "document", "subdocument", "websocket",  "font",
+    "media",    "object",      "ping",       "other"};
+}  // namespace
+struct Engine::Rule {
+  mutable std::atomic<uint64_t> uses{0};
+  std::string text, source;
+  int line = 0;
+  bool exception = false, important = false;
+  std::optional<bool> third_party;
+  std::set<std::string> types, excluded;
+  std::vector<std::string> domains;
+  std::unique_ptr<RE2> regex;
+  std::string redirect, remove_param, method;
+};
+struct Engine::Cosmetic {
+  std::vector<std::string> domains;
+  bool exception = false;
+  std::string selector, op, value;
+};
+Engine::Engine() = default;
+Engine::~Engine() = default;
+base::DictValue Decision::ToValue() const {
+  base::DictValue result;
+  result.Set("shouldBlock", block);
+  result.Set("important", important);
+  result.Set("hasFilter", has_filter);
+  result.Set("hasException", has_exception);
+  result.Set("filter", filter);
+  result.Set("exception", exception);
+  result.Set("redirect", redirect);
+  result.Set("rewrittenUrl", rewritten_url);
+  result.Set("sourceId", source_id);
+  result.Set("sourceLine", source_line);
+  return result;
+}
+std::shared_ptr<const Engine> Engine::Compile(
+    const std::vector<Source>& sources) {
+  auto engine = std::shared_ptr<Engine>(new Engine);
+  size_t compiled_memory = 0;
+  for (const auto& source : sources) {
+    int network = 0, cosmetic = 0, line = 0, parse_errors = 0;
+    base::ListValue errors;
+    const auto invalid = [&](std::string_view text) {
+      ++parse_errors;
+      if (errors.size() < 128) {
+        errors.Append("line " + base::NumberToString(line) + ": " +
+                      std::string(text).substr(0, 256));
+      }
+    };
+    for (std::string_view raw : base::SplitStringPiece(
+             source.text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL)) {
+      ++line;
+      if (raw.empty() || raw.front() == '!' || raw.front() == '[') {
+        continue;
+      }
+      if (raw.size() > 8192) {
+        invalid(raw);
+        continue;
+      }
+      size_t sep = raw.find("#@#");
+      bool exception = sep != raw.npos;
+      if (!exception) {
+        sep = raw.find("##");
+      }
+      if (sep != raw.npos) {
+        if (engine->cosmetics_.size() >= 50000) {
+          invalid(raw);
+          continue;
+        }
+        auto rule = std::make_unique<Cosmetic>();
+        rule->exception = exception;
+        rule->domains =
+            base::SplitString(raw.substr(0, sep), ",", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY);
+        std::string_view selector = raw.substr(sep + (exception ? 3 : 2));
+        bool valid = true;
+        for (const auto& op :
+             {":has-text(", ":matches-attr(", ":matches-css("}) {
+          const auto pos = selector.find(op);
+          if (pos == selector.npos) {
+            continue;
+          }
+          if (selector.back() != ')') {
+            valid = false;
+            break;
+          }
+          rule->op = op;
+          rule->value = std::string(selector.substr(
+              pos + std::string_view(op).size(),
+              selector.size() - pos - std::string_view(op).size() - 1));
+          selector = selector.substr(0, pos);
+          break;
+        }
+        if (!valid || !SafeSelector(selector) ||
+            selector.find(":has-text(") != selector.npos ||
+            selector.find(":matches-") != selector.npos ||
+            selector.find("+js(") != selector.npos) {
+          invalid(raw);
+          continue;
+        }
+        rule->selector = std::string(selector);
+        engine->cosmetics_.push_back(std::move(rule));
+        ++cosmetic;
+        continue;
+      }
+      auto rule = std::make_unique<Rule>();
+      rule->text = std::string(raw);
+      rule->source = source.id;
+      rule->line = line;
+      rule->exception = raw.starts_with("@@");
+      if (rule->exception) {
+        raw.remove_prefix(2);
+      }
+      auto dollar = raw.rfind('$');
+      if (raw.starts_with('/') && dollar != raw.npos &&
+          dollar < raw.rfind('/')) {
+        dollar = raw.npos;
+      }
+      auto pattern = raw.substr(0, dollar);
+      bool match_case = false, valid = true;
+      if (dollar != raw.npos) {
+        for (auto option : base::SplitStringPiece(raw.substr(dollar + 1), ",",
+                                                  base::TRIM_WHITESPACE,
+                                                  base::SPLIT_WANT_NONEMPTY)) {
+          bool negate = option.starts_with('~');
+          if (negate) {
+            option.remove_prefix(1);
+          }
+          if (std::ranges::find(kTypes, option) != std::end(kTypes)) {
+            (negate ? rule->excluded : rule->types).insert(std::string(option));
+          } else if (option == "third-party") {
+            rule->third_party = !negate;
+          } else if (option == "important" && !negate) {
+            rule->important = true;
+          } else if (option == "match-case" && !negate) {
+            match_case = true;
+          } else if (option.starts_with("domain=") && !negate) {
+            rule->domains =
+                base::SplitString(option.substr(7), "|", base::TRIM_WHITESPACE,
+                                  base::SPLIT_WANT_NONEMPTY);
+          } else if (option.starts_with("method=") && !negate) {
+            rule->method = base::ToUpperASCII(option.substr(7));
+          } else if (option.starts_with("redirect=") && !negate) {
+            auto value = option.substr(9);
+            if (value != "nooptext" && value != "1x1.gif" &&
+                value != "noopjs") {
+              valid = false;
+            } else {
+              rule->redirect = std::string(value);
+            }
+          } else if (option.starts_with("removeparam=") && !negate) {
+            rule->remove_param = std::string(option.substr(12));
+            if (rule->remove_param.empty() ||
+                rule->remove_param.find_first_not_of(
+                    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz012345"
+                    "6789_-.%") != std::string::npos) {
+              valid = false;
+            }
+          } else {
+            valid = false;
+          }
+        }
+      }
+      auto regex = Pattern(pattern);
+      if (!valid || !regex || engine->rules_.size() >= 50000) {
+        invalid(rule->text);
+        continue;
+      }
+      RE2::Options options;
+      options.set_log_errors(false);
+      options.set_case_sensitive(match_case);
+      options.set_max_mem(64 * 1024);
+      rule->regex = std::make_unique<RE2>(*regex, options);
+      if (!rule->regex->ok()) {
+        invalid(rule->text);
+        continue;
+      }
+      const auto memory = static_cast<size_t>(rule->regex->ProgramSize()) * 64;
+      if (compiled_memory + memory > 64 * 1024 * 1024) {
+        invalid(rule->text);
+        continue;
+      }
+      compiled_memory += memory;
+      std::string host_key;
+      if (pattern.starts_with("||")) {
+        auto host = pattern.substr(2);
+        host = host.substr(
+            0, host.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN"
+                                      "OPQRSTUVWXYZ0123456789.-"));
+        if (!host.empty() && !host.starts_with('.') && !host.ends_with('.')) {
+          host_key = base::ToLowerASCII(host);
+        }
+      }
+      if (host_key.empty()) {
+        engine->global_rules_.push_back(rule.get());
+      } else {
+        engine->host_index_[host_key].push_back(rule.get());
+      }
+      engine->rules_.push_back(std::move(rule));
+      ++network;
+    }
+    base::DictValue diagnostic;
+    diagnostic.Set("id", source.id);
+    diagnostic.Set("networkRuleCount", network);
+    diagnostic.Set("cosmeticRuleCount", cosmetic);
+    diagnostic.Set("parseErrorCount", parse_errors);
+    diagnostic.Set("invalidLines", std::move(errors));
+    engine->diagnostics_.Append(std::move(diagnostic));
+  }
+  return engine;
+}
+Decision Engine::Evaluate(const Request& request) const {
+  Decision decision;
+  const Rule *filter = nullptr, *exception = nullptr;
+  std::vector<const Rule*> candidates = global_rules_;
+  std::string_view host = request.url.host();
+  while (!host.empty()) {
+    if (auto found = host_index_.find(std::string(host));
+        found != host_index_.end()) {
+      candidates.insert(candidates.end(), found->second.begin(),
+                        found->second.end());
+    }
+    auto dot = host.find('.');
+    if (dot == host.npos) {
+      break;
+    }
+    host.remove_prefix(dot + 1);
+  }
+  for (const auto* rule : candidates) {
+    if ((rule->third_party && *rule->third_party != request.third_party) ||
+        (!rule->types.empty() && !rule->types.contains(request.type)) ||
+        rule->excluded.contains(request.type) ||
+        (!rule->method.empty() && rule->method != request.method) ||
+        !Applies(rule->domains, request.initiator.host()) ||
+        !RE2::PartialMatch(request.url.spec(), *rule->regex)) {
+      continue;
+    }
+    rule->uses.fetch_add(1, std::memory_order_relaxed);
+    if (rule->exception) {
+      if (!exception || rule->important) {
+        exception = rule;
+      }
+    } else if (!filter || rule->important) {
+      filter = rule;
+    }
+  }
+  if (filter) {
+    decision.has_filter = true;
+    decision.filter = filter->text;
+    decision.important = filter->important;
+    decision.source_id = filter->source;
+    decision.source_line = filter->line;
+    decision.block = true;
+  }
+  if (exception) {
+    decision.has_exception = true;
+    decision.exception = exception->text;
+    if (!filter || !filter->important || exception->important) {
+      decision.block = false;
+    }
+  }
+  if (decision.block && filter && !filter->redirect.empty()) {
+    decision.redirect = filter->redirect;
+    decision.block = false;
+  }
+  if (decision.block && filter && !filter->remove_param.empty()) {
+    std::string query;
+    for (auto part :
+         base::SplitStringPiece(request.url.query(), "&", base::KEEP_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)) {
+      if (part.substr(0, part.find('=')) == filter->remove_param) {
+        continue;
+      }
+      if (!query.empty()) {
+        query += '&';
+      }
+      query += part;
+    }
+    GURL::Replacements replace;
+    replace.SetQueryStr(query);
+    decision.rewritten_url = request.url.ReplaceComponents(replace).spec();
+    decision.block = false;
+  }
+  return decision;
+}
+base::DictValue Engine::Cosmetics(const GURL& document) const {
+  base::ListValue selectors, procedural;
+  std::set<std::string> exceptions;
+  for (const auto& rule : cosmetics_) {
+    if (rule->exception && Applies(rule->domains, document.host())) {
+      exceptions.insert(rule->selector + rule->op + rule->value);
+    }
+  }
+  for (const auto& rule : cosmetics_) {
+    if (rule->exception || !Applies(rule->domains, document.host()) ||
+        exceptions.contains(rule->selector + rule->op + rule->value)) {
+      continue;
+    }
+    if (rule->op.empty()) {
+      if (selectors.size() < 10000) {
+        selectors.Append(rule->selector);
+      }
+    } else {
+      if (procedural.size() < 1000) {
+        procedural.Append(base::DictValue()
+                              .Set("selector", rule->selector)
+                              .Set("op", rule->op)
+                              .Set("value", rule->value));
+      }
+    }
+  }
+  base::DictValue result;
+  result.Set("selectors", std::move(selectors));
+  result.Set("procedural", std::move(procedural));
+  return result;
+}
+base::ListValue Engine::RegexDiagnostics() const {
+  base::ListValue result;
+  for (const auto& rule : rules_) {
+    if (result.size() >= 256) {
+      break;
+    }
+    base::DictValue row;
+    row.Set("id", static_cast<int>(result.size()));
+    row.Set("usageCount",
+            static_cast<double>(rule->uses.load(std::memory_order_relaxed)));
+    row.Set("regex", rule->regex->pattern());
+    row.Set("compiled", true);
+    result.Append(std::move(row));
+  }
+  return result;
+}
+bool ValidSubscriptionURL(const GURL& url) {
+  if (!url.SchemeIs("https") || url.has_username() || url.has_password() ||
+      url.has_ref() || !url.has_host() || url.host() == "localhost" ||
+      base::EndsWith(url.host(), ".localhost") ||
+      base::EndsWith(url.host(), ".local")) {
+    return false;
+  }
+  net::IPAddress ip;
+  if (ip.AssignFromIPLiteral(url.HostNoBrackets()) &&
+      !ip.IsPubliclyRoutable()) {
+    return false;
+  }
+  return true;
+}
+}  // namespace aux_adblock
