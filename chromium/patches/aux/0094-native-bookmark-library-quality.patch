+base::DictValue ProfileLibrary::ChangeBookmark(const std::string& method,
+                                               const base::DictValue& params) {
+  if (!profile_->GetPrefs()->GetBoolean(
+          bookmarks::prefs::kEditBookmarksEnabled))
+    return Fault("forbidden",
+                 "Bookmark editing is managed by your organization");
+  if (method == "bookmarks.entries.restore") {
+    const std::string* token = params.FindString("undoToken");
+    auto found = std::find_if(
+        removed_bookmarks_.begin(), removed_bookmarks_.end(),
+        [&](const auto& entry) { return token && entry->token == *token; });
+    if (found == removed_bookmarks_.end())
+      return Fault("not_found", "This bookmark can no longer be restored");
+    const auto& entry = **found;
+    const std::string parent_id = base::NumberToString(entry.parent_id);
+    const auto* parent = FolderById(bookmarks_, &parent_id);
+    if (!parent || bookmarks::GetBookmarkNodeByID(bookmarks_, entry.node_id) ||
+        ChildIds(parent) != entry.expected_children ||
+        entry.index > parent->children().size())
+      return Fault("conflict",
+                   "The original folder changed. Undo is unavailable.");
+    bookmarks_->AddURL(parent, entry.index, entry.title, entry.url, &entry.meta,
+                       entry.created_at);
+    removed_bookmarks_.erase(found);
+    return Result(base::Value(FolderSnapshot()));
+  }
+  const auto* node = BookmarkBySource(bookmarks_, params.FindDict("source"));
+  const bool create = method == "bookmarks.entries.create";
+  if (!node && !create)
+    return Fault("conflict",
+                 "The bookmark changed. Open its menu and try again.");
+  if (method == "bookmarks.entries.remove") {
+    auto entry = std::make_unique<RemovedBookmark>();
+    entry->token = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    entry->node_id = node->id();
+    const auto* parent = node->parent();
+    entry->parent_id = parent->id();
+    entry->index = parent->GetIndexOf(node).value();
+    entry->title = node->GetTitle();
+    entry->url = node->url();
+    entry->created_at = node->date_added();
+    if (const auto* meta = node->GetMetaInfoMap())
+      entry->meta = *meta;
+    bookmarks_->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                       FROM_HERE);
+    entry->expected_children = ChildIds(parent);
+    base::DictValue result = base::DictValue()
+                                 .Set("snapshot", FolderSnapshot())
+                                 .Set("undoToken", entry->token);
+    if (removed_bookmarks_.size() == 32)
+      removed_bookmarks_.pop_front();
+    removed_bookmarks_.push_back(std::move(entry));
+    return Result(base::Value(std::move(result)));
+  }
+  const std::string* title = params.FindString("title");
+  const std::string* url = params.FindString("url");
+  if (!title || !url || !GURL(*url).is_valid())
+    return Fault("invalid_params", "Enter a valid bookmark address");
+  const auto* parent = node ? node->parent() : nullptr;
+  size_t index = node ? parent->GetIndexOf(node).value() : 0;
+  if (const auto* destination = params.FindDict("destination")) {
+    parent = FolderById(bookmarks_, destination->FindString("parentId"));
+    const auto* children = destination->FindList("expectedChildren");
+    const auto proposed = destination->FindInt("index");
+    if (!parent || !children || *children != ChildIds(parent) || !proposed ||
+        *proposed < 0 ||
+        static_cast<size_t>(*proposed) > parent->children().size())
+      return Fault("conflict", "The destination changed. Choose it again.");
+    index = static_cast<size_t>(*proposed);
+  }
+  if (create) {
+    if (!parent)
+      return Fault("invalid_params", "Choose a bookmark folder");
+    bookmarks_->AddURL(parent, index, base::UTF8ToUTF16(*title), GURL(*url));
+    return Result(base::Value(FolderSnapshot()));
+  }
+  // Check every guard before editing either the entry or its placement.
+  bookmarks_->SetTitle(node, base::UTF8ToUTF16(*title),
+                       bookmarks::metrics::BookmarkEditSource::kUser);
+  bookmarks_->SetURL(node, GURL(*url),
+                     bookmarks::metrics::BookmarkEditSource::kUser);
+  MoveNode(bookmarks_, node, parent, index);
+  return Result(base::Value(base::DictValue()
+                                .Set("snapshot", FolderSnapshot())
+                                .Set("source", NodeSource(node))));
+}
