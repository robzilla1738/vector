+const bookmarks::BookmarkNode* BookmarkBySource(bookmarks::BookmarkModel* model,
+                                                const base::DictValue* source) {
+  int64_t id = 0;
+  const std::string* node_id = source ? source->FindString("nodeId") : nullptr;
+  if (!node_id || !base::StringToInt64(*node_id, &id) || id <= 0)
+    return nullptr;
+  const auto* node = bookmarks::GetBookmarkNodeByID(model, id);
+  return node && node->is_url() && !model->client()->IsNodeManaged(node) &&
+                 *source == NodeSource(node)
+             ? node
+             : nullptr;
+}
