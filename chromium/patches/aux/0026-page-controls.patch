+#if BUILDFLAG(ENABLE_AUX_SHELL)
+void WebUIBrowserUI::HandleAuxPageControlsRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  const base::ListValue* list = &args;
+  if (method == "memorySaverGet" || method == "memorySaverSet") {
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Memory saver requires a regular profile");
+      return;
+    }
+    const bool set = method == "memorySaverSet";
+    if ((!set && !args.empty()) ||
+        (set && (args.size() != 1 || !args[0].is_int() ||
+                 !aux::TabCatalog::IsMemorySaverMinutes(args[0].GetInt())))) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Choose a supported memory saver interval");
+      return;
+    }
+    auto* catalog = aux::TabCatalog::GetForProfile(profile);
+    if (set && !catalog->MemorySaverSet(args[0].GetInt())) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Memory saver is managed by policy");
+      return;
+    }
+    std::move(callback).Run(true, *base::WriteJson(catalog->MemorySaverGet()),
+                            "", "");
+    return;
+  }
+  if (method == "defaultPageZoom") {
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Default page zoom requires a regular profile");
+      return;
+    }
+    auto* zoom_prefs = profile->GetZoomLevelPrefs();
+    auto* prefs = profile->GetPrefs();
+    const auto* pref = prefs->FindPreference(prefs::kPartitionDefaultZoomLevel);
+    if (!zoom_prefs || !pref) {
+      std::move(callback).Run(false, "", "not_supported",
+                              "Default page zoom is unavailable");
+      return;
+    }
+    if (!list->empty()) {
+      if (pref->IsManaged()) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Default page zoom is managed by policy");
+        return;
+      }
+      if (!(*list)[0].is_int() || (*list)[0].GetInt() < 50 ||
+          (*list)[0].GetInt() > 200) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Choose a page zoom from 50% to 200%");
+        return;
+      }
+      zoom_prefs->SetDefaultZoomLevelPref(
+          blink::ZoomFactorToZoomLevel((*list)[0].GetInt() / 100.0));
+    }
+    base::DictValue result;
+    result.Set("percentage", static_cast<int>(std::round(
+        zoom_prefs->GetDefaultZoomFactor() * 100)));
+    result.Set("managed", pref->IsManaged());
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+    return;
+  }
+  if (method == "keepRuntimeInBackground") {
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Background runtime requires a regular profile");
+      return;
+    }
+    auto* prefs = profile->GetPrefs();
+    const auto* preference =
+        prefs->FindPreference(aux::kKeepRuntimeInBackgroundPref);
+    auto* manager = g_browser_process->background_mode_manager();
+    auto* local_state = g_browser_process->local_state();
+    const bool available = manager && local_state &&
+        local_state->GetBoolean(prefs::kBackgroundModeEnabled);
+    if (!list->empty()) {
+      if (preference->IsManaged()) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Background runtime is managed by policy");
+        return;
+      }
+      if (!(*list)[0].is_bool() || (!available && (*list)[0].GetBool())) {
+        std::move(callback).Run(false, "", "not_supported",
+                                "Browser background mode is unavailable");
+        return;
+      }
+      prefs->SetBoolean(aux::kKeepRuntimeInBackgroundPref,
+                        (*list)[0].GetBool());
+      if ((*list)[0].GetBool())
+        AuxRuntimeHost::ForProfile(profile);
+    }
+    base::DictValue result;
+    result.Set("enabled", prefs->GetBoolean(aux::kKeepRuntimeInBackgroundPref));
+    result.Set("available", available);
+    result.Set("managed", preference->IsManaged());
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+    return;
+  }
+  if (method == "automaticPictureInPicture") {
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Automatic picture-in-picture requires a regular profile");
+      return;
+    }
+    auto* map = HostContentSettingsMapFactory::GetForProfile(profile);
+    constexpr auto type = ContentSettingsType::AUTO_PICTURE_IN_PICTURE;
+    HostContentSettingsMap::ProviderType provider;
+    ContentSetting setting = map->GetDefaultContentSetting(type, &provider);
+    const bool managed = provider == content_settings::ProviderType::kPolicyProvider;
+    if (!list->empty()) {
+      if (managed) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Automatic picture-in-picture is managed by policy");
+        return;
+      }
+      if (!(*list)[0].is_string()) {
+        std::move(callback).Run(false, "", "invalid_argument", "Invalid setting");
+        return;
+      }
+      const std::string& choice = (*list)[0].GetString();
+      if (choice == "ask") setting = CONTENT_SETTING_ASK;
+      else if (choice == "allow") setting = CONTENT_SETTING_ALLOW;
+      else if (choice == "block") setting = CONTENT_SETTING_BLOCK;
+      else {
+        std::move(callback).Run(false, "", "invalid_argument", "Unknown setting");
+        return;
+      }
+      map->SetDefaultContentSetting(type, setting);
+      setting = map->GetDefaultContentSetting(type, &provider);
+    }
+    base::DictValue result;
+    result.Set("mode", setting == CONTENT_SETTING_ALLOW ? "allow" :
+                       setting == CONTENT_SETTING_BLOCK ? "block" : "ask");
+    result.Set("managed", provider == content_settings::ProviderType::kPolicyProvider);
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+    return;
+  }
+  if (method == "languagePreferences") {
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Language preferences require a regular profile");
+      return;
+    }
+    auto* prefs = profile->GetPrefs();
+    const auto* selected_pref =
+        prefs->FindPreference(language::prefs::kSelectedLanguages);
+    if (!selected_pref) {
+      std::move(callback).Run(false, "", "not_supported",
+                              "Language preferences are unavailable");
+      return;
+    }
+    language::LanguagePrefs languages(prefs);
+    if (!list->empty()) {
+      if (selected_pref->IsManaged()) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Languages are managed by policy");
+        return;
+      }
+      if (!(*list)[0].is_list()) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Expected a language list");
+        return;
+      }
+      const base::ListValue& input = (*list)[0].GetList();
+      if (input.empty() || input.size() > 20) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Choose between 1 and 20 languages");
+        return;
+      }
+      std::vector<std::string> selected;
+      std::set<std::string> unique;
+      for (const base::Value& entry : input) {
+        if (!entry.is_string() || entry.GetString().empty() ||
+            !unique.insert(entry.GetString()).second) {
+          std::move(callback).Run(false, "", "invalid_argument",
+                                  "Languages must be distinct valid codes");
+          return;
+        }
+        selected.push_back(entry.GetString());
+      }
+      if (l10n_util::KeepAcceptedLanguages(selected) != selected) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Unsupported language code");
+        return;
+      }
+      languages.SetUserSelectedLanguagesList(selected);
+    }
+    std::vector<std::string> selected;
+    std::vector<std::string> effective;
+    languages.GetUserSelectedLanguagesList(&selected);
+    languages.GetAcceptLanguagesList(&effective);
+    base::ListValue selected_json;
+    base::ListValue effective_json;
+    for (const auto& code : selected) selected_json.Append(code);
+    for (const auto& code : effective) effective_json.Append(code);
+    base::ListValue forced_json =
+        prefs->GetList(language::prefs::kForcedLanguages).Clone();
+    base::DictValue result;
+    result.Set("selected", std::move(selected_json));
+    result.Set("effective", std::move(effective_json));
+    result.Set("forced", std::move(forced_json));
+    result.Set("managed", selected_pref->IsManaged());
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+    return;
+  }
+  if (method == "startupPreferences") {
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Startup preferences require a regular profile");
+      return;
+    }
+    auto* prefs = profile->GetPrefs();
+    const bool managed = SessionStartupPref::TypeIsManaged(prefs) ||
+                         SessionStartupPref::URLsAreManaged(prefs);
+    if (!list->empty()) {
+      if (managed) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Startup preferences are managed by policy");
+        return;
+      }
+      const base::DictValue& input = (*list)[0].GetDict();
+      const std::string* mode = input.FindString("mode");
+      const base::ListValue* urls = input.FindList("urls");
+      if (!mode || !urls || urls->size() > 20) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Invalid startup preferences");
+        return;
+      }
+      SessionStartupPref::Type type;
+      if (*mode == "new-tab") {
+        type = SessionStartupPref::DEFAULT;
+      } else if (*mode == "continue") {
+        type = SessionStartupPref::LAST;
+      } else if (*mode == "pages") {
+        type = SessionStartupPref::URLS;
+      } else if (*mode == "continue-and-pages") {
+        type = SessionStartupPref::LAST_AND_URLS;
+      } else {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Unknown startup mode");
+        return;
+      }
+      if ((type == SessionStartupPref::URLS ||
+           type == SessionStartupPref::LAST_AND_URLS) && urls->empty()) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Add a startup page first");
+        return;
+      }
+      SessionStartupPref next(type);
+      for (const base::Value& value : *urls) {
+        if (!value.is_string()) {
+          std::move(callback).Run(false, "", "invalid_argument",
+                                  "Invalid startup page");
+          return;
+        }
+        const GURL url(value.GetString());
+        if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+            !url.username().empty() || !url.password().empty() ||
+            url.spec().size() > 2048) {
+          std::move(callback).Run(false, "", "invalid_argument",
+                                  "Startup pages must be ordinary web URLs");
+          return;
+        }
+        next.urls.push_back(url);
+      }
+      SessionStartupPref::SetStartupPref(profile, next);
+    }
+    const SessionStartupPref current = SessionStartupPref::GetStartupPref(profile);
+    base::DictValue result;
+    switch (current.type) {
+      case SessionStartupPref::DEFAULT:
+        result.Set("mode", "new-tab");
+        break;
+      case SessionStartupPref::LAST:
+        result.Set("mode", "continue");
+        break;
+      case SessionStartupPref::URLS:
+        result.Set("mode", "pages");
+        break;
+      case SessionStartupPref::LAST_AND_URLS:
+        result.Set("mode", "continue-and-pages");
+        break;
+    }
+    base::ListValue saved_urls;
+    for (const GURL& url : current.urls)
+      saved_urls.Append(url.spec());
+    result.Set("urls", std::move(saved_urls));
+    result.Set("managed", managed);
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+    return;
+  }
+  if (method == "spellCheck") {
+#if BUILDFLAG(ENABLE_SPELLCHECK)
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Spell check settings require a regular profile");
+      return;
+    }
+    auto* prefs = profile->GetPrefs();
+    const auto* pref = prefs->FindPreference(spellcheck::prefs::kSpellCheckEnable);
+    if (!pref) {
+      std::move(callback).Run(false, "", "not_supported",
+                              "Spell check preferences are unavailable");
+      return;
+    }
+    if (!list->empty() && (*list)[0].is_bool()) {
+      if (pref->IsManaged()) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Spell check is managed by policy");
+        return;
+      }
+      prefs->SetBoolean(spellcheck::prefs::kSpellCheckEnable,
+                        (*list)[0].GetBool());
+    }
+    base::DictValue result;
+    result.Set("enabled", prefs->GetBoolean(spellcheck::prefs::kSpellCheckEnable));
+    result.Set("managed", pref->IsManaged());
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+#else
+    std::move(callback).Run(false, "", "not_supported",
+                            "Spell check is unavailable in this build");
+#endif
+    return;
+  }
+  if (method == "downloadFolder" || method == "chooseDownloadFolder") {
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Private downloads use a per-download save location");
+      return;
+    }
+    auto* prefs = DownloadPrefs::FromBrowserContext(profile);
+    if (!prefs) {
+      std::move(callback).Run(false, "", "not_supported",
+                              "Download preferences are unavailable");
+      return;
+    }
+    if (method == "chooseDownloadFolder" && !list->empty() &&
+        (*list)[0].is_bool() && (*list)[0].GetBool()) {
+      if (prefs->IsDownloadPathManaged()) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Download location is managed by policy");
+        return;
+      }
+      prefs->SetDownloadPath(DownloadPrefs::GetDefaultDownloadDirectory());
+    } else if (method == "chooseDownloadFolder") {
+      if (prefs->IsDownloadPathManaged()) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Download location is managed by policy");
+        return;
+      }
+      if (open_file_dialog_) {
+        std::move(callback).Run(false, "", "conflict",
+                                "A file dialog is already open");
+        return;
+      }
+      open_file_dialog_ = ui::SelectFileDialog::Create(
+          this, std::make_unique<ChromeSelectFilePolicy>(
+                    web_ui()->GetWebContents()));
+      if (!open_file_dialog_) {
+        std::move(callback).Run(false, "", "not_supported",
+                                "The system folder dialog is unavailable");
+        return;
+      }
+      file_dialog_purpose_ = FileDialogPurpose::kDownloadFolder;
+      file_dialog_callback_ = std::move(callback);
+      ui::SelectFileDialog::FileTypeInfo file_types;
+      file_types.allowed_paths = ui::SelectFileDialog::FileTypeInfo::NATIVE_PATH;
+      open_file_dialog_->SelectFile(
+          ui::SelectFileDialog::SELECT_FOLDER, std::u16string(),
+          prefs->DownloadPath(), &file_types, 0, base::FilePath::StringType(),
+          browser_->GetWindow()->GetNativeWindow());
+      return;
+    }
+    base::DictValue result;
+    result.Set("path", prefs->DownloadPath().AsUTF8Unsafe());
+    result.Set("custom", prefs->DownloadPath() !=
+                             DownloadPrefs::GetDefaultDownloadDirectory());
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+    return;
+  }
+  if (method == "dismissDownloads") {
+    base::DictValue result;
+    result.Set("removed", aux::DismissDownloads(browser_->GetProfile(), (*list)[0].GetList()));
+    std::move(callback).Run(true, *base::WriteJson(result), "", "");
+    return;
+  }
+  if (method == "downloadsSnapshot") {
+    base::ListValue result;
+    content::DownloadManager::DownloadVector items;
+    if (auto* manager = browser_->GetProfile()->GetDownloadManager()) {
+      manager->GetAllDownloads(&items);
+    }
+    for (download::DownloadItem* item : items) {
+      if (aux::DownloadIsDismissed(browser_->GetProfile(), item)) continue;
+      base::DictValue row;
+      row.Set("id", item->GetGuid());
+      if (!item->GetURL().is_empty())
+        row.Set("sourceUrl", item->GetURL().spec());
+      const std::string filename = item->GetFileNameToReportUser().AsUTF8Unsafe();
+      row.Set("filename", filename.empty() ? "download" : filename);
+      row.Set("path", item->GetTargetFilePath().AsUTF8Unsafe());
+      row.Set("size", static_cast<double>(item->GetReceivedBytes()));
+      if (item->GetTotalBytes() > 0)
+        row.Set("totalBytes", static_cast<double>(item->GetTotalBytes()));
+      row.Set("paused", item->IsPaused());
+      row.Set("canResume", item->CanResume());
+      row.Set("canCancel", item->GetState() == download::DownloadItem::IN_PROGRESS);
+      const char* state = "progressing";
+      switch (item->GetState()) {
+        case download::DownloadItem::COMPLETE: state = "completed"; break;
+        case download::DownloadItem::CANCELLED: state = "cancelled"; break;
+        case download::DownloadItem::INTERRUPTED: state = "interrupted"; break;
+        case download::DownloadItem::IN_PROGRESS:
+          state = item->GetReceivedBytes() == 0 ? "started" : "progressing";
+          break;
+        case download::DownloadItem::MAX_DOWNLOAD_STATE: break;
+      }
+      row.Set("state", state);
+      row.Set("startedAt", static_cast<double>(
+                               item->GetStartTime().InMillisecondsSinceUnixEpoch()));
+      if (item->GetState() != download::DownloadItem::IN_PROGRESS &&
+          !item->GetEndTime().is_null()) {
+        row.Set("endedAt", static_cast<double>(
+                             item->GetEndTime().InMillisecondsSinceUnixEpoch()));
+      }
+      result.Append(std::move(row));
+    }
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+    return;
+  }
+  if (method == "controlDownload" || method == "retryDownload") {
+    auto* manager = browser_->GetProfile()->GetDownloadManager();
+    download::DownloadItem* item = manager && !list->empty() && (*list)[0].is_string()
+        ? manager->GetDownloadByGuid((*list)[0].GetString()) : nullptr;
+    if (!item) {
+      std::move(callback).Run(false, "", "not_found", "Download no longer exists");
+      return;
+    }
+    if (method == "controlDownload") {
+      const std::string& action = (*list)[1].GetString();
+      if (action == "pause" && item->GetState() == download::DownloadItem::IN_PROGRESS)
+        item->Pause();
+      else if (action == "resume" && item->CanResume())
+        item->Resume(true);
+      else if (action == "cancel" && item->GetState() == download::DownloadItem::IN_PROGRESS)
+        item->Cancel(true);
+      else {
+        std::move(callback).Run(false, "", "conflict",
+                                "Download cannot perform this action now");
+        return;
+      }
+    } else {
+      const GURL url = item->GetURL();
+      if ((item->GetState() != download::DownloadItem::INTERRUPTED &&
+           item->GetState() != download::DownloadItem::CANCELLED) ||
+          !url.SchemeIsHTTPOrHTTPS()) {
+        std::move(callback).Run(false, "", "not_supported",
+                                "Retry requires an interrupted HTTP download");
+        return;
+      }
+      static constexpr net::NetworkTrafficAnnotationTag kRetryAnnotation =
+          net::DefineNetworkTrafficAnnotation("aux_user_download_retry", R"(
+            semantics {
+              sender: "Aux Downloads"
+              description: "Retries a download after the user presses Retry."
+              trigger: "The user presses Retry in the Downloads panel."
+              data: "The saved download URL is requested."
+              destination: WEBSITE
+            }
+            policy { cookies_allowed: YES cookies_store: "user" setting: "No separate setting." }
+          )");
+      auto params = std::make_unique<download::DownloadUrlParameters>(
+          url, kRetryAnnotation);
+      params->set_content_initiated(false);
+      params->set_download_source(download::DownloadSource::RETRY_FROM_BUBBLE);
+      manager->DownloadUrl(std::move(params));
+    }
+    std::move(callback).Run(true, "null", "", "");
+    return;
+  }
+  if (method == "createResultPreview") {
+    if (browser_->GetProfile()->IsOffTheRecord() || list->size() != 1 ||
+        !(*list)[0].is_string()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid HTML result preview request");
+      return;
+    }
+    auto url = aux::ResultPreviewStore::Create(
+        web_ui()->GetWebContents(), (*list)[0].GetString());
+    if (!url) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "HTML result preview is unavailable or too large");
+      return;
+    }
+    std::move(callback).Run(true, *base::WriteJson(base::Value(*url)), "", "");
+    return;
+  }
+  if (method == "releaseResultPreview") {
+    if (list->size() != 1 || !(*list)[0].is_string()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid HTML result preview URL");
+      return;
+    }
+    const bool released = aux::ResultPreviewStore::Release(
+        web_ui()->GetWebContents(), GURL((*list)[0].GetString()));
+    std::move(callback).Run(true, *base::WriteJson(base::Value(released)), "", "");
+    return;
+  }
+  if (method == "surfaceContentId") {
+    if (list->size() != 1 || !(*list)[0].is_string()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid page identifier");
+      return;
+    }
+    BrowserWindowInterface* owner = nullptr;
+    content::WebContents* contents =
+        aux::TabCatalog::GetForProfile(browser_->GetProfile())
+            ->FindPage((*list)[0].GetString(), &owner);
+    if (!contents || owner != browser_) {
+      std::move(callback).Run(false, "", "not_found",
+                              "Page is outside this browser window");
+      return;
+    }
+    guest_contents::GuestContentsHandle::CreateForWebContents(contents);
+    auto* handle =
+        guest_contents::GuestContentsHandle::FromWebContents(contents);
+    std::move(callback).Run(true, *base::WriteJson(base::Value(handle->id().ToString())),
+                            "", "");
+    return;
+  }
+  if (method == "hardReload" || method == "printPage" ||
+      method == "devTools") {
+    if ((list->size() != 1 && !(method == "devTools" && list->size() == 2 &&
+         (*list)[1].is_string() && ((*list)[1].GetString() == "toggle" || (*list)[1].GetString() == "inspect"))) ||
+        !(*list)[0].is_string() || (*list)[0].GetString().empty()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "A browser page ID is required");
+      return;
+    }
+    BrowserWindowInterface* owner = nullptr;
+    auto* catalog = aux::TabCatalog::GetForProfile(browser_->GetProfile());
+    auto* contents = catalog->FindPage((*list)[0].GetString(), &owner);
+    if (!contents || owner != browser_) {
+      std::move(callback).Run(false, "", "not_found",
+                              "The page is no longer in this window");
+      return;
+    }
+    if (method == "hardReload") {
+      // Keep Chromium's repost confirmation when bypassing the HTTP cache.
+      contents->GetController().Reload(content::ReloadType::BYPASSING_CACHE,
+                                       /*check_for_repost=*/true);
+    } else if (method == "devTools") {
+      if (!DevToolsWindow::AllowDevToolsFor(browser_->GetProfile(), contents)) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Developer tools are disabled for this page");
+        return;
+      }
+      DevToolsWindow::OpenDevToolsWindow(
+          contents, list->size() == 2 && (*list)[1].GetString() == "inspect"
+              ? DevToolsToggleAction::Inspect() : DevToolsToggleAction::Toggle(),
+          DevToolsOpenedByAction::kMainMenuOrMainShortcut);
+    } else {
+      // Browser print commands act on the active tab. Never print a different
+      // page if selection changed while the shell request was in flight.
+      if (browser_->GetTabStripModel()->GetActiveWebContents() != contents) {
+        std::move(callback).Run(false, "", "conflict",
+                                "Select this page before printing");
+        return;
+      }
+      if (!chrome::CanPrint(browser_)) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Printing is unavailable for this page");
+        return;
+      }
+      chrome::Print(browser_);
+    }
+    std::move(callback).Run(true, "true", "", "");
+    return;
+  }
+  if (method == "savePagePdf") {
+#if !BUILDFLAG(ENABLE_PRINTING)
+    std::move(callback).Run(false, "", "not_supported",
+                            "PDF rendering is unavailable");
+    return;
+#else
+    if (list->size() != 1 || !(*list)[0].is_string() ||
+        (*list)[0].GetString().empty()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "A browser page ID is required");
+      return;
+    }
+    BrowserWindowInterface* owner = nullptr;
+    auto* catalog = aux::TabCatalog::GetForProfile(browser_->GetProfile());
+    auto* contents = catalog->FindPage((*list)[0].GetString(), &owner);
+    auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+    if (!contents || owner != browser_ || !frame || !frame->IsActive() ||
+        !frame->IsRenderFrameLive() ||
+        browser_->GetTabStripModel()->GetActiveWebContents() != contents) {
+      std::move(callback).Run(false, "", "not_found",
+                              "Select the page before saving its PDF");
+      return;
+    }
+    if (!chrome::CanPrint(browser_)) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "PDF export is unavailable for this page");
+      return;
+    }
+    if (open_file_dialog_) {
+      std::move(callback).Run(false, "", "conflict",
+                              "A file dialog is already open");
+      return;
+    }
+    open_file_dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(contents));
+    if (!open_file_dialog_) {
+      std::move(callback).Run(false, "", "not_supported",
+                              "The system file dialog is unavailable");
+      return;
+    }
+    file_dialog_purpose_ = FileDialogPurpose::kSavePdf;
+    save_pdf_page_id_ = (*list)[0].GetString();
+    save_pdf_document_ = frame->GetWeakDocumentPtr();
+    file_dialog_callback_ = std::move(callback);
+    ui::SelectFileDialog::FileTypeInfo file_types;
+    file_types.extensions = {{FILE_PATH_LITERAL("pdf")}};
+    const auto name = net::GenerateFileName(
+        contents->GetLastCommittedURL(), "", "",
+        base::UTF16ToUTF8(contents->GetTitle()), "application/pdf", "Page")
+                          .ReplaceExtension(FILE_PATH_LITERAL("pdf"));
+    const auto destination =
+        browser_->GetProfile()->last_selected_directory().Append(name);
+    open_file_dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_SAVEAS_FILE, std::u16string(), destination,
+        &file_types, 0, FILE_PATH_LITERAL("pdf"),
+        browser_->GetWindow()->GetNativeWindow());
+    return;
+#endif
+  }
+  std::move(callback).Run(false, "", "not_found",
+                          "Unsupported Aux shell method: " + method);
+}
+#endif
