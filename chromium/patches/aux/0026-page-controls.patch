@@ -0,0 +1,72 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+
+#include <utility>
+
+#include "base/json/json_writer.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/appearance_prefs.h"
+#include "chrome/browser/ui/aux/health_recorder.h"
+#include "chrome/browser/ui/aux/method_registry.h"
+#include "chrome/browser/ui/aux/site_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "components/version_info/version_info.h"
+
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+void WebUIBrowserUI::HandleAuxHealthRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  Profile* profile = browser_->GetProfile();
+  if (method == "healthSummary" || method == "clearHealth") {
+    base::DictValue summary = method == "clearHealth"
+                                  ? aux::ClearHealth(profile)
+                                  : aux::HealthSummary(profile);
+    const auto json = base::WriteJson(summary);
+    std::move(callback).Run(json.has_value(), json.value_or(""),
+                            json ? "" : "io_error",
+                            json ? "" : "Health summary could not be encoded");
+    return;
+  }
+  if (method == "exportDiagnostics") {
+    const base::DictValue capabilities = aux::AuxMethodRegistry::Get().Capabilities();
+    base::DictValue report;
+    report.Set("format", "aux-support-report-v1");
+    report.Set("createdAt", static_cast<double>(
+        base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    report.Set("browserVersion", version_info::GetVersionNumber());
+    report.Set("buildId", *capabilities.FindString("buildId"));
+    report.Set("sourceCommit", *capabilities.FindString("sourceCommit"));
+    const base::ListValue* methods = capabilities.FindList("methods");
+    report.Set("availableHostMethods", static_cast<int>(methods ? methods->size() : 0));
+    report.Set("health", aux::HealthSummary(profile));
+    base::DictValue modes;
+    PrefService* prefs = profile->GetPrefs();
+    modes.Set("appearanceTheme", prefs->GetString(aux::kAppearanceThemePref));
+    modes.Set("httpsUpgradeEnabled", prefs->GetBoolean(aux::kHttpsUpgradesEnabled));
+    modes.Set("privateProfile", profile->IsOffTheRecord());
+    report.Set("modes", std::move(modes));
+    base::ListValue limits;
+    limits.Append("CPU and memory samples cover the browser process only.");
+    limits.Append("Responsiveness is one-minute UI task scheduling delay.");
+    limits.Append("Suspension counts and startup timing are not recorded yet.");
+    limits.Append("Page crash and hang counts are since the last Clear action.");
+    limits.Append("Runtime version and state are not included yet.");
+    report.Set("knownLimits", std::move(limits));
+    const auto content = base::WriteJsonWithOptions(
+        report, base::OPTIONS_PRETTY_PRINT);
+    if (!content) {
+      std::move(callback).Run(false, "", "io_error",
+                              "Support report could not be encoded");
+      return;
+    }
+    BeginAuxGeneratedSave("Aux-support-report.json", *content + "\n",
+                          base::FilePath(), 0, std::move(callback));
+    return;
+  }
+  std::move(callback).Run(false, "", "not_found", "Unknown health method");
+}
+#endif
