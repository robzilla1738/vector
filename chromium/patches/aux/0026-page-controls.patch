+class RunAttentionState final : public base::SupportsUserData::Data,
+                                public ProfileObserver,
+                                public BrowserCollectionObserver {
+ public:
+  explicit RunAttentionState(Profile* profile) : profile_(profile) {
+    profile_observation_.Observe(profile);
+    if (auto* browsers = ProfileBrowserCollection::GetForProfile(profile))
+      browser_observation_.Observe(browsers);
+  }
+  ~RunAttentionState() override {
+    browser_observation_.Reset();
+    profile_observation_.Reset();
+    entries.clear();
+    UpdateBadge();
+  }
+  void UpdateBadge() {
+#if BUILDFLAG(IS_MAC)
+    std::set<std::string> runs;
+    for (const auto& [id, entry] : entries) runs.insert(entry.run_id);
+    SetTaskAttentionBadge(badge_owner_, runs.size());
+#endif
+  }
+  void PlayCompletionSound() {
+#if BUILDFLAG(IS_MAC)
+    PlayTaskCompletionSound(badge_owner_);
+#endif
+  }
+  void OnBrowserActivated(BrowserWindowInterface* browser) override {
+    ClearWindow(browser);
+  }
+  void OnBrowserClosed(BrowserWindowInterface* browser) override {
+    ClearWindow(browser);
+  }
+  void OnProfileWillBeDestroyed(Profile*) override {
+    ClearWindow(nullptr);
+    browser_observation_.Reset();
+    profile_observation_.Reset();
+    profile_ = nullptr;
+  }
+  std::map<std::string, RunAttentionEntry> entries;
+  std::map<std::string, base::TimeTicks> last_by_kind;
+ private:
+  void ClearWindow(BrowserWindowInterface* browser) {
+    const std::string window = browser ?
+        base::NumberToString(browser->GetSessionID().id()) : "";
+    std::vector<std::string> removed;
+    std::erase_if(entries, [&](const auto& entry) {
+      if (browser && entry.second.window_id != window) return false;
+      removed.push_back(entry.first);
+      return true;
+    });
+    UpdateBadge();
+    // Remove only this state's native entries; never adopt another Profile or
+    // fabricate acknowledgement of its pending run.
+    if (auto* service = profile_ ?
+        NotificationDisplayServiceFactory::GetForProfile(profile_) : nullptr) {
+      for (const auto& id : removed)
+        service->Close(NotificationHandler::Type::AUX_RUN_ATTENTION, id);
+    }
+  }
+  raw_ptr<Profile> profile_;
+  const base::UnguessableToken badge_owner_ = base::UnguessableToken::Create();
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::ScopedObservation<ProfileBrowserCollection, BrowserCollectionObserver>
+      browser_observation_{this};
+};
