@@ -0,0 +1,210 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/health_recorder.h"
+
+#include <algorithm>
+#include <cmath>
+#include <memory>
+#include <set>
+#include <vector>
+
+#include "base/process/process_metrics.h"
+#include "base/supports_user_data.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "components/prefs/pref_service.h"
+
+namespace aux {
+namespace {
+
+constexpr char kRecorderKey = 0;
+constexpr base::TimeDelta kInterval = base::Minutes(1);
+constexpr base::TimeDelta kRetention = base::Days(7);
+constexpr size_t kMaxSamples = 10080;
+
+double Number(const base::DictValue& row, const char* key) {
+  return row.FindDouble(key).value_or(
+      static_cast<double>(row.FindInt(key).value_or(0)));
+}
+
+base::DictValue Stats(std::vector<double> values) {
+  base::DictValue result;
+  if (values.empty()) {
+    result.Set("p50", 0.0);
+    result.Set("p95", 0.0);
+    result.Set("max", 0.0);
+    return result;
+  }
+  std::sort(values.begin(), values.end());
+  result.Set("p50", values[(values.size() - 1) / 2]);
+  result.Set("p95", values[static_cast<size_t>(
+      std::ceil(values.size() * 0.95) - 1)]);
+  result.Set("max", values.back());
+  return result;
+}
+
+void TrimSamples(base::ListValue& samples, int64_t now_ms) {
+  const int64_t cutoff = now_ms - kRetention.InMilliseconds();
+  while (!samples.empty()) {
+    const base::DictValue* first = samples.front().GetIfDict();
+    if (samples.size() <= kMaxSamples && first &&
+        Number(*first, "at") >= cutoff)
+      break;
+    samples.erase(samples.begin());
+  }
+}
+
+class Recorder : public base::SupportsUserData::Data {
+ public:
+  explicit Recorder(Profile* profile)
+      : profile_(profile),
+        metrics_(base::ProcessMetrics::CreateCurrentProcessMetrics()) {
+    base::ListValue retained =
+        profile_->GetPrefs()->GetList(kHealthSamplesPref).Clone();
+    const size_t previous_size = retained.size();
+    TrimSamples(retained, base::Time::Now().InMillisecondsSinceUnixEpoch());
+    if (retained.size() != previous_size)
+      profile_->GetPrefs()->SetList(kHealthSamplesPref, std::move(retained));
+    profile_->GetPrefs()->SetInteger(
+        kHealthSessionsPref,
+        profile_->GetPrefs()->GetInteger(kHealthSessionsPref) + 1);
+    first_sample_.Start(FROM_HERE, base::Seconds(2), this,
+                        &Recorder::BeginSampling);
+  }
+
+  void Tick() { Sample(/*initial=*/false); }
+
+ private:
+  void BeginSampling() {
+    Sample(/*initial=*/true);
+    timer_.Start(FROM_HERE, kInterval, this, &Recorder::Tick);
+  }
+
+  void Sample(bool initial) {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    const double lag_ms = initial ? 0.0 :
+        std::max(0.0, (now - expected_tick_).InMillisecondsF());
+    expected_tick_ = now + kInterval;
+    const int64_t at = base::Time::Now().InMillisecondsSinceUnixEpoch();
+    base::DictValue row;
+    row.Set("at", static_cast<double>(at));
+    row.Set("session", profile_->GetPrefs()->GetInteger(kHealthSessionsPref));
+    row.Set("lag", lag_ms);
+    double cpu = 0;
+    double memory = 0;
+    if (metrics_) {
+      auto usage = metrics_->GetPlatformIndependentCPUUsage();
+      if (usage.has_value()) cpu = std::max(0.0, usage.value());
+      auto info = metrics_->GetMemoryInfo();
+      if (info.has_value())
+        memory = info->resident_set_bytes / (1024.0 * 1024.0);
+    }
+    row.Set("cpu", cpu);
+    row.Set("memory", memory);
+    const base::DictValue snapshot =
+        TabCatalog::GetForProfile(profile_)->Snapshot();
+    const auto* windows = snapshot.FindList("windows");
+    const auto* tabs = snapshot.FindList("tabs");
+    row.Set("windows", static_cast<int>(windows ? windows->size() : 0));
+    row.Set("pages", static_cast<int>(tabs ? tabs->size() : 0));
+    base::ListValue samples =
+        profile_->GetPrefs()->GetList(kHealthSamplesPref).Clone();
+    samples.Append(std::move(row));
+    TrimSamples(samples, at);
+    profile_->GetPrefs()->SetList(kHealthSamplesPref, std::move(samples));
+  }
+
+  raw_ptr<Profile> profile_;
+  std::unique_ptr<base::ProcessMetrics> metrics_;
+  base::TimeTicks expected_tick_;
+  base::OneShotTimer first_sample_;
+  base::RepeatingTimer timer_;
+};
+
+}  // namespace
+
+void StartHealthRecorder(Profile* profile) {
+  if (!profile || profile->GetUserData(&kRecorderKey)) return;
+  profile->SetUserData(&kRecorderKey, std::make_unique<Recorder>(profile));
+}
+
+base::DictValue HealthSummary(Profile* profile) {
+  StartHealthRecorder(profile);
+  PrefService* prefs = profile->GetPrefs();
+  const base::ListValue& rows = prefs->GetList(kHealthSamplesPref);
+  std::vector<double> cpu, memory, lag;
+  std::set<int> sessions;
+  int observed_minutes = 0;
+  int previous_session = -1;
+  double previous_at = 0;
+  int max_windows = 0, max_pages = 0;
+  double earliest = 0, latest = 0;
+  for (const base::Value& value : rows) {
+    const base::DictValue* row = value.GetIfDict();
+    if (!row) continue;
+    const double at = Number(*row, "at");
+    if (!earliest || at < earliest) earliest = at;
+    latest = std::max(latest, at);
+    const int session = row->FindInt("session").value_or(0);
+    sessions.insert(session);
+    if (session == previous_session && at > previous_at &&
+        at - previous_at <= 120000.0)
+      ++observed_minutes;
+    previous_session = session;
+    previous_at = at;
+    cpu.push_back(Number(*row, "cpu"));
+    memory.push_back(Number(*row, "memory"));
+    lag.push_back(Number(*row, "lag"));
+    max_windows = std::max(max_windows, row->FindInt("windows").value_or(0));
+    max_pages = std::max(max_pages, row->FindInt("pages").value_or(0));
+  }
+  base::DictValue result;
+  if (earliest) result.Set("recordingSince", earliest);
+  if (latest) result.Set("latestAt", latest);
+  result.Set("samples", static_cast<int>(cpu.size()));
+  result.Set("sessions", static_cast<int>(sessions.size()));
+  result.Set("observedMinutes", observed_minutes);
+  const double span_days = earliest ? (latest - earliest) / 86400000.0 : 0.0;
+  result.Set("spanDays", span_days);
+  result.Set("sevenDaySpan", span_days >= 6.95);
+  result.Set("cpuPercent", Stats(std::move(cpu)));
+  result.Set("memoryMb", Stats(std::move(memory)));
+  result.Set("eventLoopLagMs", Stats(std::move(lag)));
+  result.Set("maxWindows", max_windows);
+  result.Set("maxPages", max_pages);
+  result.Set("maxSuspendedPages", 0);
+  result.Set("pageCrashes", prefs->GetInteger(kHealthCrashesPref));
+  result.Set("pageUnresponsive", prefs->GetInteger(kHealthHangsPref));
+  result.Set("suspensionFailures", 0);
+  return result;
+}
+
+base::DictValue ClearHealth(Profile* profile) {
+  StartHealthRecorder(profile);
+  PrefService* prefs = profile->GetPrefs();
+  prefs->SetList(kHealthSamplesPref, base::ListValue());
+  prefs->SetInteger(kHealthSessionsPref, 1);
+  prefs->SetInteger(kHealthCrashesPref, 0);
+  prefs->SetInteger(kHealthHangsPref, 0);
+  return HealthSummary(profile);
+}
+
+void RecordPageCrash(Profile* profile) {
+  if (!profile) return;
+  PrefService* prefs = profile->GetPrefs();
+  prefs->SetInteger(kHealthCrashesPref,
+                    prefs->GetInteger(kHealthCrashesPref) + 1);
+}
+
+void RecordPageUnresponsive(Profile* profile) {
+  if (!profile) return;
+  PrefService* prefs = profile->GetPrefs();
+  prefs->SetInteger(kHealthHangsPref,
+                    prefs->GetInteger(kHealthHangsPref) + 1);
+}
+
+}  // namespace aux
