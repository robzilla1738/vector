+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_FIND_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_FIND_H_
+
+#include <map>
+#include <cstdint>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "base/supports_user_data.h"
+#include "components/find_in_page/find_result_observer.h"
+
+class Profile;
+namespace content { class Page; class WebContents; }
+namespace find_in_page { class FindTabHelper; }
+
+namespace aux {
+
+// Observes Chromium's actual find results. Pending results are tied to the
+// owning Profile, page ID, document, and find request; stale replies fail.
+class NativeFind final : public find_in_page::FindResultObserver,
+                         public base::SupportsUserData::Data {
+ public:
+  using Reply = base::OnceCallback<void(base::DictValue)>;
+  static NativeFind* ForProfile(Profile* profile);
+  explicit NativeFind(Profile* profile);
+  ~NativeFind() override;
+  void Find(const base::DictValue& params, Reply reply, bool web_only,
+            const void* request_owner);
+  void CancelOwner(const void* request_owner);
+  base::DictValue Stop(const base::DictValue& params);
+
+ private:
+  struct Pending {
+    // Identity values only. A navigation may destroy either object before a
+    // delayed result or timeout; neither pointer is ever dereferenced.
+    uintptr_t request_owner;
+    uintptr_t contents;
+    uintptr_t document;
+    int request_id;
+    Reply reply;
+  };
+  void Finish(const std::string& page_id, base::DictValue result);
+  void OnFindResultAvailable(content::WebContents* contents) override;
+  void OnFindTabHelperDestroyed(find_in_page::FindTabHelper* helper) override;
+  raw_ptr<Profile> profile_;
+  std::map<std::string, Pending> pending_;
+  std::map<find_in_page::FindTabHelper*, content::WebContents*> observed_;
+  base::WeakPtrFactory<NativeFind> weak_factory_{this};
+};
+
+}  // namespace aux
+#endif  // CHROME_BROWSER_UI_AUX_NATIVE_FIND_H_
