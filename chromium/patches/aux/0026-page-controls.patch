+bool ShowRunAttention(Profile* profile, const std::string& kind,
+                      const std::string& run_id, const std::string& identity,
+                      const std::string& window_id) {
+  if (!profile || profile->IsOffTheRecord() || profile->ShutdownStarted() || run_id.empty() || identity.empty() ||
+      window_id.empty() || run_id.size() > 128 || identity.size() > 128 ||
+      window_id.size() > 128) return false;
+  const char16_t* title = nullptr;
+  const char16_t* body = nullptr;
+  if (kind == "completed") {
+    title = u"Aux finished a task";
+    body = u"Open Aux to review the result.";
+  } else if (kind == "question") {
+    title = u"Aux needs your answer";
+    body = u"Open Aux to review a question.";
+  } else if (kind == "handoff") {
+    title = u"Your turn in Aux";
+    body = u"Open Aux to finish a browser step.";
+  } else {
+    return false;
+  }
+  auto* browsers = ProfileBrowserCollection::GetForProfile(profile);
+  bool original_window_current = false;
+  if (browsers) browsers->ForEach([&](BrowserWindowInterface* browser) {
+    if (base::NumberToString(browser->GetSessionID().id()) != window_id)
+      return true;
+    // Policy belongs to the original durable shell gate. Native validates the
+    // same live Profile/window without adding a whole-window focus policy.
+    original_window_current = browser->GetProfile() == profile;
+    return false;
+  });
+  if (!original_window_current) return false;
+  auto* service = NotificationDisplayServiceImpl::GetForProfile(profile);
+  if (!service) return false;
+  if (!service->GetNotificationHandler(NotificationHandler::Type::AUX_RUN_ATTENTION)) {
+    service->AddNotificationHandler(NotificationHandler::Type::AUX_RUN_ATTENTION,
+                                    std::make_unique<RunAttentionHandler>());
+  }
+  auto* state = static_cast<RunAttentionState*>(
+      profile->GetUserData(&kRunAttentionKey));
+  if (!state) {
+    profile->SetUserData(&kRunAttentionKey, std::make_unique<RunAttentionState>(profile));
+    state = static_cast<RunAttentionState*>(profile->GetUserData(&kRunAttentionKey));
+  }
+  const auto now = base::TimeTicks::Now();
+  auto last = state->last_by_kind.find(kind);
+  if (last != state->last_by_kind.end() && now - last->second < base::Seconds(5))
+    return false;
+  const std::string notification_id =
+      "aux-run-attention-" + base::Uuid::GenerateRandomV4().AsLowercaseString();
+  state->entries.emplace(notification_id,
+                         RunAttentionEntry{run_id, identity, window_id});
+  state->last_by_kind[kind] = now;
+  message_center::RichNotificationData data;
+  message_center::Notification notification(
+      message_center::NOTIFICATION_TYPE_SIMPLE, notification_id,
+      std::u16string(title), std::u16string(body), ui::ImageModel(), u"Aux",
+      GURL(), message_center::NotifierId(), data, nullptr);
+  service->Display(NotificationHandler::Type::AUX_RUN_ATTENTION,
+                   notification, nullptr);
+  state->UpdateBadge();
+#if BUILDFLAG(IS_MAC)
+  if (kind == "completed") state->PlayCompletionSound();
+#endif
+  return true;  // Enqueued; OS permission can still deny display. The shell keeps a fallback.
+}
+
+bool DownloadIsDismissed(Profile* profile, download::DownloadItem* item) {
+  return item->GetState() != download::DownloadItem::IN_PROGRESS &&
+         !item->CanResume() &&
+         profile->GetPrefs()->GetDict(kDismissedDownloadsPref)
+             .FindBool(item->GetGuid()).value_or(false);
+}
+
+base::ListValue DismissDownloads(Profile* profile, const base::ListValue& ids) {
+  base::ListValue removed;
+  auto* manager = profile->GetDownloadManager();
+  if (!manager) return removed;
+  {
+    ScopedDictPrefUpdate dismissed(profile->GetPrefs(), kDismissedDownloadsPref);
+    std::set<std::string> seen;
+    for (const auto& value : ids) {
+      const std::string& id = value.GetString();
+      if (!seen.insert(id).second) continue;
+      auto* item = manager->GetDownloadByGuid(id);
+      if (item && (item->GetState() == download::DownloadItem::IN_PROGRESS ||
+                   item->CanResume())) continue;
+      if (!item && !dismissed->FindBool(id).value_or(false)) continue;
+      // Remove() deletes interrupted partial files. Shelf dismissal must preserve them.
+      dismissed->Set(id, true);
+      removed.Append(id);
+    }
+  }
+  if (!removed.empty()) {
+    base::DictValue payload;
+    payload.Set("ids", removed.Clone());
+    EmitDict(profile, "onDownloadsRemoved", std::move(payload));
+  }
+  return removed;
+}
