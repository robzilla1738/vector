+namespace {
+base::DictValue NativeFault(std::string code, std::string message) {
+  base::DictValue error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::DictValue reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+base::DictValue NativeResult(base::Value value) {
+  base::DictValue reply;
+  reply.Set("result", std::move(value));
+  return reply;
+}
+}  // namespace
+
+base::DictValue AuxRuntimeHost::HandleNativePageControlsCall(
+    const std::string& method, const base::DictValue& params,
+    uint64_t /*connection_generation*/) {
+  constexpr double kZoomBase = 1.2;
+  constexpr double kMinZoomFactor = 0.25;
+  constexpr double kMaxZoomFactor = 5.0;
+  constexpr std::array<int, 16> kZoomPercentages = {
+      25, 33, 50, 67, 75, 90, 100, 110, 125, 150, 175, 200, 250, 300, 400, 500};
+  auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+  if (method == "native.memorySaverGet" || method == "native.memorySaverSet") {
+    if (profile_->IsOffTheRecord() || profile_->IsGuestSession()) {
+      return NativeFault("forbidden",
+                         "Memory saver requires a regular profile");
+    }
+    const bool set = method == "native.memorySaverSet";
+    const auto minutes = params.FindInt("minutes");
+    if ((!set && !params.empty()) ||
+        (set && (params.size() != 1 || !minutes ||
+                 !aux::TabCatalog::IsMemorySaverMinutes(*minutes)))) {
+      return NativeFault("invalid_params",
+                         "Choose a supported memory saver interval");
+    }
+    if (set && !catalog->MemorySaverSet(*minutes)) {
+      return NativeFault("forbidden", "Memory saver is managed by policy");
+    }
+    return NativeResult(base::Value(catalog->MemorySaverGet()));
+  }
+  if (method == "native.stopFind") return native_find_->Stop(params);
+  if (method == "native.setZoom") {
+    const std::string* page_id = params.FindString("pageId");
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id) : nullptr;
+    if (!contents) {
+      return NativeFault("not_found", "Page is not in this Profile");
+    }
+    auto* zoom_controller = zoom::ZoomController::FromWebContents(contents);
+    if (!zoom_controller) {
+      return NativeFault("backend_unavailable", "Page zoom is unavailable");
+    }
+    const double current = zoom_controller->GetZoomLevel();
+    double next = current;
+    bool requested = false;
+    if (params.FindBool("reset").value_or(false)) {
+      requested = true;
+      next = zoom_controller->GetDefaultZoomLevel();
+    } else if (const std::string* direction = params.FindString("direction")) {
+      requested = true;
+      if (*direction != "in" && *direction != "out") {
+        return NativeFault("invalid_params", "Invalid zoom direction");
+      }
+      const int current_percent =
+          static_cast<int>(std::round(100.0 * std::pow(kZoomBase, current)));
+      int stepped = *direction == "in" ? 500 : 25;
+      for (int percentage : kZoomPercentages) {
+        if (*direction == "in" && percentage > current_percent) {
+          stepped = percentage;
+          break;
+        }
+        if (*direction == "out" && percentage < current_percent) {
+          stepped = percentage;
+        }
+      }
+      next = std::log(stepped / 100.0) / std::log(kZoomBase);
+    } else if (const std::optional<double> level = params.FindDouble("level")) {
+      requested = true;
+      next = *level;
+    } else if (const std::optional<double> delta = params.FindDouble("delta")) {
+      requested = true;
+      next += *delta;
+    }
+    if (!std::isfinite(next)) {
+      return NativeFault("invalid_params", "Invalid page zoom");
+    }
+    if (requested) {
+      next = std::clamp(next, std::log(kMinZoomFactor) / std::log(kZoomBase),
+                        std::log(kMaxZoomFactor) / std::log(kZoomBase));
+    }
+    if (requested && next != current && !zoom_controller->SetZoomLevel(next)) {
+      return NativeFault("backend_unavailable", "Page zoom is disabled");
+    }
+    base::DictValue result;
+    result.Set("level", zoom_controller->GetZoomLevel());
+    return NativeResult(base::Value(std::move(result)));
+  }
+  return NativeFault("backend_unavailable",
+                     "Native method is unavailable in this build");
+}
