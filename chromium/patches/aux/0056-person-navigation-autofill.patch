+std::shared_ptr<NativePersonNavigationReceipt>
+EgressController::CapturePersonNavigation(content::RenderFrameHost* frame,
+                                          int64_t navigation_id) {
+  auto* page =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  auto* navigation = PendingNavigation(page);
+  if (!navigation || navigation->GetNavigationId() != navigation_id ||
+      !navigation->IsInPrimaryMainFrame() ||
+      navigation->IsRendererInitiated()) {
+    return {};
+  }
+  auto* data = static_cast<PersonNavigationData*>(
+      navigation->GetUserData(&kPersonNavigationKey));
+  if (!data) {
+    auto owned = std::make_unique<PersonNavigationData>();
+    data = owned.get();
+    auto& receipt = *data->receipt;
+    receipt.document = page->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+    receipt.page = page->GetWeakPtr();
+    receipt.page_id = PageIdentity::GetOrCreate(profile_, page);
+    const auto state = pages_.find(receipt.page_id);
+    if (state != pages_.end()) {
+      receipt.control_generation = state->second->control_generation;
+    }
+    navigation->SetUserData(&kPersonNavigationKey, std::move(owned));
+  }
+  return data->receipt;
+}
+bool EgressController::AllowsPersonNavigation(
+    const EgressRequestContext& context) const {
+  const auto& receipt = context.person_navigation;
+  if (!receipt || !receipt->admitted || !receipt->page ||
+      receipt->page_id != context.page_id || context.kind != "navigation" ||
+      context.ambiguous) {
+    return false;
+  }
+  auto* source = receipt->document.AsRenderFrameHostIfValid();
+  const auto state = pages_.find(context.page_id);
+  return source && source == context.document.AsRenderFrameHostIfValid() &&
+         receipt->page->GetBrowserContext() == profile_ &&
+         receipt->page->GetPrimaryMainFrame() == source &&
+         state != pages_.end() && state->second->lease.empty() &&
+         state->second->control_generation == receipt->control_generation &&
+         !isolation_run_by_page_.contains(context.page_id);
+}
+void EgressController::NavigateForPerson(content::WebContents* page,
+                                         base::OnceClosure navigate) {
+  auto original_page = page->GetWeakPtr();
+  auto original_document = page->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  auto* previous = PendingNavigation(page);
+  const int64_t previous_id = previous ? previous->GetNavigationId() : 0;
+  std::move(navigate).Run();
+  if (!original_page || page->GetPrimaryMainFrame() !=
+                            original_document.AsRenderFrameHostIfValid()) {
+    return;
+  }
+  auto* navigation = PendingNavigation(page);
+  const auto* identity = PageIdentity::FromWebContents(page);
+  if (!navigation || navigation->GetNavigationId() == previous_id ||
+      !identity || identity->runtime_owned() ||
+      page->GetBrowserContext() != profile_ ||
+      isolation_run_by_page_.contains(identity->id())) {
+    return;
+  }
+  const auto state = pages_.find(identity->id());
+  if (state == pages_.end() || !state->second->lease.empty() ||
+      state->second->returned_person_read_document.AsRenderFrameHostIfValid() !=
+          original_document.AsRenderFrameHostIfValid()) {
+    return;
+  }
+  auto receipt = CapturePersonNavigation(page->GetPrimaryMainFrame(),
+                                         navigation->GetNavigationId());
+  if (!receipt ||
+      receipt->document.AsRenderFrameHostIfValid() !=
+          original_document.AsRenderFrameHostIfValid() ||
+      receipt->control_generation != state->second->control_generation) {
+    return;
+  }
+  // Only this NavigationRequest gains authority. The old document's tombstone
+  // and retired control generation continue rejecting late task traffic.
+  receipt->admitted = true;
+}
