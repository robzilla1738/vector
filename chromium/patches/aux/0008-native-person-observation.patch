+                fail();
+            return value;
+        };
+        const attributes = new Set(["href", "title", "alt", "aria-label", "name", "id", "role"]);
+        for (const field of request.fields) {
+            if (!field || typeof field.name !== "string" || !/^[A-Za-z][\w-]{0,63}$/.test(field.name) ||
