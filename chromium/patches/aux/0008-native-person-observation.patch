+            for (const root of roots) {
+                for (const element of root.querySelectorAll(field.selector)) {
+                    if (selected.length >= 200)
+                        fail();
+                    selected.push(element);
+                    if (!field.all)
+                        break;
+                }
+                if (!field.all && selected.length)
+                    break;
+            }
+            const values = selected.map(element => bounded(field.attribute
+                ? field.attribute === "href" ? safeUrl(element.getAttribute("href") ?? "") : (element.getAttribute(field.attribute) ?? "").slice(0, 4000)
