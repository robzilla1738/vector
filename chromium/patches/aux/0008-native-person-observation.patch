+// Generated from the fixed person observer; run gen-native-person-observer.mjs.
+#ifndef CHROME_COMMON_NATIVE_PERSON_OBSERVER_SCRIPT_H_
+#define CHROME_COMMON_NATIVE_PERSON_OBSERVER_SCRIPT_H_
+namespace aux::person_observer_script {
+inline constexpr char kProducerSha256[] = "650d19e9c07e9e465bcc9d61f35d7d5f1738ef060a44b49937f2dcc4ad4763c4";
+inline constexpr char16_t kRead[] = uR"AUX_READ(((request) => JSON.stringify((function readPersonDocument(request) {
+    const fail = () => { throw new Error("This page cannot be read safely."); };
+    const secretIdentity = /password|passphrase|secret|api[-_ ]?key|(?:access|refresh|id|auth|authorization|session|bearer)[-_ ]?token|card[-_ ]?number|credit[-_ ]?card|security[-_ ]?code|\bcvv\b|\bcvc\b|\bcsc\b/i;
+    const secretAutocomplete = /^(current-password|new-password|one-time-code|cc-number|cc-csc|cc-exp|cc-exp-month|cc-exp-year)$/;
+    if (!request || !["observe", "extract"].includes(request.operation))
+        fail();
+    if (request.operation === "observe" &&
+        (!Number.isInteger(request.maxElements) || request.maxElements < 1 || request.maxElements > 200 ||
+            !Number.isInteger(request.maxTextChars) || request.maxTextChars < 1 || request.maxTextChars > 16000))
+        fail();
+    if (request.operation === "observe" &&
+        ((request.filter !== undefined && !["interactive", "all", "viewport"].includes(request.filter)) ||
+            (request.subtreeRef !== undefined && (typeof request.subtreeRef !== "string" || !request.subtreeRef.length || request.subtreeRef.length > 512))))
+        fail();
+    if (request.operation === "extract" && (!Array.isArray(request.fields) || request.fields.length < 1 || request.fields.length > 20))
+        fail();
+    const roots = [document];
+    const elements = [];
+    // Finish metadata admission before touching text, title or field properties.
+    // Refuse protected forms as a whole, including echoes elsewhere in the DOM,
+    // rather than reading a secret in order to redact it afterwards.
+    for (let index = 0; index < roots.length; index++) {
+        if (roots.length > 64)
+            fail();
+        const walker = document.createTreeWalker(roots[index], 1);
+        for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+            if (elements.length >= 10000)
+                fail();
+            const element = node;
+            const type = (element.getAttribute("type") ?? "").toLowerCase();
+            const identity = ["name", "id", "aria-label", "placeholder"].map(key => element.getAttribute(key) ?? "").join(" ");
+            const autocomplete = (element.getAttribute("autocomplete") ?? "").toLowerCase().split(/\s+/);
+            if (type === "password" || autocomplete.some(token => secretAutocomplete.test(token)) ||
+                secretIdentity.test(identity) || element.hasAttribute("contenteditable"))
