+            fail();
+        scope = matches[0];
+    }
+    const inside = (element) => {
+        for (let node = element; node; node = node.parentNode ?? (node instanceof ShadowRoot ? node.host : null))
+            if (node === scope)
+                return true;
+        return false;
+    };
+    const scoped = elements.filter(inside);
+    const interactive = "a[href],button,input:not([type=hidden]),select,textarea,summary,[role],[tabindex]";
+    const candidates = request.filter === "all" ? scoped : scoped.filter(element => element.matches(interactive));
+    const entries = [];
+    for (const element of candidates) {
+        if (entries.length >= request.maxElements)
+            break;
+        const rect = element.getBoundingClientRect();
+        const style = getComputedStyle(element);
+        if (!rect.width || !rect.height || style.display === "none" || style.visibility !== "visible")
+            continue;
+        if (request.filter === "viewport" &&
+            (rect.bottom <= 0 || rect.right <= 0 || rect.top >= innerHeight || rect.left >= innerWidth))
+            continue;
+        let id = refs.ids.get(element);
+        if (id === undefined) {
+            id = refs.next++;
+            refs.ids.set(element, id);
+        }
+        if (!Number.isSafeInteger(refs.next))
+            fail();
+        const tag = element.tagName.toLowerCase();
+        const label = element.getAttribute("id") ? elements.find(candidate => candidate.tagName === "LABEL" && candidate.getAttribute("for") === element.id) : undefined;
+        const name = (element.getAttribute("aria-label") || (label ? textOf(label, 120) : "") ||
+            element.getAttribute("placeholder") || textOf(element, 120) || element.getAttribute("name") || "").slice(0, 120);
+        entries.push({ ref: `r${id}`, frame: "main", tag, name,
+            role: element.getAttribute("role") ?? (tag === "button" ? "button" : tag === "a" ? "link" : undefined),
+            rect: { x: Math.round(rect.x), y: Math.round(rect.y), w: Math.round(rect.width), h: Math.round(rect.height) },
+            selector: {},
+            ...(tag === "input" ? { type: element.getAttribute("type") ?? "text" } : {}),
+            ...(tag === "a" ? { href: safeUrl(element.getAttribute("href") ?? "") } : {}),
+        });
+    }
+    const formFields = entries.filter(entry => ["input", "select", "textarea"].includes(entry.tag))
+        .map(entry => ({ ref: entry.ref, label: entry.name, type: entry.type ?? entry.tag }));
+    const tables = scoped.filter(element => element.tagName === "TABLE").slice(0, 6).map((table, index) => {
+        const rows = [...table.querySelectorAll("tr")];
+        const header = rows.find(row => row.querySelector("th"));
+        const body = rows.filter(row => row !== header);
+        const cells = (row) => [...row.querySelectorAll("th,td")].slice(0, 20).map(cell => textOf(cell, 120));
+        return { ref: `t${index + 1}`, caption: table.querySelector("caption") ? textOf(table.querySelector("caption"), 80) : undefined,
+            columns: header ? cells(header) : [], rows: body.slice(0, 12).map(cells), totalRows: body.length, truncated: body.length > 12 };
