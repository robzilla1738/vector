@@ -0,0 +1,95 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_OWNED_HEADLESS_PROCESS_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_OWNED_HEADLESS_PROCESS_H_
+
+#include <sys/types.h>
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/scoped_file.h"
+#include "base/memory/ref_counted.h"
+#include "base/sequence_checker.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "base/types/expected.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/ui/aux/native_project_listener.h"
+
+namespace aux {
+// Browser-only, immutable installed-payload receipt. Its installer lease must
+// prevent replacement of the executable/private Home until Joined is returned.
+// No renderer/API accepts this object or any PID.
+struct OwnedCopilotLaunch {
+  OwnedCopilotLaunch();
+  ~OwnedCopilotLaunch();
+  OwnedCopilotLaunch(OwnedCopilotLaunch&&);
+  OwnedCopilotLaunch& operator=(OwnedCopilotLaunch&&);
+  OwnedCopilotLaunch(const OwnedCopilotLaunch&) = delete;
+  OwnedCopilotLaunch& operator=(const OwnedCopilotLaunch&) = delete;
+  base::FilePath runtime_root;
+  uint64_t runtime_device = 0;
+  uint64_t runtime_inode = 0;
+  base::FilePath executable;
+  uint64_t executable_device = 0;
+  uint64_t executable_inode = 0;
+  base::FilePath working_directory;
+  uint64_t working_device = 0;
+  uint64_t working_inode = 0;
+  base::FilePath private_home;
+  uint64_t home_device = 0;
+  uint64_t home_inode = 0;
+  std::string access_token;
+  std::string connection_token;
+};
+struct OwnedGroupJoined {
+  int exit_code = 0;
+  int exit_signal = 0;
+};
+// All calls, including final release, belong to one BLOCK_SHUTDOWN sequenced
+// worker. This owner never enters base::Process or a Node/SDK child reaper.
+// An active/uncertain owner self-retains: failed Stop is debt, not destruction.
+// Joined certifies ONLY the originally spawned private group and owned pipes.
+// Descendants that escape the session/group are not contained by this class.
+class NativeOwnedHeadlessProcess
+    : public base::RefCounted<NativeOwnedHeadlessProcess> {
+ public:
+  NativeOwnedHeadlessProcess();
+  const base::UnguessableToken& handle() const { return handle_; }
+  base::expected<void, std::string> Start(OwnedCopilotLaunch launch,
+                                          base::TimeTicks setup_deadline);
+  // Finds a unique actual loopback listener in the original live group;
+  // connection-token authentication remains the SDK adapter's next step.
+  base::expected<std::string, std::string> LoopbackUri();
+  base::expected<OwnedGroupJoined, std::string> Stop(base::TimeTicks deadline);
+  bool has_cleanup_debt() const;
+
+ private:
+  friend class base::RefCounted<NativeOwnedHeadlessProcess>;
+  ~NativeOwnedHeadlessProcess();
+  base::expected<void, std::string> ObserveAnchor();
+  base::expected<bool, std::string> OnlyRetainedLeader();
+  bool DrainPipes();
+  void Maintain();
+  void Drain(base::ScopedFD& pipe);
+  SEQUENCE_CHECKER(sequence_checker_);
+  const base::UnguessableToken handle_ = base::UnguessableToken::Create();
+  scoped_refptr<NativeOwnedHeadlessProcess> retained_;
+  const scoped_refptr<base::SequencedTaskRunner> runner_;
+  pid_t pid_ = -1;
+  NativeProjectProcess identity_{};
+  std::optional<NativeProjectListener> endpoint_;
+  bool private_group_ = false;
+  bool uncertain_ = false;
+  bool stopping_ = false;
+  bool started_ = false;
+  bool exited_ = false;
+  bool reaped_ = false;
+  OwnedGroupJoined exit_;
+  base::ScopedFD output_;
+  base::ScopedFD errors_;
+  std::optional<OwnedGroupJoined> joined_;
+};
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/aux/owned_headless_launcher.cc b/chrome/browser/ui/aux/owned_headless_launcher.cc
new file mode 100644
index 0000000..2117d96
--- /dev/null
+++ b/chrome/browser/ui/aux/owned_headless_launcher.cc
@@ -0,0 +1,144 @@
+// Copyright 2026 The Aux Authors
+// Fixed private spawn protocol. This executable never accepts a shell command,
+// alternate argv, port, PID, process group or renderer-supplied launch options.
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <span>
+
+#include "base/compiler_specific.h"
+
+#include "chrome/browser/ui/aux/owned_headless_protocol.h"
+extern char** environ;
+// Exact compiled-profile ABI/declaration used by pinned Chromium seatbelt.cc;
+// sandbox_apply is exported by the SDK libsandbox.tbd, not deprecated init.
+extern "C" {
+struct sandbox_profile_t {
+  char* builtin;
+  const uint8_t* data;
+  size_t size;
+};
+int sandbox_apply(sandbox_profile_t*);
+}
+namespace {
+constexpr int kGate = 3;
+constexpr int kStatus = 4;
+constexpr int kWorkingDirectory = 5;
+constexpr int kCompiledPolicy = 6;
+constexpr int kDeadline = 7;
+[[noreturn]] void Fail(int error) {
+  // One small atomic pipe message; parent treats any partial message as debt.
+  const aux::OwnedHeadlessSetupMessage failed{aux::kOwnedHeadlessFailed, error};
+  ssize_t sent;
+  do {
+    sent = write(kStatus, &failed, sizeof(failed));
+  } while (sent < 0 && errno == EINTR);
+  _exit(127);
+}
+bool CurrentDeadline(uint64_t deadline) {
+  struct timespec now{};
+  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+    return false;
+  }
+  const uint64_t actual =
+      static_cast<uint64_t>(now.tv_sec) * 1000000000 + now.tv_nsec;
+  return actual < deadline;
+}
+void ApplyModelOnlyPolicy(uint64_t deadline) {
+  struct stat info{};
+  if (!CurrentDeadline(deadline) || fstat(kCompiledPolicy, &info) != 0 ||
+      !S_ISREG(info.st_mode) || info.st_size <= 0 ||
+      static_cast<uint64_t>(info.st_size) >
+          aux::kOwnedHeadlessMaximumCompiledPolicy) {
+    Fail(EINVAL);
+  }
+  const size_t size = static_cast<size_t>(info.st_size);
+  void* bytes = mmap(nullptr, size, PROT_READ, MAP_PRIVATE, kCompiledPolicy, 0);
+  if (bytes == MAP_FAILED) {
+    Fail(errno);
+  }
+  if (close(kCompiledPolicy) != 0) {
+    Fail(errno);
+  }
+  if (!CurrentDeadline(deadline)) {
+    Fail(ETIMEDOUT);
+  }
+  sandbox_profile_t profile{nullptr, static_cast<const uint8_t*>(bytes), size};
+  if (sandbox_apply(&profile) != 0) {
+    Fail(errno);
+  }
+  if (munmap(bytes, size) != 0) {
+    Fail(errno);
+  }
+  if (!CurrentDeadline(deadline)) {
+    Fail(ETIMEDOUT);
+  }
+  const aux::OwnedHeadlessSetupMessage applied{
+      aux::kOwnedHeadlessSandboxApplied, 0};
+  ssize_t sent;
+  do {
+    sent = write(kStatus, &applied, sizeof(applied));
+  } while (sent < 0 && errno == EINTR && CurrentDeadline(deadline));
+  if (sent != sizeof(applied)) {
+    Fail(EPIPE);
+  }
+}
+}  // namespace
+int main(int argc, char** argv) {
+  if (argc != 2 || !argv) {
+    Fail(EINVAL);
+  }
+  // The process entry ABI supplies argc initialized argv elements. Admit only
+  // the fixed two-element protocol before constructing its bounded view.
+  const auto process_arguments = UNSAFE_BUFFERS(std::span(argv, size_t{2}));
+  char* const runtime = process_arguments[1];
+  if (!runtime || *runtime != '/' ||
+      getsid(0) != getpid() || getpgrp() != getpid()) {
+    Fail(EINVAL);
+  }
+  aux::OwnedHeadlessDeadline deadline{};
+  // Descriptor contains exactly one preloaded atomic8byte native deadline.
+  // Nonblocking read can never wait on a page/process-authored producer.
+  if (read(kDeadline, &deadline, sizeof(deadline)) != sizeof(deadline) ||
+      close(kDeadline) != 0 ||
+      !CurrentDeadline(deadline.monotonic_nanoseconds)) {
+    Fail(ETIMEDOUT);
+  }
+  if (fchdir(kWorkingDirectory) != 0 || close(kWorkingDirectory) != 0 ||
+      fcntl(kStatus, F_SETFD, FD_CLOEXEC) != 0) {
+    Fail(errno);
+  }
+  const aux::OwnedHeadlessSetupMessage ready{aux::kOwnedHeadlessReady, 0};
+  if (write(kStatus, &ready, sizeof(ready)) != sizeof(ready)) {
+    Fail(EPIPE);
+  }
+  char accepted = 0;
+  ssize_t received;
+  do {
+    received = read(kGate, &accepted, 1);
+  } while (received < 0 && errno == EINTR);
+  if (received != 1 || accepted != 'A') {
+    Fail(ECANCELED);
+  }
+  if (close(kGate) != 0) {
+    Fail(errno);
+  }
+  ApplyModelOnlyPolicy(deadline.monotonic_nanoseconds);
+  char headless[] = "--headless";
+  char host[] = "--host";
+  char loopback[] = "127.0.0.1";
+  char no_update[] = "--no-auto-update";
+  char no_login[] = "--no-auto-login";
+  char auth[] = "--auth-token-env";
+  char auth_env[] = "AUX_COPILOT_TOKEN";
+  char log[] = "--log-level";
+  char none[] = "none";
+  char* arguments[] = {runtime, headless, host, loopback, no_update, no_login,
+                       auth,    auth_env, log,  none,     nullptr};
+  execve(runtime, arguments, environ);
+  Fail(errno);
+}
