+namespace aux {
+namespace {
+bool ExclusiveDisposition() {
+  struct sigaction action{};
+  return sigaction(SIGCHLD, nullptr, &action) == 0 &&
+         action.sa_handler == SIG_DFL && !(action.sa_flags & SA_NOCLDWAIT);
+}
+base::ScopedFD OpenReceipt(const base::FilePath& path,
+                           uint64_t device,
+                           uint64_t inode,
+                           bool directory,
+                           bool private_home) {
+  if (!path.IsAbsolute() || path.ReferencesParent()) {
+    return {};
+  }
+  base::ScopedFD fd(HANDLE_EINTR(
+      open(path.value().c_str(),
+           O_RDONLY | O_NOFOLLOW | O_CLOEXEC | (directory ? O_DIRECTORY : 0))));
+  struct stat info{};
+  if (!fd.is_valid() || fstat(fd.get(), &info) != 0 || info.st_dev != device ||
+      info.st_ino != inode ||
+      (directory ? !S_ISDIR(info.st_mode) : !S_ISREG(info.st_mode)) ||
+      (private_home &&
+       (info.st_uid != getuid() || (info.st_mode & 077) != 0))) {
+    return {};
+  }
+  return fd;
+}
+// This deliberately omits all launch/Mach brokers, user Home, shell execution,
+// sandbox extensions and Chrome common-policy broad permissions. Seatbelt
+// localhost means this machine, not exact IPv4 loopback; fixed CLI --host plus
+// the retained raw AF_INET/127.0.0.1 kernel receipt enforce endpoint admission.
+// Actual policy compilation/binding must still pass; no unsandboxed fallback.
+constexpr char kModelOnlyPolicy[] = R"SBPL(
+(version 1)
+(deny default)
+(deny process-fork)
+(deny mach-lookup)
+(allow process-exec (path (param "EXECUTABLE")))
+(allow process-info-pidinfo (target self))
+(allow signal (target self))
+(allow file-read* file-map-executable
+  (subpath (param "RUNTIME_ROOT"))
+  (subpath "/System/Library")
+  (subpath "/usr/lib"))
+(allow file-read* file-write* (subpath (param "PRIVATE_HOME")))
+(allow file-read-metadata (path (param "WORKING_DIRECTORY")))
+(allow file-read-data
+  (path "/dev/null") (path "/dev/random") (path "/dev/urandom")
+  (path "/private/etc/hosts") (path "/private/etc/resolv.conf")
+  (path "/private/var/run/resolv.conf"))
+(allow file-read* (subpath "/private/var/db/timezone")
+  (subpath "/usr/share/zoneinfo.default"))
+(allow sysctl-read
+  (sysctl-name "hw.activecpu") (sysctl-name "hw.ncpu")
+  (sysctl-name "hw.memsize") (sysctl-name "hw.machine"))
+(allow network-outbound
+  (remote tcp "*:443")
+  (literal "/private/var/run/mDNSResponder"))
+(allow system-socket
+  (require-all (socket-domain AF_SYSTEM) (socket-protocol 2))
+  (socket-domain AF_ROUTE))
+(allow network-bind network-inbound (local tcp "localhost:*"))
+)SBPL";
+base::expected<base::ScopedFD, std::string> CompiledPolicy(
+    const OwnedCopilotLaunch& launch,
+    int home_fd,
+    const base::UnguessableToken& handle) {
+  auto parameters = sandbox::Seatbelt::Parameters::Create();
+  if (!parameters.params() ||
+      !parameters.Set("EXECUTABLE", launch.executable.value().c_str()) ||
+      !parameters.Set("RUNTIME_ROOT", launch.runtime_root.value().c_str()) ||
+      !parameters.Set("PRIVATE_HOME", launch.private_home.value().c_str()) ||
+      !parameters.Set("WORKING_DIRECTORY",
+                      launch.working_directory.value().c_str())) {
+    return base::unexpected("Native policy parameter preparation failed");
+  }
+  std::string bytes, error;
+  if (!sandbox::Seatbelt::Compile(kModelOnlyPolicy, parameters, bytes,
+                                  &error) ||
+      bytes.empty() || bytes.size() > kOwnedHeadlessMaximumCompiledPolicy) {
+    return base::unexpected("Native model-only policy compilation failed");
+  }
+  // Native-owned, unlinked original file descriptor. No pathname is passed to
+  // the child; all bytes originate in this one immutable compiled result.
+  const std::string name = ".aux-policy-" + handle.ToString();
+  base::ScopedFD fd(HANDLE_EINTR(
+      openat(home_fd, name.c_str(),
+             O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600)));
+  if (!fd.is_valid()) {
+    return base::unexpected("Native policy descriptor allocation failed");
+  }
+  if (unlinkat(home_fd, name.c_str(), 0) != 0) {
+    return base::unexpected("Native policy descriptor retirement failed");
+  }
+  auto remaining = base::as_byte_span(bytes);
+  while (!remaining.empty()) {
+    const auto written =
+        HANDLE_EINTR(write(fd.get(), remaining.data(), remaining.size()));
+    if (written <= 0) {
+      return base::unexpected("Native policy descriptor write failed");
+    }
+    remaining = remaining.subspan(static_cast<size_t>(written));
+  }
+  if (lseek(fd.get(), 0, SEEK_SET) != 0) {
+    return base::unexpected("Native policy descriptor rewind failed");
+  }
+  return std::move(fd);
+}
+bool Pipe(base::ScopedFD& read_end, base::ScopedFD& write_end) {
+  std::array<int, 2> fds{};
+  if (pipe(fds.data()) != 0) {
+    return false;
+  }
+  read_end.reset(fds.front());
+  write_end.reset(fds.back());
+  return fcntl(read_end.get(), F_SETFD, FD_CLOEXEC) == 0 &&
+         fcntl(write_end.get(), F_SETFD, FD_CLOEXEC) == 0;
+}
+bool Nonblocking(int fd) {
+  const int flags = fcntl(fd, F_GETFL);
+  return flags >= 0 && fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0;
+}
+base::expected<std::optional<OwnedHeadlessSetupMessage>, std::string> ReadSetup(
+    int fd,
+    base::TimeTicks deadline) {
+  OwnedHeadlessSetupMessage message{};
+  auto remaining = base::as_writable_byte_span(message);
+  bool received_any = false;
+  while (base::TimeTicks::Now() < deadline) {
+    const auto count = read(fd, remaining.data(), remaining.size());
+    if (count > 0) {
+      received_any = true;
+      remaining = remaining.subspan(static_cast<size_t>(count));
+      if (remaining.empty()) {
+        return std::optional(message);
+      }
+      continue;
+    }
+    if (count == 0) {
+      if (received_any) {
+        return base::unexpected("Partial owned setup message");
+      }
+      return std::optional<OwnedHeadlessSetupMessage>();
+    }
+    if (errno == EINTR) {
+      continue;  // Return to the deadline check.
+    }
+    if (errno != EAGAIN && errno != EWOULDBLOCK) {
+      return base::unexpected("Owned setup pipe read failed");
+    }
+    struct pollfd descriptor{fd, POLLIN | POLLHUP, 0};
+    // Status read is nonblocking, so neither a partial atomic-message delivery
+    // nor a signal after poll can make the next read exceed this deadline.
+    const auto milliseconds =
+        (deadline - base::TimeTicks::Now()).InMilliseconds();
+    if (milliseconds <= 0) {
+      break;
+    }
+    const int wait = static_cast<int>(std::min<int64_t>(milliseconds, 20));
+    const int result = poll(&descriptor, 1, wait);
+    if (result < 0 && errno != EINTR) {
+      return base::unexpected("Owned setup pipe poll failed");
+    }
+    if (result > 0 && (descriptor.revents & (POLLERR | POLLNVAL))) {
+      return base::unexpected("Owned setup pipe retired");
+    }
+  }
+  return base::unexpected("Owned setup deadline expired");
+}
+bool WriteAcceptance(int fd, base::TimeTicks deadline) {
+  const char accepted = 'A';
+  while (base::TimeTicks::Now() < deadline) {
+    const auto count = write(fd, &accepted, 1);
+    if (count == 1) {
+      return true;
+    }
+    if (count < 0 && errno == EINTR) {
+      continue;
+    }
+    if (count >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
+      return false;
+    }
+    const auto milliseconds =
+        (deadline - base::TimeTicks::Now()).InMilliseconds();
+    if (milliseconds <= 0) {
+      break;
+    }
+    struct pollfd descriptor{fd, POLLOUT, 0};
+    const int result = poll(
+        &descriptor, 1, static_cast<int>(std::min<int64_t>(milliseconds, 20)));
+    if (result < 0 && errno != EINTR) {
+      return false;
+    }
+    if (result > 0 && (descriptor.revents & (POLLERR | POLLHUP | POLLNVAL))) {
+      return false;
+    }
+  }
+  return false;
+}
+bool Secret(const std::string& value) {
+  return !value.empty() && value.size() <= 8192 &&
+         value.find('\0') == std::string::npos &&
+         value.find('\n') == std::string::npos;
+}
+}  // namespace
+OwnedCopilotLaunch::OwnedCopilotLaunch() = default;
+OwnedCopilotLaunch::~OwnedCopilotLaunch() = default;
+OwnedCopilotLaunch::OwnedCopilotLaunch(OwnedCopilotLaunch&&) = default;
+OwnedCopilotLaunch& OwnedCopilotLaunch::operator=(OwnedCopilotLaunch&&) =
+    default;
+NativeOwnedHeadlessProcess::NativeOwnedHeadlessProcess()
+    : runner_(base::SequencedTaskRunner::GetCurrentDefault()) {}
+NativeOwnedHeadlessProcess::~NativeOwnedHeadlessProcess() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK_EQ(pid_, -1);  // Unjoined debt owns a self-reference, never disappears.
+}
+bool NativeOwnedHeadlessProcess::has_cleanup_debt() const {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return pid_ != -1;
+}
+base::expected<void, std::string> NativeOwnedHeadlessProcess::Start(
+    OwnedCopilotLaunch launch,
+    base::TimeTicks setup_deadline) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (pid_ != -1 || joined_ || base::TimeTicks::Now() >= setup_deadline ||
+      !ExclusiveDisposition() || !Secret(launch.access_token) ||
+      !Secret(launch.connection_token)) {
+    return base::unexpected("Invalid launch or incompatible exclusive waiter");
+  }
+  auto runtime = OpenReceipt(launch.runtime_root, launch.runtime_device,
+                             launch.runtime_inode, true, true);
+  if (!runtime.is_valid() || !launch.runtime_root.IsParent(launch.executable)) {
+    return base::unexpected("Reviewed runtime root identity changed");
+  }
+  auto executable = OpenReceipt(launch.executable, launch.executable_device,
+                                launch.executable_inode, false, false);
+  auto directory = OpenReceipt(launch.working_directory, launch.working_device,
+                               launch.working_inode, true, false);
+  auto home = OpenReceipt(launch.private_home, launch.home_device,
+                          launch.home_inode, true, true);
+  if (!executable.is_valid() || !directory.is_valid() || !home.is_valid()) {
+    return base::unexpected("Reviewed launch identity changed");
+  }
+  auto policy = CompiledPolicy(launch, home.get(), handle_);
+  if (!policy.has_value()) {
+    return base::unexpected(policy.error());
+  }
+  // Bundle-owned fixed path, never a supplied launcher/path search.
+  const auto launcher =
+      chrome::GetFrameworkBundlePath().Append("Helpers").Append(
+          "aux_owned_headless_launcher");
+  base::ScopedFD gate_read, gate_write, status_read, status_write;
+  base::ScopedFD out_read, out_write, err_read, err_write;
+  base::ScopedFD deadline_read, deadline_write;
+  std::array<int, 2> gate{};
+  if (socketpair(AF_UNIX, SOCK_STREAM, 0, gate.data()) != 0) {
+    return base::unexpected("Private launch gate allocation failed");
+  }
+  gate_read.reset(gate.front());
+  gate_write.reset(gate.back());
+  const int no_sigpipe = 1;
+  if (fcntl(gate_read.get(), F_SETFD, FD_CLOEXEC) != 0 ||
+      fcntl(gate_write.get(), F_SETFD, FD_CLOEXEC) != 0 ||
+      setsockopt(gate_write.get(), SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe,
+                 sizeof(no_sigpipe)) != 0 ||
+      !Pipe(status_read, status_write) ||
+      !Pipe(deadline_read, deadline_write) ||
+      !Nonblocking(deadline_read.get()) || !Pipe(out_read, out_write) ||
+      !Pipe(err_read, err_write) || !Nonblocking(status_read.get()) ||
+      !Nonblocking(gate_write.get()) || !Nonblocking(out_read.get()) ||
+      !Nonblocking(err_read.get())) {
+    return base::unexpected("Private launch pipe allocation failed");
+  }
+  struct timespec now{};
+  const auto remaining_setup = setup_deadline - base::TimeTicks::Now();
+  if (remaining_setup <= base::TimeDelta() ||
+      clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+    return base::unexpected("Native setup deadline retired before spawn");
+  }
+  const auto nanos = static_cast<uint64_t>(remaining_setup.InNanoseconds());
+  const uint64_t origin =
+      static_cast<uint64_t>(now.tv_sec) * 1000000000 + now.tv_nsec;
+  if (UINT64_MAX - origin < nanos) {
+    return base::unexpected("Native setup deadline overflow");
+  }
+  const OwnedHeadlessDeadline deadline{origin + nanos};
+  if (HANDLE_EINTR(write(deadline_write.get(), &deadline, sizeof(deadline))) !=
+      sizeof(deadline)) {
+    return base::unexpected("Native setup deadline delivery failed");
+  }
+  deadline_write.reset();
+  // Move all source descriptors above the fixed child fd destinations so no
+  // ordered dup2 action overwrites another source before it is remapped.
+  std::array<base::ScopedFD, 7> sources;
+  const std::array<int, 7> source_fds = {
+      out_write.get(), err_write.get(), gate_read.get(),    status_write.get(),
+      directory.get(), policy->get(),   deadline_read.get()};
+  for (size_t index = 0; index < sources.size(); ++index) {
+    sources[index].reset(fcntl(source_fds[index], F_DUPFD_CLOEXEC, 10));
+    if (!sources[index].is_valid()) {
+      return base::unexpected("Private fd map failed");
+    }
+  }
+  posix_spawn_file_actions_t actions;
+  posix_spawnattr_t attributes;
+  if (posix_spawn_file_actions_init(&actions) != 0) {
+    return base::unexpected("Spawn actions unavailable");
+  }
+  if (posix_spawnattr_init(&attributes) != 0) {
+    posix_spawn_file_actions_destroy(&actions);
+    return base::unexpected("Spawn attributes unavailable");
+  }
+  sigset_t mask, defaults;
+  sigemptyset(&mask);
+  sigemptyset(&defaults);
+  for (int signal : {SIGCHLD, SIGPIPE, SIGINT, SIGTERM}) {
+    sigaddset(&defaults, signal);
+  }
+  int error = posix_spawnattr_setflags(
+      &attributes, POSIX_SPAWN_SETSID | POSIX_SPAWN_CLOEXEC_DEFAULT |
+                       POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK);
+  if (!error) {
+    error = posix_spawnattr_setsigmask(&attributes, &mask);
+  }
+  if (!error) {
+    error = posix_spawnattr_setsigdefault(&attributes, &defaults);
+  }
+  if (!error) {
+    error =
+        posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", O_RDONLY, 0);
+  }
+  for (size_t index = 0; index < sources.size() && !error; ++index) {
+    error = posix_spawn_file_actions_adddup2(&actions, sources[index].get(),
+                                             static_cast<int>(index) + 1);
+  }
+  std::vector<std::string> arguments = {launcher.value(),
+                                        launch.executable.value()};
+  std::vector<std::string> environment = {
+      "PATH=/usr/bin:/bin",
+      "COPILOT_HOME=" + launch.private_home.value(),
+      "HOME=" + launch.private_home.value(),
+      "TMPDIR=" + launch.private_home.value(),
+      "COPILOT_DISABLE_KEYTAR=1",
+      "COPILOT_CONNECTION_TOKEN=" + launch.connection_token,
+      "AUX_COPILOT_TOKEN=" + launch.access_token};
+  std::vector<char*> argv, envp;
+  for (auto& argument : arguments) {
+    argv.push_back(argument.data());
+  }
+  for (auto& entry : environment) {
+    envp.push_back(entry.data());
+  }
+  argv.push_back(nullptr);
+  envp.push_back(nullptr);
+  if (!error) {
+    error = posix_spawn(&pid_, launcher.value().c_str(), &actions, &attributes,
+                        argv.data(), envp.data());
+  }
+  posix_spawn_file_actions_destroy(&actions);
+  posix_spawnattr_destroy(&attributes);
+  // Credential strings never enter receipts, errors, stdout or logging.
+  if (error) {
+    pid_ = -1;
+    return base::unexpected("Owned spawn failed: errno " +
+                            std::to_string(error));
+  }
+  retained_ = this;
+  runner_->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&NativeOwnedHeadlessProcess::Maintain, retained_),
+      base::Milliseconds(50));
+  gate_read.reset();
+  status_write.reset();
+  deadline_read.reset();
+  policy->reset();
+  out_write.reset();
+  err_write.reset();
+  for (auto& source : sources) {
+    source.reset();
+  }
+  output_ = std::move(out_read);
+  errors_ = std::move(err_read);
+  auto ready = ReadSetup(status_read.get(), setup_deadline);
+  if (!ready.has_value() || !ready.value().has_value() ||
+      ready.value()->kind != kOwnedHeadlessReady || ready.value()->error != 0 ||
+      getsid(pid_) != pid_ || getpgid(pid_) != pid_ ||
+      !CaptureProjectProcess(pid_, &identity_) ||
+      !ProjectProcessCurrent(identity_)) {
+    // Child is held behind gate. Stop retains/reaps this exact spawned child;
+    // it must not signal a group until the private identity was established.
+    return base::unexpected(
+        "Spawned owner retained: setup acknowledgement failed");
+  }
+  private_group_ = true;
+  if (!WriteAcceptance(gate_write.get(), setup_deadline)) {
+    return base::unexpected("Spawned owner retained: exec acceptance failed");
+  }
+  gate_write.reset();
+  auto applied = ReadSetup(status_read.get(), setup_deadline);
+  if (!applied.has_value()) {
+    return base::unexpected("Spawned owner retained: " + applied.error());
+  }
+  if (!applied.value().has_value()) {
+    return base::unexpected(
+        "Spawned owner retained: sandbox acknowledgement missing");
+  }
+  const auto& sandbox_message = **applied;
+  if (sandbox_message.kind != kOwnedHeadlessSandboxApplied ||
+      sandbox_message.error != 0) {
+    const bool exact_failure = sandbox_message.kind == kOwnedHeadlessFailed &&
+                               sandbox_message.error > 0;
+    return base::unexpected(
+        exact_failure
+            ? "Spawned owner retained: sandbox setup errno " +
+                  std::to_string(sandbox_message.error)
+            : "Spawned owner retained: invalid sandbox acknowledgement");
+  }
+  auto exec = ReadSetup(status_read.get(), setup_deadline);
+  if (!exec.has_value()) {
+    return base::unexpected("Spawned owner retained: " + exec.error());
+  }
+  if (exec.value().has_value()) {
+    const auto& failure = **exec;
+    const bool exact_failure =
+        failure.kind == kOwnedHeadlessFailed && failure.error > 0;
+    return base::unexpected(
+        exact_failure ? "Spawned owner retained: exec errno " +
+                            std::to_string(failure.error)
+                      : "Spawned owner retained: invalid exec receipt");
+  }
+  // EOF is never readiness or proof against an abruptly killed launcher.
+  // Retain the actual child; SDK admission later requires its live socket and
+  // authenticated protocol. Refuse an already observed terminal owner here.
+  auto observed = ObserveAnchor();
+  if (!observed.has_value() || exited_) {
+    return base::unexpected("Spawned owner retired during exec transition");
+  }
+  started_ = true;
+  return {};
+}
+base::expected<void, std::string> NativeOwnedHeadlessProcess::ObserveAnchor() {
+  if (uncertain_ || !ExclusiveDisposition()) {
+    uncertain_ = true;
+    return base::unexpected("Exclusive child ownership uncertain");
+  }
+  if (exited_) {
+    return {};
+  }
+  siginfo_t information{};
+  int observation;
+  do {
+    observation =
+        waitid(P_PID, pid_, &information, WEXITED | WNOHANG | WNOWAIT);
+  } while (observation != 0 && errno == EINTR);
+  if (observation != 0) {
+    uncertain_ = true;
+    return base::unexpected("Original child no longer waitable");
+  }
+  if (information.si_pid == 0) {
+    if (private_group_ && !ProjectProcessCurrent(identity_)) {
+      // It may have exited between waitid and live proc lookup; observe again
+      // once without adopting a different live process or releasing the anchor.
+      siginfo_t terminal{};
+      if (waitid(P_PID, pid_, &terminal, WEXITED | WNOHANG | WNOWAIT) != 0 ||
+          terminal.si_pid != pid_) {
+        uncertain_ = true;
+        return base::unexpected("Original live identity changed");
+      }
+      information = terminal;
+    } else {
+      return {};
+    }
+  }
+  if (information.si_pid != pid_ ||
+      (information.si_code != CLD_EXITED && information.si_code != CLD_KILLED &&
+       information.si_code != CLD_DUMPED)) {
+    uncertain_ = true;
+    return base::unexpected("Original terminal observation invalid");
+  }
+  exited_ = true;
+  if (information.si_code == CLD_EXITED) {
+    exit_.exit_code = information.si_status;
+  } else {
+    exit_.exit_signal = information.si_status;
+  }
+  return {};
+}
+base::expected<bool, std::string>
+NativeOwnedHeadlessProcess::OnlyRetainedLeader() {
+  std::array<pid_t, 4096> members{};
+  const int bytes =
+      proc_listpids(PROC_PGRP_ONLY, pid_, members.data(), sizeof(members));
+  if (bytes <= 0 || bytes >= static_cast<int>(sizeof(members)) ||
+      bytes % sizeof(pid_t) != 0) {
+    return base::unexpected(
+        "Original group inventory unavailable or truncated");
+  }
+  const size_t count = bytes / sizeof(pid_t);
+  bool leader = false;
+  for (size_t index = 0; index < count; ++index) {
+    if (members[index] <= 0) {
+      return base::unexpected("Invalid original group inventory");
+    }
+    if (members[index] == pid_) {
+      leader = true;
+    }
+  }
+  if (!leader) {
+    return base::unexpected("Retained original leader missing from group");
+  }
+  return count == 1;
+}
+void NativeOwnedHeadlessProcess::Drain(base::ScopedFD& pipe) {
+  std::array<char, 4096> bytes{};
+  // Bounded draining discards private output; no body or credential retention.
+  for (int iteration = 0; pipe.is_valid() && iteration < 16; ++iteration) {
+    const auto count =
+        HANDLE_EINTR(read(pipe.get(), bytes.data(), bytes.size()));
+    if (count == 0) {
+      pipe.reset();
+    } else if (count < 0) {
+      if (errno != EAGAIN && errno != EWOULDBLOCK) {
+        uncertain_ = true;
+      }
+      return;
+    }
+  }
+}
+void NativeOwnedHeadlessProcess::Maintain() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (pid_ == -1 || uncertain_) {
+    return;
+  }
+  DrainPipes();
+  if (!reaped_) {
+    auto observed = ObserveAnchor();
+    if (!observed.has_value()) {
+      return;  // Retain debt, never invent a new anchor.
+    }
+    if (exited_) {
+      auto stopped = Stop(base::TimeTicks::Now() + base::Milliseconds(20));
+      if (stopped.has_value() || uncertain_) {
+        return;
+      }
+    }
+  }
+  if (pid_ != -1 && !uncertain_) {
+    runner_->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&NativeOwnedHeadlessProcess::Maintain, retained_),
+        base::Milliseconds(50));
+  }
+}
+bool NativeOwnedHeadlessProcess::DrainPipes() {
+  Drain(output_);
+  Drain(errors_);
+  return !output_.is_valid() && !errors_.is_valid();
+}
+base::expected<std::string, std::string>
+NativeOwnedHeadlessProcess::LoopbackUri() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (pid_ <= 0 || reaped_ || stopping_ || !started_ || !private_group_) {
+    return base::unexpected("Original helper unavailable");
+  }
+  const auto observed = ObserveAnchor();
+  if (!observed.has_value() || exited_) {
+    return base::unexpected("Original helper retired");
+  }
+  DrainPipes();
+  if (!endpoint_) {
+    const auto listeners = FindProjectListeners(identity_);
+    if (listeners.size() != 1 || listeners.front().host != "127.0.0.1" ||
+        !ProjectListenerCurrent(identity_, listeners.front())) {
+      return base::unexpected("Unique original loopback endpoint not ready");
+    }
+    endpoint_ = listeners.front();
+  }
+  socket_fdinfo socket{};
+  const auto& listener = *endpoint_;
+  if (proc_pidfdinfo(listener.pid, listener.fd, PROC_PIDFDSOCKETINFO, &socket,
+                     sizeof(socket)) != static_cast<int>(sizeof(socket)) ||
+      socket.psi.soi_family != AF_INET ||
+      ntohl(socket.psi.soi_proto.pri_tcp.tcpsi_ini.insi_laddr.ina_46.i46a_addr4
+                .s_addr) != INADDR_LOOPBACK ||
+      !ProjectListenerCurrent(identity_, listener)) {
+    return base::unexpected("Original endpoint is not explicit IPv4 loopback");
+  }
+  return "127.0.0.1:" + std::to_string(listener.port);
+}
+base::expected<OwnedGroupJoined, std::string> NativeOwnedHeadlessProcess::Stop(
+    base::TimeTicks deadline) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  scoped_refptr<NativeOwnedHeadlessProcess> keep_alive(this);
+  if (joined_) {
+    return *joined_;
+  }
+  if (pid_ == -1) {
+    return base::unexpected("No owned launch");
+  }
+  stopping_ = true;
+  while (base::TimeTicks::Now() < deadline) {
+    if (!reaped_) {
+      auto anchor = ObserveAnchor();
+      if (!anchor.has_value()) {
+        return base::unexpected(anchor.error());
+      }
+      if (private_group_) {
+        auto inventory = OnlyRetainedLeader();
+        if (!inventory.has_value()) {
+          return base::unexpected(inventory.error());
+        }
+        if (exited_ && *inventory) {
+          int status = 0;
+          if (HANDLE_EINTR(waitpid(pid_, &status, WNOHANG)) != pid_) {
+            uncertain_ = true;
+            return base::unexpected("Original leader reap failed");
+          }
+          reaped_ = true;  // No subsequent signal may use this number.
+        } else if (kill(-pid_, SIGKILL) != 0 && errno != ESRCH) {
+          return base::unexpected("Original private group signal failed");
+        }
+      } else {
+        // A failed setup never executed CLI code. Exact original child only.
+        if (!exited_ && kill(pid_, SIGKILL) != 0 && errno != ESRCH) {
+          return base::unexpected("Original held launcher signal failed");
+        }
+        if (exited_) {
+          int status = 0;
+          if (HANDLE_EINTR(waitpid(pid_, &status, WNOHANG)) != pid_) {
+            uncertain_ = true;
+            return base::unexpected("Original launcher reap failed");
+          }
+          reaped_ = true;
+        }
+      }
+    }
+    const bool pipes_closed = DrainPipes();
+    if (uncertain_) {
+      return base::unexpected("Original pipe join uncertain");
+    }
+    if (reaped_ && pipes_closed) {
+      joined_ = exit_;
+      pid_ = -1;
+      retained_.reset();
+      return *joined_;
+    }
+    base::PlatformThread::Sleep(base::Milliseconds(10));
+  }
+  return base::unexpected("Original cleanup still pending; owner retained");
+}
+}  // namespace aux
