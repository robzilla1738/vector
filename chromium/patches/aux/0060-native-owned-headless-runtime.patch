+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_OWNED_HEADLESS_PROTOCOL_H_
+#define CHROME_BROWSER_UI_AUX_OWNED_HEADLESS_PROTOCOL_H_
+#include <cstdint>
+namespace aux {
+struct OwnedHeadlessSetupMessage {
+  uint32_t kind;
+  int32_t error;
+};
+inline constexpr uint32_t kOwnedHeadlessReady = 1;
+inline constexpr uint32_t kOwnedHeadlessFailed = 2;
+inline constexpr uint32_t kOwnedHeadlessSandboxApplied = 3;
+inline constexpr uint64_t kOwnedHeadlessMaximumCompiledPolicy = 1024 * 1024;
+struct OwnedHeadlessDeadline {
+  uint64_t monotonic_nanoseconds;
+};
+static_assert(sizeof(OwnedHeadlessDeadline) == 8);
+static_assert(sizeof(OwnedHeadlessSetupMessage) == 8);
+}  // namespace aux
+#endif
