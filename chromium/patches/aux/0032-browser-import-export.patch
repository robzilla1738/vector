diff --git a/chrome/browser/ui/aux/browser_export_decode.cc b/chrome/browser/ui/aux/browser_export_decode.cc
new file mode 100644
index 0000000..780bc92
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_export_decode.cc
@@ -0,0 +1,224 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_export_decode.h"
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/password_manager/core/browser/import/csv_password_sequence.h"
+#include "components/password_manager/core/browser/password_string.h"
+#include "third_party/zlib/google/zip_reader.h"
+namespace aux {
+namespace {
+constexpr size_t kEntryBytes = 32 * 1024 * 1024;
+constexpr size_t kArchiveBytes = 128 * 1024 * 1024;
+constexpr size_t kEntries = 256;
+bool SafeURL(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() &&
+      !url.has_username() && !url.has_password();
+}
+bool Selected(const std::vector<std::string>& categories, const char* name) {
+  return std::ranges::find(categories, name) != categories.end();
+}
+bool ReadPasswords(std::string text, DecodedBrowserProfile& output) {
+  password_manager::CSVPasswordSequence sequence(std::move(text));
+  if (sequence.result() != password_manager::CSVPassword::Status::kOK) return false;
+  for (const auto& row : sequence) {
+    if (row.GetParseStatus() != password_manager::CSVPassword::Status::kOK ||
+        !row.GetURL().has_value() || !SafeURL(*row.GetURL())) return false;
+    password_manager::StoredCredential credential;
+    credential.url = *row.GetURL();
+    credential.signon_realm = credential.url.DeprecatedGetOriginAsURL().spec();
+    credential.username_value = base::UTF8ToUTF16(row.GetUsername());
+    credential.password_value = password_manager::PasswordString(base::UTF8ToUTF16(row.GetPassword()));
+    credential.SetPasswordNote(base::UTF8ToUTF16(row.GetNote()));
+    output.passwords.push_back(std::move(credential));
+  }
+  return true;
+}
+std::optional<int64_t> Integer(const base::Value* value) {
+  if (!value || (!value->is_int() && !value->is_double())) return std::nullopt;
+  const double number = value->GetDouble();
+  if (!std::isfinite(number) || number < 0 || number > 9007199254740991.0 ||
+      std::floor(number) != number) return std::nullopt;
+  return static_cast<int64_t>(number);
+}
+bool ReadHistory(const base::DictValue& data, DecodedBrowserProfile& output) {
+  const auto* items = data.FindList("history");
+  if (!items) return false;
+  for (const auto& item : *items) {
+    if (!item.is_dict()) return false;
+    const auto& row = item.GetDict();
+    const auto* address = row.FindString("url");
+    const auto time = Integer(row.Find("time_usec"));
+    // Apple's published schema calls this visits_count; actual Safari archives
+    // and Chromium's maintained fixtures also use visit_count. Neither is used
+    // to invent visits: the destination imports the exact most-recent visit.
+    const auto* documented = row.Find("visits_count");
+    const auto* exported = row.Find("visit_count");
+    const auto visits = Integer(documented ? documented : exported);
+    if (!address || !time || ((documented || exported) && (!visits || !*visits)) ||
+        (documented && exported && Integer(documented) != Integer(exported))) return false;
+    GURL url(*address);
+    if (!SafeURL(url)) continue;
+    const auto* title = row.FindString("title");
+    output.history.push_back({url, title ? base::UTF8ToUTF16(*title) : std::u16string(),
+        base::Time::UnixEpoch() + base::Microseconds(*time)});
+  }
+  return true;
+}
+}  // namespace
+DecodedBrowserProfile DecodeBrowserExport(const base::FilePath& directory,
+    const std::string& leaf, BrowserExportFormat format,
+    const std::vector<std::string>& categories,
+    const base::RepeatingCallback<bool()>& cancelled,
+    const BrowserExportGroup* selected_group) {
+  DecodedBrowserProfile output;
+  auto snapshot = BrowserProfileSnapshot::Capture(directory, {leaf}, false, cancelled);
+  if (!snapshot.has_value()) {
+    output.snapshot_error = snapshot.error();
+    return output;
+  }
+  output.snapshot = std::move(*snapshot);
+  const auto file = output.snapshot->path().Append(leaf);
+  auto fail = [&](const char* message) {
+    output.snapshot_error = message;
+    output.passwords.clear();
+    output.bookmark_html.clear();
+  };
+  if (format != BrowserExportFormat::kSafariArchive) {
+    std::string text;
+    if (!base::ReadFileToStringWithMaxSize(file, &text, kEntryBytes)) {
+      fail("The selected browser export is unavailable or exceeds the safe file size.");
+      return output;
+    }
+    output.export_categories.push_back(format == BrowserExportFormat::kPasswordsCsv ? "passwords" :
+        format == BrowserExportFormat::kTabsHtml ? "tabs" : "bookmarks");
+    if (format == BrowserExportFormat::kPasswordsCsv) {
+      if (!ReadPasswords(std::move(text), output)) fail("The selected password CSV is not a valid browser export.");
+    } else {
+      // The existing sandboxed Chromium BookmarkHtmlParser performs HTML parsing
+      // later. Never run ParseBookmarksUnsafe in the browser process.
+      output.bookmark_html = std::move(text);
+      output.bookmarks_as_tabs = format == BrowserExportFormat::kTabsHtml;
+    }
+  } else {
+    zip::ZipReader archive;
+    if (!archive.Open(file)) {
+      fail("The selected Safari export is not a readable ZIP archive.");
+      return output;
+    }
+    size_t entries = 0, bytes = 0;
+    std::set<std::string> names;
+    bool has_html = false, has_csv = false, has_history = false;
+    bool has_extensions = false;
+    BrowserExportGroup shared; shared.label = "Shared bookmarks and passwords";
+    std::set<std::string> selected_entries;
+    auto selected_entry = [&](const std::string& name) {
+      return !selected_group || std::ranges::find(selected_group->entries, name) != selected_group->entries.end();
+    };
+    while (const auto* entry = archive.Next()) {
+      if (cancelled.Run() || ++entries > kEntries || entry->is_unsafe ||
+          entry->is_symbolic_link || entry->is_encrypted ||
+          !names.insert(entry->path.value()).second) {
+        fail("The browser archive contains unsafe or duplicate entries, or was cancelled.");
+        return output;
+      }
+      if (entry->is_directory) continue;
+      std::string text;
+      if (!archive.ExtractCurrentEntryToString(kEntryBytes, &text) ||
+          text.size() > kArchiveBytes - bytes) {
+        fail("The browser archive exceeds the safe expanded size or is damaged.");
+        return output;
+      }
+      bytes += text.size();
+      const std::string entry_name = entry->path.value();
+      const bool included = selected_entry(entry_name);
+      if (included) selected_entries.insert(entry_name);
+      const auto extension = base::ToLowerASCII(entry->path.FinalExtension());
+      if (extension == ".html") {
+        if (has_html) { fail("The archive contains more than one bookmark export."); return output; }
+        has_html = true;
+        shared.entries.push_back(entry_name); shared.categories.push_back("bookmarks");
+        if (included && Selected(categories, "bookmarks")) output.bookmark_html = std::move(text);
+      } else if (extension == ".csv") {
+        if (has_csv) { fail("The archive contains more than one password export."); return output; }
+        has_csv = true;
+        shared.entries.push_back(entry_name); shared.categories.push_back("passwords");
+        DecodedBrowserProfile decoded;
+        if (!ReadPasswords(std::move(text), decoded)) {
+          shared.errors["passwords"] = "The Safari password export is not valid.";
+          if (included && Selected(categories, "passwords")) output.errors["passwords"] = shared.errors["passwords"];
+        } else if (included && Selected(categories, "passwords")) output.passwords = std::move(decoded.passwords);
+      } else if (extension == ".json") {
+        auto parsed = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+        if (!parsed) { fail("The Safari export contains invalid JSON metadata."); return output; }
+        const auto* metadata = parsed->FindDict("metadata");
+        const auto* browser = metadata ? metadata->FindString("browser_name") : nullptr;
+        const auto* type = metadata ? metadata->FindString("data_type") : nullptr;
+        const auto version = metadata ? Integer(metadata->Find("schema_version")) : std::nullopt;
+        if (!browser || (*browser != "Safari" && *browser != "Safari Technology Preview") ||
+            !type || !version || *version != 1) {
+          fail("This archive does not use the supported official Safari export schema."); return output;
+        }
+        if (*type == "history" || *type == "extensions") {
+          BrowserExportGroup group;
+          group.label = base::UTF16ToUTF8(base::UTF8ToUTF16(entry->path.BaseName().value()));
+          std::erase_if(group.label, [](char c) { return base::IsAsciiControl(c); });
+          group.label = std::string(base::TruncateUTF8ToByteSize(group.label, 200));
+          if (group.label.empty()) group.label = "Unnamed exported data file";
+          group.entries.push_back(entry_name); group.categories.push_back(*type);
+          DecodedBrowserProfile decoded;
+          if (*type == "history") {
+            has_history = true;
+            if (!ReadHistory(*parsed, decoded)) group.errors["history"] = "The Safari history file is not valid.";
+          } else {
+            has_extensions = true;
+            auto candidates = ReadSafariExtensionCandidates(*parsed);
+            if (!candidates) group.errors["extensions"] = "The Safari extension metadata is malformed or too large.";
+            else decoded.extension_candidates = std::move(*candidates);
+          }
+          if (included && Selected(categories, type->c_str())) {
+            if (!group.errors.empty()) output.errors.insert(group.errors.begin(), group.errors.end());
+            else if (*type == "history") output.history = std::move(decoded.history);
+            else output.extension_candidates = std::move(decoded.extension_candidates);
+          }
+          output.export_groups.push_back(std::move(group));
+        } else if (*type != "payment_cards") {
+          fail("The Safari export has an unknown data type."); return output;
+        }
+        // Payment cards and OTP seeds are outside browser import categories.
+        // Safari App Store IDs are not Chrome Web Store IDs; never infer a mapping.
+      }
+    }
+    if (!shared.categories.empty()) output.export_groups.insert(output.export_groups.begin(), std::move(shared));
+    if (selected_group) {
+      for (const auto& requested : categories) {
+        if (std::ranges::find(selected_group->categories, requested) == selected_group->categories.end()) {
+          fail("The selected category does not belong to this immutable export group."); return output;
+        }
+      }
+      for (const auto& name : selected_group->entries) {
+        if (!selected_entries.contains(name)) { fail("An original selected export entry is missing."); return output; }
+      }
+      output.export_categories = selected_group->categories;
+    }
+    if (!selected_group && has_html) output.export_categories.push_back("bookmarks");
+    if (!selected_group && has_history) output.export_categories.push_back("history");
+    if (!selected_group && has_csv) output.export_categories.push_back("passwords");
+    if (!selected_group && has_extensions) output.export_categories.push_back("extensions");
+    if (!archive.ok() || (Selected(categories, "bookmarks") && !has_html) ||
+        (Selected(categories, "passwords") && !has_csv) ||
+        (Selected(categories, "history") && !has_history) ||
+        (Selected(categories, "extensions") && !has_extensions))
+      fail("The selected Safari categories are missing or the archive is damaged.");
+  }
+  if (cancelled.Run() || !output.snapshot->OriginalIsCurrent())
+    fail("The original browser export changed or its import was cancelled.");
+  return output;
+}
+}  // namespace aux
