+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_SNAPSHOT_H_
+#define CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_SNAPSHOT_H_
+
+#include <memory>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/types/expected.h"
+
+namespace aux {
+// Created only from a native-discovered or human-selected browser Profile.
+// Original directory/file descriptors remain held until the native job retires.
+// Decoders may mutate the disposable copy; they never receive original paths.
+class BrowserProfileSnapshot {
+ public:
+  static base::expected<std::unique_ptr<BrowserProfileSnapshot>, std::string>
+  Capture(const base::FilePath& profile, const std::vector<std::string>& files,
+          bool include_sessions, const base::RepeatingCallback<bool()>& cancelled,
+          bool include_firefox_sessions = false,
+          std::map<std::string, std::string>* firefox_copy_errors = nullptr);
+  ~BrowserProfileSnapshot();
+  BrowserProfileSnapshot(const BrowserProfileSnapshot&) = delete;
+  BrowserProfileSnapshot& operator=(const BrowserProfileSnapshot&) = delete;
+  bool OriginalIsCurrent() const;
+  const base::FilePath& path() const { return directory_.GetPath(); }
+ private:
+  struct HeldEntry;
+  BrowserProfileSnapshot();
+  base::ScopedTempDir directory_;
+  std::vector<std::unique_ptr<HeldEntry>> originals_;
+};
+}  // namespace aux
+#endif
