diff --git a/chrome/browser/ui/aux/browser_profile_discovery.cc b/chrome/browser/ui/aux/browser_profile_discovery.cc
new file mode 100644
index 0000000..8ee9e97
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_profile_discovery.cc
@@ -0,0 +1,154 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_profile_discovery.h"
+#include <algorithm>
+#include <set>
+#include <string_view>
+#include <utility>
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "chrome/common/ini_parser.h"
+#include "chrome/common/importer/firefox_importer_utils.h"
+#include "base/strings/string_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/aux/browser_profile_snapshot.h"
+#include "components/sessions/core/session_constants.h"
+namespace aux {
+namespace {
+struct Source {
+  const char* id;
+  const char* label;
+  const char* relative_path;
+  BrowserProfileBrand brand;
+};
+constexpr Source kSources[] = {
+  {"chrome", "Chrome", "Google/Chrome", BrowserProfileBrand::kChrome},
+  {"chrome-beta", "Chrome Beta", "Google/Chrome Beta", BrowserProfileBrand::kChrome},
+  {"chromium", "Chromium", "Chromium", BrowserProfileBrand::kChromium},
+  {"edge", "Microsoft Edge", "Microsoft Edge", BrowserProfileBrand::kEdge},
+  {"brave", "Brave", "BraveSoftware/Brave-Browser", BrowserProfileBrand::kBrave},
+  {"arc", "Arc", "Arc/User Data", BrowserProfileBrand::kArc},
+  {"dia", "Dia", "Dia/User Data", BrowserProfileBrand::kDia},
+  {"comet", "Comet", "Comet", BrowserProfileBrand::kComet},
+};
+bool ProfileName(const std::string& value) {
+  return !value.empty() && value.size() <= 64 && value != "." && value != ".." &&
+      value.find_first_of("/\\") == std::string::npos &&
+      value.find('\0') == std::string::npos;
+}
+bool ConventionalProfile(const std::string& name) {
+  if (name == "Default") return true;
+  if (!base::StartsWith(name, "Profile ")) return false;
+  const auto suffix = std::string_view(name).substr(8);
+  return !suffix.empty() && std::ranges::all_of(suffix,
+      [](char c) { return c >= '0' && c <= '9'; });
+}
+}  // namespace
+base::expected<std::vector<DiscoveredBrowserProfile>, std::string>
+DiscoverBrowserProfiles(
+    const base::RepeatingCallback<bool()>& cancelled) {
+  std::vector<DiscoveredBrowserProfile> found;
+  if (!cancelled || cancelled.Run())
+    return base::unexpected("Browser import was cancelled.");
+  const auto support = base::GetHomeDir().AppendASCII("Library/Application Support");
+  for (const auto& source : kSources) {
+    if (cancelled.Run()) return base::unexpected("Browser import was cancelled.");
+    const auto root = support.AppendASCII(source.relative_path);
+    if (!base::DirectoryExists(root)) continue;
+    auto root_copy = BrowserProfileSnapshot::Capture(root, {"Local State"}, false, cancelled);
+    if (!root_copy.has_value()) continue;
+    std::set<std::string> registered;
+    std::string json;
+    if (base::ReadFileToStringWithMaxSize((*root_copy)->path().AppendASCII("Local State"),
+                                         &json, 8 * 1024 * 1024)) {
+      auto state = base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+      const auto* cache = state ? state->FindDictByDottedPath("profile.info_cache") : nullptr;
+      if (cache) for (const auto [name, value] : *cache)
+        if (ProfileName(name)) registered.insert(name);
+    }
+    base::FileEnumerator profiles(root, false, base::FileEnumerator::DIRECTORIES);
+    for (auto path = profiles.Next(); !path.empty(); path = profiles.Next()) {
+      if (cancelled.Run()) return base::unexpected("Browser import was cancelled.");
+      if (found.size() == 128)
+        return base::unexpected("Too many browser Profiles are present. Select a source Profile explicitly.");
+      const auto name = path.BaseName().value();
+      if (!ProfileName(name) || (!ConventionalProfile(name) && !registered.contains(name))) continue;
+      auto anchor = BrowserProfileSnapshot::Capture(path, {}, false, cancelled);
+      if (!anchor.has_value() || !(*root_copy)->OriginalIsCurrent()) continue;
+      std::vector<std::string> categories;
+      if (base::PathExists(path.AppendASCII("Bookmarks"))) categories.push_back("bookmarks");
+      if (base::PathExists(path.AppendASCII("History"))) categories.push_back("history");
+      if (base::DirectoryExists(path.Append(sessions::kSessionsDirectory)) ||
+          base::DirectoryExists(path.Append(sessions::kEncryptedSessionsDirectory))) categories.push_back("tabs");
+      if (base::PathExists(path.AppendASCII("Login Data")) ||
+          base::PathExists(path.AppendASCII("Login Data For Account"))) categories.push_back("passwords");
+      if (base::PathExists(path.AppendASCII("Preferences")) ||
+          base::PathExists(path.AppendASCII("Secure Preferences"))) categories.push_back("extensions");
+      if (!categories.empty()) found.push_back({source.id, source.label, name, source.brand,
+          path, std::move(*anchor), std::move(categories), std::nullopt, {}});
+    }
+  }
+  // Arc's shared sidebar belongs to its application storage root, not to an
+  // inferred Chromium Profile below User Data. Publish it exactly once.
+  const auto arc_root = support.AppendASCII("Arc");
+  if (base::PathExists(arc_root.AppendASCII("StorableSidebar.json"))) {
+    auto sidebar = BrowserProfileSnapshot::Capture(arc_root, {"StorableSidebar.json"}, false, cancelled);
+    if (sidebar.has_value() && (*sidebar)->OriginalIsCurrent()) {
+      if (found.size() >= 128) return base::unexpected("Too many browser sources are present.");
+      DiscoveredBrowserProfile source;
+      source.source_id = "arc";
+      source.label = "Arc";
+      source.profile_id = "Arc sidebar (all Spaces)";
+      source.brand = BrowserProfileBrand::kArc;
+      source.path = arc_root;
+      source.anchor = std::move(*sidebar);
+      source.categories = {"bookmarks", "tabs"};
+      source.arc_sidebar = true;
+      found.push_back(std::move(source));
+    }
+  }
+  const auto firefox_ini = GetProfilesINI();
+  auto firefox_registration = BrowserProfileSnapshot::Capture(
+      firefox_ini.DirName(), {firefox_ini.BaseName().value()}, false, cancelled);
+  if (firefox_registration.has_value()) {
+    std::string ini;
+    if (base::ReadFileToStringWithMaxSize(
+        (*firefox_registration)->path().Append(firefox_ini.BaseName()), &ini, 1024 * 1024)) {
+      DictionaryValueINIParser parser;
+      parser.Parse(ini);
+      std::shared_ptr<BrowserProfileSnapshot> registration(std::move(*firefox_registration));
+      std::set<base::FilePath> visited;
+      size_t ordinal = 0;
+      for (const auto& detail : GetFirefoxDetailsFromDictionary(parser.root(), "")) {
+        const auto profile_id = "Firefox " + base::NumberToString(ordinal++) + ": " + detail.path.BaseName().value().substr(0, 48);
+        if (cancelled.Run()) return base::unexpected("Browser import was cancelled.");
+        if (found.size() >= 128) return base::unexpected("Too many registered browser Profiles are present.");
+        if (!detail.path.IsAbsolute() || detail.path.ReferencesParent() ||
+            !ProfileName(detail.path.BaseName().value()) || !visited.insert(detail.path).second) continue;
+        auto anchor = BrowserProfileSnapshot::Capture(detail.path, {}, false, cancelled);
+        if (!anchor.has_value() || !registration->OriginalIsCurrent()) continue;
+        std::vector<std::string> categories;
+        if (base::PathExists(detail.path.AppendASCII("places.sqlite"))) categories = {"bookmarks", "history"};
+        if (base::PathExists(detail.path.AppendASCII("sessionstore.jsonlz4")) ||
+            base::PathExists(detail.path.AppendASCII("sessionstore-backups").AppendASCII("recovery.jsonlz4")) ||
+            base::PathExists(detail.path.AppendASCII("sessionstore-backups").AppendASCII("recovery.baklz4"))) categories.push_back("tabs");
+        if (base::PathExists(detail.path.AppendASCII("extensions.json"))) categories.push_back("extensions");
+        if (categories.empty()) continue;
+        found.push_back({
+            .source_id = "firefox",
+            .label = "Firefox",
+            .profile_id = profile_id,
+            .brand = BrowserProfileBrand::kChrome,
+            .path = detail.path,
+            .anchor = std::move(*anchor),
+            .categories = std::move(categories),
+            .firefox_profile = true,
+            .registration_anchor = registration});
+      }
+    }
+  }
+  return found;
+}
+}  // namespace aux
