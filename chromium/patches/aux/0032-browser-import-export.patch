+#ifndef CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_DECODE_H_
+#define CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_DECODE_H_
+#include <map>
+#include <memory>
