+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_export_picker.h"
+#import <Cocoa/Cocoa.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+#include "base/apple/foundation_util.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/single_thread_task_runner.h"
+namespace aux {
+namespace {
+class MacBrowserExportPicker final : public BrowserExportPicker {
+ public:
+  MacBrowserExportPicker(NSWindow* window, BrowserExportFormat format, Selected selected)
+      : selected_(std::move(selected)) {
+    panel_ = [NSOpenPanel openPanel];
+    panel_.allowsMultipleSelection = NO;
+    panel_.canChooseDirectories = NO;
+    panel_.canChooseFiles = YES;
+    panel_.resolvesAliases = NO;
+    panel_.prompt = @"Review export";
+    panel_.message = @"Choose a browser export. Aux reads a private snapshot; it does not modify this file or the original browser.";
+    NSString* extension = format == BrowserExportFormat::kSafariArchive ? @"zip" :
+        format == BrowserExportFormat::kPasswordsCsv ? @"csv" : @"html";
+    UTType* type = [UTType typeWithFilenameExtension:extension];
+    if (type) panel_.allowedContentTypes = @[type];
+    auto weak = weak_factory_.GetWeakPtr();
+    [panel_ beginSheetModalForWindow:window completionHandler:^(NSModalResponse response) {
+      if (!weak) return;
+      auto callback = std::move(weak->selected_);
+      base::expected<base::FilePath, std::string> result =
+          base::unexpected("Browser export selection was cancelled.");
+      if (response == NSModalResponseOK && weak->panel_.URL.isFileURL)
+        result = base::apple::NSURLToFilePath(weak->panel_.URL);
+      weak->panel_ = nil;
+      // The owner may destroy the panel object in this callback. Dispatch it
+      // after Cocoa has returned from the original sheet completion stack.
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+          base::BindOnce(std::move(callback), std::move(result)));
+    }];
+  }
+  ~MacBrowserExportPicker() override {
+    weak_factory_.InvalidateWeakPtrs();
+    Cancel();
+  }
+  void Cancel() override { if (panel_) [panel_ cancel:nil]; }
+ private:
+  NSOpenPanel* __strong panel_ = nil;
+  Selected selected_;
+  base::WeakPtrFactory<MacBrowserExportPicker> weak_factory_{this};
+};
+}  // namespace
+std::unique_ptr<BrowserExportPicker> BrowserExportPicker::Show(
+    gfx::NativeWindow original_window, BrowserExportFormat format, Selected selected) {
+  NSWindow* window = original_window.GetNativeNSWindow();
+  if (!window || !window.isVisible) return nullptr;
+  return std::make_unique<MacBrowserExportPicker>(window, format, std::move(selected));
+}
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/browser_firefox_import.cc b/chrome/browser/ui/aux/browser_firefox_import.cc
new file mode 100644
index 0000000..f85ab56
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_firefox_import.cc
@@ -0,0 +1,61 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_firefox_import.h"
+#include <algorithm>
+#include <cmath>
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/public/browser/service_process_host.h"
+namespace aux {
+BrowserFirefoxImport::BrowserFirefoxImport() = default;
+BrowserFirefoxImport::~BrowserFirefoxImport() = default;
+void BrowserFirefoxImport::Start(DecodedBrowserProfile& captured, const std::vector<std::string>& categories, Completed completed) {
+  CHECK(!completed_ && !decoder_.is_bound());
+  completed_ = std::move(completed);
+  decoder_ = content::ServiceProcessHost::Launch<chrome::mojom::AuxFirefoxProfileDecoder>(content::ServiceProcessHost::Options().WithDisplayName(u"Firefox import decoder").WithObserver(weak_factory_.GetWeakPtr()).Pass());
+  decoder_.set_disconnect_handler(base::BindOnce(&BrowserFirefoxImport::OnDisconnected, base::Unretained(this)));
+  auto selected = [&](const char* category) { return std::ranges::find(categories, category) != categories.end(); };
+  decoder_->Decode(std::move(captured.firefox_database), std::move(captured.firefox_wal), std::move(captured.firefox_journal), std::move(captured.firefox_session), selected("history"), selected("bookmarks"), selected("tabs"), base::BindOnce(&BrowserFirefoxImport::OnDecoded, base::Unretained(this)));
+}
+void BrowserFirefoxImport::OnDisconnected() {
+  decoder_.reset();
+  // Pipe closure alone cannot acknowledge that transferred FDs are closed.
+  // Retain the original job until the exact service's exit/crash notification.
+  if (process_retired_ && completed_) std::move(completed_).Run(base::unexpected("The Firefox utility decoder exited before completion. No decoded batch was accepted."));
+}
+void BrowserFirefoxImport::OnServiceProcessTerminatedNormally(const content::ServiceProcessInfo&) {
+  process_retired_ = true;
+  OnDisconnected();
+}
+void BrowserFirefoxImport::OnServiceProcessCrashed(const content::ServiceProcessInfo&) {
+  process_retired_ = true;
+  OnDisconnected();
+}
+void BrowserFirefoxImport::OnDecoded(chrome::mojom::AuxFirefoxProfileResultPtr source) {
+  decoder_.reset();
+  if (!source || source->error) {
+    std::move(completed_).Run(base::unexpected(source && source->error ? *source->error : "The Firefox utility result is unavailable.")); return;
+  }
+  FirefoxImportResult result;
+  for (const auto& [category, error] : source->category_errors) {
+    if ((category != "history" && category != "bookmarks" && category != "tabs") || error.empty() || error.size() > 1000) {
+      std::move(completed_).Run(base::unexpected("The Firefox utility returned an invalid category receipt.")); return;
+    }
+    result.errors.emplace(category, error);
+  }
+  if ((result.errors.contains("history") && !source->history.empty()) ||
+      (result.errors.contains("bookmarks") && !source->bookmarks.empty()) ||
+      (result.errors.contains("tabs") && !source->tabs.empty())) {
+    std::move(completed_).Run(base::unexpected("The Firefox utility returned a partial failed-category batch.")); return;
+  }
+  for (const auto& row : source->history) result.history.push_back({row->url, base::UTF8ToUTF16(row->title), base::Time::FromMillisecondsSinceUnixEpoch(row->visited_at)});
+  for (const auto& row : source->bookmarks) {
+    user_data_importer::ImportedBookmarkEntry entry; entry.url = row->url; entry.title = base::UTF8ToUTF16(row->title); entry.is_folder = row->is_folder; entry.in_toolbar = false;
+    for (const auto& part : row->path) entry.path.push_back(base::UTF8ToUTF16(part));
+    result.bookmarks.push_back(std::move(entry));
+  }
+  for (const auto& row : source->tabs) result.tabs.push_back({row->url, base::UTF8ToUTF16(row->title), row->window_id, row->pinned});
+  std::move(completed_).Run(std::move(result));
+}
+}  // namespace aux
