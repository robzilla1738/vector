diff --git a/chrome/browser/ui/aux/browser_profile_extension_candidates.cc b/chrome/browser/ui/aux/browser_profile_extension_candidates.cc
new file mode 100644
index 0000000..4f26f77
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_profile_extension_candidates.cc
@@ -0,0 +1,187 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/ui/aux/browser_profile_extension_candidates.h"
+
+#include <algorithm>
+#include <map>
+#include <string_view>
+
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/ui/aux/browser_profile_snapshot.h"
+#include "extensions/common/extension_urls.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+constexpr size_t kMetadataBytes = 16 * 1024 * 1024;
+bool Text(const std::string* value, size_t limit) {
+  return value && !value->empty() && value->size() <= limit &&
+         base::IsStringUTF8(*value) &&
+         std::ranges::none_of(*value, [](unsigned char c) {
+           return c < 32 || c == 127;
+         });
+}
+std::string Name(const base::DictValue& metadata, const std::string& id) {
+  const auto* name = metadata.FindString("name");
+  return Text(name, 200) && !base::StartsWith(*name, "__MSG_") ? *name : id;
+}
+bool StoreURL(const GURL& url) {
+  return url.is_valid() && url.SchemeIs("https") && !url.has_username() &&
+         !url.has_password() && !url.has_ref();
+}
+base::expected<base::DictValue, std::string> ReadMetadata(
+    const BrowserProfileSnapshot& snapshot, const char* leaf) {
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original extension source changed.");
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(snapshot.path().AppendASCII(leaf),
+                                       &text, kMetadataBytes))
+    return base::unexpected("The extension metadata is unavailable or too large.");
+  auto parsed = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  if (!parsed || !snapshot.OriginalIsCurrent())
+    return base::unexpected("The extension metadata is malformed or changed.");
+  return std::move(*parsed);
+}
+}  // namespace
+
+bool ValidChromeWebStoreId(const std::string& id) {
+  return id.size() == 32 && std::ranges::all_of(id, [](char c) {
+    return c >= 'a' && c <= 'p';
+  });
+}
+
+base::expected<std::vector<BrowserExtensionCandidate>, std::string>
+ReadChromiumExtensionCandidates(const BrowserProfileSnapshot& snapshot) {
+  std::map<std::string, BrowserExtensionCandidate> candidates;
+  for (const char* leaf : {"Preferences", "Secure Preferences"}) {
+    if (!base::PathExists(snapshot.path().AppendASCII(leaf))) continue;
+    auto data = ReadMetadata(snapshot, leaf);
+    if (!data) return base::unexpected(data.error());
+    const auto* settings = data->FindDictByDottedPath("extensions.settings");
+    if (!settings) continue;
+    if (settings->size() > kBrowserExtensionCandidateLimit)
+      return base::unexpected("Too many source extensions to review safely.");
+    for (const auto [id, value] : *settings) {
+      const auto* source = value.GetIfDict();
+      if (!ValidChromeWebStoreId(id) || !source)
+        return base::unexpected("The browser extension identity is malformed.");
+      const auto* manifest = source->FindDict("manifest");
+      BrowserExtensionCandidate candidate;
+      candidate.source_id = id;
+      candidate.name = manifest ? Name(*manifest, id) : id;
+      candidate.kind = "unsupported";
+      candidate.detail = "No verified store origin is available. This item is not installed automatically.";
+      // Chromium's current persistent disable-reasons list is authoritative.
+      // Missing state stays unknown; metadata absence is not permission to enable.
+      if (const auto* reasons = source->FindList("disable_reasons")) {
+        if (reasons->size() > 64 || std::ranges::any_of(*reasons, [](const base::Value& reason) {
+              return !reason.is_int() || reason.GetInt() <= 0;
+            })) return base::unexpected("The source extension disabled state is malformed.");
+        candidate.enabled = reasons->empty();
+      }
+      const auto* update = manifest ? manifest->FindString("update_url") : nullptr;
+      const GURL url(update ? *update : std::string());
+      if (StoreURL(url) && extension_urls::IsWebstoreUpdateUrl(url) &&
+          source->FindBool("from_webstore").value_or(false)) {
+        candidate.kind = "cws";
+        candidate.chrome_web_store_id = id;
+        candidate.detail = "Reinstall this Chrome Web Store item after its native permission review.";
+      } else if (StoreURL(url) && url.host() == "edge.microsoft.com" &&
+                 url.path() == "/extensionwebstorebase/v1/crx") {
+        candidate.kind = "edge";
+        candidate.detail = "Choose a Chrome Web Store counterpart explicitly; the Edge store ID is not a Chrome ID.";
+      }
+      const auto existing = candidates.find(id);
+      if (existing != candidates.end() && existing->second != candidate)
+        return base::unexpected("The source contains conflicting extension metadata. Refresh its preview.");
+      candidates.insert_or_assign(id, std::move(candidate));
+      if (candidates.size() > kBrowserExtensionCandidateLimit)
+        return base::unexpected("Too many source extensions to review safely.");
+    }
+  }
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original browser extension list changed.");
+  std::vector<BrowserExtensionCandidate> result;
+  for (auto& [id, candidate] : candidates) result.push_back(std::move(candidate));
+  return result;
+}
+
+base::expected<std::vector<BrowserExtensionCandidate>, std::string>
+ReadFirefoxExtensionCandidates(const BrowserProfileSnapshot& snapshot) {
+  auto data = ReadMetadata(snapshot, "extensions.json");
+  if (!data) return base::unexpected(data.error());
+  // Firefox's published XPIProvider/XPIDatabase current persistent schema.
+  // A future schema needs an explicit decoder update rather than guessed IDs.
+  if (data->FindInt("schemaVersion") != 37)
+    return base::unexpected("This Firefox extension metadata schema is not supported.");
+  const auto* addons = data->FindList("addons");
+  if (!addons || addons->size() > kBrowserExtensionCandidateLimit)
+    return base::unexpected("The Firefox extension list is malformed or too large.");
+  std::vector<BrowserExtensionCandidate> result;
+  std::map<std::string, bool> ids;
+  for (const auto& value : *addons) {
+    const auto* source = value.GetIfDict();
+    if (!source) return base::unexpected("The Firefox extension record is malformed.");
+    const auto* type = source->FindString("type");
+    if (!type) return base::unexpected("The Firefox add-on type is missing.");
+    if (*type != "extension") continue;
+    const auto* id = source->FindString("id");
+    const auto* location = source->FindString("location");
+    const auto* locale = source->FindDict("defaultLocale");
+    const auto* name = locale ? locale->FindString("name") : nullptr;
+    if (!Text(id, 512) || !Text(name, 200) || !Text(location, 64) || ids.contains(*id))
+      return base::unexpected("The Firefox extension identity is malformed or duplicated.");
+    ids.emplace(*id, true);
+    BrowserExtensionCandidate candidate;
+    candidate.source_id = *id;
+    candidate.name = *name;
+    candidate.kind = *location == "app-profile" ? "firefox" : "unsupported";
+    candidate.enabled = source->FindBool("active");
+    candidate.detail = candidate.kind == "firefox" ?
+        "Choose a Chrome Web Store counterpart explicitly; Firefox add-on IDs are not Chrome IDs." :
+        "This built-in or non-Profile add-on has no transferable Chromium installation.";
+    if (source->FindBool("pendingUninstall").value_or(false)) {
+      candidate.kind = "unsupported";
+      candidate.detail = "This add-on is pending removal in the source browser.";
+    }
+    result.push_back(std::move(candidate));
+  }
+  return result;
+}
+
+base::expected<std::vector<BrowserExtensionCandidate>, std::string>
+ReadSafariExtensionCandidates(const base::DictValue& exported) {
+  const auto* metadata = exported.FindDict("metadata");
+  const auto* browser = metadata ? metadata->FindString("browser_name") : nullptr;
+  const auto* type = metadata ? metadata->FindString("data_type") : nullptr;
+  if (!browser || (*browser != "Safari" && *browser != "Safari Technology Preview") ||
+      !type || *type != "extensions" ||
+      metadata->FindInt("schema_version") != 1)
+    return base::unexpected("The Safari extension export schema is not supported.");
+  const auto* extensions = exported.FindList("extensions");
+  if (!extensions || extensions->size() > kBrowserExtensionCandidateLimit)
+    return base::unexpected("The Safari extension list is malformed or too large.");
+  std::vector<BrowserExtensionCandidate> result;
+  std::map<std::string, bool> ids;
+  for (const auto& value : *extensions) {
+    const auto* source = value.GetIfDict();
+    const auto* id = source ? source->FindString("composed_identifier") : nullptr;
+    const auto* name = source ? source->FindString("display_name") : nullptr;
+    const auto* publisher = source ? source->FindString("developer_name") : nullptr;
+    if (!Text(id, 512) || !Text(name, 200) || !Text(publisher, 200) || ids.contains(*id))
+      return base::unexpected("The Safari extension identity is malformed or duplicated.");
+    ids.emplace(*id, true);
+    BrowserExtensionCandidate candidate;
+    candidate.source_id = *id;
+    candidate.name = *name;
+    candidate.publisher = *publisher;
+    candidate.enabled = true;  // Apple's export contains installed, enabled items.
+    candidate.kind = "safari";
+    candidate.detail = "Choose a Chrome Web Store counterpart explicitly. Safari apps and their data are not transferred.";
+    result.push_back(std::move(candidate));
+  }
+  return result;
+}
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/browser_profile_extension_candidates.h b/chrome/browser/ui/aux/browser_profile_extension_candidates.h
new file mode 100644
index 0000000..98f709a
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_profile_extension_candidates.h
@@ -0,0 +1,39 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license.
+#ifndef CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_EXTENSION_CANDIDATES_H_
+#define CHROME_BROWSER_UI_AUX_BROWSER_PROFILE_EXTENSION_CANDIDATES_H_
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/types/expected.h"
+#include "base/values.h"
+
+namespace aux {
+class BrowserProfileSnapshot;
+
+// Source metadata only. No executable paths, source settings, downloaded code,
+// or inferred cross-store identifiers are retained or exposed.
+struct BrowserExtensionCandidate {
+  std::string source_id;
+  std::string name;
+  std::string kind;
+  std::string publisher;
+  std::optional<bool> enabled;
+  std::string chrome_web_store_id;
+  std::string detail;
+  bool operator==(const BrowserExtensionCandidate&) const = default;
+};
+
+constexpr size_t kBrowserExtensionCandidateLimit = 512;
+bool ValidChromeWebStoreId(const std::string& id);
+base::expected<std::vector<BrowserExtensionCandidate>, std::string>
+ReadChromiumExtensionCandidates(const BrowserProfileSnapshot& snapshot);
+base::expected<std::vector<BrowserExtensionCandidate>, std::string>
+ReadFirefoxExtensionCandidates(const BrowserProfileSnapshot& snapshot);
+base::expected<std::vector<BrowserExtensionCandidate>, std::string>
+ReadSafariExtensionCandidates(const base::DictValue& exported);
+}  // namespace aux
+#endif
