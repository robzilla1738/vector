+BrowserProfileImporter::BrowserProfileImporter(Profile* profile, std::shared_ptr<ProfileLibrary> library)
+    : profile_(profile), library_(std::move(library)) {
+  CHECK(profile_ && library_ && !profile_->IsOffTheRecord());
+  profile_keep_alive_ = ScopedProfileKeepAlive::TryAcquire(profile_, ProfileKeepAliveOrigin::kAuxBrowserImport);
+  worker_ = base::ThreadPool::CreateSingleThreadTaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN});
+}
+BrowserProfileImporter::~BrowserProfileImporter() {
+  CHECK(discoveries_in_flight_ == 0);
+  for (const auto& [id, job] : jobs_) CHECK(job->done && !job->cleanup);
+}
+bool BrowserProfileImporter::CurrentJob(const Job& job) const {
+  return profile_keep_alive_ && !closed_ && !job.cancelled->load() && job.source->current.Run() &&
+      job.source->window && job.source->window->GetProfile() == profile_ &&
+      OriginalSourceCurrent(job.source->discovered) &&
+      (!job.extension_review || job.extension_review->snapshot->OriginalIsCurrent()) &&
+      (!job.decoded.snapshot || job.decoded.snapshot->OriginalIsCurrent());
+}
+void BrowserProfileImporter::ReviewExtensions(const std::string& owner,
+    const std::string& handle, Reply callback) {
+  auto found = sources_.find(handle);
+  if (closed_ || !profile_keep_alive_ || found == sources_.end() ||
+      found->second->owner != owner || !found->second->current.Run() ||
+      !found->second->window || found->second->window->GetProfile() != profile_ ||
+      !OriginalSourceCurrent(found->second->discovered) ||
+      std::ranges::find(found->second->discovered.categories, "extensions") == found->second->discovered.categories.end()) {
+    std::move(callback).Run(Fault("permission_denied", "Refresh the original extension source preview.")); return;
+  }
+  auto source = found->second;
+  if (source->review_cancelled) source->review_cancelled->store(true);
+  source->extension_review.reset();
+  auto cancelled = std::make_shared<std::atomic_bool>(false);
+  source->review_cancelled = cancelled;
+  ++discoveries_in_flight_;
+  auto replies = base::SplitOnceCallback(std::move(callback));
+  const bool posted = worker_->PostTaskAndReplyWithResult(FROM_HERE,
+      base::BindOnce([](std::shared_ptr<Source> source, std::shared_ptr<std::atomic_bool> flag) {
+        DecodedBrowserProfile result;
+        auto stopped = base::BindRepeating([](std::shared_ptr<std::atomic_bool> flag) { return flag->load(); }, flag);
+        const auto& original = source->discovered;
+        if (original.export_format) {
+          return DecodeBrowserExport(SourceAnchor(original)->path(), original.export_leaf,
+              *original.export_format, {"extensions"}, stopped, original.export_group ? &*original.export_group : nullptr);
+        }
+        auto captured = BrowserProfileSnapshot::Capture(original.path,
+            original.firefox_profile ? std::vector<std::string>{"extensions.json"} :
+                std::vector<std::string>{"Preferences", "Secure Preferences"}, false, stopped);
+        if (!captured.has_value()) { result.snapshot_error = captured.error(); return result; }
+        result.snapshot = std::move(*captured);
+        auto candidates = original.firefox_profile ? ReadFirefoxExtensionCandidates(*result.snapshot) :
+            ReadChromiumExtensionCandidates(*result.snapshot);
+        if (!candidates) result.snapshot_error = candidates.error();
+        else result.extension_candidates = std::move(*candidates);
+        return result;
+      }, source, cancelled),
+      base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self,
+          std::shared_ptr<Source> source, std::shared_ptr<std::atomic_bool> cancelled,
+          Reply reply, DecodedBrowserProfile captured) {
+        if (!self) return;
+        --self->discoveries_in_flight_;
+        auto review = std::make_shared<ExtensionReview>();
+        review->cleanup_runner = self->worker_;
+        review->snapshot = std::move(captured.snapshot);
+        if (self->closed_ || cancelled->load() || source->review_cancelled != cancelled ||
+            self->sources_.find(source->handle) == self->sources_.end() ||
+            !source->current.Run() || !source->window || source->window->GetProfile() != self->profile_ ||
+            !OriginalSourceCurrent(source->discovered)) {
+          std::move(reply).Run(Fault("cancelled", "The original extension review retired."));
+        } else if (!captured.snapshot_error.empty() || !review->snapshot || !review->snapshot->OriginalIsCurrent()) {
+          std::move(reply).Run(Fault("ref_stale", "The extension metadata is unavailable, unsupported, or changed."));
+        } else {
+          review->id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+          review->candidates = std::move(captured.extension_candidates);
+          base::ListValue candidates;
+          for (const auto& source_candidate : review->candidates) {
+            const auto id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+            review->candidate_ids.push_back(id);
+            base::DictValue candidate;
+            candidate.Set("candidateId", id);
+            candidate.Set("name", source_candidate.name);
+            candidate.Set("sourceIdentity", source_candidate.source_id);
+            candidate.Set("kind", source_candidate.kind);
+            candidate.Set("detail", source_candidate.detail);
+            if (!source_candidate.publisher.empty()) candidate.Set("publisher", source_candidate.publisher);
+            if (source_candidate.enabled) candidate.Set("enabled", *source_candidate.enabled);
+            if (!source_candidate.chrome_web_store_id.empty()) candidate.Set("chromeWebStoreId", source_candidate.chrome_web_store_id);
+            candidates.Append(std::move(candidate));
+          }
+          source->extension_review = review;
+          base::DictValue result;
+          result.Set("reviewId", review->id);
+          result.Set("candidates", std::move(candidates));
+          base::DictValue response;
+          response.Set("result", std::move(result));
+          std::move(reply).Run(std::move(response));
+        }
+        // Destroy failed snapshots before posting the same-worker close barrier.
+        review.reset();
+        self->MaybeJoined();
+      }, weak_factory_.GetWeakPtr(), source, cancelled, std::move(replies.first)));
+  if (!posted) {
+    --discoveries_in_flight_;
+    cancelled->store(true);
+    std::move(replies.second).Run(Fault("cancelled", "Extension review could not start during shutdown."));
+    MaybeJoined();
+  }
+}
+
+void BrowserProfileImporter::Discover(const std::string& owner_token,
+    base::WeakPtr<BrowserWindowInterface> window, Current current, Reply callback) {
+  if (!profile_keep_alive_ || closed_ || owner_token.empty() || !window || !current || !current.Run() ||
+      window->GetProfile() != profile_ || profile_->IsOffTheRecord()) {
+    std::move(callback).Run(Fault("permission_denied", "The original import window is unavailable."));
+    return;
+  }
+  std::erase_if(sources_, [&](const auto& item) {
+    return item.second->owner == owner_token || !item.second->current.Run();
+  });
+  if (discoveries_in_flight_ || sources_.size() >= 256) {
+    std::move(callback).Run(Fault("conflict", "A browser preview is already in progress. Close old previews and retry."));
+    return;
+  }
+  ++discoveries_in_flight_;
+  auto cancelled = std::make_shared<std::atomic_bool>(false);
+  discovery_owner_ = owner_token;
+  discovery_cancelled_ = cancelled;
+  auto replies = base::SplitOnceCallback(std::move(callback));
+  const bool posted = worker_->PostTaskAndReplyWithResult(FROM_HERE,
+      base::BindOnce(&DiscoverBrowserProfiles, base::BindRepeating(
+          [](std::shared_ptr<std::atomic_bool> flag) { return flag->load(); }, cancelled)),
+      base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self,
+          std::string owner, base::WeakPtr<BrowserWindowInterface> window,
+          Current current, Reply reply,
+          base::expected<std::vector<DiscoveredBrowserProfile>, std::string> found) {
+        if (!self) return;
+        --self->discoveries_in_flight_;
+        self->discovery_cancelled_.reset();
+        self->discovery_owner_.clear();
+        if (self->closed_ || !window || !current.Run() || !found.has_value()) {
+          std::move(reply).Run(Fault("cancelled", "The browser preview was retired or could not be read safely."));
+          self->MaybeJoined();
+          return;
+        }
+        std::move(reply).Run(self->PublishSources(owner, window, current, std::move(*found)));
+        self->MaybeJoined();
+      }, weak_factory_.GetWeakPtr(), owner_token, window, current, std::move(replies.first)));
+  if (!posted) {
+    --discoveries_in_flight_;
+    discovery_cancelled_.reset();
+    discovery_owner_.clear();
+    std::move(replies.second).Run(Fault("cancelled", "Browser discovery could not start during shutdown."));
+    MaybeJoined();
+  }
+}
+base::DictValue BrowserProfileImporter::PublishSources(const std::string& owner,
+    base::WeakPtr<BrowserWindowInterface> window, Current current,
+    std::vector<DiscoveredBrowserProfile> found) {
+  base::ListValue sources;
+  base::ListValue handles;
+  std::map<std::string, base::DictValue> summaries;
+  for (auto& discovered : found) {
+    auto source = std::make_shared<Source>();
+    source->cleanup_runner = worker_;
+    source->handle = base::Uuid::GenerateRandomV4().AsLowercaseString();
+    source->owner = owner;
+    source->window = window;
+    source->current = current;
+    source->discovered = std::move(discovered);
+    base::ListValue available;
+    for (const char* category : kCategories) {
+      base::DictValue item;
+      item.Set("category", category);
+      item.Set("available", std::ranges::find(source->discovered.categories, category) != source->discovered.categories.end());
+      if (source->discovered.export_group) {
+        const auto error = source->discovered.export_group->errors.find(category);
+        if (error != source->discovered.export_group->errors.end()) {
+          item.Set("available", false); item.Set("blocker", error->second);
+        }
+      }
+      available.Append(std::move(item));
+    }
+    auto [entry, inserted] = summaries.try_emplace(source->discovered.source_id);
+    if (inserted) {
+      entry->second.Set("id", source->discovered.source_id);
+      entry->second.Set("label", source->discovered.label);
+      entry->second.Set("profiles", base::ListValue());
+      entry->second.Set("categories", available.Clone());
+      entry->second.Set("profileCategories", base::ListValue());
+    }
+    if (!inserted) {
+      auto* categories = entry->second.FindList("categories");
+      for (size_t i = 0; i < available.size(); ++i) {
+        auto& aggregate = (*categories)[i].GetDict();
+        aggregate.Set("available", aggregate.FindBool("available").value_or(false) ||
+            available[i].GetDict().FindBool("available").value_or(false));
+      }
+    }
+    entry->second.FindList("profiles")->Append(source->discovered.profile_id);
+    base::DictValue profile;
+    profile.Set("profileId", source->discovered.profile_id);
+    profile.Set("categories", std::move(available));
+    if (!source->discovered.group_kind.empty()) {
+      profile.Set("kind", source->discovered.group_kind);
+      profile.Set("label", source->discovered.group_label);
+    }
+    entry->second.FindList("profileCategories")->Append(std::move(profile));
+    base::DictValue handle;
+    handle.Set("sourceId", source->discovered.source_id);
+    handle.Set("profileId", source->discovered.profile_id);
+    handle.Set("sourceHandle", source->handle);
+    handles.Append(std::move(handle));
+    sources_.emplace(source->handle, std::move(source));
+  }
+  for (auto& [id, summary] : summaries) sources.Append(std::move(summary));
+  base::DictValue result;
+  result.Set("sources", std::move(sources));
+  result.Set("snapshots", std::move(handles));
+  base::DictValue response;
+  response.Set("result", std::move(result));
+  return response;
+}
+void BrowserProfileImporter::SelectSafariWindow(const std::string& owner,
+    base::WeakPtr<BrowserWindowInterface> window, Current current, Reply start_reply) {
+  if (!profile_keep_alive_ || closed_ || !window || !current || !current.Run() ||
+      window->GetProfile() != profile_ || profile_->IsOffTheRecord() || owner.empty()) {
+    std::move(start_reply).Run(Fault("permission_denied", "The original Safari import window is unavailable.")); return;
+  }
+  if (discoveries_in_flight_ || sources_.size() >= 256) {
+    std::move(start_reply).Run(Fault("conflict", "Join the current browser selection first.")); return;
+  }
+  while (export_selections_.size() >= 32) {
+    auto terminal = std::ranges::find_if(export_selections_, [](const auto& entry) { return entry.second->done; });
+    if (terminal == export_selections_.end()) { std::move(start_reply).Run(Fault("conflict", "Join the original browser selection first.")); return; }
+    export_selections_.erase(terminal);
+  }
+  const auto id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  auto selection = std::make_shared<ExportSelection>(); selection->owner = owner;
+  export_selections_.emplace(id, selection);
+  ++discoveries_in_flight_; discovery_owner_ = owner;
+  auto cancelled = std::make_shared<std::atomic_bool>(false); discovery_cancelled_ = cancelled;
+  source_picker_ = BrowserSafariWindowPicker::Show(window->GetWindow()->GetNativeWindow(), current,
+      base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self, std::string owner,
+          base::WeakPtr<BrowserWindowInterface> window, Current current,
+          std::shared_ptr<std::atomic_bool> cancelled, std::shared_ptr<ExportSelection> selection,
+          base::expected<std::shared_ptr<const SafariWindowSnapshot>, std::string> captured) {
+        if (!self) return;
+        self->source_picker_.reset(); --self->discoveries_in_flight_;
+        self->discovery_cancelled_.reset(); self->discovery_owner_.clear();
+        if (self->closed_ || cancelled->load() || !window || !current.Run()) selection->reply = Fault("cancelled", "The original Safari window review was retired.");
+        else if (!captured.has_value()) selection->reply = Fault("permission_denied", captured.error().c_str());
+        else if (!(*captured)->OriginalProcessIsCurrent()) selection->reply = Fault("ref_stale", "The original Safari process changed before publication.");
+        else {
+          DiscoveredBrowserProfile source;
+          source.source_id = "safari"; source.label = "Safari";
+          source.profile_id = "Safari window " + base::NumberToString((*captured)->window_id);
+          source.brand = BrowserProfileBrand::kChrome; source.categories = {"tabs"};
+          source.safari_window = std::move(*captured);
+          std::vector<DiscoveredBrowserProfile> sources; sources.push_back(std::move(source));
+          selection->reply = self->PublishSources(owner, window, current, std::move(sources));
+        }
+        selection->done = true; self->MaybeJoined();
+      }, weak_factory_.GetWeakPtr(), owner, window, current, cancelled, selection));
+  if (!source_picker_) {
+    --discoveries_in_flight_; discovery_cancelled_.reset(); discovery_owner_.clear();
+    selection->reply = Fault("permission_denied", "The original native Safari review sheet could not open."); selection->done = true;
+  }
+  std::move(start_reply).Run(PollExport(id));
+}
+void BrowserProfileImporter::SelectExport(const std::string& owner,
+    base::WeakPtr<BrowserWindowInterface> window, Current current,
+    const std::string& source_id, BrowserExportFormat format, Reply start_reply) {
+  static constexpr const char* kSources[] = {"chrome", "arc", "safari", "firefox",
+      "edge", "brave", "dia", "comet", "atlas"};
+  if (!profile_keep_alive_ || closed_ || !window || !current || !current.Run() ||
+      window->GetProfile() != profile_ || profile_->IsOffTheRecord() || owner.empty()) {
+    std::move(start_reply).Run(Fault("permission_denied", "The original browser import window is unavailable.")); return;
+  }
+  if (std::ranges::find(kSources, source_id) == std::end(kSources) ||
+      (format == BrowserExportFormat::kSafariArchive && source_id != "safari")) {
+    std::move(start_reply).Run(Fault("invalid_params", "Choose an actual browser export format.")); return;
+  }
+  if (discoveries_in_flight_ || sources_.size() >= 256) {
+    std::move(start_reply).Run(Fault("conflict", "Join the current browser preview before choosing another export.")); return;
+  }
+  while (export_selections_.size() >= 32) {
+    auto terminal = std::ranges::find_if(export_selections_, [](const auto& item) { return item.second->done; });
+    if (terminal == export_selections_.end()) {
+      std::move(start_reply).Run(Fault("conflict", "Join the original export selection first.")); return;
+    }
+    export_selections_.erase(terminal);
+  }
+  const std::string selection_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  auto selection = std::make_shared<ExportSelection>();
+  selection->owner = owner;
+  export_selections_.emplace(selection_id, selection);
+  Reply reply = base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self,
+      std::shared_ptr<ExportSelection> original, base::DictValue response) {
+    if (!self) return;
+    original->reply = std::move(response);
+    original->done = true;
+    self->MaybeJoined();
+  }, weak_factory_.GetWeakPtr(), selection);
+  ++discoveries_in_flight_;
+  discovery_owner_ = owner;
+  auto cancelled = std::make_shared<std::atomic_bool>(false);
+  discovery_cancelled_ = cancelled;
+  auto replies = base::SplitOnceCallback(std::move(reply));
+  source_picker_ = BrowserExportPicker::Show(window->GetWindow()->GetNativeWindow(), format,
+      base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self, std::string owner,
+          base::WeakPtr<BrowserWindowInterface> window, Current current, std::string source_id,
+          BrowserExportFormat format, std::shared_ptr<std::atomic_bool> cancelled, Reply reply,
+          base::expected<base::FilePath, std::string> selected) {
+        if (!self) return;
+        self->source_picker_.reset();
+        if (!selected || self->closed_ || cancelled->load() || !window || !current.Run()) {
+          --self->discoveries_in_flight_;
+          self->discovery_cancelled_.reset();
+          self->discovery_owner_.clear();
+          std::move(reply).Run(Fault("cancelled", "The original export selection was cancelled."));
+          self->MaybeJoined(); return;
+        }
+        auto replies = base::SplitOnceCallback(std::move(reply));
+        const bool posted = self->worker_->PostTaskAndReplyWithResult(FROM_HERE,
+            base::BindOnce([](base::FilePath selected, std::string source_id,
+                BrowserExportFormat format, std::shared_ptr<std::atomic_bool> cancelled, scoped_refptr<base::SingleThreadTaskRunner> cleanup_runner)
+                -> base::expected<std::vector<DiscoveredBrowserProfile>, std::string> {
+              auto stopped = base::BindRepeating(
+                  [](std::shared_ptr<std::atomic_bool> flag) { return flag->load(); }, cancelled);
+              const std::string leaf = selected.BaseName().value();
+              auto snapshot = BrowserProfileSnapshot::Capture(selected.DirName(), {leaf}, false, stopped);
+              if (!snapshot.has_value()) return base::unexpected(snapshot.error());
+              if (!base::PathExists((*snapshot)->path().Append(leaf)))
+                return base::unexpected("The selected export file is unavailable.");
+              // Preview is native-only parsing of the selected immutable copy;
+              // no destination effects, paths or password values leave native.
+              auto decoded = DecodeBrowserExport((*snapshot)->path(), leaf, format, {}, stopped);
+              if (!decoded.snapshot_error.empty()) return base::unexpected(decoded.snapshot_error);
+              std::vector<DiscoveredBrowserProfile> profiles;
+              if (format == BrowserExportFormat::kSafariArchive) {
+                auto anchor = std::shared_ptr<BrowserProfileSnapshot>(snapshot->release(),
+                    [cleanup_runner](BrowserProfileSnapshot* value) {
+                      if (cleanup_runner->RunsTasksInCurrentSequence()) delete value;
+                      else cleanup_runner->DeleteSoon(FROM_HERE, std::unique_ptr<BrowserProfileSnapshot>(value));
+                    });
+                for (auto& group : decoded.export_groups) {
+                  DiscoveredBrowserProfile profile;
+                  profile.source_id = source_id; profile.label = "Safari exported data files";
+                  profile.profile_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+                  profile.brand = BrowserProfileBrand::kChrome;
+                  profile.export_format = format; profile.export_leaf = leaf;
+                  profile.path = anchor->path(); profile.export_anchor = anchor;
+                  profile.categories = group.categories;
+                  profile.group_kind = group.entries.size() > 1 || group.categories.front() == "bookmarks" || group.categories.front() == "passwords" ? "shared-export" : "export-file";
+                  profile.group_label = group.label;
+                  profile.export_group = std::move(group);
+                  profiles.push_back(std::move(profile));
+                }
+              } else {
+                DiscoveredBrowserProfile profile;
+                profile.source_id = source_id; profile.label = source_id;
+                profile.profile_id = format == BrowserExportFormat::kPasswordsCsv ? "Passwords export" :
+                    format == BrowserExportFormat::kTabsHtml ? "Tabs export" : "Bookmarks export";
+                profile.brand = BrowserProfileBrand::kChrome;
+                profile.export_format = format; profile.export_leaf = leaf;
+                profile.path = (*snapshot)->path(); profile.anchor = std::move(*snapshot);
+                profile.categories = std::move(decoded.export_categories);
+                profiles.push_back(std::move(profile));
+              }
+              if (profiles.empty()) return base::unexpected("The export has no supported browser data.");
+              return profiles;
+            }, *selected, source_id, format, cancelled, self->worker_),
+            base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self, std::string owner,
+                base::WeakPtr<BrowserWindowInterface> window, Current current,
+                std::shared_ptr<std::atomic_bool> cancelled, Reply reply,
+                base::expected<std::vector<DiscoveredBrowserProfile>, std::string> profiles) {
+              if (!self) return;
+              --self->discoveries_in_flight_;
+              self->discovery_cancelled_.reset();
+              self->discovery_owner_.clear();
+              if (self->closed_ || cancelled->load() || !window || !current.Run()) {
+                if (profiles) for (auto& profile : *profiles) {
+                  if (profile.anchor) self->worker_->DeleteSoon(FROM_HERE, std::move(profile.anchor));
+                }
+                std::move(reply).Run(Fault("cancelled", "The original export review was retired."));
+              } else if (!profiles) {
+                std::move(reply).Run(Fault("invalid_params", "Choose a valid export containing the selected browser data."));
+              } else {
+                if (self->sources_.size() + profiles->size() > 256) {
+                  for (auto& profile : *profiles) if (profile.anchor) self->worker_->DeleteSoon(FROM_HERE, std::move(profile.anchor));
+                  std::move(reply).Run(Fault("conflict", "Close old browser previews before selecting more exported data files."));
+                } else std::move(reply).Run(self->PublishSources(owner, window, current, std::move(*profiles)));
+              }
+              self->MaybeJoined();
+            }, self, owner, window, current, cancelled, std::move(replies.first)));
+        if (!posted) {
+          --self->discoveries_in_flight_;
+          self->discovery_cancelled_.reset();
+          self->discovery_owner_.clear();
+          std::move(replies.second).Run(Fault("cancelled", "Export review could not start during shutdown."));
+          self->MaybeJoined();
+        }
+      }, weak_factory_.GetWeakPtr(), owner, window, current, source_id, format, cancelled,
+          std::move(replies.first)));
+  if (!source_picker_) {
+    --discoveries_in_flight_;
+    discovery_cancelled_.reset();
+    discovery_owner_.clear();
+    std::move(replies.second).Run(Fault("backend_unavailable", "The original native export picker is unavailable."));
+    MaybeJoined();
+  }
+  // Never block the runtime's native worker on a human file-selection sheet.
+  std::move(start_reply).Run(PollExport(selection_id));
+
+}
+base::DictValue BrowserProfileImporter::PollExport(const std::string& id) const {
+  auto found = export_selections_.find(id);
+  base::DictValue result;
+  result.Set("selectionId", id);
+  result.Set("unknown", found == export_selections_.end());
+  if (found != export_selections_.end()) {
+    const auto& selection = *found->second;
+    result.Set("done", selection.done);
+    if (selection.done) {
+      if (const auto* discovery = selection.reply.FindDict("result"))
+        result.Set("discovery", discovery->Clone());
+      if (const auto* error = selection.reply.FindDict("error"))
+        result.Set("error", error->Clone());
+    }
+  }
+  return base::DictValue().Set("result", std::move(result));
+}
+base::DictValue BrowserProfileImporter::CancelExport(const std::string& id) {
+  auto found = export_selections_.find(id);
+  if (found != export_selections_.end() && !found->second->done &&
+      found->second->owner == discovery_owner_) {
+    if (discovery_cancelled_) discovery_cancelled_->store(true);
+    if (source_picker_) source_picker_->Cancel();
+  }
+  return PollExport(id);
+}
+void BrowserProfileImporter::ParseExportBookmarks(const std::shared_ptr<Job>& job) {
+  if (!CurrentJob(*job)) { Finish(job, "The original export was retired before parsing."); return; }
+  job->working = true;
+  job->bookmark_parser = content::ServiceProcessHost::Launch<user_data_importer::mojom::BookmarkHtmlParser>(
+      content::ServiceProcessHost::Options().WithDisplayName(
+          IDS_CONTENT_BOOKMARK_PARSER_SERVICE_DISPLAY_NAME).Pass());
+  job->bookmark_parser.set_disconnect_handler(base::BindOnce(
+      [](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job) {
+        if (!self) return;
+        job->working = false;
+        self->Finish(job, "The sandboxed browser export parser disconnected.");
+      }, weak_factory_.GetWeakPtr(), job));
+  job->bookmark_parser->Parse(std::move(job->decoded.bookmark_html), base::BindOnce(
+      [](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job,
+          user_data_importer::BookmarkParser::ParsedBookmarks parsed) {
+        if (!self) return;
+        job->bookmark_parser.reset();
+        job->working = false;
+        if (!self->CurrentJob(*job)) { self->Finish(job, "The original export was retired before acceptance."); return; }
+        parsed.bookmarks.insert(parsed.bookmarks.end(), parsed.reading_list.begin(), parsed.reading_list.end());
+        self->ApplyCollectedBookmarks(job, parsed.bookmarks);
+        self->Dispatch(job);
+      }, weak_factory_.GetWeakPtr(), job));
+}
+void BrowserProfileImporter::ApplyCollectedBookmarks(const std::shared_ptr<Job>& job,
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& entries) {
+job->bookmark_rows.push_back({1, 0, base::UTF8ToUTF16("Imported from " + job->source->discovered.label), GURL()});
+std::map<std::vector<std::u16string>, size_t> folders;
+folders[{}] = 1;
+for (const auto& entry : entries) {
+  if (!entry.is_folder && (!entry.url.is_valid() || !entry.url.SchemeIsHTTPOrHTTPS() ||
+      entry.url.has_username() || entry.url.has_password())) continue;
+  if (job->decoded.bookmarks_as_tabs) {
+    if (!entry.is_folder) job->decoded.tabs.push_back({entry.url, entry.title, 0, false});
+    continue;
+  }
+  std::vector<std::u16string> path;
+  size_t parent = 1;
+  for (const auto& component : entry.path) {
+    path.push_back(component);
+    auto existing = folders.find(path);
+    if (existing != folders.end()) { parent = existing->second; continue; }
+    const size_t id = job->bookmark_rows.size() + 1;
+    job->bookmark_rows.push_back({id, parent, component, GURL()});
+    folders[path] = id;
+    parent = id;
+  }
+  const size_t id = job->bookmark_rows.size() + 1;
+  job->bookmark_rows.push_back({id, parent, entry.title, entry.is_folder ? GURL() : entry.url});
+  if (entry.is_folder) { path.push_back(entry.title); folders[path] = id; }
+}
+}
+void BrowserProfileImporter::ParseFirefox(const std::shared_ptr<Job>& job) {
+  if (!CurrentJob(*job)) { Finish(job, "The original Firefox import was retired before utility collection."); return; }
+  job->working = true;
+  job->firefox_import = std::make_unique<BrowserFirefoxImport>();
+  job->firefox_import->Start(job->decoded, job->categories,
+      base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job,
+          base::expected<FirefoxImportResult, std::string> result) {
+        if (!self) return;
+        job->firefox_import.reset();
+        job->working = false;
+        if (!self->CurrentJob(*job)) {
+          job->cancelled->store(true);
+          self->Finish(job, ""); return;
+        }
+        if (!result) { self->Finish(job, result.error()); return; }
+        job->decoded.history = std::move(result->history);
+        job->decoded.tabs = std::move(result->tabs);
+        job->decoded.errors.insert(result->errors.begin(), result->errors.end());
+        if (std::ranges::find(job->categories, "bookmarks") != job->categories.end() && !job->decoded.errors.contains("bookmarks"))
+          self->ApplyCollectedBookmarks(job, result->bookmarks);
+        self->Dispatch(job);
+      }, weak_factory_.GetWeakPtr(), job));
+}
+base::DictValue BrowserProfileImporter::Begin(const std::string& owner,
+    const std::string& operation, const std::string& handle,
+    const std::vector<std::string>& requested, const base::DictValue& extension_choices) {
+  auto old = jobs_.find(operation);
+  if (old != jobs_.end()) {
+    if (old->second->source->owner != owner || old->second->source->handle != handle ||
+        old->second->categories != requested || old->second->extension_choices != extension_choices)
+      return Fault("conflict", "This operation already belongs to another import selection.");
+    return Poll(operation);
+  }
+  auto source = sources_.find(handle);
+  if (!profile_keep_alive_ || closed_ || !ValidOperation(operation) || source == sources_.end() ||
+      source->second->owner != owner || !source->second->current.Run() ||
+      !source->second->window || source->second->window->GetProfile() != profile_ ||
+      !OriginalSourceCurrent(source->second->discovered))
+    return Fault("permission_denied", "Refresh the original browser import preview.");
+  std::set<std::string> unique(requested.begin(), requested.end());
+  if (requested.empty() || requested.size() > 5 || unique.size() != requested.size())
+    return Fault("invalid_params", "Choose each import category only once.");
+  for (const auto& category : requested) {
+    if (std::ranges::find(source->second->discovered.categories, category) == source->second->discovered.categories.end())
+      return Fault("invalid_params", "This category is not available in the original browser Profile.");
+  }
+  std::shared_ptr<ExtensionReview> reviewed;
+  std::vector<std::string> destinations;
+  if (unique.contains("extensions")) {
+    reviewed = source->second->extension_review;
+    const auto* review_id = extension_choices.FindString("reviewId");
+    const auto* choices = extension_choices.FindList("choices");
+    if (!reviewed || !review_id || *review_id != reviewed->id || !choices ||
+        extension_choices.size() != 2 || choices->size() != reviewed->candidates.size() ||
+        !reviewed->snapshot->OriginalIsCurrent())
+      return Fault("ref_stale", "Review every extension from the original source before importing.");
+    std::set<std::string> selected;
+    std::set<std::string> destination_ids;
+    for (const auto& value : *choices) {
+      const auto* choice = value.GetIfDict();
+      const auto* candidate_id = choice ? choice->FindString("candidateId") : nullptr;
+      const auto* destination = choice ? choice->FindString("chromeWebStoreId") : nullptr;
+      const bool skip = choice && choice->FindBool("skip").value_or(false);
+      if (!candidate_id || choice->size() != 2 || (skip == !!destination) ||
+          !selected.insert(*candidate_id).second)
+        return Fault("invalid_params", "Each original extension needs one exact reviewed choice.");
+      auto found = std::ranges::find(reviewed->candidate_ids, *candidate_id);
+      if (found == reviewed->candidate_ids.end())
+        return Fault("permission_denied", "The extension choice belongs to another source review.");
+      if (destination && (!ValidChromeWebStoreId(*destination) || !destination_ids.insert(*destination).second))
+        return Fault("invalid_params", "Choose each valid Chrome Web Store counterpart only once.");
+    }
+    for (const auto& id : reviewed->candidate_ids) {
+      const auto selected_choice = std::ranges::find_if(*choices, [&](const base::Value& value) {
+        return *value.GetDict().FindString("candidateId") == id;
+      });
+      const auto* destination = selected_choice->GetDict().FindString("chromeWebStoreId");
+      destinations.push_back(destination ? *destination : std::string());
+    }
+  } else if (!extension_choices.empty()) {
+    return Fault("invalid_params", "Extension review requires the extensions category.");
+  }
+  for (const auto& [id, existing] : jobs_)
+    if (!existing->done || existing->cleanup) return Fault("conflict", "Join or cancel the current native import first.");
+  while (jobs_.size() >= 128) {
+    auto terminal = std::ranges::find_if(jobs_, [](const auto& item) {
+      return item.second->done && !item.second->cleanup;
+    });
+    if (terminal == jobs_.end()) break;
+    jobs_.erase(terminal);
+  }
+  if (jobs_.size() >= 128)
+    return Fault("conflict", "Too many import receipts are retained in this native session.");
+  auto job = std::make_shared<Job>();
+  job->operation = operation;
+  job->source = source->second;
+  job->categories = requested;
+  if (std::ranges::find(requested, "tabs") != requested.end()) {
+    std::string error;
+    auto organization = OrganizationStore::Snapshot(profile_,
+        base::NumberToString(job->source->window->GetSessionID().id()), &error);
+    const auto* layout = organization ? organization->FindDict("layout") : nullptr;
+    const auto* window = layout ? layout->FindDict("window") : nullptr;
+    const auto* active = window ? window->FindString("activeSpaceId") : nullptr;
+    if (!active) return Fault("ref_stale", "The original destination Space is unavailable. Refresh before importing tabs.");
+    job->destination_space = *active;
+  }
+  job->extension_review = std::move(reviewed);
+  job->extension_choices = extension_choices.Clone();
+  job->extension_destinations = std::move(destinations);
+  for (const auto& category : requested) {
+    base::DictValue progress;
+    progress.Set("source", job->source->discovered.source_id);
+    progress.Set("label", job->source->discovered.label);
+    progress.Set("profileId", job->source->discovered.profile_id);
+    progress.Set("category", category);
+    progress.Set("state", "running");
+    progress.Set("imported", 0);
+    progress.Set("skipped", 0);
+    job->progress.Append(std::move(progress));
+  }
+  jobs_.emplace(operation, job);
+  Decode(job);
+  return Poll(operation);
+}
+base::DictValue BrowserProfileImporter::Poll(const std::string& operation) const {
+  auto found = jobs_.find(operation);
+  base::DictValue result;
+  result.Set("operationId", operation);
+  if (found == jobs_.end()) {
+    result.Set("unknown", true);
+    base::DictValue reply;
+    reply.Set("result", std::move(result));
+    return reply;
+  }
+  const auto& job = *found->second;
+  result.Set("unknown", false);
+  result.Set("done", job.done && !job.cleanup);
+  result.Set("cancelled", job.cancelled->load());
+  result.Set("progress", job.progress.Clone());
+  if (!job.error.empty()) result.Set("error", job.error);
+  base::DictValue reply;
+  reply.Set("result", std::move(result));
+  return reply;
+}
+base::DictValue BrowserProfileImporter::Cancel(const std::string& operation) {
+  auto found = jobs_.find(operation);
+  if (found == jobs_.end()) return Poll(operation);
+  auto job = found->second;
+  job->cancelled->store(true);
+  if (job->bookmark_parser.is_bound()) {
+    job->bookmark_parser.reset();
+    job->working = false;
+  }
+  if (auto installer = job->extension_installer) installer->CancelPendingInstall();
+  if (!job->done && !job->working) Finish(job, "");
+  return Poll(operation);
+}
+void BrowserProfileImporter::RetireOwner(const std::string& owner) {
+  if (discovery_owner_ == owner && discovery_cancelled_) {
+    discovery_cancelled_->store(true);
+    if (source_picker_) source_picker_->Cancel();
+  }
+  std::vector<std::string> operations;
+  for (const auto& [id, job] : jobs_)
+    if (job->source->owner == owner && !job->done) operations.push_back(id);
+  for (const auto& id : operations) Cancel(id);
+  for (auto& [id, source] : sources_)
+    if (source->owner == owner && source->review_cancelled) source->review_cancelled->store(true);
+  std::erase_if(sources_, [&](const auto& item) { return item.second->owner == owner; });
+}
+void BrowserProfileImporter::Close(base::OnceClosure joined) {
+  closed_ = true;
+  for (auto& [id, source] : sources_)
+    if (source->review_cancelled) source->review_cancelled->store(true);
+  if (discovery_cancelled_) discovery_cancelled_->store(true);
+  if (source_picker_) source_picker_->Cancel();
+  joins_.push_back(std::move(joined));
+  std::vector<std::string> operations;
+  for (const auto& [id, job] : jobs_) if (!job->done) operations.push_back(id);
+  for (const auto& id : operations) Cancel(id);
+  MaybeJoined();
+}
+void BrowserProfileImporter::MaybeJoined() {
+  if (!closed_ || discoveries_in_flight_) return;
+  for (const auto& [id, job] : jobs_) if (!job->done || job->cleanup) return;
+  if (!sources_retired_) {
+    if (source_retirement_pending_) return;
+    source_retirement_pending_ = true;
+    if (!retiring_sources_) {
+      retiring_sources_ = std::make_shared<std::vector<std::unique_ptr<BrowserProfileSnapshot>>>();
+      auto retire_anchor = [&](DiscoveredBrowserProfile& source) {
+        if (source.anchor) retiring_sources_->push_back(std::move(source.anchor));
+        // Last shared export release queues its actual private-file deletion on
+        // this worker before the following retirement barrier can acknowledge.
+        source.export_anchor.reset();
+      };
+      for (auto& [handle, source] : sources_) retire_anchor(source->discovered);
+      for (auto& [operation, job] : jobs_) retire_anchor(job->source->discovered);
+      for (auto& [id, source] : sources_) source->extension_review.reset();
+      for (auto& [id, job] : jobs_) {
+        job->extension_review.reset();
+        job->source->extension_review.reset();
+      }
+      sources_.clear();
+    }
+    // A barrier on this same worker also joins snapshots retired by earlier
+    // source previews. No accepted destination batch is cancelled or rolled back.
+    const bool posted = worker_->PostTaskAndReply(FROM_HERE,
+        base::BindOnce([](std::shared_ptr<std::vector<std::unique_ptr<BrowserProfileSnapshot>>> snapshots) {
+          snapshots->clear();
+        }, retiring_sources_),
+        base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self) {
+          if (!self) return;
+          self->sources_retired_ = true;
+          self->source_retirement_pending_ = false;
+          self->retiring_sources_.reset();
+          self->MaybeJoined();
+        }, weak_factory_.GetWeakPtr()));
+    if (!posted) source_retirement_pending_ = false;
+    return;  // A rejected worker task is not a fictional cleanup acknowledgement.
+  }
+  auto joins = std::move(joins_);
+  for (auto& joined : joins)
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, std::move(joined));
+}
+void BrowserProfileImporter::Decode(const std::shared_ptr<Job>& job) {
+  job->working = true;
+  const bool needs_key = !job->source->discovered.export_format &&
+      !job->source->discovered.firefox_profile && !job->source->discovered.safari_window && !job->source->discovered.arc_sidebar && (std::ranges::find(job->categories, "passwords") != job->categories.end() ||
+      (std::ranges::find(job->categories, "tabs") != job->categories.end() &&
+       base::DirectoryExists(job->source->discovered.path.Append(sessions::kEncryptedSessionsDirectory))));
+  auto decoded = base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self,
+      std::shared_ptr<Job> job, scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+    if (!self) return;
+    if (!self->CurrentJob(*job)) {
+      job->working = false;
+      self->Finish(job, "The original browser import was retired before acceptance.");
+      return;
+    }
+    const bool posted = self->worker_->PostTaskAndReplyWithResult(FROM_HERE,
+        base::BindOnce([](std::shared_ptr<Job> original,
+            scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+          auto cancelled = base::BindRepeating(
+              [](std::shared_ptr<std::atomic_bool> flag) { return flag->load(); }, original->cancelled);
+          const auto& source = original->source->discovered;
+          if (source.safari_window) {
+            DecodedBrowserProfile captured;
+            if (cancelled.Run() || !source.safari_window->OriginalProcessIsCurrent()) captured.snapshot_error = "The original Safari process retired before import admission.";
+            else captured.tabs = source.safari_window->tabs;
+            return captured;
+          }
+          if (source.arc_sidebar)
+            return DecodeArcSidebar(*source.anchor, original->categories, cancelled);
+          if (source.firefox_profile)
+            return PrepareFirefoxSnapshot(source.path, original->categories, cancelled);
+          if (source.export_format)
+            return DecodeBrowserExport(SourceAnchor(source)->path(), source.export_leaf,
+                *source.export_format, original->categories, cancelled, source.export_group ? &*source.export_group : nullptr);
+          return DecodeBrowserProfile(source.path, original->categories,
+              std::move(encryptor), cancelled);
+        }, job, std::move(encryptor)),
+        base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self,
+            std::shared_ptr<Job> job, DecodedBrowserProfile data) {
+          if (!self) return;
+          job->decoded = std::move(data);
+          job->working = false;
+          job->source_crypt.reset();
+          if (!job->decoded.snapshot_error.empty()) self->Finish(job, job->decoded.snapshot_error);
+          else if (job->source->discovered.firefox_profile &&
+              std::ranges::any_of(job->categories, [](const std::string& category) {
+                return category == "bookmarks" || category == "history" || category == "tabs";
+              })) self->ParseFirefox(job);
+          else if (!job->decoded.bookmark_html.empty()) self->ParseExportBookmarks(job);
+          else self->Dispatch(job);
+        }, self, job));
+    if (!posted) {
+      job->working = false;
+      self->Finish(job, "Browser decoding could not start during shutdown.");
+    }
+  }, weak_factory_.GetWeakPtr(), job);
+  if (!needs_key) {
+    std::move(decoded).Run(nullptr);
+    return;
+  }
+  std::vector<std::pair<os_crypt_async::OSCryptAsync::Precedence,
+                        std::unique_ptr<os_crypt_async::KeyProvider>>> providers;
+  providers.emplace_back(1, std::make_unique<BrowserProfileKeyProvider>(job->source->discovered.brand, job->cancelled));
+  job->source_crypt = std::make_unique<os_crypt_async::OSCryptAsync>(std::move(providers));
+  job->source_crypt->GetInstance(std::move(decoded));
+}
+void BrowserProfileImporter::ScheduleDispatch(const std::shared_ptr<Job>& job) {
+  if (!base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&BrowserProfileImporter::Dispatch, weak_factory_.GetWeakPtr(), job)))
+    Finish(job, "The next browser import batch was not accepted during shutdown.");
+}
+void BrowserProfileImporter::Dispatch(const std::shared_ptr<Job>& job) {
+  if (job->done || job->working) return;
+  if (!CurrentJob(*job)) {
+    job->cancelled->store(true);
+    Finish(job, "");
+    return;
+  }
+  if (job->category == job->categories.size()) {
+    Finish(job, "");
+    return;
+  }
+  const auto& category = job->categories[job->category];
+  auto& progress = job->progress[job->category].GetDict();
+  auto error = job->decoded.errors.find(category);
+  if (error != job->decoded.errors.end()) {
+    progress.Set("state", "error");
+    progress.Set("detail", error->second);
+    ++job->category;
+    job->offset = 0;
+    ScheduleDispatch(job);
+    return;
+  }
+  if (category == "bookmarks") {
+    if (job->bookmark_rows.empty() && job->offset == 0) {
+      job->bookmark_rows.push_back({1, 0, base::UTF8ToUTF16("Imported from " +
+          job->source->discovered.label + " (" + job->source->discovered.profile_id + ")"), GURL()});
+      auto flatten = [&](auto&& visit, const ImportedProfileBookmark& node, size_t parent) -> void {
+        const size_t id = job->bookmark_rows.size() + 1;
+        job->bookmark_rows.push_back({id, parent, node.title, node.url});
+        for (const auto& child : node.children) visit(visit, child, id);
+      };
+      for (const auto& root : job->decoded.bookmarks) flatten(flatten, root, 1);
+    }
+    if (job->offset < job->bookmark_rows.size()) {
+      const size_t end = std::min(job->offset + 500, job->bookmark_rows.size());
+      std::vector<NativeBookmarkImportEntry> rows(job->bookmark_rows.begin() + job->offset,
+                                                job->bookmark_rows.begin() + end);
+      const auto reply = library_->ImportNativeBookmarks(rows, job->bookmark_folders,
+          base::BindRepeating([](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job) {
+            return self && self->CurrentJob(*job);
+          }, weak_factory_.GetWeakPtr(), job));
+      const auto* result = reply.FindDict("result");
+      if (!result || !result->FindInt("added") || !result->FindInt("skipped")) {
+        progress.Set("state", "error");
+        progress.Set("detail", "Chromium could not complete this bookmark batch.");
+        job->offset = job->bookmark_rows.size();
+      } else {
+        progress.Set("imported", progress.FindInt("imported").value() + *result->FindInt("added"));
+        progress.Set("skipped", progress.FindInt("skipped").value() + *result->FindInt("skipped"));
+        job->offset = end;
+        if (result->FindBool("retired").value_or(false)) job->cancelled->store(true);
+      }
+      ScheduleDispatch(job);
+      return;
+    }
+  } else if (category == "history") {
+    if (job->offset < job->decoded.history.size()) {
+      base::ListValue rows;
+      const size_t end = std::min(job->offset + 500, job->decoded.history.size());
+      for (size_t i = job->offset; i < end; ++i) {
+        const auto& visit = job->decoded.history[i];
+        base::DictValue row;
+        row.Set("url", visit.url.spec());
+        row.Set("title", HistoryTitle(visit.title));
+        row.Set("visitedAt", static_cast<double>(visit.last_visit.InMillisecondsSinceUnixEpoch()));
+        rows.Append(std::move(row));
+      }
+      base::DictValue params;
+      params.Set("visits", std::move(rows));
+      job->batch_end = end;
+      job->working = true;
+      library_->ImportHistory(params,
+          base::BindOnce(&BrowserProfileImporter::OnHistory, weak_factory_.GetWeakPtr(), job),
+          base::BindRepeating([](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job) {
+            return self && self->CurrentJob(*job);
+          }, weak_factory_.GetWeakPtr(), job));
+      return;
+    }
+  } else if (category == "tabs") {
+    if (job->offset == 0 && std::ranges::any_of(job->decoded.tabs, [](const ImportedProfileTab& tab) {
+          return tab.pinned && tab.group.has_value();
+        })) {
+      // Chromium 154 grouping always moves tabs with pinned=false. Refuse an
+      // incoherent saved session before any tab/organization effect rather than
+      // silently discarding either genuine source property.
+      progress.Set("state", "error");
+      progress.Set("detail", "This saved session combines a pinned tab with a tab group, which Chromium cannot preserve together.");
+      job->offset = job->decoded.tabs.size();
+    }
+    if (job->offset < job->decoded.tabs.size()) {
+      const auto& tab = job->decoded.tabs[job->offset];
+      const std::string window_id = base::NumberToString(job->source->window->GetSessionID().id());
+      std::string placement_error;
+      auto organization = OrganizationStore::Snapshot(profile_, window_id, &placement_error);
+      auto* layout = organization ? organization->FindDict("layout") : nullptr;
+      auto* shared = layout ? layout->FindDict("shared") : nullptr;
+      auto* spaces = shared ? shared->FindList("spaces") : nullptr;
+      auto* folders = shared ? shared->FindList("folders") : nullptr;
+      auto* order = shared ? shared->FindList("order") : nullptr;
+      auto* tab_space = shared ? shared->FindDict("tabSpace") : nullptr;
+      auto* tab_folder = shared ? shared->FindDict("tabFolder") : nullptr;
+      auto* strip = job->source->window->GetTabStripModel();
+      std::string destination = job->destination_space;
+      std::string folder_id;
+      std::string workspace_id;
+      bool new_space = false;
+      bool new_folder = false;
+      auto contains_id = [](const base::ListValue& values, const std::string& id) {
+        return std::ranges::any_of(values, [&](const base::Value& value) {
+          const auto* row = value.GetIfDict();
+          const auto* saved = row ? row->FindString("id") : nullptr;
+          return saved && *saved == id;
+        });
+      };
+      bool ready = organization && organization->FindInt("revision") && shared && spaces && folders && order && tab_space && tab_folder &&
+          order->size() < 5000 && CurrentJob(*job);
+      if (ready && tab.space) {
+        const auto& source = *tab.space;
+        ready = !source.key.empty() && !source.name.empty() &&
+            base::UTF8ToUTF16(source.name).size() <= 100 &&
+            base::UTF8ToUTF16(source.folder_path).size() <= 200;
+        if (ready) {
+          auto found = job->imported_spaces.find(source.key);
+          new_space = found == job->imported_spaces.end();
+          destination = new_space ? base::Uuid::GenerateRandomV4().AsLowercaseString() : found->second;
+          ready = new_space ? spaces->size() < 200 : contains_id(*spaces, destination);
+          if (ready && new_space) {
+            base::DictValue space;
+            space.Set("id", destination); space.Set("name", source.name);
+            space.Set("color", "slate"); space.Set("grain", 0);
+            spaces->Append(std::move(space));
+          }
+          if (ready && !source.folder_key.empty()) {
+            auto key = std::make_pair(source.key, source.folder_key);
+            auto folder = job->imported_folders.find(key);
+            new_folder = folder == job->imported_folders.end();
+            folder_id = new_folder ? base::Uuid::GenerateRandomV4().AsLowercaseString() : folder->second;
+            ready = !source.folder_path.empty() &&
+                (new_folder ? folders->size() < 1000 : contains_id(*folders, folder_id));
+            if (ready && new_folder) {
+              base::DictValue row;
+              row.Set("id", folder_id); row.Set("name", source.folder_path);
+              row.Set("spaceId", destination); row.Set("collapsed", false);
+              folders->Append(std::move(row));
+            }
+          }
+        }
+      } else if (ready) {
+        ready = contains_id(*spaces, destination);
+      }
+      if (ready) {
+        for (const auto& row : *spaces) {
+          const auto& space = row.GetDict();
+          if (*space.FindString("id") == destination) {
+            if (const auto* workspace = space.FindString("workspaceId")) workspace_id = *workspace;
+            break;
+          }
+        }
+      }
+      if (ready && tab.group) {
+        auto group = job->imported_groups.find(tab.group->key);
+        ready = strip->SupportsTabGroups() &&
+            (group == job->imported_groups.end() ||
+             strip->group_model()->ContainsTabGroup(group->second));
+      }
+      if (!ready) {
+        progress.Set("state", "error");
+        progress.Set("detail", "The source tab placement or original destination Space is unavailable or exceeds its supported bounds.");
+        job->offset = job->decoded.tabs.size();
+        ScheduleDispatch(job);
+        return;
+      }
+      // Mint and publish only original-job page IDs; never attach an existing
+      // user's page or merge groups by their display name.
+      const std::string page_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+      tab_space->Set(page_id, destination);
+      if (!folder_id.empty()) tab_folder->Set(page_id, folder_id);
+      order->Append(page_id);
+      // Commit placement before creating the page. All capacity/schema/CAS
+      // checks happen before opening a tab; later retirement stops new effects.
+      if (!CurrentJob(*job) || !OrganizationStore::Commit(profile_, window_id,
+          organization->FindInt("revision").value(), *layout, &placement_error)) {
+        progress.Set("state", "error");
+        progress.Set("detail", "The destination organization changed before this imported tab was accepted.");
+        job->offset = job->decoded.tabs.size();
+        ScheduleDispatch(job);
+        return;
+      }
+      if (new_space) job->imported_spaces.emplace(tab.space->key, destination);
+      if (new_folder) job->imported_folders.emplace(
+          std::make_pair(tab.space->key, tab.space->folder_key), folder_id);
+      base::DictValue command;
+      command.Set("kind", "open"); command.Set("url", tab.url.spec());
+      command.Set("pageId", page_id); command.Set("background", true);
+      auto* catalog = TabCatalog::GetForProfile(profile_);
+      auto result = CurrentJob(*job) ? catalog->Command(job->source->window.get(),
+          job->operation + "_tab_" + std::to_string(job->offset), command, std::nullopt) : base::DictValue();
+      const auto* status = result.FindString("status");
+      BrowserWindowInterface* owner = nullptr;
+      auto* contents = catalog->FindPage(page_id, &owner);
+      if (status && (*status == "applied" || *status == "duplicate") &&
+          contents && owner == job->source->window.get()) {
+        progress.Set("imported", progress.FindInt("imported").value() + 1);
+        if (CurrentJob(*job)) {
+          const int index = strip->GetIndexOfWebContents(contents);
+          if (index >= 0) {
+            if (tab.pinned) strip->SetTabPinned(index, true);
+            if (CurrentJob(*job)) catalog->BindSpace(page_id, destination, workspace_id);
+            if (tab.group && CurrentJob(*job)) {
+              // Native model notifications may reorder/retire a page. Resolve
+              // the original page/window again before the next admitted effect.
+              BrowserWindowInterface* group_owner = nullptr;
+              auto* group_contents = catalog->FindPage(page_id, &group_owner);
+              strip = job->source->window->GetTabStripModel();
+              const int group_index = group_contents && group_owner == job->source->window.get() ?
+                  strip->GetIndexOfWebContents(group_contents) : -1;
+              if (group_index >= 0) {
+                auto group = job->imported_groups.find(tab.group->key);
+                if (group == job->imported_groups.end()) {
+                  const auto id = strip->AddToNewGroup({group_index});
+                  job->imported_groups.emplace(tab.group->key, id);
+                  if (CurrentJob(*job) && job->source->window->GetTabStripModel()->group_model()->ContainsTabGroup(id))
+                    job->source->window->GetTabStripModel()->ChangeTabGroupVisuals(id, tab.group->visual_data, true);
+                } else if (strip->group_model()->ContainsTabGroup(group->second)) {
+                  strip->AddToExistingGroup({group_index}, group->second, true);
+                }
+              }
+            }
+          }
+          if (CurrentJob(*job)) {
+            BrowserWindowInterface* final_owner = nullptr;
+            auto* final_contents = catalog->FindPage(page_id, &final_owner);
+            auto* final_strip = job->source->window->GetTabStripModel();
+            const int final_index = final_contents && final_owner == job->source->window.get() ?
+                final_strip->GetIndexOfWebContents(final_contents) : -1;
+            const auto expected_group = tab.group ? job->imported_groups.find(tab.group->key) : job->imported_groups.end();
+            if (final_index < 0 || final_strip->IsTabPinned(final_index) != tab.pinned ||
+                (tab.group && (expected_group == job->imported_groups.end() ||
+                    final_strip->GetTabGroupForTab(final_index) != expected_group->second))) {
+              progress.Set("state", "error");
+              progress.Set("detail", "The tab opened, but Chromium did not retain its original pin/group placement.");
+              job->offset = job->decoded.tabs.size();
+            }
+          }
+        }
+      } else {
+        progress.Set("state", "error");
+        // Reduction only: remove this never-created page's exact reservation,
+        // preserving any concurrent organization edit and prior imported pages.
+        auto latest = OrganizationStore::Snapshot(profile_, window_id, &placement_error);
+        auto* cleanup_layout = latest ? latest->FindDict("layout") : nullptr;
+        auto* cleanup_shared = cleanup_layout ? cleanup_layout->FindDict("shared") : nullptr;
+        bool cleared = false;
+        if (cleanup_shared && !catalog->FindPage(page_id) && latest->FindInt("revision")) {
+          auto* placements = cleanup_shared->FindDict("tabSpace");
+          auto* folder_placements = cleanup_shared->FindDict("tabFolder");
+          auto* saved_order = cleanup_shared->FindList("order");
+          const auto* reserved = placements ? placements->FindString(page_id) : nullptr;
+          if (reserved && *reserved == destination && folder_placements && saved_order) {
+            placements->Remove(page_id); folder_placements->Remove(page_id);
+            saved_order->EraseIf([&](const base::Value& value) { return value.is_string() && value.GetString() == page_id; });
+            // Empty imported Spaces/folders are accepted organization effects;
+            // retain their original IDs so a later category/job receipt is honest.
+            cleared = OrganizationStore::Commit(profile_, window_id,
+                *latest->FindInt("revision"), *cleanup_layout, &placement_error).has_value();
+          }
+        }
+        progress.Set("detail", cleared ? "Chromium could not create an imported tab; its unused page placement was removed." :
+            "Chromium could not create an imported tab and its original placement cleanup could not be acknowledged.");
+        job->offset = job->decoded.tabs.size();
+      }
+      ++job->offset;
+      // Yield between actual tab effects, so retirement/cancellation can stop
+      // the next admission even for large original browser sessions.
+      ScheduleDispatch(job);
+      return;
+    }
+  } else if (category == "passwords") {
+    if (job->offset < job->decoded.passwords.size()) {
+      auto delegate = extensions::PasswordsPrivateDelegateFactory::GetForBrowserContext(profile_, true);
+      auto* presenter = delegate ? delegate->GetSavedPasswordsPresenter() : nullptr;
+      if (!presenter || presenter->IsWaitingForPasswordStore()) {
+        progress.Set("state", "error");
+        progress.Set("detail", "Saved passwords are still loading. Refresh this category before retrying.");
+        job->offset = job->decoded.passwords.size();
+      } else {
+        const size_t end = std::min(job->offset + 500, job->decoded.passwords.size());
+        std::vector<password_manager::CSVPassword> passwords;
+        // Public native cache view preserves every real facet in grouped saved
+        // credentials. Never replace an existing profile/account password, and
+        // reject duplicate source rows before the same native importer batch.
+        std::set<std::pair<std::string, std::u16string>> occupied;
+        for (const auto& saved : presenter->GetSavedCredentials()) {
+          if (!saved.passkey_credential_id.empty()) continue;
+          for (const auto& facet : saved.facets)
+            occupied.emplace(facet.signon_realm, saved.username);
+        }
+        for (size_t i = job->offset; i < end; ++i) {
+          const auto& credential = job->decoded.passwords[i];
+          password_manager::CSVPassword csv(credential.url,
+              base::UTF16ToUTF8(credential.username_value),
+              base::UTF16ToUTF8(credential.password_value.secure_value()),
+              base::UTF16ToUTF8(credential.GetPasswordNote()),
+              password_manager::CSVPassword::Status::kOK);
+          password_manager::CredentialUIEntry destination(csv);
+          if (destination.password.empty() ||
+              !occupied.emplace(destination.GetFirstSignonRealm(), destination.username).second) {
+            progress.Set("skipped", progress.FindInt("skipped").value() + 1);
+            continue;
+          }
+          passwords.push_back(std::move(csv));
+        }
+        job->batch_end = end;
+        job->working = true;
+        job->password_importer = std::make_unique<password_manager::PasswordImporter>(*presenter);
+        job->password_importer->SetDispatchGuard(base::BindRepeating(
+            [](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job) {
+              return self && self->CurrentJob(*job);
+            }, weak_factory_.GetWeakPtr(), job));
+        job->password_importer->Import(passwords,
+            password_manager::PasswordForm::Store::kProfileStore,
+            base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self,
+                std::shared_ptr<Job> job, size_t count, const password_manager::ImportResults& result) {
+              if (self) self->OnPasswords(job, count, result.status, result.number_imported);
+            }, weak_factory_.GetWeakPtr(), job, passwords.size()));
+        return;
+      }
+    }
+  } else if (category == "extensions") {
+    if (job->offset < job->extension_destinations.size()) {
+      const auto& id = job->extension_destinations[job->offset];
+      if (id.empty() || extensions::ExtensionRegistry::Get(profile_)->GetExtensionById(
+              id, extensions::ExtensionRegistry::EVERYTHING)) {
+        progress.Set("skipped", progress.FindInt("skipped").value() + 1);
+        ++job->offset;
+        ScheduleDispatch(job);
+        return;
+      }
+      job->working = true;
+      job->extension_installer = base::MakeRefCounted<BrowserProfileExtensionInstaller>(
+          id, profile_, job->source->window->GetWindow()->GetNativeWindow(),
+          base::BindRepeating([](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job) {
+            return self && self->CurrentJob(*job);
+          }, weak_factory_.GetWeakPtr(), job),
+          job->extension_review->candidates[job->offset].enabled == false,
+          base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self,
+              std::shared_ptr<Job> job, bool success, const std::string&, extensions::webstore_install::Result) {
+            if (self) self->OnExtension(job, success);
+          }, weak_factory_.GetWeakPtr(), job));
+      job->extension_installer->BeginInstall();
+      return;
+    }
+  }
+  if (progress.FindString("state") && *progress.FindString("state") == "running") progress.Set("state", "done");
+  ++job->category;
+  job->offset = 0;
+  ScheduleDispatch(job);
+}
+void BrowserProfileImporter::OnHistory(const std::shared_ptr<Job>& job, base::DictValue reply) {
+  job->working = false;
+  auto& progress = job->progress[job->category].GetDict();
+  const auto* result = reply.FindDict("result");
+  const auto added = result ? result->FindInt("added") : std::nullopt;
+  const auto skipped = result ? result->FindInt("skipped") : std::nullopt;
+  if (!added || !skipped || *added < 0 || *skipped < 0 ||
+      static_cast<size_t>(*added + *skipped) > job->batch_end - job->offset) {
+    progress.Set("state", "error");
+    progress.Set("detail", "Chromium did not confirm this history batch.");
+    job->offset = job->decoded.history.size();
+  } else {
+    progress.Set("imported", progress.FindInt("imported").value() + *added);
+    progress.Set("skipped", progress.FindInt("skipped").value() + *skipped);
+    job->offset = job->batch_end;
+  }
+  Dispatch(job);
+}
+void BrowserProfileImporter::OnPasswords(const std::shared_ptr<Job>& job,
+    size_t total, int status, size_t imported) {
+  if (status == password_manager::ImportResults::CONFLICTS && CurrentJob(*job)) {
+    // Existing credentials are never overwritten by source import. This is the
+    // upstream importer's explicit skip-conflicts continuation, still subject
+    // to the mandatory final native dispatch guard.
+    job->password_importer->ContinueImport({}, base::BindOnce(
+        [](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job,
+           size_t total, const password_manager::ImportResults& result) {
+          if (self) self->OnPasswords(job, total, result.status, result.number_imported);
+        }, weak_factory_.GetWeakPtr(), job, total));
+    return;
+  }
+  job->working = false;
+  auto& progress = job->progress[job->category].GetDict();
+  if (status == password_manager::ImportResults::SUCCESS && imported <= total) {
+    progress.Set("imported", progress.FindInt("imported").value() + static_cast<int>(imported));
+    progress.Set("skipped", progress.FindInt("skipped").value() + static_cast<int>(total - imported));
+  } else {
+    progress.Set("state", "error");
+    progress.Set("detail", "Chromium did not confirm this password batch.");
+  }
+  // Deleting the importer is deferred until its completion stack returns.
+  auto completed = std::move(job->password_importer);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, std::move(completed));
+  job->offset = status == password_manager::ImportResults::SUCCESS && imported <= total
+      ? job->batch_end : job->decoded.passwords.size();
+  Dispatch(job);
+}
+void BrowserProfileImporter::OnExtension(const std::shared_ptr<Job>& job, bool success) {
+  job->working = false;
+  auto& progress = job->progress[job->category].GetDict();
+  const char* counter = success ? "imported" : "skipped";
+  progress.Set(counter, progress.FindInt(counter).value() + 1);
+  if (!success) progress.Set("detail", "An extension was declined or could not be installed from the Chrome Web Store.");
+  job->extension_installer.reset();
+  ++job->offset;
+  Dispatch(job);
+}
+void BrowserProfileImporter::Finish(const std::shared_ptr<Job>& job, const std::string& error) {
+  if (job->done) return;
+  CHECK(!job->working);
+  job->done = true;
+  job->error = error;
+  for (auto& value : job->progress) {
+    auto& progress = value.GetDict();
+    const auto* state = progress.FindString("state");
+    if (state && *state == "running") {
+      progress.Set("state", error.empty() ? "skipped" : "error");
+      progress.Set("detail", error.empty() ? "Cancelled before the next native batch was accepted." : error);
+    }
+  }
+  job->decoded.passwords.clear();
+  job->bookmark_rows.clear();
+  job->bookmark_folders.clear();
+  job->cleanup = true;
+  auto decoded = std::make_unique<DecodedBrowserProfile>(std::move(job->decoded));
+  const bool posted = worker_->PostTaskAndReply(FROM_HERE,
+      base::BindOnce([](std::unique_ptr<DecodedBrowserProfile> data) { data.reset(); }, std::move(decoded)),
+      base::BindOnce([](base::WeakPtr<BrowserProfileImporter> self, std::shared_ptr<Job> job) {
+        job->cleanup = false;
+        if (self) self->MaybeJoined();
+      }, weak_factory_.GetWeakPtr(), job));
+  // A rejected task is destroyed synchronously, including its decoded data.
+  if (!posted) job->cleanup = false;
+  job->password_importer.reset();
+  job->extension_installer.reset();
+  job->source_crypt.reset();
+  MaybeJoined();
+}
+}  // namespace aux
