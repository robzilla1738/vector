index 0000000..e58c87a
--- /dev/null
+++ b/chrome/utility/aux/firefox_private_vfs.cc
@@ -0,0 +1,83 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/utility/aux/firefox_private_vfs.h"
+#include <map>
+#include <memory>
+#include "base/thread_annotations.h"
+#include "base/synchronization/lock.h"
+#include "base/uuid.h"
+#include "components/services/storage/sandboxed_vfs_file_impl.h"
+#include "sql/sandboxed_vfs.h"
+namespace aux {
+namespace {
+constexpr char kVfsName[] = "aux-firefox-private-copy";
+class PrivateFile final : public storage::SandboxedVfsFileImpl {
+ public:
+  using SandboxedVfsFileImpl::SandboxedVfsFileImpl;
+  int Fetch(sqlite3_int64, int, void** result) override { *result = nullptr; return SQLITE_OK; }
+  int Unfetch(sqlite3_int64, void*) override { return SQLITE_OK; }
+};
+class PrivateDelegate final : public sql::SandboxedVfs::Delegate {
+ public:
+  bool Add(const base::FilePath& path, base::File file, bool exists) {
+    const int64_t length = file.IsValid() ? file.GetLength() : -1;
+    if (length < 0 || length > 1024LL * 1024 * 1024) return false;
+    base::AutoLock lock(lock_);
+    return files_.emplace(path, Entry{std::move(file), exists}).second;
+  }
+  void Remove(const base::FilePath& path) { base::AutoLock lock(lock_); files_.erase(path); }
+  sql::SandboxedVfsFile* RetrieveSandboxedVfsFile(base::File file,
+      base::FilePath path, sql::SandboxedVfsFileType type, sql::SandboxedVfs* vfs) override {
+    return new PrivateFile(std::move(file), std::move(path), type, vfs);
+  }
+  base::File OpenFile(const base::FilePath& path, int flags) override {
+    base::AutoLock lock(lock_);
+    auto found = files_.find(path);
+    if (found == files_.end() || (!found->second.exists && !(flags & SQLITE_OPEN_CREATE))) return {};
+    found->second.exists = true;
+    return found->second.file.Duplicate();
+  }
+  int DeleteFile(const base::FilePath& path, bool) override {
+    base::AutoLock lock(lock_);
+    auto found = files_.find(path);
+    if (found == files_.end() || !found->second.file.SetLength(0)) return SQLITE_IOERR_DELETE;
+    found->second.exists = false;
+    return SQLITE_OK;
+  }
+  std::optional<sql::SandboxedVfs::PathAccessInfo> GetPathAccess(const base::FilePath& path) override {
+    base::AutoLock lock(lock_);
+    auto found = files_.find(path);
+    if (found == files_.end() || !found->second.exists) return std::nullopt;
+    return sql::SandboxedVfs::PathAccessInfo{true, true};
+  }
+ private:
+  struct Entry { base::File file; bool exists; };
+  base::Lock lock_;
+  std::map<base::FilePath, Entry> files_ GUARDED_BY(lock_);
+};
+PrivateDelegate& Delegate() {
+  static PrivateDelegate* const delegate = [] {
+    auto owned = std::make_unique<PrivateDelegate>();
+    auto* pointer = owned.get();
+    sql::SandboxedVfs::Register(kVfsName, std::move(owned), false);
+    return pointer;
+  }();
+  return *delegate;
+}
+}  // namespace
+const char* FirefoxPrivateVfsScope::name() { return kVfsName; }
+FirefoxPrivateVfsScope::FirefoxPrivateVfsScope(base::File database, base::File wal, base::File journal)
+    : path_(base::FilePath("/aux-firefox-private").AppendASCII(base::Uuid::GenerateRandomV4().AsLowercaseString()).AppendASCII("places.sqlite")) {
+  const bool journal_exists = journal.GetLength() > 0;
+  valid_ = database.GetLength() >= 100 &&
+      Delegate().Add(path_, std::move(database), true) &&
+      Delegate().Add(base::FilePath(path_.value() + "-wal"), std::move(wal), true) &&
+      Delegate().Add(base::FilePath(path_.value() + "-journal"), std::move(journal), journal_exists);
+}
+FirefoxPrivateVfsScope::~FirefoxPrivateVfsScope() {
+  Delegate().Remove(path_);
+  Delegate().Remove(base::FilePath(path_.value() + "-wal"));
+  Delegate().Remove(base::FilePath(path_.value() + "-journal"));
+}
+}  // namespace aux
