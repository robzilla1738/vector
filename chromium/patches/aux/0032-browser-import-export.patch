+namespace aux {
+// Registers the maintained SQLite sandbox VFS against exact transferred copy
+// handles. It never opens a path. The scope closes all duplicate handles after
+// the synchronous utility decoder and its real database close have completed.
+class FirefoxPrivateVfsScope {
+ public:
+  FirefoxPrivateVfsScope(base::File database, base::File wal, base::File journal);
