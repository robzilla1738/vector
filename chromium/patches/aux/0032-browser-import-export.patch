+#include "chrome/browser/ui/aux/browser_profile_snapshot.h"
+namespace os_crypt_async { class Encryptor; }
+namespace aux {
+// An immutable archive-entry selection, not an inferred Safari Profile identity.
+struct BrowserExportGroup {
+  std::string label;
+  std::vector<std::string> entries;
+  std::vector<std::string> categories;
+  std::map<std::string, std::string> errors;
+};
+struct DecodedBrowserProfile {
+  std::unique_ptr<BrowserProfileSnapshot> snapshot;
+  base::File firefox_database;
+  base::File firefox_wal;
+  base::File firefox_journal;
+  std::optional<mojo_base::BigBuffer> firefox_session;
+  std::vector<ImportedProfileBookmark> bookmarks;
+  std::vector<ImportedProfileHistory> history;
+  std::vector<ImportedProfileTab> tabs;
+  std::vector<password_manager::StoredCredential> passwords;
+  std::vector<BrowserExtensionCandidate> extension_candidates;
+  std::map<std::string, std::string> errors;
+  std::string snapshot_error;
+  std::string bookmark_html;
+  bool bookmarks_as_tabs = false;
+  std::vector<std::string> export_categories;
+  std::vector<BrowserExportGroup> export_groups;
+};
+// Blocking snapshot/Chromium decoding runs on one native single-thread task runner.
+// No original browser file is writable, no plaintext secrets cross IPC, and
+// the cancellation callback is worker-safe (never a BrowserWindow/UI pointer).
+DecodedBrowserProfile DecodeBrowserProfile(
+    const base::FilePath& source,
+    const std::vector<std::string>& categories,
+    scoped_refptr<os_crypt_async::Encryptor> source_encryptor,
+    const base::RepeatingCallback<bool()>& cancelled);
+}  // namespace aux
