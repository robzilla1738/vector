diff --git a/chrome/browser/ui/aux/browser_profile_snapshot.cc b/chrome/browser/ui/aux/browser_profile_snapshot.cc
new file mode 100644
index 0000000..b3a5f31
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_profile_snapshot.cc
@@ -0,0 +1,308 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_profile_snapshot.h"
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <array>
+#include <cerrno>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_util.h"
+#include "components/sessions/core/session_constants.h"
+
+namespace aux {
+namespace {
+constexpr int64_t kMaxSnapshotBytes = 1024LL * 1024 * 1024;
+constexpr size_t kMaxSessionFiles = 256;
+
+bool SameEntry(const struct stat& before, const struct stat& after) {
+  return before.st_dev == after.st_dev && before.st_ino == after.st_ino &&
+         before.st_mode == after.st_mode && before.st_size == after.st_size &&
+         before.st_mtimespec.tv_sec == after.st_mtimespec.tv_sec &&
+         before.st_mtimespec.tv_nsec == after.st_mtimespec.tv_nsec &&
+         before.st_ctimespec.tv_sec == after.st_ctimespec.tv_sec &&
+         before.st_ctimespec.tv_nsec == after.st_ctimespec.tv_nsec;
+}
+
+bool SafeLeaf(const std::string& leaf) {
+  return !leaf.empty() && leaf != "." && leaf != ".." &&
+         leaf.find('/') == std::string::npos && leaf.find('\0') == std::string::npos;
+}
+}  // namespace
+
+struct BrowserProfileSnapshot::HeldEntry {
+  base::ScopedFD descriptor;
+  base::ScopedFD parent;
+  std::string leaf;
+  struct stat identity;
+  bool contents = true;
+  bool Current() const {
+    struct stat current, linked;
+    return fstat(descriptor.get(), &current) == 0 &&
+        (contents ? SameEntry(identity, current) :
+          identity.st_dev == current.st_dev && identity.st_ino == current.st_ino && identity.st_mode == current.st_mode) &&
+        (leaf.empty() || (fstatat(parent.get(), leaf.c_str(), &linked,
+                                  AT_SYMLINK_NOFOLLOW) == 0 &&
+                         (contents ? SameEntry(identity, linked) :
+                             identity.st_dev == linked.st_dev && identity.st_ino == linked.st_ino && identity.st_mode == linked.st_mode)));
+  }
+};
+BrowserProfileSnapshot::BrowserProfileSnapshot() = default;
+BrowserProfileSnapshot::~BrowserProfileSnapshot() = default;
+
+bool BrowserProfileSnapshot::OriginalIsCurrent() const {
+  for (const auto& entry : originals_) if (!entry->Current()) return false;
+  return true;
+}
+
+base::expected<std::unique_ptr<BrowserProfileSnapshot>, std::string>
+BrowserProfileSnapshot::Capture(const base::FilePath& profile,
+                               const std::vector<std::string>& files,
+                               bool include_sessions,
+                               const base::RepeatingCallback<bool()>& cancelled,
+                               bool include_firefox_sessions,
+                               std::map<std::string, std::string>* firefox_copy_errors) {
+  if (cancelled.is_null() || cancelled.Run())
+    return base::unexpected("Browser import was cancelled.");
+  auto snapshot = std::unique_ptr<BrowserProfileSnapshot>(new BrowserProfileSnapshot);
+  if (!profile.IsAbsolute() || profile.ReferencesParent())
+    return base::unexpected("Invalid original browser Profile.");
+  base::ScopedFD root(HANDLE_EINTR(open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC)));
+  for (const auto& component : profile.GetComponents()) {
+    if (component == "/") continue;
+    if (!SafeLeaf(component) || component == ".")
+      return base::unexpected("Invalid original browser Profile.");
+    auto entry = std::make_unique<HeldEntry>();
+    entry->parent.reset(HANDLE_EINTR(dup(root.get())));
+    entry->leaf = component;
+    entry->descriptor.reset(HANDLE_EINTR(openat(root.get(), component.c_str(),
+        O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+    entry->contents = false;
+    if (!entry->descriptor.is_valid() || !entry->parent.is_valid() ||
+        fstat(entry->descriptor.get(), &entry->identity) != 0)
+      return base::unexpected("The browser Profile path changed or contains a symbolic link.");
+    root.reset(HANDLE_EINTR(dup(entry->descriptor.get())));
+    snapshot->originals_.push_back(std::move(entry));
+  }
+  // System temp paths on macOS commonly contain /var or /tmp aliases. Resolve
+  // only this owned-output parent; original picked-source paths stay strict.
+  base::FilePath temporary;
+  if (!root.is_valid() || !base::GetTempDir(&temporary))
+    return base::unexpected("This browser Profile could not be opened safely.");
+  const base::FilePath canonical_temporary = base::MakeAbsoluteFilePath(temporary);
+  if (canonical_temporary.empty() || canonical_temporary.ReferencesParent())
+    return base::unexpected("The private snapshot parent is unavailable.");
+  auto temp_parent = std::make_unique<HeldEntry>();
+  temp_parent->parent.reset(HANDLE_EINTR(open(canonical_temporary.DirName().value().c_str(),
+      O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+  temp_parent->leaf = canonical_temporary.BaseName().value();
+  temp_parent->descriptor.reset(HANDLE_EINTR(openat(temp_parent->parent.get(),
+      temp_parent->leaf.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+  temp_parent->contents = false;
+  if (!temp_parent->parent.is_valid() || !temp_parent->descriptor.is_valid() ||
+      fstat(temp_parent->descriptor.get(), &temp_parent->identity) != 0 ||
+      !S_ISDIR(temp_parent->identity.st_mode) ||
+      (temp_parent->identity.st_uid != geteuid() &&
+       !(temp_parent->identity.st_uid == 0 && (temp_parent->identity.st_mode & S_ISVTX))) ||
+      !temp_parent->Current() ||
+      !snapshot->directory_.CreateUniqueTempDirUnderPath(canonical_temporary) ||
+      !temp_parent->Current())
+    return base::unexpected("A private import snapshot could not be created safely.");
+  auto temp_directory = std::make_unique<HeldEntry>();
+  temp_directory->parent.reset(HANDLE_EINTR(dup(temp_parent->descriptor.get())));
+  temp_directory->leaf = snapshot->path().BaseName().value();
+  temp_directory->descriptor.reset(HANDLE_EINTR(openat(temp_directory->parent.get(),
+      temp_directory->leaf.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+  temp_directory->contents = false;
+  if (!temp_directory->parent.is_valid() || !temp_directory->descriptor.is_valid() ||
+      fstat(temp_directory->descriptor.get(), &temp_directory->identity) != 0 ||
+      temp_directory->identity.st_uid != geteuid() ||
+      (temp_directory->identity.st_mode & 0777) != 0700 || !temp_directory->Current())
+    return base::unexpected("A private import snapshot could not be pinned safely.");
+  snapshot->originals_.push_back(std::move(temp_parent));
+  snapshot->originals_.push_back(std::move(temp_directory));
+  auto retain_directory = [&](int descriptor, int parent = -1, const char* leaf = "") {
+    auto entry = std::make_unique<HeldEntry>();
+    entry->descriptor.reset(HANDLE_EINTR(dup(descriptor)));
+    if (parent >= 0) entry->parent.reset(HANDLE_EINTR(dup(parent)));
+    entry->leaf = leaf;
+    if (!entry->descriptor.is_valid() || fstat(descriptor, &entry->identity) != 0)
+      return false;
+    snapshot->originals_.push_back(std::move(entry));
+    return true;
+  };
+  if (!retain_directory(root.get()))
+    return base::unexpected("The original browser Profile is unavailable.");
+  auto firefox_leaf = [&](const std::string& leaf) {
+    return firefox_copy_errors && (leaf == "places.sqlite" || leaf == "places.sqlite-wal" ||
+        leaf == "places.sqlite-journal" || leaf == "sessionstore.jsonlz4" ||
+        leaf == "recovery.jsonlz4" || leaf == "recovery.baklz4" || leaf == "sessionstore-backups");
+  };
+  // A denied content read can remain a category error only while a real held
+  // metadata descriptor proves the same original inode/mode/timestamps. Unsafe
+  // links, replacement, missing proof and private-output failure stay global.
+  auto retain_unreadable = [&](int parent, const std::string& leaf, bool directory, const struct stat* expected = nullptr) {
+    if (!firefox_leaf(leaf)) return false;
+    auto entry = std::make_unique<HeldEntry>();
+    entry->descriptor.reset(HANDLE_EINTR(openat(parent, leaf.c_str(), O_EVTONLY | O_NOFOLLOW | O_CLOEXEC | (directory ? O_DIRECTORY : 0))));
+    entry->parent.reset(HANDLE_EINTR(dup(parent))); entry->leaf = leaf;
+    if (!entry->descriptor.is_valid() || !entry->parent.is_valid() ||
+        fstat(entry->descriptor.get(), &entry->identity) != 0 ||
+        (directory ? !S_ISDIR(entry->identity.st_mode) : !S_ISREG(entry->identity.st_mode)) ||
+        (expected && !SameEntry(*expected, entry->identity)) || !entry->Current()) return false;
+    snapshot->originals_.push_back(std::move(entry));
+    (*firefox_copy_errors)[leaf] = "The selected Firefox source file cannot be read safely.";
+    return true;
+  };
+  int64_t total = 0;
+  auto copy = [&](int source_directory, const std::string& leaf,
+                  const base::FilePath& destination, const struct stat* expected = nullptr) {
+    if (!SafeLeaf(leaf)) return false;
+    auto entry = std::make_unique<HeldEntry>();
+    entry->descriptor.reset(HANDLE_EINTR(openat(source_directory, leaf.c_str(),
+        O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)));
+    const int source_error = entry->descriptor.is_valid() ? 0 : errno;
+    if ((source_error == EACCES || source_error == EPERM) && retain_unreadable(source_directory, leaf, false, expected)) return false;
+    entry->parent.reset(HANDLE_EINTR(dup(source_directory)));
+    entry->leaf = leaf;
+    if (!entry->descriptor.is_valid() || !entry->parent.is_valid() ||
+        fstat(entry->descriptor.get(), &entry->identity) != 0 ||
+        !S_ISREG(entry->identity.st_mode) || (expected && !SameEntry(*expected, entry->identity)) || entry->identity.st_size < 0 ||
+        entry->identity.st_size > kMaxSnapshotBytes - total) return false;
+    base::ScopedFD output(HANDLE_EINTR(open(destination.value().c_str(),
+        O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600)));
+    if (!output.is_valid()) return false;
+    std::array<char, 64 * 1024> buffer;
+    int64_t copied = 0;
+    for (;;) {
+      if (cancelled.Run()) return false;
+      ssize_t count = HANDLE_EINTR(read(entry->descriptor.get(), buffer.data(), buffer.size()));
+      if (count < 0) {
+        const int read_error = errno;
+        if (firefox_leaf(leaf) && (read_error == EIO || read_error == EACCES || read_error == EPERM) && entry->Current() &&
+            unlink(destination.value().c_str()) == 0) {
+          snapshot->originals_.push_back(std::move(entry));
+          (*firefox_copy_errors)[leaf] = "The selected Firefox source file could not be read completely.";
+        }
+        return false;
+      }
+      if (count == 0) break;
+      if (count > entry->identity.st_size - copied) return false;
+      ssize_t written = 0;
+      while (written < count) {
+        const auto remaining = base::span(buffer).first(static_cast<size_t>(count)).subspan(static_cast<size_t>(written));
+        ssize_t next = HANDLE_EINTR(write(output.get(), remaining.data(), remaining.size()));
+        if (next <= 0) return false;
+        written += next;
+      }
+      copied += count;
+    }
+    if (copied != entry->identity.st_size || !entry->Current()) return false;
+    total += copied;
+    snapshot->originals_.push_back(std::move(entry));
+    return true;
+  };
+  bool firefox_primary_selected = false;
+  for (const auto& leaf : files) {
+    if (cancelled.Run()) return base::unexpected("Browser import was cancelled.");
+    if (!SafeLeaf(leaf)) return base::unexpected("Invalid browser import file.");
+    struct stat identity;
+    if (fstatat(root.get(), leaf.c_str(), &identity, AT_SYMLINK_NOFOLLOW) != 0) {
+      if (errno == ENOENT) continue;
+      if ((errno == EACCES || errno == EPERM) && retain_unreadable(root.get(), leaf, false)) {
+        if (leaf == "sessionstore.jsonlz4") firefox_primary_selected = true;
+        continue;
+      }
+      return base::unexpected("A browser import file is unavailable.");
+    }
+    if (leaf == "sessionstore.jsonlz4") firefox_primary_selected = true;
+    if (leaf == "sessionstore.jsonlz4" && identity.st_size > 32 * 1024 * 1024) {
+      if (retain_unreadable(root.get(), leaf, false, &identity)) {
+        (*firefox_copy_errors)[leaf] = "The Firefox session exceeds the safe import size."; continue;
+      }
+      return base::unexpected("The browser changed while it was being read. Close it and try again.");
+    }
+    if (!copy(root.get(), leaf, snapshot->path().AppendASCII(leaf), &identity) &&
+        !(firefox_copy_errors && firefox_copy_errors->contains(leaf)))
+      return base::unexpected("The browser changed while it was being read. Close it and try again.");
+  }
+  if (include_firefox_sessions && !firefox_primary_selected) {
+    // Mozilla's current priority is the clean session, then recovery, then
+    // recovery backup. Only ENOENT advances to the next candidate; never read
+    // an irrelevant fallback or silently substitute one after a read failure.
+    constexpr char name[] = "sessionstore-backups";
+    base::ScopedFD directory(HANDLE_EINTR(openat(root.get(), name,
+        O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+    if (!directory.is_valid() && errno != ENOENT) {
+      if (!((errno == EACCES || errno == EPERM) && retain_unreadable(root.get(), name, true)))
+        return base::unexpected("The Firefox recovery session is unavailable.");
+    }
+    if (directory.is_valid()) {
+      if (!retain_directory(directory.get(), root.get(), name) ||
+          !base::CreateDirectory(snapshot->path().AppendASCII(name)))
+        return base::unexpected("The Firefox session could not be copied safely.");
+      for (const char* leaf : {"recovery.jsonlz4", "recovery.baklz4"}) {
+        struct stat identity;
+        if (fstatat(directory.get(), leaf, &identity, AT_SYMLINK_NOFOLLOW) != 0) {
+          if (errno == ENOENT) continue;
+          if ((errno == EACCES || errno == EPERM) && retain_unreadable(directory.get(), leaf, false)) break;
+          return base::unexpected("The Firefox recovery session is unavailable.");
+        }
+        if (identity.st_size > 32 * 1024 * 1024) {
+          if (retain_unreadable(directory.get(), leaf, false, &identity)) {
+            (*firefox_copy_errors)[leaf] = "The Firefox session exceeds the safe import size."; break;
+          }
+          return base::unexpected("The Firefox session changed while it was being copied.");
+        }
+        if (!copy(directory.get(), leaf, snapshot->path().AppendASCII(name).AppendASCII(leaf), &identity) &&
+            !(firefox_copy_errors && firefox_copy_errors->contains(leaf)))
+          return base::unexpected("The Firefox session changed while it was being copied.");
+        break;  // This exact present candidate is the original session authority.
+      }
+    }
+  }
+  if (include_sessions) {
+    for (const char* name : {sessions::kSessionsDirectory.data(),
+                             sessions::kEncryptedSessionsDirectory.data()}) {
+      base::ScopedFD directory(HANDLE_EINTR(openat(root.get(), name,
+          O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+      if (!directory.is_valid()) {
+        if (errno == ENOENT) continue;
+        return base::unexpected("The original browser session is unavailable.");
+      }
+      if (!retain_directory(directory.get(), root.get(), name) ||
+          !base::CreateDirectory(snapshot->path().AppendASCII(name)))
+        return base::unexpected("The browser session could not be copied safely.");
+      DIR* entries = fdopendir(HANDLE_EINTR(dup(directory.get())));
+      if (!entries) return base::unexpected("The browser session could not be listed.");
+      size_t count = 0;
+      bool copied = true;
+      errno = 0;
+      while (auto* entry = readdir(entries)) {
+        const std::string leaf(entry->d_name);
+        if (!base::StartsWith(leaf, "Session_") && !base::StartsWith(leaf, "Tabs_")) continue;
+        if (++count > kMaxSessionFiles || !copy(directory.get(), leaf,
+            snapshot->path().AppendASCII(name).AppendASCII(leaf))) { copied = false; break; }
+        errno = 0;
+      }
+      const int listing_error = errno;
+      closedir(entries);
+      if (!copied || listing_error || !snapshot->OriginalIsCurrent())
+        return base::unexpected("The browser session changed. Close it and try again.");
+    }
+  }
+  if (cancelled.Run()) return base::unexpected("Browser import was cancelled.");
+  if (!snapshot->OriginalIsCurrent())
+    return base::unexpected("The browser changed while it was being read. Close it and try again.");
+  return snapshot;
+}
+}  // namespace aux
