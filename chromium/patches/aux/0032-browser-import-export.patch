@@ -0,0 +1,197 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_profile_readers.h"
+#include <algorithm>
+#include <set>
+#include <utility>
+#include "base/files/file_util.h"
+#include "base/functional/callback_helpers.h"
+#include "base/json/json_reader.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/ui/aux/browser_profile_snapshot.h"
+#include "components/bookmarks/browser/bookmark_codec.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/download/public/common/download_interrupt_reasons.h"
+#include "components/history/core/browser/history_database.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "components/password_manager/core/browser/password_store/login_database.h"
+#include "components/password_manager/core/browser/sync/password_store_sync.h"
+#include "components/sessions/core/command_storage_backend.h"
+#include "components/sessions/core/command_storage_manager.h"
+#include "components/sessions/core/session_constants.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/sessions/core/session_types.h"
+
+namespace aux {
+namespace {
+bool SafeUrl(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() &&
+      !url.has_username() && !url.has_password() && url.spec().size() <= 8192;
+}
+
+base::expected<ImportedProfileBookmark, std::string> ProjectBookmark(
+    const bookmarks::BookmarkNode& node, size_t depth, size_t& count) {
+  if (depth > 64 || ++count > 100000)
+    return base::unexpected("This bookmark tree exceeds the safe import size.");
+  ImportedProfileBookmark result{node.GetTitle().substr(0, 1000), GURL(), {}};
+  if (node.is_url()) {
+    if (!SafeUrl(node.url()))
+      return base::unexpected("This bookmark has a private or unsupported URL.");
+    result.url = node.url();
+  } else {
+    for (const auto& child : node.children()) {
+      // Internal browser URLs and credential-bearing URLs cannot leave the
+      // original Profile. Keep folders and the safe web bookmarks they contain.
+      if (child->is_url() && !SafeUrl(child->url())) continue;
+      auto projected = ProjectBookmark(*child, depth + 1, count);
+      if (!projected.has_value()) return base::unexpected(projected.error());
+      result.children.push_back(std::move(*projected));
+    }
+  }
+  return result;
+}
+}
+base::expected<std::vector<ImportedProfileBookmark>, std::string>
+ReadProfileBookmarks(const BrowserProfileSnapshot& snapshot) {
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original bookmark store changed.");
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(snapshot.path().AppendASCII("Bookmarks"),
+                                       &json, 64 * 1024 * 1024))
+    return base::unexpected("The copied bookmark store is unreadable or too large.");
+  auto encoded = base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!encoded) return base::unexpected("The copied bookmark store is malformed.");
+  auto bar = bookmarks::BookmarkPermanentNode::CreateBookmarkBar(1, false);
+  auto other = bookmarks::BookmarkPermanentNode::CreateOtherBookmarks(2, false);
+  auto mobile = bookmarks::BookmarkPermanentNode::CreateMobileBookmarks(3, false);
+  bookmarks::BookmarkCodec codec;
+  int64_t max_id = 3;
+  std::string sync_metadata;
+  if (!codec.Decode(*encoded, {1, 2, 3}, bar.get(), other.get(), mobile.get(),
+                    &max_id, &sync_metadata))
+    return base::unexpected("Chromium could not decode the copied bookmarks.");
+  std::vector<ImportedProfileBookmark> results;
+  size_t count = 0;
+  for (const auto* root : {bar.get(), other.get(), mobile.get()}) {
+    auto projected = ProjectBookmark(*root, 0, count);
+    if (!projected.has_value()) return base::unexpected(projected.error());
+    results.push_back(std::move(*projected));
+  }
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original bookmark store changed.");
+  return results;
+}
+
+base::expected<std::vector<ImportedProfileHistory>, std::string>
+ReadProfileHistory(const BrowserProfileSnapshot& snapshot) {
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original history store changed.");
+  // HistoryDatabase may migrate its database. Its only path is the disposable
+  // immutable-source copy, never the original browser's History file.
+  const auto history_size = base::GetFileSize(snapshot.path().AppendASCII("History"));
+  if (!history_size || *history_size <= 0)
+    return base::unexpected("The copied history store is missing or empty.");
+  history::HistoryDatabase database(download::DOWNLOAD_INTERRUPT_REASON_NONE,
+                                   download::DOWNLOAD_INTERRUPT_REASON_CRASH);
+  if (database.Init(snapshot.path().AppendASCII("History")) != sql::INIT_OK)
+    return base::unexpected("Chromium could not decode the copied history.");
+  history::URLDatabase::URLEnumerator enumerator;
+  if (!database.InitURLEnumeratorForEverything(&enumerator))
+    return base::unexpected("Chromium could not enumerate the copied history.");
+  std::vector<ImportedProfileHistory> results;
+  history::URLRow row;
+  while (enumerator.GetNextURL(&row)) {
+    if (!SafeUrl(row.url()) || row.last_visit().is_null()) continue;
+    if (results.size() == 1000000)
+      return base::unexpected("This history exceeds the safe import size.");
+    results.push_back({row.url(), row.title().substr(0, 1000), row.last_visit()});
+  }
+  if (!enumerator.Succeeded())
+    return base::unexpected("The copied history could not be read completely.");
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original history store changed.");
+  return results;
+}
+base::expected<std::vector<ImportedProfileTab>, std::string> ReadProfileTabs(
+    const BrowserProfileSnapshot& snapshot,
+    scoped_refptr<os_crypt_async::Encryptor> source_encryptor) {
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original browser Profile changed.");
+  const bool encrypted = base::DirectoryExists(
+      snapshot.path().Append(sessions::kEncryptedSessionsDirectory));
+  if (encrypted && (!source_encryptor || !source_encryptor->IsDecryptionAvailable()))
+    return base::unexpected("Allow access to the original browser’s Safe Storage key to import encrypted tabs.");
+  auto backend = base::MakeRefCounted<sessions::CommandStorageBackend>(
+      base::SequencedTaskRunner::GetCurrentDefault(), snapshot.path(),
+      sessions::CommandStorageManager::SessionType::kSessionRestore,
+      encrypted ? source_encryptor : nullptr);
+  auto commands = backend->ReadLastSessionCommands();
+  if (commands.error_reading)
+    return base::unexpected("Chromium could not decode this browser’s session.");
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active = SessionID::InvalidValue();
+  std::string platform_id;
+  std::set<SessionID> discarded;
+  sessions::RestoreSessionFromCommands(commands.commands, &windows, &active,
+                                       &platform_id, &discarded);
+  std::vector<ImportedProfileTab> tabs;
+  for (const auto& window : windows) {
+    for (const auto& tab : window->tabs) {
+      if (tab->navigations.empty()) continue;
+      const auto& navigation = tab->navigations[tab->normalized_navigation_index()];
+      if (!SafeUrl(navigation.virtual_url())) continue;
+      ImportedProfileTab imported{navigation.virtual_url(),
+          navigation.title().substr(0, 1000), window->window_id.id(), tab->pinned};
+      if (tab->group) {
+        for (const auto& group : window->tab_groups) {
+          if (group->id == *tab->group) {
+            imported.group = ImportedTabGroup{group->id.ToString(), group->visual_data};
+            break;
+          }
+        }
+        if (tab->group->is_empty() || !imported.group)
+          return base::unexpected("The saved session has a tab group without its original group metadata.");
+      }
+      tabs.push_back(std::move(imported));
+    }
+  }
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original browser session changed.");
+  return tabs;
+}
+
+base::expected<std::vector<password_manager::StoredCredential>, std::string>
+ReadProfilePasswords(const BrowserProfileSnapshot& snapshot,
+                    scoped_refptr<os_crypt_async::Encryptor> source_encryptor) {
+  if (!snapshot.OriginalIsCurrent() || !source_encryptor ||
+      !source_encryptor->IsDecryptionAvailable())
+    return base::unexpected("Allow access to the original browser’s Safe Storage key to import passwords.");
+  std::vector<password_manager::StoredCredential> all;
+  for (const auto& [filename, account] :
+       {std::pair{"Login Data", false}, std::pair{"Login Data For Account", true}}) {
+    const auto file = snapshot.path().AppendASCII(filename);
+    if (!base::PathExists(file)) continue;
+    const auto size = base::GetFileSize(file);
+    if (!size || *size <= 0)
+      return base::unexpected("The copied password store is empty or unreadable.");
+    password_manager::LoginDatabase database(file,
+        password_manager::IsAccountStore(account),
+        password_manager::LoginDatabase::DeletingUndecryptablePasswordsEnabled(false));
+    if (!database.Init(base::DoNothing(), source_encryptor))
+      return base::unexpected("Chromium could not open the copied password store.");
+    std::vector<password_manager::StoredCredential> credentials;
+    if (database.GetAllLogins(&credentials) !=
+        password_manager::FormRetrievalResult::kSuccess)
+      return base::unexpected("The original browser’s passwords could not all be decrypted.");
+    for (auto& credential : credentials) {
+      if (!credential.blocked_by_user && SafeUrl(credential.url))
+        all.push_back(std::move(credential));
+    }
+  }
+  if (!snapshot.OriginalIsCurrent())
+    return base::unexpected("The original password store changed.");
+  return all;
+}
+
+}  // namespace aux
