+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_terminal.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <array>
+#include <optional>
+#include <vector>
+#include "base/base64.h"
+#include "base/environment.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+namespace aux {
+namespace {
+base::DictValue Fault(const std::string& message) {
+  return base::DictValue().Set("error", base::DictValue().Set("code", "ref_stale").Set("message", message));
+}
+base::DictValue Result(base::DictValue value) { return base::DictValue().Set("result", std::move(value)); }
+struct Termination {
+  bool acknowledged = true;
+  std::optional<int> exit_code;
+};
+Termination KillAndReap(pid_t pid, int fd) {
+  Termination result;
+  if (pid > 0) {
+    kill(-pid, SIGKILL);
+    kill(pid, SIGKILL);
+  }
+  // A session leader's exit can wait for its controlling PTY output to drain.
+  // Disconnect and flush the original master before joining that exit.
+  if (fd >= 0) result.acknowledged = close(fd) == 0;
+  if (pid > 0) {
+    int status = 0;
+    pid_t reaped;
+    do { reaped = waitpid(pid, &status, 0); } while (reaped < 0 && errno == EINTR);
+    result.acknowledged &= reaped == pid;
+    if (reaped == pid)
+      result.exit_code = WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
+  }
+  return result;
+}
+}  // namespace
+NativeTerminal::NativeTerminal(content::WebContents* owner, content::WeakDocumentPtr document,
+    std::string token, base::DictValue session)
+    : content::WebContentsObserver(owner), document_(std::move(document)), token_(std::move(token)), session_(std::move(session)) {}
+NativeTerminal::~NativeTerminal() { Retire(); }
+bool NativeTerminal::Current() const { return document_.AsRenderFrameHostIfValid() && web_contents(); }
+base::DictValue NativeTerminal::Session() const { return session_.Clone(); }
+bool NativeTerminal::Start(const std::string& executable, const std::string& cwd, const std::string& device, const std::string& inode, std::string* error) {
+  if (!Current() || executable.empty() || executable.front() != '/' || cwd.empty() || cwd.front() != '/') { *error = "Original terminal launch is unavailable"; return false; }
+  const int directory = open(cwd.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  struct stat identity{};
+  if (directory < 0 || fstat(directory, &identity) != 0 ||
+      base::NumberToString(static_cast<uint64_t>(identity.st_dev)) != device ||
+      base::NumberToString(static_cast<uint64_t>(identity.st_ino)) != inode) {
+    if (directory >= 0) close(directory);
+    *error = "Original Project directory changed before launch"; return false;
+  }
+  // Pass only the user's terminal environment, never runtime/provider credentials.
+  auto env = base::Environment::Create();
+  std::vector<std::string> values;
+  for (base::cstring_view name : {base::cstring_view("HOME"), base::cstring_view("USER"), base::cstring_view("LOGNAME"), base::cstring_view("SHELL"), base::cstring_view("PATH"), base::cstring_view("LANG"), base::cstring_view("LC_ALL"), base::cstring_view("TMPDIR")}) {
+    auto value = env->GetVar(name);
+    if (value) values.push_back(std::string(name.c_str()) + "=" + *value);
+  }
+  values.push_back("TERM=xterm-256color"); values.push_back("COLORTERM=truecolor");
+  std::vector<char*> environment;
+  for (auto& value : values) environment.push_back(value.data());
+  environment.push_back(nullptr);
+  char* arguments[] = {const_cast<char*>(executable.c_str()), nullptr};
+  winsize size{}; size.ws_col = *session_.FindInt("cols"); size.ws_row = *session_.FindInt("rows");
+  const int descriptor_limit = getdtablesize();
+  master_ = posix_openpt(O_RDWR | O_NOCTTY | O_CLOEXEC);
+  std::array<char, 128> slave_name;
+  int slave = -1;
+  if (master_ >= 0 && grantpt(master_) == 0 && unlockpt(master_) == 0 &&
+      ptsname_r(master_, slave_name.data(), slave_name.size()) == 0) {
+    slave = open(slave_name.data(), O_RDWR | O_NOCTTY | O_CLOEXEC);
+  }
+  if (slave < 0 || ioctl(slave, TIOCSWINSZ, &size) != 0) {
+    if (slave >= 0) close(slave);
+    if (master_ >= 0) close(master_);
+    master_ = -1;
+    close(directory);
+    *error = "Cannot create terminal descriptors"; return false;
+  }
+  pid_ = fork();
+  if (pid_ == 0) {
+    // The forked child does no allocation or Chromium work before exec.
+    if (fchdir(directory) != 0) _exit(126);
+    if (setsid() < 0 || ioctl(slave, TIOCSCTTY, 0) != 0 ||
+        dup2(slave, STDIN_FILENO) < 0 || dup2(slave, STDOUT_FILENO) < 0 ||
+        dup2(slave, STDERR_FILENO) < 0) _exit(126);
+    for (int fd = STDIN_FILENO; fd <= STDERR_FILENO; ++fd)
+      if (fcntl(fd, F_SETFD, 0) != 0) _exit(126);
+    for (int fd = 3; fd < descriptor_limit; ++fd) close(fd);
+    sigset_t empty; sigemptyset(&empty); sigprocmask(SIG_SETMASK, &empty, nullptr);
+    execve(executable.c_str(), arguments, environment.data());
+    _exit(127);
+  }
+  close(slave);
+  close(directory);
+  if (pid_ < 0) { close(master_); master_ = -1; *error = "Cannot create terminal process"; return false; }
+  const int flags = fcntl(master_, F_GETFL);
+  if (flags < 0 || fcntl(master_, F_SETFL, flags | O_NONBLOCK) < 0 || fcntl(master_, F_SETFD, FD_CLOEXEC) < 0) {
+    Retire(); *error = "Cannot configure terminal descriptor"; return false;
+  }
+  return true;
+}
+void NativeTerminal::Flush() {
+  while (master_ >= 0 && !pending_input_.empty()) {
+    const ssize_t count = write(master_, pending_input_.data(), pending_input_.size());
+    if (count > 0) pending_input_.erase(0, count);
+    else if (count < 0 && errno == EINTR) continue;
+    else if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+    else { Retire(); return; }
+  }
+}
+void NativeTerminal::PollExit() {
+  if (pid_ <= 0 || closing_) return;
+  siginfo_t info{};
+  if (waitid(P_PID, pid_, &info, WEXITED | WNOHANG | WNOWAIT) != 0 || !info.si_pid) return;
+  // Reaping and PTY cleanup use the same asynchronous original close ACK.
+  Close(base::BindOnce([](base::DictValue) {}));
+}
+base::DictValue NativeTerminal::Read(uint64_t offset) {
+  if (!Current()) { Retire(); return Fault("Original terminal document retired"); }
+  if (offset == previous_offset_ && !previous_chunk_.empty()) {
+    return Result(base::DictValue().Set("terminalId", *session_.FindString("terminalId")).Set("offset", static_cast<double>(offset))
+      .Set("nextOffset", static_cast<double>(offset_)).Set("data", base::Base64Encode(previous_chunk_)).Set("encoding", "base64").Set("state", *session_.FindString("state")));
+  }
+  if (offset != offset_) return Fault("Terminal output acknowledgement changed");
+  Flush();
+  std::array<char, 65536> chunk;
+  ssize_t count = master_ < 0 ? 0 : read(master_, chunk.data(), chunk.size());
+  if (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR && errno != EIO) { Retire(); return Fault("Terminal output failed"); }
+  previous_offset_ = offset_;
+  previous_chunk_.assign(chunk.data(), count > 0 ? count : 0);
+  offset_ += previous_chunk_.size();
+  PollExit();
+  if (closing_ && closing_->failed) return Fault("Terminal exit has no original reaping acknowledgement");
+  if (count <= 0 && pid_ < 0 && !closing_) session_.Set("state", "closed");
+  auto result = base::DictValue().Set("terminalId", *session_.FindString("terminalId")).Set("offset", static_cast<double>(previous_offset_))
+    .Set("nextOffset", static_cast<double>(offset_)).Set("data", base::Base64Encode(previous_chunk_)).Set("encoding", "base64").Set("state", *session_.FindString("state"));
+  if (*session_.FindString("state") == "closed") result.Set("exitCode", exit_code_);
+  return Result(std::move(result));
+}
+base::DictValue NativeTerminal::Input(uint64_t sequence, const std::string& data) {
+  if (!Current() || pid_ <= 0 || sequence != sequence_ || data.empty() || data.size() > 65536 || pending_input_.size() + data.size() > 65536) return Fault("Terminal input authority or sequence changed");
+  pending_input_ += data; ++sequence_; Flush();
+  if (master_ < 0) return Fault("Terminal input could not be delivered; do not replay it");
+  return Result(base::DictValue().Set("terminalId", *session_.FindString("terminalId")).Set("nextSequence", static_cast<double>(sequence_)));
+}
+base::DictValue NativeTerminal::Resize(int cols, int rows) {
+  if (!Current() || master_ < 0 || cols < 2 || cols > 500 || rows < 1 || rows > 300) return Fault("Terminal resize authority changed");
+  winsize size{}; size.ws_col = cols; size.ws_row = rows;
+  if (ioctl(master_, TIOCSWINSZ, &size) != 0) return Fault("Terminal resize failed");
+  session_.Set("cols", cols); session_.Set("rows", rows);
+  return Result(Session());
+}
+void NativeTerminal::Close(base::OnceCallback<void(base::DictValue)> callback) {
+  if (closing_) {
+    if (closing_->failed) std::move(callback).Run(Fault("Terminal termination has no original reaping acknowledgement"));
+    else closing_->callbacks.push_back(std::move(callback));
+    return;
+  }
+  if (*session_.FindString("state") == "closed") {
+    if (master_ >= 0) close(master_);
+    master_ = -1; previous_chunk_.clear(); pending_input_.clear();
+    std::move(callback).Run(Result(Session())); return;
+  }
+  const pid_t pid = pid_; const int fd = master_;
+  if (pid > 0) { kill(-pid, SIGKILL); kill(pid, SIGKILL); }
+  pid_ = -1; master_ = -1; pending_input_.clear(); session_.Set("state", "closing");
+  closing_ = std::make_shared<CloseState>();
+  closing_->stopped = Session(); closing_->stopped.Set("state", "closed");
+  closing_->callbacks.push_back(std::move(callback));
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&KillAndReap, pid, fd), base::BindOnce(
+          [](base::WeakPtr<NativeTerminal> owner, std::shared_ptr<CloseState> state, Termination result) {
+            const bool acknowledged = result.acknowledged;
+            state->failed = !acknowledged;
+            if (owner && acknowledged) {
+              if (result.exit_code) owner->exit_code_ = *result.exit_code;
+              owner->session_ = state->stopped.Clone(); owner->closing_.reset();
+            }
+            auto callbacks = std::move(state->callbacks);
+            for (auto& callback : callbacks) std::move(callback).Run(acknowledged ? Result(state->stopped.Clone()) : Fault("Terminal termination has no original reaping acknowledgement"));
+          }, weak_factory_.GetWeakPtr(), closing_));
+}
+void NativeTerminal::Retire() {
+  // Fence the original group immediately. Close joins the same eventual reaping ACK.
+  if (pid_ > 0) { kill(-pid_, SIGKILL); kill(pid_, SIGKILL); }
+  Close(base::BindOnce([](base::DictValue) {}));
+}
+void NativeTerminal::PrimaryPageChanged(content::Page&) { Retire(); }
+void NativeTerminal::WebContentsDestroyed() { Retire(); Observe(nullptr); }
+}  // namespace aux
