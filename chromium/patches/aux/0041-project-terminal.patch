+    auto cols = params.FindInt("cols"), rows = params.FindInt("rows");
+    if (params.size() != 4 || !cols || !rows) { fail("Exact terminal dimensions are required"); return; }
+    std::move(callback).Run(session->second->Resize(*cols, *rows)); return;
+  }
+  fail("Unknown terminal method");
+}
