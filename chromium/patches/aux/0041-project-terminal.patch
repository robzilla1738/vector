+        *workspace = params.FindString("workspaceId"), *folder = params.FindString("folderId"), *client = params.FindString("client"), *device = params.FindString("rootDevice"), *inode = params.FindString("rootInode");
+    const auto cols = params.FindInt("cols"), rows = params.FindInt("rows");
