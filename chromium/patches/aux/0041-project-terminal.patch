+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_TERMINAL_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_TERMINAL_H_
+#include <sys/types.h>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/weak_document_ptr.h"
+namespace aux {
+// One terminal's process group and PTY belong to the original WebUI document.
+class NativeTerminal final : public content::WebContentsObserver {
+ public:
+  NativeTerminal(content::WebContents* owner, content::WeakDocumentPtr document,
+                 std::string token, base::DictValue session);
+  ~NativeTerminal() override;
+  bool Start(const std::string& executable, const std::string& cwd, const std::string& device, const std::string& inode, std::string* error);
+  const std::string& token() const { return token_; }
+  bool Current() const;
+  base::DictValue Session() const;
+  base::DictValue Read(uint64_t offset);
+  base::DictValue Input(uint64_t sequence, const std::string& data);
+  base::DictValue Resize(int cols, int rows);
+  // Detaches ownership synchronously, then acknowledges actual child reaping.
+  void Close(base::OnceCallback<void(base::DictValue)> callback);
+  void PrimaryPageChanged(content::Page& page) override;
+  void WebContentsDestroyed() override;
+ private:
+  void Retire();
+  void Flush();
+  void PollExit();
+  content::WeakDocumentPtr document_;
+  std::string token_;
+  base::DictValue session_;
+  pid_t pid_ = -1;
+  int master_ = -1;
+  uint64_t offset_ = 0;
+  uint64_t previous_offset_ = 0;
+  uint64_t sequence_ = 0;
+  std::string previous_chunk_;
+  std::string pending_input_;
+  int exit_code_ = 0;
+  struct CloseState {
+    base::DictValue stopped;
+    bool failed = false;
+    std::vector<base::OnceCallback<void(base::DictValue)>> callbacks;
+  };
+  std::shared_ptr<CloseState> closing_;
+  base::WeakPtrFactory<NativeTerminal> weak_factory_{this};
+};
+}  // namespace aux
+#endif
