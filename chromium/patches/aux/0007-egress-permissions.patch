+
+namespace aux {
+namespace {
+base::AtomicSequenceNumberT<uint64_t> request_ids;
+struct RequestState {
+  base::WeakPtr<EgressController> controller;
+  EgressRequestContext context;
+  network::ResourceRequest request;
+  int original_id = 0;
+  bool cancelled = false;
+};
+struct FactoryState {
+  base::WeakPtr<EgressController> controller;
+  EgressRequestContext context;
+  std::map<int32_t, std::weak_ptr<RequestState>> requests;
+};
+void Check(const std::shared_ptr<RequestState>& state,
+           const net::HttpRequestHeaders& headers,
+           bool final_headers,
+           base::OnceCallback<void(bool)> callback) {
+  if (state->cancelled || !state->controller) {
+    std::move(callback).Run(false);
+    return;
+  }
+  state->controller->Check(
+      state->context, state->request, headers, final_headers,
+      base::BindOnce(
+          [](std::shared_ptr<RequestState> state,
+             base::OnceCallback<void(bool)> done, bool allowed) {
+            std::move(done).Run(allowed && !state->cancelled &&
+                                !!state->controller);
+          },
+          state, std::move(callback)));
+}
+net::HttpRequestHeaders KnownHeaders(const network::ResourceRequest& request) {
+  auto headers = request.headers;
+  headers.MergeFrom(request.cors_exempt_headers);
+  // Native-generated Referer is already known before connecting to the URL.
+  if (!request.referrer.is_empty()) {
+    headers.SetHeader("Referer", request.referrer.spec());
+  }
+  return headers;
+}
+class HeaderClient final : public network::mojom::TrustedHeaderClient {
+ public:
+  HeaderClient(std::shared_ptr<RequestState> state,
+               mojo::PendingRemote<network::mojom::TrustedHeaderClient> target)
+      : state_(std::move(state)), required_target_(!!target) {
+    if (target) {
+      target_.Bind(std::move(target));
+    }
+  }
+  void OnConnected(const GURL& url,
+                   network::mojom::TrustedConnectionInfoPtr connection,
+                   OnConnectedCallback callback) override {
+    if (!state_ || state_->cancelled || url != state_->request.url) {
+      std::move(callback).Run(net::ERR_BLOCKED_BY_CLIENT, std::nullopt);
+      return;
+    }
+    auto reviewed =
+        base::BindOnce(&HeaderClient::AfterConnectionOwners,
+                       weak_factory_.GetWeakPtr(), url, std::move(callback));
+    if (target_) {
+      target_->OnConnected(
+          url, std::move(connection),
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              std::move(reviewed), net::ERR_FAILED, std::nullopt));
+    } else {
+      std::move(reviewed).Run(required_target_ ? net::ERR_FAILED : net::OK,
+                              std::nullopt);
+    }
+  }
+  void OnBeforeSendHeaders(const GURL& url,
+                           const net::HttpRequestHeaders& headers,
+                           OnBeforeSendHeadersCallback callback) override {
+    if (!state_ || state_->cancelled || url != state_->request.url) {
+      std::move(callback).Run(net::ERR_BLOCKED_BY_CLIENT, std::nullopt,
+                              std::nullopt, std::nullopt);
+      return;
+    }
+    if (target_) {
+      target_->OnBeforeSendHeaders(
+          url, headers,
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&HeaderClient::AfterMutations,
+                             weak_factory_.GetWeakPtr(), headers,
+                             std::move(callback)),
+              net::ERR_FAILED, std::nullopt, std::nullopt, std::nullopt));
+    } else if (required_target_) {
+      std::move(callback).Run(net::ERR_FAILED, std::nullopt, std::nullopt,
+                              std::nullopt);
+    } else {
+      AfterMutations(headers, std::move(callback), net::OK, std::nullopt,
+                     std::nullopt, std::nullopt);
+    }
+  }
+  void OnHeadersReceived(const std::string& headers,
+                         const net::IPEndPoint& endpoint,
+                         const std::optional<net::SSLInfo>& info,
+                         OnHeadersReceivedCallback callback) override {
+    if (target_) {
+      target_->OnHeadersReceived(headers, endpoint, info,
+                                 mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                                     std::move(callback), net::ERR_FAILED,
+                                     std::nullopt, std::nullopt));
+    } else {
+      std::move(callback).Run(required_target_ ? net::ERR_FAILED : net::OK,
+                              std::nullopt, std::nullopt);
+    }
+  }
+
+ private:
+  void AfterConnectionOwners(
+      GURL url,
+      OnConnectedCallback callback,
+      int32_t result,
+      const std::optional<GURL>& native_policy_redirect) {
+    if (result != net::OK || !state_ || state_->cancelled ||
+        url != state_->request.url) {
+      std::move(callback).Run(
+          result == net::OK ? net::ERR_BLOCKED_BY_CLIENT : result,
+          state_ && !state_->cancelled && url == state_->request.url
+              ? native_policy_redirect
+              : std::nullopt);
+      return;
+    }
+    // Re-admit the exact final header envelope, rather than granting authority
+    // from DNS metadata. Check retains original controller/source retirement.
+    Check(state_, final_headers_, true,
+          base::BindOnce(
+              [](OnConnectedCallback callback, bool allowed) {
+                std::move(callback).Run(
+                    allowed ? net::OK : net::ERR_BLOCKED_BY_CLIENT,
+                    std::nullopt);
+              },
+              std::move(callback)));
+  }
+  void AfterMutations(net::HttpRequestHeaders original,
+                      OnBeforeSendHeadersCallback callback,
+                      int32_t result,
+                      const std::optional<net::HttpRequestHeaders>& modified,
+                      std::optional<base::DictValue> net_log,
+                      const std::optional<GURL>& native_policy_redirect) {
+    if (result != net::OK) {
+      std::move(callback).Run(result, std::nullopt, std::nullopt,
+                              native_policy_redirect);
+      return;
+    }
+    // Snapshot is immutable while consent waits. No other handler sees a chance
+    // to mutate after this final wrapper returns it to the network service.
+    auto final = modified.value_or(original);
+    // Only the CookieStore-selected header from Network Service is ambient
+    // Profile authority. A downstream header client cannot add or replace it.
+    if (state_ && state_->controller &&
+        state_->controller->AllowsProfileCookies(state_->context) &&
+        final.GetHeader("Cookie") != original.GetHeader("Cookie")) {
+      std::move(callback).Run(net::ERR_BLOCKED_BY_CLIENT, std::nullopt,
+                              std::nullopt, std::nullopt);
+      return;
+    }
+    final_headers_ = final;
+    Check(state_, final, true,
+          base::BindOnce(
+              [](net::HttpRequestHeaders final,
+                 std::optional<base::DictValue> net_log,
+                 OnBeforeSendHeadersCallback callback, bool allowed) {
+                if (!allowed) {
+                  std::move(callback).Run(net::ERR_BLOCKED_BY_CLIENT,
+                                          std::nullopt, std::nullopt,
+                                          std::nullopt);
+                  return;
+                }
+                std::move(callback).Run(net::OK, std::move(final),
+                                        std::move(net_log), std::nullopt);
+              },
+              std::move(final), std::move(net_log), std::move(callback)));
+  }
+  net::HttpRequestHeaders final_headers_;
+  std::shared_ptr<RequestState> state_;
+  const bool required_target_;
+  mojo::Remote<network::mojom::TrustedHeaderClient> target_;
+  base::WeakPtrFactory<HeaderClient> weak_factory_{this};
+};
+class FactoryHeaderClient final
+    : public network::mojom::TrustedURLLoaderHeaderClient {
+ public:
+  FactoryHeaderClient(
+      std::shared_ptr<FactoryState> state,
+      mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient> target)
+      : state_(std::move(state)) {
+    if (target) {
+      target_.Bind(std::move(target));
+    }
+  }
+  void OnLoaderCreated(
+      int32_t id,
+      mojo::PendingReceiver<network::mojom::TrustedHeaderClient> receiver)
+      override {
+    auto it = state_->requests.find(id);
+    auto request = it == state_->requests.end() ? nullptr : it->second.lock();
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> target;
+    if (target_ && request) {
+      target_->OnLoaderCreated(request->original_id,
+                               target.InitWithNewPipeAndPassReceiver());
+    }
+    // Missing/unknown request provenance gets a denying HeaderClient.
+    mojo::MakeSelfOwnedReceiver(
+        std::make_unique<HeaderClient>(std::move(request), std::move(target)),
+        std::move(receiver));
+  }
+  void OnLoaderForCorsPreflightCreated(
+      const network::ResourceRequest& request,
+      mojo::PendingReceiver<network::mojom::TrustedHeaderClient> receiver)
+      override {
+    auto state = std::make_shared<RequestState>();
+    state->controller = state_->controller;
+    state->context = state_->context;
+    state->request = request;
+    if (state->controller && state->controller->IsProtected(state->context)) {
+      // Caller-supplied and browser-bonus cookies never acquire session
+      // authority. Network Service selects ambient cookies from CookieStore.
+      state->request.headers.RemoveHeader("Cookie");
+      state->request.cors_exempt_headers.RemoveHeader("Cookie");
+      if (state->request.trusted_params) {
+        state->request.trusted_params->allow_cookies_from_browser = false;
+      }
+    }
+    // OPTIONS has its own complete final header check and exact recipient
+    // approval. It cannot reuse its parent POST's future consent.
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> target;
+    if (target_) {
+      target_->OnLoaderForCorsPreflightCreated(
+          request, target.InitWithNewPipeAndPassReceiver());
+    }
+    mojo::MakeSelfOwnedReceiver(
+        std::make_unique<HeaderClient>(std::move(state), std::move(target)),
+        std::move(receiver));
+  }
+
+ private:
+  std::shared_ptr<FactoryState> state_;
+  mojo::Remote<network::mojom::TrustedURLLoaderHeaderClient> target_;
+};
+class GuardedRequest final : public network::mojom::URLLoader,
+                             public network::mojom::URLLoaderClient {
+ public:
+  GuardedRequest(std::shared_ptr<RequestState> state,
+                 mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+                 mojo::PendingRemote<network::mojom::URLLoaderClient> client)
+      : state_(std::move(state)),
+        client_(std::move(client)),
+        receiver_(this, std::move(receiver)) {
+    receiver_.set_disconnect_handler(
+        base::BindOnce(&GuardedRequest::Cancel, base::Unretained(this)));
+    if (state_->controller) {
+      subscription_ = state_->controller->ObserveAuthority(base::BindRepeating(
+          &GuardedRequest::Revalidate, weak_factory_.GetWeakPtr()));
+    }
+  }
+  ~GuardedRequest() override { state_->cancelled = true; }
+  mojo::PendingReceiver<network::mojom::URLLoader> BindLoader() {
+    return target_.BindNewPipeAndPassReceiver();
+  }
+  base::WeakPtr<GuardedRequest> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+  void Fail() {
+    Complete(network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+  }
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams updates,
+                      const std::optional<GURL>& new_url) override {
+    if (!redirect_ || following_ || state_->cancelled) {
+      Fail();
+      return;
+    }
+    following_ = true;
+    if (state_->controller && state_->controller->IsProtected(state_->context)) {
+      updates.modified_headers.RemoveHeader("Cookie");
+      updates.modified_cors_exempt_headers.RemoveHeader("Cookie");
+      updates.removed_headers.push_back("Cookie");
+    }
+    auto next = *redirect_;
+    if (new_url) {
+      next.new_url = *new_url;
+    }
+    bool clear = false;
+    net::RedirectUtil::UpdateHttpRequest(
+        state_->request.url, state_->request.method, next,
+        updates.removed_headers, updates.modified_headers,
+        &state_->request.headers, &clear);
+    updates.Apply(state_->request.headers, state_->request.cors_exempt_headers);
+    if (clear) {
+      state_->request.request_body = nullptr;
+    }
+    state_->request.UpdateOnRedirect(next);
+    state_->context.kind = "redirect";
+    // Every actual replacement URL and header/body mutation is checked here,
+    // before the target loader may follow or start DNS/connection for this hop.
+    Check(state_, KnownHeaders(state_->request), false,
+          base::BindOnce(&GuardedRequest::FollowChecked,
+                         weak_factory_.GetWeakPtr(), std::move(updates),
+                         new_url));
+  }
+  void SetPriority(net::RequestPriority priority, int32_t intra) override {
+    if (!terminal_ && target_) {
+      target_->SetPriority(priority, intra);
+    }
+  }
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr hints) override {
+    if (!terminal_) client_->OnReceiveEarlyHints(std::move(hints));
+  }
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> metadata) override {
+    if (!terminal_) {
+      client_->OnReceiveResponse(std::move(head), std::move(body),
+                                 std::move(metadata));
+    }
+  }
+  void OnReceiveRedirect(const net::RedirectInfo& info,
+                         network::mojom::URLResponseHeadPtr head) override {
+    if (!terminal_) {
+      redirect_ = info;
+      client_->OnReceiveRedirect(info, std::move(head));
+    }
+  }
+  void OnUploadProgress(int64_t position,
+                        int64_t total,
+                        OnUploadProgressCallback callback) override {
+    if (terminal_) {
+      std::move(callback).Run();
+    } else {
+      client_->OnUploadProgress(position, total, std::move(callback));
+    }
+  }
+  void OnTransferSizeUpdated(int32_t diff) override {
+    if (!terminal_) client_->OnTransferSizeUpdated(diff);
+  }
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    Complete(status);
+  }
+
+ private:
+  void Complete(const network::URLLoaderCompletionStatus& status) {
+    if (terminal_) return;
+    // Revocation can race a queued upstream completion. The client must see
+    // exactly one terminal message, with authority closed before delivery.
+    terminal_ = true;
+    state_->cancelled = true;
+    weak_factory_.InvalidateWeakPtrs();
+    target_.reset();
+    if (client_) client_->OnComplete(status);
+  }
+  void FollowChecked(network::HttpRequestHeadersUpdateParams updates,
+                     std::optional<GURL> url,
+                     bool allowed) {
+    if (terminal_) return;
+    if (!allowed || !target_) {
+      Fail();
+      return;
+    }
+    following_ = false;
+    redirect_.reset();
+    target_->FollowRedirect(std::move(updates), url);
+  }
+  void Revalidate() {
+    if (!terminal_ && (!state_->controller ||
+                       !state_->controller->MayContinue(state_->context))) {
+      Fail();
+    }
+  }
+  void Cancel() {
+    if (terminal_) return;
+    terminal_ = true;
+    state_->cancelled = true;
+    weak_factory_.InvalidateWeakPtrs();
+    target_.reset();
+    client_.reset();
+  }
+  std::shared_ptr<RequestState> state_;
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  mojo::Receiver<network::mojom::URLLoader> receiver_;
+  mojo::Remote<network::mojom::URLLoader> target_;
+  std::optional<net::RedirectInfo> redirect_;
+  bool following_ = false;
+  bool terminal_ = false;
+  base::CallbackListSubscription subscription_;
+  base::WeakPtrFactory<GuardedRequest> weak_factory_{this};
+};
+class GuardedFactory final : public network::SelfDeletingURLLoaderFactory {
+ public:
+  GuardedFactory(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target,
+      std::shared_ptr<FactoryState> state,
+      base::SelfDeletingPassKey key)
+      : network::SelfDeletingURLLoaderFactory(std::move(receiver), key),
+        state_(std::move(state)),
+        target_(std::move(target)) {
+    target_.set_disconnect_handler(
+        base::BindOnce(&GuardedFactory::TargetLost, base::Unretained(this)));
+  }
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> receiver,
+      int32_t id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& annotation) override {
+    std::erase_if(state_->requests,
+                  [](const auto& item) { return item.second.expired(); });
+    if (state_->requests.size() >= 4096) {
+      mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+          ->OnComplete(
+              network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+    auto state = std::make_shared<RequestState>();
+    state->controller = state_->controller;
+    state->context = state_->context;
+    state->request = request;
+    state->original_id = id;
+    if (state->controller && state->controller->IsProtected(state->context)) {
+      state->request.headers.RemoveHeader("Cookie");
+      state->request.cors_exempt_headers.RemoveHeader("Cookie");
+      if (state->request.trusted_params)
+        state->request.trusted_params->allow_cookies_from_browser = false;
+    }
+    if (request.request_body && state->controller &&
+        std::ranges::any_of(*request.request_body->elements(),
+                            [](const auto& element) {
+                              return element.type() !=
+                                     network::DataElement::Tag::kBytes;
+                            }) &&
+        !state->controller->AllowUninspectable(
+            state->context.document.AsRenderFrameHostIfValid(),
+            "streaming-upload")) {
+      mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
+          ->OnComplete(
+              network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+    const uint64_t sequence = request_ids.GetNext();
+    if (sequence >=
+        static_cast<uint64_t>(std::numeric_limits<int32_t>::max())) {
+      return;
+    }
+    const int32_t native_id = static_cast<int32_t>(sequence + 1);
+    state_->requests[native_id] = state;
+    auto guard = std::make_unique<GuardedRequest>(state, std::move(receiver),
+                                                  std::move(client));
+    auto weak = guard->GetWeakPtr();
+    auto loader = guard->BindLoader();
+    mojo::PendingRemote<network::mojom::URLLoaderClient> target_client;
+    mojo::MakeSelfOwnedReceiver(std::move(guard),
+                                target_client.InitWithNewPipeAndPassReceiver());
+    Check(state, KnownHeaders(state->request), false,
+          base::BindOnce(&GuardedFactory::StartChecked,
+                         weak_factory_.GetWeakPtr(), weak, std::move(loader),
+                         native_id, options, state->request, std::move(target_client),
+                         annotation));
+  }
+
+ private:
+  ~GuardedFactory() override = default;
+  void TargetLost() { DisconnectReceiversAndDestroy(); }
+  void StartChecked(base::WeakPtr<GuardedRequest> guard,
+                    mojo::PendingReceiver<network::mojom::URLLoader> loader,
+                    int32_t id,
+                    uint32_t options,
+                    network::ResourceRequest request,
+                    mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+                    net::MutableNetworkTrafficAnnotationTag annotation,
+                    bool allowed) {
+    if (!guard) {
+      return;
+    }
+    if (!allowed || !target_) {
+      guard->Fail();
+      return;
+    }
+    if (state_->controller && state_->controller->IsProtected(state_->context)) {
+      // Session pages use only the original Profile's ambient CookieStore;
+      // private and other protected pages retain the empty-cookie transport.
+      if (!state_->controller->AllowsProfileCookies(state_->context))
+        options |= network::mojom::kURLLoadOptionBlockAllCookies;
+      request.headers.RemoveHeader("Cookie");
+      request.cors_exempt_headers.RemoveHeader("Cookie");
+      if (request.trusted_params) {
+        request.trusted_params->allow_cookies_from_browser = false;
+      }
+      if (auto it = state_->requests.find(id); it != state_->requests.end()) {
+        if (auto pending = it->second.lock()) pending->request = request;
+      }
+    }
+    target_->CreateLoaderAndStart(
+        std::move(loader), id,
+        options | network::mojom::kURLLoadOptionUseHeaderClient,
+        request,
+        std::move(client), annotation);
+  }
+  std::shared_ptr<FactoryState> state_;
+  mojo::Remote<network::mojom::URLLoaderFactory> target_;
+  base::WeakPtrFactory<GuardedFactory> weak_factory_{this};
+};
+}  // namespace
+void EgressController::ProxyFactory(
+    Profile* profile,
+    content::RenderFrameHost* frame,
+    bool navigation,
+    bool worker,
+    network::URLLoaderFactoryBuilder& builder,
+    mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient>*
+        header_client) {
+  auto* controller = ForProfile(profile);
+  if (!controller || !header_client) {
+    return;
+  }
+  auto state = std::make_shared<FactoryState>();
+  state->controller = controller->GetWeakPtr();
+  state->context.kind = navigation ? "navigation"
+                        : worker   ? "worker"
+                                   : "subresource";
+  auto* page =
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  // Navigation is initiated by the current document, whereas a committed
+  // document factory must retain its own document (even during pending commit).
+  auto* document =
+      page ? (navigation ? page->GetPrimaryMainFrame() : frame->GetMainFrame())
+           : nullptr;
+  if (document) {
+    state->context.document = document->GetWeakDocumentPtr();
+    state->context.page_id = PageIdentity::GetOrCreate(profile, page);
+  } else {
+    state->context.ambiguous = true;
+  }
+  auto target_headers = std::move(*header_client);
+  mojo::MakeSelfOwnedReceiver(
+      std::make_unique<FactoryHeaderClient>(state, std::move(target_headers)),
+      header_client->InitWithNewPipeAndPassReceiver());
+  auto [receiver, target] = builder.Append();
+  base::MakeSelfDeleting<GuardedFactory>(std::move(receiver), std::move(target),
+                                         std::move(state));
+}
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/owner_mutation_fence.cc b/chrome/browser/ui/aux/owner_mutation_fence.cc
