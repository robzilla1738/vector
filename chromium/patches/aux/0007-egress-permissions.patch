@@ -0,0 +1,29 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/owner_mutation_fence.h"
+
+#include <limits>
+#include <utility>
+#include "base/unguessable_token.h"
+
+namespace aux {
+OwnerMutationFence::OwnerMutationFence() = default;
+OwnerMutationFence::~OwnerMutationFence() = default;
+std::optional<std::string> OwnerMutationFence::Begin() {
+  if (pending_.size() >= 256 || failure_epoch_ == std::numeric_limits<uint64_t>::max())
+    return std::nullopt;
+  auto token = base::UnguessableToken::Create().ToString();
+  pending_.insert(token);
+  observers_.Notify();
+  return token;
+}
+bool OwnerMutationFence::End(const std::string& token, bool success) {
+  if (!pending_.erase(token)) return false;
+  if (!success && failure_epoch_ != std::numeric_limits<uint64_t>::max())
+    ++failure_epoch_;
+  observers_.Notify();
+  return true;
+}
+base::CallbackListSubscription OwnerMutationFence::Observe(base::RepeatingClosure callback) {
+  return observers_.Add(std::move(callback));
+}
+}  // namespace aux
