+  if (value.empty()) return "none";
+  value.resize(std::min(value.size(), size_t{128}));
+  for (char& ch : value) {
+    if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+          (ch >= '0' && ch <= '9') || ch == ':' || ch == '-')) ch = '_';
