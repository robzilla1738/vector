index 0000000..6cb3416
--- /dev/null
+++ b/chrome/browser/ui/aux/egress_projection.cc
@@ -0,0 +1,271 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/egress_projection.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "crypto/sha2.h"
+#include "net/http/http_request_headers.h"
+#include "services/network/public/cpp/data_element.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/resource_request_body.h"
+#include "third_party/icu/source/common/unicode/locid.h"
+#include "third_party/icu/source/common/unicode/normalizer2.h"
+#include "third_party/icu/source/common/unicode/uchar.h"
+#include "third_party/icu/source/common/unicode/unistr.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+constexpr size_t kBodyBound = 65536;
+bool JSWhitespace(char16_t c) {
+  return (c >= 9 && c <= 13) || c == 0x20 || c == 0xa0 || c == 0x1680 ||
+         (c >= 0x2000 && c <= 0x200a) || c == 0x2028 || c == 0x2029 ||
+         c == 0x202f || c == 0x205f || c == 0x3000 || c == 0xfeff;
+}
+std::optional<std::string> PercentDecode(std::string_view value) {
+  std::string output;
+  for (size_t i = 0; i < value.size(); ++i) {
+    if (value[i] == '+') {
+      output.push_back(' ');
+    } else if (value[i] != '%') {
+      output.push_back(value[i]);
+    } else {
+      int decoded = 0;
+      if (i + 2 >= value.size() ||
+          !base::HexStringToInt(value.substr(i + 1, 2), &decoded)) {
+        return std::nullopt;
+      }
+      output.push_back(static_cast<char>(decoded));
+      i += 2;
+    }
+  }
+  return base::IsStringUTF8(output) ? std::make_optional(output) : std::nullopt;
+}
+bool Base64Char(char c) {
+  return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '+' ||
+         c == '/' || c == '_' || c == '-';
+}
+std::vector<std::string> Variants(const std::string& value) {
+  std::vector<std::string> result{value};
+  for (int i = 0; i < 2; ++i) {
+    auto decoded = PercentDecode(result.back());
+    if (!decoded) {
+      break;
+    }
+    result.push_back(std::move(*decoded));
+  }
+  const size_t encoded_count = result.size();
+  for (size_t i = 0; i < encoded_count; ++i) {
+    const std::string encoded = result[i];
+    for (size_t at = 0; at < encoded.size();) {
+      if (!Base64Char(encoded[at])) {
+        ++at;
+        continue;
+      }
+      size_t end = at;
+      while (end < encoded.size() && Base64Char(encoded[end])) {
+        ++end;
+      }
+      const size_t digits = end - at;
+      while (end < encoded.size() && end - at < digits + 2 &&
+             encoded[end] == '=') {
+        ++end;
+      }
+      if (digits >= 16 && digits % 4 != 1) {
+        std::string candidate = encoded.substr(at, digits);
+        std::replace(candidate.begin(), candidate.end(), '-', '+');
+        std::replace(candidate.begin(), candidate.end(), '_', '/');
+        while (candidate.size() % 4) {
+          candidate += '=';
+        }
+        std::string decoded;
+        if (base::Base64Decode(candidate, &decoded) && decoded.size() >= 12 &&
+            decoded.size() <= kBodyBound && base::IsStringUTF8(decoded)) {
+          result.push_back(std::move(decoded));
+        }
+      }
+      at = end;
+    }
+  }
+  std::sort(result.begin(), result.end());
+  result.erase(std::unique(result.begin(), result.end()), result.end());
+  return result;
+}
+std::set<std::string> Phrases(const std::u16string& value) {
+  std::vector<std::u16string> words;
+  std::u16string word;
+  icu::UnicodeString text(value.data(), static_cast<int32_t>(value.size()));
+  for (int32_t at = 0; at < text.length();) {
+    UChar32 point = text.char32At(at);
+    const int32_t length = U16_LENGTH(point);
+    const auto category = u_charType(point);
+    if ((category >= U_UPPERCASE_LETTER && category <= U_OTHER_LETTER) ||
+        (category >= U_DECIMAL_DIGIT_NUMBER && category <= U_OTHER_NUMBER)) {
+      word.append(value.substr(at, length));
+    } else if (!word.empty()) {
+      words.push_back(std::move(word));
+      word.clear();
+    }
+    at += length;
+  }
+  if (!word.empty()) {
+    words.push_back(std::move(word));
+  }
+  std::set<std::string> result;
+  for (size_t i = 0; i + 4 <= words.size(); ++i) {
+    const auto phrase = words[i] + u" " + words[i + 1] + u" " + words[i + 2] +
+                        u" " + words[i + 3];
+    if (phrase.size() >= 20) {
+      result.insert(EgressHash(base::UTF16ToUTF8(phrase)));
+    }
+  }
+  return result;
+}
+void AppendPart(std::string& digest_input, std::string_view part) {
+  digest_input += base::NumberToString(part.size()) + ":";
+  digest_input.append(part);
+}
+}  // namespace
+std::string EgressHash(std::string_view value) {
+  return base::HexEncodeLower(crypto::SHA256HashString(value));
+}
+std::optional<std::u16string> EgressNormalize(std::string_view value) {
+  if (!base::IsStringUTF8(value)) {
+    return std::nullopt;
+  }
+  UErrorCode status = U_ZERO_ERROR;
+  const auto* normalizer = icu::Normalizer2::getNFKCInstance(status);
+  if (U_FAILURE(status)) {
+    return std::nullopt;
+  }
+  const auto utf16 = base::UTF8ToUTF16(value);
+  icu::UnicodeString normalized;
+  normalizer->normalize(
+      icu::UnicodeString(utf16.data(), static_cast<int32_t>(utf16.size())),
+      normalized, status);
+  if (U_FAILURE(status)) {
+    return std::nullopt;
+  }
+  normalized.toLower(icu::Locale::getRoot());
+  if (normalized.isBogus() || normalized.length() > 262144) {
+    return std::nullopt;
+  }
+  std::u16string result;
+  for (int32_t i = 0; i < normalized.length(); ++i) {
+    const char16_t c = normalized.charAt(i);
+    if (JSWhitespace(c)) {
+      if (result.empty() || result.back() != u' ') {
+        result += u' ';
+      }
+    } else {
+      result += c;
+    }
+  }
+  return result;
+}
+std::set<std::string> EgressWindows(std::u16string_view text, size_t length) {
+  std::set<std::string> result;
+  if (!length) {
+    return result;
+  }
+  for (size_t i = 0; i + length <= text.size(); ++i) {
+    result.insert(EgressHash(base::UTF16ToUTF8(text.substr(i, length))));
+  }
+  return result;
+}
+std::optional<EgressProjection> ProjectEgressRequest(
+    const network::ResourceRequest& request,
+    const net::HttpRequestHeaders& headers,
+    bool final_headers) {
+  if (!request.url.SchemeIsHTTPOrHTTPS() || request.url.has_username() ||
+      request.url.has_password() || request.url.spec().size() > 2048) {
+    return std::nullopt;
+  }
+  std::string body;
+  if (request.request_body) {
+    for (const auto& element : *request.request_body->elements()) {
+      if (element.type() != network::DataElement::Tag::kBytes) {
+        return std::nullopt;
+      }
+      const auto bytes = element.As<network::DataElementBytes>().AsStringView();
+      if (bytes.size() > kBodyBound - body.size()) {
+        return std::nullopt;
+      }
+      body.append(bytes);
+    }
+  }
+  if (!base::IsStringUTF8(body)) {
+    return std::nullopt;
+  }
+  std::vector<std::pair<std::string, std::string>> pairs;
+  size_t header_bytes = 0;
+  for (net::HttpRequestHeaders::Iterator it(headers); it.GetNext();) {
+    header_bytes += it.name().size() + it.value().size() + 4;
+    if (pairs.size() >= 128 || header_bytes > 16384 ||
+        !base::IsStringUTF8(it.name()) || !base::IsStringUTF8(it.value())) {
+      return std::nullopt;
+    }
+    pairs.emplace_back(it.name(), it.value());
+  }
+  std::vector<std::string> fields{request.url.spec(), body};
+  for (const auto& [name, value] : pairs) {
+    fields.push_back(name);
+    fields.push_back(value);
+  }
+  EgressProjection output;
+  output.body_bytes = body.size();
+  std::set<std::string> text_hashes, phrase_hashes;
+  for (const auto& field : fields) {
+    for (const auto& variant : Variants(field)) {
+      auto normalized = EgressNormalize(variant);
+      if (!normalized) {
+        return std::nullopt;
+      }
+      const auto windows = EgressWindows(*normalized, 12);
+      text_hashes.insert(windows.begin(), windows.end());
+      const auto phrases = Phrases(*normalized);
+      phrase_hashes.insert(phrases.begin(), phrases.end());
+      if (text_hashes.size() > 131072 || phrase_hashes.size() > 32768) {
+        return std::nullopt;
+      }
+      output.normalized.push_back(std::move(*normalized));
+    }
+  }
+  const std::string phase = final_headers ? "send" : "preflight";
+  std::string digest_input;
+  for (const auto& part :
+       {std::string("aux-egress-v1"), phase, request.method, request.url.spec(),
+        std::string(final_headers ? "complete" : "partial"),
+        base::NumberToString(pairs.size())}) {
+    AppendPart(digest_input, part);
+  }
+  for (const auto& [name, value] : pairs) {
+    AppendPart(digest_input, base::ToLowerASCII(name));
+    AppendPart(digest_input, value);
+  }
+  AppendPart(digest_input, body);
+  base::ListValue texts, phrases;
+  for (const auto& hash : text_hashes) {
+    texts.Append(hash);
+  }
+  for (const auto& hash : phrase_hashes) {
+    phrases.Append(hash);
+  }
+  output.wire.Set("version", 1);
+  output.wire.Set("phase", phase);
+  output.wire.Set("urlDigest", EgressHash(request.url.spec()));
+  output.wire.Set("requestDigest", EgressHash(digest_input));
+  output.wire.Set("urlBytes", static_cast<int>(request.url.spec().size()));
+  output.wire.Set("headerBytes", static_cast<int>(header_bytes));
+  output.wire.Set("headersComplete", final_headers);
+  output.wire.Set("projectionComplete", true);
+  output.wire.Set("textHashes", std::move(texts));
+  output.wire.Set("phraseHashes", std::move(phrases));
+  return output;
+}
+}  // namespace aux
