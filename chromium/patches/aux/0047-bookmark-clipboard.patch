+void AuxRuntimeHost::CallBookmarkClipboardForUser(
+    const std::string& method,
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback,
+    base::RepeatingCallback<bool()> current) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile_library_) {
+    std::move(callback).Run(
+        NativeFault("forbidden", "Private windows do not persist bookmarks"));
+    return;
+  }
+  profile_library_->BookmarkClipboardCall(method, params, std::move(callback),
+                                          std::move(current));
