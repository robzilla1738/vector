+
+bool ValidClipboardElements(
+    const std::vector<bookmarks::BookmarkNodeData::Element>& elements,
+    size_t depth,
+    size_t& count) {
+  if (depth > 128) {
+    return false;
+  }
+  for (const auto& element : elements) {
+    if (++count > 10000 || (element.is_url && !element.url.is_valid()) ||
+        !ValidClipboardElements(element.children, depth + 1, count)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::DictValue ClipboardNodeState(const bookmarks::BookmarkNode* node) {
+  base::ListValue children;
+  for (const auto& child : node->children()) {
+    children.Append(ClipboardNodeState(child.get()));
+  }
+  base::DictValue meta;
+  if (const auto* values = node->GetMetaInfoMap()) {
+    for (const auto& [key, value] : *values) {
+      meta.Set(key, value);
+    }
+  }
+  return base::DictValue()
+      .Set("id", base::NumberToString(node->id()))
+      .Set("title", base::UTF16ToUTF8(node->GetTitle()))
+      .Set("url", node->url().spec())
+      .Set("meta", std::move(meta))
+      .Set("children", std::move(children));
 }
 
