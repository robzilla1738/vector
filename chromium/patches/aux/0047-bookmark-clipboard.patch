+void ProfileLibrary::BookmarkClipboardCall(
+    const std::string& method,
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback,
+    base::RepeatingCallback<bool()> current) {
+  if (!current.Run() || !bookmarks_ || !bookmarks_->loaded()) {
+    std::move(callback).Run(
+        Fault("ref_stale", "Original bookmark window is unavailable"));
+    return;
+  }
+  if (method == "bookmarks.clipboard.copy") {
+    const auto* node = BookmarkBySource(bookmarks_, params.FindDict("source"));
+    const bool cut = params.FindBool("cut").value_or(false);
+    if (!node || (cut && !profile_->GetPrefs()->GetBoolean(
+                             bookmarks::prefs::kEditBookmarksEnabled))) {
+      std::move(callback).Run(
+          Fault("conflict", "The bookmark changed or cannot be cut."));
+      return;
+    }
+    bookmarks::CopyToClipboard(bookmarks_, {node}, false,
+                               bookmarks::metrics::BookmarkEditSource::kUser,
+                               profile_->IsOffTheRecord());
+    if (cut) {
+      std::move(callback).Run(
+          ChangeBookmark("bookmarks.entries.remove", params));
+    } else {
+      std::move(callback).Run(
+          Result(base::Value(base::DictValue()
+                                 .Set("snapshot", FolderSnapshot())
+                                 .Set("undoToken", base::Value()))));
+    }
+    return;
+  }
+  bookmarks::BookmarkNodeData::ReadFromClipboard(
+      ui::ClipboardBuffer::kCopyPaste,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> owner, std::string method,
+             base::DictValue params, base::RepeatingCallback<bool()> current,
+             base::OnceCallback<void(base::DictValue)> callback,
+             std::unique_ptr<bookmarks::BookmarkNodeData> data) {
+            if (!owner || !current.Run()) {
+              std::move(callback).Run(Fault(
+                  "ref_stale", "Original bookmark window is unavailable"));
+              return;
+            }
+            if (method == "bookmarks.clipboard.available") {
+              std::move(callback).Run(Result(base::Value(base::DictValue().Set(
+                  "available", data && data->is_valid()))));
+              return;
+            }
+            if (!data || !data->is_valid()) {
+              std::move(callback).Run(
+                  Fault("invalid_argument",
+                        "The clipboard does not contain bookmarks or a URL."));
+              return;
+            }
+            if (!owner->profile_->GetPrefs()->GetBoolean(
+                    bookmarks::prefs::kEditBookmarksEnabled)) {
+              std::move(callback).Run(
+                  Fault("forbidden",
+                        "Bookmark editing is managed by your organization"));
+              return;
+            }
+            const auto* destination = params.FindDict("destination");
+            const auto* parent =
+                destination ? FolderById(owner->bookmarks_,
+                                         destination->FindString("parentId"))
+                            : nullptr;
+            const auto* children =
+                destination ? destination->FindList("expectedChildren")
+                            : nullptr;
+            const auto index =
+                destination ? destination->FindInt("index") : std::nullopt;
+            if (!parent || !children || *children != ChildIds(parent) ||
+                !index || *index < 0 ||
+                static_cast<size_t>(*index) > parent->children().size()) {
+              std::move(callback).Run(Fault(
+                  "conflict", "The destination changed. Choose it again."));
+              return;
+            }
+            size_t total = 0;
+            if (!ValidClipboardElements(data->elements, 0, total)) {
+              std::move(callback).Run(Fault("invalid_argument",
+                                            "The clipboard bookmarks are "
+                                            "invalid or too large to paste."));
+              return;
+            }
+            const size_t count = data->elements.size();
+            bookmarks::CloneBookmarkNode(owner->bookmarks_, data->elements,
+                                         parent, *index, true);
+            base::ListValue nodes;
+            for (size_t i = 0; i < count; ++i) {
+              nodes.Append(
+                  ClipboardNodeState(parent->children()[*index + i].get()));
+            }
+            const auto token =
+                base::Uuid::GenerateRandomV4().AsLowercaseString();
+            if (owner->pasted_bookmarks_.size() == 32) {
+              owner->pasted_bookmarks_.pop_front();
+            }
+            owner->pasted_bookmarks_.push_back(
+                base::DictValue()
+                    .Set("token", token)
+                    .Set("parentId", base::NumberToString(parent->id()))
+                    .Set("children", ChildIds(parent))
+                    .Set("nodes", std::move(nodes)));
+            std::move(callback).Run(
+                Result(base::Value(base::DictValue()
+                                       .Set("snapshot", owner->FolderSnapshot())
+                                       .Set("undoToken", token))));
+          },
+          weak_factory_.GetWeakPtr(), method, params.Clone(),
+          std::move(current), std::move(callback)));
+}
