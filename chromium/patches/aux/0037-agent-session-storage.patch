+bool EgressController::GroupAgentPage(content::WebContents* page,
+                                      BrowserWindowInterface* owner) {
+  if (!page || !owner || owner->GetProfile() != profile_) return false;
+  const auto* identity = PageIdentity::FromWebContents(page);
+  const auto* isolation = identity
+      ? IsolationForPage(identity->id(), page->GetPrimaryMainFrame()) : nullptr;
+  auto* model = owner->GetTabStripModel();
+  if (!identity || !identity->runtime_owned() || !isolation ||
+      !RunIntentCurrent(*isolation) || !model || !model->SupportsTabGroups())
+    return false;
+  const int index = model->GetIndexOfWebContents(page);
+  if (index == TabStripModel::kNoTab) return false;
+  const auto run_id = isolation->run_id;
+  const auto isolation_id = isolation->id;
+  const int owner_id = owner->GetSessionID().id();
+  auto original = GetWeakPtr();
+  auto original_page = page->GetWeakPtr();
+  const auto original_document = page->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  auto original_owner = owner->GetWeakPtr();
+  const auto existing = isolation->groups.find(owner_id);
+  const bool reuse = existing != isolation->groups.end() &&
+      model->group_model()->ContainsTabGroup(existing->second);
+  const auto group = reuse ? existing->second : model->AddToNewGroup({index});
+  if (reuse) model->AddToExistingGroup({index}, group, true);
+  // Group notifications may synchronously close or move the original tab.
+  if (!original || !original_page || !original_owner) return false;
+  auto current = isolations_by_run_.find(run_id);
+  auto* current_model = original_owner->GetTabStripModel();
+  const auto* current_identity = PageIdentity::FromWebContents(original_page.get());
+  const int current_index = current_model
+      ? current_model->GetIndexOfWebContents(original_page.get()) : TabStripModel::kNoTab;
+  if (current == isolations_by_run_.end() || current->second->id != isolation_id ||
+      !RunIntentCurrent(*current->second) || !current_identity ||
+      !current_identity->runtime_owned() || current_index == TabStripModel::kNoTab ||
+      !current_model->SupportsTabGroups() ||
+      current_model->GetTabGroupForTab(current_index) != group ||
+      IsolationForPage(current_identity->id(), original_page->GetPrimaryMainFrame()) != current->second.get())
+    return false;
+  const std::string current_page_id = current_identity->id();
+  current->second->groups.insert_or_assign(owner_id, group);
+  if (!reuse) {
+    current_model->group_model()->GetTabGroup(group)->SetVisualData(
+        tab_groups::TabGroupVisualData(u"Agent", tab_groups::TabGroupColorId::kBlue));
+  }
+  if (!original || !original_page || !original_owner ||
+      original_document.AsRenderFrameHostIfValid() != original_page->GetPrimaryMainFrame())
+    return false;
+  auto final = original->isolations_by_run_.find(run_id);
+  auto* final_model = original_owner->GetTabStripModel();
+  const int final_index = final_model ? final_model->GetIndexOfWebContents(original_page.get()) : TabStripModel::kNoTab;
+  return final != original->isolations_by_run_.end() &&
+      final->second->id == isolation_id && original->RunIntentCurrent(*final->second) &&
+      final_index != TabStripModel::kNoTab && final_model->SupportsTabGroups() &&
+      final_model->GetTabGroupForTab(final_index) == group &&
+      original->IsolationForPage(current_page_id, original_document.AsRenderFrameHostIfValid()) == final->second.get();
+}
+bool EgressController::AllowsProfileCookies(const EgressRequestContext& context) const {
+  auto owner = pages_.find(context.page_id);
+  auto* frame = context.document.AsRenderFrameHostIfValid();
+  const auto* isolation = frame ? IsolationForPage(context.page_id, frame) : nullptr;
+  return owner != pages_.end() && isolation && isolation->session &&
+      isolation->config.is_default() && RunIntentCurrent(*isolation) &&
+      Current(context, owner->second->lease);
+}
