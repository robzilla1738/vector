+void WebUIBrowserUI::FocusAuxShell() {
+  // Focusing the native root view alone leaves SurfaceEmbed's child frame tree
+  // owning keyboard input. Release that ownership before dispatching a shortcut.
+  auto* active = browser_->GetTabStripModel()->GetActiveWebContents();
+  if (active) {
+    if (auto* connector = active->GetSurfaceEmbedConnector()) {
+      connector->FocusParentIfChildFocused();
+    }
+  }
+  web_ui()->GetWebContents()->Focus();
+}
