diff --git a/chrome/browser/resources/aux/BUILD.gn b/chrome/browser/resources/aux/BUILD.gn
new file mode 100644
index 0000000..4ba3e8a
--- /dev/null
+++ b/chrome/browser/resources/aux/BUILD.gn
@@ -0,0 +1,70 @@
+# Copyright 2026 The Aux Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//chrome/browser/buildflags.gni")
+import("//chrome/common/features.gni")
+import("//tools/grit/grit_rule.gni")
+import("//ui/webui/resources/tools/generate_grd.gni")
+import("//ui/webui/resources/tools/generate_code_cache.gni")
+import("//ui/webui/webui_features.gni")
+
+assert(enable_aux_shell)
+
+# The local build stages the current renderer and its resource inventory.
+shell_manifest = read_file("assets/manifest.json", "json")
+shell_files = []
+shell_inputs = []
+foreach(asset, shell_manifest.files) {
+  shell_files += [ asset.path ]
+  shell_inputs += [ "assets/${asset.path}" ]
+}
+
+grit("resources") {
+  defines = chrome_grit_defines
+  enable_input_discovery_for_gn_analyze = false
+  source = "$target_gen_dir/resources.grd"
+  inputs = shell_inputs
+  deps = [ ":build_grd" ]
+  outputs = [
+    "grit/aux_resources.h",
+    "grit/aux_resources_map.h",
+    "grit/aux_resources_map.cc",
+    "aux_resources.pak",
+  ]
+  output_dir = "$root_gen_dir/chrome"
+}
+
+generate_grd("build_grd") {
+  grd_prefix = "aux"
+  out_grd = "$target_gen_dir/resources.grd"
+  input_files = shell_files
+  input_files_base_dir = rebase_path("assets", "//")
+}
+
+if (enable_webui_generate_code_cache) {
+  generate_code_cache("build_code_cache") {
+    in_folder = "assets"
+    in_files = filter_include(shell_files, [ "*.js" ])
+    out_folder = "$target_gen_dir/code_cache"
+    out_manifest = "$target_gen_dir/build_code_cache_manifest.json"
+  }
+  generate_grd("build_code_cache_grd") {
+    grd_prefix = "aux_code_cache"
+    out_grd = "$target_gen_dir/code_cache_resources.grd"
+    manifest_files = [ "$target_gen_dir/build_code_cache_manifest.json" ]
+    deps = [ ":build_code_cache" ]
+  }
+  grit("code_cache_resources") {
+    enable_input_discovery_for_gn_analyze = false
+    source = "$target_gen_dir/code_cache_resources.grd"
+    deps = [ ":build_code_cache_grd" ]
+    outputs = [
+      "grit/aux_code_cache_resources.h",
+      "grit/aux_code_cache_resources_map.h",
+      "grit/aux_code_cache_resources_map.cc",
+      "aux_code_cache_resources.pak",
+    ]
+    output_dir = "$root_gen_dir/chrome"
+  }
+}
