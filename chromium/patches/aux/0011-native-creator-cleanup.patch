+void BrowserWebContentsDelegate::BeforeUnloadFiredWithEmbeddingInvocation(
+    content::WebContents* source, bool proceed, bool* proceed_to_fire_unload,
+    base::UnguessableToken invocation,
+    content::WeakDocumentPtr original_document) {
+  *proceed_to_fire_unload = false;
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+  auto* receipt = aux::NativeCreatorCloseReceipt::FromWebContents(source);
+  if (!receipt) return;
+  auto original = receipt->GetWeakPtr();
+  const bool human_close = receipt->OriginalAck(
+      invocation, proceed && original_document.AsRenderFrameHostIfValid() ==
+                                 source->GetPrimaryMainFrame());
+  // The agent remains retired. An accepted ACK for this exact document may
+  // complete the separate queued human close through ordinary unload handling.
+  if (human_close && proceed && original &&
+      original_document.AsRenderFrameHostIfValid() == source->GetPrimaryMainFrame()) {
+    unload_controller_->BeforeUnloadFired(source, proceed, proceed_to_fire_unload);
+    return;
+  }
+  if (!original || invocation.is_empty() ||
+      original_document.AsRenderFrameHostIfValid() != source->GetPrimaryMainFrame() ||
+      !original->MayContinue(invocation)) {
+    if (original) original->Refuse(invocation);
+    return;
+  }
+  auto contents = source->GetWeakPtr();
+  unload_controller_->BeforeUnloadFired(source, proceed, proceed_to_fire_unload);
+  if (!contents || !original) { *proceed_to_fire_unload = false; return; }
+  if (original_document.AsRenderFrameHostIfValid() != source->GetPrimaryMainFrame() ||
+      !original->MayContinue(invocation)) {
+    *proceed_to_fire_unload = false;
+    return;
+  }
+  if (*proceed_to_fire_unload) original->AwaitOriginalAck(invocation);
+  else original->Refuse(invocation);
+#endif
+}
