+void BrowserWebContentsDelegate::CloseContentsWithEmbeddingInvocation(
+    content::WebContents* source, base::UnguessableToken invocation,
+    content::WeakDocumentPtr original_document) {
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+  auto* receipt = aux::NativeCreatorCloseReceipt::FromWebContents(source);
+  if (!receipt) return;
+  auto original = receipt->GetWeakPtr();
+  receipt->OriginalAck(invocation);
+  if (!original || invocation.is_empty() ||
+      original_document.AsRenderFrameHostIfValid() != source->GetPrimaryMainFrame() ||
+      !original->MayContinue(invocation)) return;
+  auto contents = source->GetWeakPtr();
+  if (!unload_controller_->CanCloseContents(source) || !contents || !original ||
+      original_document.AsRenderFrameHostIfValid() != source->GetPrimaryMainFrame() ||
+      !original->MayContinue(invocation)) return;
+  auto* close_data = TabCloseTypesData::FromWebContents(source);
+  const uint32_t types = close_data ? close_data->close_types() : TabCloseTypes::CLOSE_NONE;
+  browser_->GetTabStripModel()->CloseWebContentsForCreatorCleanup(
+      source, types, invocation);
+#endif
+}
