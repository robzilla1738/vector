+      [](base::WeakPtr<AuxRuntimeHost> host, std::string token,
+         uint64_t generation, std::string claim, base::FilePath root,
+         base::ScopedClosureRunner release,
+         base::OnceCallback<void(Response, base::FilePath,
+                                 base::ScopedClosureRunner)> callback,
+         Response response) {
+        if (!host || !host->RemoteDebuggingOwnerCurrent(token, generation)) {
+          response = {false, "", "ref_stale",
+                      "Original export window is unavailable"};
+        }
+        if (response.ok) {
+          auto data = base::JSONReader::ReadDict(response.result_json,
+                                                base::JSON_PARSE_RFC);
+          const auto* returned_claim = data ? data->FindString("claimId") : nullptr;
+          if (data && data->contains("claimId") &&
+              (!returned_claim || *returned_claim != claim)) {
+            response = {false, "", "ref_stale", "Original export claim changed"};
+          }
+        }
+        std::move(callback).Run(std::move(response), std::move(root),
+                                std::move(release));
+      }, weak_factory_.GetWeakPtr(), *token, generation, claim, std::move(root),
