+void AuxRuntimeHost::ExportArtifactFromWindow(
+    base::WeakPtr<BrowserWindowInterface> window,
+    content::WeakDocumentPtr document, std::string artifact_id,
+    base::OnceCallback<void(Response, base::FilePath,
+                            base::ScopedClosureRunner)> callback) {
+  auto token = RegisterTurnContext(std::move(window), std::move(document));
+  if (!token.has_value()) {
+    std::move(callback).Run(std::move(token.error()), {}, {});
+    return;
+  }
+  const auto generation = admitted_native_generation_;
+  base::FilePath root = profile_->IsOffTheRecord()
+      ? (private_runtime_directory_ ? private_runtime_directory_->GetPath()
+                                    : base::FilePath())
+      : profile_->GetPath();
+  if (root.empty()) {
+    std::move(callback).Run(
+        {false, "", "ref_stale", "Original artifact storage is unavailable"},
+        {}, {});
+    return;
+  }
+  root = root.Append("Aux Runtime Data").Append("artifacts");
+  const auto claim = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::DictValue request;
+  request.Set("artifactId", std::move(artifact_id));
+  request.Set("token", *token);
+  request.Set("claimId", claim);
+  const auto json = *base::WriteJson(request);
+  base::ScopedClosureRunner release(base::BindOnce(
+      [](base::WeakPtr<AuxRuntimeHost> host, uint64_t generation,
+         std::string request) {
+        // A retired document may release its own claim, but never a new worker's.
+        if (host && host->DeviceConfirmationConnectionCurrent(generation)) {
+          host->CallInternal("artifact.exportRelease", std::move(request),
+                             base::DoNothing());
+        }
+      }, weak_factory_.GetWeakPtr(), generation, json));
