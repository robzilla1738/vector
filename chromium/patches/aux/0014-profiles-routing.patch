+constexpr char kRouterKey[] = "aux.link_router";
+constexpr size_t kCapacity = 128;
+std::string Id(Profile* profile) {
+  const auto directory = profile->GetPath().BaseName().AsUTF8Unsafe();
+  return directory == "Default" ? "default" : directory;
+}
+std::string WindowId(BrowserWindowInterface* window) { return base::NumberToString(window->GetSessionID().id()); }
+bool Eligible(BrowserWindowInterface* window, Profile* profile) {
+  return window && window->GetProfile() == profile && !profile->IsOffTheRecord() &&
+      window->GetType() == BrowserWindowInterface::TYPE_NORMAL && !IsQuickAskWindow(window);
+}
+bool WebUrl(const GURL& url) { return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && !url.has_username() && !url.has_password() && url.spec().size() <= 8192; }
+ProfileAttributesEntry* Entry(std::string_view id) {
+  if (!g_browser_process || !g_browser_process->profile_manager()) return nullptr;
+  const auto& entries = g_browser_process->profile_manager()->GetProfileAttributesStorage().GetAllProfilesAttributes();
+  for (auto* entry : entries) {
+    const std::string directory = entry->GetPath().BaseName().AsUTF8Unsafe();
+    if ((id == "default" ? directory == "Default" : directory == id) &&
+        !entry->IsOmitted() && !entry->IsEphemeral() &&
+        directory != "Guest Profile" && directory != "System Profile") return entry;
+  }
+  return nullptr;
+}
+bool Available(std::string_view id) {
+  auto* entry = Entry(id);
+  return entry && !entry->IsSigninRequired() &&
+      !g_browser_process->local_state()->GetDict(kArchivedProfilesPref).FindBool(id).value_or(false);
+}
+bool SpaceAvailable(std::string_view profile, std::string_view space) {
+  const auto* spaces = g_browser_process->local_state()->GetDict(kProfileSpacesIndexPref).FindList(profile);
+  return spaces && std::ranges::any_of(*spaces, [space](const base::Value& value) { return value.is_dict() && value.GetDict().FindString("id") && *value.GetDict().FindString("id") == space; });
+}
+std::string LastProfile() {
+  const auto directory = g_browser_process->local_state()->GetString("profile.last_used");
+  return directory == "Default" ? "default" : directory;
+}
