diff --git a/chrome/browser/ui/aux/profile_search_engine.cc b/chrome/browser/ui/aux/profile_search_engine.cc
new file mode 100644
index 0000000..5edda68
--- /dev/null
+++ b/chrome/browser/ui/aux/profile_search_engine.cc
@@ -0,0 +1,185 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/profile_search_engine.h"
+
+#include <memory>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_data.h"
+#include "components/search_engines/template_url_service.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+
+constexpr char kSearchToken[] = "auxuniquesearchtermplaceholder";
+
+TemplateURLService* Service(Profile* profile) {
+  return profile ? TemplateURLServiceFactory::GetForProfile(profile) : nullptr;
+}
+
+std::string ReplaceAll(std::string text,
+                       const std::string& old_text,
+                       const std::string& new_text) {
+  size_t pos = 0;
+  while ((pos = text.find(old_text, pos)) != std::string::npos) {
+    text.replace(pos, old_text.size(), new_text);
+    pos += new_text.size();
+  }
+  return text;
+}
+
+}  // namespace
+
+std::optional<std::string> ProfileSearchEngine::CurrentTemplate(
+    Profile* profile) {
+  TemplateURLService* service = Service(profile);
+  const TemplateURL* provider =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  if (!provider) {
+    return std::nullopt;
+  }
+  const GURL generated = provider->GenerateSearchURL(
+      service->search_terms_data(), base::UTF8ToUTF16(std::string_view(kSearchToken)));
+  if (!generated.is_valid() || !generated.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  const std::string url = generated.spec();
+  if (url.find(kSearchToken) == std::string::npos) {
+    return std::nullopt;
+  }
+  return ReplaceAll(url, kSearchToken, "%s");
+}
+
+std::optional<std::string> ProfileSearchEngine::Resolve(
+    Profile* profile,
+    const std::string& query) {
+  if (query.empty() || query.size() > 2048) {
+    return std::nullopt;
+  }
+  TemplateURLService* service = Service(profile);
+  const TemplateURL* provider =
+      service ? service->GetDefaultSearchProvider() : nullptr;
+  if (!provider) {
+    return std::nullopt;
+  }
+  const GURL url = provider->GenerateSearchURL(service->search_terms_data(),
+                                                base::UTF8ToUTF16(query));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  return url.spec();
+}
+
+ProfileSearchEngine::SetResult ProfileSearchEngine::Set(
+    Profile* profile,
+    const std::string& url_template) {
+  if (!profile || profile->IsOffTheRecord() || url_template.size() > 2048 ||
+      url_template.find("%s") == std::string::npos) {
+    return SetResult::kInvalid;
+  }
+  const size_t authority_start = url_template.find("://");
+  if (authority_start == std::string::npos) {
+    return SetResult::kInvalid;
+  }
+  const size_t authority_end = url_template.find_first_of("/?#", authority_start + 3);
+  if (url_template.substr(authority_start + 3,
+                          authority_end - authority_start - 3)
+              .find("%s") != std::string::npos) {
+    return SetResult::kInvalid;
+  }
+  const GURL sample(ReplaceAll(url_template, "%s", "aux"));
+  if (!sample.is_valid() || !sample.SchemeIsHTTPOrHTTPS() ||
+      sample.has_username() || sample.has_password() ||
+      sample.host().find('%') != std::string::npos) {
+    return SetResult::kInvalid;
+  }
+  TemplateURLService* service = Service(profile);
+  if (!service || !service->loaded()) {
+    return SetResult::kUnavailable;
+  }
+  const TemplateURL* current = service->GetDefaultSearchProvider();
+  if (!service->CanDefaultSearchProviderBeModifiedByUser()) {
+    return SetResult::kManaged;
+  }
+  const std::string native_template =
+      ReplaceAll(url_template, "%s", "{searchTerms}");
+  for (TemplateURL* provider : service->GetTemplateURLs()) {
+    if (provider->url() != native_template) {
+      continue;
+    }
+    if (provider == current) {
+      return SetResult::kOk;
+    }
+    if (!service->CanMakeDefault(provider)) {
+      return SetResult::kManaged;
+    }
+    service->SetUserSelectedDefaultSearchProvider(provider);
+    return SetResult::kOk;
+  }
+  TemplateURLData data;
+  data.SetShortName(base::UTF8ToUTF16(sample.host()));
+  std::string keyword = "aux-" + std::string(sample.host());
+  for (int suffix = 2;
+       service->GetTemplateURLForKeyword(base::UTF8ToUTF16(keyword));
+       ++suffix) {
+    keyword = "aux-" + std::string(sample.host()) + "-" + base::NumberToString(suffix);
+  }
+  data.SetKeyword(base::UTF8ToUTF16(keyword));
+  data.SetURL(native_template);
+  TemplateURL* provider = service->Add(std::make_unique<TemplateURL>(data));
+  if (!provider) {
+    return SetResult::kUnavailable;
+  }
+  if (!service->CanMakeDefault(provider)) {
+    service->Remove(provider);
+    return SetResult::kManaged;
+  }
+  service->SetUserSelectedDefaultSearchProvider(provider);
+  return SetResult::kOk;
+}
+
+void ProfileSearchEngine::InitializeSuggestions(Profile* profile) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  const PrefService::Preference* preference =
+      prefs->FindPreference(prefs::kSearchSuggestEnabled);
+  if (preference && preference->IsDefaultValue()) {
+    prefs->SetBoolean(prefs::kSearchSuggestEnabled, false);
+  }
+}
+
+bool ProfileSearchEngine::SuggestionsEnabled(Profile* profile) {
+  return profile &&
+         profile->GetPrefs()->GetBoolean(prefs::kSearchSuggestEnabled);
+}
+
+ProfileSearchEngine::SetResult ProfileSearchEngine::SetSuggestions(
+    Profile* profile,
+    bool enabled) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return SetResult::kInvalid;
+  }
+  PrefService* prefs = profile->GetPrefs();
+  const PrefService::Preference* preference =
+      prefs->FindPreference(prefs::kSearchSuggestEnabled);
+  if (!preference || !preference->IsUserModifiable()) {
+    return SetResult::kManaged;
+  }
+  prefs->SetBoolean(prefs::kSearchSuggestEnabled, enabled);
+  return SetResult::kOk;
+}
+
+}  // namespace aux
