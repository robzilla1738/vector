+LinkRouter* LinkRouter::ForProfile(Profile* profile) {
+  if (!profile || profile->IsOffTheRecord()) return nullptr;
+  auto* router = static_cast<LinkRouter*>(profile->GetUserData(kRouterKey));
+  if (!router) {
+    auto instance = std::make_unique<LinkRouter>(profile);
+    router = instance.get();
+    profile->SetUserData(kRouterKey, std::move(instance));
+  }
+  return router;
+}
+LinkRouter::LinkRouter(Profile* profile) : profile_(profile), browsers_(ProfileBrowserCollection::GetForProfile(profile)) {
+  if (browsers_) observation_.Observe(browsers_);
+  profile_observation_.Observe(profile);
+}
+LinkRouter::~LinkRouter() = default;
+void LinkRouter::OnProfileWillBeDestroyed(Profile*) {
+  observation_.Reset(); profile_observation_.Reset(); expiry_timer_.Stop();
+  weak_factory_.InvalidateWeakPtrs(); receipts_.clear(); prompts_.clear();
+}
+base::DictValue LinkRouter::Config() {
+  const auto& stored = g_browser_process->local_state()->GetDict(kLinkRoutingPref);
+  if (!stored.empty() && ValidLinkRoutes(stored)) return stored.Clone();
+  base::DictValue config;
+  config.Set("version", 1); config.Set("revision", 0); config.Set("enabled", stored.empty()); config.Set("inApp", "off");
+  base::DictValue destination; destination.Set("kind", "last-used");
+  config.Set("default", std::move(destination)); config.Set("rules", base::ListValue());
+  return config;
+}
+std::optional<base::DictValue> LinkRouter::SetConfig(int expected, const base::DictValue& config, std::string* error) {
+  return WriteConfig(expected, config, true, error);
+}
+void LinkRouter::RecordHit(const std::string& id) {
+  if (id.empty()) return;
+  auto config = Config();
+  for (auto& value : *config.FindList("rules")) {
+    auto& rule = value.GetDict();
+    if (*rule.FindString("id") != id) continue;
+    rule.Set("hits", std::min(std::numeric_limits<int>::max() - 1, rule.FindInt("hits").value_or(0)) + 1);
+    rule.Set("lastHitAt", static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    std::string error;
+    WriteConfig(config.FindInt("revision").value(), config, false, &error);
+    return;
+  }
+}
+std::optional<base::DictValue> LinkRouter::WriteConfig(int expected, const base::DictValue& config, bool preserve_hits, std::string* error) {
+  auto current = Config();
+  if (!ValidLinkRoutes(config) || config.FindInt("revision") != expected) { *error = "Invalid routing rules"; return std::nullopt; }
+  if (current.FindInt("revision") != expected || expected == std::numeric_limits<int>::max()) { *error = "Routing rules changed; refresh and try again"; return std::nullopt; }
+  auto next = config.Clone();
+  // Rule editing cannot overwrite native hit accounting from the same revision.
+  if (preserve_hits) for (auto& value : *next.FindList("rules")) for (const auto& old : *current.FindList("rules")) {
+    if (*value.GetDict().FindString("id") != *old.GetDict().FindString("id")) continue;
+    value.GetDict().Set("hits", old.GetDict().FindInt("hits").value_or(0));
+    if (const auto* time = old.GetDict().Find("lastHitAt")) value.GetDict().Set("lastHitAt", time->Clone());
+  }
+  next.Set("revision", expected + 1);
+  g_browser_process->local_state()->SetDict(kLinkRoutingPref, next.Clone());
+  return next;
+}
+base::DictValue LinkRouter::Test(const GURL& url, std::string_view source, std::string_view sender) {
+  auto result = MatchLinkRoute(Config(), url, source, sender, LastProfile(), Available, SpaceAvailable);
+  base::DictValue value; value.Set("destination", std::move(result.destination)); value.Set("fallback", result.fallback);
+  if (!result.rule_id.empty()) value.Set("ruleId", result.rule_id);
+  if (!result.fallback_reason.empty()) value.Set("fallbackReason", result.fallback_reason);
+  return value;
+}
+bool LinkRouter::Deliver(BrowserWindowInterface* window, const GURL& url, const base::DictValue& destination,
+                         const std::string& rule, bool background, bool untrusted, const std::string& fallback_reason) {
+  if (!Eligible(window, profile_) || !WebUrl(url) || receipts_.size() >= kCapacity) return false;
+  std::string error;
+  auto snapshot = OrganizationStore::Snapshot(profile_, WindowId(window), &error);
+  if (!snapshot) return false;
+  auto* layout = snapshot->FindDict("layout");
+  std::string space;
+  std::string workspace;
+  std::string actual_fallback = fallback_reason;
+  if (layout) {
+    const auto* requested = destination.FindString("spaceId");
+    if (requested && !SpaceAvailable(Id(profile_), *requested)) actual_fallback = "space-unavailable";
+    space = requested && SpaceAvailable(Id(profile_), *requested) ? *requested : *layout->FindDict("window")->FindString("activeSpaceId");
+    for (const auto& item : *layout->FindDict("shared")->FindList("spaces")) if (*item.GetDict().FindString("id") == space) {
+      if (const auto* id = item.GetDict().FindString("workspaceId")) workspace = *id;
+      break;
+    }
+    // Little has its own local active Space; FocusProfileSpace intentionally excludes it.
+    layout->FindDict("window")->Set("activeSpaceId", space);
+    if (!OrganizationStore::Commit(profile_, WindowId(window), snapshot->FindInt("revision").value(), *layout, &error)) return false;
+  } else if (destination.FindString("spaceId")) return false;
+  content::WebContents* contents = nullptr;
+  {
+    NavigateParams navigation(window, url, ui::PAGE_TRANSITION_LINK);
+    navigation.original_user_gesture = false;
+    navigation.disposition = IsLittleWindow(window) ? WindowOpenDisposition::CURRENT_TAB :
+        background ? WindowOpenDisposition::NEW_BACKGROUND_TAB : WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    if (untrusted) navigation.initiator_origin = url::Origin();
+    Navigate(&navigation);
+    contents = navigation.navigated_or_inserted_contents;
+  }
+  if (!contents) return false;
+  const auto id = PageIdentity::GetOrCreate(profile_, contents);
+  if (!space.empty()) TabCatalog::GetForProfile(profile_)->BindSpace(id, space, workspace);
+  base::DictValue payload;
+  payload.Set("pageId", id); payload.Set("profileId", Id(profile_));
+  if (!space.empty()) payload.Set("spaceId", space);
+  if (!rule.empty()) payload.Set("ruleId", rule);
+  if (!actual_fallback.empty()) payload.Set("fallbackReason", actual_fallback);
+  receipts_.push_back({WindowId(window), payload.Clone()});
+  EmitShellEvent(profile_, "onRoutedOpen", *base::WriteJson(payload));
+  RecordHit(rule);
+  if (!background) window->GetWindow()->Activate();
+  return true;
+}
+bool LinkRouter::Open(Profile* source_profile, const GURL& url, std::string source, std::string sender,
+                      std::optional<base::DictValue> explicit_destination, bool background,
+                      base::OnceCallback<void(bool)> done, base::RepeatingCallback<bool()> authorized,
+                      std::string fallback_reason, bool fallback_attempt) {
+  auto refuse = [&done]() { if (done) std::move(done).Run(false); return false; };
+  if (!source_profile || source_profile->IsOffTheRecord() || !WebUrl(url) ||
+      !ValidLinkRoutes(Config()) || (authorized && !authorized.Run())) return refuse();
+  auto test = Test(url, source, sender);
+  auto destination = explicit_destination ? std::move(*explicit_destination) : test.FindDict("destination")->Clone();
+  if (!explicit_destination && source != "in-app" && !test.FindString("ruleId") &&
+      g_browser_process->local_state()->GetString(kExternalLinkTargetPref) == "little" && destination.FindString("profileId")) destination.Set("window", "little");
+  const auto* kind = destination.FindString("kind");
+  if (!kind) return refuse();
+  if (*kind == "ask") {
+    auto* window = LastNormalWindow(source_profile);
+    const bool accepted = window && ForProfile(source_profile)->Ask(window, url);
+    if (done) std::move(done).Run(accepted);
+    return accepted;
+  }
+  if (fallback_reason.empty() && test.FindString("fallbackReason")) fallback_reason = *test.FindString("fallbackReason");
+  auto completion = base::BindOnce([](base::WeakPtr<Profile> source_profile, GURL url,
+      std::string source, bool background, bool fallback_attempt,
+      base::RepeatingCallback<bool()> authorized, base::OnceCallback<void(bool)> done,
+      bool ok, bool unavailable) {
+    if (!ok && unavailable && !fallback_attempt && source_profile && (!authorized || authorized.Run())) {
+      // Resolve the configured default once. Never cycle through the matching rule again.
+      auto config = Config(); config.Set("rules", base::ListValue());
+      auto fallback = MatchLinkRoute(config, url, source, "", LastProfile(), Available, SpaceAvailable);
+      Open(source_profile.get(), url, source, "", std::move(fallback.destination), background,
+          std::move(done), std::move(authorized), "profile-unavailable", true);
+      return;
+    }
+    if (done) std::move(done).Run(ok);
+  }, source_profile->GetWeakPtr(), url, source, background, fallback_attempt, authorized, std::move(done));
+  const auto* id = destination.FindString("profileId");
+  if (!id || !Available(*id)) { std::move(completion).Run(false, true); return true; }
+  auto* entry = Entry(*id);
+  std::string rule = test.FindString("ruleId") ? *test.FindString("ruleId") : "";
+  g_browser_process->profile_manager()->CreateProfileAsync(entry->GetPath(), base::BindOnce(
+    [](GURL url, base::DictValue destination, std::string rule, bool background, bool untrusted,
+       std::string fallback_reason, base::OnceCallback<void(bool, bool)> completion,
+       base::RepeatingCallback<bool()> authorized, Profile* profile) {
+      if (authorized && !authorized.Run()) { std::move(completion).Run(false, false); return; }
+      if (!profile || !Available(Id(profile))) { std::move(completion).Run(false, true); return; }
+      auto* router = ForProfile(profile);
+      if (router->receipts_.size() + router->reserved_ >= kCapacity) { std::move(completion).Run(false, false); return; }
+      ++router->reserved_;
+      auto complete = base::BindOnce([](base::WeakPtr<LinkRouter> router, GURL url,
+          base::DictValue destination, std::string rule, bool background, bool untrusted,
+          std::string fallback_reason, base::OnceCallback<void(bool, bool)> completion,
+          base::RepeatingCallback<bool()> authorized, BrowserWindowInterface* window) {
+        if (router) --router->reserved_;
+        const bool unavailable = window && !Available(Id(window->GetProfile()));
+        const bool ok = router && window && (!authorized || authorized.Run()) && !unavailable &&
+            router->Deliver(window, url, destination, rule, background, untrusted, fallback_reason);
+        if (!ok && window && IsLittleWindow(window)) CloseLittleWindow(window);
+        std::move(completion).Run(ok, unavailable);
+      }, router->weak_factory_.GetWeakPtr(), url, destination.Clone(), rule, background, untrusted,
+          fallback_reason, std::move(completion), std::move(authorized));
+      const auto* kind = destination.FindString("window");
+      if (kind && *kind == "little") {
+        std::move(complete).Run(OpenLittleWindow(profile, GURL(), untrusted, !background));
+      } else if (kind && *kind == "new-window") {
+        auto* window = CreateBrowserWindow(BrowserWindowCreateParams(profile, /*user_gesture=*/true));
+        if (window) { if (background) window->GetWindow()->ShowInactive(); else window->GetWindow()->Show(); }
+        std::move(complete).Run(window);
+      } else if (auto* window = LastNormalWindow(profile)) {
+        std::move(complete).Run(window);
+      } else {
+        profiles::OpenBrowserWindowForProfile(std::move(complete), true, false, false, profile);
+      }
+    }, url, destination.Clone(), rule, background, source != "in-app", fallback_reason,
+        std::move(completion), std::move(authorized)));
+  return true;
+}
+
+bool LinkRouter::OpenScheme(Profile* profile, const GURL& scheme) {
+  if (!scheme.SchemeIs("aux") || scheme.host() != "open" || scheme.has_username() || scheme.has_password() || scheme.has_port() || scheme.has_ref()) return false;
+  if (scheme.path() != "" && scheme.path() != "/") return false;
+  std::set<std::string> keys;
+  for (net::QueryIterator it(scheme); !it.IsAtEnd(); it.Advance()) {
+    const std::string key(it.GetKey());
+    if ((key != "url" && key != "profile" && key != "space" && key != "window" && key != "source" && key != "background") || !keys.insert(key).second) return false;
+  }
+  std::string inner, id, space, window, source, background;
+  if (!net::GetValueForKeyInQuery(scheme, "url", &inner) || !WebUrl(GURL(inner))) return false;
+  net::GetValueForKeyInQuery(scheme, "profile", &id); net::GetValueForKeyInQuery(scheme, "space", &space);
+  net::GetValueForKeyInQuery(scheme, "window", &window); net::GetValueForKeyInQuery(scheme, "source", &source);
+  net::GetValueForKeyInQuery(scheme, "background", &background);
+  if ((!background.empty() && background != "1") || (!source.empty() && source != "cli" && source != "external")) return false;
+  if (!window.empty() && window != "tab" && window != "little" && window != "new-window") return false;
+  auto destination = Test(GURL(inner), source == "cli" ? "cli" : "external").FindDict("destination")->Clone();
+  if (!id.empty() && Available(id)) { destination.Set("kind", "profile"); destination.Set("profileId", id); destination.Remove("spaceId"); }
+  if (!space.empty()) destination.Set("spaceId", space);
+  if (!window.empty()) destination.Set("window", window);
+  return Open(profile, GURL(inner), source == "cli" ? "cli" : "external", "", std::move(destination), background == "1");
+}
+bool LinkRouter::Ask(BrowserWindowInterface* window, const GURL& url) {
+  Expire();
+  if (!Eligible(window, profile_) || IsLittleWindow(window) || prompts_.size() >= kCapacity) return false;
+  const auto id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  const auto expires_at = base::Time::Now().InMillisecondsSinceUnixEpoch() + 60'000;
+  prompts_.emplace(id, Prompt{WindowId(window), url, base::TimeTicks::Now() + base::Seconds(60), expires_at});
+  ScheduleExpiry();
+  base::DictValue payload; payload.Set("id", id); payload.Set("url", url.spec()); payload.Set("expiresAt", static_cast<double>(expires_at));
+  EmitShellEvent(profile_, "onRoutePrompt", *base::WriteJson(payload));
+  return true;
+}
+base::ListValue LinkRouter::TakeReceipts(BrowserWindowInterface* caller) {
+  base::ListValue result;
+  if (!Eligible(caller, profile_)) return result;
+  std::erase_if(receipts_, [&](Receipt& receipt) {
+    if (receipt.window != WindowId(caller)) return false;
+    result.Append(std::move(receipt.payload)); return true;
+  });
+  return result;
+}
+base::ListValue LinkRouter::Prompts(BrowserWindowInterface* caller) {
+  Expire(); base::ListValue result;
+  if (!Eligible(caller, profile_) || IsLittleWindow(caller)) return result;
+  for (const auto& [id, prompt] : prompts_) if (prompt.window == WindowId(caller)) {
+    base::DictValue payload; payload.Set("id", id); payload.Set("url", prompt.url.spec()); payload.Set("expiresAt", static_cast<double>(prompt.expires_at)); result.Append(std::move(payload));
+  }
+  return result;
+}
+void LinkRouter::Resolve(BrowserWindowInterface* caller, const std::string& id, const base::DictValue& destination,
+                         bool remember, base::OnceCallback<void(bool)> done) {
+  Expire(); auto it = prompts_.find(id);
+  const auto* profile = destination.FindString("profileId");
+  if (!Eligible(caller, profile_) || IsLittleWindow(caller) || it == prompts_.end() ||
+      it->second.window != WindowId(caller) || it->second.resolving || !profile || !Available(*profile)) { std::move(done).Run(false); return; }
+  const GURL url = it->second.url;
+  if (remember) {
+    auto config = Config();
+    if (config.FindList("rules")->size() >= 500) { std::move(done).Run(false); return; }
+    base::DictValue match; match.Set("kind", "host"); match.Set("pattern", url.host()); match.Set("subdomains", false);
+    base::DictValue rule; rule.Set("id", "remember-" + id); rule.Set("enabled", true);
+    rule.Set("order", static_cast<int>(config.FindList("rules")->size())); rule.Set("match", std::move(match)); rule.Set("destination", destination.Clone()); rule.Set("hits", 0);
+    bool existing = false;
+    for (auto& value : *config.FindList("rules")) if (*value.GetDict().FindString("id") == "remember-" + id) {
+      value.GetDict().Set("destination", destination.Clone()); existing = true; break;
+    }
+    if (!existing) config.FindList("rules")->Append(std::move(rule));
+    std::string error;
+    if (!SetConfig(config.FindInt("revision").value(), config, &error)) { std::move(done).Run(false); return; }
+  }
+  it->second.resolving = true;
+  auto finish = base::BindOnce([](base::WeakPtr<LinkRouter> router, std::string id, base::OnceCallback<void(bool)> done, bool ok) {
+    if (router) {
+      auto it = router->prompts_.find(id);
+      if (it != router->prompts_.end()) { if (ok) router->prompts_.erase(it); else it->second.resolving = false; }
+      router->ScheduleExpiry();
+    }
+    std::move(done).Run(ok);
+  }, weak_factory_.GetWeakPtr(), id, std::move(done));
+  auto authorized = base::BindRepeating([](base::WeakPtr<LinkRouter> router, std::string id) {
+    return router && router->PromptLive(id);
+  }, weak_factory_.GetWeakPtr(), id);
+  Open(profile_, url, "external", "", destination.Clone(), false, std::move(finish), std::move(authorized));
+}
+bool LinkRouter::PromptLive(const std::string& id) {
+  auto it = prompts_.find(id);
+  return it != prompts_.end() && it->second.resolving && it->second.expires > base::TimeTicks::Now();
+}
+
+void LinkRouter::Expire() {
+  const auto now = base::TimeTicks::Now();
+  std::erase_if(prompts_, [now](const auto& item) { return item.second.expires <= now; });
+  ScheduleExpiry();
+}
+void LinkRouter::ScheduleExpiry() {
+  if (prompts_.empty()) { expiry_timer_.Stop(); return; }
+  auto first = std::ranges::min_element(prompts_, {}, [](const auto& item) { return item.second.expires; });
+  expiry_timer_.Start(FROM_HERE, std::max(base::TimeDelta(), first->second.expires - base::TimeTicks::Now()),
+                       base::BindOnce(&LinkRouter::Expire, weak_factory_.GetWeakPtr()));
+}
+void LinkRouter::OnBrowserClosed(BrowserWindowInterface* browser) {
+  const auto window = WindowId(browser);
+  std::erase_if(receipts_, [&](const Receipt& value) { return value.window == window; });
+  std::erase_if(prompts_, [&](const auto& value) { return value.second.window == window; });
+  ScheduleExpiry();
+}
+}
