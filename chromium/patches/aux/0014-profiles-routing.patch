@@ -0,0 +1,34 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_PROFILE_SEARCH_ENGINE_H_
+#define CHROME_BROWSER_UI_AUX_PROFILE_SEARCH_ENGINE_H_
+
+#include <optional>
+#include <string>
+
+class Profile;
+
+namespace aux {
+
+// Uses the owning Profile's TemplateURLService. Aux does not keep another
+// default-provider preference; callers should read this service on demand.
+class ProfileSearchEngine {
+ public:
+  enum class SetResult { kOk, kInvalid, kUnavailable, kManaged };
+
+  static std::optional<std::string> CurrentTemplate(Profile* profile);
+  static std::optional<std::string> Resolve(Profile* profile,
+                                            const std::string& query);
+  static SetResult Set(Profile* profile, const std::string& url_template);
+  // Aux starts with network suggestions off unless this Profile already has
+  // a user, extension, or policy decision.
+  static void InitializeSuggestions(Profile* profile);
+  static bool SuggestionsEnabled(Profile* profile);
+  static SetResult SetSuggestions(Profile* profile, bool enabled);
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_PROFILE_SEARCH_ENGINE_H_
