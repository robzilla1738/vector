diff --git a/chrome/browser/ui/aux/methods/profile_methods.cc b/chrome/browser/ui/aux/methods/profile_methods.cc
new file mode 100644
index 0000000..4b30a7d
--- /dev/null
+++ b/chrome/browser/ui/aux/methods/profile_methods.cc
@@ -0,0 +1,466 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/location.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/delete_profile_helper.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_window.h"
+#include "chrome/browser/profiles/profiles_state.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/aux/profile_prefs.h"
+#include "chrome/browser/ui/aux/link_router.h"
+#include "chrome/browser/ui/aux/profile_spaces.h"
+#include "chrome/browser/ui/aux/page_identity.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "chrome/browser/ui/aux/egress_controller.h"
+#include "chrome/browser/ui/aux/shell_events.h"
+#include "chrome/browser/ui/aux/quick_ask_controller.h"
+#include "chrome/browser/ui/aux/little_window_controller.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/common/pref_names.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "ui/base/base_window.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/web_contents.h"
+#include "unicode/uchar.h"
+#include "unicode/utf16.h"
+#include "url/gurl.h"
+
+namespace {
+
+using Reply = aux::mojom::ShellHost::RequestCallback;
+
+void Fail(Reply callback, const char* code, const char* message) {
+  std::move(callback).Run(false, "", code, message);
+}
+
+void Succeed(Reply callback, base::Value value) {
+  const auto json = base::WriteJson(value);
+  if (!json) {
+    Fail(std::move(callback), "internal", "Profile result could not be encoded");
+    return;
+  }
+  std::move(callback).Run(true, *json, "", "");
+}
+
+std::string ProfileId(const base::FilePath& path) {
+  const std::string name = path.BaseName().AsUTF8Unsafe();
+  return name == "Default" ? "default" : name;
+}
+
+bool ListedProfile(ProfileAttributesEntry* entry, Profile* current) {
+  return entry && !entry->IsOmitted() && !entry->IsEphemeral() &&
+         entry->GetPath().DirName() == current->GetPath().DirName() &&
+         entry->GetPath().BaseName() != ProfileManager::GetGuestProfilePath().BaseName() &&
+         entry->GetPath().BaseName() != ProfileManager::GetSystemProfilePath().BaseName();
+}
+
+ProfileAttributesEntry* FindProfile(ProfileManager* manager, Profile* current,
+                                    const std::string& id) {
+  for (auto* entry : manager->GetProfileAttributesStorage().GetAllProfilesAttributes()) {
+    if (ListedProfile(entry, current) && ProfileId(entry->GetPath()) == id)
+      return entry;
+  }
+  return nullptr;
+}
+
+bool Archived(const std::string& id) {
+  return g_browser_process->local_state()
+      ->GetDict(aux::kArchivedProfilesPref).FindBool(id).value_or(false);
+}
+
+base::DictValue Describe(ProfileAttributesEntry* entry, Profile* current) {
+  const std::string id = ProfileId(entry->GetPath());
+  base::DictValue item;
+  item.Set("id", id);
+  item.Set("name", id == "default" && entry->IsUsingDefaultName()
+                       ? "Personal"
+                       : base::UTF16ToUTF8(entry->GetLocalProfileName()));
+  item.Set("current", entry->GetPath() == current->GetPath());
+  item.Set("archived", Archived(id));
+  const auto* local_state = g_browser_process->local_state();
+  const auto* appearance = local_state->GetDict(aux::kProfileAppearancePref).FindDict(id);
+  item.Set("color", appearance && appearance->FindString("color") ? *appearance->FindString("color") : "blue");
+  item.Set("icon", appearance && appearance->FindString("icon") ? *appearance->FindString("icon") : "person");
+  const auto* spaces = local_state->GetDict(aux::kProfileSpacesIndexPref).FindList(id);
+  item.Set("spaces", spaces ? spaces->Clone() : base::ListValue());
+  return item;
+}
+
+base::ListValue ListProfiles(ProfileManager* manager, Profile* current) {
+  base::ListValue items;
+  for (auto* entry : manager->GetProfileAttributesStorage().GetAllProfilesAttributes()) {
+    if (ListedProfile(entry, current)) items.Append(Describe(entry, current));
+  }
+  return items;
+}
+
+std::optional<std::u16string> ProfileName(const std::string& raw) {
+  if (raw.empty() || raw.size() > 240 || !base::IsStringUTF8(raw))
+    return std::nullopt;
+  std::u16string name(base::TrimWhitespace(base::UTF8ToUTF16(raw),
+                                           base::TRIM_ALL));
+  if (name.empty() || name.size() > 60) return std::nullopt;
+  const auto code_units = base::span(name);
+  for (int32_t i = 0; i < static_cast<int32_t>(name.size());) {
+    UChar32 codepoint;
+    U16_NEXT(code_units, i, static_cast<int32_t>(name.size()), codepoint);
+    const int category = u_charType(codepoint);
+    if (category == U_CONTROL_CHAR || category == U_FORMAT_CHAR)
+      return std::nullopt;
+  }
+  return name;
+}
+
+bool ValidWebUrl(const std::string& text) {
+  const GURL url(text);
+  return text.size() <= 8192 && url.is_valid() && url.SchemeIsHTTPOrHTTPS() &&
+         !url.has_username() && !url.has_password();
+}
+
+void AwaitRemoval(base::WeakPtr<WebUIBrowserUI> ui, base::FilePath path,
+                  Reply callback, int attempts) {
+  if (!ui || !g_browser_process || !g_browser_process->profile_manager())
+    return;
+  auto* manager = g_browser_process->profile_manager();
+  auto& storage = manager->GetProfileAttributesStorage();
+  if (!storage.GetProfileAttributesWithPath(path)) {
+    ScopedDictPrefUpdate archived(g_browser_process->local_state(),
+                                  aux::kArchivedProfilesPref);
+    archived->Remove(ProfileId(path));
+    ScopedDictPrefUpdate appearance(g_browser_process->local_state(), aux::kProfileAppearancePref);
+    appearance->Remove(ProfileId(path));
+    ScopedDictPrefUpdate spaces(g_browser_process->local_state(), aux::kProfileSpacesIndexPref);
+    spaces->Remove(ProfileId(path));
+    Succeed(std::move(callback),
+            base::Value(ListProfiles(manager, ui->browser()->GetProfile())));
+    return;
+  }
+  if (attempts >= 100) {
+    Fail(std::move(callback), "conflict", "Profile deletion did not finish");
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&AwaitRemoval, ui, std::move(path), std::move(callback),
+                     attempts + 1),
+      base::Milliseconds(100));
+}
+
+bool HumanTab(Profile* profile, content::WebContents* contents) {
+  const auto* identity = aux::PageIdentity::FromWebContents(contents);
+  aux::EgressRequestContext context;
+  context.document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  context.page_id = aux::PageIdentity::GetOrCreate(profile, contents);
+  return !(identity && identity->runtime_owned()) && !aux::EgressController::ForProfile(profile)->IsProtected(context);
+}
+
+void OpenLoadedProfile(Reply callback, std::optional<GURL> url,
+                       std::optional<std::string> space_id,
+                       base::WeakPtr<content::WebContents> source,
+                       content::WeakDocumentPtr source_document,
+                       Profile* profile) {
+  if (!profile) {
+    Fail(std::move(callback), "backend_unavailable", "Profile could not be loaded");
+    return;
+  }
+  auto* entry = g_browser_process->profile_manager()->GetProfileAttributesStorage()
+      .GetProfileAttributesWithPath(profile->GetPath());
+  if (!ListedProfile(entry, profile) || Archived(ProfileId(profile->GetPath())) || entry->IsSigninRequired()) {
+    Fail(std::move(callback), "forbidden", "Destination Profile is archived or locked");
+    return;
+  }
+  auto opened = base::BindOnce(
+          [](Reply callback, std::optional<GURL> url,
+             std::optional<std::string> space_id,
+             base::WeakPtr<content::WebContents> source,
+             content::WeakDocumentPtr source_document,
+             BrowserWindowInterface* window) {
+            if (!window) {
+              Fail(std::move(callback), "backend_unavailable",
+                   "Profile window could not be opened");
+              return;
+            }
+            auto* entry = g_browser_process->profile_manager()->GetProfileAttributesStorage()
+                .GetProfileAttributesWithPath(window->GetProfile()->GetPath());
+            if (!ListedProfile(entry, window->GetProfile()) || Archived(ProfileId(window->GetProfile()->GetPath())) || entry->IsSigninRequired()) {
+              Fail(std::move(callback), "forbidden", "Destination Profile is archived or locked");
+              return;
+            }
+            if (window->GetProfile()->IsOffTheRecord() || aux::IsLittleWindow(window) || aux::IsQuickAskWindow(window)) {
+              Fail(std::move(callback), "forbidden", "A normal Profile window is required");
+              return;
+            }
+            if (space_id) {
+              std::string error;
+              if (!aux::FocusProfileSpace(window, *space_id, &error)) {
+                Fail(std::move(callback), "conflict", error.c_str());
+                return;
+              }
+            }
+            if (url && !chrome::AddAndReturnTabAt(window, *url, -1, true)) {
+              Fail(std::move(callback), "backend_unavailable",
+                   "Page could not be opened in the Profile");
+              return;
+            }
+            window->GetWindow()->Activate();
+            if (source && url && aux::SameMovedDocument(source.get(), source_document, *url)) {
+              auto* source_profile = Profile::FromBrowserContext(source->GetBrowserContext());
+              BrowserWindowInterface* owner = nullptr;
+              aux::TabCatalog::GetForProfile(source_profile)->FindPage(
+                  aux::PageIdentity::GetOrCreate(source_profile, source.get()), &owner);
+              if (owner && !source_profile->IsOffTheRecord() && owner->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+                  !aux::IsLittleWindow(owner) && !aux::IsQuickAskWindow(owner) && HumanTab(source_profile, source.get())) {
+                const int index = owner->GetTabStripModel()->GetIndexOfWebContents(source.get());
+                if (index >= 0) owner->GetTabStripModel()->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+              }
+            }
+            Succeed(std::move(callback), base::Value(true));
+          },
+          std::move(callback), std::move(url), std::move(space_id), source, source_document);
+  if (auto* normal = aux::LastNormalWindow(profile)) {
+    std::move(opened).Run(normal);
+  } else {
+    profiles::OpenBrowserWindowForProfile(std::move(opened),
+        /*always_create=*/true, /*is_new_profile=*/false,
+        /*open_command_line_urls=*/false, profile);
+  }
+}
+
+}  // namespace
+
+void WebUIBrowserUI::HandleAuxProfilesRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  if (aux::IsLinkRoutingMethod(method)) {
+    aux::HandleLinkRoutingRequest(browser_, method, args, std::move(callback));
+    return;
+  }
+  Profile* current = browser_ ? browser_->GetProfile() : nullptr;
+  ProfileManager* manager = g_browser_process
+                                ? g_browser_process->profile_manager()
+                                : nullptr;
+  if (!current || current->IsOffTheRecord() || !manager ||
+      !g_browser_process->local_state()) {
+    Fail(std::move(callback), "forbidden", "Profiles require a regular Aux window");
+    return;
+  }
+  if (method == "javascriptAppleEvents") {
+    if (args.size() > 1 || (!args.empty() && !args[0].is_bool())) {
+      Fail(std::move(callback), "invalid_argument", "Invalid JavaScript Apple Events preference");
+      return;
+    }
+    auto* prefs = current->GetPrefs();
+    const bool managed = prefs->IsManagedPreference(prefs::kAllowJavascriptAppleEvents);
+    if (!args.empty()) {
+      if (managed) {
+        Fail(std::move(callback), "forbidden", "JavaScript Apple Events is managed");
+        return;
+      }
+      prefs->SetBoolean(prefs::kAllowJavascriptAppleEvents, args[0].GetBool());
+    }
+    base::DictValue result;
+    result.Set("enabled", prefs->GetBoolean(prefs::kAllowJavascriptAppleEvents));
+    result.Set("managed", managed);
+    Succeed(std::move(callback), base::Value(std::move(result)));
+    return;
+  }
+  if (method == "browserProfiles") {
+    if (!args.empty()) {
+      Fail(std::move(callback), "invalid_argument", "Unexpected Profile arguments");
+      return;
+    }
+    Succeed(std::move(callback), base::Value(ListProfiles(manager, current)));
+    return;
+  }
+  if (method == "createBrowserProfile") {
+    if (args.size() != 1 || !args[0].is_string()) {
+      Fail(std::move(callback), "invalid_argument", "Invalid Profile name");
+      return;
+    }
+    const auto name = ProfileName(args[0].GetString());
+    if (!name) {
+      Fail(std::move(callback), "invalid_argument", "Profile name must be 1–60 visible characters");
+      return;
+    }
+    ProfileManager::CreateMultiProfileAsync(
+        *name, /*icon_index=*/0, /*is_hidden=*/false,
+        base::BindOnce(
+            [](base::WeakPtr<WebUIBrowserUI> ui, Reply callback,
+               Profile* created) {
+              if (!ui) return;
+              if (!created || !g_browser_process ||
+                  !g_browser_process->profile_manager()) {
+                Fail(std::move(callback), "backend_unavailable",
+                     "Profile could not be created");
+                return;
+              }
+              auto* entry = g_browser_process->profile_manager()
+                                ->GetProfileAttributesStorage()
+                                .GetProfileAttributesWithPath(created->GetPath());
+              if (!entry || !ListedProfile(entry, ui->browser()->GetProfile())) {
+                Fail(std::move(callback), "internal", "Created Profile was not registered");
+                return;
+              }
+              Succeed(std::move(callback),
+                      base::Value(Describe(entry, ui->browser()->GetProfile())));
+            },
+            GetWeakPtr(), std::move(callback)));
+    return;
+  }
+  if (args.empty() || !args[0].is_string()) {
+    Fail(std::move(callback), "invalid_argument", "Invalid Profile identity");
+    return;
+  }
+  base::WeakPtr<content::WebContents> source;
+  std::optional<GURL> moving_url;
+  content::WeakDocumentPtr source_document;
+  std::string id = args[0].GetString();
+  if (method == "moveTabToProfile") {
+    if (args.size() != 2 || !args[1].is_string()) {
+      Fail(std::move(callback), "invalid_argument", "Invalid destination Profile");
+      return;
+    }
+    BrowserWindowInterface* owner = nullptr;
+    auto* contents = aux::TabCatalog::GetForProfile(current)->FindPage(id, &owner);
+    if (!contents || !owner || owner->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        aux::IsLittleWindow(owner) || aux::IsQuickAskWindow(owner) || !HumanTab(current, contents)) {
+      Fail(std::move(callback), "forbidden", "Only a human tab in a normal window can change Profile");
+      return;
+    }
+    moving_url = contents->GetLastCommittedURL();
+    if (!ValidWebUrl(moving_url->spec())) {
+      Fail(std::move(callback), "invalid_argument", "Only HTTP and HTTPS tabs can change Profile");
+      return;
+    }
+    source = contents->GetWeakPtr();
+    source_document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+    id = args[1].GetString();
+    if (id == ProfileId(current->GetPath())) {
+      Fail(std::move(callback), "invalid_argument", "The tab is already in that Profile");
+      return;
+    }
+  }
+  auto* entry = FindProfile(manager, current, id);
+  if (!entry) {
+    Fail(std::move(callback), "not_found", "Profile was not found");
+    return;
+  }
+  if (method == "setBrowserProfileAppearance") {
+    const auto* appearance = args.size() == 2 ? args[1].GetIfDict() : nullptr;
+    const auto* color = appearance ? appearance->FindString("color") : nullptr;
+    const auto* icon = appearance ? appearance->FindString("icon") : nullptr;
+    if (!color || !icon || icon->empty() || icon->size() > 32 ||
+        (*color != "blue" && *color != "violet" && *color != "pink" && *color != "orange" && *color != "green" && *color != "teal" && *color != "slate")) {
+      Fail(std::move(callback), "invalid_argument", "Invalid Profile appearance");
+      return;
+    }
+    ScopedDictPrefUpdate appearances(g_browser_process->local_state(), aux::kProfileAppearancePref);
+    appearances->Set(id, appearance->Clone());
+    Succeed(std::move(callback), base::Value(true));
+    return;
+  }
+  if (method == "renameBrowserProfile") {
+    if (args.size() != 2 || !args[1].is_string()) {
+      Fail(std::move(callback), "invalid_argument", "Invalid Profile name");
+      return;
+    }
+    const auto name = ProfileName(args[1].GetString());
+    if (!name) {
+      Fail(std::move(callback), "invalid_argument", "Profile name must be 1–60 visible characters");
+      return;
+    }
+    entry->SetLocalProfileName(*name, /*is_default_name=*/false);
+    Succeed(std::move(callback), base::Value(ListProfiles(manager, current)));
+    return;
+  }
+  if (method == "archiveBrowserProfile") {
+    if (args.size() != 2 || !args[1].is_bool()) {
+      Fail(std::move(callback), "invalid_argument", "Invalid archive state");
+      return;
+    }
+    if (entry->GetPath() == current->GetPath() || id == "default") {
+      Fail(std::move(callback), "forbidden", "Current and default Profiles cannot be archived");
+      return;
+    }
+    ScopedDictPrefUpdate archived(g_browser_process->local_state(),
+                                  aux::kArchivedProfilesPref);
+    if (args[1].GetBool()) archived->Set(id, true);
+    else archived->Remove(id);
+    Succeed(std::move(callback), base::Value(ListProfiles(manager, current)));
+    return;
+  }
+  if (method == "deleteBrowserProfile") {
+    if (args.size() != 1 || entry->GetPath() == current->GetPath() ||
+        id == "default") {
+      Fail(std::move(callback), "forbidden", "Current and default Profiles cannot be deleted");
+      return;
+    }
+    Profile* loaded = manager->GetProfileByPath(entry->GetPath());
+    auto* windows = loaded ? ProfileBrowserCollection::GetForProfile(loaded)
+                           : nullptr;
+    if (windows && (windows->GetSize() || windows->GetOffTheRecordBrowserCount())) {
+      Fail(std::move(callback), "conflict", "Close the Profile’s windows before deleting it");
+      return;
+    }
+    const base::FilePath path = entry->GetPath();
+    profiles::SetLastUsedProfile(current->GetPath().BaseName());
+    manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+        path, base::BindOnce([](Profile*) {}),
+        ProfileMetrics::DELETE_PROFILE_SETTINGS);
+    AwaitRemoval(GetWeakPtr(), path, std::move(callback), 0);
+    return;
+  }
+  if (method == "openBrowserProfile" || method == "openBrowserProfileUrl" ||
+      method == "focusBrowserProfileSpace" || method == "moveTabToProfile") {
+    if (method == "focusBrowserProfileSpace" &&
+        (args.size() != 2 || (!args[1].is_none() && !args[1].is_string()))) {
+      Fail(std::move(callback), "invalid_argument", "Invalid Profile Space");
+      return;
+    }
+    if ((method == "openBrowserProfile" && args.size() != 1) ||
+        (method == "openBrowserProfileUrl" &&
+         (args.size() != 2 || !args[1].is_string() ||
+          !ValidWebUrl(args[1].GetString())))) {
+      Fail(std::move(callback), "invalid_argument", "Invalid Profile page URL");
+      return;
+    }
+    if (Archived(id) || entry->IsSigninRequired()) {
+      Fail(std::move(callback), "forbidden", "Profile is archived or locked");
+      return;
+    }
+    std::optional<GURL> url = moving_url;
+    if (method == "openBrowserProfileUrl") url = GURL(args[1].GetString());
+    std::optional<std::string> space_id;
+    if (method == "focusBrowserProfileSpace" && args[1].is_string()) space_id = args[1].GetString();
+    manager->CreateProfileAsync(
+        entry->GetPath(),
+        base::BindOnce(&OpenLoadedProfile, std::move(callback), std::move(url), std::move(space_id), source, source_document));
+    return;
+  }
+  Fail(std::move(callback), "not_found", "Unsupported Profile operation");
+}
diff --git a/chrome/browser/ui/aux/methods/profile_routing_methods.cc b/chrome/browser/ui/aux/methods/profile_routing_methods.cc
new file mode 100644
index 0000000..3e8324b
--- /dev/null
+++ b/chrome/browser/ui/aux/methods/profile_routing_methods.cc
@@ -0,0 +1,54 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/link_router.h"
+#include "chrome/browser/ui/aux/generated/aux_host_methods.h"
+#include "chrome/browser/ui/aux/little_window_controller.h"
+#include "chrome/browser/ui/aux/quick_ask_controller.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/profiles/profile.h"
+#include "base/json/json_writer.h"
+#include "base/functional/bind.h"
+namespace aux {
+bool IsLinkRoutingMethod(std::string_view method) {
+  return method == "linkRoutes" || method == "setLinkRoutes" || method == "testLinkRoute" ||
+      method == "resolveRoutePrompt" || method == "routedOpens" || method == "routePrompts";
+}
+bool HandleLinkRoutingRequest(BrowserWindowInterface* caller, const std::string& method,
+    const base::ListValue& args, mojom::ShellHost::RequestCallback callback) {
+  auto fail = [&callback](const char* code, const std::string& message) {
+    std::move(callback).Run(false, "", code, message); return true;
+  };
+  if (!caller || caller->GetProfile()->IsOffTheRecord() || IsQuickAskWindow(caller) ||
+      caller->GetType() != BrowserWindowInterface::TYPE_NORMAL) return fail("forbidden", "Routing requires an owned regular Aux window");
+  const auto descriptor = generated::LookupMethod(method);
+  std::string error;
+  if (!descriptor || !generated::ValidateMethodArgs(*descriptor, base::Value(args.Clone()), &error))
+    return fail("invalid_argument", error);
+  auto reply = [](mojom::ShellHost::RequestCallback callback, base::Value value) {
+    const auto json = base::WriteJson(value);
+    if (!json) { std::move(callback).Run(false, "", "internal", "Routing result could not be encoded"); return; }
+    std::move(callback).Run(true, *json, "", "");
+  };
+  auto* router = LinkRouter::ForProfile(caller->GetProfile());
+  if (method == "linkRoutes") reply(std::move(callback), base::Value(LinkRouter::Config()));
+  else if (method == "setLinkRoutes") {
+    if (!args[0].is_int()) return fail("invalid_argument", "Revision exceeds the native integer range");
+    auto config = LinkRouter::SetConfig(args[0].GetInt(), args[1].GetDict(), &error);
+    if (!config) return fail("conflict", error);
+    reply(std::move(callback), base::Value(std::move(*config)));
+  } else if (method == "testLinkRoute") {
+    const GURL url(args[0].GetString());
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.has_username() || url.has_password())
+      return fail("invalid_argument", "Routing tests require an HTTP or HTTPS URL without credentials");
+    reply(std::move(callback), base::Value(LinkRouter::Test(url, args[1].GetString())));
+  } else if (method == "routedOpens") reply(std::move(callback), base::Value(router->TakeReceipts(caller)));
+  else if (method == "routePrompts") reply(std::move(callback), base::Value(router->Prompts(caller)));
+  else if (method == "resolveRoutePrompt") {
+    router->Resolve(caller, args[0].GetString(), args[1].GetDict(), args[2].GetBool(),
+      base::BindOnce([](mojom::ShellHost::RequestCallback callback, bool opened) {
+        if (!opened) { std::move(callback).Run(false, "", "conflict", "The prompt expired, its owner closed, or its destination changed. Refresh and choose again."); return; }
+        std::move(callback).Run(true, "true", "", "");
+      }, std::move(callback)));
+  } else return fail("unavailable", "Unknown routing method");
+  return true;
+}
+}
