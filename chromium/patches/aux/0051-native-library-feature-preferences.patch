 void AuxRuntimeHost::OnRuntimeNote(std::string type, std::string payload_json) {
   if (type == "event") {
+    // Cache only Library presentation opt-outs, never provider/profile secrets.
+    // Native pages can retain their choices while the runtime is unavailable.
+    if (!profile_->IsOffTheRecord() && !profile_->IsGuestSession()) {
+      const auto event = base::JSONReader::ReadDict(payload_json, base::JSON_PARSE_RFC);
+      const auto* event_type = event ? event->FindString("type") : nullptr;
+      const auto* payload = event ? event->FindDict("payload") : nullptr;
+      const auto* settings = payload ? payload->FindDict("settings") : nullptr;
+      if (event_type && *event_type == "settings.changed" && settings) {
+        const auto* overrides = settings->FindDict("featureOverrides");
+        base::DictValue library;
+        for (const char* feature : {"folders", "splitView", "privateWindows"}) {
+          library.Set(feature, overrides ? overrides->FindBool(feature).value_or(true) : true);
+        }
+        profile_->GetPrefs()->SetDict(aux::kLibraryFeatureOverridesPref, std::move(library));
+      }
+    }
     observers_.Notify("onEvent", payload_json);
   }
 }
