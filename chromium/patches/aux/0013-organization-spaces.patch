+class Profile;
+
+namespace aux {
+
+inline constexpr char kOrganizationPref[] = "aux.organization.v2";
+
+// Profile-owned browser organization. The caller supplies only the window ID
+// derived from its authorized WebUI; no renderer-provided Profile or window ID
+// is ever read. Every commit compares the current revision before writing.
+class OrganizationStore {
+ public:
+  static std::optional<base::DictValue> ProfileSnapshot(Profile* profile,
+                                                          std::string* error);
+  static std::optional<base::DictValue> Snapshot(Profile* profile,
+                                                   std::string_view window_id,
+                                                   std::string* error);
+  static std::optional<base::DictValue> Commit(
+      Profile* profile,
+      std::string_view window_id,
+      int expected_revision,
+      const base::DictValue& layout,
+      std::string* error);
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_ORGANIZATION_STORE_H_
