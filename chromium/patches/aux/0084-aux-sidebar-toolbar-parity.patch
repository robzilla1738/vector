+  mixer[kColorSysBaseContainer] = {kFrame};
+  mixer[kColorSysBaseContainerElevated] = {kFrame};
+  mixer[kColorSysHeader] = {kFrame};
+  mixer[kColorSysHeaderInactive] = {kFrame};
+  mixer[kColorSysHeaderContainer] = {kRaised};
+  mixer[kColorSysHeaderContainerInactive] = {kRaised};
+  mixer[kColorSysOmniboxContainer] = {kFrame};
+  mixer[kColorSysNeutralContainer] = {kFrame};
+  mixer[kColorSysDivider] = {kRaised};
+  mixer[kColorSysOnHeaderDivider] = {kRaised};
+  mixer[kColorSysSurfaceVariant] = {kFrame};
