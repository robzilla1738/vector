new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/aux/native_project_listener.cc
@@ -0,0 +1,87 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_project_listener.h"
+#include <arpa/inet.h>
+#include <libproc.h>
+#include <sys/proc_info.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <algorithm>
+#include <array>
+#include <vector>
+namespace aux {
+namespace {
+bool Process(pid_t pid, proc_bsdinfo* info) {
+  return proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, info, sizeof(*info)) == static_cast<int>(sizeof(*info)) && info->pbi_uid == getuid();
+}
+bool Socket(pid_t pid, int fd, socket_fdinfo* socket) {
+  return proc_pidfdinfo(pid, fd, PROC_PIDFDSOCKETINFO, socket, sizeof(*socket)) == static_cast<int>(sizeof(*socket)) &&
+      socket->psi.soi_kind == SOCKINFO_TCP && socket->psi.soi_protocol == IPPROTO_TCP &&
+      !(socket->psi.soi_options & SO_REUSEPORT) &&
+      socket->psi.soi_proto.pri_tcp.tcpsi_state == TSI_S_LISTEN;
+}
+std::string LoopbackHost(const socket_fdinfo& socket) {
+  const auto& address = socket.psi.soi_proto.pri_tcp.tcpsi_ini.insi_laddr;
+  if (socket.psi.soi_family == AF_INET) {
+    const auto ipv4 = ntohl(address.ina_46.i46a_addr4.s_addr);
+    if (ipv4 == INADDR_ANY) return "127.0.0.1";
+    if ((ipv4 >> 24) == 127) {
+      std::array<char, INET_ADDRSTRLEN> host{};
+      if (inet_ntop(AF_INET, &address.ina_46.i46a_addr4, host.data(), host.size())) return host.data();
+    }
+  } else if (socket.psi.soi_family == AF_INET6) {
+    if (IN6_IS_ADDR_UNSPECIFIED(&address.ina_6) || IN6_IS_ADDR_LOOPBACK(&address.ina_6)) return "[::1]";
+  }
+  return {};
+}
+}
+bool CaptureProjectProcess(pid_t pid, NativeProjectProcess* process) {
+  proc_bsdinfo info{};
+  if (pid <= 0 || !Process(pid, &info)) return false;
+  *process = {pid, info.pbi_start_tvsec, info.pbi_start_tvusec};
+  return true;
+}
+bool ProjectProcessCurrent(const NativeProjectProcess& process) {
+  proc_bsdinfo info{};
+  return process.pid > 0 && Process(process.pid, &info) && info.pbi_pgid == static_cast<uint32_t>(process.pid) &&
+      info.pbi_start_tvsec == process.seconds && info.pbi_start_tvusec == process.microseconds;
+}
+std::vector<NativeProjectListener> FindProjectListeners(const NativeProjectProcess& process) {
+  if (!ProjectProcessCurrent(process)) return {};
+  // Refuse an overflowing process/fd inventory; never silently inspect another group.
+  std::array<pid_t, 4096> pids{};
+  const int bytes = proc_listpids(PROC_PGRP_ONLY, process.pid, pids.data(), sizeof(pids));
+  if (bytes <= 0 || bytes >= static_cast<int>(sizeof(pids))) return {};
+  std::vector<NativeProjectListener> listeners;
+  for (int index = 0; index < bytes / static_cast<int>(sizeof(pid_t)); ++index) {
+    const auto pid = pids[index]; proc_bsdinfo info{};
+    if (pid <= 0 || !Process(pid, &info) || info.pbi_pgid != static_cast<uint32_t>(process.pid)) continue;
+    std::array<proc_fdinfo, 4096> fds{};
+    const int count = proc_pidinfo(pid, PROC_PIDLISTFDS, 0, fds.data(), sizeof(fds));
+    if (count < 0 || count >= static_cast<int>(sizeof(fds))) return {};
+    for (int item = 0; item < count / static_cast<int>(sizeof(proc_fdinfo)); ++item) {
+      if (fds[item].proc_fdtype != PROX_FDTYPE_SOCKET) continue;
+      socket_fdinfo socket{};
+      if (!Socket(pid, fds[item].proc_fd, &socket)) continue;
+      const auto host = LoopbackHost(socket);
+      const auto& tcp = socket.psi.soi_proto.pri_tcp;
+      const uint16_t port = ntohs(static_cast<uint16_t>(tcp.tcpsi_ini.insi_lport));
+      if (host.empty() || !port) continue;
+      listeners.push_back({pid, static_cast<int>(fds[item].proc_fd), info.pbi_start_tvsec, info.pbi_start_tvusec,
+          socket.psi.soi_so, tcp.tcpsi_ini.insi_gencnt, host, port});
+      if (listeners.size() > 32) return {};
+    }
+  }
+  if (!ProjectProcessCurrent(process)) return {};
+  std::erase_if(listeners, [&](const auto& listener) { return !ProjectListenerCurrent(process, listener); });
+  return listeners;
+}
+bool ProjectListenerCurrent(const NativeProjectProcess& process, const NativeProjectListener& listener) {
+  if (!ProjectProcessCurrent(process)) return false;
+  proc_bsdinfo info{}; socket_fdinfo socket{};
+  return Process(listener.pid, &info) && info.pbi_pgid == static_cast<uint32_t>(process.pid) &&
+      info.pbi_start_tvsec == listener.started_seconds && info.pbi_start_tvusec == listener.started_microseconds &&
+      Socket(listener.pid, listener.fd, &socket) && socket.psi.soi_so == listener.socket &&
+      socket.psi.soi_proto.pri_tcp.tcpsi_ini.insi_gencnt == listener.generation && LoopbackHost(socket) == listener.host &&
+      ntohs(static_cast<uint16_t>(socket.psi.soi_proto.pri_tcp.tcpsi_ini.insi_lport)) == listener.port;
+}
+}
diff --git a/chrome/browser/ui/aux/native_project_listener.h b/chrome/browser/ui/aux/native_project_listener.h
