+namespace aux {
+namespace {
+void Check(base::WeakPtr<NativeProjectPreview> preview, const GURL& url, bool navigation,
+    base::OnceCallback<void(bool)> callback) {
+  if (!preview) { std::move(callback).Run(false); return; }
+  preview->Admit(url, navigation, std::move(callback));
+}
+class PreviewHeader final : public network::mojom::TrustedHeaderClient {
+ public:
+  PreviewHeader(base::WeakPtr<NativeProjectPreview> preview, bool navigation,
+      mojo::PendingRemote<network::mojom::TrustedHeaderClient> target)
+      : preview_(preview), navigation_(navigation), required_(!!target), target_(std::move(target)) {}
+  void OnBeforeSendHeaders(const GURL& url, const net::HttpRequestHeaders& headers,
+      OnBeforeSendHeadersCallback callback) override {
+    last_url_ = url;
+    if (target_) {
+      target_->OnBeforeSendHeaders(url, headers, mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&PreviewHeader::ReviewedHeaders, weak_.GetWeakPtr(), url, std::move(callback)),
+          net::ERR_FAILED, std::nullopt, std::nullopt));
+    } else ReviewedHeaders(url, std::move(callback), required_ ? net::ERR_FAILED : net::OK, std::nullopt, std::nullopt);
+  }
+  void OnHeadersReceived(const std::string& headers, const net::IPEndPoint& endpoint,
+      const std::optional<net::SSLInfo>& ssl, OnHeadersReceivedCallback callback) override {
+    if (!preview_ || !preview_->MatchesEndpoint(last_url_, endpoint)) {
+      std::move(callback).Run(net::ERR_ACCESS_DENIED, std::nullopt, std::nullopt); return;
+    }
+    if (target_) target_->OnHeadersReceived(headers, endpoint, ssl, mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+        base::BindOnce(&PreviewHeader::ReviewedResponse, weak_.GetWeakPtr(), endpoint, std::move(callback)),
+        net::ERR_FAILED, std::nullopt, std::nullopt));
+    else ReviewedResponse(endpoint, std::move(callback), required_ ? net::ERR_FAILED : net::OK, std::nullopt, std::nullopt);
+  }
+ private:
+  void ReviewedResponse(net::IPEndPoint endpoint, OnHeadersReceivedCallback callback, int32_t result,
+      const std::optional<std::string>& headers, const std::optional<GURL>& preserve) {
+    if (result != net::OK || !preview_ || !preview_->MatchesEndpoint(last_url_, endpoint)) {
+      std::move(callback).Run(result == net::OK ? net::ERR_ACCESS_DENIED : result, std::nullopt, std::nullopt); return;
+    }
+    Check(preview_, last_url_, navigation_, base::BindOnce([](base::WeakPtr<NativeProjectPreview> preview,
+        GURL url, net::IPEndPoint endpoint, OnHeadersReceivedCallback callback,
+        std::optional<std::string> headers, std::optional<GURL> preserve, bool allowed) {
+      const bool current = allowed && preview && preview->MatchesEndpoint(url, endpoint);
+      std::move(callback).Run(current ? net::OK : net::ERR_ACCESS_DENIED,
+          current ? std::move(headers) : std::nullopt, current ? std::move(preserve) : std::nullopt);
+    }, preview_, last_url_, endpoint, std::move(callback), std::move(headers), std::move(preserve)));
+  }
+  void ReviewedHeaders(GURL url, OnBeforeSendHeadersCallback callback, int32_t result,
+      const std::optional<net::HttpRequestHeaders>& headers, std::optional<base::DictValue> log) {
+    if (result != net::OK) { std::move(callback).Run(result, std::nullopt, std::nullopt); return; }
+    // The final authority check follows all existing browser header mutations.
+    Check(preview_, url, navigation_, base::BindOnce([](OnBeforeSendHeadersCallback callback,
+        std::optional<net::HttpRequestHeaders> headers, std::optional<base::DictValue> log, bool allowed) {
+      std::move(callback).Run(allowed ? net::OK : net::ERR_ACCESS_DENIED,
+          allowed ? headers : std::nullopt, allowed ? std::move(log) : std::nullopt);
+    }, std::move(callback), headers, std::move(log)));
+  }
+  base::WeakPtr<NativeProjectPreview> preview_;
+  const bool navigation_;
+  const bool required_;
+  mojo::Remote<network::mojom::TrustedHeaderClient> target_;
+  GURL last_url_;
+  base::WeakPtrFactory<PreviewHeader> weak_{this};
+};
+class PreviewFactoryHeaders final : public network::mojom::TrustedURLLoaderHeaderClient {
+ public:
+  PreviewFactoryHeaders(base::WeakPtr<NativeProjectPreview> preview, bool navigation,
+      mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient> target)
+      : preview_(preview), navigation_(navigation), target_(std::move(target)) {}
+  void OnLoaderCreated(int32_t id, mojo::PendingReceiver<network::mojom::TrustedHeaderClient> receiver) override {
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> target;
+    if (target_) target_->OnLoaderCreated(id, target.InitWithNewPipeAndPassReceiver());
+    mojo::MakeSelfOwnedReceiver(std::make_unique<PreviewHeader>(preview_, navigation_, std::move(target)), std::move(receiver));
+  }
+  void OnLoaderForCorsPreflightCreated(const network::ResourceRequest& request,
+      mojo::PendingReceiver<network::mojom::TrustedHeaderClient> receiver) override {
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> target;
+    if (target_) target_->OnLoaderForCorsPreflightCreated(request, target.InitWithNewPipeAndPassReceiver());
+    mojo::MakeSelfOwnedReceiver(std::make_unique<PreviewHeader>(preview_, false, std::move(target)), std::move(receiver));
+  }
+ private:
+  base::WeakPtr<NativeProjectPreview> preview_;
+  const bool navigation_;
+  mojo::Remote<network::mojom::TrustedURLLoaderHeaderClient> target_;
+};
+class PreviewRequest final : public network::mojom::URLLoader, public network::mojom::URLLoaderClient {
+ public:
+  PreviewRequest(mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      base::WeakPtr<NativeProjectPreview> preview, GURL url, bool navigation)
+      : client_(std::move(client)), receiver_(this, std::move(loader)), target_receiver_(this), preview_(preview),
+        url_(std::move(url)), navigation_(navigation) {
+    target_receiver_.set_disconnect_handler(base::BindOnce(&PreviewRequest::TargetDisconnected, base::Unretained(this)));
+    receiver_.set_disconnect_handler(base::BindOnce(&PreviewRequest::Cancel, base::Unretained(this)));
+    client_.set_disconnect_handler(base::BindOnce(&PreviewRequest::Cancel, base::Unretained(this)));
+  }
+  void Hold(std::shared_ptr<PreviewRequest> owned) { keep_alive_ = std::move(owned); }
+  mojo::PendingRemote<network::mojom::URLLoaderClient> Client() { return target_receiver_.BindNewPipeAndPassRemote(); }
+  mojo::PendingReceiver<network::mojom::URLLoader> Target() { return target_.BindNewPipeAndPassReceiver(); }
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams headers, const std::optional<GURL>& override_url) override {
+    if (!redirect_ || terminal_) { Reject(); return; }
+    const auto url = override_url.value_or(*redirect_);
+    ++pending_;
+    Check(preview_, url, navigation_, base::BindOnce([](base::WeakPtr<PreviewRequest> request,
+        network::HttpRequestHeadersUpdateParams headers, std::optional<GURL> override_url, GURL url, bool allowed) {
+      if (!request) return;
+      if (!allowed || request->terminal_) { request->Reject(); return; }
+      request->url_ = std::move(url); request->redirect_.reset();
+      request->target_->FollowRedirect(std::move(headers), override_url);
+      request->ReviewFinished();
+    }, weak_.GetWeakPtr(), std::move(headers), override_url, url));
+  }
+  void SetPriority(net::RequestPriority priority, int32_t value) override { if (target_ && !terminal_) target_->SetPriority(priority, value); }
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr hints) override {
+    if (!preview_ || !preview_->Current()) { Reject(); return; }
+    client_->OnReceiveEarlyHints(std::move(hints));
+  }
+  void OnReceiveResponse(network::mojom::URLResponseHeadPtr head, mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> metadata) override {
+    ++pending_;
+    Check(preview_, url_, navigation_, base::BindOnce([](base::WeakPtr<PreviewRequest> request,
+        network::mojom::URLResponseHeadPtr head, mojo::ScopedDataPipeConsumerHandle body,
+        std::optional<mojo_base::BigBuffer> metadata, bool allowed) {
+      if (!request) return;
+      if (!allowed || request->terminal_) { request->Reject(); return; }
+      request->client_->OnReceiveResponse(std::move(head), std::move(body), std::move(metadata));
+      request->ReviewFinished();
+    }, weak_.GetWeakPtr(), std::move(head), std::move(body), std::move(metadata)));
+  }
+  void OnReceiveRedirect(const net::RedirectInfo& info, network::mojom::URLResponseHeadPtr head) override {
+    ++pending_;
+    Check(preview_, info.new_url, navigation_, base::BindOnce([](base::WeakPtr<PreviewRequest> request,
+        net::RedirectInfo info, network::mojom::URLResponseHeadPtr head, bool allowed) {
+      if (!request) return;
+      if (!allowed || request->terminal_) { request->Reject(); return; }
+      request->redirect_ = info.new_url;
+      request->client_->OnReceiveRedirect(info, std::move(head));
+      request->ReviewFinished();
+    }, weak_.GetWeakPtr(), info, std::move(head)));
+  }
+  void OnUploadProgress(int64_t current, int64_t total, OnUploadProgressCallback callback) override {
+    if (!terminal_) client_->OnUploadProgress(current, total, std::move(callback));
+    else std::move(callback).Run();
+  }
+  void OnTransferSizeUpdated(int32_t size) override { if (!terminal_) client_->OnTransferSizeUpdated(size); }
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    if (terminal_) return;
+    completion_ = status;
+    FinishIfReady();
+  }
+ private:
+  void Release() {
+    receiver_.reset(); target_receiver_.reset(); target_.reset(); weak_.InvalidateWeakPtrs();
+    auto owned = std::move(keep_alive_);
+  }
+  void ReviewFinished() { --pending_; FinishIfReady(); }
+  void FinishIfReady() {
+    if (terminal_ || pending_ || !completion_) return;
+    terminal_ = true; client_->OnComplete(*completion_); Release();
+  }
+  void TargetDisconnected() {
+    if (!terminal_ && !completion_) Reject();
+    // OnComplete may precede the runtime review. Keep this actual request
+    // alive until its deferred response/redirect is admitted or refused.
+  }
+  void Cancel() { terminal_ = true; Release(); }
+  void Reject() {
+    if (terminal_) return;
+    terminal_ = true; client_->OnComplete(network::URLLoaderCompletionStatus(net::ERR_ACCESS_DENIED));
+    Release();
+  }
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  mojo::Receiver<network::mojom::URLLoader> receiver_;
+  mojo::Receiver<network::mojom::URLLoaderClient> target_receiver_;
+  std::shared_ptr<PreviewRequest> keep_alive_;
+  size_t pending_ = 0;
+  std::optional<network::URLLoaderCompletionStatus> completion_;
+  mojo::Remote<network::mojom::URLLoader> target_;
+  base::WeakPtr<NativeProjectPreview> preview_;
+  GURL url_;
+  const bool navigation_;
+  std::optional<GURL> redirect_;
+  bool terminal_ = false;
+  base::WeakPtrFactory<PreviewRequest> weak_{this};
+};
+class PreviewFactory final : public network::SelfDeletingURLLoaderFactory {
+ public:
+  PreviewFactory(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target,
+      base::WeakPtr<NativeProjectPreview> preview, base::SelfDeletingPassKey key)
+      : network::SelfDeletingURLLoaderFactory(std::move(receiver), key), target_(std::move(target)), preview_(preview) {
+    target_.set_disconnect_handler(base::BindOnce(&PreviewFactory::Lost, base::Unretained(this)));
+  }
+  void CreateLoaderAndStart(mojo::PendingReceiver<network::mojom::URLLoader> receiver, int32_t id, uint32_t options,
+      const network::ResourceRequest& request, mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& annotation) override {
+    const bool navigation = request.destination == network::mojom::RequestDestination::kDocument ||
+        request.destination == network::mojom::RequestDestination::kIframe;
+    Check(preview_, request.url, navigation, base::BindOnce([](base::WeakPtr<PreviewFactory> factory,
+        mojo::PendingReceiver<network::mojom::URLLoader> receiver, int32_t id, uint32_t options,
+        network::ResourceRequest request, mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+        net::MutableNetworkTrafficAnnotationTag annotation, bool allowed) {
+      if (!factory || !allowed) {
+        mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))->OnComplete(
+            network::URLLoaderCompletionStatus(net::ERR_ACCESS_DENIED)); return;
+      }
+      const bool navigation = request.destination == network::mojom::RequestDestination::kDocument ||
+          request.destination == network::mojom::RequestDestination::kIframe;
+      auto guard = std::make_shared<PreviewRequest>(std::move(receiver), std::move(client), factory->preview_, request.url, navigation);
+      guard->Hold(guard);
+      auto target = guard->Target();
+      auto guarded_client = guard->Client();
+      // Public asset hostnames must never resolve into another local service.
+      request.required_ip_address_space = net::IsLocalhost(request.url) ? network::mojom::IPAddressSpace::kLoopback : network::mojom::IPAddressSpace::kPublic;
+      factory->target_->CreateLoaderAndStart(std::move(target), id, options, request, std::move(guarded_client), annotation);
+    }, weak_.GetWeakPtr(), std::move(receiver), id, options, request, std::move(client), annotation));
+  }
+ private:
+  ~PreviewFactory() override = default;
+  void Lost() { DisconnectReceiversAndDestroy(); }
+  mojo::Remote<network::mojom::URLLoaderFactory> target_;
+  base::WeakPtr<NativeProjectPreview> preview_;
+  base::WeakPtrFactory<PreviewFactory> weak_{this};
+};
+class PreviewNavigation final : public content::NavigationThrottle {
+ public:
+  PreviewNavigation(content::NavigationThrottleRegistry& registry, base::WeakPtr<NativeProjectPreview> preview)
+      : content::NavigationThrottle(registry), preview_(preview) {}
+  ThrottleCheckResult WillStartRequest() override { return Review(); }
+  ThrottleCheckResult WillRedirectRequest() override { return Review(); }
+  const char* GetNameForLogging() override { return "AuxProjectPreview"; }
+ private:
+  ThrottleCheckResult Review() {
+    if (!preview_ || !preview_->Current()) return CANCEL_AND_IGNORE;
+    Check(preview_, navigation_handle()->GetURL(), true,
+        base::BindOnce([](base::WeakPtr<PreviewNavigation> navigation, bool allowed) {
+          if (!navigation) return;
+          if (allowed) navigation->Resume();
+          else navigation->CancelDeferredNavigation(CANCEL_AND_IGNORE);
+        }, weak_.GetWeakPtr()));
+    return DEFER;
+  }
+  base::WeakPtr<NativeProjectPreview> preview_;
+  base::WeakPtrFactory<PreviewNavigation> weak_{this};
+};
+}
+void NativeProjectPreview::ProxyFactory(content::RenderFrameHost* frame, int process_id, bool navigation, network::URLLoaderFactoryBuilder& builder,
+    mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient>* headers) {
+  auto* process = frame ? frame->GetProcess() : content::RenderProcessHost::FromID(process_id);
+  auto* partition = process ? process->GetStoragePartition() : nullptr;
+  if (!IsPreviewPartition(partition)) return;
+  if (headers) {
+    auto original = std::move(*headers);
+    mojo::MakeSelfOwnedReceiver(std::make_unique<PreviewFactoryHeaders>(ForPartition(partition), navigation, std::move(original)),
+        headers->InitWithNewPipeAndPassReceiver());
+  }
+  auto [receiver, target] = builder.Append();
+  base::MakeSelfDeleting<PreviewFactory>(std::move(receiver), std::move(target), headers ? ForPartition(partition) : base::WeakPtr<NativeProjectPreview>());
+}
+mojo::PendingRemote<network::mojom::TrustedHeaderClient> NativeProjectPreview::WrapHeaders(
+    base::WeakPtr<NativeProjectPreview> preview, mojo::PendingRemote<network::mojom::TrustedHeaderClient> target) {
+  mojo::PendingRemote<network::mojom::TrustedHeaderClient> wrapped;
+  mojo::MakeSelfOwnedReceiver(std::make_unique<PreviewHeader>(preview, false, std::move(target)),
+      wrapped.InitWithNewPipeAndPassReceiver());
+  return wrapped;
+}
+void NativeProjectPreview::AddNavigationThrottle(content::NavigationThrottleRegistry& registry) {
+  auto* contents = registry.GetNavigationHandle().GetWebContents();
+  auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+  auto* partition = frame ? frame->GetProcess()->GetStoragePartition() : nullptr;
+  if (IsPreviewPartition(partition)) registry.AddThrottle(std::make_unique<PreviewNavigation>(registry, ForPartition(partition)));
+}
+}
diff --git a/chrome/browser/ui/aux/native_terminal.cc b/chrome/browser/ui/aux/native_terminal.cc
--- a/chrome/browser/ui/aux/native_terminal.cc
+++ b/chrome/browser/ui/aux/native_terminal.cc
@@ -10,9 +10,12 @@
 #include <stdlib.h>
 #include <array>
 #include <optional>
+#include <algorithm>
 #include <vector>
 #include "base/base64.h"
 #include "base/environment.h"
+#include "base/uuid.h"
+#include "base/strings/strcat.h"
 #include "base/strings/string_number_conversions.h"
 #include "base/functional/bind.h"
 #include "base/task/thread_pool.h"
@@ -127,7 +130,77 @@
   if (flags < 0 || fcntl(master_, F_SETFL, flags | O_NONBLOCK) < 0 || fcntl(master_, F_SETFD, FD_CLOEXEC) < 0) {
     Retire(); *error = "Cannot configure terminal descriptor"; return false;
   }
+  if (!CaptureProjectProcess(pid_, &process_)) { Retire(); *error = "Original process identity is unavailable"; return false; }
+  cwd_ = cwd; device_ = device; inode_ = inode;
   return true;
+}
+bool NativeTerminal::PreviewCurrent(const NativeProjectListener& listener) const {
+  if (!Current() || closing_ || pid_ <= 0 || !ProjectListenerCurrent(process_, listener)) return false;
+  const int directory = open(cwd_.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  struct stat identity{};
+  const bool current = directory >= 0 && fstat(directory, &identity) == 0 &&
+      base::NumberToString(static_cast<uint64_t>(identity.st_dev)) == device_ &&
+      base::NumberToString(static_cast<uint64_t>(identity.st_ino)) == inode_;
+  if (directory >= 0) close(directory);
+  return current;
+}
+void NativeTerminal::Listeners(base::OnceCallback<void(base::DictValue)> callback) {
+  if (!Current() || closing_ || !ProjectProcessCurrent(process_)) {
+    std::move(callback).Run(Fault("Original terminal process retired")); return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&FindProjectListeners, process_), base::BindOnce(
+          [](base::WeakPtr<NativeTerminal> owner, base::OnceCallback<void(base::DictValue)> callback,
+             std::vector<NativeProjectListener> listeners) {
+            if (!owner || !owner->Current() || owner->closing_ || !ProjectProcessCurrent(owner->process_)) {
+              std::move(callback).Run(Fault("Original terminal process retired")); return;
+            }
+            base::ListValue result;
+            // Preserve opaque IDs only for the same live kernel socket; never reuse an old ID.
+            std::map<std::string, NativeProjectListener> admitted;
+            for (const auto& listener : listeners) {
+              if (!owner->PreviewCurrent(listener)) continue;
+              std::string id;
+              for (const auto& [old_id, old] : owner->listeners_) {
+                if (old.pid == listener.pid && old.fd == listener.fd && old.socket == listener.socket &&
+                    old.generation == listener.generation && old.started_seconds == listener.started_seconds &&
+                    old.started_microseconds == listener.started_microseconds) { id = old_id; break; }
+              }
+              if (id.empty()) id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+              admitted.emplace(id, listener);
+              result.Append(base::DictValue().Set("listenerId", id).Set("url",
