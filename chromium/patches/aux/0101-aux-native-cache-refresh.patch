+// Copyright 2026 Aux Authors. BSD-3-Clause; see //LICENSE.
+#include <iostream>
+
+#include "base/check.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "components/aux_adblock/engine_cache.h"
+int main() {
+  base::ScopedTempDir temporary;
+  CHECK(temporary.CreateUniqueTempDir());
+  const auto root = temporary.GetPath();
+  const auto path = root.AppendASCII("cache").AppendASCII("engine.bin");
+  const std::vector<aux_adblock::Source> sources = {
+      {"fixture", "||ads.test^$websocket\nsite.test##.advert"}};
+  auto [first, first_hit, first_size] =
+      aux_adblock::LoadOrBuildEngine(root, sources);
+  CHECK(first);
+  CHECK(!first_hit);
+  CHECK_GT(first_size, 0u);
+  CHECK(base::PathExists(path));
+  int mode;
+  CHECK(base::GetPosixFilePermissions(path, &mode));
+  CHECK_EQ(mode & 0777, 0600);
+  auto [second, second_hit, second_size] =
+      aux_adblock::LoadOrBuildEngine(root, sources);
+  CHECK(second);
+  CHECK(second_hit);
+  CHECK_EQ(first_size, second_size);
+  const aux_adblock::Request socket = {GURL("wss://ads.test/socket"),
+                                       GURL("https://site.test/"), "websocket",
+                                       "GET", true};
+  CHECK(first->Evaluate(socket).block);
+  CHECK_EQ(first->Evaluate(socket).ToValue(),
+           second->Evaluate(socket).ToValue());
+  CHECK_EQ(first->Cosmetics(GURL("https://site.test/")),
+           second->Cosmetics(GURL("https://site.test/")));
+  std::string original;
+  CHECK(base::ReadFileToString(path, &original));
+  auto corrupt = original;
+  corrupt[corrupt.size() / 2] ^= 1;
+  CHECK(base::WriteFile(path, corrupt));
+  CHECK(!std::get<1>(aux_adblock::LoadOrBuildEngine(root, sources)));
+  CHECK(base::WriteFile(path, original.substr(0, original.size() / 2)));
+  CHECK(!std::get<1>(aux_adblock::LoadOrBuildEngine(root, sources)));
+  auto changed = sources;
+  changed[0].text += "\n||other.test^";
+  CHECK(!std::get<1>(aux_adblock::LoadOrBuildEngine(root, changed)));
+  CHECK(std::get<1>(aux_adblock::LoadOrBuildEngine(root, changed)));
+  const auto state = root.AppendASCII("state.json");
+  CHECK(base::WriteFile(state, "fixture state retained"));
+  aux_adblock::ClearCache(root);
+  CHECK(!base::PathExists(path));
+  CHECK(base::PathExists(state));
+  CHECK(!std::get<1>(aux_adblock::LoadOrBuildEngine(root, changed)));
+  std::cout
+      << "Disposable native parsed-engine cache hit, source invalidation, "
+         "corruption/truncation fallback, WebSocket equivalence, permissions "
+         "and selective cache clear passed\n";
+}
