+std::string Engine::SerializeCache() const {
+  base::Pickle pickle;
+  pickle.WriteString("AuxParsedFilterEngine1");
+  pickle.WriteString(base::WriteJson(diagnostics_).value_or("[]"));
+  auto strings = [&](const auto& values) {
+    pickle.WriteInt(static_cast<int>(values.size()));
+    for (const auto& value : values) {
+      pickle.WriteString(value);
+    }
+  };
+  pickle.WriteInt(static_cast<int>(rules_.size()));
+  for (const auto& rule : rules_) {
+    pickle.WriteString(rule->text);
+    pickle.WriteString(rule->source);
+    pickle.WriteString(rule->host_key);
+    pickle.WriteInt(rule->line);
+    pickle.WriteBool(rule->exception);
+    pickle.WriteBool(rule->important);
+    pickle.WriteInt(rule->third_party ? (*rule->third_party ? 1 : 0) : -1);
+    strings(rule->types);
+    strings(rule->excluded);
+    strings(rule->domains);
+    pickle.WriteString(rule->regex->pattern());
+    pickle.WriteBool(rule->regex->options().case_sensitive());
+    pickle.WriteString(rule->redirect);
+    pickle.WriteString(rule->remove_param);
+    pickle.WriteString(rule->method);
+    if (pickle.size() > 64 * 1024 * 1024) {
+      return {};
+    }
+  }
+  pickle.WriteInt(static_cast<int>(cosmetics_.size()));
+  for (const auto& cosmetic : cosmetics_) {
+    strings(cosmetic->domains);
+    pickle.WriteBool(cosmetic->exception);
+    pickle.WriteString(cosmetic->selector);
+    pickle.WriteString(cosmetic->op);
+    pickle.WriteString(cosmetic->value);
+    if (pickle.size() > 64 * 1024 * 1024) {
+      return {};
+    }
+  }
+  if (pickle.size() > 64 * 1024 * 1024) {
+    return {};
+  }
+  return std::string(pickle.AsStringView());
+}
+std::shared_ptr<const Engine> Engine::RestoreCache(std::string_view data) {
+  if (data.empty() || data.size() > 64 * 1024 * 1024) {
+    return nullptr;
+  }
+  auto input = base::PickleIterator::WithData(base::as_byte_span(data));
+  auto text = [&](std::string* output, size_t max) {
+    std::string_view view;
+    if (!input.ReadStringPiece(&view) || view.size() > max ||
+        !base::IsStringUTF8(view) || view.find('\0') != view.npos) {
+      return false;
+    }
+    output->assign(view);
+    return true;
+  };
+  auto strings = [&](auto* output) {
+    int count;
+    if (!input.ReadInt(&count) || count < 0 || count > 8192) {
+      return false;
+    }
+    for (int i = 0; i < count; ++i) {
+      std::string value;
+      if (!text(&value, 8192)) {
+        return false;
+      }
+      output->insert(output->end(), std::move(value));
+    }
+    return true;
+  };
+  std::string version, diagnostics;
+  if (!text(&version, 64) || version != "AuxParsedFilterEngine1" ||
+      !text(&diagnostics, 8 * 1024 * 1024)) {
+    return nullptr;
+  }
+  auto parsed = base::JSONReader::Read(diagnostics, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_list() || parsed->GetList().size() > 129) {
+    return nullptr;
+  }
+  for (const auto& value : parsed->GetList()) {
+    if (!value.is_dict() || !value.GetDict().FindString("id") ||
+        !value.GetDict().FindInt("networkRuleCount") ||
+        !value.GetDict().FindInt("cosmeticRuleCount") ||
+        !value.GetDict().FindInt("parseErrorCount") ||
+        !value.GetDict().FindList("invalidLines")) {
+      return nullptr;
+    }
+  }
+  auto engine = std::shared_ptr<Engine>(new Engine);
+  engine->diagnostics_ = std::move(parsed->GetList());
+  int count;
+  if (!input.ReadInt(&count) || count < 0 || count > 50000) {
+    return nullptr;
+  }
+  size_t compiled_memory = 0;
+  for (int i = 0; i < count; ++i) {
+    auto rule = std::make_unique<Rule>();
+    std::string regex;
+    bool match_case;
+    int party;
+    if (!text(&rule->text, 8192) || !text(&rule->source, 8192) ||
+        !text(&rule->host_key, 8192) || !input.ReadInt(&rule->line) ||
+        rule->line < 1 || !input.ReadBool(&rule->exception) ||
+        !input.ReadBool(&rule->important) || !input.ReadInt(&party) ||
+        party < -1 || party > 1 || !strings(&rule->types) ||
+        !strings(&rule->excluded) || !strings(&rule->domains) ||
+        !text(&regex, 32768) || !input.ReadBool(&match_case) ||
+        !text(&rule->redirect, 32) || !text(&rule->remove_param, 8192) ||
+        !text(&rule->method, 128)) {
+      return nullptr;
+    }
+    if (party != -1) {
+      rule->third_party = party == 1;
+    }
+    RE2::Options options;
+    options.set_log_errors(false);
+    options.set_case_sensitive(match_case);
+    options.set_max_mem(64 * 1024);
+    rule->regex = std::make_unique<RE2>(regex, options);
+    if (!rule->regex->ok()) {
+      return nullptr;
+    }
+    compiled_memory += static_cast<size_t>(rule->regex->ProgramSize()) * 64;
+    if (compiled_memory > 64 * 1024 * 1024) {
+      return nullptr;
+    }
+    if (rule->host_key.empty()) {
+      engine->global_rules_.push_back(rule.get());
+    } else {
+      engine->host_index_[rule->host_key].push_back(rule.get());
+    }
+    engine->rules_.push_back(std::move(rule));
+  }
+  if (!input.ReadInt(&count) || count < 0 || count > 50000) {
+    return nullptr;
+  }
+  for (int i = 0; i < count; ++i) {
+    auto rule = std::make_unique<Cosmetic>();
+    if (!strings(&rule->domains) || !input.ReadBool(&rule->exception) ||
+        !text(&rule->selector, 2048) || !SafeSelector(rule->selector) ||
+        !text(&rule->op, 32) || !text(&rule->value, 8192) ||
+        (!rule->op.empty() && rule->op != ":has-text(" &&
+         rule->op != ":matches-attr(" && rule->op != ":matches-css(")) {
+      return nullptr;
+    }
+    engine->cosmetics_.push_back(std::move(rule));
+  }
+  return input.ReachedEnd() ? engine : nullptr;
+}
