@@ -0,0 +1,66 @@
+// Copyright 2026 Aux Authors. BSD-3-Clause; see //LICENSE.
+#include "components/aux_adblock/engine_cache.h"
+
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/pickle.h"
+#include "base/strings/string_number_conversions.h"
+#include "crypto/hash.h"
+
+namespace aux_adblock {
+EngineBuild LoadOrBuildEngine(base::FilePath directory,
+                              std::vector<Source> sources) {
+  constexpr size_t limit = 64 * 1024 * 1024;
+  base::Pickle identity;
+  identity.WriteString("AuxParsedFilterEngine1");
+  for (const auto& source : sources) {
+    identity.WriteString(source.id);
+    identity.WriteString(source.text);
+  }
+  const auto key = base::HexEncode(crypto::hash::Sha256(identity.AsBytes()));
+  const auto cache_directory = directory.AppendASCII("cache");
+  const auto path = cache_directory.AppendASCII("engine.bin");
+  const bool safe = !base::IsLink(directory) &&
+                    !base::IsLink(cache_directory) && !base::IsLink(path);
+  std::string stored;
+  if (safe && base::ReadFileToStringWithMaxSize(path, &stored, limit + 1024)) {
+    auto input = base::PickleIterator::WithData(base::as_byte_span(stored));
+    std::string_view stored_key, digest, payload;
+    if (input.ReadStringPiece(&stored_key) && stored_key == key &&
+        input.ReadStringPiece(&digest) && digest.size() == 64 &&
+        input.ReadStringPiece(&payload) && payload.size() <= limit &&
+        input.ReachedEnd() &&
+        digest == base::HexEncode(crypto::hash::Sha256(payload))) {
+      if (auto engine = Engine::RestoreCache(payload)) {
+        return {std::move(engine), true, payload.size()};
+      }
+    }
+  }
+  auto engine = Engine::Compile(sources);
+  if (!engine) {
+    return {nullptr, false, 0};
+  }
+  const auto payload = engine->SerializeCache();
+  if (!payload.empty() && safe && base::CreateDirectory(cache_directory) &&
+      base::SetPosixFilePermissions(directory, 0700) &&
+      base::SetPosixFilePermissions(cache_directory, 0700)) {
+    base::Pickle output;
+    output.WriteString(key);
+    output.WriteString(base::HexEncode(crypto::hash::Sha256(payload)));
+    output.WriteString(payload);
+    if (base::ImportantFileWriter::WriteFileAtomically(path,
+                                                       output.AsStringView())) {
+      base::SetPosixFilePermissions(path, 0600);
+    }
+  }
+  return {std::move(engine), false, payload.size()};
+}
+void ClearCache(const base::FilePath& directory) {
+  const auto cache = directory.AppendASCII("cache");
+  if (!base::IsLink(directory) && !base::IsLink(cache)) {
+    // Delete only our exact cache entry; subscriptions and custom rules
+    // survive.
+    base::DeleteFile(cache.AppendASCII("engine.bin"));
+  }
+}
+}  // namespace aux_adblock
