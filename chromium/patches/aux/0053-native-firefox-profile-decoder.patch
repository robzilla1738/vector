new file mode 100644
index 0000000..d7b36c4
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_firefox_snapshot.cc
@@ -0,0 +1,61 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_firefox_snapshot.h"
+#include <fcntl.h>
+#include <cerrno>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <algorithm>
+#include "base/files/scoped_file.h"
+#include "base/posix/eintr_wrapper.h"
+namespace aux {
+DecodedBrowserProfile PrepareFirefoxSnapshot(const base::FilePath& source,
+    const std::vector<std::string>& categories, const base::RepeatingCallback<bool()>& cancelled) {
+  DecodedBrowserProfile result;
+  const bool places = std::ranges::find(categories, "history") != categories.end() || std::ranges::find(categories, "bookmarks") != categories.end();
+  const bool tabs = std::ranges::find(categories, "tabs") != categories.end();
+  std::vector<std::string> files;
+  if (places) files = {"places.sqlite", "places.sqlite-wal", "places.sqlite-journal"};
+  if (tabs) files.push_back("sessionstore.jsonlz4");
+  auto captured = BrowserProfileSnapshot::Capture(source, files, false, cancelled, tabs);
+  if (!captured.has_value()) { result.snapshot_error = captured.error(); return result; }
+  result.snapshot = std::move(*captured);
+  base::ScopedFD directory(HANDLE_EINTR(open(result.snapshot->path().value().c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+  auto file = [&](const char* name, bool create) {
+    const int flags = O_RDWR | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC;
+    int fd = HANDLE_EINTR(openat(directory.get(), name, flags));
+    if (fd < 0 && create && errno == ENOENT) fd = HANDLE_EINTR(openat(directory.get(), name, flags | O_CREAT | O_EXCL, 0600));
+    base::File held(fd);
+    base::File::Info info;
+    if (!held.IsValid() || !held.GetInfo(&info) || info.is_directory || info.size < 0 || info.size > 1024LL * 1024 * 1024) return base::File();
+    return held;
+  };
+  if (places) {
+    result.firefox_database = file("places.sqlite", false);
+    result.firefox_wal = file("places.sqlite-wal", true);
+    result.firefox_journal = file("places.sqlite-journal", true);
+    if (!result.firefox_database.IsValid() || !result.firefox_wal.IsValid() || !result.firefox_journal.IsValid()) result.snapshot_error = "The Firefox private database handles are unavailable.";
+  }
+  if (tabs) {
+    base::File session(HANDLE_EINTR(openat(directory.get(), "sessionstore.jsonlz4", O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)));
+    if (!session.IsValid() && errno == ENOENT) {
+      base::ScopedFD recovery(HANDLE_EINTR(openat(directory.get(), "sessionstore-backups", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+      if (recovery.is_valid()) {
+        session = base::File(HANDLE_EINTR(openat(recovery.get(), "recovery.jsonlz4", O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)));
+        if (!session.IsValid() && errno == ENOENT) session = base::File(HANDLE_EINTR(openat(recovery.get(), "recovery.baklz4", O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)));
+      }
+    }
+    const int64_t length = session.IsValid() ? session.GetLength() : -1;
+    if (length < 12 || length > 32 * 1024 * 1024) result.snapshot_error = "A current Firefox session snapshot is unavailable.";
+    else {
+      mojo_base::BigBuffer bytes(static_cast<size_t>(length));
+      const auto read = session.Read(0, base::span(bytes));
+      if (!read || *read != bytes.size()) result.snapshot_error = "The Firefox session snapshot could not be read completely.";
+      else result.firefox_session = std::move(bytes);
+    }
+  }
+  if (cancelled.Run() || !result.snapshot->OriginalIsCurrent()) result.snapshot_error = "The original Firefox Profile changed or its import was retired.";
+  return result;
+}
+}  // namespace aux
