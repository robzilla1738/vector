+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_BROWSER_FIREFOX_IMPORT_H_
+#define CHROME_BROWSER_UI_AUX_BROWSER_FIREFOX_IMPORT_H_
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/service_process_host.h"
+#include "base/types/expected.h"
+#include "chrome/browser/ui/aux/browser_profile_decode.h"
+#include "chrome/common/importer/aux_firefox_profile.mojom.h"
+#include "components/user_data_importer/common/imported_bookmark_entry.h"
+#include "mojo/public/cpp/bindings/remote.h"
+namespace aux {
+struct FirefoxImportResult {
+  std::vector<ImportedProfileHistory> history;
+  std::vector<user_data_importer::ImportedBookmarkEntry> bookmarks;
+  std::vector<ImportedProfileTab> tabs;
+};
+// Retained by the original BrowserProfileImporter job until actual kService
+// decoding finishes. Cancellation retires effects, never fabricates a join.
+class BrowserFirefoxImport final : public content::ServiceProcessHost::Observer {
+ public:
+  using Completed = base::OnceCallback<void(base::expected<FirefoxImportResult, std::string>)>;
+  BrowserFirefoxImport();
+  ~BrowserFirefoxImport() override;
+  void Start(DecodedBrowserProfile& captured, const std::vector<std::string>& categories, Completed completed);
+  void OnServiceProcessTerminatedNormally(const content::ServiceProcessInfo& info) override;
+  void OnServiceProcessCrashed(const content::ServiceProcessInfo& info) override;
+ private:
+  void OnDecoded(chrome::mojom::AuxFirefoxProfileResultPtr result);
+  void OnDisconnected();
+  mojo::Remote<chrome::mojom::AuxFirefoxProfileDecoder> decoder_;
+  Completed completed_;
+  bool process_retired_ = false;
+  base::WeakPtrFactory<BrowserFirefoxImport> weak_factory_{this};
+};
+}  // namespace aux
+#endif
