+#include "components/user_data_importer/common/imported_bookmark_entry.h"
+#include "components/user_data_importer/common/importer_data_types.h"
+#include "sql/database.h"
+namespace aux {
+namespace {
+constexpr size_t kMaximumEntries = 200000;
+constexpr size_t kMaximumSession = 64 * 1024 * 1024;
+bool AllowedUrl(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && !url.has_username() && !url.has_password() && url.spec().size() <= 8192;
+}
+class Collection final : public ImporterBridge {
+ public:
+  explicit Collection(chrome::mojom::AuxFirefoxProfileResult* result) : result_(result) {}
+  bool Complete(uint16_t items) const { return started_ && ended_ && ended_items_ == items && !failed_; }
+  void AddBookmarks(const std::vector<user_data_importer::ImportedBookmarkEntry>& entries, const std::u16string&) override {
+    if (entries.size() > kMaximumEntries) { failed_ = true; return; }
+    for (const auto& entry : entries) {
+      if (entry.path.size() > 128 || entry.title.size() > 4096) { failed_ = true; return; }
+      if (!entry.is_folder && !AllowedUrl(entry.url)) continue;
+      auto value = chrome::mojom::AuxFirefoxBookmark::New();
+      value->url = entry.url; value->title = base::UTF16ToUTF8(entry.title); value->is_folder = entry.is_folder;
+      for (const auto& part : entry.path) {
+        if (part.size() > 4096) { failed_ = true; return; }
+        value->path.push_back(base::UTF16ToUTF8(part));
+      }
+      result_->bookmarks.push_back(std::move(value));
+    }
+  }
+  void SetHistoryItems(const std::vector<user_data_importer::ImporterURLRow>& rows, user_data_importer::VisitSource) override {
+    if (rows.size() > kMaximumEntries) { failed_ = true; return; }
+    for (const auto& row : rows) {
+      if (!AllowedUrl(row.url)) continue;
+      if (row.title.size() > 4096 || row.last_visit.is_null()) { failed_ = true; return; }
+      auto value = chrome::mojom::AuxFirefoxHistory::New(); value->url = row.url;
+      value->title = base::UTF16ToUTF8(row.title); value->visited_at = row.last_visit.InMillisecondsFSinceUnixEpochIgnoringNull();
+      if (!std::isfinite(value->visited_at) || value->visited_at < 0) { failed_ = true; return; }
+      result_->history.push_back(std::move(value));
+    }
+  }
+  void AddHomePage(const GURL&) override { failed_ = true; }
+  void SetFavicons(const favicon_base::FaviconUsageDataList&) override {}
+  void SetKeywords(const std::vector<user_data_importer::SearchEngineInfo>&, bool) override {}
+  void SetPasswordForm(const user_data_importer::ImportedPasswordForm&) override { failed_ = true; }
+  void SetAutofillFormData(const std::vector<ImporterAutofillFormDataEntry>&) override { failed_ = true; }
+  void NotifyStarted() override { if (started_) failed_ = true; started_ = true; }
+  void NotifyItemStarted(user_data_importer::ImportItem item) override { if (started_items_ & item) failed_ = true; started_items_ |= item; }
+  void NotifyItemEnded(user_data_importer::ImportItem item) override { if (!(started_items_ & item) || (ended_items_ & item)) failed_ = true; ended_items_ |= item; }
+  void NotifyEnded() override { if (ended_) failed_ = true; ended_ = true; }
+  std::u16string GetLocalizedString(int) override { return u"Firefox"; }
+ private:
+  ~Collection() override = default;
+  raw_ptr<chrome::mojom::AuxFirefoxProfileResult> result_;
+  uint16_t started_items_ = 0, ended_items_ = 0;
+  bool started_ = false, ended_ = false, failed_ = false;
+};
+bool DecodeTabs(const mojo_base::BigBuffer& buffer, chrome::mojom::AuxFirefoxProfileResult& result) {
+  // Mozilla ReadFileLZ4: eight-byte mozLz40\0 magic, LE32 expanded size,
+  // followed by a raw LZ4 block. The maintained system decoder runs in kService.
+  constexpr char magic[] = "mozLz40";
+  const auto data = base::span(buffer);
+  if (data.size() < 12 || data.size() > 32 * 1024 * 1024 ||
+      data.first<sizeof(magic)>() != base::as_byte_span(magic)) {
+    return false;
+  }
+  const uint32_t length = base::U32FromLittleEndian(data.subspan<8, 4>());
+  if (!length || length > kMaximumSession) return false;
+  std::string json(length, '\0');
+  const auto compressed = data.subspan<12>();
+  const auto output = base::as_writable_byte_span(json);
+  if (compression_decode_buffer(output.data(), output.size(), compressed.data(),
+                                compressed.size(), nullptr,
+                                COMPRESSION_LZ4_RAW) != length) {
+    return false;
+  }
+  auto state = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!state) return false;
+  const auto* version = state->FindList("version"); const auto* windows = state->FindList("windows");
+  if (!version || version->size() != 2 || !(*version)[0].is_string() || (*version)[0].GetString() != "sessionrestore" || !(*version)[1].is_int() || (*version)[1].GetInt() != 1 || !windows || windows->size() > 1024) return false;
+  size_t count = 0;
+  size_t decoded_bytes = 0;
+  for (size_t window_index = 0; window_index < windows->size(); ++window_index) {
+    const auto* window = (*windows)[window_index].GetIfDict(); if (!window) return false;
+    const auto* private_value = window->Find("isPrivate");
+    if (private_value && !private_value->is_bool()) return false;
+    if (private_value && private_value->GetBool()) continue;
+    const auto* tabs = window->FindList("tabs"); if (!tabs) return false;
+    for (const auto& raw_tab : *tabs) {
+      if (++count > 10000) return false;
+      const auto* tab = raw_tab.GetIfDict(); if (!tab) return false;
+      private_value = tab->Find("isPrivate");
+      if (private_value && !private_value->is_bool()) return false;
+      if (private_value && private_value->GetBool()) continue;
+      const auto* entries = tab->FindList("entries"); const auto index = tab->FindInt("index");
+      if (!entries || !index || *index < 1 || size_t(*index) > entries->size()) { if (entries && entries->empty()) continue; return false; }
+      const auto* entry = (*entries)[*index - 1].GetIfDict(); if (!entry) return false;
+      const auto* url = entry->FindString("url"); if (!url) return false;
+      GURL target(*url); if (!AllowedUrl(target)) continue;
+      const auto* title = entry->Find("title"); const auto* pinned = tab->Find("pinned");
+      if ((title && (!title->is_string() || title->GetString().size() > 4096)) || (pinned && !pinned->is_bool())) return false;
+      const size_t bytes = target.spec().size() + (title ? title->GetString().size() : 0);
+      if (bytes > 64 * 1024 * 1024 - decoded_bytes) return false;
+      decoded_bytes += bytes;
+      auto value = chrome::mojom::AuxFirefoxTab::New(); value->url = std::move(target);
+      value->title = title ? title->GetString() : ""; value->pinned = pinned && pinned->GetBool();
+      // Captured session window grouping, never a foreign live window handle.
+      value->window_id = static_cast<int32_t>(window_index);
+      result.tabs.push_back(std::move(value));
+    }
+  }
+  return true;
+}
+}  // namespace
+FirefoxProfileDecoder::FirefoxProfileDecoder(mojo::PendingReceiver<chrome::mojom::AuxFirefoxProfileDecoder> receiver) : receiver_(this, std::move(receiver)) {}
+FirefoxProfileDecoder::~FirefoxProfileDecoder() = default;
+void FirefoxProfileDecoder::Decode(base::File database, base::File wal, base::File journal, std::optional<mojo_base::BigBuffer> session, bool history, bool bookmarks, bool tabs, DecodeCallback callback) {
+  auto result = chrome::mojom::AuxFirefoxProfileResult::New();
+  bool valid = history || bookmarks || tabs;
+  if (valid && (history || bookmarks)) {
+    valid = database.IsValid() && wal.IsValid() && journal.IsValid();
+    if (valid) {
+      FirefoxPrivateVfsScope files(std::move(database), std::move(wal), std::move(journal));
+      valid = files.valid();
+      if (valid) {
+        sql::Database db(sql::DatabaseOptions().set_exclusive_locking(true).set_vfs_name_discouraged(files.name()).set_wal_mode(true).set_mmap_enabled(false), sql::Database::Tag{"FirefoxImporter"});
+        valid = db.Open(files.path()) && db.Execute("PRAGMA temp_store=MEMORY") && db.DoesTableExist("moz_places") && (!history || db.DoesTableExist("moz_historyvisits")) && (!bookmarks || db.DoesTableExist("moz_bookmarks")) && db.CheckpointDatabase(true);
+        db.Close();
+      }
+      if (valid) {
+        auto importer = base::MakeRefCounted<FirefoxImporter>(); auto bridge = base::MakeRefCounted<Collection>(result.get());
+        importer->SetAuxSnapshot(files.path(), files.name());
+        user_data_importer::SourceProfile source; source.source_path = files.path().DirName(); source.importer_type = user_data_importer::TYPE_FIREFOX;
