+  Decode(mojo_base.mojom.File? database, mojo_base.mojom.File? wal,
+         mojo_base.mojom.File? journal, mojo_base.mojom.BigBuffer? session,
+         bool history, bool bookmarks, bool tabs) => (AuxFirefoxProfileResult result);
+};
