+        importer->StartImport(source, items, bridge.get());
+        valid = bridge->Complete(items) && !importer->AuxSnapshotFailed();
+        // Both decoders and their SQLite handles close before the VFS scope and
+        // before the completion receipt. No stock Cancel() can fake this join.
+      }
+    }
+  }
+  if (valid && tabs) valid = session && DecodeTabs(*session, *result);
+  if (!valid) { result->history.clear(); result->bookmarks.clear(); result->tabs.clear(); result->error = "Firefox source data could not be safely decoded"; }
+  std::move(callback).Run(std::move(result));
+}
+}  // namespace aux
