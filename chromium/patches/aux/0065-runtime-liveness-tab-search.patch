+void AuxRuntimeHost::RuntimeResponsivenessChanged(uint64_t generation,
+                                                   bool responsive) {
+  if (shutting_down_ || !generation || generation != admitted_native_generation_ ||
+      generation <= retired_native_generation_ || runtime_responsive_ == responsive) {
+    return;
+  }
+  // Responsiveness is presentation state, never connection or action authority.
+  // Keep the original generation, receipts, socket and pending effects intact.
+  runtime_responsive_ = responsive;
+  observers_.Notify("onRuntimeStatus", responsive
+      ? "{\"connected\":true}"
+      : "{\"connected\":false,\"detail\":\"Runtime is not responding\"}");
+}
