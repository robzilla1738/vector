+void AuxRuntimeHost::Worker::ProbeLiveness() {
+  if (connection_fd_ < 0 || !connection_generation_ || liveness_pending_) {
+    return;
+  }
+  liveness_pending_ = true;
+  const std::string nonce = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  base::DictValue params;
+  params.Set("nonce", nonce);
+  CallInternal("runtime.liveness", *base::WriteJson(params),
+      base::BindOnce(&Worker::LivenessReply, weak_factory_.GetWeakPtr(),
+                     connection_generation_, nonce));
+}
+
+void AuxRuntimeHost::Worker::LivenessReply(uint64_t generation,
+                                           std::string nonce,
+                                           Response response) {
+  if (connection_fd_ < 0 || generation != connection_generation_) {
+    return;
+  }
+  liveness_pending_ = false;
+  const auto result = response.ok
+      ? base::JSONReader::ReadDict(response.result_json, base::JSON_PARSE_RFC)
+      : std::nullopt;
+  const auto* echoed = result ? result->FindString("nonce") : nullptr;
+  const bool responsive = echoed && *echoed == nonce && result->size() == 1;
+  ui_runner_->PostTask(FROM_HERE,
+      base::BindOnce(&AuxRuntimeHost::RuntimeResponsivenessChanged, owner_,
+                     generation, responsive));
+  // A timed-out child may resume. Probe that same connection; do not restart it.
+  liveness_timer_.Start(FROM_HERE, base::Seconds(5), this, &Worker::ProbeLiveness);
+}
