@@ -0,0 +1,823 @@
+// Copyright 2026 Aux Authors. All rights reserved.
+// Independent owned AutocompleteController sessions: native/omnibox O1-O4.
+#include "chrome/browser/extensions/api/aux_omnibox/aux_omnibox_api.h"
+
+#include <algorithm>
