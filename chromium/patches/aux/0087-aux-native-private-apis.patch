From: Aux clean-room build
Subject: [PATCH 0087] Native account, browser preferences, notification, omnibox and popup APIs

Specs: docs/spec/native/apis-core.md A0-A4; native/omnibox.md O1-O4; native/platform.md P1-P3.
Independent implementation using public upstream Chromium APIs. Remaining acceptance gaps are recorded separately.

diff --git a/chrome/browser/aux/daemon_supervisor.cc b/chrome/browser/aux/daemon_supervisor.cc
--- a/chrome/browser/aux/daemon_supervisor.cc
+++ b/chrome/browser/aux/daemon_supervisor.cc
@@ -3,12 +3,14 @@
 #include "chrome/browser/aux/daemon_supervisor.h"
 
 #include "base/command_line.h"
+#include "base/environment.h"
 #include "base/files/file_util.h"
 #include "base/functional/bind.h"
 #include "base/json/json_reader.h"
 #include "base/json/json_writer.h"
 #include "base/path_service.h"
 #include "base/process/launch.h"
+#include "base/process/process_handle.h"
 #include "base/strings/string_number_conversions.h"
 #include "base/task/thread_pool.h"
 #include "chrome/browser/aux/installation_auth.h"
@@ -48,6 +50,27 @@
   base::LaunchOptions options;
   options.environment["AUX_HOME"] = home.value();
   options.environment["AUX_PORT"] = base::NumberToString(port);
+  options.environment["AUX_BROWSER_PID"] =
+      base::NumberToString(base::GetCurrentProcId());
+  options.environment["AUX_HELPER_PATH"] =
+      paths.root
+          .AppendASCII(
+              "apps/computer-use/Aux Computer "
+              "Use.app/Contents/MacOS/aux-computer-use")
+          .value();
+  options.environment["AUX_EMBEDDING_MODEL_DIR"] =
+      paths.root.AppendASCII("apps/memory/models/minilm").value();
+  const base::FilePath runtime = paths.root.AppendASCII("runtime");
+  std::string path =
+      runtime.value() + ":" + runtime.AppendASCII("python/bin").value();
+  if (auto inherited = base::Environment::Create()->GetVar("PATH")) {
+    path += ":" + *inherited;
+  }
+  options.environment["PATH"] = path;
+  options.environment["FONTCONFIG_PATH"] =
+      runtime.AppendASCII("poppler/etc/fonts").value();
+  options.environment["FONTCONFIG_FILE"] =
+      runtime.AppendASCII("poppler/etc/fonts/fonts.conf").value();
   options.current_directory = paths.root;
   return base::LaunchProcess(command, options);
 }
