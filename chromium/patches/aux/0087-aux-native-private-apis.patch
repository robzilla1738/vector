+// Copyright 2026 Aux Authors. All rights reserved.
+#include "chrome/browser/extensions/api/aux_notification/aux_notification_api.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/permission_controller.h"
+#include "content/public/browser/permission_request_description.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/permissions/permission_utils.h"
+#include "third_party/blink/public/mojom/permissions/permission.mojom.h"
+#include "url/origin.h"
+namespace extensions {
+ExtensionFunction::ResponseAction AuxNotificationFunction::RunAux() {
+  if (args().size() != 1) {
+    return RespondNow(Error("One permission target is required"));
+  }
+  if (std::string_view(name()) == "auxNotification.revokePermission") {
+    if (!args()[0].is_string()) {
+      return RespondNow(Error("Origin string required"));
+    }
+    const GURL url(args()[0].GetString());
+    const auto origin = url::Origin::Create(url);
+    if (!url.SchemeIsHTTPOrHTTPS() || origin.opaque() ||
+        url != origin.GetURL()) {
+      return RespondNow(Error("A valid web origin is required"));
+    }
+    profile()->GetPermissionController()->ResetPermission(
+        blink::PermissionType::NOTIFICATIONS, origin);
+    return RespondNow(WithArguments(true));
+  }
+  if (!args()[0].is_int()) {
+    return RespondNow(Error("Tab identity required"));
+  }
+  content::WebContents* tab = nullptr;
+  if (!ExtensionTabUtil::GetTabById(args()[0].GetInt(), profile(), false,
+                                    &tab) ||
+      !tab || tab->GetBrowserContext() != profile()) {
+    return RespondNow(Error("Tab is unavailable in this profile"));
+  }
+  auto* frame = tab->GetPrimaryMainFrame();
+  if (!frame ||
+      !frame->GetLastCommittedOrigin().GetURL().SchemeIsHTTPOrHTTPS()) {
+    return RespondNow(
+        Error("Notification permission requires an active web origin"));
+  }
+  if (!user_gesture()) {
+    return RespondNow(Error("Notification permission requires a user gesture"));
+  }
+  auto descriptor = blink::mojom::PermissionDescriptor::New();
+  descriptor->name = blink::mojom::PermissionName::NOTIFICATIONS;
+  profile()->GetPermissionController()->RequestPermissionFromCurrentDocument(
+      frame, content::PermissionRequestDescription(std::move(descriptor), true),
+      base::BindOnce(&AuxNotificationFunction::DidRequest,
+                     base::RetainedRef(this)));
+  return RespondLater();
+}
+void AuxNotificationFunction::DidRequest(content::PermissionResult result) {
+  Respond(
+      WithArguments(result.status == blink::mojom::PermissionStatus::GRANTED));
+}
+}  // namespace extensions
