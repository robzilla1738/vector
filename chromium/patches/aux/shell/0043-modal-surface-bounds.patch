 gfx::Rect WebUIBrowserWindow::GetContentsBoundsInScreen() const {
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+  // Aux owns its DOM layout rather than Webium's tracked content element.
+  // SurfaceEmbed supplies the active guest's real screen bounds, including
+  // sidebar insets. Home and a not-yet-rendered guest use the shell client area.
+  const gfx::Rect client_bounds = widget_->GetClientAreaBoundsInScreen();
+  auto* contents = browser_->GetTabStripModel()->GetActiveWebContents();
+  auto* view = contents ? contents->GetRenderWidgetHostView() : nullptr;
+  if (view) {
+    gfx::Rect page_bounds = view->GetViewBounds();
+    page_bounds.Intersect(client_bounds);
+    if (!page_bounds.IsEmpty()) return page_bounds;
+  }
+  return client_bounds;
+#else
   ui::TrackedElement* content_region =
       ui::ElementTracker::GetElementTracker()->GetFirstMatchingElement(
           kContentsContainerViewElementId,
           views::ElementTrackerViews::GetContextForWidget(widget_.get()));
   return content_region ? content_region->GetScreenBounds() : gfx::Rect();
+#endif
 }
 
