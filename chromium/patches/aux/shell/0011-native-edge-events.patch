+// Observes mouse motion over the entire native browser window, including an
+// embedded page surface. WebUI mousemove cannot see events consumed by the
+// SurfaceEmbed guest, so the shell needs this narrow native edge signal.
+class AuxShellEdgeMonitor : public ui::EventObserver {
+ public:
+  AuxShellEdgeMonitor(WebUIBrowserWindow* window,
+                      base::RepeatingCallback<void(bool, bool)> on_edges)
+      : window_(window), on_edges_(std::move(on_edges)) {
+    monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, window_->widget()->GetNativeWindow(),
+        {ui::EventType::kMouseMoved});
+  }
+
+  void OnEvent(const ui::Event& event) override {
+    if (!event.IsMouseEvent()) {
+      return;
+    }
+    const gfx::Rect bounds = window_->widget()->GetWindowBoundsInScreen();
+    const gfx::Point cursor =
+        display::Screen::Get()->GetCursorScreenPoint();
+    const bool inside = window_->widget()->IsActive() &&
+                        bounds.Contains(cursor);
+    const bool sidebar = inside && cursor.x() - bounds.x() <= 8;
+    const bool toolbar = inside && cursor.y() - bounds.y() <= 8;
+    if (sidebar == sidebar_ && toolbar == toolbar_) {
+      return;
+    }
+    sidebar_ = sidebar;
+    toolbar_ = toolbar;
+    on_edges_.Run(sidebar, toolbar);
+  }
+
+ private:
+  raw_ptr<WebUIBrowserWindow> window_;
+  base::RepeatingCallback<void(bool, bool)> on_edges_;
+  std::unique_ptr<views::EventMonitor> monitor_;
+  bool sidebar_ = false;
+  bool toolbar_ = false;
+};
+#endif
