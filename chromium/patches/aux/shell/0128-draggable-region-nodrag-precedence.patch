@@ -50,7 +50,17 @@ void WebUIBrowserClientView::AddedToWidget() {
 }
 
 int WebUIBrowserClientView::NonClientHitTest(const gfx::Point& point) {
-  if (draggable_region_.contains(point.x(), point.y())) {
+  // Draggable regions are in the shell WebView's coordinates. The hit-test
+  // point is in this client view's coordinates, which match only when the
+  // WebView fills the client view at the origin.
+  gfx::Point point_in_contents = point;
+  views::View* contents = contents_view();
+  if (contents && contents->GetWidget()) {
+    point_in_contents =
+        views::View::ConvertPointToTarget(this, contents, point);
+  }
+  if (draggable_region_.contains(point_in_contents.x(),
+                                 point_in_contents.y())) {
     return HTCAPTION;
   }
   return ClientView::NonClientHitTest(point);
@@ -72,11 +82,26 @@ void WebUIBrowserClientView::OnLocationIconMoved(ui::TrackedElement* element) {
 void WebUIBrowserClientView::DraggableRegionsChanged(
     const std::vector<blink::mojom::DraggableRegionPtr>& regions) {
   SkRegion draggable_region;
+  // Union every draggable rect, then subtract every no-drag rect. Blink reports
+  // regions in preorder, so applying each op as it arrives lets a later drag
+  // rect cover a control that already opted out.
+  for (const blink::mojom::DraggableRegionPtr& region : regions) {
+    if (!region->draggable) {
+      continue;
+    }
+    draggable_region.op(
+        SkIRect::MakeXYWH(region->bounds.x(), region->bounds.y(),
+                          region->bounds.width(), region->bounds.height()),
+        SkRegion::kUnion_Op);
+  }
   for (const blink::mojom::DraggableRegionPtr& region : regions) {
+    if (region->draggable) {
+      continue;
+    }
     draggable_region.op(
         SkIRect::MakeXYWH(region->bounds.x(), region->bounds.y(),
                           region->bounds.width(), region->bounds.height()),
-        region->draggable ? SkRegion::kUnion_Op : SkRegion::kDifference_Op);
+        SkRegion::kDifference_Op);
   }
   draggable_region_.swap(draggable_region);
 }
