+
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+void WebUIBrowserUI::HandleAuxTabsRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  const base::ListValue* list = &args;
+  if (method == "bindTabSpace" || method == "migrateTabSpaces") {
+    const bool migrate = method == "migrateTabSpaces";
+    base::ListValue assignments;
+    if (!migrate && list->size() == 2 && (*list)[0].is_string() &&
+        (*list)[1].is_string()) {
+      base::DictValue assignment;
+      assignment.Set("pageId", (*list)[0].GetString());
+      assignment.Set("spaceId", (*list)[1].GetString());
+      assignments.Append(std::move(assignment));
+    } else if (migrate && list->size() == 1 && (*list)[0].is_list() &&
+               (*list)[0].GetList().size() <= 512) {
+      assignments = (*list)[0].GetList().Clone();
+    } else {
+      std::move(callback).Run(false, "", "invalid_argument", "Invalid Space assignments");
+      return;
+    }
+    if (browser_->GetProfile()->IsOffTheRecord()) {
+      std::move(callback).Run(false, "", "forbidden", "Private tabs do not bind to saved Spaces");
+      return;
+    }
+    auto* catalog = aux::TabCatalog::GetForProfile(browser_->GetProfile());
+    const auto snapshot = catalog->Snapshot();
+    const std::string window_id = base::NumberToString(browser_->GetSessionID().id());
+    std::set<std::string> seen;
+    base::ListValue pending;
+    for (const auto& value : assignments) {
+      const auto* item = value.GetIfDict();
+      const auto* page_id = item ? item->FindString("pageId") : nullptr;
+      const auto* space_id = item ? item->FindString("spaceId") : nullptr;
+      if (!page_id || !space_id || page_id->empty() || space_id->empty() ||
+          page_id->size() > 128 || space_id->size() > 128 || item->size() != 2) {
+        std::move(callback).Run(false, "", "invalid_argument", "Invalid tab or Space identifier");
+        return;
+      }
+      if (!seen.insert(*page_id).second) continue;
+      for (const auto& tab_value : *snapshot.FindList("tabs")) {
+        const auto& tab = tab_value.GetDict();
+        if (tab.FindString("pageId") && *tab.FindString("pageId") == *page_id &&
+            tab.FindString("windowId") && *tab.FindString("windowId") == window_id &&
+            !tab.FindBool("popup").value_or(false) &&
+            !tab.FindBool("runtimeOwned").value_or(false) &&
+            (!migrate || !tab.FindString("spaceId"))) {
+          auto request = item->Clone();
+          request.Set("generation", tab.FindInt("generation").value_or(0));
+          request.Set("bindingVersion", ++space_binding_versions_[*page_id]);
+          pending.Append(std::move(request));
+          break;
+        }
+      }
+    }
+    if (!migrate && pending.empty()) {
+      std::move(callback).Run(false, "", "not_found", "That tab is unavailable for Space memory");
+      return;
+    }
+    AuxRuntimeHost::ForProfile(browser_->GetProfile())->CallApi(
+        "spaces.list", "{}", base::BindOnce(
+        [](base::WeakPtr<WebUIBrowserUI> self, base::ListValue pending,
+           bool migrate, std::string window_id, RequestCallback callback,
+           AuxRuntimeHost::Response response) {
+          if (!self) return;
+          if (!response.ok) {
+            std::move(callback).Run(false, "", response.error_code, response.error_message);
+            return;
+          }
+          auto spaces = base::JSONReader::Read(response.result_json, base::JSON_PARSE_RFC);
+          if (!spaces || !spaces->is_list()) {
+            std::move(callback).Run(false, "", "internal", "Invalid Space catalog");
+            return;
+          }
+          auto* catalog = aux::TabCatalog::GetForProfile(self->browser_->GetProfile());
+          const auto current = catalog->Snapshot();
+          int migrated = 0;
+          base::DictValue binding;
+          for (const auto& value : pending) {
+            const auto& request = value.GetDict();
+            const auto& page_id = *request.FindString("pageId");
+            const auto& space_id = *request.FindString("spaceId");
+            if (self->space_binding_versions_[page_id] != request.FindInt("bindingVersion")) continue;
+            bool valid_tab = false;
+            for (const auto& tab_value : *current.FindList("tabs")) {
+              const auto& tab = tab_value.GetDict();
+              if (tab.FindString("pageId") && *tab.FindString("pageId") == page_id &&
+                  tab.FindString("windowId") && *tab.FindString("windowId") == window_id &&
+                  tab.FindInt("generation") == request.FindInt("generation") &&
+                  !tab.FindBool("popup").value_or(false) &&
+                  !tab.FindBool("runtimeOwned").value_or(false) &&
+                  (!migrate || !tab.FindString("spaceId"))) valid_tab = true;
+            }
+            if (!valid_tab) continue;
+            for (const auto& space_value : spaces->GetList()) {
+              const auto* space = space_value.GetIfDict();
+              if (!space || !space->FindString("id") || *space->FindString("id") != space_id ||
+                  space->FindBool("archived").value_or(false)) continue;
+              const auto* workspace = space->FindString("workspaceId");
+              if (!workspace || workspace->empty() || workspace->size() > 128) continue;
+              catalog->BindSpace(page_id, space_id, *workspace);
+              binding.Set("spaceId", space_id);
+              binding.Set("workspaceId", *workspace);
+              ++migrated;
+              break;
+            }
+          }
+          if (!migrate && migrated != 1) {
+            std::move(callback).Run(false, "", "conflict", "The tab or Space changed. Select it again.");
+            return;
+          }
+          if (migrate) { binding.clear(); binding.Set("migrated", migrated); }
+          std::move(callback).Run(true, *base::WriteJson(binding), "", "");
+        }, weak_factory_.GetWeakPtr(), std::move(pending), migrate,
+           window_id, std::move(callback)));
+    return;
+  }
+  if (method == "tabsSnapshot" || method == "tabsSince") {
+    if ((method == "tabsSnapshot" && !list->empty()) ||
+        (method == "tabsSince" &&
+         (list->size() != 1 || !(*list)[0].is_int()))) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid tab catalog request");
+      return;
+    }
+    auto* catalog = aux::TabCatalog::GetForProfile(browser_->GetProfile());
+    base::DictValue result;
+    if (method == "tabsSnapshot") {
+      result = catalog->Snapshot();
+    } else {
+      result.Set("kind", "snapshot");
+      result.Set("snapshot", catalog->Snapshot());
+    }
+    std::move(callback).Run(true, *base::WriteJson(result), "", "");
+    return;
+  }
+  if (method == "tabCommand") {
+    if (list->size() < 2 || list->size() > 3 || !(*list)[0].is_string() ||
+        !(*list)[1].is_dict() ||
+        (list->size() == 3 && !(*list)[2].is_int())) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid tab command envelope");
+      return;
+    }
+    const std::string& command_id = (*list)[0].GetString();
+    if (command_id.size() < 8 || command_id.size() > 128) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid tab command identifier");
+      return;
+    }
+    const std::optional<int> expected_version =
+        list->size() == 3 ? std::optional<int>((*list)[2].GetInt())
+                          : std::nullopt;
+    base::DictValue ack =
+        aux::TabCatalog::GetForProfile(browser_->GetProfile())
+            ->Command(browser_, command_id, (*list)[1].GetDict(),
+                      expected_version);
+    std::move(callback).Run(true, *base::WriteJson(ack), "", "");
+    return;
+  }
+  std::move(callback).Run(false, "", "not_found",
+                          "Unsupported Aux shell method: " + method);
+}
+#endif
