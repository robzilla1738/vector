+#include "content/public/browser/web_contents.h"
+#include "content/public/common/stop_find_action.h"
+#include "ui/base/base_window.h"
+#include "url/gurl.h"
+
+
+namespace {
+base::DictValue NativeFault(std::string code, std::string message) {
+  base::DictValue error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::DictValue reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+}  // namespace
+
+namespace {
+
+bool CaptureAllowed(Profile* profile, const base::DictValue& params,
+                    content::WebContents** page_out) {
+  const std::string* page_id = params.FindString("pageId");
+  const std::string* workspace_id = params.FindString("workspaceId");
+  const std::string* expected_url = params.FindString("expectedUrl");
+  if (!page_id || page_id->empty() || page_id->size() > 200 ||
+      !workspace_id || workspace_id->empty() || workspace_id->size() > 200 ||
+      !expected_url || expected_url->size() > 8192) return false;
+  const GURL url(*expected_url);
+  if (!url.is_valid() || !url.SchemeIs("https") || url.has_username() ||
+      url.has_password() || url.spec() != *expected_url) return false;
+  auto* catalog = aux::TabCatalog::GetForProfile(profile);
+  BrowserWindowInterface* owner = nullptr;
+  content::WebContents* page = catalog ? catalog->FindPage(*page_id, &owner) : nullptr;
+  if (!page || !owner || owner->GetProfile() != profile || !owner->IsActive() ||
+      owner->GetTabStripModel()->GetActiveWebContents() != page ||
+      page->GetLastCommittedURL() != url) return false;
+  const auto* identity = aux::PageIdentity::FromWebContents(page);
+  if (!identity || identity->runtime_owned()) return false;
+  std::string error;
+  const auto snapshot = aux::OrganizationStore::Snapshot(
+      profile, base::NumberToString(owner->GetSessionID().id()), &error);
+  const base::DictValue* layout = snapshot ? snapshot->FindDict("layout") : nullptr;
+  if (!layout ||
+      !aux::ReadableWorkspaceMatches(*layout, *page_id, *workspace_id))
+    return false;
+  *page_out = page;
+  return true;
+}
+
+}  // namespace
+
+void AuxRuntimeHost::HandleReadableCapture(
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  content::WebContents* page = nullptr;
+  if (!CaptureAllowed(profile_, params, &page)) {
+    std::move(callback).Run(NativeFault("permission_denied", "Select the visible HTTPS page in its owning Space"));
+    return;
+  }
+  auto* capture = aux::ReadableCapture::FromWebContents(page);
+  if (!capture) {
+    std::move(callback).Run(NativeFault("permission_denied", "Page response eligibility is unavailable"));
+    return;
+  }
+  capture->Extract(
+      *params.FindString("expectedUrl"),
+      base::BindOnce(
+          [](base::WeakPtr<AuxRuntimeHost> owner, base::DictValue params,
+             content::WebContents* original,
+             base::OnceCallback<void(base::DictValue)> callback,
+             base::DictValue reply) {
+            content::WebContents* current = nullptr;
+            if (!owner || !CaptureAllowed(owner->profile_, params, &current) ||
+                current != original) {
+              std::move(callback).Run(NativeFault("conflict", "Page or Space changed during capture"));
+              return;
+            }
+            std::move(callback).Run(std::move(reply));
+          }, weak_factory_.GetWeakPtr(), params.Clone(), page,
+          std::move(callback)));
+}
+
