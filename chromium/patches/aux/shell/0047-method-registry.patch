+namespace {
+base::DictValue NativeFault(std::string code, std::string message) {
+  base::DictValue error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::DictValue reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+base::DictValue NativeResult(base::Value value) {
+  base::DictValue reply;
+  reply.Set("result", std::move(value));
+  return reply;
+}
+}  // namespace
+
+base::DictValue AuxRuntimeHost::HandleNativeTabsCall(
+    const std::string& method, const base::DictValue& params,
+    uint64_t /*connection_generation*/) {
+  auto* catalog = aux::TabCatalog::GetForProfile(profile_);
+  if (method == "native.listPages") {
+    base::DictValue snapshot = catalog->Snapshot();
+    base::ListValue pages;
+    const base::ListValue* tabs = snapshot.FindList("tabs");
+    const base::ListValue* windows = snapshot.FindList("windows");
+    for (const base::Value& value : *tabs) {
+      const base::DictValue& tab = value.GetDict();
+      const std::string& page_id = *tab.FindString("pageId");
+      base::DictValue page;
+      page.Set("pageId", page_id);
+      page.Set("windowId", *tab.FindString("windowId"));
+      page.Set("marker", "atab-" + page_id);
+      page.Set("url", *tab.FindString("url"));
+      page.Set("title", *tab.FindString("title"));
+      bool active = false;
+      for (const base::Value& window_value : *windows) {
+        const base::DictValue& window = window_value.GetDict();
+        const std::string* active_id = window.FindString("activePageId");
+        if (active_id && *active_id == page_id) {
+          active = true;
+          break;
+        }
+      }
+      page.Set("active", active);
+      if (content::WebContents* contents = catalog->FindPage(page_id)) {
+        page.Set("cdpTargetId",
+                 content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId());
+      }
+      pages.Append(std::move(page));
+    }
+    base::DictValue result;
+    result.Set("pages", std::move(pages));
+    return NativeResult(base::Value(std::move(result)));
+  }
+  if (method == "native.tabCommand") {
+    const std::string* command_id = params.FindString("commandId");
+    const std::string* window_id = params.FindString("windowId");
+    const base::DictValue* command = params.FindDict("command");
+    if (!command_id || command_id->size() < 8 || command_id->size() > 128 ||
+        !window_id || !command) {
+      return NativeFault("invalid_argument", "Invalid tab command envelope");
+    }
+    auto* browsers = ProfileBrowserCollection::GetForProfile(profile_);
+    if (!browsers) {
+      return NativeFault("backend_unavailable",
+                         "No browser window is available");
+    }
+    BrowserWindowInterface* issuer = nullptr;
+    if (*window_id == "main") {
+      issuer = browsers->FindTabbedBrowser();
+    } else {
+      int parsed_id = 0;
+      if (!base::StringToInt(*window_id, &parsed_id) || parsed_id <= 0) {
+        return NativeFault("invalid_argument", "Invalid window identifier");
+      }
+      issuer = browsers->FindBrowserWithID(
+          SessionID::FromSerializedValue(parsed_id));
+    }
+    base::DictValue ack = catalog->Command(issuer, *command_id, *command,
+                                             params.FindInt("catalogVersion"));
+    if (const std::string* page_id = ack.FindString("pageId")) {
+      if (const std::string* kind = command->FindString("kind");
+          kind && *kind == "open") {
+        if (command->FindBool("runtimeOwned").value_or(false) &&
+            ack.FindString("status") &&
+            *ack.FindString("status") == "applied") {
+          catalog->MarkRuntimeOwned(*page_id);
+          ack.Set("catalogVersion",
+                  catalog->Snapshot().FindInt("version").value_or(0));
+        }
+        if (content::WebContents* contents = catalog->FindPage(*page_id)) {
+          ack.Set(
+              "targetId",
+              content::DevToolsAgentHost::GetOrCreateFor(contents)->GetId());
+        }
+      }
+    }
+    return NativeResult(base::Value(std::move(ack)));
+  }
+  if (method == "native.movePage") {
+    const std::string* page_id = params.FindString("pageId");
+    BrowserWindowInterface* source = nullptr;
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id, &source) : nullptr;
+    if (!contents || !source || source->GetProfile() != profile_ ||
+        source->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+      return NativeFault("not_found", "Page is not in a regular window in this Profile");
+    }
+    TabStripModel* source_model = source->GetTabStripModel();
+    const int source_index = source_model->GetIndexOfWebContents(contents);
+    if (source_index < 0) {
+      return NativeFault("not_found", "Page is no longer in its window");
+    }
+    const std::string source_window_id =
+        base::NumberToString(source->GetSessionID().id());
+    const std::string* requested_window_id = params.FindString("windowId");
+    BrowserWindowInterface* target = nullptr;
+    std::string previous_target_page_id;
+    if (requested_window_id && !requested_window_id->empty()) {
+      int target_id = 0;
+      if (!base::StringToInt(*requested_window_id, &target_id) ||
+          target_id <= 0) {
+        return NativeFault("invalid_argument", "Invalid destination window");
+      }
+      auto* browsers = ProfileBrowserCollection::GetForProfile(profile_);
+      target = browsers ? browsers->FindBrowserWithID(
+                              SessionID::FromSerializedValue(target_id))
+                        : nullptr;
+      if (!target || target->GetProfile() != profile_ ||
+          target->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+        return NativeFault("not_found", "Destination window is not in this Profile");
+      }
+      if (target == source) {
+        base::DictValue result;
+        result.Set("windowId", source_window_id);
+        base::Value active;
+        if (content::WebContents* selected =
+                source_model->GetActiveWebContents()) {
+          active = base::Value(aux::PageIdentity::GetOrCreate(profile_, selected));
+        }
+        result.Set("sourceActivePageId", active.Clone());
+        result.Set("activePageId", std::move(active));
+        return NativeResult(base::Value(std::move(result)));
+      }
+      if (content::WebContents* active =
+              target->GetTabStripModel()->GetActiveWebContents()) {
+        previous_target_page_id =
+            aux::PageIdentity::GetOrCreate(profile_, active);
+      }
+    }
+
+    // Chromium's own transfer path preserves the TabModel, group and split
+    // metadata. The Aux page identity remains attached to the WebContents.
+    if (target) {
+      chrome::MoveTabsToExistingWindow(source, target, {source_index});
+    } else {
+      if (!chrome::CanMoveTabsToNewWindow(source, {source_index})) {
+        return NativeFault("conflict", "This window has no other tab to leave behind");
+      }
+      chrome::MoveTabsToNewWindow(source, {source_index});
+    }
+    BrowserWindowInterface* actual_target = nullptr;
+    content::WebContents* moved = catalog->FindPage(*page_id, &actual_target);
+    if (moved != contents || !actual_target ||
+        actual_target->GetProfile() != profile_ ||
+        actual_target->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+        (target && actual_target != target)) {
+      return NativeFault("backend_unavailable", "Chromium did not preserve the moved page");
+    }
+    if (!params.FindBool("activate").value_or(true) &&
+        !previous_target_page_id.empty()) {
+      if (content::WebContents* previous =
+              catalog->FindPage(previous_target_page_id)) {
+        TabStripModel* model = actual_target->GetTabStripModel();
+        const int index = model->GetIndexOfWebContents(previous);
+        if (index >= 0) {
+          model->ActivateTabAt(index);
+        }
+      }
+    }
+    const std::string destination_window_id =
+        base::NumberToString(actual_target->GetSessionID().id());
+    base::DictValue result;
+    result.Set("windowId", destination_window_id);
+    base::Value source_active;
+    base::Value destination_active;
+    base::DictValue snapshot = catalog->Snapshot();
+    for (const base::Value& window_value : *snapshot.FindList("windows")) {
+      const base::DictValue& window = window_value.GetDict();
+      const std::string* id = window.FindString("windowId");
+      if (!id) {
+        continue;
+      }
+      const base::Value* active = window.Find("activePageId");
+      if (*id == source_window_id && active) {
+        source_active = active->Clone();
+      }
+      if (*id == destination_window_id && active) {
+        destination_active = active->Clone();
+      }
+    }
+    result.Set("sourceActivePageId", std::move(source_active));
+    result.Set("activePageId", std::move(destination_active));
+    return NativeResult(base::Value(std::move(result)));
+  }
+  if (method == "native.focusPage" || method == "native.stopPage" ||
+      method == "native.recoverPage") {
+    const std::string* page_id = params.FindString("pageId");
+    BrowserWindowInterface* owner = nullptr;
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id, &owner) : nullptr;
+    if (!contents || !owner) {
+      return NativeFault("not_found", "Page is not in this Profile");
+    }
+    if (method == "native.focusPage") {
+      TabStripModel* model = owner->GetTabStripModel();
+      model->ActivateTabAt(model->GetIndexOfWebContents(contents));
+    } else if (method == "native.stopPage") {
+      contents->Stop();
+    } else {
+      const std::string* url_text = params.FindString("url");
+      const GURL url(url_text ? *url_text : "");
+      if (!url.is_valid() ||
+          (!url.SchemeIsHTTPOrHTTPS() && !url.SchemeIs("about"))) {
+        return NativeFault("invalid_argument", "Invalid recovery URL");
+      }
+      content::NavigationController::LoadURLParams load(url);
+      contents->GetController().LoadURLWithParams(load);
+    }
+    base::DictValue result;
+    result.Set("ok", true);
+    return NativeResult(base::Value(std::move(result)));
+  }
+  if (method == "native.acquireStage" || method == "native.releaseStage") {
+    const std::string* page_id = params.FindString("pageId");
+    BrowserWindowInterface* owner = nullptr;
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id, &owner) : nullptr;
+    if (!contents || !owner)
+      return NativeFault("not_found", "Page is not in this Profile");
+    const bool active =
+        owner->GetTabStripModel()->GetActiveWebContents() == contents;
+    if (method == "native.acquireStage") {
+      if (params.FindBool("requiresVisible").value_or(false) && !active)
+        return NativeFault("conflict", "The page must be active for pointer input");
+      if (contents->GetSize().IsEmpty()) {
+        gfx::Size size = owner->GetWindow()->GetBounds().size();
+        if (size.IsEmpty())
+          return NativeFault("backend_unavailable", "Page stage has no size");
+        contents->Resize(gfx::Rect(size));
+      }
+      if (++staged_pages_[*page_id] == 1 && !active)
+        contents->UpdateWebContentsVisibility(content::Visibility::VISIBLE);
+    } else {
+      auto it = staged_pages_.find(*page_id);
+      if (it != staged_pages_.end() && --it->second == 0) {
+        staged_pages_.erase(it);
+        if (!active)
+          contents->UpdateWebContentsVisibility(content::Visibility::HIDDEN);
+      }
+    }
+    base::DictValue result;
+    result.Set("ok", true);
+    return NativeResult(base::Value(std::move(result)));
+  }
+  return NativeFault("backend_unavailable",
+                     "Native method is unavailable in this build");
+}
