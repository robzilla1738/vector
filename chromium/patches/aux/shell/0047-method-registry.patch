+namespace {
+base::DictValue NativeFault(std::string code, std::string message) {
+  base::DictValue error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::DictValue reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+base::DictValue NativeResult(base::Value value) {
+  base::DictValue reply;
+  reply.Set("result", std::move(value));
+  return reply;
+}
+void RefreshCosmeticProfiles(Profile* profile,
+                             base::OnceCallback<void(bool)> callback) {
+  std::vector<Profile*> profiles = profile->GetAllOffTheRecordProfiles();
+  profiles.push_back(profile);
+  struct Pending {
+    size_t remaining = 0;
+    bool applied = true;
+    base::OnceCallback<void(bool)> callback;
+  };
+  auto pending = std::make_shared<Pending>();
+  pending->remaining = profiles.size();
+  pending->callback = std::move(callback);
+  for (Profile* current : profiles) {
+    aux::ZapController::ForProfile(current)->RefreshCosmetic(base::BindOnce(
+        [](std::shared_ptr<Pending> pending, bool applied) {
+          pending->applied &= applied;
+          if (--pending->remaining == 0) {
+            std::move(pending->callback).Run(pending->applied);
+          }
+        }, pending));
+  }
+}
+
+}  // namespace
+
+void AuxRuntimeHost::HandleZapInstall(
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  aux::ZapController* controller = aux::ZapController::ForProfile(profile_);
+  if (!controller) {
+    std::move(callback).Run(
+        NativeFault("backend_unavailable", "Zap Profile is unavailable"));
+    return;
+  }
+  controller->Install(params, std::move(callback));
+}
+
+void AuxRuntimeHost::HandleCosmeticCommit(
+    const base::DictValue& params,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  auto* cosmetic = aux::CosmeticController::ForProfile(profile_);
+  if (!cosmetic) {
+    std::move(callback).Run(NativeFault("backend_unavailable",
+                                        "Cosmetic filtering is unavailable"));
+    return;
+  }
+  cosmetic->Commit(params, base::BindOnce(
+      [](base::WeakPtr<AuxRuntimeHost> owner,
+         base::OnceCallback<void(base::DictValue)> callback,
+         std::optional<base::DictValue> receipt, std::string error) {
+        if (!owner) {
+          std::move(callback).Run(NativeFault(
+              "backend_unavailable", "The owning browser Profile closed"));
+          return;
+        }
+        if (!receipt) {
+          std::move(callback).Run(NativeFault("invalid_argument", std::move(error)));
+          return;
+        }
+        RefreshCosmeticProfiles(owner->profile_, base::BindOnce(
+      [](base::WeakPtr<AuxRuntimeHost> owner, base::DictValue receipt,
+         base::OnceCallback<void(base::DictValue)> callback, bool applied) {
+        if (!owner) {
+          std::move(callback).Run(NativeFault(
+              "backend_unavailable", "The owning browser Profile closed"));
+          return;
+        }
+        auto* cosmetic = aux::CosmeticController::ForProfile(owner->profile_);
+        if (applied) {
+          cosmetic->Confirm();
+          std::move(callback).Run(
+              NativeResult(base::Value(std::move(receipt))));
+          return;
+        }
+        cosmetic->Rollback(base::BindOnce(
+          [](base::WeakPtr<AuxRuntimeHost> owner,
+             base::OnceCallback<void(base::DictValue)> callback,
+             bool persisted) {
+            if (!owner || !persisted) {
+              std::move(callback).Run(NativeFault(
+                  "backend_unavailable",
+                  "Cosmetic rollback could not be persisted"));
+              return;
+            }
+            RefreshCosmeticProfiles(owner->profile_, base::BindOnce(
+                [](base::OnceCallback<void(base::DictValue)> callback,
+                   bool restored) {
+                  std::move(callback).Run(NativeFault(
+                      restored ? "backend_unavailable" : "conflict",
+                      restored ? "An active document rejected cosmetic styles"
+                               : "Cosmetic rollback could not refresh an "
+                                 "active document"));
+                },
+                std::move(callback)));
+          }, owner, std::move(callback)));
+      },
+      owner, std::move(*receipt), std::move(callback)));
+      }, weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+
+base::DictValue AuxRuntimeHost::HandleNativeBlockingCall(
+    const std::string& method, const base::DictValue& params,
+    uint64_t /*connection_generation*/) {
+  if (method == "native.contentBlockBegin" ||
+      method == "native.contentBlockAppend") {
+    auto* blocker = aux::ContentBlockingController::ForProfile(profile_);
+    if (!blocker) {
+      return NativeFault("backend_unavailable",
+                         "Content blocking is unavailable");
+    }
+    std::string error;
+    std::optional<base::DictValue> result;
+    if (method == "native.contentBlockBegin") {
+      result = blocker->Begin(params, &error);
+    } else {
+      result = blocker->Append(params, &error);
+    }
+    return result ? NativeResult(base::Value(std::move(*result)))
+                  : NativeFault(error == "Content blocking page changed"
+                                    ? "conflict"
+                                    : "invalid_argument",
+                                std::move(error));
+  }
+  if (method == "native.cosmeticBegin" || method == "native.cosmeticAppend") {
+    auto* cosmetic = aux::CosmeticController::ForProfile(profile_);
+    if (!cosmetic) {
+      return NativeFault("backend_unavailable",
+                         "Cosmetic filtering is unavailable");
+    }
+    std::string error;
+    auto result = method == "native.cosmeticBegin"
+                      ? cosmetic->Begin(params, &error)
+                      : cosmetic->Append(params, &error);
+    return result ? NativeResult(base::Value(std::move(*result)))
+                  : NativeFault(error == "Content blocking page changed"
+                                    ? "conflict"
+                                    : "invalid_argument",
+                                std::move(error));
+  }
+  return NativeFault("backend_unavailable",
+                     "Native method is unavailable in this build");
+}
