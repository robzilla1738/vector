+void WebUIBrowserUI::HandleAuxMigrationRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  const base::ListValue* list = &args;
+  if (method == "migrationReview" || method == "migrationBegin" ||
+      method == "migrationBatch" || method == "migrationFinish" ||
+      method == "migrationRollback") {
+    if (browser_->GetProfile()->IsOffTheRecord() ||
+        (method == "migrationReview" ? !list->empty()
+                                      : list->size() != 1 || !(*list)[0].is_dict())) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid Profile migration request");
+      return;
+    }
+    base::DictValue params = method == "migrationReview"
+                                 ? base::DictValue() : (*list)[0].GetDict().Clone();
+    aux::MigrationImport::ForProfile(browser_->GetProfile())->CallAsync(
+        base::BindRepeating([](base::WeakPtr<WebUIBrowserUI> self) -> BrowserWindowInterface* {
+          return self && self->IsAuthorizedAuxDocument() ? self->browser_.get() : nullptr;
+        }, weak_factory_.GetWeakPtr()), method, std::move(params),
+        base::BindOnce([](RequestCallback callback,
+                          std::optional<base::DictValue> result, std::string error) {
+          if (!result) {
+            std::move(callback).Run(false, "", "conflict",
+                                    error.empty() ? "Migration is unavailable" : error);
+          } else {
+            std::move(callback).Run(true, *base::WriteJson(*result), "", "");
+          }
+        }, std::move(callback)));
+    return;
+  }
+  std::move(callback).Run(false, "", "not_found",
+                          "Unsupported Aux shell method: " + method);
+}
+#endif
