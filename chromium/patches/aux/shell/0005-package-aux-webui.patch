+
+module aux.mojom;
+
+// Available only to the committed top-level chrome://aux/ document. The
+// browser process validates the frame, Profile, method and arguments again on
+// every request; a renderer-held remote is never treated as authority.
+interface ShellHostFactory {
+  CreateShellHost(pending_receiver<ShellHost> host);
+};
+
+interface ShellHost {
+  GetIdentity() => (string window_id, string profile_id, bool private_mode);
+  Request(string method, string args_json) =>
+      (bool ok, string result_json, string error_code, string error_message);
+};
