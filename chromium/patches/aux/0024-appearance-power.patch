diff --git a/chrome/browser/ui/aux/methods/power_methods.cc b/chrome/browser/ui/aux/methods/power_methods.cc
new file mode 100644
index 0000000..c2b254f
--- /dev/null
+++ b/chrome/browser/ui/aux/methods/power_methods.cc
@@ -0,0 +1,24 @@
+#include "chrome/browser/ui/aux/runtime_host.h"
+#include "chrome/browser/ui/aux/power_activity_mac.h"
+#include "chrome/browser/profiles/profile.h"
+base::DictValue AuxRuntimeHost::HandleNativePowerCall(const std::string& method, const base::DictValue& params) {
+  auto fault = [](const char* message) {
+    base::DictValue error; error.Set("code", "invalid_params"); error.Set("message", message);
+    base::DictValue reply; reply.Set("error", std::move(error)); return reply;
+  };
+  if (!power_activity_) power_activity_ = std::make_unique<aux::PowerActivityMac>(profile_);
+  base::DictValue value;
+  if (method == "native.powerRelease") {
+    if (!params.empty()) return fault("Power release takes no arguments.");
+    power_activity_->End(); value.Set("active", false);
+  } else if (method == "native.powerStatus") {
+    if (!params.empty()) return fault("Power status takes no arguments.");
+    value = power_activity_->Status();
+  } else if (method == "native.powerActivity") {
+    const auto* reason = params.FindString("reason"); const auto duration = params.FindInt("durationSec");
+    if (params.size() != 2 || !reason || reason->empty() || reason->size() > 200 || !duration || *duration < 1 || *duration > 3600)
+      return fault("Power activity requires a bounded reason and one to 3600 seconds.");
+    value = power_activity_->Begin(*reason, *duration);
+  } else return fault("Unknown power method.");
+  base::DictValue reply; reply.Set("result", std::move(value)); return reply;
+}
diff --git a/chrome/browser/ui/aux/power_activity_mac.h b/chrome/browser/ui/aux/power_activity_mac.h
