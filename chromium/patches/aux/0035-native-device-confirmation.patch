+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_WEBUI_BROWSER_AUX_DEVICE_CONFIRMATION_H_
+#define CHROME_BROWSER_UI_WEBUI_BROWSER_AUX_DEVICE_CONFIRMATION_H_
+#include <cstdint>
+#include <memory>
+#include <string>
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/aux/runtime_host.h"
+#include "chrome/browser/ui/webui_browser/shell_host.mojom.h"
+#include "content/public/browser/weak_document_ptr.h"
+class BrowserWindowInterface;
+class Profile;
+namespace content { class WebContents; }
+namespace device_reauth { class DeviceAuthenticator; }
+
+// One fresh OS confirmation belongs to one original shell document and turn.
+class AuxDeviceConfirmation final {
+ public:
+  using Reply = aux::mojom::ShellHost::RequestCallback;
+  AuxDeviceConfirmation(Profile* profile, BrowserWindowInterface* window,
+                        content::WebContents* shell,
+                        base::RepeatingCallback<bool()> authorized);
+  ~AuxDeviceConfirmation();
+  void Confirm(const base::DictValue& params, Reply reply);
+ private:
+  bool Current();
+  void Prepared(AuxRuntimeHost::Response response);
+  void Authenticated(bool approved);
+  void Confirmed(AuxRuntimeHost::Response response);
+  void Fail(std::string code, std::string message);
+  void Deadline();
+  void Finish(AuxRuntimeHost::Response response);
+  raw_ptr<Profile> profile_;
+  base::WeakPtr<BrowserWindowInterface> window_;
+  base::WeakPtr<content::WebContents> shell_;
+  base::RepeatingCallback<bool()> authorized_;
+  base::WeakPtr<AuxRuntimeHost> runtime_;
+  content::WeakDocumentPtr document_;
+  uint64_t generation_ = 0;
+  base::DictValue request_;
+  std::string challenge_id_;
+  Reply reply_;
+  std::unique_ptr<device_reauth::DeviceAuthenticator> authenticator_;
+  bool busy_ = false;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<AuxDeviceConfirmation> weak_factory_{this};
+};
+#endif
diff --git a/chrome/browser/ui/webui_browser/aux_device_confirmation.cc b/chrome/browser/ui/webui_browser/aux_device_confirmation.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/webui_browser/aux_device_confirmation.cc
@@ -0,0 +1,182 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/webui_browser/aux_device_confirmation.h"
+#include <algorithm>
+#include <optional>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/device_reauth/chrome_device_authenticator_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "components/device_reauth/device_authenticator.h"
+#include "components/sessions/core/session_id.h"
+#include "content/public/browser/document_user_data.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+// An opaque native identity with the public Chromium document lifetime.
+class ConfirmationDocument final : public content::DocumentUserData<ConfirmationDocument> {
+ public:
+  const base::UnguessableToken token = base::UnguessableToken::Create();
+ private:
+  explicit ConfirmationDocument(content::RenderFrameHost* frame) : DocumentUserData(frame) {}
+  friend class content::DocumentUserData<ConfirmationDocument>;
+  DOCUMENT_USER_DATA_KEY_DECL();
+};
+DOCUMENT_USER_DATA_KEY_IMPL(ConfirmationDocument);
+}  // namespace
+
+AuxDeviceConfirmation::AuxDeviceConfirmation(Profile* profile,
+    BrowserWindowInterface* window, content::WebContents* shell,
+    base::RepeatingCallback<bool()> authorized)
+    : profile_(profile), window_(window->GetWeakPtr()), shell_(shell->GetWeakPtr()),
+      authorized_(std::move(authorized)) {}
+AuxDeviceConfirmation::~AuxDeviceConfirmation() {
+  weak_factory_.InvalidateWeakPtrs();
+  if (authenticator_) authenticator_->Cancel();
+  Fail("ref_stale", "The original confirmation window closed");
+}
+
+bool AuxDeviceConfirmation::Current() {
+  const auto weak = weak_factory_.GetWeakPtr();
+  if (!authorized_.Run() || !weak) return false;
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  return window_ && window_->IsActive() && window_->GetProfile() == profile_ &&
+      shell_ && frame && frame->IsRenderFrameLive() && shell_->GetPrimaryMainFrame() == frame &&
+      runtime_ && runtime_->DeviceConfirmationConnectionCurrent(generation_);
+}
+
+void AuxDeviceConfirmation::Confirm(const base::DictValue& params, Reply reply) {
+  if (busy_) {
+    std::move(reply).Run(false, "", "conflict", "A device confirmation is already pending");
+    return;
+  }
+  const auto weak = weak_factory_.GetWeakPtr();
+  if (profile_->IsOffTheRecord() || !authorized_.Run() || !weak ||
+      !window_ || !window_->IsActive() || !shell_) {
+    std::move(reply).Run(false, "", "permission_denied", "Device confirmation requires the original active Aux window");
+    return;
+  }
+  auto* runtime = AuxRuntimeHost::ForProfile(profile_);
+  runtime_ = runtime->GetWeakPtr();
+  generation_ = runtime->DeviceConfirmationGeneration();
+  document_ = shell_->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  const bool current = Current();
+  if (!weak || !current) {
+    std::move(reply).Run(false, "", "ref_stale", "The original runtime connection is unavailable");
+    return;
+  }
+  base::DictValue context;
+  context.Set("windowId", base::NumberToString(window_->GetSessionID().id()));
+  context.Set("documentToken", ConfirmationDocument::GetOrCreateForCurrentDocument(shell_->GetPrimaryMainFrame())->token.ToString());
+  context.Set("ownerIncarnation", runtime->DeviceConfirmationOwnerIncarnation());
+  context.Set("connectionGeneration", base::NumberToString(generation_));
+  request_.Set("approvalId", *params.FindString("approvalId"));
+  request_.Set("expectedTurnId", *params.FindString("expectedTurnId"));
+  request_.Set("context", std::move(context));
+  // Renderer reason text is never proof or the authoritative OS-sheet message.
+  reply_ = std::move(reply);
+  busy_ = true;
+  runtime->CallInternal("safety.deviceAuth.prepare", *base::WriteJson(request_),
+      base::BindOnce(&AuxDeviceConfirmation::Prepared, weak_factory_.GetWeakPtr()));
+}
+
+void AuxDeviceConfirmation::Prepared(AuxRuntimeHost::Response response) {
+  if (!response.ok) { Finish(std::move(response)); return; }
+  auto value = base::JSONReader::Read(response.result_json, base::JSON_PARSE_RFC);
+  const auto* result = value ? value->GetIfDict() : nullptr;
+  const auto* id = result ? result->FindString("challengeId") : nullptr;
+  const auto* reason = result ? result->FindString("reason") : nullptr;
+  const auto expires = result ? result->FindDouble("expiresAt") : std::nullopt;
+  if (id) challenge_id_ = *id;
+  const auto weak = weak_factory_.GetWeakPtr();
+  const bool current = Current();
+  if (!weak) return;
+  if (!id || id->empty() || !reason || reason->empty() || !expires ||
+      *expires <= base::Time::Now().InMillisecondsSinceUnixEpoch() || !current) {
+    Fail("ref_stale", "This confirmation ended or changed");
+    return;
+  }
+  deadline_.Start(FROM_HERE, base::Milliseconds(static_cast<int64_t>(std::min(
+      *expires - base::Time::Now().InMillisecondsSinceUnixEpoch(), 120000.0))),
+      base::BindOnce(&AuxDeviceConfirmation::Deadline, weak_factory_.GetWeakPtr()));
+  authenticator_ = ChromeDeviceAuthenticatorFactory::GetForProfile(profile_,
+      device_reauth::DeviceAuthParams(base::Seconds(0),
+          device_reauth::DeviceAuthSource::kPasswordManager));
+  if (!authenticator_ || !authenticator_->CanAuthenticateWithBiometricOrScreenLock()) {
+    Fail("permission_denied", "Device authentication is unavailable");
+    return;
+  }
+  authenticator_->AuthenticateWithMessage(base::UTF8ToUTF16(*reason),
+      base::BindOnce(&AuxDeviceConfirmation::Authenticated, weak_factory_.GetWeakPtr()));
+}
+
+void AuxDeviceConfirmation::Authenticated(bool approved) {
+  const auto weak = weak_factory_.GetWeakPtr();
+  const bool current = Current();
+  if (!weak) return;
+  if (!approved || !current) {
+    Fail("permission_denied", "Device confirmation was not approved for this original action");
+    return;
+  }
+  auto confirmation = request_.Clone();
+  confirmation.Set("challengeId", challenge_id_);
+  runtime_->CallInternal("safety.deviceAuth.confirm", *base::WriteJson(confirmation),
+      base::BindOnce(&AuxDeviceConfirmation::Confirmed, weak_factory_.GetWeakPtr()));
+}
+
+void AuxDeviceConfirmation::Confirmed(AuxRuntimeHost::Response response) {
+  if (response.ok) {
+    auto value = base::JSONReader::Read(response.result_json, base::JSON_PARSE_RFC);
+    const auto* result = value ? value->GetIfDict() : nullptr;
+    if (!result || result->FindBool("ok") != true ||
+        result->FindString("approvalId") == nullptr ||
+        result->FindString("turnId") == nullptr ||
+        *result->FindString("approvalId") != *request_.FindString("approvalId") ||
+        *result->FindString("turnId") != *request_.FindString("expectedTurnId")) {
+      Fail("ref_stale", "The confirmation acknowledgement changed");
+      return;
+    }
+  }
+  const auto weak = weak_factory_.GetWeakPtr();
+  const bool current = Current();
+  if (!weak) return;
+  if (!current) {
+    Fail("ref_stale", "The original confirmation context changed");
+    return;
+  }
+  Finish(std::move(response));
+}
+
+void AuxDeviceConfirmation::Deadline() {
+  auto authenticator = std::move(authenticator_);
+  Fail("condition_timeout", "Device confirmation expired");
+  if (authenticator) authenticator->Cancel();
+}
+
+void AuxDeviceConfirmation::Fail(std::string code, std::string message) {
+  if (!challenge_id_.empty() && runtime_ &&
+      runtime_->DeviceConfirmationConnectionCurrent(generation_)) {
+    auto cancellation = request_.Clone();
+    cancellation.Set("challengeId", challenge_id_);
+    runtime_->CallInternal("safety.deviceAuth.cancel", *base::WriteJson(cancellation),
+        base::BindOnce([](AuxRuntimeHost::Response) {}));
+  }
+  Finish({false, "", std::move(code), std::move(message)});
+}
+
+void AuxDeviceConfirmation::Finish(AuxRuntimeHost::Response response) {
+  deadline_.Stop();
+  weak_factory_.InvalidateWeakPtrs();
+  auto callback = std::move(reply_);
+  busy_ = false;
+  challenge_id_.clear(); request_.clear(); runtime_.reset(); generation_ = 0;
+  if (callback) std::move(callback).Run(response.ok, std::move(response.result_json),
+      std::move(response.error_code), std::move(response.error_message));
+}
