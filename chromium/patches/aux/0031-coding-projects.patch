+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_PROJECT_FILES_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_PROJECT_FILES_H_
+#include "base/values.h"
+namespace aux {
+// Caller admits the original WebUI document before dispatch and before reply.
+// All filesystem access is relative to the exact reviewed root descriptor.
+base::DictValue ReadProjectFiles(const base::DictValue& params, bool listing);
+}
+#endif
diff --git a/chrome/browser/ui/aux/native_project_listener.cc b/chrome/browser/ui/aux/native_project_listener.cc
new file mode 100644
index 0000000..dfd9cd0
--- /dev/null
+++ b/chrome/browser/ui/aux/native_project_listener.cc
@@ -0,0 +1,253 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_project_listener.h"
+#include <arpa/inet.h>
+#include <libproc.h>
+#include <sys/proc_info.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <errno.h>
+#include <utility>
+#include <signal.h>
+#include <sys/proc.h>
+#include "base/threading/platform_thread.h"
+#include "base/time/time.h"
+#include <algorithm>
+#include <array>
+#include <vector>
+namespace aux {
+namespace {
+bool Process(pid_t pid, proc_bsdinfo* info) {
+  return proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, info, sizeof(*info)) == static_cast<int>(sizeof(*info)) && info->pbi_uid == getuid();
+}
+bool SameBirth(const NativeProjectProcess& process, const proc_bsdinfo& info) {
+  return info.pbi_uid == getuid() && info.pbi_start_tvsec == process.seconds &&
+      info.pbi_start_tvusec == process.microseconds;
+}
+bool BirthCurrent(const NativeProjectProcess& process, proc_bsdinfo* info) {
+  return process.pid > 0 && Process(process.pid, info) && SameBirth(process, *info);
+}
+bool ChainCurrent(const NativeProjectProcess& root,
+                  const std::vector<NativeProjectProcess>& chain) {
+  if (chain.empty() || chain.front().pid != root.pid ||
+      chain.front().seconds != root.seconds || chain.front().microseconds != root.microseconds)
+    return false;
+  for (size_t i = 0; i < chain.size(); ++i) {
+    proc_bsdinfo info{};
+    if (!BirthCurrent(chain[i], &info) ||
+        (i && info.pbi_ppid != static_cast<uint32_t>(chain[i - 1].pid))) return false;
+  }
+  return true;
+}
+bool CaptureChain(const NativeProjectProcess& root, pid_t pid,
+                  std::vector<NativeProjectProcess>* chain) {
+  for (size_t depth = 0; depth < 32 && pid > 1; ++depth) {
+    proc_bsdinfo info{};
+    if (!Process(pid, &info)) return false;
+    chain->push_back({pid, info.pbi_start_tvsec, info.pbi_start_tvusec});
+    if (pid == root.pid) {
+      std::reverse(chain->begin(), chain->end());
+      return ChainCurrent(root, *chain);
+    }
+    pid = static_cast<pid_t>(info.pbi_ppid);
+  }
+  return false;
+}
+bool Inventory(uint32_t type, uint32_t owner, std::vector<NativeProjectProcess>* members) {
+  std::array<pid_t, 4096> pids{};
+  const int bytes = proc_listpids(type, owner, pids.data(), sizeof(pids));
+  if (bytes < 0 || bytes >= static_cast<int>(sizeof(pids)) || bytes % static_cast<int>(sizeof(pid_t))) return false;
+  for (int i = 0; i < bytes / static_cast<int>(sizeof(pid_t)); ++i) {
+    if (pids[i] <= 0) continue;
+    proc_bsdinfo info{};
+    if (!Process(pids[i], &info)) return false;
+    if ((type == PROC_PPID_ONLY && info.pbi_ppid != owner) ||
+        (type == PROC_PGRP_ONLY && info.pbi_pgid != owner)) return false;
+    members->push_back({pids[i], info.pbi_start_tvsec, info.pbi_start_tvusec});
+  }
+  return true;
+}
+bool OriginalGone(const NativeProjectProcess& process) {
+  proc_bsdinfo info{};
+  errno = 0;
+  const int bytes = proc_pidinfo(process.pid, PROC_PIDTBSDINFO, 0, &info, sizeof(info));
+  if (bytes == static_cast<int>(sizeof(info)))
+    return info.pbi_start_tvsec != process.seconds || info.pbi_start_tvusec != process.microseconds;
+  return errno == ESRCH;
+}
+bool StopAndConfirm(const NativeProjectProcess& process, base::TimeTicks deadline) {
+  proc_bsdinfo info{};
+  if (!BirthCurrent(process, &info) || info.pbi_status == SZOMB) return false;
+  if (kill(process.pid, SIGSTOP) != 0) return false;
+  do {
+    if (!BirthCurrent(process, &info) || info.pbi_status == SZOMB) return false;
+    if (info.pbi_status == SSTOP) return true;
+    base::PlatformThread::Sleep(base::Milliseconds(1));
+  } while (base::TimeTicks::Now() < deadline);
+  return false;
+}
+void Remember(std::vector<NativeProjectProcess>* members, const NativeProjectProcess& process) {
+  if (std::none_of(members->begin(), members->end(), [&](const auto& known) {
+        return known.pid == process.pid && known.seconds == process.seconds &&
+            known.microseconds == process.microseconds;
+      })) members->push_back(process);
+}
+bool Socket(pid_t pid, int fd, socket_fdinfo* socket) {
+  return proc_pidfdinfo(pid, fd, PROC_PIDFDSOCKETINFO, socket, sizeof(*socket)) == static_cast<int>(sizeof(*socket)) &&
+      socket->psi.soi_kind == SOCKINFO_TCP && socket->psi.soi_protocol == IPPROTO_TCP &&
+      !(socket->psi.soi_options & SO_REUSEPORT) &&
+      socket->psi.soi_proto.pri_tcp.tcpsi_state == TSI_S_LISTEN;
+}
+std::string LoopbackHost(const socket_fdinfo& socket) {
+  const auto& address = socket.psi.soi_proto.pri_tcp.tcpsi_ini.insi_laddr;
+  if (socket.psi.soi_family == AF_INET) {
+    const auto ipv4 = ntohl(address.ina_46.i46a_addr4.s_addr);
+    if (ipv4 == INADDR_ANY) return "127.0.0.1";
+    if ((ipv4 >> 24) == 127) {
+      std::array<char, INET_ADDRSTRLEN> host{};
+      if (inet_ntop(AF_INET, &address.ina_46.i46a_addr4, host.data(), host.size())) return host.data();
+    }
+  } else if (socket.psi.soi_family == AF_INET6) {
+    if (IN6_IS_ADDR_UNSPECIFIED(&address.ina_6) || IN6_IS_ADDR_LOOPBACK(&address.ina_6)) return "[::1]";
+  }
+  return {};
+}
+}
+bool CaptureProjectProcess(pid_t pid, NativeProjectProcess* process, bool dedicated_descendants) {
+  proc_bsdinfo info{};
+  if (pid <= 0 || !Process(pid, &info)) return false;
+  *process = {pid, info.pbi_start_tvsec, info.pbi_start_tvusec, dedicated_descendants};
+  return true;
+}
+bool ProjectProcessCurrent(const NativeProjectProcess& process) {
+  proc_bsdinfo info{};
+  return process.pid > 0 && Process(process.pid, &info) && info.pbi_pgid == static_cast<uint32_t>(process.pid) &&
+      info.pbi_start_tvsec == process.seconds && info.pbi_start_tvusec == process.microseconds;
+}
+bool FreezeProjectRoot(const NativeProjectProcess& process) {
+  proc_bsdinfo info{};
+  if (!BirthCurrent(process, &info) || info.pbi_status == SZOMB) return false;
+  // The native-owned child has not been reaped, so its root/group ID cannot be reused.
+  if (!process.dedicated_descendants && info.pbi_pgid != static_cast<uint32_t>(process.pid))
+    return false;
+  return kill(process.dedicated_descendants ? process.pid : -process.pid, SIGSTOP) == 0;
+}
+bool StopProjectProcesses(const NativeProjectProcess& process, bool fenced,
+                          std::vector<NativeProjectProcess>* captured) {
+  auto& remembered = *captured;
+  const auto deadline = base::TimeTicks::Now() + base::Seconds(5);
+  proc_bsdinfo root_status{};
+  const bool root_known = BirthCurrent(process, &root_status);
+  const bool exited_group_root = root_known && !process.dedicated_descendants && root_status.pbi_status == SZOMB;
+  bool proven = exited_group_root || (fenced && StopAndConfirm(process, deadline));
+  std::vector<NativeProjectProcess> group;
+  if (ProjectProcessCurrent(process)) {
+    const bool inventoried = Inventory(PROC_PGRP_ONLY, process.pid, &group);
+    proven &= inventoried;
+    for (const auto& member : group) {
+      Remember(&remembered, member);
+      proc_bsdinfo status{};
+      if (!BirthCurrent(member, &status)) proven = false;
+      else if (status.pbi_status != SZOMB) proven &= StopAndConfirm(member, deadline);
+    }
+  } else proven = false;
+  if (process.dedicated_descendants && proven) {
+    // Freeze each parent BEFORE reading its children, then freeze/rescan that
+    // child inventory. A live frozen parent cannot create a late successor.
+    std::vector<NativeProjectProcess> pending{process};
+    for (size_t i = 0; i < pending.size() && proven; ++i) {
+      if (pending.size() > 4096 || base::TimeTicks::Now() >= deadline) { proven = false; break; }
+      const auto parent = pending[i];
+      proc_bsdinfo parent_status{};
+      if (!BirthCurrent(parent, &parent_status) || parent_status.pbi_status != SSTOP) { proven = false; break; }
+      std::vector<NativeProjectProcess> children;
+      if (!Inventory(PROC_PPID_ONLY, parent.pid, &children) ||
+          !BirthCurrent(parent, &parent_status) || parent_status.pbi_status != SSTOP) { proven = false; break; }
+      for (const auto& child : children) {
+        proc_bsdinfo child_status{};
+        if (!BirthCurrent(parent, &parent_status) || parent_status.pbi_status != SSTOP ||
+            !BirthCurrent(child, &child_status) || child_status.pbi_ppid != static_cast<uint32_t>(parent.pid)) { proven = false; break; }
+        Remember(&remembered, child);
+        if (!StopAndConfirm(child, deadline) || !BirthCurrent(parent, &parent_status) ||
+            parent_status.pbi_status != SSTOP) { proven = false; break; }
+        Remember(&pending, child);
+      }
+      std::vector<NativeProjectProcess> confirmed;
+      if (!BirthCurrent(parent, &parent_status) || parent_status.pbi_status != SSTOP ||
+          !Inventory(PROC_PPID_ONLY, parent.pid, &confirmed) ||
+          !BirthCurrent(parent, &parent_status) || parent_status.pbi_status != SSTOP) { proven = false; break; }
+      for (const auto& child : confirmed) {
+        if (std::none_of(children.begin(), children.end(), [&](const auto& known) {
+              return known.pid == child.pid && known.seconds == child.seconds && known.microseconds == child.microseconds;
+            })) { proven = false; break; }
+      }
+    }
+  }
+  // Keep all known receipts even after reparenting; only reduction uses them.
+  // Never signal a recycled PID or expand to an arbitrary descendant group.
+  for (auto it = remembered.rbegin(); it != remembered.rend(); ++it) {
+    if (it->pid == process.pid || OriginalGone(*it)) continue;
+    proc_bsdinfo info{};
+    if (!BirthCurrent(*it, &info) || kill(it->pid, SIGKILL) != 0) proven = false;
+  }
+  proc_bsdinfo root{};
+  if (BirthCurrent(process, &root)) {
+    if (root.pbi_pgid == static_cast<uint32_t>(process.pid)) kill(-process.pid, SIGKILL);
+    if (kill(process.pid, SIGKILL) != 0) proven = false;
+  } else proven = false;
+  // The parent owns only root waitpid. Original descendants must actually
+  // disappear (not merely become zombies) before claiming complete cleanup.
+  do {
+    bool gone = true;
+    for (const auto& member : remembered)
+      if (member.pid != process.pid && !OriginalGone(member)) { gone = false; break; }
+    if (gone) return proven;
+    base::PlatformThread::Sleep(base::Milliseconds(1));
+  } while (base::TimeTicks::Now() < deadline);
+  return false;
+}
+std::vector<NativeProjectListener> FindProjectListeners(const NativeProjectProcess& process) {
+  if (!ProjectProcessCurrent(process)) return {};
+  // Refuse an overflowing process/fd inventory; never silently inspect another group.
+  std::array<pid_t, 4096> pids{};
+  const int bytes = proc_listpids(process.dedicated_descendants ? PROC_UID_ONLY : PROC_PGRP_ONLY,
+      process.dedicated_descendants ? getuid() : process.pid, pids.data(), sizeof(pids));
+  if (bytes <= 0 || bytes >= static_cast<int>(sizeof(pids))) return {};
+  std::vector<NativeProjectListener> listeners;
+  for (int index = 0; index < bytes / static_cast<int>(sizeof(pid_t)); ++index) {
+    const auto pid = pids[index]; proc_bsdinfo info{};
+    if (pid <= 0 || !Process(pid, &info)) continue;
+    std::vector<NativeProjectProcess> ancestry;
+    if (info.pbi_pgid != static_cast<uint32_t>(process.pid) &&
+        (!process.dedicated_descendants || !CaptureChain(process, pid, &ancestry))) continue;
+    std::array<proc_fdinfo, 4096> fds{};
+    const int count = proc_pidinfo(pid, PROC_PIDLISTFDS, 0, fds.data(), sizeof(fds));
+    if (count < 0 || count >= static_cast<int>(sizeof(fds))) return {};
+    for (int item = 0; item < count / static_cast<int>(sizeof(proc_fdinfo)); ++item) {
+      if (fds[item].proc_fdtype != PROX_FDTYPE_SOCKET) continue;
+      socket_fdinfo socket{};
+      if (!Socket(pid, fds[item].proc_fd, &socket)) continue;
+      const auto host = LoopbackHost(socket);
+      const auto& tcp = socket.psi.soi_proto.pri_tcp;
+      const uint16_t port = ntohs(static_cast<uint16_t>(tcp.tcpsi_ini.insi_lport));
+      if (host.empty() || !port) continue;
+      listeners.push_back({pid, static_cast<int>(fds[item].proc_fd), info.pbi_start_tvsec, info.pbi_start_tvusec,
+          socket.psi.soi_so, tcp.tcpsi_ini.insi_gencnt, host, port, ancestry});
+      if (listeners.size() > 32) return {};
+    }
+  }
+  if (!ProjectProcessCurrent(process)) return {};
+  std::erase_if(listeners, [&](const auto& listener) { return !ProjectListenerCurrent(process, listener); });
+  return listeners;
+}
+bool ProjectListenerCurrent(const NativeProjectProcess& process, const NativeProjectListener& listener) {
+  if (!ProjectProcessCurrent(process)) return false;
+  proc_bsdinfo info{}; socket_fdinfo socket{};
+  return Process(listener.pid, &info) &&
+      (info.pbi_pgid == static_cast<uint32_t>(process.pid) ||
+       (process.dedicated_descendants && ChainCurrent(process, listener.ancestry))) &&
+      info.pbi_start_tvsec == listener.started_seconds && info.pbi_start_tvusec == listener.started_microseconds &&
+      Socket(listener.pid, listener.fd, &socket) && socket.psi.soi_so == listener.socket &&
+      socket.psi.soi_proto.pri_tcp.tcpsi_ini.insi_gencnt == listener.generation && LoopbackHost(socket) == listener.host &&
+      ntohs(static_cast<uint16_t>(socket.psi.soi_proto.pri_tcp.tcpsi_ini.insi_lport)) == listener.port;
+}
+}
diff --git a/chrome/browser/ui/aux/native_project_listener.h b/chrome/browser/ui/aux/native_project_listener.h
new file mode 100644
index 0000000..05cb52f
--- /dev/null
