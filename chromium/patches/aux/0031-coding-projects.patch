new file mode 100644
index 0000000..37329bf
--- /dev/null
+++ b/chrome/browser/ui/aux/native_project.cc
@@ -0,0 +1,211 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_project.h"
+#include <Security/Security.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <optional>
+#include "base/apple/scoped_cftyperef.h"
+#include "base/base64.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_file.h"
+#include "base/process/launch.h"
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/ui/aux/native_project_files.h"
+#include "chrome/browser/ui/aux/native_terminal.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/web_contents.h"
+
+namespace aux {
+namespace {
+constexpr size_t kOutputBytes = 1024 * 1024;
+struct GitExecutable {
+  std::string path;
+  uint64_t device;
+  uint64_t inode;
+  int64_t size;
+  int64_t modified_seconds;
+  int64_t modified_nanoseconds;
+};
+std::optional<GitExecutable> InspectGitExecutable(const std::string& path) {
+  base::ScopedFD descriptor(open(path.c_str(), O_RDONLY | O_NOFOLLOW | O_CLOEXEC));
+  struct stat identity{};
+  if (!descriptor.is_valid() || fstat(descriptor.get(), &identity) != 0 ||
+      !S_ISREG(identity.st_mode) || identity.st_uid != 0 ||
+      (identity.st_mode & (S_IWGRP | S_IWOTH)) || !(identity.st_mode & S_IXUSR)) return std::nullopt;
+  return GitExecutable{path, static_cast<uint64_t>(identity.st_dev), static_cast<uint64_t>(identity.st_ino),
+      identity.st_size, identity.st_mtimespec.tv_sec, identity.st_mtimespec.tv_nsec};
+}
+std::optional<GitExecutable> FindInstalledGit() {
+  // Resolve Apple's selected toolchain before applying the read-only Project
+  // policy: /usr/bin/git is an xcrun shim which can write its system cache.
+  // Do not let an ambient DEVELOPER_DIR or PATH select another executable.
+  std::string output;
+  if (!base::GetAppOutput(std::vector<std::string>{"/usr/bin/env", "-i", "PATH=/usr/bin:/bin",
+      "/usr/bin/xcrun", "--find", "git"}, &output) || output.size() > 4096) return std::nullopt;
+  const std::string selected(base::TrimWhitespaceASCII(output, base::TRIM_ALL));
+  base::FilePath resolved;
+  if (selected.empty() || selected.front() != '/' || selected.find('\n') != std::string::npos ||
+      !base::NormalizeFilePath(base::FilePath(selected), &resolved) ||
+      resolved.BaseName().value() != "git" || resolved.value() == "/usr/bin/git") return std::nullopt;
+  auto executable = InspectGitExecutable(resolved.value());
+  if (!executable) return std::nullopt;
+  base::apple::ScopedCFTypeRef<CFURLRef> url(CFURLCreateFromFileSystemRepresentation(kCFAllocatorDefault,
+      reinterpret_cast<const UInt8*>(executable->path.data()), executable->path.size(), false));
+  base::apple::ScopedCFTypeRef<SecStaticCodeRef> code;
+  base::apple::ScopedCFTypeRef<SecRequirementRef> requirement;
+  if (!url || SecStaticCodeCreateWithPath(url.get(), kSecCSDefaultFlags, code.InitializeInto()) != errSecSuccess ||
+      SecRequirementCreateWithString(CFSTR("anchor apple"), kSecCSDefaultFlags, requirement.InitializeInto()) != errSecSuccess ||
+      SecStaticCodeCheckValidity(code.get(), kSecCSCheckAllArchitectures, requirement.get()) != errSecSuccess)
+    return std::nullopt;
+  return executable;
+}
+base::DictValue Fault(const char* message) {
+  return base::DictValue().Set("error", base::DictValue().Set("code", "permission_denied").Set("message", message));
+}
+base::DictValue Closed() { return base::DictValue().Set("result", base::DictValue().Set("closed", true)); }
+}
+struct NativeProject::Work {
+  bool retired = false;
+  bool finished = false;
+  base::OnceCallback<void(base::DictValue)> reply;
+  std::vector<base::OnceCallback<void(base::DictValue)>> closed;
+};
+NativeProject::NativeProject(content::WebContents* owner, content::WeakDocumentPtr document,
+    std::string token, base::DictValue params)
+    : content::WebContentsObserver(owner), document_(document), token_(std::move(token)),
+      params_(std::move(params)), work_(std::make_shared<Work>()) {}
+NativeProject::~NativeProject() { Retire(); }
+bool NativeProject::Current() const { return !work_->retired && document_.AsRenderFrameHostIfValid() && web_contents(); }
+void NativeProject::Start(const std::string& method, base::OnceCallback<void(base::DictValue)> callback) {
+  work_->reply = std::move(callback);
+  if (!Current()) { Finish(Fault("Original Project window retired")); return; }
+  if (method == "native.projectChanges") {
+    output_.resize(3); started_ = base::TimeTicks::Now();
+    base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE,
+        {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN}, base::BindOnce(&FindInstalledGit),
+        base::BindOnce([](base::WeakPtr<NativeProject> owner, std::shared_ptr<Work> work,
+                         std::optional<GitExecutable> executable) {
+          if (owner) {
+            if (!owner->Current()) { owner->Finish(Fault("Original Project window retired")); return; }
+            if (!executable) { owner->Finish(Fault("Apple's installed Git is unavailable or its identity could not be verified")); return; }
+            owner->git_path_ = executable->path; owner->git_device_ = executable->device;
+            owner->git_inode_ = executable->inode; owner->git_size_ = executable->size;
+            owner->git_modified_seconds_ = executable->modified_seconds;
+            owner->git_modified_nanoseconds_ = executable->modified_nanoseconds;
+            owner->BeginGit(); return;
+          }
+          work->finished = true;
+          if (work->reply) std::move(work->reply).Run(Fault("Original Project window retired"));
+          auto callbacks = std::move(work->closed);
+          for (auto& callback : callbacks) std::move(callback).Run(Closed());
+        }, weak_factory_.GetWeakPtr(), work_));
+    return;
+  }
+  const bool listing = method == "native.projectFiles";
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&ReadProjectFiles, params_.Clone(), listing),
+      base::BindOnce([](base::WeakPtr<NativeProject> owner, std::shared_ptr<Work> work, base::DictValue result) {
+        if (owner) { owner->Finish(std::move(result)); return; }
+        work->finished = true;
+        if (work->reply) std::move(work->reply).Run(Fault("Original Project window retired"));
+        auto callbacks = std::move(work->closed);
+        for (auto& callback : callbacks) std::move(callback).Run(Closed());
+      }, weak_factory_.GetWeakPtr(), work_));
+}
+void NativeProject::BeginGit() {
+  if (!Current()) { Finish(Fault("Original Project window retired")); return; }
+  const auto* profile = params_.FindString("sandboxProfile");
+  if (!profile || profile->empty()) { Finish(Fault("Original Project file policy is unavailable")); return; }
+  const auto executable = InspectGitExecutable(git_path_);
+  if (!executable || executable->device != git_device_ || executable->inode != git_inode_ ||
+      executable->size != git_size_ || executable->modified_seconds != git_modified_seconds_ ||
+      executable->modified_nanoseconds != git_modified_nanoseconds_) {
+    Finish(Fault("Original installed Git changed before its Project query")); return;
+  }
+  std::vector<std::string> args = {"-p", *profile, git_path_, "--no-pager", "--no-optional-locks", "--literal-pathspecs",
+      "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", "-c", "color.ui=false", "-c", "core.pager=cat"};
+  if (phase_ == 0) args.insert(args.end(), {"status", "--short", "--untracked-files=normal"});
+  else {
+    args.insert(args.end(), {"diff", "--no-ext-diff", "--no-textconv", "--ignore-submodules=all"});
+    if (phase_ == 1) args.push_back("--cached");
+  }
+  process_ = std::make_unique<NativeTerminal>(web_contents(), document_, token_,
+      base::DictValue().Set("terminalId", *params_.FindString("operationId")).Set("state", "running").Set("cols", 120).Set("rows", 40));
+  std::string error;
+  if (!process_->StartCommand("/usr/bin/sandbox-exec", args,
+      {"PATH=/usr/bin:/bin", "GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL=/dev/null", "GIT_TERMINAL_PROMPT=0", "GIT_OPTIONAL_LOCKS=0"},
+      *params_.FindString("cwd"), *params_.FindString("rootDevice"), *params_.FindString("rootInode"), &error)) {
+    Finish(Fault("The reviewed Project could not start its Git query")); return;
+  }
+  offset_ = 0;
+  timer_.Start(FROM_HERE, base::Milliseconds(15), this, &NativeProject::Poll);
+}
+void NativeProject::Poll() {
+  if (!Current()) { Finish(Fault("Original Project window retired")); return; }
+  if (base::TimeTicks::Now() - started_ > base::Seconds(30)) { Finish(Fault("Git inspection timed out; its original process is being stopped")); return; }
+  auto read = process_->Read(offset_);
+  const auto* result = read.FindDict("result");
+  if (!result) { Finish(std::move(read)); return; }
+  const auto* encoded = result->FindString("data");
+  const auto next = result->FindDouble("nextOffset");
+  const auto* state = result->FindString("state");
+  std::string data;
+  if (!encoded || !next || !state || !base::Base64Decode(*encoded, &data)) { Finish(Fault("Git output acknowledgement changed")); return; }
+  offset_ = static_cast<uint64_t>(*next);
+  const auto remaining = phase_ == 0 ? kOutputBytes - output_[0].size() :
+      kOutputBytes - 64 - output_[1].size() - output_[2].size();
+  const bool limited = data.size() > remaining;
+  if (limited) { output_[phase_].append(data.data(), remaining); truncated_ = true; }
+  else output_[phase_] += data;
+  if (*state != "closed" && !limited) return;
+  if (limited) for (int count = 0; count < 3 && !output_[phase_].empty() && !base::IsStringUTF8(output_[phase_]); ++count) output_[phase_].pop_back();
+  if (!base::IsStringUTF8(output_[phase_])) { Finish(Fault("Git returned non-text output")); return; }
+  timer_.Stop();
+  const auto exit_code = result->FindInt("exitCode");
+  if (*state == "closed" && (!exit_code || *exit_code != 0)) { Finish(Fault("Git could not inspect this reviewed Project")); return; }
+  process_->Close(base::BindOnce([](base::WeakPtr<NativeProject> owner, base::DictValue closed) {
+    if (!owner) return;
+    if (closed.FindDict("error")) { owner->Finish(std::move(closed)); return; }
+    owner->process_.reset();
+    owner->phase_++;
+    if (owner->phase_ < owner->output_.size()) { owner->BeginGit(); return; }
+    auto result = base::DictValue().Set("status", owner->output_[0])
+        .Set("diff", "Staged changes\n" + owner->output_[1] + "\nWorking changes\n" + owner->output_[2]).Set("truncated", owner->truncated_);
+    owner->Finish(base::DictValue().Set("result", std::move(result)));
+  }, weak_factory_.GetWeakPtr()));
+}
+void NativeProject::Finish(base::DictValue result) {
+  timer_.Stop();
+  if (work_->finished) return;
+  if (!Current()) result = Fault("Original Project window retired");
+  auto complete = base::BindOnce([](std::shared_ptr<Work> work, base::DictValue result, base::DictValue closed) {
+    const bool acknowledged = !closed.FindDict("error");
+    work->finished = acknowledged;
+    if (!acknowledged) result = closed.Clone();
+    else if (work->retired) result = Fault("Original Project window retired");
+    if (work->reply) std::move(work->reply).Run(std::move(result));
+    auto callbacks = std::move(work->closed);
+    for (auto& callback : callbacks) std::move(callback).Run(acknowledged ? Closed() : closed.Clone());
+  }, work_, std::move(result));
+  if (process_) process_->Close(std::move(complete));
+  else std::move(complete).Run(Closed());
+}
+bool NativeProject::Finished() const { return work_->finished; }
+void NativeProject::Close(base::OnceCallback<void(base::DictValue)> callback) {
+  work_->retired = true;
+  if (work_->finished) { std::move(callback).Run(Closed()); return; }
+  work_->closed.push_back(std::move(callback));
+  if (process_) Finish(Fault("Original Project query was cancelled"));
+  // File reads acknowledge only after their original descriptor task joins.
+}
+void NativeProject::Retire() {
+  work_->retired = true;
+  if (process_) Finish(Fault("Original Project window retired"));
+}
+void NativeProject::PrimaryPageChanged(content::Page&) { Retire(); }
+void NativeProject::WebContentsDestroyed() { Retire(); }
+}
diff --git a/chrome/browser/ui/aux/native_project.h b/chrome/browser/ui/aux/native_project.h
