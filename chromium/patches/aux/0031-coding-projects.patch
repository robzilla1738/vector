@@ -0,0 +1,55 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_PROJECT_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_PROJECT_H_
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/weak_document_ptr.h"
+namespace aux {
+class NativeTerminal;
+class NativeProject final : public content::WebContentsObserver {
+ public:
+  NativeProject(content::WebContents* owner, content::WeakDocumentPtr document,
+                std::string token, base::DictValue params);
+  ~NativeProject() override;
+  const std::string& token() const { return token_; }
+  void Start(const std::string& method, base::OnceCallback<void(base::DictValue)> callback);
+  bool Finished() const;
+  void Close(base::OnceCallback<void(base::DictValue)> callback);
+  void PrimaryPageChanged(content::Page& page) override;
+  void WebContentsDestroyed() override;
+ private:
+  struct Work;
+  bool Current() const;
+  void BeginGit();
+  void Poll();
+  void Finish(base::DictValue result);
+  void Retire();
+  content::WeakDocumentPtr document_;
+  const std::string token_;
+  base::DictValue params_;
+  std::shared_ptr<Work> work_;
+  std::unique_ptr<NativeTerminal> process_;
+  base::RepeatingTimer timer_;
+  std::vector<std::string> output_;
+  std::string git_path_;
+  uint64_t git_device_ = 0;
+  uint64_t git_inode_ = 0;
+  int64_t git_size_ = 0;
+  int64_t git_modified_seconds_ = 0;
+  int64_t git_modified_nanoseconds_ = 0;
+  size_t phase_ = 0;
+  uint64_t offset_ = 0;
+  bool truncated_ = false;
+  base::TimeTicks started_;
+  base::WeakPtrFactory<NativeProject> weak_factory_{this};
+};
+}
+#endif
diff --git a/chrome/browser/ui/aux/native_project_files.cc b/chrome/browser/ui/aux/native_project_files.cc
new file mode 100644
index 0000000..4b6880d
--- /dev/null
+++ b/chrome/browser/ui/aux/native_project_files.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_project_files.h"
+#include <cerrno>
+#include <cstdint>
+#include <utility>
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <algorithm>
+#include <array>
+#include <string>
+#include <vector>
+#include "base/files/scoped_file.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace aux {
+namespace {
+constexpr size_t kTextBytes = 1024 * 1024;
+constexpr size_t kEntries = 1000;
+base::DictValue Fail(const char* message) {
+  return base::DictValue().Set("error", base::DictValue()
+      .Set("code", "permission_denied").Set("message", message));
+}
+bool Inside(const std::string& path, const std::string& root) {
+  return path == root || path.starts_with(root.ends_with('/') ? root : root + "/");
+}
+bool Permitted(const std::string& path, const base::ListValue& denied) {
+  for (const auto& value : denied) {
+    if (!value.is_string() || Inside(path, value.GetString())) return false;
+  }
+  return true;
+}
+std::vector<std::string> Components(const std::string& path) {
+  std::vector<std::string> parts;
+  size_t offset = 0;
+  while (offset < path.size()) {
+    const auto end = path.find('/', offset);
+    auto part = path.substr(offset, end == std::string::npos ? end : end - offset);
+    if (part.empty() || part == "." || part == "..") return {};
+    parts.push_back(std::move(part));
+    if (end == std::string::npos) break;
+    offset = end + 1;
+    if (offset == path.size()) return {};
+  }
+  return parts;
+}
+}
+
+base::DictValue ReadProjectFiles(const base::DictValue& params, bool listing) {
+  const auto* root = params.FindString("cwd");
+  const auto* path = params.FindString("path");
+  const auto* device = params.FindString("rootDevice");
+  const auto* inode = params.FindString("rootInode");
+  const auto* denied = params.FindList("deniedRoots");
+  if (!root || !path || !device || !inode || !denied || root->empty() ||
+      root->front() != '/' || root->find('\0') != std::string::npos ||
+      path->find('\0') != std::string::npos || path->size() > 4096 ||
+      (!path->empty() && path->front() == '/') || denied->size() > 512)
+    return Fail("Exact reviewed Project access is required");
+  auto parts = Components(*path);
+  if ((!path->empty() && parts.empty()) || (!listing && parts.empty()))
+    return Fail("Choose a relative Project path");
+  base::ScopedFD fd(open(root->c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+  struct stat identity{};
+  if (!fd.is_valid() || fstat(fd.get(), &identity) != 0 ||
+      base::NumberToString(static_cast<uint64_t>(identity.st_dev)) != *device ||
+      base::NumberToString(static_cast<uint64_t>(identity.st_ino)) != *inode)
+    return Fail("The original reviewed Project directory changed");
+  std::string current = *root;
+  if (!Permitted(current, *denied)) return Fail("Project access is excluded by current file permissions");
+  for (size_t i = 0; i < parts.size(); ++i) {
+    current += "/" + parts[i];
+    if (!Permitted(current, *denied)) return Fail("This Project path is excluded by current file permissions");
+    const bool directory = listing || i + 1 < parts.size();
+    base::ScopedFD next(openat(fd.get(), parts[i].c_str(), O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC | (directory ? O_DIRECTORY : 0)));
+    if (!next.is_valid()) return Fail("Project paths cannot follow replaced directories or symbolic links");
+    fd = std::move(next);
+  }
+  if (listing) {
+    const int copy = dup(fd.get());
+    DIR* directory = copy < 0 ? nullptr : fdopendir(copy);
+    if (!directory) { if (copy >= 0) close(copy); return Fail("The Project directory cannot be listed"); }
+    std::vector<base::DictValue> entries;
+    bool truncated = false;
+    int listing_error = 0;
+    for (;;) {
+      errno = 0;
+      auto* item = readdir(directory);
+      if (!item) { listing_error = errno; break; }
+      std::string name(item->d_name);
+      if (name == "." || name == ".." || !base::IsStringUTF8(name) || !Permitted(current + "/" + name, *denied)) continue;
+      if (entries.size() == kEntries) { truncated = true; break; }
+      struct stat info{};
+      if (fstatat(fd.get(), name.c_str(), &info, AT_SYMLINK_NOFOLLOW) != 0) continue;
+      const char* type = S_ISDIR(info.st_mode) ? "directory" : S_ISREG(info.st_mode) ? "file" : S_ISLNK(info.st_mode) ? "symlink" : "other";
+      entries.push_back(base::DictValue().Set("name", name).Set("path", path->empty() ? name : *path + "/" + name)
+          .Set("type", type).Set("size", static_cast<double>(std::max<off_t>(0, info.st_size))));
+    }
+    closedir(directory);
+    if (listing_error) return Fail("The original Project directory could not be completely listed");
+    std::ranges::sort(entries, {}, [](const auto& entry) { return *entry.FindString("name"); });
+    base::ListValue result;
+    for (auto& entry : entries) result.Append(std::move(entry));
+    return base::DictValue().Set("result", base::DictValue().Set("path", *path).Set("entries", std::move(result)).Set("truncated", truncated));
+  }
+  struct stat before{};
+  if (fstat(fd.get(), &before) != 0 || !S_ISREG(before.st_mode)) return Fail("Choose a regular Project file");
+  std::string text;
+  std::array<char, 16384> buffer;
+  while (text.size() < kTextBytes) {
+    const auto count = read(fd.get(), buffer.data(), std::min(buffer.size(), kTextBytes - text.size()));
+    if (count < 0) { if (errno == EINTR) continue; return Fail("Project file read failed"); }
+    if (count == 0) break;
+    text.append(buffer.data(), count);
+  }
+  struct stat after{};
+  if (fstat(fd.get(), &after) != 0 || before.st_size != after.st_size ||
+      before.st_mtimespec.tv_sec != after.st_mtimespec.tv_sec || before.st_mtimespec.tv_nsec != after.st_mtimespec.tv_nsec)
+    return Fail("The Project file changed while it was read");
+  const bool truncated = before.st_size > static_cast<off_t>(text.size());
+  if (truncated) for (int count = 0; count < 3 && !text.empty() && !base::IsStringUTF8(text); ++count) text.pop_back();
+  if (text.find('\0') != std::string::npos || !base::IsStringUTF8(text)) return Fail("This file is binary; choose a text file");
+  return base::DictValue().Set("result", base::DictValue().Set("path", *path).Set("text", std::move(text)).Set("truncated", truncated));
+}
+}
