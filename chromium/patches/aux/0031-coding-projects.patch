+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_PROJECT_PREVIEW_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_PROJECT_PREVIEW_H_
+#include <memory>
+#include <optional>
+#include <string>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "url/gurl.h"
+#include "net/base/ip_endpoint.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "services/network/public/mojom/network_context.mojom-forward.h"
+namespace content { class BrowserContext; class NavigationThrottleRegistry; class RenderFrameHost; class StoragePartition; class WebContents; }
+namespace network { class URLLoaderFactoryBuilder; }
+namespace aux {
+// A live local dev application retains its own origin, routes and network stack.
+// Its cookies/workers live only in a new in-memory partition, never in Profile storage.
+class NativeProjectPreview final : public content::WebContentsDelegate {
+ public:
+  enum class OriginKind { kLocalEndpoint, kPublicHttps };
+  using Review = base::RepeatingCallback<void(base::OnceCallback<void(bool)>)>;
+  NativeProjectPreview(content::WebContents* owner, content::WeakDocumentPtr document,
+      GURL origin, base::RepeatingCallback<bool()> source, Review review,
+      OriginKind origin_kind = OriginKind::kLocalEndpoint);
+  ~NativeProjectPreview() override;
+  bool Open();
+  base::DictValue Describe() const;
+  bool Current() const;
+  bool MatchesEndpoint(const GURL& url, const net::IPEndPoint& endpoint) const;
+  void Admit(const GURL& url, bool navigation, base::OnceCallback<void(bool)> callback);
+  void Close(base::OnceCallback<void(bool)> callback);
+  static bool IsPreviewPartition(content::StoragePartition* partition);
+  static base::WeakPtr<NativeProjectPreview> ForPartition(content::StoragePartition* partition);
+  static void ProxyFactory(content::RenderFrameHost* frame, int process_id, bool navigation,
+                           network::URLLoaderFactoryBuilder& builder,
+                           mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient>* headers);
+  static mojo::PendingRemote<network::mojom::TrustedHeaderClient> WrapHeaders(
+      base::WeakPtr<NativeProjectPreview> preview, mojo::PendingRemote<network::mojom::TrustedHeaderClient> target);
+  static void AddNavigationThrottle(content::NavigationThrottleRegistry& registry);
+ private:
+  void CheckSource();
+  content::StoragePartition* Partition() const;
+  bool Permits(const GURL& url, bool navigation) const;
+  content::WeakDocumentPtr owner_document_;
+  base::WeakPtr<content::WebContents> owner_;
+  base::WeakPtr<content::BrowserContext> context_;
+  const GURL origin_;
+  const OriginKind origin_kind_;
+  base::RepeatingCallback<bool()> source_;
+  Review review_;
+  std::unique_ptr<content::WebContents> guest_;
+  std::optional<content::StoragePartitionConfig> config_;
+  std::string content_id_;
+  bool retired_ = false;
+  bool checking_ = false;
+  struct CloseState;
+  std::shared_ptr<CloseState> close_;
+  base::RepeatingTimer timer_;
+  base::WeakPtrFactory<NativeProjectPreview> weak_factory_{this};
+};
+}
+#endif
