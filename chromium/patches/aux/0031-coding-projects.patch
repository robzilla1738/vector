+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_project_preview.h"
+#include <map>
+#include <set>
+#include <utility>
+#include <vector>
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/no_destructor.h"
+#include "base/task/bind_post_task.h"
+#include "base/uuid.h"
+#include "components/guest_contents/browser/guest_contents_handle.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/render_process_host_observer.h"
+#include "content/public/browser/shared_worker_service.h"
+#include "content/public/browser/child_process_termination_info.h"
+#include "content/public/browser/service_worker_context.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "url/origin.h"
+#include "net/base/url_util.h"
+#include "ui/base/page_transition_types.h"
+namespace aux {
+namespace {
+constexpr char kDomain[] = "aux-project-preview";
+auto& Previews() {
+  static base::NoDestructor<std::map<std::string, base::WeakPtr<NativeProjectPreview>>> registry;
+  return *registry;
+}
+}
+struct NativeProjectPreview::CloseState final : content::RenderProcessHostObserver {
+  bool started = false;
+  bool finished = false;
+  bool failed = false;
+  bool workers_stopped = false;
+  bool cleared = false;
+  std::set<content::RenderProcessHost*> processes;
+  std::shared_ptr<CloseState> keep_alive;
+  std::vector<base::OnceCallback<void(bool)>> callbacks;
+  void Finish() {
+    if (finished || !workers_stopped || !cleared || !processes.empty()) return;
+    finished = true;
+    auto pending = std::move(callbacks);
+    for (auto& callback : pending) std::move(callback).Run(!failed);
+    auto owned = std::move(keep_alive);
+  }
+  void FailedCleanup() { failed = true; workers_stopped = true; cleared = true; Finish(); }
+  void RenderProcessReady(content::RenderProcessHost* host) override {
+    if (workers_stopped && !host->Shutdown(0)) failed = true;
+  }
+  void RenderProcessExited(content::RenderProcessHost* host,
+      const content::ChildProcessTerminationInfo&) override {
+    host->RemoveObserver(this); processes.erase(host); Finish();
+  }
+  void RenderProcessHostDestroyed(content::RenderProcessHost* host) override {
+    // Losing the native actor before its exit notification cannot manufacture ACK.
+    host->RemoveObserver(this); processes.erase(host); failed = true; Finish();
+  }
+};
+NativeProjectPreview::NativeProjectPreview(content::WebContents* owner, content::WeakDocumentPtr document,
+    GURL origin, base::RepeatingCallback<bool()> source, Review review, OriginKind origin_kind)
+    : owner_document_(document), owner_(owner->GetWeakPtr()), context_(owner->GetBrowserContext()->GetWeakPtr()), origin_(std::move(origin)), origin_kind_(origin_kind), source_(std::move(source)), review_(std::move(review)), close_(std::make_shared<CloseState>()) {}
+NativeProjectPreview::~NativeProjectPreview() {
+  Close(base::BindOnce([](bool) {}));
+  if (config_) Previews().erase(config_->partition_name());
+}
+bool NativeProjectPreview::Current() const {
+  auto* frame = owner_document_.AsRenderFrameHostIfValid();
+  return !retired_ && frame && content::WebContents::FromRenderFrameHost(frame) == owner_.get() && source_.Run();
+}
+content::StoragePartition* NativeProjectPreview::Partition() const {
+  return context_ && config_ ? context_->GetStoragePartition(*config_, false) : nullptr;
+}
+bool NativeProjectPreview::Open() {
+  if (!Current() || guest_ || !origin_.SchemeIsHTTPOrHTTPS() || origin_.has_username() || origin_.has_password()) return false;
+  if (origin_kind_ == OriginKind::kPublicHttps && (!origin_.SchemeIs("https") || origin_.EffectiveIntPort() != 443 ||
+      origin_.HostIsIPAddress() || net::IsLocalhost(origin_) || origin_.path() != "/" || origin_.has_query() || origin_.has_ref())) return false;
+  auto* context = owner_->GetBrowserContext();
+  const auto partition = content::StoragePartitionConfig::Create(context, kDomain,
+      base::Uuid::GenerateRandomV4().AsLowercaseString(), true);
+  auto site = content::SiteInstance::CreateForFixedStoragePartition(context, origin_, partition);
+  if (!site) return false;
+  auto* storage = context->GetStoragePartition(site.get());
+  if (!storage || !storage->GetConfig().in_memory()) return false;
+  config_ = storage->GetConfig();
+  Previews()[config_->partition_name()] = weak_factory_.GetWeakPtr();
+  content::WebContents::CreateParams params(context, site);
+  params.opener_suppressed = true;
+  guest_ = content::WebContents::Create(params);
+  if (!guest_) return false;
+  guest_->SetDelegate(this);
+  auto* handle = guest_contents::GuestContentsHandle::CreateForWebContents(guest_.get());
+  handle->SetAttachmentValidator(base::BindRepeating([](base::WeakPtr<NativeProjectPreview> preview, content::RenderFrameHost* outer) {
+    return preview && preview->Current() && outer == preview->owner_document_.AsRenderFrameHostIfValid();
+  }, weak_factory_.GetWeakPtr()));
+  content_id_ = handle->id().ToString();
+  timer_.Start(FROM_HERE, base::Milliseconds(origin_kind_ == OriginKind::kPublicHttps ? 2000 : 100), this, &NativeProjectPreview::CheckSource);
+  guest_->GetController().LoadURL(origin_, content::Referrer(), ui::PAGE_TRANSITION_AUTO_TOPLEVEL, "");
+  return Current();
+}
+base::DictValue NativeProjectPreview::Describe() const {
+  return base::DictValue().Set("contentId", content_id_).Set("url", origin_.spec());
+}
+bool NativeProjectPreview::MatchesEndpoint(const GURL& url, const net::IPEndPoint& endpoint) const {
+  if (!Current()) return false;
+  if (origin_kind_ == OriginKind::kPublicHttps)
+    return (url.SchemeIs("https") || url.SchemeIs("wss")) && url.host() == origin_.host() &&
+        url.EffectiveIntPort() == origin_.EffectiveIntPort() && endpoint.port() == origin_.EffectiveIntPort() && endpoint.address().IsPubliclyRoutable();
+  if (url.host() != origin_.host() || url.EffectiveIntPort() != origin_.EffectiveIntPort()) return url.SchemeIs("https") && endpoint.address().IsPubliclyRoutable();
+  return endpoint.address().ToString() == origin_.HostNoBrackets() && endpoint.port() == origin_.EffectiveIntPort();
+}
+bool NativeProjectPreview::Permits(const GURL& url, bool navigation) const {
+  if (!url.is_valid() || url.has_username() || url.has_password()) return false;
+  if (origin_kind_ == OriginKind::kPublicHttps)
+    return (url.SchemeIs("https") || (!navigation && url.SchemeIs("wss"))) &&
+        url.host() == origin_.host() && url.EffectiveIntPort() == origin_.EffectiveIntPort();
+  if (navigation) return url::Origin::Create(url) == url::Origin::Create(origin_);
+  // The dev app keeps public HTTPS assets. Local requests stay on its exact
+  // admitted endpoint; localhost URLs are never resolved from renderer input.
+  if (url.SchemeIsHTTPOrHTTPS() && url::Origin::Create(url) == url::Origin::Create(origin_)) return true;
+  if (url.SchemeIs("https")) return !net::IsLocalhost(url);
+  if (url.SchemeIs("http")) return false;
+  if (url.SchemeIsWSOrWSS() && url.host() == origin_.host() && url.EffectiveIntPort() == origin_.EffectiveIntPort()) return true;
+  return false;
+}
+void NativeProjectPreview::Admit(const GURL& url, bool navigation, base::OnceCallback<void(bool)> callback) {
+  callback = base::BindPostTaskToCurrentDefault(std::move(callback));
+  if (!Current() || !Permits(url, navigation)) { std::move(callback).Run(false); return; }
+  review_.Run(base::BindOnce([](base::WeakPtr<NativeProjectPreview> preview, GURL url, bool navigation,
+      base::OnceCallback<void(bool)> callback, bool reviewed) {
+    std::move(callback).Run(reviewed && preview && preview->Current() && preview->Permits(url, navigation));
+  }, weak_factory_.GetWeakPtr(), url, navigation, std::move(callback)));
+}
+void NativeProjectPreview::CheckSource() {
+  if (!Current()) { Close(base::BindOnce([](bool) {})); return; }
+  if (checking_) return;
+  checking_ = true;
+  review_.Run(base::BindOnce([](base::WeakPtr<NativeProjectPreview> preview, bool reviewed) {
+    if (!preview) return;
+    preview->checking_ = false;
+    if (!reviewed || !preview->Current()) preview->Close(base::BindOnce([](bool) {}));
+  }, weak_factory_.GetWeakPtr()));
+}
+void NativeProjectPreview::Close(base::OnceCallback<void(bool)> callback) {
+  retired_ = true; timer_.Stop();
+  if (close_->finished) { std::move(callback).Run(!close_->failed); return; }
+  close_->callbacks.push_back(std::move(callback));
+  if (close_->started) return;
+  close_->started = true;
+  close_->keep_alive = close_;
+  // Observe the real actors before dropping document/worker ownership. A unique
+  // partition cannot contain a Profile page or another Project's renderer.
+  auto* partition = Partition();
+  if (partition) {
+    for (auto hosts = content::RenderProcessHost::AllHostsIterator(); !hosts.IsAtEnd(); hosts.Advance()) {
+      auto* host = hosts.GetCurrentValue();
+      if (host->GetStoragePartition() == partition && host->IsInitializedAndNotDead()) {
+        close_->processes.insert(host); host->AddObserver(close_.get());
+      }
+    }
+  }
+  if (guest_) { guest_->Stop(); guest_.reset(); }
+  if (!partition) {
+    close_->failed = config_.has_value();
+    close_->workers_stopped = true; close_->cleared = true; close_->Finish(); return;
+  }
+  partition->GetSharedWorkerService()->Shutdown();
+  auto failed = base::ScopedClosureRunner(base::BindOnce([](std::shared_ptr<CloseState> state) {
+    state->FailedCleanup();
+  }, close_));
+  partition->GetServiceWorkerContext()->StopAllServiceWorkers(base::BindOnce([](
+      base::WeakPtr<content::BrowserContext> context, content::StoragePartitionConfig config,
+      std::shared_ptr<CloseState> state, base::ScopedClosureRunner failed) {
+    failed.Release().Reset();
+    auto* partition = context ? context->GetStoragePartition(config, false) : nullptr;
+    if (!partition) { state->FailedCleanup(); return; }
+    state->workers_stopped = true;
+    // Include actors whose startup finished while service-worker Stop awaited.
+    for (auto hosts = content::RenderProcessHost::AllHostsIterator(); !hosts.IsAtEnd(); hosts.Advance()) {
+      auto* host = hosts.GetCurrentValue();
+      if (host->GetStoragePartition() == partition && host->IsInitializedAndNotDead() && state->processes.insert(host).second)
+        host->AddObserver(state.get());
+    }
+    // WebSockets and dedicated/shared workers in this exact partition cannot
+    // survive an acknowledged renderer exit, even if their script ignores Stop.
+    const auto processes = state->processes;
+    for (auto* host : processes) if (state->processes.contains(host)) {
+      if (host->IsReady() && !host->Shutdown(0)) state->failed = true;
+    }
+    auto cleanup_failed = base::ScopedClosureRunner(base::BindOnce([](std::shared_ptr<CloseState> state) {
+      state->FailedCleanup();
+    }, state));
+    partition->ClearData(content::StoragePartition::REMOVE_DATA_MASK_ALL, nullptr, {},
+        network::mojom::CookieDeletionFilter::New(), false,
+        base::Time(), base::Time::Max(), base::BindOnce([](std::shared_ptr<CloseState> state,
+            base::ScopedClosureRunner failed) {
+          failed.Release().Reset(); state->cleared = true; state->Finish();
+        }, state, std::move(cleanup_failed)));
+  }, context_, *config_, close_, std::move(failed)));
+}
+bool NativeProjectPreview::IsPreviewPartition(content::StoragePartition* partition) {
+  return partition && partition->GetConfig().in_memory() && partition->GetConfig().partition_domain() == kDomain;
+}
+base::WeakPtr<NativeProjectPreview> NativeProjectPreview::ForPartition(content::StoragePartition* partition) {
+  auto found = partition ? Previews().find(partition->GetConfig().partition_name()) : Previews().end();
+  return found == Previews().end() ? base::WeakPtr<NativeProjectPreview>() : found->second;
+}
+}
