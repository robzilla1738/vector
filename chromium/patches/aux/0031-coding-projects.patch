@@ -0,0 +1,376 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_project_preview.h"
+#include <optional>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/memory/self_deleting.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/web_contents.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "mojo/public/cpp/bindings/self_owned_receiver.h"
+#include "net/base/net_errors.h"
+#include "net/base/url_util.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/http_request_headers_update_params.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/self_deleting_url_loader_factory.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/cpp/url_loader_factory_builder.h"
+#include "services/network/public/mojom/early_hints.mojom.h"
+#include "services/network/public/mojom/network_context.mojom.h"
+#include "services/network/public/mojom/url_loader.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+namespace aux {
+namespace {
+void Check(base::WeakPtr<NativeProjectPreview> preview, const GURL& url, bool navigation,
+    base::OnceCallback<void(bool)> callback) {
+  if (!preview) { std::move(callback).Run(false); return; }
+  preview->Admit(url, navigation, std::move(callback));
+}
+class PreviewHeader final : public network::mojom::TrustedHeaderClient {
+ public:
+  PreviewHeader(base::WeakPtr<NativeProjectPreview> preview, bool navigation,
+      mojo::PendingRemote<network::mojom::TrustedHeaderClient> target)
+      : preview_(preview), navigation_(navigation), required_(!!target), target_(std::move(target)) {}
+  void OnConnected(const GURL& url,
+                   network::mojom::TrustedConnectionInfoPtr connection,
+                   OnConnectedCallback callback) override {
+    if (!connection || !preview_ || url != last_url_ ||
+        !preview_->MatchesEndpoint(url, connection->endpoint)) {
+      std::move(callback).Run(net::ERR_ACCESS_DENIED, std::nullopt);
+      return;
+    }
+    const auto endpoint = connection->endpoint;
+    auto reviewed =
+        base::BindOnce(&PreviewHeader::ReviewedConnection, weak_.GetWeakPtr(),
+                       url, endpoint, std::move(callback));
+    if (target_) {
+      target_->OnConnected(
+          url, std::move(connection),
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              std::move(reviewed), net::ERR_FAILED, std::nullopt));
+    } else {
+      std::move(reviewed).Run(required_ ? net::ERR_FAILED : net::OK,
+                              std::nullopt);
+    }
+  }
+  void OnBeforeSendHeaders(const GURL& url, const net::HttpRequestHeaders& headers,
+      OnBeforeSendHeadersCallback callback) override {
+    last_url_ = url;
+    if (target_) {
+      target_->OnBeforeSendHeaders(
+          url, headers,
+          mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+              base::BindOnce(&PreviewHeader::ReviewedHeaders,
+                             weak_.GetWeakPtr(), url, std::move(callback)),
+              net::ERR_FAILED, std::nullopt, std::nullopt, std::nullopt));
+    } else {
+      ReviewedHeaders(url, std::move(callback),
+                      required_ ? net::ERR_FAILED : net::OK, std::nullopt,
+                      std::nullopt, std::nullopt);
+    }
+  }
+  void OnHeadersReceived(const std::string& headers, const net::IPEndPoint& endpoint,
+      const std::optional<net::SSLInfo>& ssl, OnHeadersReceivedCallback callback) override {
+    if (!preview_ || !preview_->MatchesEndpoint(last_url_, endpoint)) {
+      std::move(callback).Run(net::ERR_ACCESS_DENIED, std::nullopt, std::nullopt); return;
+    }
+    if (target_) target_->OnHeadersReceived(headers, endpoint, ssl, mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+        base::BindOnce(&PreviewHeader::ReviewedResponse, weak_.GetWeakPtr(), endpoint, std::move(callback)),
+        net::ERR_FAILED, std::nullopt, std::nullopt));
+    else ReviewedResponse(endpoint, std::move(callback), required_ ? net::ERR_FAILED : net::OK, std::nullopt, std::nullopt);
+  }
+ private:
+  void ReviewedConnection(GURL url,
+                          net::IPEndPoint endpoint,
+                          OnConnectedCallback callback,
+                          int32_t result,
+                          const std::optional<GURL>& native_policy_redirect) {
+    if (result != net::OK || !preview_ || url != last_url_ ||
+        !preview_->MatchesEndpoint(url, endpoint)) {
+      std::move(callback).Run(
+          result == net::OK ? net::ERR_ACCESS_DENIED : result,
+          preview_ && url == last_url_ &&
+                  preview_->MatchesEndpoint(url, endpoint)
+              ? native_policy_redirect
+              : std::nullopt);
+      return;
+    }
+    Check(
+        preview_, url, navigation_,
+        base::BindOnce(
+            [](base::WeakPtr<NativeProjectPreview> preview, GURL url,
+               net::IPEndPoint endpoint, OnConnectedCallback callback,
+               bool allowed) {
+              std::move(callback).Run(
+                  allowed && preview && preview->MatchesEndpoint(url, endpoint)
+                      ? net::OK
+                      : net::ERR_ACCESS_DENIED,
+                  std::nullopt);
+            },
+            preview_, url, endpoint, std::move(callback)));
+  }
+  void ReviewedResponse(net::IPEndPoint endpoint, OnHeadersReceivedCallback callback, int32_t result,
+      const std::optional<std::string>& headers, const std::optional<GURL>& preserve) {
+    if (result != net::OK || !preview_ || !preview_->MatchesEndpoint(last_url_, endpoint)) {
+      std::move(callback).Run(result == net::OK ? net::ERR_ACCESS_DENIED : result, std::nullopt, std::nullopt); return;
+    }
+    Check(preview_, last_url_, navigation_, base::BindOnce([](base::WeakPtr<NativeProjectPreview> preview,
+        GURL url, net::IPEndPoint endpoint, OnHeadersReceivedCallback callback,
+        std::optional<std::string> headers, std::optional<GURL> preserve, bool allowed) {
+      const bool current = allowed && preview && preview->MatchesEndpoint(url, endpoint);
+      std::move(callback).Run(current ? net::OK : net::ERR_ACCESS_DENIED,
+          current ? std::move(headers) : std::nullopt, current ? std::move(preserve) : std::nullopt);
+    }, preview_, last_url_, endpoint, std::move(callback), std::move(headers), std::move(preserve)));
+  }
+  void ReviewedHeaders(GURL url,
+                       OnBeforeSendHeadersCallback callback,
+                       int32_t result,
+                       const std::optional<net::HttpRequestHeaders>& headers,
+                       std::optional<base::DictValue> log,
+                       const std::optional<GURL>& native_policy_redirect) {
+    if (result != net::OK) {
+      std::move(callback).Run(result, std::nullopt, std::nullopt,
+                              native_policy_redirect);
+      return;
+    }
+    // The final authority check follows all existing browser header mutations.
+    Check(preview_, url, navigation_,
+          base::BindOnce(
+              [](OnBeforeSendHeadersCallback callback,
+                 std::optional<net::HttpRequestHeaders> headers,
+                 std::optional<base::DictValue> log, bool allowed) {
+                std::move(callback).Run(
+                    allowed ? net::OK : net::ERR_ACCESS_DENIED,
+                    allowed ? headers : std::nullopt,
+                    allowed ? std::move(log) : std::nullopt, std::nullopt);
+              },
+              std::move(callback), headers, std::move(log)));
+  }
+  base::WeakPtr<NativeProjectPreview> preview_;
+  const bool navigation_;
+  const bool required_;
+  mojo::Remote<network::mojom::TrustedHeaderClient> target_;
+  GURL last_url_;
+  base::WeakPtrFactory<PreviewHeader> weak_{this};
+};
+class PreviewFactoryHeaders final : public network::mojom::TrustedURLLoaderHeaderClient {
+ public:
+  PreviewFactoryHeaders(base::WeakPtr<NativeProjectPreview> preview, bool navigation,
+      mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient> target)
+      : preview_(preview), navigation_(navigation), target_(std::move(target)) {}
+  void OnLoaderCreated(int32_t id, mojo::PendingReceiver<network::mojom::TrustedHeaderClient> receiver) override {
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> target;
+    if (target_) target_->OnLoaderCreated(id, target.InitWithNewPipeAndPassReceiver());
+    mojo::MakeSelfOwnedReceiver(std::make_unique<PreviewHeader>(preview_, navigation_, std::move(target)), std::move(receiver));
+  }
+  void OnLoaderForCorsPreflightCreated(const network::ResourceRequest& request,
+      mojo::PendingReceiver<network::mojom::TrustedHeaderClient> receiver) override {
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient> target;
+    if (target_) target_->OnLoaderForCorsPreflightCreated(request, target.InitWithNewPipeAndPassReceiver());
+    mojo::MakeSelfOwnedReceiver(std::make_unique<PreviewHeader>(preview_, false, std::move(target)), std::move(receiver));
+  }
+ private:
+  base::WeakPtr<NativeProjectPreview> preview_;
+  const bool navigation_;
+  mojo::Remote<network::mojom::TrustedURLLoaderHeaderClient> target_;
+};
+class PreviewRequest final : public network::mojom::URLLoader, public network::mojom::URLLoaderClient {
+ public:
+  PreviewRequest(mojo::PendingReceiver<network::mojom::URLLoader> loader,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      base::WeakPtr<NativeProjectPreview> preview, GURL url, bool navigation)
+      : client_(std::move(client)), receiver_(this, std::move(loader)), target_receiver_(this), preview_(preview),
+        url_(std::move(url)), navigation_(navigation) {
+    receiver_.set_disconnect_handler(base::BindOnce(&PreviewRequest::Cancel, base::Unretained(this)));
+    client_.set_disconnect_handler(base::BindOnce(&PreviewRequest::Cancel, base::Unretained(this)));
+  }
+  void Hold(std::shared_ptr<PreviewRequest> owned) { keep_alive_ = std::move(owned); }
+  mojo::PendingRemote<network::mojom::URLLoaderClient> Client() {
+    auto client = target_receiver_.BindNewPipeAndPassRemote();
+    target_receiver_.set_disconnect_handler(base::BindOnce(
+        &PreviewRequest::TargetDisconnected, base::Unretained(this)));
+    return client;
+  }
+  mojo::PendingReceiver<network::mojom::URLLoader> Target() { return target_.BindNewPipeAndPassReceiver(); }
+  void FollowRedirect(network::HttpRequestHeadersUpdateParams headers, const std::optional<GURL>& override_url) override {
+    if (!redirect_ || terminal_) { Reject(); return; }
+    const auto url = override_url.value_or(*redirect_);
+    ++pending_;
+    Check(preview_, url, navigation_, base::BindOnce([](base::WeakPtr<PreviewRequest> request,
+        network::HttpRequestHeadersUpdateParams headers, std::optional<GURL> override_url, GURL url, bool allowed) {
+      if (!request) return;
+      if (!allowed || request->terminal_) { request->Reject(); return; }
+      request->url_ = std::move(url); request->redirect_.reset();
+      request->target_->FollowRedirect(std::move(headers), override_url);
+      request->ReviewFinished();
+    }, weak_.GetWeakPtr(), std::move(headers), override_url, url));
+  }
+  void SetPriority(net::RequestPriority priority, int32_t value) override { if (target_ && !terminal_) target_->SetPriority(priority, value); }
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr hints) override {
+    if (!preview_ || !preview_->Current()) { Reject(); return; }
+    client_->OnReceiveEarlyHints(std::move(hints));
+  }
+  void OnReceiveResponse(network::mojom::URLResponseHeadPtr head, mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer> metadata) override {
+    ++pending_;
+    Check(preview_, url_, navigation_, base::BindOnce([](base::WeakPtr<PreviewRequest> request,
+        network::mojom::URLResponseHeadPtr head, mojo::ScopedDataPipeConsumerHandle body,
+        std::optional<mojo_base::BigBuffer> metadata, bool allowed) {
+      if (!request) return;
+      if (!allowed || request->terminal_) { request->Reject(); return; }
+      request->client_->OnReceiveResponse(std::move(head), std::move(body), std::move(metadata));
+      request->ReviewFinished();
+    }, weak_.GetWeakPtr(), std::move(head), std::move(body), std::move(metadata)));
+  }
+  void OnReceiveRedirect(const net::RedirectInfo& info, network::mojom::URLResponseHeadPtr head) override {
+    ++pending_;
+    Check(preview_, info.new_url, navigation_, base::BindOnce([](base::WeakPtr<PreviewRequest> request,
+        net::RedirectInfo info, network::mojom::URLResponseHeadPtr head, bool allowed) {
+      if (!request) return;
+      if (!allowed || request->terminal_) { request->Reject(); return; }
+      request->redirect_ = info.new_url;
+      request->client_->OnReceiveRedirect(info, std::move(head));
+      request->ReviewFinished();
+    }, weak_.GetWeakPtr(), info, std::move(head)));
+  }
+  void OnUploadProgress(int64_t current, int64_t total, OnUploadProgressCallback callback) override {
+    if (!terminal_) client_->OnUploadProgress(current, total, std::move(callback));
+    else std::move(callback).Run();
+  }
+  void OnTransferSizeUpdated(int32_t size) override { if (!terminal_) client_->OnTransferSizeUpdated(size); }
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    if (terminal_) return;
+    completion_ = status;
+    FinishIfReady();
+  }
+ private:
+  void Release() {
+    receiver_.reset(); target_receiver_.reset(); target_.reset(); weak_.InvalidateWeakPtrs();
+    auto owned = std::move(keep_alive_);
+  }
+  void ReviewFinished() { --pending_; FinishIfReady(); }
+  void FinishIfReady() {
+    if (terminal_ || pending_ || !completion_) return;
+    terminal_ = true; client_->OnComplete(*completion_); Release();
+  }
+  void TargetDisconnected() {
+    if (!terminal_ && !completion_) Reject();
+    // OnComplete may precede the runtime review. Keep this actual request
+    // alive until its deferred response/redirect is admitted or refused.
+  }
+  void Cancel() { terminal_ = true; Release(); }
+  void Reject() {
+    if (terminal_) return;
+    terminal_ = true; client_->OnComplete(network::URLLoaderCompletionStatus(net::ERR_ACCESS_DENIED));
+    Release();
+  }
+  mojo::Remote<network::mojom::URLLoaderClient> client_;
+  mojo::Receiver<network::mojom::URLLoader> receiver_;
+  mojo::Receiver<network::mojom::URLLoaderClient> target_receiver_;
+  std::shared_ptr<PreviewRequest> keep_alive_;
+  size_t pending_ = 0;
+  std::optional<network::URLLoaderCompletionStatus> completion_;
+  mojo::Remote<network::mojom::URLLoader> target_;
+  base::WeakPtr<NativeProjectPreview> preview_;
+  GURL url_;
+  const bool navigation_;
+  std::optional<GURL> redirect_;
+  bool terminal_ = false;
+  base::WeakPtrFactory<PreviewRequest> weak_{this};
+};
+class PreviewFactory final : public network::SelfDeletingURLLoaderFactory {
+ public:
+  PreviewFactory(mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target,
+      base::WeakPtr<NativeProjectPreview> preview, base::SelfDeletingPassKey key)
+      : network::SelfDeletingURLLoaderFactory(std::move(receiver), key), target_(std::move(target)), preview_(preview) {
+    target_.set_disconnect_handler(base::BindOnce(&PreviewFactory::Lost, base::Unretained(this)));
+  }
+  void CreateLoaderAndStart(mojo::PendingReceiver<network::mojom::URLLoader> receiver, int32_t id, uint32_t options,
+      const network::ResourceRequest& request, mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& annotation) override {
+    const bool navigation = request.destination == network::mojom::RequestDestination::kDocument ||
+        request.destination == network::mojom::RequestDestination::kIframe;
+    Check(preview_, request.url, navigation, base::BindOnce([](base::WeakPtr<PreviewFactory> factory,
+        mojo::PendingReceiver<network::mojom::URLLoader> receiver, int32_t id, uint32_t options,
+        network::ResourceRequest request, mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+        net::MutableNetworkTrafficAnnotationTag annotation, bool allowed) {
+      if (!factory || !allowed) {
+        mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))->OnComplete(
+            network::URLLoaderCompletionStatus(net::ERR_ACCESS_DENIED)); return;
+      }
+      const bool navigation = request.destination == network::mojom::RequestDestination::kDocument ||
+          request.destination == network::mojom::RequestDestination::kIframe;
+      auto guard = std::make_shared<PreviewRequest>(std::move(receiver), std::move(client), factory->preview_, request.url, navigation);
+      guard->Hold(guard);
+      auto target = guard->Target();
+      auto guarded_client = guard->Client();
+      // Public asset hostnames must never resolve into another local service.
+      request.required_ip_address_space = net::IsLocalhost(request.url) ? network::mojom::IPAddressSpace::kLoopback : network::mojom::IPAddressSpace::kPublic;
+      factory->target_->CreateLoaderAndStart(std::move(target), id, options, request, std::move(guarded_client), annotation);
+    }, weak_.GetWeakPtr(), std::move(receiver), id, options, request, std::move(client), annotation));
+  }
+ private:
+  ~PreviewFactory() override = default;
+  void Lost() { DisconnectReceiversAndDestroy(); }
+  mojo::Remote<network::mojom::URLLoaderFactory> target_;
+  base::WeakPtr<NativeProjectPreview> preview_;
+  base::WeakPtrFactory<PreviewFactory> weak_{this};
+};
+class PreviewNavigation final : public content::NavigationThrottle {
+ public:
+  PreviewNavigation(content::NavigationThrottleRegistry& registry, base::WeakPtr<NativeProjectPreview> preview)
+      : content::NavigationThrottle(registry), preview_(preview) {}
+  ThrottleCheckResult WillStartRequest() override { return Review(); }
+  ThrottleCheckResult WillRedirectRequest() override { return Review(); }
+  const char* GetNameForLogging() override { return "AuxProjectPreview"; }
+ private:
+  ThrottleCheckResult Review() {
+    if (!preview_ || !preview_->Current()) return CANCEL_AND_IGNORE;
+    Check(preview_, navigation_handle()->GetURL(), true,
+        base::BindOnce([](base::WeakPtr<PreviewNavigation> navigation, bool allowed) {
+          if (!navigation) return;
+          if (allowed) navigation->Resume();
+          else navigation->CancelDeferredNavigation(CANCEL_AND_IGNORE);
+        }, weak_.GetWeakPtr()));
+    return DEFER;
+  }
+  base::WeakPtr<NativeProjectPreview> preview_;
+  base::WeakPtrFactory<PreviewNavigation> weak_{this};
+};
+}
+void NativeProjectPreview::ProxyFactory(content::RenderFrameHost* frame, int process_id, bool navigation, network::URLLoaderFactoryBuilder& builder,
+    mojo::PendingRemote<network::mojom::TrustedURLLoaderHeaderClient>* headers) {
+  auto* process = frame ? frame->GetProcess() : content::RenderProcessHost::FromID(process_id);
+  auto* partition = process ? process->GetStoragePartition() : nullptr;
+  if (!IsPreviewPartition(partition)) return;
+  if (headers) {
+    auto original = std::move(*headers);
+    mojo::MakeSelfOwnedReceiver(std::make_unique<PreviewFactoryHeaders>(ForPartition(partition), navigation, std::move(original)),
+        headers->InitWithNewPipeAndPassReceiver());
+  }
+  auto [receiver, target] = builder.Append();
+  base::MakeSelfDeleting<PreviewFactory>(std::move(receiver), std::move(target), headers ? ForPartition(partition) : base::WeakPtr<NativeProjectPreview>());
+}
+mojo::PendingRemote<network::mojom::TrustedHeaderClient> NativeProjectPreview::WrapHeaders(
+    base::WeakPtr<NativeProjectPreview> preview, mojo::PendingRemote<network::mojom::TrustedHeaderClient> target) {
+  mojo::PendingRemote<network::mojom::TrustedHeaderClient> wrapped;
+  mojo::MakeSelfOwnedReceiver(std::make_unique<PreviewHeader>(preview, false, std::move(target)),
+      wrapped.InitWithNewPipeAndPassReceiver());
+  return wrapped;
+}
+void NativeProjectPreview::AddNavigationThrottle(content::NavigationThrottleRegistry& registry) {
+  auto* contents = registry.GetNavigationHandle().GetWebContents();
+  auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+  auto* partition = frame ? frame->GetProcess()->GetStoragePartition() : nullptr;
+  if (IsPreviewPartition(partition)) registry.AddThrottle(std::make_unique<PreviewNavigation>(registry, ForPartition(partition)));
+}
+}
diff --git a/chrome/browser/ui/aux/native_terminal.cc b/chrome/browser/ui/aux/native_terminal.cc
new file mode 100644
index 0000000..228f2cd
--- /dev/null
+++ b/chrome/browser/ui/aux/native_terminal.cc
@@ -0,0 +1,308 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_terminal.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <stdlib.h>
+#include <array>
+#include <optional>
+#include <algorithm>
+#include <vector>
+#include "base/base64.h"
+#include "base/environment.h"
+#include "base/uuid.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+namespace aux {
+namespace {
+base::DictValue Fault(const std::string& message) {
+  return base::DictValue().Set("error", base::DictValue().Set("code", "ref_stale").Set("message", message));
+}
+base::DictValue Result(base::DictValue value) { return base::DictValue().Set("result", std::move(value)); }
+struct Termination {
+  bool acknowledged = true;
+  std::optional<int> exit_code;
+  std::vector<NativeProjectProcess> processes;
+};
+Termination KillAndReap(pid_t pid, int fd, NativeProjectProcess process, bool fenced,
+                        std::vector<NativeProjectProcess> remembered) {
+  Termination result;
+  result.processes = std::move(remembered);
+  if (pid > 0) {
+    result.acknowledged = StopProjectProcesses(process, fenced, &result.processes);
+    // This is the exact unreaped child returned by our fork, even if birth
+    // capture failed before Start could acknowledge it. Never adopt another PID.
+    if (kill(pid, SIGKILL) != 0 && errno != ESRCH) result.acknowledged = false;
+  }
+  // A session leader's exit can wait for its controlling PTY output to drain.
+  // Disconnect and flush the original master before joining that exit.
+  if (fd >= 0) result.acknowledged &= close(fd) == 0;
+  if (pid > 0) {
+    int status = 0;
+    pid_t reaped;
+    do { reaped = waitpid(pid, &status, 0); } while (reaped < 0 && errno == EINTR);
+    result.acknowledged &= reaped == pid;
+    if (reaped == pid)
+      result.exit_code = WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
+  }
+  return result;
+}
+}  // namespace
+NativeTerminal::NativeTerminal(content::WebContents* owner, content::WeakDocumentPtr document,
+    std::string token, base::DictValue session)
+    : content::WebContentsObserver(owner), document_(std::move(document)), token_(std::move(token)), session_(std::move(session)) {}
+NativeTerminal::~NativeTerminal() { Retire(); }
+bool NativeTerminal::Current() const { return document_.AsRenderFrameHostIfValid() && web_contents(); }
+base::DictValue NativeTerminal::Session() const { return session_.Clone(); }
+bool NativeTerminal::Start(const std::string& executable, const std::string& cwd, const std::string& device, const std::string& inode, std::string* error) {
+  dedicated_descendants_ = true;
+  return StartCommand(executable, {"-l"}, {}, cwd, device, inode, error);
+}
+bool NativeTerminal::StartCommand(const std::string& executable, const std::vector<std::string>& args,
+    const std::vector<std::string>& overrides, const std::string& cwd,
+    const std::string& device, const std::string& inode, std::string* error) {
+  if (!Current() || executable.empty() || executable.front() != '/' || cwd.empty() || cwd.front() != '/') { *error = "Original terminal launch is unavailable"; return false; }
+  const int directory = open(cwd.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  struct stat identity{};
+  if (directory < 0 || fstat(directory, &identity) != 0 ||
+      base::NumberToString(static_cast<uint64_t>(identity.st_dev)) != device ||
+      base::NumberToString(static_cast<uint64_t>(identity.st_ino)) != inode) {
+    if (directory >= 0) close(directory);
+    *error = "Original Project directory changed before launch"; return false;
+  }
+  // Pass only the user's terminal environment, never runtime/provider credentials.
+  auto env = base::Environment::Create();
+  std::vector<std::string> values;
+  for (base::cstring_view name : {base::cstring_view("HOME"), base::cstring_view("USER"), base::cstring_view("LOGNAME"), base::cstring_view("SHELL"), base::cstring_view("PATH"), base::cstring_view("LANG"), base::cstring_view("LC_ALL"), base::cstring_view("TMPDIR")}) {
+    auto value = env->GetVar(name);
+    if (value) values.push_back(std::string(name.c_str()) + "=" + *value);
+  }
+  values.push_back("TERM=xterm-256color"); values.push_back("COLORTERM=truecolor");
+  for (const auto& value : overrides) {
+    const auto separator = value.find('=');
+    const auto prefix = value.substr(0, separator + 1);
+    std::erase_if(values, [&](const auto& existing) { return existing.starts_with(prefix); });
+    values.push_back(value);
+  }
+  std::vector<char*> environment;
+  for (auto& value : values) environment.push_back(value.data());
+  environment.push_back(nullptr);
+  std::vector<char*> arguments;
+  arguments.push_back(const_cast<char*>(executable.c_str()));
+  for (const auto& arg : args) arguments.push_back(const_cast<char*>(arg.c_str()));
+  arguments.push_back(nullptr);
+  winsize size{}; size.ws_col = *session_.FindInt("cols"); size.ws_row = *session_.FindInt("rows");
+  const int descriptor_limit = getdtablesize();
+  master_ = posix_openpt(O_RDWR | O_NOCTTY | O_CLOEXEC);
+  std::array<char, 128> slave_name;
+  int slave = -1;
+  if (master_ >= 0 && grantpt(master_) == 0 && unlockpt(master_) == 0 &&
+      ptsname_r(master_, slave_name.data(), slave_name.size()) == 0) {
+    slave = open(slave_name.data(), O_RDWR | O_NOCTTY | O_CLOEXEC);
+  }
+  if (slave < 0 || ioctl(slave, TIOCSWINSZ, &size) != 0) {
+    if (slave >= 0) close(slave);
+    if (master_ >= 0) close(master_);
+    master_ = -1;
+    close(directory);
+    *error = "Cannot create terminal descriptors"; return false;
+  }
+  pid_ = fork();
+  if (pid_ == 0) {
+    // The forked child does no allocation or Chromium work before exec.
+    if (fchdir(directory) != 0) _exit(126);
+    if (setsid() < 0 || ioctl(slave, TIOCSCTTY, 0) != 0 ||
+        dup2(slave, STDIN_FILENO) < 0 || dup2(slave, STDOUT_FILENO) < 0 ||
+        dup2(slave, STDERR_FILENO) < 0) _exit(126);
+    for (int fd = STDIN_FILENO; fd <= STDERR_FILENO; ++fd)
+      if (fcntl(fd, F_SETFD, 0) != 0) _exit(126);
+    for (int fd = 3; fd < descriptor_limit; ++fd) close(fd);
+    sigset_t empty; sigemptyset(&empty); sigprocmask(SIG_SETMASK, &empty, nullptr);
+    execve(executable.c_str(), arguments.data(), environment.data());
+    _exit(127);
+  }
+  close(slave);
+  close(directory);
+  if (pid_ < 0) { close(master_); master_ = -1; *error = "Cannot create terminal process"; return false; }
+  const int flags = fcntl(master_, F_GETFL);
+  if (flags < 0 || fcntl(master_, F_SETFL, flags | O_NONBLOCK) < 0 || fcntl(master_, F_SETFD, FD_CLOEXEC) < 0) {
+    Retire(); *error = "Cannot configure terminal descriptor"; return false;
+  }
+  if (!CaptureProjectProcess(pid_, &process_, dedicated_descendants_)) { Retire(); *error = "Original process identity is unavailable"; return false; }
+  cwd_ = cwd; device_ = device; inode_ = inode;
+  return true;
+}
+bool NativeTerminal::PreviewCurrent(const NativeProjectListener& listener) const {
+  if (!Current() || closing_ || pid_ <= 0 || !ProjectListenerCurrent(process_, listener)) return false;
+  const int directory = open(cwd_.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  struct stat identity{};
+  const bool current = directory >= 0 && fstat(directory, &identity) == 0 &&
+      base::NumberToString(static_cast<uint64_t>(identity.st_dev)) == device_ &&
+      base::NumberToString(static_cast<uint64_t>(identity.st_ino)) == inode_;
+  if (directory >= 0) close(directory);
+  return current;
+}
+void NativeTerminal::Listeners(base::OnceCallback<void(base::DictValue)> callback) {
+  if (!Current() || closing_ || !ProjectProcessCurrent(process_)) {
+    std::move(callback).Run(Fault("Original terminal process retired")); return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&FindProjectListeners, process_), base::BindOnce(
+          [](base::WeakPtr<NativeTerminal> owner, base::OnceCallback<void(base::DictValue)> callback,
+             std::vector<NativeProjectListener> listeners) {
+            if (!owner || !owner->Current() || owner->closing_ || !ProjectProcessCurrent(owner->process_)) {
+              std::move(callback).Run(Fault("Original terminal process retired")); return;
+            }
+            base::ListValue result;
+            // Preserve opaque IDs only for the same live kernel socket; never reuse an old ID.
+            std::map<std::string, NativeProjectListener> admitted;
+            for (const auto& listener : listeners) {
+              if (!owner->PreviewCurrent(listener)) continue;
+              std::string id;
+              for (const auto& [old_id, old] : owner->listeners_) {
+                if (old.pid == listener.pid && old.fd == listener.fd && old.socket == listener.socket &&
+                    old.generation == listener.generation && old.started_seconds == listener.started_seconds &&
+                    old.started_microseconds == listener.started_microseconds) { id = old_id; break; }
+              }
+              if (id.empty()) id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+              admitted.emplace(id, listener);
+              result.Append(base::DictValue().Set("listenerId", id).Set("url",
+                  base::StrCat({"http://", listener.host, ":", base::NumberToString(listener.port), "/"})));
+            }
+            owner->listeners_ = std::move(admitted);
+            std::move(callback).Run(Result(base::DictValue().Set("terminalId", *owner->session_.FindString("terminalId"))
+                .Set("listeners", std::move(result))));
+          }, weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+base::DictValue NativeTerminal::Preview(const std::string& listener_id, const std::string& preview_id,
+    const std::string& protocol, NativeProjectPreview::Review review) {
+  const auto listener = listeners_.find(listener_id);
+  if (listener == listeners_.end() || !PreviewCurrent(listener->second) || previews_.contains(preview_id) ||
+      previews_.size() >= 8 || (protocol != "http" && protocol != "https")) return Fault("Original Project listener changed");
+  const auto proof = listener->second;
+  const GURL origin(base::StrCat({protocol, "://", proof.host, ":", base::NumberToString(proof.port), "/"}));
+  auto preview = std::make_unique<NativeProjectPreview>(web_contents(), document_, origin,
+      base::BindRepeating([](base::WeakPtr<NativeTerminal> owner, NativeProjectListener listener) {
+        return owner && owner->PreviewCurrent(listener);
+      }, weak_factory_.GetWeakPtr(), proof), std::move(review));
+  if (!preview->Open()) return Fault("Cannot attach original Project preview");
+  auto result = preview->Describe(); result.Set("terminalId", *session_.FindString("terminalId")); result.Set("previewId", preview_id);
+  previews_.emplace(preview_id, std::move(preview)); return Result(std::move(result));
+}
+void NativeTerminal::ClosePreview(const std::string& preview_id, base::OnceCallback<void(base::DictValue)> callback) {
+  const auto preview = previews_.find(preview_id);
+  // This terminal owns the complete native guest inventory for its original
+  // document. Absence proves no guest exists, including an unstarted request.
+  if (preview == previews_.end()) { std::move(callback).Run(Result(base::DictValue().Set("closed", true))); return; }
+  preview->second->Close(base::BindOnce([](base::WeakPtr<NativeTerminal> owner, std::string id,
+      base::OnceCallback<void(base::DictValue)> callback, bool acknowledged) {
+    if (acknowledged && owner) owner->previews_.erase(id);
+    std::move(callback).Run(acknowledged ? Result(base::DictValue().Set("closed", true)) : Fault("Project preview cleanup is not acknowledged"));
+  }, weak_factory_.GetWeakPtr(), preview_id, std::move(callback)));
+}
+void NativeTerminal::Flush() {
+  while (master_ >= 0 && !pending_input_.empty()) {
+    const ssize_t count = write(master_, pending_input_.data(), pending_input_.size());
+    if (count > 0) pending_input_.erase(0, count);
+    else if (count < 0 && errno == EINTR) continue;
+    else if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+    else { Retire(); return; }
+  }
+}
+void NativeTerminal::PollExit() {
+  if (pid_ <= 0 || closing_) return;
+  siginfo_t info{};
+  if (waitid(P_PID, pid_, &info, WEXITED | WNOHANG | WNOWAIT) != 0 || !info.si_pid) return;
+  // Reaping and PTY cleanup use the same asynchronous original close ACK.
+  Close(base::BindOnce([](base::DictValue) {}));
+}
+base::DictValue NativeTerminal::Read(uint64_t offset) {
+  if (!Current()) { Retire(); return Fault("Original terminal document retired"); }
+  if (offset == previous_offset_ && !previous_chunk_.empty()) {
+    return Result(base::DictValue().Set("terminalId", *session_.FindString("terminalId")).Set("offset", static_cast<double>(offset))
+      .Set("nextOffset", static_cast<double>(offset_)).Set("data", base::Base64Encode(previous_chunk_)).Set("encoding", "base64").Set("state", *session_.FindString("state")));
+  }
+  if (offset != offset_) return Fault("Terminal output acknowledgement changed");
+  Flush();
+  std::array<char, 65536> chunk;
+  ssize_t count = master_ < 0 ? 0 : read(master_, chunk.data(), chunk.size());
+  if (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR && errno != EIO) { Retire(); return Fault("Terminal output failed"); }
+  previous_offset_ = offset_;
+  previous_chunk_.assign(chunk.data(), count > 0 ? count : 0);
+  offset_ += previous_chunk_.size();
+  PollExit();
+  if (closing_ && closing_->failed) return Fault("Terminal exit has no original reaping acknowledgement");
+  if (count <= 0 && pid_ < 0 && !closing_) session_.Set("state", "closed");
+  auto result = base::DictValue().Set("terminalId", *session_.FindString("terminalId")).Set("offset", static_cast<double>(previous_offset_))
+    .Set("nextOffset", static_cast<double>(offset_)).Set("data", base::Base64Encode(previous_chunk_)).Set("encoding", "base64").Set("state", *session_.FindString("state"));
+  if (*session_.FindString("state") == "closed") result.Set("exitCode", exit_code_);
+  return Result(std::move(result));
+}
+base::DictValue NativeTerminal::Input(uint64_t sequence, const std::string& data) {
+  if (!Current() || pid_ <= 0 || sequence != sequence_ || data.empty() || data.size() > 65536 || pending_input_.size() + data.size() > 65536) return Fault("Terminal input authority or sequence changed");
+  pending_input_ += data; ++sequence_; Flush();
+  if (master_ < 0) return Fault("Terminal input could not be delivered; do not replay it");
+  return Result(base::DictValue().Set("terminalId", *session_.FindString("terminalId")).Set("nextSequence", static_cast<double>(sequence_)));
+}
+base::DictValue NativeTerminal::Resize(int cols, int rows) {
+  if (!Current() || master_ < 0 || cols < 2 || cols > 500 || rows < 1 || rows > 300) return Fault("Terminal resize authority changed");
+  winsize size{}; size.ws_col = cols; size.ws_row = rows;
+  if (ioctl(master_, TIOCSWINSZ, &size) != 0) return Fault("Terminal resize failed");
+  session_.Set("cols", cols); session_.Set("rows", rows);
+  return Result(Session());
+}
+void NativeTerminal::Close(base::OnceCallback<void(base::DictValue)> callback) {
+  if (closing_) {
+    if (closing_->completed) std::move(callback).Run(closing_->failed ? Fault("Terminal termination has no original acknowledgement") : Result(closing_->stopped.Clone()));
+    else closing_->callbacks.push_back(std::move(callback));
+    return;
+  }
+  const pid_t pid = pid_; const int fd = master_;
+  // Freeze the root before any guest cleanup await. Killing it first would
+  // orphan dedicated-session children before their ancestry can be retained.
+  if (pid > 0 && process_.pid != pid)
+    CaptureProjectProcess(pid, &process_, dedicated_descendants_);
+  const bool fenced = pid <= 0 || FreezeProjectRoot(process_);
+  std::vector<NativeProjectProcess> remembered;
+  for (const auto& [id, listener] : listeners_) {
+    remembered.insert(remembered.end(), listener.ancestry.begin(), listener.ancestry.end());
+    remembered.push_back({listener.pid, listener.started_seconds, listener.started_microseconds});
+  }
+  pid_ = -1; master_ = -1; pending_input_.clear(); session_.Set("state", "closing");
+  closing_ = std::make_shared<CloseState>();
+  closing_->stopped = Session(); closing_->stopped.Set("state", "closed");
+  closing_->pending = previews_.size() + 1;
+  closing_->callbacks.push_back(std::move(callback));
+  auto joined = base::BindRepeating([](base::WeakPtr<NativeTerminal> owner, std::shared_ptr<CloseState> state, bool acknowledged) {
+    state->failed |= !acknowledged;
+    if (--state->pending) return;
+    state->completed = true;
+    if (owner && !state->failed) owner->session_ = state->stopped.Clone();
+    auto callbacks = std::move(state->callbacks);
+    for (auto& callback : callbacks) std::move(callback).Run(state->failed ? Fault("Terminal termination has no original acknowledgement") : Result(state->stopped.Clone()));
+  }, weak_factory_.GetWeakPtr(), closing_);
+  for (auto& [id, preview] : previews_) preview->Close(base::BindOnce(joined));
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&KillAndReap, pid, fd, process_, fenced, std::move(remembered)), base::BindOnce(
+          [](base::WeakPtr<NativeTerminal> owner, std::shared_ptr<CloseState> state,
+             base::RepeatingCallback<void(bool)> joined, Termination result) {
+            state->processes = std::move(result.processes);
+            if (result.exit_code && owner) owner->exit_code_ = *result.exit_code;
+            joined.Run(result.acknowledged);
+          }, weak_factory_.GetWeakPtr(), closing_, joined));
+}
+void NativeTerminal::Retire() {
+  // Close fences the original root and joins the same eventual cleanup ACK.
+  Close(base::BindOnce([](base::DictValue) {}));
+}
+void NativeTerminal::PrimaryPageChanged(content::Page&) { Retire(); }
+void NativeTerminal::WebContentsDestroyed() { Retire(); Observe(nullptr); }
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/native_terminal.h b/chrome/browser/ui/aux/native_terminal.h
new file mode 100644
index 0000000..85e9a26
--- /dev/null
+++ b/chrome/browser/ui/aux/native_terminal.h
@@ -0,0 +1,76 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_TERMINAL_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_TERMINAL_H_
+#include <sys/types.h>
+#include <cstdint>
+#include <memory>
+#include <map>
+#include "chrome/browser/ui/aux/native_project_listener.h"
+#include "chrome/browser/ui/aux/native_project_preview.h"
+#include <string>
+#include <vector>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/weak_document_ptr.h"
+namespace aux {
+// One terminal's process group and PTY belong to the original WebUI document.
+// Dedicated Codex child groups additionally retain birth-bound ancestry.
+class NativeTerminal final : public content::WebContentsObserver {
+ public:
+  NativeTerminal(content::WebContents* owner, content::WeakDocumentPtr document,
+                 std::string token, base::DictValue session);
+  ~NativeTerminal() override;
+  bool Start(const std::string& executable, const std::string& cwd, const std::string& device, const std::string& inode, std::string* error);
+  bool StartCommand(const std::string& executable, const std::vector<std::string>& args,
+                    const std::vector<std::string>& environment, const std::string& cwd,
+                    const std::string& device, const std::string& inode, std::string* error);
+  const std::string& token() const { return token_; }
+  bool Current() const;
+  base::DictValue Session() const;
+  base::DictValue Read(uint64_t offset);
+  base::DictValue Input(uint64_t sequence, const std::string& data);
+  base::DictValue Resize(int cols, int rows);
+  void Listeners(base::OnceCallback<void(base::DictValue)> callback);
+  base::DictValue Preview(const std::string& listener_id, const std::string& preview_id,
+                         const std::string& protocol, NativeProjectPreview::Review review);
+  void ClosePreview(const std::string& preview_id, base::OnceCallback<void(base::DictValue)> callback);
+  // Detaches ownership synchronously, then acknowledges actual child reaping.
+  void Close(base::OnceCallback<void(base::DictValue)> callback);
+  void PrimaryPageChanged(content::Page& page) override;
+  void WebContentsDestroyed() override;
+ private:
+  void Retire();
+  void Flush();
+  void PollExit();
+  bool PreviewCurrent(const NativeProjectListener& listener) const;
+  NativeProjectProcess process_{};
+  bool dedicated_descendants_ = false;
+  std::string cwd_, device_, inode_;
+  std::map<std::string, NativeProjectListener> listeners_;
+  std::map<std::string, std::unique_ptr<NativeProjectPreview>> previews_;
+  content::WeakDocumentPtr document_;
+  std::string token_;
+  base::DictValue session_;
+  pid_t pid_ = -1;
+  int master_ = -1;
+  uint64_t offset_ = 0;
+  uint64_t previous_offset_ = 0;
+  uint64_t sequence_ = 0;
+  std::string previous_chunk_;
+  std::string pending_input_;
+  int exit_code_ = 0;
+  struct CloseState {
+    base::DictValue stopped;
+    bool failed = false;
+    bool completed = false;
+    size_t pending = 0;
+    std::vector<NativeProjectProcess> processes;
+    std::vector<base::OnceCallback<void(base::DictValue)>> callbacks;
+  };
+  std::shared_ptr<CloseState> closing_;
+  base::WeakPtrFactory<NativeTerminal> weak_factory_{this};
+};
+}  // namespace aux
+#endif
