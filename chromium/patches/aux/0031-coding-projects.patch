@@ -0,0 +1,37 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_PROJECT_LISTENER_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_PROJECT_LISTENER_H_
+#include <sys/types.h>
+#include <cstdint>
+#include <string>
+#include <vector>
+namespace aux {
+// Kernel identities stay native. A renderer receives only a randomly minted ID.
+struct NativeProjectProcess {
+  pid_t pid; uint64_t seconds; uint64_t microseconds;
+  // Set only when native launch selects the dedicated Codex --no-daemon mode.
+  bool dedicated_descendants = false;
+};
+struct NativeProjectListener {
+  pid_t pid;
+  int fd;
+  uint64_t started_seconds;
+  uint64_t started_microseconds;
+  uint64_t socket;
+  uint64_t generation;
+  std::string host;
+  uint16_t port;
+  std::vector<NativeProjectProcess> ancestry;
+};
+bool CaptureProjectProcess(pid_t pid, NativeProjectProcess* process, bool dedicated_descendants = false);
+// Reduction only: fence the original root/group before any guest cleanup await.
+bool FreezeProjectRoot(const NativeProjectProcess& process);
+// Freeze/rescan the original scope, kill birth-bound members, and verify exit.
+// Enumeration/signal/identity uncertainty cannot produce a positive join receipt.
+bool StopProjectProcesses(const NativeProjectProcess& process, bool fenced,
+                          std::vector<NativeProjectProcess>* remembered);
+bool ProjectProcessCurrent(const NativeProjectProcess& process);
+std::vector<NativeProjectListener> FindProjectListeners(const NativeProjectProcess& process);
+bool ProjectListenerCurrent(const NativeProjectProcess& process, const NativeProjectListener& listener);
+}
+#endif
