+std::optional<std::string> ContentBlockingController::RegisterToggleOperation(
+    content::RenderFrameHost *frame, bool enabled) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!frame || frame->GetBrowserContext() != profile_ ||
+      profile_->IsOffTheRecord() || !frame->IsActive() ||
+      !frame->IsRenderFrameLive() ||
+      !frame->GetLastCommittedURL().SchemeIs("chrome") ||
+      frame->GetLastCommittedURL().host() != "aux")
+    return std::nullopt;
+  auto operation = std::make_unique<ToggleOperation>();
+  operation->document = frame->GetWeakDocumentPtr();
+  operation->enabled = enabled;
+  auto id = base::UnguessableToken::Create().ToString();
+  toggle_operations_.emplace(id, std::move(operation));
+  return id;
+}
+bool ContentBlockingController::ToggleOperationCurrent(const std::string &id) {
+  const auto found = toggle_operations_.find(id);
+  if (found == toggle_operations_.end() || found->second->retired)
+    return false;
+  auto *frame = found->second->document.AsRenderFrameHostIfValid();
+  return frame && frame->IsActive() && frame->IsRenderFrameLive() &&
+         frame->GetBrowserContext() == profile_;
+}
+void ContentBlockingController::RetireToggleOperation(const std::string &id) {
+  auto found = toggle_operations_.find(id);
+  if (found == toggle_operations_.end())
+    return;
+  auto &operation = *found->second;
+  operation.retired = true;
+  if (operation.phase == "prepared") {
+    if (staging_ && staging_->operation_id == id)
+      staging_.reset();
+    operation.phase = "failed";
+    operation.error = "Original filter toggle document retired";
+  }
+  // Running work reaches its real callback before becoming terminal. An
+  // already accepted durable publication is never undone by later retirement.
+}
+bool ContentBlockingController::ReleaseToggleOperation(const std::string &id) {
+  auto found = toggle_operations_.find(id);
+  if (found == toggle_operations_.end() ||
+      (found->second->phase != "completed" && found->second->phase != "failed"))
+    return false;
+  toggle_operations_.erase(found);
+  return true;
+}
+std::optional<base::DictValue>
+ContentBlockingController::ReadToggleOperation(const std::string &id) {
+  auto found = toggle_operations_.find(id);
+  if (found == toggle_operations_.end())
+    return std::nullopt;
+  auto &operation = *found->second;
+  base::DictValue result;
+  result.Set("current", ToggleOperationCurrent(id));
+  result.Set("enabled", operation.enabled);
+  result.Set("phase", operation.phase);
+  if (operation.receipt)
+    result.Set("receipt", operation.receipt->Clone());
+  if (!operation.error.empty())
+    result.Set("error", base::DictValue()
+                            .Set("code", "conflict")
+                            .Set("message", operation.error));
+  return result;
+}
