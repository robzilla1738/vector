+bool DownloadIsDismissed(Profile* profile, download::DownloadItem* item) {
+  return item->GetState() != download::DownloadItem::IN_PROGRESS &&
+         !item->CanResume() &&
+         profile->GetPrefs()->GetDict(kDismissedDownloadsPref)
+             .FindBool(item->GetGuid()).value_or(false);
+}
+
+base::ListValue DismissDownloads(Profile* profile, const base::ListValue& ids) {
+  base::ListValue removed;
+  auto* manager = profile->GetDownloadManager();
+  if (!manager) return removed;
+  {
+    ScopedDictPrefUpdate dismissed(profile->GetPrefs(), kDismissedDownloadsPref);
+    std::set<std::string> seen;
+    for (const auto& value : ids) {
+      const std::string& id = value.GetString();
+      if (!seen.insert(id).second) continue;
+      auto* item = manager->GetDownloadByGuid(id);
+      if (item && (item->GetState() == download::DownloadItem::IN_PROGRESS ||
+                   item->CanResume())) continue;
+      if (!item && !dismissed->FindBool(id).value_or(false)) continue;
+      // Remove() deletes interrupted partial files. Shelf dismissal must preserve them.
+      dismissed->Set(id, true);
+      removed.Append(id);
+    }
+  }
+  if (!removed.empty()) {
+    base::DictValue payload;
+    payload.Set("ids", removed.Clone());
+    EmitDict(profile, "onDownloadsRemoved", std::move(payload));
+  }
+  return removed;
+}
