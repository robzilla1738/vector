+void EvidenceDocumentSnapshot::ReadOriginal(
+    const std::string& snapshot_id,
+    const std::string& source_sha256,
+    uint32_t offset,
+    Callback callback,
+    std::shared_ptr<std::atomic_bool> runtime_owner) {
+  if (retired_ || (runtime_owner && runtime_owner->load()) || !owner_current_.Run()) {
+    std::move(callback).Run(false, "", "ref_stale", "Original document selection retired");
+    return;
+  }
+  if (pending_) {
+    std::move(callback).Run(false, "", "conflict", "A document read is already in progress");
+    return;
+  }
+  constexpr uint32_t kChunkBytes = 128 * 1024;
+  const auto* hash = metadata_.FindString("sourceSha256");
+  const auto* format = metadata_.FindString("format");
+  if (snapshot_id != snapshot_id_ || !hash || *hash != source_sha256 ||
+      !format || (*format != "pdf" && *format != "docx") ||
+      !source_mapping_.IsValid() || offset >= source_mapping_.size() ||
+      offset % kChunkBytes) {
+    std::move(callback).Run(false, "", "ref_stale", "Original immutable document bytes are unavailable");
+    return;
+  }
+  pending_ = std::move(callback);
+  runtime_read_owner_ = std::move(runtime_owner);
+  if (!Current()) return;
+  const auto bytes = source_mapping_.GetMemoryAsSpan<const uint8_t>();
+  const size_t count = std::min(static_cast<size_t>(kChunkBytes), bytes.size() - offset);
+  Reply(base::DictValue()
+    .Set("snapshotId", snapshot_id_)
+    .Set("sourceSha256", source_sha256)
+    .Set("sourceBytes", static_cast<double>(bytes.size()))
+    .Set("offset", static_cast<double>(offset))
+    .Set("nextOffset", static_cast<double>(offset + count))
+    .Set("bytesBase64", base::Base64Encode(bytes.subspan(offset, count))));
+}
