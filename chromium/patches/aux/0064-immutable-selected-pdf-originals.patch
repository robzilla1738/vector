+TEST(AuxPdfImportTest, ImageOnlyPdfRetainsEmptyLocatedTextAndCountedWarnings) {
+  const auto source = Pdf({
+      "<< /Type /Catalog /Pages 2 0 R >>",
+      "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+      "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 100 100] "
+      "/Resources << >> /Contents 4 0 R >>",
+      Stream("0.5 g 0 0 100 100 re f")});
+  const auto original = source;
+  DocumentSegments output;
+  ASSERT_EQ(ExtractPdf(source, output), mojom::Failure::kNone);
+  auto metadata = output.Finish();
+  ASSERT_TRUE(metadata);
+  EXPECT_EQ(metadata->format, mojom::Format::kPdf);
+  EXPECT_EQ(metadata->page_count, 1u);
+  EXPECT_EQ(metadata->chunk_count, 1u);
+  ASSERT_TRUE(metadata->completed);
+  EXPECT_EQ(metadata->completed->text_bytes, 0u);
+  EXPECT_EQ(metadata->completed->segment_count, 0u);
+  EXPECT_EQ(metadata->completed->text_sha256,
+            "ef6830b74d2f59421d0d60de29a156f5e9afa28f15906e1eb9ef74534081dbfa");
+  ASSERT_EQ(metadata->warnings.size(), 1u);
+  EXPECT_EQ(metadata->warnings[0]->code, mojom::WarningCode::kNoSelectableText);
+  EXPECT_EQ(metadata->warnings[0]->count, 1u);
+  EXPECT_EQ(metadata->warnings[0]->first_page, 1u);
+  auto chunk = output.Chunk(0);
+  ASSERT_TRUE(chunk);
+  EXPECT_TRUE(chunk->final_chunk);
+  EXPECT_TRUE(chunk->segments.empty());
+  EXPECT_EQ(source, original);
+}
