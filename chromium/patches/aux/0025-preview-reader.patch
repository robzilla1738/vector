+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_READABLE_CAPTURE_H_
+#define CHROME_BROWSER_UI_AUX_READABLE_CAPTURE_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+class NavigationHandle;
+}  // namespace content
+namespace net {
+class HttpResponseHeaders;
+}
+
+namespace aux {
+
+// Response status, MIME type, and cache directive gate for protected recall.
+bool ReadableResponseAllowed(const net::HttpResponseHeaders* headers);
+bool ReadableWorkspaceMatches(const base::DictValue& layout,
+                              const std::string& page_id,
+                              const std::string& workspace_id);
+
+// Records only response eligibility, never page contents or response headers.
+// This is installed when a tab enters the Profile catalog, before navigation.
+class ReadableCapture final
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<ReadableCapture> {
+ public:
+  ~ReadableCapture() override;
+  ReadableCapture(const ReadableCapture&) = delete;
+  ReadableCapture& operator=(const ReadableCapture&) = delete;
+
+  bool Eligible(const std::string& expected_url) const;
+  void Extract(const std::string& expected_url,
+               base::OnceCallback<void(base::DictValue)> callback);
+
+ private:
+  friend class content::WebContentsUserData<ReadableCapture>;
+  explicit ReadableCapture(content::WebContents* contents);
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+
+  std::string eligible_url_;
+  int64_t document_id_ = 0;
+  base::WeakPtrFactory<ReadableCapture> weak_factory_{this};
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_READABLE_CAPTURE_H_
