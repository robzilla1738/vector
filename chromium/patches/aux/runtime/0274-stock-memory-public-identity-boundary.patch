+// Copyright 2026 The Aux Authors
+#ifndef CONTENT_PUBLIC_BROWSER_CHILD_PROCESS_TASK_IDENTITY_MAC_H_
+#define CONTENT_PUBLIC_BROWSER_CHILD_PROCESS_TASK_IDENTITY_MAC_H_
+#include "build/build_config.h"
+#if BUILDFLAG(IS_MAC)
+#include <array>
+#include <cstdint>
+#include <optional>
+#include "base/process/process_handle.h"
+#include "content/common/content_export.h"
+namespace content {
+enum class ChildProcessTaskHostKind { kRenderer, kBrowserChild };
+struct ChildProcessTaskHost {
+  ChildProcessTaskHostKind kind;
+  int id;
+  bool operator==(const ChildProcessTaskHost&) const = default;
+};
+struct OwnedChildProcessTaskIdentity {
+  ChildProcessTaskHost host;
+  uint64_t launch_generation;
+  std::array<uint32_t, 8> audit_token;
+  int pid_version;
+  bool operator==(const OwnedChildProcessTaskIdentity&) const = default;
+};
+// Freshly audits the original native host's retained task port. Refuses a
+// pending/replaced/dead/unowned association; never returns a raw task port.
+// Host IDs must come from the browser's actual native host inventory.
+CONTENT_EXPORT std::optional<OwnedChildProcessTaskIdentity>
+ReadOwnedChildProcessTaskIdentity(base::ProcessHandle process_handle,
+                                 ChildProcessTaskHost host);
+}  // namespace content
+#endif
