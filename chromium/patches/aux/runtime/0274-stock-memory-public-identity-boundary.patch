diff --git a/chrome/browser/ui/stock_measurement/native_stock_measurement_request.h b/chrome/browser/ui/stock_measurement/native_stock_measurement_request.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/stock_measurement/native_stock_measurement_request.h
@@ -0,0 +1,36 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_STOCK_MEASUREMENT_NATIVE_STOCK_MEASUREMENT_REQUEST_H_
+#define CHROME_BROWSER_UI_STOCK_MEASUREMENT_NATIVE_STOCK_MEASUREMENT_REQUEST_H_
+#include "build/build_config.h"
+#include "chrome/browser/buildflags.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS) && !BUILDFLAG(ENABLE_AUX_SHELL)
+#include <sys/stat.h>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include "base/files/file_path.h"
+#include "base/files/scoped_file.h"
+#include "base/values.h"
+namespace aux {
+// Retains the actual opened root/request descriptors through UI dispatch. An
+// invalid object is a refusal sentinel; only Current() admits its fixed record.
+class NativeStockMeasurementRequest final {
+ public:
+  NativeStockMeasurementRequest(NativeStockMeasurementRequest&&) = default;
+  NativeStockMeasurementRequest& operator=(NativeStockMeasurementRequest&&) = default;
+  static std::optional<NativeStockMeasurementRequest> Read(
+      base::FilePath root, uint64_t device, uint64_t inode, uint64_t sequence);
+  bool Current() const;
+  const base::DictValue& record() const { return record_; }
+ private:
+  NativeStockMeasurementRequest() = default;
+  base::FilePath root_;
+  uint64_t device_ = 0, inode_ = 0;
+  struct stat original_{};
+  std::string original_bytes_;
+  base::ScopedFD directory_, file_;
+  base::DictValue record_;
+};
+}  // namespace aux
+#endif
+#endif
diff --git a/chrome/browser/ui/stock_measurement/native_stock_measurement_request.cc b/chrome/browser/ui/stock_measurement/native_stock_measurement_request.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/stock_measurement/native_stock_measurement_request.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/stock_measurement/native_stock_measurement_request.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS) && !BUILDFLAG(ENABLE_AUX_SHELL)
+#include <cerrno>
+#include <fcntl.h>
+#include <unistd.h>
+#include <utility>
+#include <string_view>
+#include "base/json/json_reader.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/aux/journey_fixture_path.h"
+namespace aux {
+namespace {
+constexpr char kRequest[] = "performance-request.json";
+bool SameFile(const struct stat& a, const struct stat& b) {
+  return a.st_dev == b.st_dev && a.st_ino == b.st_ino && a.st_size == b.st_size &&
+      a.st_mode == b.st_mode && a.st_uid == b.st_uid && a.st_nlink == b.st_nlink &&
+      a.st_ctimespec.tv_sec == b.st_ctimespec.tv_sec && a.st_ctimespec.tv_nsec == b.st_ctimespec.tv_nsec &&
+      a.st_mtimespec.tv_sec == b.st_mtimespec.tv_sec && a.st_mtimespec.tv_nsec == b.st_mtimespec.tv_nsec;
+}
+bool Directory(const struct stat& value, uint64_t device, uint64_t inode) {
+  return S_ISDIR(value.st_mode) && value.st_uid == geteuid() && (value.st_mode & 0777) == 0700 &&
+      static_cast<uint64_t>(value.st_dev) == device && static_cast<uint64_t>(value.st_ino) == inode;
+}
+}  // namespace
+std::optional<NativeStockMeasurementRequest> NativeStockMeasurementRequest::Read(
+    base::FilePath root, uint64_t device, uint64_t inode, uint64_t sequence) {
+  if (!OwnedJourneyFixtureRoot(root.value())) return NativeStockMeasurementRequest();
+  base::ScopedFD directory(HANDLE_EINTR(open(root.value().c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC)));
+  struct stat info{};
+  if (!directory.is_valid() || fstat(directory.get(), &info) != 0 || !Directory(info, device, inode))
+    return NativeStockMeasurementRequest();
+  base::ScopedFD file(HANDLE_EINTR(openat(directory.get(), kRequest, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC)));
+  if (!file.is_valid()) {
+    if (errno == ENOENT) return std::nullopt;
+    return NativeStockMeasurementRequest();
+  }
+  struct stat before{}; char bytes[513];
+  if (fstat(file.get(), &before) != 0 || !S_ISREG(before.st_mode) || before.st_uid != geteuid() ||
+      (before.st_mode & 0777) != 0600 || before.st_nlink != 1 || before.st_size <= 0 || before.st_size > 512)
+    return NativeStockMeasurementRequest();
+  const auto size = HANDLE_EINTR(read(file.get(), bytes, sizeof(bytes)));
+  if (size != before.st_size) return NativeStockMeasurementRequest();
+  auto row = base::JSONReader::ReadDict(std::string_view(bytes, size), base::JSON_PARSE_RFC);
+  const auto* operation = row ? row->FindString("operation") : nullptr;
+  const auto* raw_sequence = row ? row->FindString("sequence") : nullptr; uint64_t next = 0;
+  if (!row || row->size() != 2 || !operation || *operation != "sampleStockProcessMemory" || !raw_sequence ||
+      !base::StringToUint64(*raw_sequence, &next) || *raw_sequence != base::NumberToString(next) ||
+      next == 0 || next > 4000 || next < sequence || next > sequence + 1)
+    return NativeStockMeasurementRequest();
+  NativeStockMeasurementRequest result;
+  result.root_ = std::move(root); result.device_ = device; result.inode_ = inode; result.original_ = before; result.original_bytes_.assign(bytes, size);
+  result.directory_ = std::move(directory); result.file_ = std::move(file); result.record_ = std::move(*row);
+  if (!result.Current()) return NativeStockMeasurementRequest();
+  return next == sequence ? std::nullopt : std::make_optional(std::move(result));
+}
+bool NativeStockMeasurementRequest::Current() const {
+  struct stat directory{}, path{}, opened{}, named{}; char bytes[513];
+  return directory_.is_valid() && file_.is_valid() && OwnedJourneyFixtureRoot(root_.value()) &&
+      fstat(directory_.get(), &directory) == 0 && Directory(directory, device_, inode_) &&
+      lstat(root_.value().c_str(), &path) == 0 && Directory(path, device_, inode_) &&
+      fstat(file_.get(), &opened) == 0 && SameFile(opened, original_) &&
+      fstatat(directory_.get(), kRequest, &named, AT_SYMLINK_NOFOLLOW) == 0 && SameFile(named, original_) &&
+      HANDLE_EINTR(pread(file_.get(), bytes, sizeof(bytes), 0)) == original_.st_size &&
+      std::string_view(bytes, original_.st_size) == original_bytes_ &&
+      fstat(file_.get(), &opened) == 0 && SameFile(opened, original_) &&
+      fstatat(directory_.get(), kRequest, &named, AT_SYMLINK_NOFOLLOW) == 0 && SameFile(named, original_) &&
+      lstat(root_.value().c_str(), &path) == 0 && Directory(path, device_, inode_);
+}
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/stock_measurement/native_stock_measurement_request_unittest.cc b/chrome/browser/ui/stock_measurement/native_stock_measurement_request_unittest.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/stock_measurement/native_stock_measurement_request_unittest.cc
@@ -0,0 +1,84 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/stock_measurement/native_stock_measurement_request.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS) && !BUILDFLAG(ENABLE_AUX_SHELL)
+#include <cstdlib>
+#include <cstdio>
+#include <unistd.h>
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux {
+class NativeStockMeasurementRequestTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    char path[] = "/private/tmp/aux-native-journey-stock-request-XXXXXX";
+    ASSERT_NE(mkdtemp(path), nullptr);
+    ASSERT_TRUE(root_.Set(base::FilePath(path)));
+    ASSERT_EQ(lstat(root_.GetPath().value().c_str(), &pin_), 0);
+    Write();
+  }
+  void Write(const char* bytes = "{\"operation\":\"sampleStockProcessMemory\",\"sequence\":\"1\"}") {
+    ASSERT_TRUE(base::WriteFile(path(), bytes));
+    ASSERT_EQ(chmod(path().value().c_str(), 0600), 0);
+  }
+  base::FilePath path() { return root_.GetPath().AppendASCII("performance-request.json"); }
+  std::optional<NativeStockMeasurementRequest> Read(uint64_t sequence = 0) {
+    return NativeStockMeasurementRequest::Read(root_.GetPath(), pin_.st_dev, pin_.st_ino, sequence);
+  }
+  base::ScopedTempDir root_;
+  struct stat pin_{};
+};
+TEST_F(NativeStockMeasurementRequestTest, CurrentOriginalDescriptorsAndConsumedRequest) {
+  auto request = Read(); ASSERT_TRUE(request);
+  ASSERT_TRUE(request->Current());
+  ASSERT_NE(request->record().FindString("operation"), nullptr);
+  EXPECT_EQ(*request->record().FindString("operation"), "sampleStockProcessMemory");
+  EXPECT_FALSE(Read(1));
+}
+TEST_F(NativeStockMeasurementRequestTest, NamedReplacementWithIdenticalBytesRefusesOriginalDescriptor) {
+  auto request = Read(); ASSERT_TRUE(request); ASSERT_TRUE(request->Current());
+  ASSERT_EQ(rename(path().value().c_str(), root_.GetPath().AppendASCII("retired.json").value().c_str()), 0);
+  Write();
+  EXPECT_FALSE(request->Current());
+  auto fresh = Read(); ASSERT_TRUE(fresh); EXPECT_TRUE(fresh->Current());
+}
+TEST_F(NativeStockMeasurementRequestTest, RootReplacementRefusesRetainedOriginalDirectory) {
+  auto request = Read(); ASSERT_TRUE(request); ASSERT_TRUE(request->Current());
+  const auto original = root_.Take(), retired_path = original.AddExtensionASCII("retired");
+  ASSERT_TRUE(base::Move(original, retired_path));
+  base::ScopedTempDir retired; ASSERT_TRUE(retired.Set(retired_path));
+  ASSERT_TRUE(base::CreateDirectory(original)); ASSERT_EQ(chmod(original.value().c_str(), 0700), 0);
+  ASSERT_TRUE(root_.Set(original)); Write();
+  EXPECT_FALSE(request->Current());
+  auto replay = Read(); ASSERT_TRUE(replay); EXPECT_FALSE(replay->Current());
+}
+TEST_F(NativeStockMeasurementRequestTest, SymlinkReplacementRefusesWithoutFollowingTarget) {
+  auto request = Read(); ASSERT_TRUE(request); ASSERT_TRUE(request->Current());
+  const auto target = root_.GetPath().AppendASCII("target.json");
+  ASSERT_TRUE(base::Move(path(), target)); ASSERT_EQ(symlink(target.value().c_str(), path().value().c_str()), 0);
+  EXPECT_FALSE(request->Current());
+  auto replaced = Read(); ASSERT_TRUE(replaced); EXPECT_FALSE(replaced->Current());
+}
+TEST_F(NativeStockMeasurementRequestTest, PermissionOrHardlinkChangeRefuses) {
+  auto request = Read(); ASSERT_TRUE(request); ASSERT_TRUE(request->Current());
+  ASSERT_EQ(chmod(path().value().c_str(), 0644), 0); EXPECT_FALSE(request->Current());
+  ASSERT_EQ(chmod(path().value().c_str(), 0600), 0);
+  auto fresh = Read(); ASSERT_TRUE(fresh); ASSERT_TRUE(fresh->Current());
+  ASSERT_EQ(link(path().value().c_str(), root_.GetPath().AppendASCII("linked.json").value().c_str()), 0);
+  EXPECT_FALSE(fresh->Current());
+}
+TEST_F(NativeStockMeasurementRequestTest, MutationBeforeUiDispatchRefusesEvenOnSameInode) {
+  auto request = Read(); ASSERT_TRUE(request); ASSERT_TRUE(request->Current());
+  Write("{\"operation\":\"sampleStockProcessMemory\",\"sequence\":\"2\"}");
+  EXPECT_FALSE(request->Current());
+}
+TEST_F(NativeStockMeasurementRequestTest, ClosedOperationAndSequenceCannotCarrySelectors) {
+  for (const auto* bytes : {"{\"operation\":\"pages.open\",\"sequence\":\"1\"}",
+      "{\"operation\":\"sampleStockProcessMemory\",\"sequence\":\"1\",\"pid\":1}",
+      "{\"operation\":\"sampleStockProcessMemory\",\"sequence\":\"01\"}",
+      "{\"operation\":\"sampleStockProcessMemory\",\"sequence\":\"2\"}"}) {
+    Write(bytes); auto request = Read(); ASSERT_TRUE(request); EXPECT_FALSE(request->Current());
+  }
+}
+}  // namespace aux
+#endif
