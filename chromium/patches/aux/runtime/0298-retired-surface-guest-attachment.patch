+IN_PROC_BROWSER_TEST_F(SurfaceEmbedBrowserTest,
+                       DestroyedOriginalGuestCannotAttachOrRetainPreviousGuest) {
+  auto attached = SetupHarnessAndChild();
+  AttachChildToEmbed(attached.get());
+  auto* host = GetHost(0);
+  ASSERT_TRUE(host);
+  ASSERT_TRUE(host->IsAttachedForTesting());
+  auto retired = CreateChildWebContents();
+  auto* original = guest_contents::GuestContentsHandle::CreateForWebContents(
+      retired.get());
+  ASSERT_TRUE(original);
+  const auto original_id = original->id();
+  retired.reset();
+  ASSERT_EQ(guest_contents::GuestContentsHandle::FromID(original_id), nullptr);
+  // Execute the actual attach entry point after the genuine original guest
+  // retirement. The existing attachment must not become a fallback target.
+  host->AttachConnector(original_id, false);
+  EXPECT_FALSE(host->IsAttachedForTesting());
+  EXPECT_EQ(attached->GetSurfaceEmbedConnector(), nullptr);
+  EXPECT_EQ(1, CountEmbedElementsInPage());
+}
