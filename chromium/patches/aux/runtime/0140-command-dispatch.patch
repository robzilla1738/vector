+#include "ui/base/accelerators/accelerator.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+namespace aux {
+bool IsAllowedAuxShortcut(const ui::Accelerator& accelerator) {
+  const auto code = accelerator.key_code();
+  const int modifiers = accelerator.modifiers();
+  constexpr int command = ui::EF_COMMAND_DOWN;
+  constexpr int shift = ui::EF_SHIFT_DOWN;
+  constexpr int alt = ui::EF_ALT_DOWN;
+  constexpr int control = ui::EF_CONTROL_DOWN;
+  if (code <= 0 || code > 255 || (modifiers & ~(command | shift | alt | control)) != 0) return false;
+  const bool reserved =
+      (modifiers == command && (code == ui::VKEY_Q || code == ui::VKEY_H ||
+       code == ui::VKEY_M || code == ui::VKEY_TAB || code == ui::VKEY_SPACE ||
+       code == ui::VKEY_OEM_3)) ||
+      (modifiers == (command | alt) && (code == ui::VKEY_H || code == ui::VKEY_D)) ||
+      (modifiers == (command | control) && code == ui::VKEY_F) ||
+      (modifiers == (command | shift) && code >= ui::VKEY_3 && code <= ui::VKEY_5);
+  return !reserved && (modifiers != 0 || (code >= ui::VKEY_F1 && code <= ui::VKEY_F24));
+}
+bool DispatchNativeAuxCommand(BrowserWindowInterface* browser, const std::string& id) {
+  if (!browser) return false;
+  if (id == "new-window") return chrome::ExecuteCommand(browser, IDC_NEW_WINDOW);
+  if (id == "new-private-window") return chrome::ExecuteCommand(browser, IDC_NEW_INCOGNITO_WINDOW);
+  return false;
+}
+}
