+void LoadUnpacked(Profile* profile, const base::FilePath& path,
+                  std::string expected_id, Reply callback) {
+  if (!profile || profile->IsOffTheRecord() || path.empty()) {
+    Error(std::move(callback), "invalid_argument",
+          "Choose an unpacked extension folder in a regular Profile");
+    return;
+  }
+  auto installer = extensions::UnpackedInstaller::Create(profile);
+  installer->set_completion_callback(base::BindOnce(
+      [](base::WeakPtr<Profile> profile, std::string expected_id,
+         Reply callback, const extensions::Extension* loaded,
+         const base::FilePath&, const std::u16string& error) {
+        auto* registry = profile
+                             ? extensions::ExtensionRegistry::Get(profile.get())
+                             : nullptr;
+        const auto* installed = loaded && registry
+                                    ? registry->GetInstalledExtension(loaded->id())
+                                    : nullptr;
+        if (!installed) {
+          Error(std::move(callback), "install_failed",
+                error.empty() ? "Unpacked extension could not be loaded"
+                              : base::UTF16ToUTF8(error));
+          return;
+        }
+        if (!expected_id.empty() && installed->id() != expected_id) {
+          if (auto* registrar = extensions::ExtensionRegistrar::Get(profile.get())) {
+            std::u16string uninstall_error;
+            registrar->UninstallExtension(installed->id(),
+                extensions::UNINSTALL_REASON_USER_INITIATED, &uninstall_error);
+          }
+          Error(std::move(callback), "conflict",
+                "The extension identity changed during update");
+          return;
+        }
+        Result(std::move(callback), base::Value(Describe(*installed, *registry)));
+      }, profile->GetWeakPtr(), std::move(expected_id), std::move(callback)));
+  installer->Load(path);
+}
+
