+bool TidyUndo(const base::DictValue* receipt) {
+  if (!receipt || !HasOnly(*receipt, {"created", "moved"})) return false;
+  const base::ListValue* created = receipt->FindList("created");
+  const base::ListValue* moved = receipt->FindList("moved");
+  if (!created || created->empty() || created->size() > 6 ||
+      !moved || moved->size() < 2 || moved->size() > 30) return false;
+  for (const base::Value& folder : *created) if (!Folder(folder)) return false;
+  for (const base::Value& value : *moved) {
+    const base::DictValue* item = value.GetIfDict();
+    if (!item || !HasOnly(*item, {"pageId", "toFolderId", "fromFolderId"}) ||
+        !Id(item->Find("pageId")) || !Id(item->Find("toFolderId"))) return false;
+    if (const base::Value* from = item->Find("fromFolderId"); from && !Id(from)) return false;
+  }
+  return true;
+}
