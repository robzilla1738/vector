+#include "chrome/browser/ui/aux/little_window_controller.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "ui/base/base_window.h"
+#include "components/prefs/pref_service.h"
+#include "url/gurl.h"
+namespace aux {
+std::optional<base::Value> HandleLittleWindow(BrowserWindowInterface* browser,
+    const std::string& method, const base::ListValue& args) {
+  if (!browser) return std::nullopt;
+  if (method == "showTabWindow") {
+    if (args.size() != 1 || !args[0].is_string()) return std::nullopt;
+    BrowserWindowInterface* owner = nullptr;
+    auto* catalog = TabCatalog::GetForProfile(browser->GetProfile());
+    if (!catalog->FindPage(args[0].GetString(), &owner) || !owner || owner->GetProfile() != browser->GetProfile()) return base::Value(false);
+    owner->GetWindow()->Show();
+    owner->GetWindow()->Activate();
+    return base::Value(true);
+  }
+  if (method == "externalLinkTarget") {
+    auto* prefs = g_browser_process ? g_browser_process->local_state() : nullptr;
+    if (!prefs || args.size() > 1) return std::nullopt;
+    if (!args.empty() && !args[0].is_none()) {
+      if (!args[0].is_string() || (args[0].GetString() != "little" && args[0].GetString() != "main")) return std::nullopt;
+      prefs->SetString(kExternalLinkTargetPref, args[0].GetString());
+    }
+    return base::Value(prefs->GetString(kExternalLinkTargetPref));
+  }
+  if (method != "littleWindow" || args.size() != 2 || !args[0].is_string() || !args[1].is_dict()) return std::nullopt;
+  const auto& options = args[1].GetDict();
+  const auto& operation = args[0].GetString();
+  const auto* url = options.FindString("url");
+  const auto* space_id = options.FindString("spaceId");
+  if (operation == "open") return base::Value(OpenLittleWindow(browser->GetProfile(), url ? GURL(*url) : GURL()) != nullptr);
+  if (operation == "promote") return base::Value(PromoteLittleWindow(browser, space_id ? *space_id : ""));
+  if (operation == "close") return base::Value(CloseLittleWindow(browser));
+  return std::nullopt;
+}
+}
