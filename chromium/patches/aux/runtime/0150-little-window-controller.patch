+class LittleWindows : public BrowserCollectionObserver {
+ public:
+  LittleWindows() {
+    observation_.Observe(GlobalBrowserCollection::GetInstance());
+    [NSEvent addLocalMonitorForEventsMatchingMask:NSEventMaskLeftMouseDown handler:^NSEvent*(NSEvent* event) {
+      auto* collection = GlobalBrowserCollection::GetInstance();
+      if (!collection) return event;
+      auto* browser = collection->FindBrowserWithWindow(gfx::NativeWindow(event.window));
+      if (!browser) return event;
+      const NSEventModifierFlags flags = event.modifierFlags;
+      const NSEventModifierFlags relevant = NSEventModifierFlagOption | NSEventModifierFlagShift | NSEventModifierFlagCommand | NSEventModifierFlagControl;
+      const bool little = (flags & relevant) == (NSEventModifierFlagOption | NSEventModifierFlagShift);
+      if (little) gestures[browser->GetSessionID().id()] = base::TimeTicks::Now();
+      else gestures.erase(browser->GetSessionID().id());
+      return event;
+    }];
+  }
+  void OnBrowserClosed(BrowserWindowInterface* browser) override { ids.erase(browser->GetSessionID().id()); gestures.erase(browser->GetSessionID().id()); }
+  std::set<int> ids;
+  std::map<int, base::TimeTicks> gestures;
+ private:
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver> observation_{this};
+};
+LittleWindows& Windows() { static base::NoDestructor<LittleWindows> windows; return *windows; }
+}
+bool IsLittleWindow(const BrowserWindowInterface* browser) {
+  return browser && Windows().ids.contains(browser->GetSessionID().id());
+}
+bool CanOpenLittleLink(Profile* profile, content::WebContents* contents) {
+  if (!profile || profile->IsOffTheRecord() || !contents || !contents->GetPrimaryMainFrame()) return false;
+  const std::string page_id = PageIdentity::GetOrCreate(profile, contents);
+  EgressRequestContext authority;
+  authority.page_id = page_id;
+  authority.document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  return !PageIdentity::FromWebContents(contents)->runtime_owned() &&
+         !EgressController::ForProfile(profile)->IsProtected(authority);
+}
+bool ConsumeLittleLinkGesture(BrowserWindowInterface* browser) {
+  if (!browser) return false;
+  auto& gestures = Windows().gestures;
+  const auto found = gestures.find(browser->GetSessionID().id());
+  if (found == gestures.end()) return false;
+  const bool fresh = base::TimeTicks::Now() - found->second <= base::Seconds(1);
+  gestures.erase(found);
+  return fresh;
+}
+BrowserWindowInterface* LastNormalWindow(Profile* profile) {
+  auto* collection = profile ? ProfileBrowserCollection::GetForProfile(profile) : nullptr;
+  if (!collection) return nullptr;
+  BrowserWindowInterface* result = nullptr;
+  collection->ForEach([&](BrowserWindowInterface* candidate) {
+    if (candidate->GetType() == BrowserWindowInterface::TYPE_NORMAL && !IsLittleWindow(candidate) && !IsQuickAskWindow(candidate)) {
+      result = candidate;
+      return false;
+    }
+    return true;
+  }, BrowserCollection::Order::kActivation);
+  return result;
+}
+BrowserWindowInterface* OpenLittleWindow(Profile* profile, const GURL& url, bool untrusted_launch) {
+  if (!profile || profile->IsOffTheRecord() || (!url.is_empty() && !url.SchemeIsHTTPOrHTTPS())) return nullptr;
+  auto* screen = display::Screen::Get();
+  if (!screen) return nullptr;
+  const gfx::Point cursor = screen->GetCursorScreenPoint();
+  const gfx::Rect area = screen->GetDisplayNearestPoint(cursor).work_area();
+  const int width = std::min(960, area.width()), height = std::min(720, area.height());
+  const gfx::Rect bounds(std::clamp(cursor.x() - width / 2, area.x(), area.right() - width),
+                         std::clamp(cursor.y() - 40, area.y(), area.bottom() - height), width, height);
+  BrowserWindowCreateParams params(BrowserWindowInterface::TYPE_NORMAL, profile, true);
+  params.initial_bounds = bounds;
+  params.omit_from_session_restore = true;
+  params.should_trigger_session_restore = false;
+  auto* browser = CreateBrowserWindow(std::move(params));
+  if (!browser) return nullptr;
+  Windows().ids.insert(browser->GetSessionID().id());
+  if (url.is_empty()) {
+    chrome::AddTabAt(browser, GURL(), -1, true);
+  } else {
+    NavigateParams navigation(browser, url, ui::PAGE_TRANSITION_LINK);
+    navigation.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    if (untrusted_launch) navigation.initiator_origin = url::Origin();
+    Navigate(&navigation);
+  }
+  browser->GetWindow()->SetBounds(bounds);
+  browser->GetWindow()->Show();
+  browser->GetWindow()->Activate();
+  return browser;
+}
+bool CloseLittleWindow(BrowserWindowInterface* browser) {
+  if (!IsLittleWindow(browser)) return false;
+  browser->GetWindow()->Close();
+  return true;
+}
+bool PromoteLittleWindow(BrowserWindowInterface* browser, const std::string& space_id) {
+  if (!IsLittleWindow(browser)) return false;
+  auto* profile = browser->GetProfile();
+  auto* contents = browser->GetTabStripModel()->GetActiveWebContents();
+  if (!contents) return false;
+  const std::string page_id = PageIdentity::GetOrCreate(profile, contents);
+  EgressRequestContext authority;
+  authority.page_id = page_id;
+  authority.document = contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  if (PageIdentity::FromWebContents(contents)->runtime_owned() || EgressController::ForProfile(profile)->IsProtected(authority)) return false;
+  BrowserWindowInterface* destination = LastNormalWindow(profile);
+  if (!destination) return false;
+  const std::string destination_id = base::NumberToString(destination->GetSessionID().id());
+  std::string error;
+  auto organization = OrganizationStore::Snapshot(profile, destination_id, &error);
+  if (!organization) return false;
+  const auto* layout = organization->FindDict("layout");
+  const auto* shared = layout ? layout->FindDict("shared") : nullptr;
+  const auto* window = layout ? layout->FindDict("window") : nullptr;
+  const auto* spaces = shared ? shared->FindList("spaces") : nullptr;
+  const std::string* active = window ? window->FindString("activeSpaceId") : nullptr;
+  const std::string selected = space_id.empty() && active ? *active : space_id;
+  bool valid = false;
+  std::string workspace_id;
+  if (spaces) for (const auto& space : *spaces) {
+    const auto* id = space.is_dict() ? space.GetDict().FindString("id") : nullptr;
+    if (id && *id == selected) {
+      valid = true;
+      if (const auto* workspace = space.GetDict().FindString("workspaceId")) workspace_id = *workspace;
+    }
+  }
+  if (!valid) return false;
+  const int index = browser->GetTabStripModel()->GetIndexOfWebContents(contents);
+  chrome::MoveTabsToExistingWindow(browser, destination, {index});
+  auto* catalog = TabCatalog::GetForProfile(profile);
+  BrowserWindowInterface* actual = nullptr;
+  if (catalog->FindPage(page_id, &actual) != contents || actual != destination) return false;
+  catalog->BindSpace(page_id, selected, workspace_id);
+  destination->GetTabStripModel()->ActivateTabAt(destination->GetTabStripModel()->GetIndexOfWebContents(contents));
+  destination->GetWindow()->Show();
+  destination->GetWindow()->Activate();
+  return true;
+}
+}
