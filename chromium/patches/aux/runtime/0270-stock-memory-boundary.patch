+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/stock_measurement/native_stock_memory_sampler.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS) && !BUILDFLAG(ENABLE_AUX_SHELL)
