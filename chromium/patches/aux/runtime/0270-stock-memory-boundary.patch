+#include "content/public/browser/web_contents.h"
+#include "content/public/common/process_type.h"
+namespace aux {
+namespace {
+base::DictValue Refused() {
+  return base::DictValue().Set("producer", "aux-native-stock-process-memory")
+      .Set("version", 1).Set("status", "refused");
+}
+BrowserWindowInterface* UniqueBrowser() {
+  BrowserWindowInterface* result = nullptr; bool ambiguous = false;
+  const base::FilePath path(base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("user-data-dir"));
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&result, &ambiguous](BrowserWindowInterface* browser) {
+        // A second regular/OTR/other-Profile window makes this fixture ambiguous,
+        // even if it is not the one carrying the benchmark tabs.
+        if (result) ambiguous = true; else result = browser;
+        return true;
+      });
+  if (ambiguous || !result || result->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !result->GetProfile() || result->GetProfile()->IsOffTheRecord() ||
+      result->GetProfile()->GetPath().DirName() != path) return nullptr;
+  return result;
+}
+base::ListValue Reading(const NativeProcessFootprint& value, base::TimeTicks origin) {
+  return base::ListValue().Append(base::NumberToString(value.physical_bytes))
+      .Append(base::NumberToString((value.sample_start - origin).InMicroseconds()))
+      .Append(base::NumberToString((value.sample_end - origin).InMicroseconds()));
+}
+}  // namespace
+base::WeakPtr<BrowserWindowInterface> ReadNativeStockMeasurementOwner() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* browser = UniqueBrowser();
+  return browser ? browser->GetWeakPtr() : base::WeakPtr<BrowserWindowInterface>();
+}
+NativeStockMemorySampler::NativeStockMemorySampler() = default;
+NativeStockMemorySampler::~NativeStockMemorySampler() = default;
+bool NativeStockMemorySampler::Capture() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (captured_) return false;
+  auto* browser = UniqueBrowser();
+  auto* strip = browser ? browser->GetTabStripModel() : nullptr;
+  if (!browser || !strip || strip->count() != 10) return false;
+  std::vector<Tab> tabs; std::set<content::WebContents*> contents_seen;
+  for (int index = 0; index < 10; ++index) {
+    auto* contents = strip->GetWebContentsAt(index);
+    auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+    const auto url = contents ? contents->GetLastCommittedURL() : GURL();
+    if (!contents || !frame || frame->IsErrorDocument() || contents->IsLoading() ||
+        contents->GetBrowserContext() != browser->GetProfile() ||
+        !url.SchemeIsHTTPOrHTTPS() || url.spec().size() > 512 || !contents_seen.insert(contents).second) return false;
+    tabs.push_back(Tab{contents->GetWeakPtr(), frame->GetWeakDocumentPtr(),
+        base::UnguessableToken::Create(), url.spec()});
+  }
+  browser_ = browser->GetWeakPtr(); tabs_ = std::move(tabs); captured_ = true;
+  return Current();
+}
+bool NativeStockMemorySampler::Current() const {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!browser_ || UniqueBrowser() != browser_.get()) return false;
+  auto* strip = browser_->GetTabStripModel();
+  if (!strip || strip->count() != 10 || tabs_.size() != 10) return false;
+  for (int index = 0; index < 10; ++index) {
+    const auto& tab = tabs_[index];
+    auto* frame = tab.document.AsRenderFrameHostIfValid();
+    if (!tab.contents || !frame || strip->GetWebContentsAt(index) != tab.contents.get() ||
+        tab.contents->GetPrimaryMainFrame() != frame || frame->IsErrorDocument() ||
+        tab.contents->IsLoading() || tab.contents->GetLastCommittedURL().spec() != tab.url ||
+        tab.contents->GetBrowserContext() != browser_->GetProfile()) return false;
+  }
+  return true;
+}
+std::optional<NativeStockMemorySampler::Inventory> NativeStockMemorySampler::ReadInventory() const {
+  if (!Current()) return std::nullopt;
+  Inventory result; const int browser_pid = base::GetCurrentProcId();
+  result.emplace(browser_pid, Process{"browser", content::PROCESS_TYPE_BROWSER, {}, {}});
+  size_t hosts = 0;
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd(); it.Advance()) {
+    auto* host = it.GetCurrentValue();
+    if (!host || host->GetBrowserContext() != browser_->GetProfile() || !host->GetProcess().IsValid()) continue;
+    const int pid = host->GetProcess().Pid(), id = host->GetID().value();
+    if (pid <= 0 || id <= 0 || pid == browser_pid || ++hosts > 128 ||
+        (!result.contains(pid) && result.size() >= 32)) return std::nullopt;
+    auto& process = result.try_emplace(pid, Process{"renderer", content::PROCESS_TYPE_RENDERER, {}, {}}).first->second;
+    const auto task = content::ChildProcessTaskPortProvider::GetInstance()->ReadOwnedTaskIdentity(pid,
+        {content::ChildProcessTaskPortProvider::OwnedHostKind::kRenderer, id});
+    if (!task || process.role != "renderer" || !process.tasks.emplace(id, *task).second) return std::nullopt;
+    process.hosts.push_back(id);
+  }
+  unsigned gpus = 0;
+  for (content::BrowserChildProcessHostIterator it; !it.Done(); ++it) {
+    const auto& child = it.GetData(); if (!child.GetProcess().IsValid()) continue;
+    const int pid = child.GetProcess().Pid(), id = child.GetChildProcessId().value();
+    if (pid <= 0 || id <= 0 || result.contains(pid) || ++hosts > 128 || result.size() >= 32 ||
+        child.process_type == content::PROCESS_TYPE_BROWSER || child.process_type == content::PROCESS_TYPE_RENDERER) return std::nullopt;
+    const bool gpu = child.process_type == content::PROCESS_TYPE_GPU;
+    if (gpu && ++gpus > 1) return std::nullopt;
+    const auto task = content::ChildProcessTaskPortProvider::GetInstance()->ReadOwnedTaskIdentity(pid,
+        {content::ChildProcessTaskPortProvider::OwnedHostKind::kBrowserChild, id});
+    if (!task) return std::nullopt;
+    result.emplace(pid, Process{gpu ? "gpu" : "browser-child", child.process_type, {id}, {{id, *task}}});
+  }
+  if (gpus != 1) return std::nullopt;
+  for (auto& [pid, process] : result) std::ranges::sort(process.hosts);
+  for (const auto& tab : tabs_) {
+    auto* frame = tab.document.AsRenderFrameHostIfValid();
+    if (!frame || !result.contains(frame->GetProcess()->GetProcess().Pid())) return std::nullopt;
+  }
+  return Current() ? std::make_optional(std::move(result)) : std::nullopt;
+}
+base::DictValue NativeStockMemorySampler::Sample() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (++sequence_ > 4000 || (!captured_ && !Capture()) || !Current()) return Refused();
+  const auto started = base::TimeTicks::Now();
+  const auto inventory = ReadInventory(); if (!inventory) return Refused();
+  std::map<int, NativeProcessFootprint> before, after;
+  for (const auto& [pid, owner] : *inventory) {
+    const auto reading = ReadNativeProcessFootprint(pid); if (!reading) return Refused(); before.emplace(pid, *reading);
+  }
+  if (ReadInventory() != inventory) return Refused();
+  for (const auto& [pid, owner] : *inventory) {
+    const auto reading = ReadNativeProcessFootprint(pid); const auto& first = before.at(pid);
+    if (!reading || reading->process_uuid != first.process_uuid || reading->process_start_absolute != first.process_start_absolute ||
+        reading->sample_start < first.sample_end) return Refused();
+    after.emplace(pid, *reading);
+  }
+  if (ReadInventory() != inventory || !Current() || base::TimeTicks::Now() - started > base::Seconds(5)) return Refused();
+  base::ListValue processes, tabs;
+  for (const auto& [pid, owner] : *inventory) {
+    base::ListValue hosts; for (int id : owner.hosts) hosts.Append(id);
+    processes.Append(base::ListValue().Append(pid).Append(owner.role).Append(owner.type).Append(std::move(hosts))
+        .Append(before.at(pid).process_uuid).Append(base::NumberToString(before.at(pid).process_start_absolute))
+        .Append(base::ListValue().Append(Reading(before.at(pid), started)).Append(Reading(after.at(pid), started))));
+  }
+  for (const auto& tab : tabs_) tabs.Append(base::DictValue().Set("documentReceipt", tab.receipt.ToString()).Set("url", tab.url));
+  auto record = base::DictValue().Set("producer", "aux-native-stock-process-memory").Set("version", 1).Set("status", "sampled")
+      .Set("auxShellEnabled", false).Set("chromiumVersion", std::string(version_info::GetVersionNumber())).Set("chromiumLastChange", std::string(version_info::GetLastChange()))
+      .Set("windowId", browser_->GetSessionID().id()).Set("requestNonce", nonce_.ToString()).Set("sampleSequence", base::NumberToString(sequence_))
+      .Set("sampleStartUs", base::NumberToString(started.since_origin().InMicroseconds()))
+      .Set("sampleEndUs", base::NumberToString(base::TimeTicks::Now().since_origin().InMicroseconds()))
+      .Set("tabs", std::move(tabs)).Set("processes", std::move(processes));
+  const auto json = base::WriteJson(record);
+  return json && json->size() <= 12 * 1024 ? std::move(record) : Refused();
+}
+}  // namespace aux
+#endif
