+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_STOCK_MEASUREMENT_NATIVE_STOCK_MEMORY_SAMPLER_H_
+#define CHROME_BROWSER_UI_STOCK_MEASUREMENT_NATIVE_STOCK_MEMORY_SAMPLER_H_
+#include "build/build_config.h"
+#include "chrome/browser/buildflags.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS) && !BUILDFLAG(ENABLE_AUX_SHELL)
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+#include "base/memory/weak_ptr.h"
+#include "base/unguessable_token.h"
+#include "base/values.h"
+#include "content/browser/child_process_task_port_provider_mac.h"
+#include "content/public/browser/weak_document_ptr.h"
+class BrowserWindowInterface;
+class Profile;
+namespace content { class WebContents; }
+namespace aux {
+base::WeakPtr<BrowserWindowInterface> ReadNativeStockMeasurementOwner();
+// The browser/window/Profile and ten current documents come from the native
+// owner inventory only; callers cannot supply process, page or Profile IDs.
+class NativeStockMemorySampler final {
+ public:
+  NativeStockMemorySampler();
+  ~NativeStockMemorySampler();
+  base::DictValue Sample();
+ private:
+  friend class NativeStockMemorySamplerTestPeer;
+  struct Tab {
+    base::WeakPtr<content::WebContents> contents;
+    content::WeakDocumentPtr document;
+    base::UnguessableToken receipt = base::UnguessableToken::Create();
+    std::string url;
+  };
+  struct Process {
+    std::string role;
+    int type;
+    std::vector<int> hosts;
+    std::map<int, content::ChildProcessTaskPortProvider::OwnedTaskIdentity> tasks;
+    bool operator==(const Process&) const = default;
+  };
+  using Inventory = std::map<int, Process>;
+  bool Capture();
+  bool Current() const;
+  std::optional<Inventory> ReadInventory() const;
+  base::WeakPtr<BrowserWindowInterface> browser_;
+  std::vector<Tab> tabs_;
+  const base::UnguessableToken nonce_ = base::UnguessableToken::Create();
+  uint64_t sequence_ = 0;
+  bool captured_ = false;
+};
+}  // namespace aux
+#endif
+#endif
diff --git a/chrome/browser/ui/stock_measurement/native_stock_memory_sampler_browsertest.cc b/chrome/browser/ui/stock_measurement/native_stock_memory_sampler_browsertest.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/ui/stock_measurement/native_stock_memory_sampler_browsertest.cc
@@ -0,0 +1,97 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/stock_measurement/native_stock_memory_sampler.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS) && !BUILDFLAG(ENABLE_AUX_SHELL)
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/test/browser_test.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/page_transition_types.h"
+namespace aux {
+class NativeStockMemorySamplerTestPeer {
+ public:
+  static bool Capture(NativeStockMemorySampler& sampler) { return sampler.Capture(); }
+  static bool Current(const NativeStockMemorySampler& sampler) { return sampler.Current(); }
+};
+class NativeStockMemorySamplerBrowserTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url()));
+    for (int index = 1; index < 10; ++index)
+      ASSERT_TRUE(AddTabAtIndex(index, url(), ui::PAGE_TRANSITION_TYPED));
+    ASSERT_EQ(browser()->GetTabStripModel()->count(), 10);
+  }
+  GURL url() { return embedded_test_server()->GetURL("/title1.html"); }
+};
+// These exercise real Chrome Browser/Profile/ten-tab/document ownership only.
+// They do not claim successful kernel sampling or the twenty-trial stock gate.
+IN_PROC_BROWSER_TEST_F(NativeStockMemorySamplerBrowserTest, TenCurrentDocumentsAndOneShotCapture) {
+  NativeStockMemorySampler sampler;
+  ASSERT_TRUE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  EXPECT_TRUE(NativeStockMemorySamplerTestPeer::Current(sampler));
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  EXPECT_TRUE(NativeStockMemorySamplerTestPeer::Current(sampler));
+}
+IN_PROC_BROWSER_TEST_F(NativeStockMemorySamplerBrowserTest, SameUrlDocumentReplacementRetiresOriginalCapture) {
+  NativeStockMemorySampler sampler;
+  ASSERT_TRUE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), embedded_test_server()->GetURL("/title2.html")));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url()));
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Current(sampler));
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  const auto record = sampler.Sample();
+  ASSERT_NE(record.FindString("status"), nullptr);
+  EXPECT_EQ(*record.FindString("status"), "refused");
+}
+IN_PROC_BROWSER_TEST_F(NativeStockMemorySamplerBrowserTest, EleventhTabRetiresOriginalCapture) {
+  NativeStockMemorySampler sampler;
+  ASSERT_TRUE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  ASSERT_TRUE(AddTabAtIndex(10, url(), ui::PAGE_TRANSITION_TYPED));
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Current(sampler));
+  const auto record = sampler.Sample();
+  ASSERT_NE(record.FindString("status"), nullptr);
+  EXPECT_EQ(*record.FindString("status"), "refused");
+}
+IN_PROC_BROWSER_TEST_F(NativeStockMemorySamplerBrowserTest, ReorderRetiresExactTenTabIdentity) {
+  NativeStockMemorySampler sampler;
+  ASSERT_TRUE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  browser()->GetTabStripModel()->MoveWebContentsAt(0, 1, false);
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Current(sampler));
+}
+IN_PROC_BROWSER_TEST_F(NativeStockMemorySamplerBrowserTest, SecondNormalBrowserRefusesWithoutSelectingWindow) {
+  NativeStockMemorySampler sampler;
+  ASSERT_TRUE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  auto* second = CreateBrowser(browser()->GetProfile());
+  ASSERT_NE(second, nullptr);
+  EXPECT_FALSE(ReadNativeStockMeasurementOwner());
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Current(sampler));
+  NativeStockMemorySampler other;
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Capture(other));
+  CloseBrowserSynchronously(second);
+}
+IN_PROC_BROWSER_TEST_F(NativeStockMemorySamplerBrowserTest, ClosedOwnerCannotRecaptureReplacementBrowser) {
+  NativeStockMemorySampler sampler;
+  ASSERT_TRUE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  auto original = browser()->GetWeakPtr();
+  auto* replacement = CreateBrowser(browser()->GetProfile());
+  ASSERT_NE(replacement, nullptr);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(replacement, url()));
+  for (int index = 1; index < 10; ++index)
+    ASSERT_TRUE(AddTabAtIndexToBrowser(replacement, index, url(), ui::PAGE_TRANSITION_TYPED));
+  SetBrowser(replacement);
+  CloseBrowserSynchronously(original.get());
+  ASSERT_FALSE(original);
+  ASSERT_EQ(ReadNativeStockMeasurementOwner().get(), replacement);
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Current(sampler));
+  EXPECT_FALSE(NativeStockMemorySamplerTestPeer::Capture(sampler));
+  const auto record = sampler.Sample();
+  ASSERT_NE(record.FindString("status"), nullptr);
+  EXPECT_EQ(*record.FindString("status"), "refused");
+  NativeStockMemorySampler fresh;
+  EXPECT_TRUE(NativeStockMemorySamplerTestPeer::Capture(fresh));
+}
+}  // namespace aux
+#endif
