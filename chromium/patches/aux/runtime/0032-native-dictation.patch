+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/dictation_session.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+namespace {
+
+constexpr char kFirst[] = "4e8e3c9f-3140-4bc7-95e0-d28808389d47";
+constexpr char kSecond[] = "42a0756a-9535-43ef-b5d6-6c8806079642";
+constexpr char kFirstOwner[] = "658426c1-7488-4462-9e9b-12f42d25384e";
+constexpr char kSecondOwner[] = "e1c85449-b1ed-41ac-9405-66845593647a";
+
+TEST(DictationSessionGateTest, RejectsInvalidAndOverlappingSessions) {
+  DictationSessionGate gate;
+  EXPECT_FALSE(gate.Begin(kFirstOwner, "not-a-session"));
+  EXPECT_FALSE(gate.Begin("renderer-owned", kFirst));
+  ASSERT_TRUE(gate.Begin(kFirstOwner, kFirst));
+  EXPECT_FALSE(gate.Begin(kSecondOwner, kSecond));
+  EXPECT_FALSE(gate.Begin(kFirstOwner, kSecond));
+  EXPECT_TRUE(gate.IsCurrent(kFirstOwner, kFirst));
+  EXPECT_FALSE(gate.IsCurrent(kSecondOwner, kFirst));
+}
+
+TEST(DictationSessionGateTest, StaleAndForeignStopCannotEndNewSession) {
+  DictationSessionGate gate;
+  ASSERT_TRUE(gate.Begin(kFirstOwner, kFirst));
+  EXPECT_FALSE(gate.MarkStopping(kSecondOwner, kFirst));
+  EXPECT_FALSE(gate.End(kFirstOwner, kSecond));
+  ASSERT_TRUE(gate.MarkStopping(kFirstOwner, kFirst));
+  EXPECT_FALSE(gate.MarkStopping(kFirstOwner, kFirst));
+  ASSERT_TRUE(gate.End(kFirstOwner, kFirst));
+  ASSERT_TRUE(gate.Begin(kSecondOwner, kSecond));
+  EXPECT_FALSE(gate.End(kFirstOwner, kFirst));
+  EXPECT_TRUE(gate.IsCurrent(kSecondOwner, kSecond));
+}
+
+TEST(DictationSessionGateTest, OwnerTeardownReleasesMicrophone) {
+  DictationSessionGate gate;
+  ASSERT_TRUE(gate.Begin(kFirstOwner, kFirst));
+  gate.EndOwner(kFirstOwner);
+  EXPECT_FALSE(gate.IsCurrent(kFirstOwner, kFirst));
+  EXPECT_TRUE(gate.Begin(kFirstOwner, kSecond));
+}
+
