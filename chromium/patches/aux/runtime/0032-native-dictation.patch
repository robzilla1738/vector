@@ -0,0 +1,30 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_DICTATION_SESSION_H_
+#define CHROME_BROWSER_UI_AUX_DICTATION_SESSION_H_
+
+#include <string>
+
+namespace aux {
+
+// UI-sequence authority for the one microphone session in the browser process.
+// The owner token is generated by the browser, never supplied by a renderer.
+class DictationSessionGate {
+ public:
+  bool Begin(const std::string& owner, const std::string& session_id);
+  bool IsCurrent(const std::string& owner, const std::string& session_id) const;
+  bool MarkStopping(const std::string& owner, const std::string& session_id);
+  bool End(const std::string& owner, const std::string& session_id);
+  void EndOwner(const std::string& owner);
+
+ private:
+  std::string owner_;
+  std::string session_id_;
+  bool stopping_ = false;
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_DICTATION_SESSION_H_
