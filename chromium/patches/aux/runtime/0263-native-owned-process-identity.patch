+std::optional<ChildProcessTaskPortProvider::OwnedTaskIdentity>
+ChildProcessTaskPortProvider::ReadOwnedTaskIdentity(
+    base::ProcessHandle process_handle, OwnedHost host) const {
+  if (process_handle <= 0 || host.id <= 0) return std::nullopt;
+  base::AutoLock lock(lock_);
+  const auto it = handle_to_task_port_.find(process_handle);
+  if (it == handle_to_task_port_.end() || it->second.owner != host ||
+      !it->second.launch_generation ||
+      it->second.installed_generation != it->second.launch_generation ||
+      !it->second.port.is_valid()) return std::nullopt;
+  audit_token_t token{};
+  mach_msg_type_number_t count = TASK_AUDIT_TOKEN_COUNT;
+  if (task_info(it->second.port.get(), TASK_AUDIT_TOKEN,
+      reinterpret_cast<task_info_t>(&token), &count) != KERN_SUCCESS ||
+      count != TASK_AUDIT_TOKEN_COUNT || audit_token_to_pid(token) != process_handle ||
+      audit_token_to_pidversion(token) <= 0) return std::nullopt;
+  // An audit token alone can describe a dead task. Require the original task
+  // still to expose its VM before/after the caller's PID-based kernel read.
+  task_vm_info_data_t vm{};
+  count = TASK_VM_INFO_COUNT;
+  if (task_info(it->second.port.get(), TASK_VM_INFO,
+      reinterpret_cast<task_info_t>(&vm), &count) != KERN_SUCCESS ||
+      count != TASK_VM_INFO_COUNT || !vm.virtual_size) return std::nullopt;
+  OwnedTaskIdentity result{host, it->second.launch_generation, {}, audit_token_to_pidversion(token)};
+  std::copy(std::begin(token.val), std::end(token.val), result.audit_token.begin());
+  return result;
 }
 
