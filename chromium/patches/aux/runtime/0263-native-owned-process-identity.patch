@@ -0,0 +1,31 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_runtime_peer_identity.h"
+#if BUILDFLAG(IS_MAC)
+#include <algorithm>
+#include <iterator>
+#include <bsm/libbsm.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+namespace aux {
+std::optional<NativeRuntimePeerIdentity> ReadNativeRuntimePeerIdentity(
+    int connection_fd, int launched_pid) {
+  if (connection_fd < 0 || launched_pid <= 0) return std::nullopt;
+  int type = 0;
+  socklen_t size = sizeof(type);
+  if (getsockopt(connection_fd, SOL_SOCKET, SO_TYPE, &type, &size) != 0 ||
+      size != sizeof(type) || type != SOCK_STREAM) return std::nullopt;
+  audit_token_t token{};
+  size = sizeof(token);
+  if (getsockopt(connection_fd, SOL_LOCAL, LOCAL_PEERTOKEN, &token, &size) != 0 ||
+      size != sizeof(token) || audit_token_to_pid(token) != launched_pid ||
+      audit_token_to_pidversion(token) <= 0) return std::nullopt;
+  pid_t pid = -1;
+  size = sizeof(pid);
+  if (getsockopt(connection_fd, SOL_LOCAL, LOCAL_PEERPID, &pid, &size) != 0 ||
+      size != sizeof(pid) || pid != launched_pid) return std::nullopt;
+  NativeRuntimePeerIdentity result{pid, audit_token_to_pidversion(token), {}};
+  std::copy(std::begin(token.val), std::end(token.val), result.audit_token.begin());
+  return result;
+}
+}  // namespace aux
+#endif
