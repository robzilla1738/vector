+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_RUNTIME_PEER_IDENTITY_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_RUNTIME_PEER_IDENTITY_H_
+#include "build/build_config.h"
+#if BUILDFLAG(IS_MAC)
+#include <array>
+#include <optional>
+#include <stdint.h>
+namespace aux {
+struct NativeRuntimePeerIdentity {
+  int pid;
+  int pid_version;
+  std::array<uint32_t, 8> audit_token;
+  bool operator==(const NativeRuntimePeerIdentity&) const = default;
+};
+// Kernel socket identity, not process liveness. A genuine new same-connection
+// response after the memory reads is still required to prove endpoint liveness.
+std::optional<NativeRuntimePeerIdentity> ReadNativeRuntimePeerIdentity(
+    int connection_fd, int launched_pid);
+}  // namespace aux
+#endif
+#endif
diff --git a/chrome/browser/ui/aux/native_runtime_peer_identity_unittest.cc b/chrome/browser/ui/aux/native_runtime_peer_identity_unittest.cc
new file mode 100644
index 0000000..1acc07a
--- /dev/null
+++ b/chrome/browser/ui/aux/native_runtime_peer_identity_unittest.cc
@@ -0,0 +1,50 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_runtime_peer_identity.h"
+#if BUILDFLAG(IS_MAC)
+#include <algorithm>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include "base/files/scoped_file.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux {
+TEST(NativeRuntimePeerIdentityTest, RealAcceptedEndpointRetainsExactKernelAudit) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  sockaddr_un address{};
+  address.sun_family = AF_UNIX;
+  const auto path = dir.GetPath().AppendASCII("runtime.sock").value();
+  ASSERT_LT(path.size(), sizeof(address.sun_path));
+  std::copy(path.begin(), path.end(), address.sun_path);
+  base::ScopedFD listener(socket(AF_UNIX, SOCK_STREAM, 0));
+  ASSERT_TRUE(listener.is_valid());
+  ASSERT_EQ(bind(listener.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)), 0);
+  ASSERT_EQ(listen(listener.get(), 1), 0);
+  EXPECT_FALSE(ReadNativeRuntimePeerIdentity(listener.get(), getpid()));
+  base::ScopedFD client(socket(AF_UNIX, SOCK_STREAM, 0));
+  ASSERT_TRUE(client.is_valid());
+  ASSERT_EQ(connect(client.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)), 0);
+  base::ScopedFD accepted(accept(listener.get(), nullptr, nullptr));
+  ASSERT_TRUE(accepted.is_valid());
+  const auto before = ReadNativeRuntimePeerIdentity(accepted.get(), getpid());
+  ASSERT_TRUE(before);
+  EXPECT_EQ(before->pid, getpid());
+  EXPECT_GT(before->pid_version, 0);
+  EXPECT_EQ(ReadNativeRuntimePeerIdentity(accepted.get(), getpid()), before);
+  EXPECT_FALSE(ReadNativeRuntimePeerIdentity(accepted.get(), getpid() + 1));
+  accepted.reset();
+  EXPECT_FALSE(ReadNativeRuntimePeerIdentity(accepted.get(), getpid()));
+  // Identity is intentionally not a liveness receipt: production must obtain
+  // a new authenticated fixed-operation response AFTER kernel measurement.
+}
+TEST(NativeRuntimePeerIdentityTest, NoDescriptorOrPipeCannotMintPeerIdentity) {
+  EXPECT_FALSE(ReadNativeRuntimePeerIdentity(-1, getpid()));
+  int descriptors[2];
+  ASSERT_EQ(pipe(descriptors), 0);
+  base::ScopedFD reader(descriptors[0]), writer(descriptors[1]);
+  EXPECT_FALSE(ReadNativeRuntimePeerIdentity(reader.get(), getpid()));
+  EXPECT_FALSE(ReadNativeRuntimePeerIdentity(writer.get(), getpid()));
+}
+}  // namespace aux
+#endif
