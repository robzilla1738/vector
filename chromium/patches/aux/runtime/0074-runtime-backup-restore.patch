+                          : method == "cancelRuntimeRestore"
+                                ? "installation.cancelRestore"
+                                : "installation.restoreStatus";
+    host->CallApi(api, "{}",
+        base::BindOnce(
+            [](RequestCallback callback, bool backup,
+               AuxRuntimeHost::Response response) {
+              if (!response.ok || !backup) {
+                std::move(callback).Run(response.ok, response.result_json,
+                                        response.error_code,
+                                        response.error_message);
+                return;
+              }
+              auto parsed = base::JSONReader::Read(response.result_json,
+                                                   base::JSON_PARSE_RFC);
+              if (!parsed || !parsed->is_dict()) {
+                std::move(callback).Run(false, "", "backend_unavailable",
+                                        "Aux backup result is invalid");
+                return;
+              }
+              base::DictValue result = parsed->GetDict().Clone();
+              result.Remove("createdAt");
+              result.Remove("schemaVersion");
+              std::move(callback).Run(true,
+                  *base::WriteJson(base::Value(std::move(result))), "", "");
+            }, std::move(callback), method == "exportRuntimeBackup"));
+    return;
+  }
+  if (method == "stageRuntimeRestore") {
+    if (!list->empty() || browser_->GetProfile()->IsOffTheRecord() ||
+        open_file_dialog_) {
+      std::move(callback).Run(false, "", "conflict",
+                              "Runtime restore requires an available regular Profile");
+      return;
+    }
+    auto* active = browser_->GetTabStripModel()->GetActiveWebContents();
+    open_file_dialog_ = ui::SelectFileDialog::Create(
+        this, std::make_unique<ChromeSelectFilePolicy>(active));
+    if (!open_file_dialog_) {
+      std::move(callback).Run(false, "", "not_supported",
+                              "The system file dialog is unavailable");
+      return;
+    }
+    file_dialog_purpose_ = FileDialogPurpose::kRuntimeRestore;
+    file_dialog_callback_ = std::move(callback);
+    open_file_dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_FOLDER, std::u16string(),
+        browser_->GetProfile()->last_selected_directory(), nullptr, 0,
+        base::FilePath::StringType(), browser_->GetWindow()->GetNativeWindow());
+    return;
+  }
+  if (method == "exportMigrationLayout") {
+    if (list->size() != 1 || !(*list)[0].is_string() ||
+        (*list)[0].GetString().size() > 1024 * 1024 ||
+        browser_->GetProfile()->IsOffTheRecord()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Invalid migration layout");
+      return;
+    }
+    const std::string& content = (*list)[0].GetString();
+    auto parsed = base::JSONReader::Read(content, base::JSON_PARSE_RFC);
+    if (!parsed || !parsed->is_dict()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Migration layout must be a JSON object");
+      return;
+    }
+    BeginAuxGeneratedSave("Aux-layout.json", content + "\n", base::FilePath(), 0,
+        base::BindOnce(
+            [](RequestCallback callback, bool ok, const std::string& result,
+               const std::string& code, const std::string& message) {
+              if (!ok || result == "null") {
+                std::move(callback).Run(ok, result, code, message);
+                return;
+              }
+              auto path = base::JSONReader::Read(result, base::JSON_PARSE_RFC);
+              if (!path || !path->is_string()) {
+                std::move(callback).Run(false, "", "io_error",
+                                        "Migration layout path is invalid");
+                return;
+              }
+              base::DictValue value;
+              value.Set("path", path->GetString());
+              std::move(callback).Run(true,
+                  *base::WriteJson(base::Value(std::move(value))), "", "");
+            }, std::move(callback)));
+    return;
+  }
   if (method == "migrationReview" || method == "migrationBegin" ||
       method == "migrationBatch" || method == "migrationFinish" ||
       method == "migrationRollback") {
