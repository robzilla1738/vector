   GetOrCreate(profile, contents);
   PageIdentity* identity = FromWebContents(contents);
   if (identity->runtime_owned_) {
+    identity->AcquirePaintLease();
     return;
   }
   identity->runtime_owned_ = true;
+  identity->AcquirePaintLease();
   if (!profile || profile->IsOffTheRecord()) {
     return;
