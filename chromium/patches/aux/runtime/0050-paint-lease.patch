+void PageIdentity::AcquirePaintLease() {
+  if (paint_lease_) {
+    return;
+  }
+  paint_lease_ = GetWebContents().IncrementCapturerCount(
+      gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/false,
+      /*is_activity=*/false);
+}
+
 void PageIdentity::MarkRuntimeOwned(Profile* profile,
