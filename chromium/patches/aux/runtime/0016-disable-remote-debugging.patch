diff --git a/chrome/browser/buildflags.gni b/chrome/browser/buildflags.gni
index f9867a92a5..32857b0a55 100644
--- a/chrome/browser/buildflags.gni
+++ b/chrome/browser/buildflags.gni
@@ -11,6 +11,9 @@ import("//build/config/chrome_build.gni")
 declare_args() {
   # Aux shell is built only for the Aux distribution.
   enable_aux_shell = false
+  # Compatibility probes may enable Chromium's remote DevTools endpoint in
+  # local test builds. The release signer rejects this flag.
+  aux_allow_remote_debugging_for_tests = false
 
   # By default, only branded builds allow for platform experience.
   enable_platform_experience = is_chrome_branded
