+  NativeGuestStageWitness witness;
+  mojo_base.mojom.TimeTicks witness_observed;
+  mojo_base.mojom.TimeTicks commit;
+  mojo_base.mojom.TimeTicks submitted_at;
+  uint32 shell_frame_token;
+  bool activated;
+  bool submitted_frame;
+  int32 submission_failure;
+  bool submitted;
+};
+interface NativeCreatedGuestFrameReadiness {
+  Ready(NativeCreatedGuestFrameScope scope, NativeGuestStageWitness witness)
+      => (bool accepted);
+};
