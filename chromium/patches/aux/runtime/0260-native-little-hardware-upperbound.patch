+// Identities assert continuity on this already-bound target widget; no selectors.
+enum NativeCreatedGuestSurfaceKind { kLittleWindow };
+struct NativeCreatedGuestFrameScope {
+  NativeCreatedGuestSurfaceKind surface_kind;
+  mojo_base.mojom.UnguessableToken request_nonce;
