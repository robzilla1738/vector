+#if BUILDFLAG(ENABLE_AUX_SHELL)
+std::optional<LoginTabHelper::AuxAuthRequest>
+LoginTabHelper::GetAuxAuthRequest() const {
+  return aux_auth_request_;
+}
+
+bool LoginTabHelper::RespondAuxAuth(
+    const std::string& id,
+    const std::optional<net::AuthCredentials>& credentials) {
+  if (!aux_auth_request_ || aux_auth_request_->id != id) {
+    return false;
+  }
+  if (credentials) {
+    aux_last_submitted_challenge_ = challenge_.challenger.Serialize() + "\n" +
+                                    challenge_.realm + "\n" + challenge_.scheme;
+  }
+  aux_auth_request_.reset();
+  HandleCredentials(credentials);
+  return true;
+}
