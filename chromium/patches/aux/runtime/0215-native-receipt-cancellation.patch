diff --git a/components/permissions/permission_request_manager.cc b/components/permissions/permission_request_manager.cc
index 3608927..07e9c0f 100644
--- a/components/permissions/permission_request_manager.cc
+++ b/components/permissions/permission_request_manager.cc
@@ -689,6 +689,26 @@ bool PermissionRequestManager::ResolveRequestsFromBrowser(
   // Effects/observers may destroy the manager; do not access it again.
   return true;
 }
+bool PermissionRequestManager::CancelRequestsFromBrowser(
+    const std::vector<const PermissionRequest*>& expected_requests) {
+  if (!IsCurrentBrowserBatch(expected_requests)) return false;
+  const auto self = weak_factory_.GetWeakPtr();
+  const auto lifetimes = CurrentRequestLifetimes();
+  const bool previous_preempt = can_preempt_current_request_;
+  can_preempt_current_request_ = false;
+  base::ScopedClosureRunner restore_preempt(base::BindOnce(
+      [](base::WeakPtr<PermissionRequestManager> manager, bool previous) {
+        if (manager) manager->can_preempt_current_request_ = previous;
+      }, self, previous_preempt));
+  for (const auto& request : requests_) {
+    CancelRequestIncludingDuplicates(request.get());
+    if (!self || !IsCurrentBatch(lifetimes) ||
+        !IsCurrentBrowserBatch(expected_requests)) return true;
+  }
+  FinalizeCurrentRequests();
+  // Finalization may destroy this manager through request/observer callbacks.
+  return true;
+}
 void PermissionRequestManager::Accept(const PromptOptions& prompt_options) {
   if (ignore_callbacks_from_prompt_) return;
   DCHECK(view_);
