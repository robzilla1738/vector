diff --git a/chrome/browser/ui/aux/profile_spaces_unittest.cc b/chrome/browser/ui/aux/profile_spaces_unittest.cc
new file mode 100644
index 0000000..d3a7738
--- /dev/null
+++ b/chrome/browser/ui/aux/profile_spaces_unittest.cc
@@ -0,0 +1,25 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/profile_spaces.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "content/public/test/navigation_simulator.h"
+#include "content/public/test/test_renderer_host.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+namespace aux {
+class ProfileMoveDocumentTest : public content::RenderViewHostTestHarness {};
+TEST_F(ProfileMoveDocumentTest, RechecksCapturedDocumentAfterDestinationLoad) {
+  const GURL url("https://fixture.test/work");
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(web_contents(), url);
+  auto initial = web_contents()->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  EXPECT_TRUE(SameMovedDocument(web_contents(), initial, url));
+  // A destination load can finish after a same-URL replacement document.
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(web_contents(), url);
+  EXPECT_FALSE(SameMovedDocument(web_contents(), initial, url));
+  auto replaced = web_contents()->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(web_contents(), GURL("https://fixture.test/other"));
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(web_contents(), url);
+  EXPECT_FALSE(SameMovedDocument(web_contents(), replaced, url));
+  EXPECT_FALSE(SameMovedDocument(nullptr, replaced, url));
+}
+}
