@@ -0,0 +1,46 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/profile_spaces.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/organization_store.h"
+#include "chrome/browser/ui/aux/little_window_controller.h"
+#include "chrome/browser/ui/aux/quick_ask_controller.h"
+#include "chrome/browser/ui/aux/shell_events.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "url/gurl.h"
+namespace aux {
+bool SameMovedDocument(content::WebContents* contents, const content::WeakDocumentPtr& document, const GURL& url) {
+  auto* frame = document.AsRenderFrameHostIfValid();
+  return contents && frame && contents->GetLastCommittedURL() == url &&
+      frame == contents->GetPrimaryMainFrame();
+}
+bool FocusProfileSpace(BrowserWindowInterface* window, std::string_view space_id, std::string* error) {
+  if (!window || window->GetProfile()->IsOffTheRecord() || window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      IsLittleWindow(window) || IsQuickAskWindow(window)) {
+    *error = "A normal Profile window is required";
+    return false;
+  }
+  const std::string window_id = base::NumberToString(window->GetSessionID().id());
+  auto snapshot = OrganizationStore::Snapshot(window->GetProfile(), window_id, error);
+  auto* layout = snapshot ? snapshot->FindDict("layout") : nullptr;
+  bool found = false;
+  if (layout) for (const auto& value : *layout->FindDict("shared")->FindList("spaces"))
+    found |= *value.GetDict().FindString("id") == space_id;
+  if (!found) {
+    *error = "Space was not found in this Profile";
+    return false;
+  }
+  layout->FindDict("window")->Set("activeSpaceId", std::string(space_id));
+  if (!OrganizationStore::Commit(window->GetProfile(), window_id,
+        snapshot->FindInt("revision").value_or(0), *layout, error)) return false;
+  base::DictValue focus;
+  focus.Set("spaceId", std::string(space_id));
+  focus.Set("windowId", window_id);
+  EmitShellEvent(window->GetProfile(), "onFocusSpace", *base::WriteJson(focus));
+  return true;
+}
+}
