+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/extension_bridge.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+
+TEST(ExtensionBridgeTest, AcceptsOnlyCanonicalStoreIds) {
+  EXPECT_TRUE(ExtensionBridge::IsStoreId("abcdefghijklmnopabcdefghijklmnop"));
+  EXPECT_FALSE(ExtensionBridge::IsStoreId("abcdefghijklmnop"));
+  EXPECT_FALSE(ExtensionBridge::IsStoreId("abcdefghijklmnopabcdefghijklmnO"));
+  EXPECT_FALSE(ExtensionBridge::IsStoreId("abcdefghijklmnopabcdefghijklmn0"));
+  EXPECT_FALSE(ExtensionBridge::IsStoreId("../../../../../../../../../../../../"));
+}
+
+}  // namespace aux
