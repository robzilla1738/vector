diff --git a/chrome/browser/ui/aux/extension_bridge.cc b/chrome/browser/ui/aux/extension_bridge.cc
new file mode 100644
index 0000000000..e54fa1c2ea
--- /dev/null
+++ b/chrome/browser/ui/aux/extension_bridge.cc
@@ -0,0 +1,256 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/extension_bridge.h"
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/memory/ref_counted.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/extensions/updater/extension_updater.h"
+#include "chrome/browser/extensions/updater/extension_updater_factory.h"
+#include "chrome/browser/extensions/webstore_install_with_prompt.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/extensions/extensions_container.h"
+#include "chrome/browser/ui/toolbar/toolbar_action_view_model.h"
+#include "extensions/browser/disable_reason.h"
+#include "extensions/browser/extension_registrar.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/uninstall_reason.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/permissions/permissions_data.h"
+
+namespace aux {
+namespace {
+
+using Reply = ExtensionBridge::Callback;
+
+void Error(Reply callback, const char* code, std::string message) {
+  std::move(callback).Run(false, "", code, std::move(message));
+}
+
+void Result(Reply callback, base::Value value) {
+  const auto json = base::WriteJson(value);
+  if (!json) {
+    Error(std::move(callback), "internal", "Extension result was invalid");
+    return;
+  }
+  std::move(callback).Run(true, *json, "", "");
+}
+
+bool StoreOwned(const extensions::Extension* extension) {
+  return extension && extension->from_webstore() && !extension->is_app();
+}
+
+base::DictValue Describe(const extensions::Extension& extension,
+                           extensions::ExtensionRegistry& registry) {
+  const bool enabled =
+      registry.enabled_extensions().Contains(extension.id());
+  base::DictValue item;
+  item.Set("key", extension.id());
+  item.Set("id", extension.id());
+  item.Set("name", extension.name());
+  item.Set("version", extension.VersionString());
+  item.Set("enabled", enabled);
+  item.Set("loaded", enabled);
+  item.Set("managed", StoreOwned(&extension));
+  item.Set("source", extension.from_webstore() ? "store" : "environment");
+  base::ListValue permissions;
+  for (const auto& message :
+       extension.permissions_data()->GetPermissionMessages()) {
+    if (permissions.size() == 32) {
+      break;
+    }
+    std::string text = base::UTF16ToUTF8(message.message());
+    if (text.size() > 512) {
+      text.resize(512);
+    }
+    permissions.Append(std::move(text));
+  }
+  item.Set("permissions", std::move(permissions));
+  return item;
+}
+
+const std::string* OneId(const base::ListValue& args) {
+  return args.size() == 1 && args[0].is_string()
+             ? args[0].GetIfString()
+             : nullptr;
+}
+
+}  // namespace
+
+bool ExtensionBridge::Handles(std::string_view method) {
+  return method == "extensions" || method == "installStoreExtension" ||
+         method == "checkStoreExtensionUpdate" ||
+         method == "setExtensionEnabled" || method == "reloadExtension" ||
+         method == "removeExtension" || method == "showExtensionAction";
+}
+
+bool ExtensionBridge::IsStoreId(std::string_view id) {
+  return id.size() == 32 &&
+         std::ranges::all_of(id, [](char c) { return c >= 'a' && c <= 'p'; });
+}
+
+void ExtensionBridge::Handle(Profile* profile, BrowserWindowInterface* browser,
+                             gfx::NativeWindow parent, std::string_view method,
+                             const base::ListValue& args, Callback callback) {
+  if (!profile || profile->IsOffTheRecord() || !browser ||
+      browser->GetProfile() != profile) {
+    Error(std::move(callback), "forbidden", "Extensions require a regular Profile");
+    return;
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  auto* registrar = extensions::ExtensionRegistrar::Get(profile);
+  if (!registry || !registrar || !registrar->IsInitialized()) {
+    Error(std::move(callback), "backend_unavailable", "Extension service is not ready");
+    return;
+  }
+  if (method == "extensions") {
+    if (!args.empty()) {
+      Error(std::move(callback), "invalid_argument", "Unexpected extension arguments");
+      return;
+    }
+    base::ListValue items;
+    for (const auto& extension : registry->GenerateInstalledExtensionsSet()) {
+      if (extension->is_app() || extension->location() ==
+          extensions::mojom::ManifestLocation::kComponent) {
+        continue;
+      }
+      items.Append(Describe(*extension, *registry));
+    }
+    Result(std::move(callback), base::Value(std::move(items)));
+    return;
+  }
+  const std::string* id = OneId(args);
+  if (method == "setExtensionEnabled") {
+    if (args.size() != 2 || !args[0].is_string() || !args[1].is_bool()) {
+      Error(std::move(callback), "invalid_argument", "Invalid extension state");
+      return;
+    }
+    id = args[0].GetIfString();
+  }
+  if (!id || !IsStoreId(*id)) {
+    Error(std::move(callback), "invalid_argument", "Invalid Store extension ID");
+    return;
+  }
+  if (method == "installStoreExtension") {
+    if (registry->GetInstalledExtension(*id)) {
+      Error(std::move(callback), "conflict", "Extension is already installed");
+      return;
+    }
+    auto installer = base::MakeRefCounted<extensions::WebstoreInstallWithPrompt>(
+        *id, profile, parent,
+        base::BindOnce(
+            [](base::WeakPtr<Profile> profile, std::string id,
+               Reply callback, bool success, const std::string& error,
+               extensions::webstore_install::Result) {
+              auto* registry = profile
+                                   ? extensions::ExtensionRegistry::Get(profile.get())
+                                   : nullptr;
+              const auto* installed = registry ? registry->GetInstalledExtension(id) : nullptr;
+              if (!success || !installed) {
+                Error(std::move(callback), "install_failed",
+                      error.empty() ? "Store installation was cancelled or failed" : error);
+                return;
+              }
+              Result(std::move(callback), base::Value(Describe(*installed, *registry)));
+            }, profile->GetWeakPtr(), *id, std::move(callback)));
+    installer->BeginInstall();
+    return;
+  }
+  const extensions::Extension* extension = registry->GetInstalledExtension(*id);
+  if (!StoreOwned(extension)) {
+    Error(std::move(callback), "not_found", "Store extension is not installed in this Profile");
+    return;
+  }
+  if (method == "checkStoreExtensionUpdate") {
+    auto* updater = extensions::ExtensionUpdaterFactory::GetForBrowserContext(profile);
+    if (!updater) {
+      Error(std::move(callback), "backend_unavailable", "Extension updater is unavailable");
+      return;
+    }
+    extensions::ExtensionUpdater::CheckParams params;
+    params.ids.push_back(*id);
+    params.install_immediately = true;
+    params.fetch_priority = extensions::DownloadFetchPriority::kForeground;
+    params.callback = base::BindOnce(
+        [](base::WeakPtr<Profile> profile, std::string id, Reply callback) {
+          auto* registry = profile ? extensions::ExtensionRegistry::Get(profile.get()) : nullptr;
+          const auto* extension = registry ? registry->GetInstalledExtension(id) : nullptr;
+          if (!extension) {
+            Error(std::move(callback), "conflict", "Extension changed during update");
+            return;
+          }
+          Result(std::move(callback), base::Value(Describe(*extension, *registry)));
+        }, profile->GetWeakPtr(), *id, std::move(callback));
+    updater->CheckNow(std::move(params));
+    return;
+  }
+  if (method == "setExtensionEnabled") {
+    if (args[1].GetBool()) {
+      registrar->EnableExtension(*id);
+    } else {
+      registrar->DisableExtension(*id,
+          {extensions::disable_reason::DISABLE_USER_ACTION});
+    }
+    extension = registry->GetInstalledExtension(*id);
+    if (!extension || registry->enabled_extensions().Contains(*id) !=
+                          args[1].GetBool()) {
+      Error(std::move(callback), "conflict", "Extension state could not be changed");
+      return;
+    }
+    Result(std::move(callback), base::Value(Describe(*extension, *registry)));
+    return;
+  }
+  if (method == "reloadExtension") {
+    if (!registry->enabled_extensions().Contains(*id)) {
+      Error(std::move(callback), "conflict", "Enable the extension before reloading it");
+      return;
+    }
+    registrar->ReloadExtension(*id);
+    // Reload may replace the Extension object synchronously.
+    extension = registry->GetInstalledExtension(*id);
+    if (!extension) {
+      Error(std::move(callback), "conflict", "Extension changed during reload");
+      return;
+    }
+    Result(std::move(callback), base::Value(Describe(*extension, *registry)));
+    return;
+  }
+  if (method == "removeExtension") {
+    std::u16string error;
+    if (!registrar->UninstallExtension(
+            *id, extensions::UNINSTALL_REASON_USER_INITIATED, &error)) {
+      Error(std::move(callback), "permission_denied",
+            error.empty() ? "Extension cannot be removed" : base::UTF16ToUTF8(error));
+      return;
+    }
+    Result(std::move(callback), base::Value(true));
+    return;
+  }
+  if (method == "showExtensionAction") {
+    if (!registry->enabled_extensions().Contains(*id)) {
+      Error(std::move(callback), "conflict", "Extension is not enabled");
+      return;
+    }
+    auto* container = ExtensionsContainer::From(*browser);
+    auto* action = container ? container->GetActionForId(*id) : nullptr;
+    if (!action) {
+      Error(std::move(callback), "not_found", "Extension has no toolbar action");
+      return;
+    }
+    action->ExecuteUserAction(ToolbarActionViewModel::InvocationSource::kToolbarButton);
+    Result(std::move(callback), base::Value(true));
+    return;
+  }
+  Error(std::move(callback), "not_found", "Unsupported extension operation");
+}
+
+}  // namespace aux
