@@ -0,0 +1,37 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_EXTENSION_BRIDGE_H_
+#define CHROME_BROWSER_UI_AUX_EXTENSION_BRIDGE_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/functional/callback.h"
+#include "base/values.h"
+#include "ui/gfx/native_ui_types.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace aux {
+
+// Only the authenticated chrome://aux/ browser shell calls this bridge.
+// Chromium's extension registry and updater remain the source of truth.
+class ExtensionBridge {
+ public:
+  using Callback = base::OnceCallback<void(bool ok, std::string result_json,
+                                           std::string error_code,
+                                           std::string error_message)>;
+
+  static bool Handles(std::string_view method);
+  static bool IsStoreId(std::string_view id);
+  static void Handle(Profile* profile, BrowserWindowInterface* browser,
+                     gfx::NativeWindow parent, std::string_view method,
+                     const base::ListValue& args, Callback callback);
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_EXTENSION_BRIDGE_H_
