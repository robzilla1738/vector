+// Only a boolean leaves the page. A failed or incomplete probe is unknown,
+// which protects the tab from duplicate cleanup.
+constexpr char16_t kUnsavedWorkScript[] = uR"JS((() => {
+  try {
+    if (document.designMode === 'on' || document.querySelector('[contenteditable="true"], [contenteditable=""], [contenteditable="plaintext-only"]')) return true;
+    const fields = document.querySelectorAll('input, textarea, select');
+    if (fields.length > 5000) return null;
+    for (const field of fields) {
+      if (field instanceof HTMLTextAreaElement) {
+        if (field.value !== field.defaultValue) return true;
+      } else if (field instanceof HTMLSelectElement) {
+        const options = Array.from(field.options);
+        const defaults = options.filter(option => option.defaultSelected);
+        if (defaults.length ? options.some(option => option.selected !== option.defaultSelected)
+          : field.multiple ? options.some(option => option.selected)
+          : field.selectedIndex > 0) return true;
+      } else if (field instanceof HTMLInputElement) {
+        if (field.type === 'file') { if (field.files?.length) return true; }
+        else if (field.type === 'checkbox' || field.type === 'radio') { if (field.checked !== field.defaultChecked) return true; }
+        else if (!['hidden', 'button', 'submit', 'reset', 'image'].includes(field.type) && field.value !== field.defaultValue) return true;
+      }
+    }
+    return false;
+  } catch { return null; }
+})())JS";
+
+constexpr int kUnsavedWorkWorld = content::ISOLATED_WORLD_ID_CONTENT_END + 8;
+
+class UnsavedWorkRequest : public std::enable_shared_from_this<UnsavedWorkRequest> {
+ public:
+  using Reply = aux::mojom::ShellHost::RequestCallback;
+
+  UnsavedWorkRequest(base::WeakPtr<WebUIBrowserUI> ui, Reply callback)
+      : ui_(std::move(ui)), callback_(std::move(callback)) {}
+
+  void Start(const base::ListValue& tabs) {
+    struct Job {
+      std::string page_id;
+      content::GlobalRenderFrameHostId frame_id;
+      int64_t navigation_id;
+    };
+    std::vector<Job> jobs;
+    auto* catalog = aux::TabCatalog::GetForProfile(ui_->browser()->GetProfile());
+    for (const auto& value : tabs) {
+      const auto& request = value.GetDict();
+      const std::string& page_id = *request.FindString("pageId");
+      const std::string& url = *request.FindString("url");
+      if (items_.contains(page_id)) {
+        if (items_[page_id].url != url) items_[page_id].unknown = true;
+        continue;
+      }
+      Item& item = items_[page_id];
+      item.url = url;
+      BrowserWindowInterface* owner = nullptr;
+      content::WebContents* contents = catalog->FindPage(page_id, &owner);
+      if (!contents || owner != ui_->browser() || contents->IsLoading() ||
+          contents->IsCrashed() || contents->GetLastCommittedURL().spec() != url ||
+          !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) continue;
+      content::RenderFrameHost* main = contents->GetPrimaryMainFrame();
+      if (!main || !main->IsRenderFrameLive() ||
+          main->GetLastCommittedURL().spec() != url) continue;
+      item.navigation_id = main->GetNavigationId();
+      main->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+        if (!frame->IsRenderFrameLive()) { item.unknown = true; return; }
+        if (item.frames.size() >= 512) { item.unknown = true; return; }
+        const auto id = frame->GetGlobalId();
+        item.frames.emplace(id, frame->GetNavigationId());
+        jobs.push_back({page_id, id, frame->GetNavigationId()});
+        ++item.pending;
+        ++pending_;
+      });
+      if (item.frames.empty()) item.unknown = true;
+    }
+    if (!pending_) { Finish(); return; }
+    timer_.Start(FROM_HERE, base::Seconds(5),
+                 base::BindOnce([](std::shared_ptr<UnsavedWorkRequest> self) {
+                   self->Finish();
+                 }, shared_from_this()));
+    for (const Job& job : jobs) {
+      content::RenderFrameHost* frame = content::RenderFrameHost::FromID(job.frame_id);
+      if (!frame) {
+        OnResult(job.page_id, job.frame_id, job.navigation_id, base::Value());
+        continue;
+      }
+      frame->ExecuteJavaScriptInIsolatedWorld(
+          kUnsavedWorkScript,
+          base::BindOnce([](std::shared_ptr<UnsavedWorkRequest> self,
+                            std::string page_id,
+                            content::GlobalRenderFrameHostId frame_id,
+                            int64_t navigation_id, base::Value result) {
+            self->OnResult(page_id, frame_id, navigation_id, std::move(result));
+          }, shared_from_this(), job.page_id, job.frame_id, job.navigation_id),
+          kUnsavedWorkWorld);
+    }
+  }
+
+ private:
+  struct Item {
+    std::string url;
+    int64_t navigation_id = 0;
+    std::map<content::GlobalRenderFrameHostId, int64_t> frames;
+    int pending = 0;
+    bool dirty = false;
+    bool unknown = false;
+  };
+
+  void OnResult(const std::string& page_id,
+                content::GlobalRenderFrameHostId frame_id,
+                int64_t navigation_id,
+                base::Value result) {
+    if (!callback_) return;
+    Item& item = items_.at(page_id);
+    content::RenderFrameHost* frame = content::RenderFrameHost::FromID(frame_id);
+    if (!frame || frame->GetNavigationId() != navigation_id || !result.is_bool())
+      item.unknown = true;
+    else if (result.GetBool())
+      item.dirty = true;
+    --item.pending;
+    if (--pending_ == 0) Finish();
+  }
+
+  void Finish() {
+    if (!callback_) return;
+    timer_.Stop();
+    if (!ui_) return;
+    auto* catalog = aux::TabCatalog::GetForProfile(ui_->browser()->GetProfile());
+    base::DictValue result;
+    for (const auto& [page_id, item] : items_) {
+      BrowserWindowInterface* owner = nullptr;
+      content::WebContents* contents = catalog->FindPage(page_id, &owner);
+      bool valid = contents && owner == ui_->browser() && !contents->IsLoading() &&
+                   !contents->IsCrashed() &&
+                   contents->GetLastCommittedURL().spec() == item.url &&
+                   contents->GetPrimaryMainFrame() &&
+                   contents->GetPrimaryMainFrame()->GetLastCommittedURL().spec() == item.url &&
+                   contents->GetPrimaryMainFrame()->GetNavigationId() == item.navigation_id;
+      if (valid) {
+        std::map<content::GlobalRenderFrameHostId, int64_t> current;
+        contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+            [&](content::RenderFrameHost* frame) {
+              if (frame->IsRenderFrameLive())
+                current.emplace(frame->GetGlobalId(), frame->GetNavigationId());
+            });
+        valid = current == item.frames;
+      }
+      result.Set(page_id, !valid || item.unknown || item.pending ? "unknown" :
+                          item.dirty ? "dirty" : "clean");
+    }
+    std::move(callback_).Run(true, *base::WriteJson(result), "", "");
+  }
+
+  base::WeakPtr<WebUIBrowserUI> ui_;
+  Reply callback_;
+  std::map<std::string, Item> items_;
+  int pending_ = 0;
+  base::OneShotTimer timer_;
+};
+
+}  // namespace
