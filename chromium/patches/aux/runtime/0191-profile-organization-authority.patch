diff --git a/chrome/browser/ui/aux/organization_store.cc b/chrome/browser/ui/aux/organization_store.cc
index af3d29b..3be94cb 100644
--- a/chrome/browser/ui/aux/organization_store.cc
+++ b/chrome/browser/ui/aux/organization_store.cc
@@ -382,6 +382,24 @@ base::DictValue MakeSnapshot(const base::DictValue& document,
 
 }  // namespace
 
+std::optional<base::DictValue> OrganizationStore::ProfileSnapshot(
+    Profile* profile, std::string* error) {
+  if (!profile || profile->IsOffTheRecord()) {
+    *error = "Organization is unavailable for this Profile";
+    return std::nullopt;
+  }
+  const base::DictValue& document = profile->GetPrefs()->GetDict(kOrganizationPref);
+  if (!ValidDocument(document)) {
+    *error = "The Profile organization preference is invalid";
+    return std::nullopt;
+  }
+  base::DictValue snapshot;
+  snapshot.Set("revision", document.FindInt("revision").value_or(0));
+  if (document.empty()) snapshot.Set("shared", base::Value());
+  else snapshot.Set("shared", document.FindDict("shared")->Clone());
+  return snapshot;
+}
