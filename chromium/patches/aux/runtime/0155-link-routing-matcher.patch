+class LinkRouter final : public base::SupportsUserData::Data, public BrowserCollectionObserver, public ProfileObserver {
+ public:
+  static LinkRouter* ForProfile(Profile* profile);
+  static base::DictValue Config();
+  static std::optional<base::DictValue> SetConfig(int expected_revision, const base::DictValue& config, std::string* error);
+  static base::DictValue Test(const GURL& url, std::string_view source, std::string_view sender = "");
+  // Trust comes from the native caller, never renderer data or inner URL parameters.
+  static bool Open(Profile* source_profile, const GURL& url, std::string source, std::string sender,
+                   std::optional<base::DictValue> explicit_destination = std::nullopt,
+                   bool background = false, base::OnceCallback<void(bool)> done = {},
+                   base::RepeatingCallback<bool()> authorized = {},
+                   std::string fallback_reason = "", bool fallback_attempt = false);
+  static void RecordHit(const std::string& id);
+  static bool OpenScheme(Profile* source_profile, const GURL& url);
+  explicit LinkRouter(Profile* profile);
+  ~LinkRouter() override;
+  base::ListValue TakeReceipts(BrowserWindowInterface* caller);
+  base::ListValue Prompts(BrowserWindowInterface* caller);
+  void Resolve(BrowserWindowInterface* caller, const std::string& id, const base::DictValue& destination,
+               bool remember, base::OnceCallback<void(bool)> done);
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+  void OnBrowserCreated(BrowserWindowInterface*) override {}
+ private:
+  friend class LinkRouterBrowserTest;
+  struct Receipt { std::string window; base::DictValue payload; };
+  struct Prompt { std::string window; GURL url; base::TimeTicks expires; int64_t expires_at; bool resolving = false; };
+  static std::optional<base::DictValue> WriteConfig(int expected, const base::DictValue& config, bool preserve_hits, std::string* error);
+  bool PromptLive(const std::string& id);
+  size_t reserved_ = 0;
+  bool Deliver(BrowserWindowInterface* window, const GURL& url, const base::DictValue& destination,
+               const std::string& rule_id, bool background, bool untrusted, const std::string& fallback_reason);
+  bool Ask(BrowserWindowInterface* window, const GURL& url);
+  void Expire();
+  void ScheduleExpiry();
+  raw_ptr<Profile> profile_;
+  raw_ptr<ProfileBrowserCollection> browsers_;
+  base::ScopedObservation<ProfileBrowserCollection, BrowserCollectionObserver> observation_{this};
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  std::vector<Receipt> receipts_;
+  std::map<std::string, Prompt> prompts_;
+  base::OneShotTimer expiry_timer_;
+  base::WeakPtrFactory<LinkRouter> weak_factory_{this};
+};
+}
+#endif
diff --git a/chrome/browser/ui/aux/link_router_browsertest.cc b/chrome/browser/ui/aux/link_router_browsertest.cc
new file mode 100644
index 0000000..da04ae7
--- /dev/null
+++ b/chrome/browser/ui/aux/link_router_browsertest.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/link_router.h"
+#include "chrome/browser/ui/browser.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/test/browser_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux {
+class LinkRouterBrowserTest : public InProcessBrowserTest {
+ protected:
+  bool Ask(LinkRouter* router, BrowserWindowInterface* window) { return router->Ask(window, GURL("http://127.0.0.1/held")); }
+  bool Deliver(LinkRouter* router, BrowserWindowInterface* window) {
+    base::DictValue destination; destination.Set("kind", "profile"); destination.Set("profileId", "default"); destination.Set("window", "tab");
+    return router->Deliver(window, GURL("http://127.0.0.1/receipt"), destination, "", false, true, "");
+  }
+  void ExpireNow(LinkRouter* router) { for (auto& [id, prompt] : router->prompts_) prompt.expires = base::TimeTicks::Now() - base::Milliseconds(1); router->Expire(); }
+};
+IN_PROC_BROWSER_TEST_F(LinkRouterBrowserTest, ExactOwnerDrainIsAtomicAndCloseClearsHeldURLs) {
+  auto* router = LinkRouter::ForProfile(browser()->profile());
+  auto* other = CreateBrowser(browser()->profile());
+  ASSERT_TRUE(Deliver(router, browser()));
+  EXPECT_TRUE(router->TakeReceipts(other).empty());
+  EXPECT_EQ(router->TakeReceipts(browser()).size(), 1u);
+  EXPECT_TRUE(router->TakeReceipts(browser()).empty());
+  ASSERT_TRUE(Ask(router, browser()));
+  EXPECT_TRUE(router->Prompts(other).empty());
+  EXPECT_EQ(router->Prompts(browser()).size(), 1u);
+  router->OnBrowserClosed(browser());
+  EXPECT_TRUE(router->Prompts(browser()).empty());
+}
+IN_PROC_BROWSER_TEST_F(LinkRouterBrowserTest, FullReceiptQueueRefusesBeforeNavigation) {
+  auto* router = LinkRouter::ForProfile(browser()->profile());
+  for (int i = 0; i < 128; ++i) ASSERT_TRUE(Deliver(router, browser()));
+  const int tabs = browser()->tab_strip_model()->count();
+  EXPECT_FALSE(Deliver(router, browser()));
+  EXPECT_EQ(browser()->tab_strip_model()->count(), tabs);
+  EXPECT_EQ(router->TakeReceipts(browser()).size(), 128u);
+  EXPECT_TRUE(Deliver(router, browser()));
+}
+IN_PROC_BROWSER_TEST_F(LinkRouterBrowserTest, MonotonicExpiryAndDuplicateResolveDoNotOpen) {
+  auto* router = LinkRouter::ForProfile(browser()->profile());
+  ASSERT_TRUE(Ask(router, browser()));
+  const std::string id = *router->Prompts(browser())[0].GetDict().FindString("id");
+  ExpireNow(router);
+  EXPECT_TRUE(router->Prompts(browser()).empty());
+  base::DictValue destination; destination.Set("kind", "profile"); destination.Set("profileId", "default"); destination.Set("window", "tab");
+  bool answered = false;
+  const int tabs = browser()->tab_strip_model()->count();
+  router->Resolve(browser(), id, destination, false, base::BindOnce([](bool* answered, bool ok) { *answered = true; EXPECT_FALSE(ok); }, &answered));
+  EXPECT_TRUE(answered);
+  EXPECT_EQ(browser()->tab_strip_model()->count(), tabs);
+}
+IN_PROC_BROWSER_TEST_F(LinkRouterBrowserTest, PrivateOwnerCannotReadOrResolveRegularQueue) {
+  auto* router = LinkRouter::ForProfile(browser()->profile());
+  ASSERT_TRUE(Ask(router, browser()));
+  ASSERT_TRUE(Deliver(router, browser()));
+  auto* private_browser = CreateIncognitoBrowser();
+  EXPECT_EQ(LinkRouter::ForProfile(private_browser->profile()), nullptr);
+  EXPECT_TRUE(router->TakeReceipts(private_browser).empty());
+  EXPECT_TRUE(router->Prompts(private_browser).empty());
+  EXPECT_EQ(router->Prompts(browser()).size(), 1u);
+  EXPECT_EQ(router->TakeReceipts(browser()).size(), 1u);
+}
+}
diff --git a/chrome/browser/ui/aux/link_routing.cc b/chrome/browser/ui/aux/link_routing.cc
new file mode 100644
index 0000000..f318062
--- /dev/null
+++ b/chrome/browser/ui/aux/link_routing.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/link_routing.h"
+#include <algorithm>
+#include <limits>
+#include "base/strings/pattern.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/ui/aux/generated/aux_host_methods.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "url/gurl.h"
+namespace aux {
+namespace {
+bool WebUrl(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && !url.has_username() && !url.has_password();
+}
+bool Contains(const base::ListValue* values, std::string_view wanted) {
+  return values && std::ranges::any_of(*values, [wanted](const base::Value& item) {
+    return item.is_string() && item.GetString() == wanted;
+  });
+}
+int Match(const base::DictValue& rule, const GURL& url,
+          std::string_view source, std::string_view sender_app) {
+  if (!rule.FindBool("enabled").value_or(false)) return 0;
+  if (const auto* sources = rule.FindList("sources"); sources && !Contains(sources, source)) return 0;
+  if (const auto* apps = rule.FindList("fromApps"); apps && !apps->empty() && !Contains(apps, sender_app)) return 0;
+  const auto* match = rule.FindDict("match");
+  const auto* kind = match ? match->FindString("kind") : nullptr;
+  const auto* pattern = match ? match->FindString("pattern") : nullptr;
+  if (!kind || !pattern) return 0;
+  if (*kind == "prefix") {
+    const GURL prefix(*pattern);
+    return WebUrl(prefix) && base::StartsWith(url.spec(), prefix.spec()) ? 4 : 0;
+  }
+  if (*kind == "host") {
+    const GURL host("https://" + *pattern + "/");
+    if (!WebUrl(host) || host.has_port() || host.path() != "/" || host.has_query() || host.has_ref()) return 0;
+    if (url.host() == host.host()) return match->FindBool("subdomains").value_or(false) ? 2 : 3;
+    return match->FindBool("subdomains").value_or(false) &&
+        base::EndsWith(url.host(), "." + host.host()) ? 2 : 0;
+  }
+  return *kind == "glob" && base::MatchPattern(url.spec(), *pattern) ? 1 : 0;
+}
+base::DictValue DefaultDestination(const base::DictValue& config, std::string_view last,
+    const std::function<bool(std::string_view)>& available) {
+  base::DictValue destination;
+  const auto* fallback = config.FindDict("default");
+  const auto* configured = fallback ? fallback->FindString("profileId") : nullptr;
+  const std::string profile = configured && available(*configured) ? *configured :
+      available(last) ? std::string(last) : "default";
+  destination.Set("kind", "profile");
+  destination.Set("profileId", profile);
+  destination.Set("window", "tab");
+  if (configured && profile == *configured) {
+    if (const auto* space = fallback->FindString("spaceId")) destination.Set("spaceId", *space);
+  }
+  return destination;
+}
+}
+LinkRouteResult MatchLinkRoute(const base::DictValue& config, const GURL& url,
+    std::string_view source, std::string_view sender_app, std::string_view last,
+    const std::function<bool(std::string_view)>& available,
+    const std::function<bool(std::string_view, std::string_view)>& space_available) {
+  LinkRouteResult result{DefaultDestination(config, last, available)};
+  int rank = 0;
+  int order = std::numeric_limits<int>::max();
+  if (WebUrl(url) && config.FindBool("enabled").value_or(false)) {
+    if (const auto* rules = config.FindList("rules")) for (const auto& value : *rules) {
+      const auto* rule = value.GetIfDict();
+      if (!rule) continue;
+      const int candidate = Match(*rule, url, source, sender_app);
+      const int candidate_order = rule->FindInt("order").value_or(std::numeric_limits<int>::max());
+      if (candidate > rank || (candidate && candidate == rank && candidate_order < order)) {
+        if (const auto* destination = rule->FindDict("destination")) {
+          result.destination = destination->Clone();
+          const auto* id = rule->FindString("id");
+          result.rule_id = id ? *id : "";
+          rank = candidate;
+          order = candidate_order;
+        }
+      }
+    }
+  }
+  if (const auto* profile = result.destination.FindString("profileId")) {
+    if (!available(*profile)) {
+      result.destination = DefaultDestination(config, last, available);
+      result.fallback = true;
+      result.fallback_reason = "profile-unavailable";
+    }
+    const auto* actual = result.destination.FindString("profileId");
+    if (const auto* space = result.destination.FindString("spaceId"); space && !space_available(*actual, *space)) {
+      result.destination.Remove("spaceId");
+      result.fallback = true;
+      result.fallback_reason = "space-unavailable";
+    }
+  }
+  return result;
+}
+bool ValidLinkRoutes(const base::DictValue& config) {
+  const auto method = generated::LookupMethod("setLinkRoutes");
+  base::ListValue args;
+  args.Append(config.FindInt("revision").value_or(-1));
+  args.Append(config.Clone());
+  std::string error;
+  if (!method || !generated::ValidateMethodArgs(*method, base::Value(std::move(args)), &error)) return false;
+  const auto* rules = config.FindList("rules");
+  if (config.FindInt("version") != 1 || !config.FindBool("enabled") ||
+      config.FindInt("revision").value_or(-1) < 0 || !config.FindDict("default") ||
+      !rules || rules->size() > 500) return false;
+  const auto* in_app = config.FindString("inApp");
+  if (!in_app || (*in_app != "off" && *in_app != "cross-site-new-tab")) return false;
+  for (const auto& value : *rules) {
+    const auto* rule = value.GetIfDict();
+    const auto* match = rule ? rule->FindDict("match") : nullptr;
+    const auto* pattern = match ? match->FindString("pattern") : nullptr;
+    const auto* kind = match ? match->FindString("kind") : nullptr;
+    if (!pattern || pattern->empty() || pattern->size() > 2048 || !kind) return false;
+    if (*kind == "prefix" && !WebUrl(GURL(*pattern))) return false;
+    if (*kind == "host") {
+      const GURL host("https://" + *pattern + "/");
+      if (!WebUrl(host) || host.has_port() || host.path() != "/" || host.has_query() || host.has_ref()) return false;
+    } else if (*kind != "prefix" && *kind != "glob") return false;
+  }
+  return true;
+}
+bool CanRouteInApp(const base::DictValue& config, const GURL& source,
+    const GURL& destination, bool new_tab, bool user_gesture,
+    bool has_opener, bool post, bool private_window, bool protected_page) {
+  const auto* mode = config.FindString("inApp");
+  if (!mode || *mode != "cross-site-new-tab" || !config.FindBool("enabled").value_or(false) ||
+      !new_tab || !user_gesture || has_opener || post || private_window || protected_page ||
+      !WebUrl(source) || !WebUrl(destination)) return false;
+  using namespace net::registry_controlled_domains;
+  return !SameDomainOrHost(source, destination, INCLUDE_PRIVATE_REGISTRIES);
+}
+}
