diff --git a/chrome/browser/ui/aux/link_routing_unittest.cc b/chrome/browser/ui/aux/link_routing_unittest.cc
new file mode 100644
index 0000000..2617943
--- /dev/null
+++ b/chrome/browser/ui/aux/link_routing_unittest.cc
@@ -0,0 +1,84 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/link_routing.h"
+#include "base/json/json_reader.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+namespace aux {
+namespace {
+base::DictValue Config() {
+  return base::JSONReader::ReadDict(R"JSON({"version":1,"revision":0,"enabled":true,"inApp":"cross-site-new-tab","default":{"kind":"last-used"},"rules":[]})JSON", base::JSON_PARSE_RFC).value();
+}
+void Rule(base::DictValue& config, std::string id, std::string kind,
+          std::string pattern, bool subdomains, int order, std::string profile) {
+  base::DictValue match;
+  match.Set("kind", kind); match.Set("pattern", pattern); match.Set("subdomains", subdomains);
+  base::DictValue destination;
+  destination.Set("kind", "profile"); destination.Set("profileId", profile); destination.Set("window", "tab");
+  base::DictValue rule;
+  rule.Set("id", id); rule.Set("enabled", true); rule.Set("order", order);
+  rule.Set("match", std::move(match)); rule.Set("destination", std::move(destination)); rule.Set("hits", 0);
+  config.FindList("rules")->Append(std::move(rule));
+}
+LinkRouteResult Route(const base::DictValue& config, std::string url,
+                     std::string source = "external", std::string app = "") {
+  return MatchLinkRoute(config, GURL(url), source, app, "default",
+      [](std::string_view id) { return id == "default" || id == "work"; },
+      [](std::string_view profile, std::string_view space) { return profile == "work" && space == "research"; });
+}
+TEST(LinkRoutingTest, PrecedenceAndOrderUseTheActualMatcher) {
+  auto config = Config();
+  Rule(config, "glob", "glob", "https://*.example.test/*", false, 0, "work");
+  Rule(config, "subdomain", "host", "example.test", true, 0, "work");
+  Rule(config, "exact", "host", "example.test", false, 0, "work");
+  Rule(config, "prefix", "prefix", "https://example.test/docs", false, 20, "work");
+  Rule(config, "earlier-prefix", "prefix", "https://example.test/docs", false, 10, "work");
+  EXPECT_EQ(Route(config, "https://example.test/docs/page").rule_id, "earlier-prefix");
+  EXPECT_EQ(Route(config, "https://example.test/").rule_id, "exact");
+  EXPECT_EQ(Route(config, "https://child.example.test/").rule_id, "subdomain");
+  EXPECT_TRUE(Route(config, "https://notexample.test/").rule_id.empty());
+  EXPECT_TRUE(ValidLinkRoutes(config));
+}
+TEST(LinkRoutingTest, SourceAndSenderRestrictionsAndFallback) {
+  auto config = Config();
+  Rule(config, "source", "host", "example.test", false, 0, "work");
+  auto& rule = (*config.FindList("rules"))[0].GetDict();
+  base::ListValue sources; sources.Append("cli"); rule.Set("sources", std::move(sources));
+  base::ListValue apps; apps.Append("dev.fixture.sender"); rule.Set("fromApps", std::move(apps));
+  EXPECT_TRUE(Route(config, "https://example.test/", "external", "dev.fixture.sender").rule_id.empty());
+  EXPECT_TRUE(Route(config, "https://example.test/", "cli", "dev.other").rule_id.empty());
+  EXPECT_EQ(Route(config, "https://example.test/", "cli", "dev.fixture.sender").rule_id, "source");
+  rule.Remove("fromApps");
+  rule.FindDict("destination")->Set("spaceId", "missing");
+  EXPECT_TRUE(Route(config, "https://example.test/", "cli").fallback);
+  EXPECT_FALSE(Route(config, "https://example.test/", "cli").destination.contains("spaceId"));
+  rule.FindDict("destination")->Set("profileId", "locked-or-deleted");
+  const auto fallback = Route(config, "https://example.test/", "cli");
+  EXPECT_TRUE(fallback.fallback);
+  EXPECT_EQ(*fallback.destination.FindString("profileId"), "default");
+}
+TEST(LinkRoutingTest, UnsafeAndMalformedUrlsCannotMatch) {
+  auto config = Config();
+  Rule(config, "all", "glob", "*", false, 0, "work");
+  for (const auto* url : {"file:///etc/passwd", "javascript:alert(1)", "https://user:password@example.test/"})
+    EXPECT_TRUE(Route(config, url).rule_id.empty());
+  (*config.FindList("rules"))[0].GetDict().FindDict("match")->Set("kind", "host");
+  (*config.FindList("rules"))[0].GetDict().FindDict("match")->Set("pattern", "example.test/path");
+  EXPECT_FALSE(ValidLinkRoutes(config));
+}
+TEST(LinkRoutingTest, OpenerOAuthPostPrivateAndProtectedFlowsStayInTheirProfile) {
+  auto config = Config();
+  const GURL source("https://example.test/");
+  const GURL target("https://other.test/");
+  EXPECT_TRUE(CanRouteInApp(config, source, target, true, true, false, false, false, false));
+  EXPECT_FALSE(CanRouteInApp(config, source, GURL("https://sub.example.test/"), true, true, false, false, false, false));
+  EXPECT_FALSE(CanRouteInApp(config, source, target, false, true, false, false, false, false));
+  EXPECT_FALSE(CanRouteInApp(config, source, target, true, false, false, false, false, false));
+  EXPECT_FALSE(CanRouteInApp(config, source, target, true, true, true, false, false, false));
+  EXPECT_FALSE(CanRouteInApp(config, source, target, true, true, false, true, false, false));
+  EXPECT_FALSE(CanRouteInApp(config, source, target, true, true, false, false, true, false));
+  EXPECT_FALSE(CanRouteInApp(config, source, target, true, true, false, false, false, true));
+}
+}
+}
diff --git a/chrome/browser/ui/aux/methods/profile_routing_methods.cc b/chrome/browser/ui/aux/methods/profile_routing_methods.cc
index f7cefd4..3e8324b 100644
--- a/chrome/browser/ui/aux/methods/profile_routing_methods.cc
+++ b/chrome/browser/ui/aux/methods/profile_routing_methods.cc
@@ -1,6 +1,54 @@
 // Copyright 2026 The Aux Authors
-// Use of this source code is governed by a BSD-style license that can be
-// found in the LICENSE file.
-
-// Wave 0 reserves this compilation unit for the profile_routing feature lane.
-// It registers no handler; generated methods remain unavailable until implemented.
+#include "chrome/browser/ui/aux/link_router.h"
+#include "chrome/browser/ui/aux/generated/aux_host_methods.h"
+#include "chrome/browser/ui/aux/little_window_controller.h"
+#include "chrome/browser/ui/aux/quick_ask_controller.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/profiles/profile.h"
+#include "base/json/json_writer.h"
+#include "base/functional/bind.h"
+namespace aux {
+bool IsLinkRoutingMethod(std::string_view method) {
+  return method == "linkRoutes" || method == "setLinkRoutes" || method == "testLinkRoute" ||
+      method == "resolveRoutePrompt" || method == "routedOpens" || method == "routePrompts";
+}
+bool HandleLinkRoutingRequest(BrowserWindowInterface* caller, const std::string& method,
+    const base::ListValue& args, mojom::ShellHost::RequestCallback callback) {
+  auto fail = [&callback](const char* code, const std::string& message) {
+    std::move(callback).Run(false, "", code, message); return true;
+  };
+  if (!caller || caller->GetProfile()->IsOffTheRecord() || IsQuickAskWindow(caller) ||
+      caller->GetType() != BrowserWindowInterface::TYPE_NORMAL) return fail("forbidden", "Routing requires an owned regular Aux window");
+  const auto descriptor = generated::LookupMethod(method);
+  std::string error;
+  if (!descriptor || !generated::ValidateMethodArgs(*descriptor, base::Value(args.Clone()), &error))
+    return fail("invalid_argument", error);
+  auto reply = [](mojom::ShellHost::RequestCallback callback, base::Value value) {
+    const auto json = base::WriteJson(value);
+    if (!json) { std::move(callback).Run(false, "", "internal", "Routing result could not be encoded"); return; }
+    std::move(callback).Run(true, *json, "", "");
+  };
+  auto* router = LinkRouter::ForProfile(caller->GetProfile());
+  if (method == "linkRoutes") reply(std::move(callback), base::Value(LinkRouter::Config()));
+  else if (method == "setLinkRoutes") {
+    if (!args[0].is_int()) return fail("invalid_argument", "Revision exceeds the native integer range");
+    auto config = LinkRouter::SetConfig(args[0].GetInt(), args[1].GetDict(), &error);
+    if (!config) return fail("conflict", error);
+    reply(std::move(callback), base::Value(std::move(*config)));
+  } else if (method == "testLinkRoute") {
+    const GURL url(args[0].GetString());
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.has_username() || url.has_password())
+      return fail("invalid_argument", "Routing tests require an HTTP or HTTPS URL without credentials");
+    reply(std::move(callback), base::Value(LinkRouter::Test(url, args[1].GetString())));
+  } else if (method == "routedOpens") reply(std::move(callback), base::Value(router->TakeReceipts(caller)));
+  else if (method == "routePrompts") reply(std::move(callback), base::Value(router->Prompts(caller)));
+  else if (method == "resolveRoutePrompt") {
+    router->Resolve(caller, args[0].GetString(), args[1].GetDict(), args[2].GetBool(),
+      base::BindOnce([](mojom::ShellHost::RequestCallback callback, bool opened) {
+        if (!opened) { std::move(callback).Run(false, "", "conflict", "The prompt expired, its owner closed, or its destination changed. Refresh and choose again."); return; }
+        std::move(callback).Run(true, "true", "", "");
+      }, std::move(callback)));
+  } else return fail("unavailable", "Unknown routing method");
+  return true;
+}
+}
