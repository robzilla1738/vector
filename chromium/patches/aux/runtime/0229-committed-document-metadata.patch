+std::optional<RenderFrameMetadataProviderImpl::AuxGuestActivatedFrameForTesting>
+RenderFrameMetadataProviderImpl::FindAuxGuestFrameForTesting(
+    const base::UnguessableToken& document, const base::UnguessableToken& scope,
+    const viz::LocalSurfaceId& surface, uint32_t token) const {
+  if (document.is_empty() || scope.is_empty() || !surface.is_valid() || !token)
+    return std::nullopt;
+  for (const auto& frame : aux_guest_frames_for_testing_)
+    if (frame.document == document && frame.scope == scope &&
+        frame.local_surface_id == surface && frame.frame_token == token)
+      return frame;
+  return std::nullopt;
 }
 
