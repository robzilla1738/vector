+  DCHECK(IsMainThread());
+  CHECK(document.has_value() == scope.has_value());
+  CHECK(!document || (!document->is_empty() && !scope->is_empty()));
+  auto* state = pending_commit_state();
+  if (state->aux_guest_document_for_testing == document &&
+      state->aux_guest_scope_for_testing == scope)
+    return;
+  state->aux_guest_document_for_testing = document;
+  state->aux_guest_scope_for_testing = scope;
+  SetNeedsCommit();
+}
