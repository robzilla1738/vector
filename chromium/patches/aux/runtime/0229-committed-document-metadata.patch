+// Synthetic transport test, not native presentation qualification.
+TEST_F(RenderFrameMetadataObserverImplTest, ScopedGuestReportsEveryExactToken) {
+  cc::RenderFrameMetadata metadata;
+  metadata.aux_guest_document_for_testing = base::UnguessableToken::Create();
+  metadata.aux_guest_scope_for_testing = base::UnguessableToken::Create();
+  for (uint32_t token : {10u, 11u}) {
+    viz::CompositorFrameMetadata frame;
+    frame.frame_token = token;
+    base::RunLoop loop;
+    EXPECT_CALL(client(), OnRenderFrameMetadataChanged(token, metadata))
+        .WillOnce(InvokeClosure(loop.QuitClosure()));
+    observer_impl().OnRenderFrameSubmission(metadata, &frame, false);
+    EXPECT_TRUE(frame.send_frame_token_to_embedder);
+    loop.Run();
+  }
+  // Ending the lease must publish the absent marker; the old document cannot
+  // continue to qualify later unmarked frames.
+  metadata.aux_guest_document_for_testing.reset();
+  metadata.aux_guest_scope_for_testing.reset();
+  viz::CompositorFrameMetadata frame;
+  frame.frame_token = 12;
+  base::RunLoop loop;
+  EXPECT_CALL(client(), OnRenderFrameMetadataChanged(12u, metadata))
+      .WillOnce(InvokeClosure(loop.QuitClosure()));
+  observer_impl().OnRenderFrameSubmission(metadata, &frame, false);
+  EXPECT_TRUE(frame.send_frame_token_to_embedder);
+  loop.Run();
+}
