+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux {
+namespace {
+using Result = download::DownloadItem::DownloadRenameResult;
+TEST(DownloadNaming, EveryEligibilityRefusalIsIndependent) {
+  const DownloadNamingEligibility eligible{ .complete = true, .has_end_time = true, .web_source = true };
+  EXPECT_TRUE(CanNameDownload(eligible));
+  for (auto field : { &DownloadNamingEligibility::prompted, &DownloadNamingEligibility::forced_path,
+      &DownloadNamingEligibility::save_package, &DownloadNamingEligibility::dangerous,
+      &DownloadNamingEligibility::insecure, &DownloadNamingEligibility::opened,
+      &DownloadNamingEligibility::open_when_complete, &DownloadNamingEligibility::private_profile,
+      &DownloadNamingEligibility::removed }) {
+    auto state = eligible; state.*field = true; EXPECT_FALSE(CanNameDownload(state));
+  }
+  for (auto field : { &DownloadNamingEligibility::complete, &DownloadNamingEligibility::has_end_time,
+      &DownloadNamingEligibility::web_source }) {
+    auto state = eligible; state.*field = false; EXPECT_FALSE(CanNameDownload(state));
+  }
+}
+TEST(DownloadNaming, ExclusiveMovePreservesIdentityBytesAndAttributes) {
+  base::ScopedTempDir directory; ASSERT_TRUE(directory.CreateUniqueTempDir());
+  const auto source = directory.GetPath().AppendASCII("download.pdf");
+  const auto destination = directory.GetPath().AppendASCII("Invoice 4471.pdf");
+  ASSERT_TRUE(base::WriteFile(source, "invoice"));
+  const char quarantine[] = "0081;fixture;Aux;fixture";
+  ASSERT_EQ(0, setxattr(source.value().c_str(), "com.apple.quarantine", quarantine, sizeof(quarantine), 0, 0));
+  const char where_froms[] = "loopback download fixture";
+  ASSERT_EQ(0, setxattr(source.value().c_str(), "com.apple.metadata:kMDItemWhereFroms", where_froms, sizeof(where_froms), 0, 0));
+  const auto before = FingerprintDownloadFile(source); ASSERT_TRUE(before);
+  EXPECT_EQ(Result::SUCCESS, RenameDownloadFileConditional(*before, source, source, destination));
+  EXPECT_FALSE(base::PathExists(source));
+  const auto after = FingerprintDownloadFile(destination); ASSERT_TRUE(after); EXPECT_EQ(*before, *after);
+  std::string content; ASSERT_TRUE(base::ReadFileToString(destination, &content)); EXPECT_EQ(content, "invoice");
+  char value[128]; const auto length = getxattr(destination.value().c_str(), "com.apple.quarantine", value, sizeof(value), 0, 0);
+  ASSERT_EQ(static_cast<ssize_t>(sizeof(quarantine)), length); EXPECT_EQ(std::string(value, length), std::string(quarantine, sizeof(quarantine)));
+  const auto where_length = getxattr(destination.value().c_str(), "com.apple.metadata:kMDItemWhereFroms", value, sizeof(value), 0, 0);
+  ASSERT_EQ(static_cast<ssize_t>(sizeof(where_froms)), where_length); EXPECT_EQ(std::string(value, where_length), std::string(where_froms, sizeof(where_froms)));
+}
+TEST(DownloadNaming, NameCollisionNeverOverwritesEitherFile) {
+  base::ScopedTempDir directory; ASSERT_TRUE(directory.CreateUniqueTempDir());
+  const auto source = directory.GetPath().AppendASCII("download.txt"), destination = directory.GetPath().AppendASCII("Invoice.txt");
+  ASSERT_TRUE(base::WriteFile(source, "download")); ASSERT_TRUE(base::WriteFile(destination, "person's file"));
+  const auto fingerprint = FingerprintDownloadFile(source); ASSERT_TRUE(fingerprint);
+  EXPECT_EQ(Result::FAILURE_NAME_CONFLICT, RenameDownloadFileConditional(*fingerprint, source, source, destination));
+  std::string content; ASSERT_TRUE(base::ReadFileToString(destination, &content)); EXPECT_EQ(content, "person's file");
+  ASSERT_TRUE(base::ReadFileToString(source, &content)); EXPECT_EQ(content, "download");
+}
+TEST(DownloadNaming, RefusesChangedIdentitySizeAndOpenFiles) {
+  base::ScopedTempDir directory; ASSERT_TRUE(directory.CreateUniqueTempDir());
+  const auto source = directory.GetPath().AppendASCII("download.txt"), destination = directory.GetPath().AppendASCII("Invoice.txt");
+  ASSERT_TRUE(base::WriteFile(source, "first")); const auto fingerprint = FingerprintDownloadFile(source); ASSERT_TRUE(fingerprint);
+  ASSERT_TRUE(base::DeleteFile(source)); ASSERT_TRUE(base::WriteFile(source, "replacement"));
+  EXPECT_EQ(Result::FAILURE_UNAVAILABLE, RenameDownloadFileConditional(*fingerprint, source, source, destination));
+  const auto replaced = FingerprintDownloadFile(source); ASSERT_TRUE(replaced);
+  ASSERT_TRUE(base::WriteFile(source, "changed to a different size"));
+  EXPECT_EQ(Result::FAILURE_UNAVAILABLE, RenameDownloadFileConditional(*replaced, source, source, destination));
+  const auto current = FingerprintDownloadFile(source); ASSERT_TRUE(current);
+  const int fd = open(source.value().c_str(), O_RDONLY); ASSERT_GE(fd, 0);
+  EXPECT_EQ(Result::FAILURE_UNAVAILABLE, RenameDownloadFileConditional(*current, source, source, destination)); close(fd);
+  EXPECT_FALSE(base::PathExists(destination));
+}
+TEST(DownloadNaming, RefusesCrossDirectoryAndSymbolicLinks) {
+  base::ScopedTempDir directory; ASSERT_TRUE(directory.CreateUniqueTempDir());
+  const auto source = directory.GetPath().AppendASCII("download.txt"), link = directory.GetPath().AppendASCII("link.txt");
+  ASSERT_TRUE(base::WriteFile(source, "download")); ASSERT_TRUE(base::CreateSymbolicLink(source, link));
+  EXPECT_FALSE(FingerprintDownloadFile(link));
+  const auto fingerprint = FingerprintDownloadFile(source); ASSERT_TRUE(fingerprint);
+  EXPECT_EQ(Result::FAILURE_UNAVAILABLE, RenameDownloadFileConditional(*fingerprint, source, source, directory.GetPath().AppendASCII("another/Invoice.txt")));
+}
+}
