+#include "base/time/time.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/delete_profile_helper.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/profiles/profile_window.h"
+#include "chrome/browser/profiles/profiles_state.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/aux/profile_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/web_contents.h"
+#include "unicode/uchar.h"
+#include "unicode/utf16.h"
+#include "url/gurl.h"
+
+namespace {
+
+using Reply = aux::mojom::ShellHost::RequestCallback;
+
+void Fail(Reply callback, const char* code, const char* message) {
+  std::move(callback).Run(false, "", code, message);
+}
+
+void Succeed(Reply callback, base::Value value) {
+  const auto json = base::WriteJson(value);
+  if (!json) {
+    Fail(std::move(callback), "internal", "Profile result could not be encoded");
+    return;
+  }
+  std::move(callback).Run(true, *json, "", "");
+}
+
+std::string ProfileId(const base::FilePath& path) {
+  const std::string name = path.BaseName().AsUTF8Unsafe();
+  return name == "Default" ? "default" : name;
+}
+
+bool ListedProfile(ProfileAttributesEntry* entry, Profile* current) {
+  return entry && !entry->IsOmitted() && !entry->IsEphemeral() &&
+         entry->GetPath().DirName() == current->GetPath().DirName() &&
+         entry->GetPath().BaseName() != ProfileManager::GetGuestProfilePath().BaseName() &&
+         entry->GetPath().BaseName() != ProfileManager::GetSystemProfilePath().BaseName();
+}
+
+ProfileAttributesEntry* FindProfile(ProfileManager* manager, Profile* current,
+                                    const std::string& id) {
+  for (auto* entry : manager->GetProfileAttributesStorage().GetAllProfilesAttributes()) {
+    if (ListedProfile(entry, current) && ProfileId(entry->GetPath()) == id)
+      return entry;
+  }
+  return nullptr;
+}
+
+bool Archived(const std::string& id) {
+  return g_browser_process->local_state()
+      ->GetDict(aux::kArchivedProfilesPref).FindBool(id).value_or(false);
+}
+
+base::DictValue Describe(ProfileAttributesEntry* entry, Profile* current) {
+  const std::string id = ProfileId(entry->GetPath());
+  base::DictValue item;
+  item.Set("id", id);
+  item.Set("name", id == "default" && entry->IsUsingDefaultName()
+                       ? "Personal"
+                       : base::UTF16ToUTF8(entry->GetLocalProfileName()));
+  item.Set("current", entry->GetPath() == current->GetPath());
+  item.Set("archived", Archived(id));
+  return item;
+}
+
+base::ListValue ListProfiles(ProfileManager* manager, Profile* current) {
+  base::ListValue items;
+  for (auto* entry : manager->GetProfileAttributesStorage().GetAllProfilesAttributes()) {
+    if (ListedProfile(entry, current)) items.Append(Describe(entry, current));
+  }
+  return items;
+}
+
+std::optional<std::u16string> ProfileName(const std::string& raw) {
+  if (raw.empty() || raw.size() > 240 || !base::IsStringUTF8(raw))
+    return std::nullopt;
+  std::u16string name(base::TrimWhitespace(base::UTF8ToUTF16(raw),
+                                           base::TRIM_ALL));
+  if (name.empty() || name.size() > 60) return std::nullopt;
+  const auto code_units = base::span(name);
+  for (int32_t i = 0; i < static_cast<int32_t>(name.size());) {
+    UChar32 codepoint;
+    U16_NEXT(code_units, i, static_cast<int32_t>(name.size()), codepoint);
+    const int category = u_charType(codepoint);
+    if (category == U_CONTROL_CHAR || category == U_FORMAT_CHAR)
+      return std::nullopt;
+  }
+  return name;
+}
+
+bool ValidWebUrl(const std::string& text) {
+  const GURL url(text);
+  return text.size() <= 8192 && url.is_valid() && url.SchemeIsHTTPOrHTTPS() &&
+         !url.has_username() && !url.has_password();
+}
+
+void AwaitRemoval(base::WeakPtr<WebUIBrowserUI> ui, base::FilePath path,
+                  Reply callback, int attempts) {
+  if (!ui || !g_browser_process || !g_browser_process->profile_manager())
+    return;
+  auto* manager = g_browser_process->profile_manager();
+  auto& storage = manager->GetProfileAttributesStorage();
+  if (!storage.GetProfileAttributesWithPath(path)) {
+    ScopedDictPrefUpdate archived(g_browser_process->local_state(),
+                                  aux::kArchivedProfilesPref);
+    archived->Remove(ProfileId(path));
+    Succeed(std::move(callback),
+            base::Value(ListProfiles(manager, ui->browser()->GetProfile())));
+    return;
+  }
+  if (attempts >= 100) {
+    Fail(std::move(callback), "conflict", "Profile deletion did not finish");
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&AwaitRemoval, ui, std::move(path), std::move(callback),
+                     attempts + 1),
+      base::Milliseconds(100));
+}
+
+void OpenLoadedProfile(Reply callback, std::optional<GURL> url, Profile* profile) {
+  if (!profile) {
+    Fail(std::move(callback), "backend_unavailable", "Profile could not be loaded");
+    return;
+  }
+  profiles::OpenBrowserWindowForProfile(
+      base::BindOnce(
+          [](Reply callback, std::optional<GURL> url,
+             BrowserWindowInterface* window) {
+            if (!window) {
+              Fail(std::move(callback), "backend_unavailable",
+                   "Profile window could not be opened");
+              return;
+            }
+            if (url && !chrome::AddAndReturnTabAt(window, *url, -1, true)) {
+              Fail(std::move(callback), "backend_unavailable",
+                   "Page could not be opened in the Profile");
+              return;
+            }
+            Succeed(std::move(callback), base::Value(true));
+          },
+          std::move(callback), std::move(url)),
+      /*always_create=*/false, /*is_new_profile=*/false,
+      /*open_command_line_urls=*/false, profile);
+}
+
+}  // namespace
+
+void WebUIBrowserUI::HandleAuxProfilesRequest(
+    const std::string& method, const base::ListValue& args,
+    RequestCallback callback) {
+  Profile* current = browser_ ? browser_->GetProfile() : nullptr;
+  ProfileManager* manager = g_browser_process
+                                ? g_browser_process->profile_manager()
+                                : nullptr;
+  if (!current || current->IsOffTheRecord() || !manager ||
+      !g_browser_process->local_state()) {
+    Fail(std::move(callback), "forbidden", "Profiles require a regular Aux window");
+    return;
+  }
+  if (method == "browserProfiles") {
+    if (!args.empty()) {
+      Fail(std::move(callback), "invalid_argument", "Unexpected Profile arguments");
+      return;
+    }
+    Succeed(std::move(callback), base::Value(ListProfiles(manager, current)));
+    return;
+  }
+  if (method == "createBrowserProfile") {
+    if (args.size() != 1 || !args[0].is_string()) {
+      Fail(std::move(callback), "invalid_argument", "Invalid Profile name");
+      return;
+    }
+    const auto name = ProfileName(args[0].GetString());
+    if (!name) {
+      Fail(std::move(callback), "invalid_argument", "Profile name must be 1–60 visible characters");
+      return;
+    }
+    ProfileManager::CreateMultiProfileAsync(
+        *name, /*icon_index=*/0, /*is_hidden=*/false,
+        base::BindOnce(
+            [](base::WeakPtr<WebUIBrowserUI> ui, Reply callback,
+               Profile* created) {
+              if (!ui) return;
+              if (!created || !g_browser_process ||
+                  !g_browser_process->profile_manager()) {
+                Fail(std::move(callback), "backend_unavailable",
+                     "Profile could not be created");
+                return;
+              }
+              auto* entry = g_browser_process->profile_manager()
+                                ->GetProfileAttributesStorage()
+                                .GetProfileAttributesWithPath(created->GetPath());
+              if (!entry || !ListedProfile(entry, ui->browser()->GetProfile())) {
+                Fail(std::move(callback), "internal", "Created Profile was not registered");
+                return;
+              }
+              Succeed(std::move(callback),
+                      base::Value(Describe(entry, ui->browser()->GetProfile())));
+            },
+            GetWeakPtr(), std::move(callback)));
+    return;
+  }
+  if (args.empty() || !args[0].is_string()) {
+    Fail(std::move(callback), "invalid_argument", "Invalid Profile identity");
+    return;
+  }
+  const std::string id = args[0].GetString();
+  auto* entry = FindProfile(manager, current, id);
+  if (!entry) {
+    Fail(std::move(callback), "not_found", "Profile was not found");
+    return;
+  }
+  if (method == "renameBrowserProfile") {
+    if (args.size() != 2 || !args[1].is_string()) {
+      Fail(std::move(callback), "invalid_argument", "Invalid Profile name");
+      return;
+    }
+    const auto name = ProfileName(args[1].GetString());
+    if (!name) {
+      Fail(std::move(callback), "invalid_argument", "Profile name must be 1–60 visible characters");
+      return;
+    }
+    entry->SetLocalProfileName(*name, /*is_default_name=*/false);
+    Succeed(std::move(callback), base::Value(ListProfiles(manager, current)));
+    return;
+  }
+  if (method == "archiveBrowserProfile") {
+    if (args.size() != 2 || !args[1].is_bool()) {
+      Fail(std::move(callback), "invalid_argument", "Invalid archive state");
+      return;
+    }
+    if (entry->GetPath() == current->GetPath() || id == "default") {
+      Fail(std::move(callback), "forbidden", "Current and default Profiles cannot be archived");
+      return;
+    }
+    ScopedDictPrefUpdate archived(g_browser_process->local_state(),
+                                  aux::kArchivedProfilesPref);
+    if (args[1].GetBool()) archived->Set(id, true);
+    else archived->Remove(id);
+    Succeed(std::move(callback), base::Value(ListProfiles(manager, current)));
+    return;
+  }
+  if (method == "deleteBrowserProfile") {
+    if (args.size() != 1 || entry->GetPath() == current->GetPath() ||
+        id == "default") {
+      Fail(std::move(callback), "forbidden", "Current and default Profiles cannot be deleted");
+      return;
+    }
+    Profile* loaded = manager->GetProfileByPath(entry->GetPath());
+    auto* windows = loaded ? ProfileBrowserCollection::GetForProfile(loaded)
+                           : nullptr;
+    if (windows && (windows->GetSize() || windows->GetOffTheRecordBrowserCount())) {
+      Fail(std::move(callback), "conflict", "Close the Profile’s windows before deleting it");
+      return;
+    }
+    const base::FilePath path = entry->GetPath();
+    profiles::SetLastUsedProfile(current->GetPath().BaseName());
+    manager->GetDeleteProfileHelper().MaybeScheduleProfileForDeletion(
+        path, base::BindOnce([](Profile*) {}),
+        ProfileMetrics::DELETE_PROFILE_SETTINGS);
+    AwaitRemoval(GetWeakPtr(), path, std::move(callback), 0);
+    return;
+  }
+  if (method == "openBrowserProfile" || method == "openBrowserProfileUrl") {
+    if ((method == "openBrowserProfile" && args.size() != 1) ||
+        (method == "openBrowserProfileUrl" &&
+         (args.size() != 2 || !args[1].is_string() ||
+          !ValidWebUrl(args[1].GetString())))) {
+      Fail(std::move(callback), "invalid_argument", "Invalid Profile page URL");
+      return;
+    }
+    if (Archived(id) || entry->IsSigninRequired()) {
+      Fail(std::move(callback), "forbidden", "Profile is archived or locked");
+      return;
+    }
+    std::optional<GURL> url;
+    if (method == "openBrowserProfileUrl") url = GURL(args[1].GetString());
+    manager->CreateProfileAsync(
+        entry->GetPath(),
+        base::BindOnce(&OpenLoadedProfile, std::move(callback), std::move(url)));
+    return;
+  }
+  Fail(std::move(callback), "not_found", "Unsupported Profile operation");
+}
