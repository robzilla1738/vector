+bool HttpUrl(const base::Value* value) {
+  if (!Text(value, 8192)) return false;
+  const std::string& text = value->GetString();
+  const GURL url(text);
+  return (text.starts_with("https://") || text.starts_with("http://")) &&
+         url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
