+bool LiveFolder(const base::Value* value) {
+  const base::DictValue* live = value ? value->GetIfDict() : nullptr;
+  if (!live || !HasOnly(*live, {"kind", "config", "refreshMinutes"})) return false;
+  const std::string* kind = live->FindString("kind");
+  const base::DictValue* config = live->FindDict("config");
+  const std::optional<double> refresh = live->FindDouble("refreshMinutes");
+  if (!kind || !config || !refresh || !std::isfinite(*refresh) ||
+      std::floor(*refresh) != *refresh || *refresh < 1 || *refresh > 1440) return false;
+  if (*kind == "github") {
+    if (!HasOnly(*config, {"connectionId", "source", "query"}) ||
+        !Id(config->Find("connectionId"))) return false;
+    const std::string* source = config->FindString("source");
+    const base::Value* query = config->Find("query");
+    return source && (*source == "awaiting-review" || *source == "open-prs" ||
+                      *source == "assigned-issues" || *source == "query") &&
+           (!query || Text(query, 1000)) && (*source != "query" || query);
+  }
+  if (*kind == "calendar") {
+    return HasOnly(*config, {"connectionId"}) && Id(config->Find("connectionId"));
+  }
+  if (*kind == "rss") {
+    return HasOnly(*config, {"url"}) && HttpUrl(config->Find("url"));
+  }
+  if (*kind == "routine") {
+    return HasOnly(*config, {"routineId"}) && Id(config->Find("routineId"));
+  }
+  return false;
+}
