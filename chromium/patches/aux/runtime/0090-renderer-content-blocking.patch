+// Renderer-created subresources do not pass through the browser's
+// CreateURLLoaderThrottles hook. Keep a browser-process gate on their factory
+// so Profile rule changes also apply to already-open tabs.
+class BlockingProxyFactory final : public network::SelfDeletingURLLoaderFactory {
+ public:
+  BlockingProxyFactory(
+      mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver,
+      mojo::PendingRemote<network::mojom::URLLoaderFactory> target,
+      base::WeakPtr<ContentBlockingController> blocker,
+      base::SelfDeletingPassKey pass_key)
+      : network::SelfDeletingURLLoaderFactory(std::move(receiver), pass_key),
+        blocker_(std::move(blocker)) {
+    target_.Bind(std::move(target));
+    target_.set_disconnect_handler(base::BindOnce(
+        &BlockingProxyFactory::OnTargetError, base::Unretained(this)));
+  }
+
+  void CreateLoaderAndStart(
+      mojo::PendingReceiver<network::mojom::URLLoader> loader_receiver,
+      int32_t request_id,
+      uint32_t options,
+      const network::ResourceRequest& request,
+      mojo::PendingRemote<network::mojom::URLLoaderClient> client,
+      const net::MutableNetworkTrafficAnnotationTag& traffic_annotation)
+      override {
+    if (blocker_ && blocker_->ShouldBlockNetworkRequest(request)) {
+      mojo::Remote<network::mojom::URLLoaderClient> blocked_client(
+          std::move(client));
+      blocked_client->OnComplete(
+          network::URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+    auto guard = std::make_unique<BlockingRequest>(
+        std::move(loader_receiver), std::move(client), blocker_,
+        TopSiteHost(request));
+    auto target_loader = guard->BindTargetLoader();
+    mojo::PendingRemote<network::mojom::URLLoaderClient> target_client;
+    mojo::MakeSelfOwnedReceiver(
+        std::move(guard), target_client.InitWithNewPipeAndPassReceiver());
+    target_->CreateLoaderAndStart(std::move(target_loader), request_id, options,
+                                  request, std::move(target_client),
+                                  traffic_annotation);
+  }
+
+ private:
+  ~BlockingProxyFactory() override = default;
+  void OnTargetError() { DisconnectReceiversAndDestroy(); }
+
+  mojo::Remote<network::mojom::URLLoaderFactory> target_;
+  base::WeakPtr<ContentBlockingController> blocker_;
+};
