+bool ContentBlockingController::ShouldBlockNetworkRequest(
+    const network::ResourceRequest& request) {
+  return ShouldBlockURL(request.url, TopSiteHost(request));
+}
+
+bool ContentBlockingController::ShouldBlockURL(
+    const GURL& url, std::string_view top_site_host) {
+  SyncPrivateRules();
+  // This proxy is installed only on subresource factories. The request's
+  // is_outermost_main_frame flag describes its owning frame, not its type.
+  if (!ShouldBlockSubresource(url, top_site_host,
+                              /*main_frame=*/false,
+                              rules_->enabled, rules_->blocked,
+                              rules_->allowed)) {
+    return false;
+  }
+  NoteBlocked(std::string(top_site_host));
+  return true;
+}
