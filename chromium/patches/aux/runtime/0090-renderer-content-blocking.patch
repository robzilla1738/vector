+void ContentBlockingController::MaybeProxySubresourceFactory(
+    Profile* profile, network::URLLoaderFactoryBuilder& factory_builder) {
+  auto* blocker = ForProfile(profile);
+  if (!blocker) {
+    return;
+  }
+  auto [receiver, target] = factory_builder.Append();
+  base::MakeSelfDeleting<BlockingProxyFactory>(
+      std::move(receiver), std::move(target),
+      blocker->weak_factory_.GetWeakPtr());
 }
 
