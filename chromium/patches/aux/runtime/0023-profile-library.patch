+void ProfileLibrary::NotifyBookmarks() {
+  if (!runtime_available_ || bookmark_note_pending_) {
+    return;
+  }
+  bookmark_note_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self) {
+            if (!self) {
+              return;
+            }
+            self->bookmark_note_pending_ = false;
+            if (self->runtime_available_ && self->changed_) {
+              self->changed_.Run();
+            }
+          },
+          weak_factory_.GetWeakPtr()),
+      base::Milliseconds(50));
+}
