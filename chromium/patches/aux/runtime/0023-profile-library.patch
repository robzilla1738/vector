+base::Value::Dict
+ProfileLibrary::BookmarkCall(const std::string &method,
+                             const base::Value::Dict &params) {
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return Fault("backend_unavailable", "Chromium bookmarks are still loading");
+  }
+  if (method == "bookmarks.list") {
+    return Result(base::Value(ListBookmarks()));
+  }
+  if (method == "bookmarks.folders.list") {
+    return Result(base::Value(ListFolders()));
+  }
+
+  if (method == "bookmarks.folders.create" ||
+      method == "bookmarks.folders.rename" ||
+      method == "bookmarks.folders.remove") {
+    const base::Value::List *path = params.FindList("path");
+    if (!path || path->empty() || path->size() > 32) {
+      return Fault("invalid_argument", "Choose a bookmark folder");
+    }
+    if (method == "bookmarks.folders.create") {
+      if (FindFolder(*path, false)) {
+        return Fault("conflict", "That folder already exists");
+      }
+      base::Value::List parent_path = path->Clone();
+      const std::string *name = parent_path.back().GetIfString();
+      if (!name || name->empty() || name->size() > 200) {
+        return Fault("invalid_argument", "Invalid folder name");
+      }
+      const std::string title = *name;
+      parent_path.erase(parent_path.end() - 1);
+      const bookmarks::BookmarkNode *parent = FindFolder(parent_path, false);
+      if (!parent) {
+        return Fault("not_found", "Parent folder no longer exists");
+      }
+      bookmarks_->AddFolder(parent, parent->children().size(),
+                            base::UTF8ToUTF16(title));
+    } else {
+      const bookmarks::BookmarkNode *folder = FindFolder(*path, false);
+      if (!folder || bookmarks_->is_permanent_node(folder)) {
+        return Fault("not_found", "Folder no longer exists");
+      }
+      if (method == "bookmarks.folders.rename") {
+        const std::string *name = params.FindString("name");
+        if (!name || name->empty() || name->size() > 200) {
+          return Fault("invalid_argument", "Invalid folder name");
+        }
+        for (const auto &sibling : folder->parent()->children()) {
+          if (sibling.get() != folder && sibling->is_folder() &&
+              sibling->GetTitle() == base::UTF8ToUTF16(*name)) {
+            return Fault("conflict", "That folder already exists");
+          }
+        }
+        bookmarks_->SetTitle(folder, base::UTF8ToUTF16(*name),
+                             bookmarks::metrics::BookmarkEditSource::kUser);
+      } else {
+        if (!folder->children().empty()) {
+          return Fault("conflict", "Remove the folder's bookmarks first");
+        }
+        bookmarks_->Remove(
+            folder, bookmarks::metrics::BookmarkEditSource::kUser, FROM_HERE);
+      }
+    }
+    return Result(base::Value(ListFolders()));
+  }
+
+  if (method == "bookmarks.add" || method == "bookmarks.readingList") {
+    const std::string *url = params.FindString("url");
+    if (!url || !ValidWebUrl(*url)) {
+      return Fault("invalid_argument", "Invalid bookmark address");
+    }
+    const bookmarks::BookmarkNode *node =
+        params.FindBool("forceNew").value_or(false) && method == "bookmarks.add"
+            ? nullptr
+            : FindBookmark(params, "url");
+    if (!node) {
+      if (method == "bookmarks.readingList" &&
+          !params.FindBool("readingList").value_or(false)) {
+        return Okay();
+      }
+      const std::string *title = params.FindString("title");
+      if (!title || title->size() > 1000) {
+        return Fault("invalid_argument", "A title is required");
+      }
+      const base::Value::List *path = params.FindList("folderPath");
+      const bookmarks::BookmarkNode *folder =
+          path ? FindFolder(*path, true) : bookmarks_->bookmark_bar_node();
+      if (!folder) {
+        return Fault("invalid_argument", "Invalid bookmark folder");
+      }
+      node = bookmarks_->AddNewURL(folder, folder->children().size(),
+                                   base::UTF8ToUTF16(*title), GURL(*url));
+    } else if (method == "bookmarks.add") {
+      if (const std::string *title = params.FindString("title")) {
+        bookmarks_->SetTitle(node, base::UTF8ToUTF16(*title),
+                             bookmarks::metrics::BookmarkEditSource::kUser);
+      }
+      if (const base::Value::List *path = params.FindList("folderPath")) {
+        const bookmarks::BookmarkNode *folder = FindFolder(*path, true);
+        if (!folder) {
+          return Fault("invalid_argument", "Invalid bookmark folder");
+        }
+        if (folder != node->parent()) {
+          bookmarks_->Move(node, folder, folder->children().size());
+        }
+      }
+    }
+    if (std::optional<bool> reading = params.FindBool("readingList")) {
+      bookmarks_->SetNodeMetaInfo(node, kReadingListKey, *reading ? "1" : "0");
+      if (!*reading) {
+        bookmarks_->DeleteNodeMetaInfo(node, kReadAtKey);
+      }
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.markRead") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "url");
+    std::string reading;
+    if (!node || !node->GetMetaInfo(kReadingListKey, &reading) ||
+        reading != "1") {
+      return Fault("not_found", "This page is not on the reading list");
+    }
+    if (params.FindBool("read").value_or(false)) {
+      bookmarks_->SetNodeMetaInfo(
+          node, kReadAtKey,
+          base::NumberToString(
+              base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    } else {
+      bookmarks_->DeleteNodeMetaInfo(node, kReadAtKey);
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.remove") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "url");
+    if (node) {
+      bookmarks_->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                         FROM_HERE);
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.update") {
+    const bookmarks::BookmarkNode *node = FindBookmark(params, "originalUrl");
+    if (!node) {
+      return Fault("not_found", "This bookmark was removed");
+    }
+    const base::Value::Dict *expected = params.FindDict("expected");
+    const std::string *title = params.FindString("title");
+    const std::string *url = params.FindString("url");
+    const base::Value::List *path = params.FindList("folderPath");
+    if (!expected || !title || title->empty() || title->size() > 1000 || !url ||
+        !ValidWebUrl(*url)) {
+      return Fault("invalid_argument", "Invalid bookmark edit");
+    }
+    const std::string *old_title = expected->FindString("title");
+    const base::Value::List *old_path = expected->FindList("folderPath");
+    if (!old_title || base::UTF16ToUTF8(node->GetTitle()) != *old_title ||
+        (old_path && FolderPath(node) != *old_path)) {
+      return Fault("conflict", "Bookmark changed in another window");
+    }
+    const bookmarks::BookmarkNode *folder =
+        path ? FindFolder(*path, false) : node->parent();
+    if (!folder) {
+      return Fault("not_found", "Destination folder no longer exists");
+    }
+    if (node->url().spec() != *url) {
+      for (const auto &duplicate : bookmarks_->GetNodesByURL(GURL(*url))) {
+        if (duplicate != node) {
+          return Fault("conflict", "That address is already bookmarked");
+        }
+      }
+    }
+    bookmarks_->SetTitle(node, base::UTF8ToUTF16(*title),
+                         bookmarks::metrics::BookmarkEditSource::kUser);
+    if (node->url().spec() != *url) {
+      bookmarks_->SetURL(node, GURL(*url),
+                         bookmarks::metrics::BookmarkEditSource::kUser);
+    }
+    if (folder != node->parent()) {
+      bookmarks_->Move(node, folder, folder->children().size());
+    }
+    return Okay();
+  }
+
+  if (method == "bookmarks.move") {
+    const base::Value::List *selections = params.FindList("bookmarks");
+    const base::Value::List *path = params.FindList("folderPath");
+    if (!selections || !path || selections->empty() ||
+        selections->size() > 10000) {
+      return Fault("invalid_argument", "Invalid bookmark selection");
+    }
+    std::vector<const bookmarks::BookmarkNode *> nodes;
+    nodes.reserve(selections->size());
+    for (const base::Value &item : *selections) {
+      const base::Value::Dict *entry = item.GetIfDict();
+      const bookmarks::BookmarkNode *node =
+          entry ? FindBookmark(*entry, "url") : nullptr;
+      const base::Value::List *expected =
+          entry ? entry->FindList("folderPath") : nullptr;
+      if (!node || !expected || FolderPath(node) != *expected) {
+        return Fault("conflict", "A selected bookmark moved or was removed");
+      }
+      nodes.push_back(node);
+    }
+    const bool create = params.FindBool("createFolder").value_or(false);
+    if (create && FindFolder(*path, false)) {
+      return Fault("conflict", "That destination folder already exists");
+    }
+    const bookmarks::BookmarkNode *folder = FindFolder(*path, create);
+    if (!folder) {
+      return Fault("not_found", "Destination folder no longer exists");
+    }
+    int moved = 0;
+    for (const bookmarks::BookmarkNode *node : nodes) {
+      if (node->parent() != folder) {
+        bookmarks_->Move(node, folder, folder->children().size());
+        ++moved;
+      }
+    }
+    base::Value::Dict result;
+    result.Set("moved", moved);
+    return Result(base::Value(std::move(result)));
+  }
+
+  if (method == "bookmarks.import" || method == "bookmarks.saveFolder") {
+    const base::Value::List *items = params.FindList("bookmarks");
+    if (!items || items->size() > 10000) {
+      return Fault("invalid_argument", "Invalid bookmark import");
+    }
+    base::Value::List folder_prefix;
+    if (method == "bookmarks.saveFolder") {
+      const std::string *name = params.FindString("name");
+      if (!name || name->empty() || name->size() > 200) {
+        return Fault("invalid_argument", "Invalid folder name");
+      }
+      folder_prefix.Append(*name);
+      if (FindFolder(folder_prefix, false)) {
+        return Fault("conflict", "That folder already exists");
+      }
+    }
+    if (const base::Value::List *folders = params.FindList("folders")) {
+      for (const base::Value &value : *folders) {
+        const base::Value::List *path = value.GetIfList();
+        if (!path || !FindFolder(*path, true)) {
+          return Fault("invalid_argument", "Invalid imported folder");
+        }
+      }
+    }
+    int added = 0;
+    for (const base::Value &value : *items) {
+      const base::Value::Dict *entry = value.GetIfDict();
+      if (!entry) {
+        return Fault("invalid_argument", "Invalid bookmark entry");
+      }
+      const std::string *url = entry->FindString("url");
+      const std::string *title = entry->FindString("title");
+      if (!url || !ValidWebUrl(*url) || !title || title->size() > 1000) {
+        return Fault("invalid_argument", "Invalid bookmark entry");
+      }
+      if (!bookmarks_->GetNodesByURL(GURL(*url)).empty()) {
+        continue;
+      }
+      const base::Value::List *path = entry->FindList("folderPath");
+      const bookmarks::BookmarkNode *folder =
+          method == "bookmarks.saveFolder" ? FindFolder(folder_prefix, true)
+          : path                           ? FindFolder(*path, true)
+                                           : bookmarks_->bookmark_bar_node();
+      if (!folder) {
+        return Fault("invalid_argument", "Invalid imported folder");
+      }
+      bookmarks_->AddNewURL(folder, folder->children().size(),
+                            base::UTF8ToUTF16(*title), GURL(*url));
+      ++added;
+    }
+    base::Value::Dict result;
+    result.Set("added", added);
+    result.Set("skipped", static_cast<int>(items->size()) - added);
+    return Result(base::Value(std::move(result)));
+  }
+  return Fault("not_found", "Unsupported Chromium bookmark method");
+}
+
+void ProfileLibrary::ClearHistory(
+    const base::Value::Dict &params,
+    base::OnceCallback<void(base::Value::Dict)> callback) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const std::optional<double> since = params.FindDouble("since");
+  const std::optional<double> before = params.FindDouble("before");
+  if ((since && (*since < 0 || !std::isfinite(*since))) ||
+      (before && (*before < 0 || !std::isfinite(*before)))) {
+    std::move(callback).Run(Fault("invalid_argument", "Invalid history range"));
+    return;
+  }
+  const base::Time begin = since ? base::Time::FromMillisecondsSinceUnixEpoch(
+                                       static_cast<int64_t>(*since))
+                                 : base::Time();
+  const base::Time end = before ? base::Time::FromMillisecondsSinceUnixEpoch(
+                                      static_cast<int64_t>(*before))
+                                : base::Time();
+  history::QueryOptions options;
+  options.begin_time = begin;
+  options.end_time = end;
+  options.duplicate_policy = history::QueryOptions::KEEP_ALL_DUPLICATES;
+  options.policy_for_404_visits = history::VisitQuery404sPolicy::kInclude404s;
+  history_->QueryHistory(
+      u"", options,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self, base::Time begin,
+             base::Time end,
+             base::OnceCallback<void(base::Value::Dict)> callback,
+             history::QueryResults rows) {
+            if (!self || !self->history_) {
+              std::move(callback).Run(
+                  Fault("backend_unavailable", "HistoryService closed"));
+              return;
+            }
+            const int count = static_cast<int>(rows.size());
+            self->history_->ExpireHistoryBetween(
+                {}, std::nullopt, begin, end, true,
+                base::BindOnce(
+                    [](base::OnceCallback<void(base::Value::Dict)> callback,
+                       int count) {
+                      base::Value::Dict result;
+                      result.Set("removed", count);
+                      std::move(callback).Run(
+                          Result(base::Value(std::move(result))));
+                    },
+                    std::move(callback), count),
+                &self->tracker_);
+          },
+          weak_factory_.GetWeakPtr(), begin, end, std::move(callback)),
+      &tracker_);
+}
+
+void ProfileLibrary::RemoveVisit(
+    const base::Value::Dict &params,
+    base::OnceCallback<void(base::Value::Dict)> callback) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const std::string *url = params.FindString("url");
+  const std::optional<double> at = params.FindDouble("visitedAt");
+  if (!url || !ValidWebUrl(*url) || !at || !std::isfinite(*at) || *at < 0) {
+    std::move(callback).Run(Fault("invalid_argument", "Invalid history visit"));
+    return;
+  }
+  const base::Time begin =
+      base::Time::FromMillisecondsSinceUnixEpoch(static_cast<int64_t>(*at));
+  const base::Time end = begin + base::Milliseconds(1);
+  history::QueryOptions options;
+  options.begin_time = begin;
+  options.end_time = end;
+  options.duplicate_policy = history::QueryOptions::KEEP_ALL_DUPLICATES;
+  options.policy_for_404_visits = history::VisitQuery404sPolicy::kInclude404s;
+  history_->QueryHistory(
+      u"", options,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self, GURL url, base::Time begin,
+             base::Time end,
+             base::OnceCallback<void(base::Value::Dict)> callback,
+             history::QueryResults rows) {
+            if (!self || !self->history_) {
+              std::move(callback).Run(
+                  Fault("backend_unavailable", "HistoryService closed"));
+              return;
+            }
+            const bool found = std::any_of(
+                rows.begin(), rows.end(), [&](const history::URLResult &row) {
+                  return row.url() == url && row.visit_time() == begin;
+                });
+            if (!found) {
+              base::Value::Dict result;
+              result.Set("removed", false);
+              std::move(callback).Run(Result(base::Value(std::move(result))));
+              return;
+            }
+            self->history_->ExpireHistoryBetween(
+                {url}, std::nullopt, begin, end, true,
+                base::BindOnce(
+                    [](base::OnceCallback<void(base::Value::Dict)> callback) {
+                      base::Value::Dict result;
+                      result.Set("removed", true);
+                      std::move(callback).Run(
+                          Result(base::Value(std::move(result))));
+                    },
+                    std::move(callback)),
+                &self->tracker_);
+          },
+          weak_factory_.GetWeakPtr(), GURL(*url), begin, end,
+          std::move(callback)),
+      &tracker_);
+}
