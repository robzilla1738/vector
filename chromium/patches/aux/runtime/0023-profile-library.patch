+// Profile-owned Chromium data adapter. History is projected into runtime FTS;
+// bookmarks are served directly from BookmarkModel. No timer or second writable
+// bookmark tree exists in the Chromium host.
+class ProfileLibrary final : public history::HistoryServiceObserver,
+                             public bookmarks::BookmarkModelObserver {
+public:
+  using RuntimeCall = base::RepeatingCallback<void(
+      std::string, std::string, base::OnceCallback<void(bool)>)>;
+  ProfileLibrary(Profile *profile, RuntimeCall call,
+                 base::RepeatingClosure changed);
+  ~ProfileLibrary() override;
+
+  void OnRuntimeAvailable();
+  void OnRuntimeDisconnected();
+  base::Value::Dict BookmarkCall(const std::string &method,
+                                 const base::Value::Dict &params);
+  void ClearHistory(const base::Value::Dict &params,
+                    base::OnceCallback<void(base::Value::Dict)> callback);
+  void RemoveVisit(const base::Value::Dict &params,
+                   base::OnceCallback<void(base::Value::Dict)> callback);
+
+  // history::HistoryServiceObserver:
+  void OnURLVisited(history::HistoryService *,
+                    const history::VisitedURLInfo &) override;
+  void OnURLsModified(history::HistoryService *,
+                      const history::URLRows &) override;
+  void OnHistoryDeletions(history::HistoryService *,
+                          const history::DeletionInfo &) override;
+  void OnHistoryServiceLoaded(history::HistoryService *) override;
+  void HistoryServiceBeingDeleted(history::HistoryService *) override;
+
+  // bookmarks::BookmarkModelObserver:
+  void BookmarkModelLoaded(bool ids_reassigned) override;
+  void BookmarkModelBeingDeleted() override;
+  void BookmarkNodeMoved(const bookmarks::BookmarkNode *, size_t,
+                         const bookmarks::BookmarkNode *, size_t) override;
+  void BookmarkNodeAdded(const bookmarks::BookmarkNode *, size_t,
+                         bool) override;
+  void BookmarkNodeRemoved(const bookmarks::BookmarkNode *, size_t,
+                           const bookmarks::BookmarkNode *,
+                           const std::set<GURL> &,
+                           const base::Location &) override;
+  void BookmarkNodeChanged(const bookmarks::BookmarkNode *) override;
+  void BookmarkMetaInfoChanged(const bookmarks::BookmarkNode *) override;
+  void BookmarkNodeFaviconChanged(const bookmarks::BookmarkNode *) override;
+  void BookmarkNodeChildrenReordered(const bookmarks::BookmarkNode *) override;
+  void BookmarkAllUserNodesRemoved(const std::set<GURL> &,
+                                   const base::Location &) override;
+
+private:
+  struct Visit {
+    std::string url;
+    std::string title;
+    int64_t visited_at;
+  };
+  void RefreshHistory();
+  void OnHistoryQuery(history::QueryResults results);
+  void SendSnapshotBatch(size_t offset, size_t batch_index);
+  void EnqueueDelta(base::Value::Dict delta);
+  void FlushDelta();
+  void NotifyBookmarks();
+  base::Value::List ListBookmarks() const;
+  base::Value::List ListFolders() const;
+  const bookmarks::BookmarkNode *FindFolder(const base::Value::List &path,
+                                            bool create);
+  const bookmarks::BookmarkNode *FindBookmark(const base::Value::Dict &params,
+                                              const std::string &url_key) const;
+  base::Value::List FolderPath(const bookmarks::BookmarkNode *node) const;
+  std::vector<std::pair<const bookmarks::BookmarkNode *, std::string>>
+  RootAliases() const;
+
+  raw_ptr<Profile> profile_;
+  raw_ptr<history::HistoryService> history_ = nullptr;
+  raw_ptr<bookmarks::BookmarkModel> bookmarks_ = nullptr;
+  RuntimeCall call_;
+  base::RepeatingClosure changed_;
+  base::CancelableTaskTracker tracker_;
+  bool runtime_available_ = false;
+  bool snapshotting_ = false;
+  bool history_ready_ = false;
+  bool history_dirty_ = false;
+  bool delta_in_flight_ = false;
+  bool bookmark_note_pending_ = false;
+  std::string generation_;
+  uint64_t sequence_ = 0;
+  std::vector<Visit> snapshot_visits_;
+  std::deque<base::Value::Dict> pending_deltas_;
+  base::WeakPtrFactory<ProfileLibrary> weak_factory_{this};
+};
