+const bookmarks::BookmarkNode *
+ProfileLibrary::FindFolder(const base::Value::List &path, bool create) {
+  if (!bookmarks_ || !bookmarks_->loaded() || path.size() > 32) {
+    return nullptr;
+  }
+  const bookmarks::BookmarkNode *node = bookmarks_->bookmark_bar_node();
+  size_t offset = 0;
+  if (!path.empty() && path.front().is_string()) {
+    const std::string &first = path.front().GetString();
+    for (const auto &[root, name] : RootAliases()) {
+      if (first == name) {
+        node = root;
+        offset = 1;
+        break;
+      }
+    }
+  }
+  if (!node) {
+    return nullptr;
+  }
+  for (size_t index = offset; index < path.size(); ++index) {
+    if (!IsFolderName(path[index])) {
+      return nullptr;
+    }
+    const std::u16string title = base::UTF8ToUTF16(path[index].GetString());
+    const bookmarks::BookmarkNode *found = nullptr;
+    for (const auto &child : node->children()) {
+      if (child->is_folder() && child->GetTitle() == title) {
+        found = child.get();
+        break;
+      }
+    }
+    if (!found && create) {
+      found = bookmarks_->AddFolder(node, node->children().size(), title);
+    }
+    if (!found) {
+      return nullptr;
+    }
+    node = found;
+  }
+  return node;
+}
+
+const bookmarks::BookmarkNode *
+ProfileLibrary::FindBookmark(const base::Value::Dict &params,
+                             const std::string &url_key) const {
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return nullptr;
+  }
+  const std::string *node_id = params.FindString("nodeId");
+  const std::string *url = params.FindString(url_key);
+  if (!url || !ValidWebUrl(*url)) {
+    return nullptr;
+  }
+  const auto candidates = bookmarks_->GetNodesByURL(GURL(*url));
+  if (node_id) {
+    int64_t id = 0;
+    if (!base::StringToInt64(*node_id, &id)) {
+      return nullptr;
+    }
+    for (const auto &candidate : candidates) {
+      if (candidate->id() == id) {
+        return candidate;
+      }
+    }
+    return nullptr;
+  }
+  // Legacy callers identify a bookmark by URL. Prefer the most recent user
+  // node; explicit Library edits carry nodeId and never affect another copy.
+  return bookmarks_->GetMostRecentlyAddedUserNodeForURL(GURL(*url));
+}
+
+base::Value::List
+ProfileLibrary::FolderPath(const bookmarks::BookmarkNode *node) const {
+  std::vector<std::string> names;
+  const bookmarks::BookmarkNode *parent = node->parent();
+  while (parent && !bookmarks_->is_permanent_node(parent)) {
+    names.push_back(base::UTF16ToUTF8(parent->GetTitle()));
+    parent = parent->parent();
+  }
+  for (const auto &[root, name] : RootAliases()) {
+    if (parent == root) {
+      names.push_back(name);
+      break;
+    }
+  }
+  base::Value::List path;
+  for (auto it = names.rbegin(); it != names.rend(); ++it) {
+    path.Append(*it);
+  }
+  return path;
+}
