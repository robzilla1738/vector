+base::Value::Dict Fault(std::string code, std::string message) {
+  base::Value::Dict error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::Value::Dict reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+
+base::Value::Dict Result(base::Value value) {
+  base::Value::Dict reply;
+  reply.Set("result", std::move(value));
+  return reply;
+}
+
+base::Value::Dict Okay() {
+  base::Value::Dict result;
+  result.Set("ok", true);
+  return Result(base::Value(std::move(result)));
+}
+
+bool ValidWebUrl(const std::string &text) {
+  const GURL url(text);
+  return text.size() <= 8192 && url.is_valid() && url.SchemeIsHTTPOrHTTPS() &&
+         !url.has_username() && !url.has_password();
+}
+
+base::Value::Dict VisitValue(const std::string &url, const std::string &title,
+                             int64_t visited_at) {
+  base::Value::Dict visit;
+  visit.Set("url", url);
+  visit.Set("title", title);
+  visit.Set("visitedAt", static_cast<double>(visited_at));
+  return visit;
+}
+
+bool IsFolderName(const base::Value &value) {
+  const std::string *name = value.GetIfString();
+  return name && !name->empty() && name->size() <= 200;
+}
