+std::vector<std::pair<const bookmarks::BookmarkNode *, std::string>>
+ProfileLibrary::RootAliases() const {
+  std::vector<std::pair<const bookmarks::BookmarkNode *, std::string>> roots;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return roots;
+  }
+  std::set<std::string> used;
+  for (const auto &child : bookmarks_->bookmark_bar_node()->children()) {
+    if (child->is_folder()) {
+      used.insert(base::UTF16ToUTF8(child->GetTitle()));
+    }
+  }
+  auto add = [&](const bookmarks::BookmarkNode *root,
+                 const std::string &preferred) {
+    if (!root) {
+      return;
+    }
+    std::string label = preferred;
+    for (int suffix = 2; used.contains(label); ++suffix) {
+      label = preferred + " (" + base::NumberToString(suffix) + ")";
+    }
+    used.insert(label);
+    roots.emplace_back(root, std::move(label));
+  };
+  add(bookmarks_->other_node(), "Other bookmarks");
+  add(bookmarks_->mobile_node(), "Mobile bookmarks");
+  add(bookmarks_->account_bookmark_bar_node(), "Account bookmarks");
+  add(bookmarks_->account_other_node(), "Account other bookmarks");
+  add(bookmarks_->account_mobile_node(), "Account mobile bookmarks");
+  return roots;
+}
+
+base::Value::List ProfileLibrary::ListBookmarks() const {
+  base::Value::List result;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return result;
+  }
+  auto walk = [&](auto &&self, const bookmarks::BookmarkNode *node,
+                  const base::Value::List &path) -> void {
+    for (const auto &child : node->children()) {
+      if (child->is_folder()) {
+        base::Value::List next = path.Clone();
+        next.Append(base::UTF16ToUTF8(child->GetTitle()));
+        self(self, child.get(), next);
+        continue;
+      }
+      if (!child->url().SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      base::Value::Dict bookmark;
+      bookmark.Set("nodeId", base::NumberToString(child->id()));
+      bookmark.Set("url", child->url().spec());
+      bookmark.Set("title", base::UTF16ToUTF8(child->GetTitle()));
+      bookmark.Set("folderPath", path.Clone());
+      bookmark.Set("createdAt",
+                   static_cast<double>(
+                       child->date_added().InMillisecondsSinceUnixEpoch()));
+      std::string meta;
+      if (child->GetMetaInfo(kReadingListKey, &meta) && meta == "1") {
+        bookmark.Set("readingList", true);
+        if (child->GetMetaInfo(kReadAtKey, &meta)) {
+          int64_t read_at = 0;
+          if (base::StringToInt64(meta, &read_at) && read_at > 0) {
+            bookmark.Set("readAt", static_cast<double>(read_at));
+          }
+        }
+      }
+      result.Append(std::move(bookmark));
+    }
+  };
+  walk(walk, bookmarks_->bookmark_bar_node(), base::Value::List());
+  for (const auto &[root, name] : RootAliases()) {
+    base::Value::List path;
+    path.Append(name);
+    walk(walk, root, path);
+  }
+  return result;
+}
+
+base::Value::List ProfileLibrary::ListFolders() const {
+  base::Value::List result;
+  if (!bookmarks_ || !bookmarks_->loaded()) {
+    return result;
+  }
+  auto walk = [&](auto &&self, const bookmarks::BookmarkNode *node,
+                  const base::Value::List &path) -> void {
+    for (const auto &child : node->children()) {
+      if (!child->is_folder()) {
+        continue;
+      }
+      base::Value::List next = path.Clone();
+      next.Append(base::UTF16ToUTF8(child->GetTitle()));
+      result.Append(next.Clone());
+      self(self, child.get(), next);
+    }
+  };
+  walk(walk, bookmarks_->bookmark_bar_node(), base::Value::List());
+  for (const auto &[root, name] : RootAliases()) {
+    base::Value::List path;
+    path.Append(name);
+    result.Append(path.Clone());
+    walk(walk, root, path);
+  }
+  return result;
+}
