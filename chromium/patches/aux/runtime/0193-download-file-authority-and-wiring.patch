 #include "testing/gtest/include/gtest/gtest.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "chrome/test/base/testing_profile.h"
+#include "content/public/test/browser_task_environment.h"
+#include "components/download/public/common/mock_download_item.h"
+#include "base/time/time.h"
 namespace aux {
 namespace {
 using Result = download::DownloadItem::DownloadRenameResult;
+TEST(DownloadNaming, CompletionIdentityCannotBeReboundAfterReplacement) {
+  content::BrowserTaskEnvironment environment;
+  TestingProfile profile;
+  base::ScopedTempDir directory; ASSERT_TRUE(directory.CreateUniqueTempDir());
+  const auto path = directory.GetPath().AppendASCII("download.txt");
+  const base::FilePath empty_path;
+  const GURL source("http://127.0.0.1/file"), empty_url;
+  const std::string guid = "fixture-download";
+  testing::NiceMock<download::MockDownloadItem> item;
+  ON_CALL(item, GetState()).WillByDefault(testing::Return(download::DownloadItem::COMPLETE));
+  ON_CALL(item, GetInsecureDownloadStatus()).WillByDefault(testing::Return(download::DownloadItem::SAFE));
+  ON_CALL(item, GetGuid()).WillByDefault(testing::ReturnRef(guid));
+  ON_CALL(item, GetURL()).WillByDefault(testing::ReturnRef(source));
+  ON_CALL(item, GetTabReferrerUrl()).WillByDefault(testing::ReturnRef(empty_url));
+  ON_CALL(item, GetTargetFilePath()).WillByDefault(testing::ReturnRef(path));
+  ON_CALL(item, GetForcedFilePath()).WillByDefault(testing::ReturnRef(empty_path));
+  ON_CALL(item, GetEndTime()).WillByDefault(testing::Return(base::Time::Now()));
+  ASSERT_TRUE(base::WriteFile(path, "actual download"));
+  ASSERT_TRUE(RecordDownloadNamingCandidate(&profile, &item));
+  ASSERT_TRUE(DownloadNamingCandidate(&profile, &item));
+  ASSERT_TRUE(base::DeleteFile(path));
+  ASSERT_TRUE(base::WriteFile(path, "different person file"));
+  EXPECT_FALSE(DownloadNamingCandidate(&profile, &item));
+  EXPECT_FALSE(RecordDownloadNamingCandidate(&profile, &item));
+}
