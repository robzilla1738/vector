diff --git a/chrome/browser/ui/aux/native_content_unittest.cc b/chrome/browser/ui/aux/native_content_unittest.cc
new file mode 100644
index 0000000000..b6c806e7e8
--- /dev/null
+++ b/chrome/browser/ui/aux/native_content_unittest.cc
@@ -0,0 +1,89 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <string_view>
+
+#include "base/values.h"
+#include "chrome/browser/ui/aux/cookie_import.h"
+#include "chrome/browser/ui/aux/readable_capture.h"
+#include "net/cookies/canonical_cookie.h"
+#include "net/http/http_response_headers.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+namespace {
+
+base::Value Cookie(std::string domain, bool secure = true) {
+  base::Value::Dict cookie;
+  cookie.Set("name", "session");
+  cookie.Set("value", "opaque");
+  cookie.Set("domain", std::move(domain));
+  cookie.Set("path", "/");
+  cookie.Set("secure", secure);
+  cookie.Set("httpOnly", true);
+  cookie.Set("sameSite", "Lax");
+  return base::Value(std::move(cookie));
+}
+
+TEST(NativeContentTest, CookieImportRequiresSanitizedHostAndPath) {
+  EXPECT_TRUE(ParseImportedCookie(Cookie("example.test")));
+  EXPECT_FALSE(ParseImportedCookie(Cookie("example.test/redirect")));
+  EXPECT_FALSE(ParseImportedCookie(Cookie("https://example.test")));
+  EXPECT_FALSE(ParseImportedCookie(Cookie("")));
+  base::Value invalid = Cookie("example.test");
+  invalid.GetDict().Set("path", "relative");
+  EXPECT_FALSE(ParseImportedCookie(invalid));
+  invalid.GetDict().Set("path", "/?redirect=1");
+  EXPECT_FALSE(ParseImportedCookie(invalid));
+}
+
+TEST(NativeContentTest, RecallRequiresHtmlSuccessWithoutNoStore) {
+  constexpr char kAllowed[] =
+      "HTTP/1.1 200 OK\0Content-Type: text/html; charset=utf-8\0\0";
+  const net::HttpResponseHeaders allowed(
+      std::string_view(kAllowed, sizeof(kAllowed) - 1));
+  EXPECT_TRUE(ReadableResponseAllowed(&allowed));
+  constexpr char kNoStore[] =
+      "HTTP/1.1 200 OK\0Content-Type: text/html\0Cache-Control: private, "
+      "no-store\0\0";
+  const net::HttpResponseHeaders no_store(
+      std::string_view(kNoStore, sizeof(kNoStore) - 1));
+  EXPECT_FALSE(ReadableResponseAllowed(&no_store));
+  constexpr char kJson[] =
+      "HTTP/1.1 200 OK\0Content-Type: application/json\0\0";
+  const net::HttpResponseHeaders json(
+      std::string_view(kJson, sizeof(kJson) - 1));
+  EXPECT_FALSE(ReadableResponseAllowed(&json));
+  constexpr char kError[] =
+      "HTTP/1.1 401 Unauthorized\0Content-Type: text/html\0\0";
+  const net::HttpResponseHeaders error(
+      std::string_view(kError, sizeof(kError) - 1));
+  EXPECT_FALSE(ReadableResponseAllowed(&error));
+}
+
+TEST(NativeContentTest, RecallRequiresActiveOwningWorkspace) {
+  base::Value::Dict space;
+  space.Set("id", "space-1");
+  space.Set("workspaceId", "workspace-1");
+  base::Value::List spaces;
+  spaces.Append(std::move(space));
+  base::Value::Dict shared;
+  shared.Set("spaces", std::move(spaces));
+  base::Value::Dict tab_space;
+  tab_space.Set("page-1", "space-1");
+  base::Value::Dict window;
+  window.Set("activeSpaceId", "space-1");
+  window.Set("tabSpace", std::move(tab_space));
+  base::Value::Dict layout;
+  layout.Set("shared", std::move(shared));
+  layout.Set("window", std::move(window));
+  EXPECT_TRUE(ReadableWorkspaceMatches(layout, "page-1", "workspace-1"));
+  EXPECT_FALSE(ReadableWorkspaceMatches(layout, "page-2", "workspace-1"));
+  EXPECT_FALSE(ReadableWorkspaceMatches(layout, "page-1", "workspace-2"));
+  layout.FindDict("window")->Set("activeSpaceId", "another-space");
+  EXPECT_FALSE(ReadableWorkspaceMatches(layout, "page-1", "workspace-1"));
+}
+
+}  // namespace
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/readable_capture.cc b/chrome/browser/ui/aux/readable_capture.cc
new file mode 100644
index 0000000000..1711972d96
--- /dev/null
+++ b/chrome/browser/ui/aux/readable_capture.cc
@@ -0,0 +1,188 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/readable_capture.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/isolated_world_ids.h"
+#include "net/http/http_response_headers.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+
+constexpr size_t kMaxTextBytes = 64 * 1024;
+constexpr size_t kMaxTitleBytes = 1024;
+constexpr int kCaptureWorld = content::ISOLATED_WORLD_ID_CONTENT_END + 9;
+
+base::Value::Dict Fault(const char* code, const char* message) {
+  base::Value::Dict error;
+  error.Set("code", code);
+  error.Set("message", message);
+  base::Value::Dict reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+
+// Only inert text crosses the browser boundary. The fixed script runs in an
+// isolated world and rejects forms and editable/sensitive documents before
+// reading any content. The browser checks the returned UTF-8 size again.
+constexpr char16_t kExtractScript[] =
+    uR"JS((() => {
+  if (document.visibilityState !== 'visible' || document.readyState === 'loading') return null;
+  if (document.querySelector('input[type="password"], input[autocomplete~="one-time-code"], input[autocomplete^="cc-"], input[autocomplete="current-password"], input[autocomplete="new-password"], [contenteditable="true"], [role="textbox"], meta[http-equiv="Cache-Control"][content*="no-store" i], form[action*="login" i], form[action*="signin" i], form[action*="checkout" i], form[action*="payment" i]')) return null;
+  const source = document.querySelector('article') || document.querySelector('main') || document.body;
+  if (!source || source.querySelectorAll('*').length > 10000) return null;
+  const walker = document.createTreeWalker(source, NodeFilter.SHOW_TEXT);
+  let units = 0;
+  while (walker.nextNode()) {
+    units += walker.currentNode.textContent.length;
+    if (units > 65536) return null;
+  }
+  const copy = source.cloneNode(true);
+  copy.querySelectorAll('script,style,form,input,textarea,button,select,iframe,object,embed,nav,aside,footer,header,[hidden],[aria-hidden="true"]').forEach(node => node.remove());
+  const text = (copy.textContent || '').replace(/\s+/g, ' ').trim();
+  if (!text || text.length > 65536) return null;
+  return {title: document.title.slice(0, 1024), text};
+})())JS";
+
+}  // namespace
+
+bool ReadableResponseAllowed(const net::HttpResponseHeaders* headers) {
+  if (!headers || headers->response_code() < 200 ||
+      headers->response_code() >= 300) {
+    return false;
+  }
+  std::string mime;
+  if (!headers->GetMimeType(&mime) ||
+      !base::EqualsCaseInsensitiveASCII(mime, "text/html")) {
+    return false;
+  }
+  const auto cache = headers->GetNormalizedHeader("cache-control");
+  if (cache &&
+      base::ToLowerASCII(*cache).find("no-store") != std::string::npos) {
+    return false;
+  }
+  return true;
+}
+
+bool ReadableWorkspaceMatches(const base::Value::Dict& layout,
+                              const std::string& page_id,
+                              const std::string& workspace_id) {
+  const base::Value::Dict* window = layout.FindDict("window");
+  const base::Value::Dict* shared = layout.FindDict("shared");
+  const base::Value::Dict* tab_space =
+      window ? window->FindDict("tabSpace") : nullptr;
+  const std::string* space_id =
+      tab_space ? tab_space->FindString(page_id) : nullptr;
+  const std::string* active =
+      window ? window->FindString("activeSpaceId") : nullptr;
+  if (!space_id || !active || *space_id != *active) {
+    return false;
+  }
+  const base::Value::List* spaces =
+      shared ? shared->FindList("spaces") : nullptr;
+  if (!spaces) {
+    return false;
+  }
+  for (const base::Value& value : *spaces) {
+    const base::Value::Dict* space = value.GetIfDict();
+    if (space && space->FindString("id") &&
+        *space->FindString("id") == *space_id &&
+        space->FindString("workspaceId") &&
+        *space->FindString("workspaceId") == workspace_id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ReadableCapture);
+
+ReadableCapture::ReadableCapture(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<ReadableCapture>(*contents) {}
+
+ReadableCapture::~ReadableCapture() = default;
+
+void ReadableCapture::DidFinishNavigation(content::NavigationHandle* nav) {
+  if (!nav->IsInPrimaryMainFrame() || !nav->HasCommitted()) {
+    return;
+  }
+  eligible_url_.clear();
+  document_id_ = 0;
+  const GURL& url = nav->GetURL();
+  if (!url.SchemeIs("https") || url.has_username() || url.has_password() ||
+      !ReadableResponseAllowed(nav->GetResponseHeaders())) {
+    return;
+  }
+  eligible_url_ = url.spec();
+  document_id_ = nav->GetNavigationId();
+}
+
+bool ReadableCapture::Eligible(const std::string& expected_url) const {
+  content::WebContents* contents = web_contents();
+  content::RenderFrameHost* frame =
+      contents ? contents->GetPrimaryMainFrame() : nullptr;
+  return !eligible_url_.empty() && eligible_url_ == expected_url &&
+         contents->GetLastCommittedURL().spec() == expected_url && frame &&
+         frame->GetNavigationId() == document_id_ &&
+         contents->GetVisibility() == content::Visibility::VISIBLE;
+}
+
+void ReadableCapture::Extract(
+    const std::string& expected_url,
+    base::OnceCallback<void(base::Value::Dict)> callback) {
+  if (!Eligible(expected_url)) {
+    std::move(callback).Run(Fault("permission_denied",
+                                  "Page is not eligible for protected recall"));
+    return;
+  }
+  const int64_t document_id = document_id_;
+  web_contents()->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      kExtractScript,
+      base::BindOnce(
+          [](base::WeakPtr<ReadableCapture> self, std::string expected_url,
+             int64_t document_id,
+             base::OnceCallback<void(base::Value::Dict)> callback,
+             base::Value value) {
+            if (!self || self->document_id_ != document_id ||
+                !self->Eligible(expected_url)) {
+              std::move(callback).Run(
+                  Fault("conflict", "Page changed during capture"));
+              return;
+            }
+            const base::Value::Dict* article = value.GetIfDict();
+            const std::string* title =
+                article ? article->FindString("title") : nullptr;
+            const std::string* text =
+                article ? article->FindString("text") : nullptr;
+            if (!title || !text || title->size() > kMaxTitleBytes ||
+                text->empty() || text->size() > kMaxTextBytes) {
+              std::move(callback).Run(Fault("invalid_argument",
+                                            "Readable page exceeds safe bounds "
+                                            "or contains private fields"));
+              return;
+            }
+            base::Value::Dict result;
+            result.Set("url", expected_url);
+            result.Set("title", *title);
+            result.Set("text", *text);
+            base::Value::Dict reply;
+            reply.Set("result", std::move(result));
+            std::move(callback).Run(std::move(reply));
+          },
+          weak_factory_.GetWeakPtr(), expected_url, document_id,
+          std::move(callback)),
+      kCaptureWorld);
+}
+
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/readable_capture.h b/chrome/browser/ui/aux/readable_capture.h
