new file mode 100644
index 0000000000..4611787efd
--- /dev/null
+++ b/chrome/browser/ui/aux/native_find.cc
@@ -0,0 +1,163 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/native_find.h"
+
+#include <algorithm>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "components/find_in_page/find_tab_helper.h"
+#include "components/find_in_page/find_types.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+base::DictValue Fault(const char* code, const char* message) {
+  base::DictValue error;
+  error.Set("code", code);
+  error.Set("message", message);
+  base::DictValue result;
+  result.Set("error", std::move(error));
+  return result;
+}
+base::DictValue Result(int matches, int active) {
+  base::DictValue value;
+  value.Set("matches", matches);
+  if (active > 0) value.Set("activeMatch", active);
+  base::DictValue result;
+  result.Set("result", std::move(value));
+  return result;
+}
+}  // namespace
+
+NativeFind::NativeFind(Profile* profile) : profile_(profile) {}
+NativeFind::~NativeFind() {
+  for (auto& [helper, contents] : observed_) helper->RemoveObserver(this);
+  while (!pending_.empty())
+    Finish(pending_.begin()->first,
+           Fault("backend_unavailable", "The browser Profile closed"));
+}
+
+void NativeFind::Finish(const std::string& page_id, base::DictValue result) {
+  auto it = pending_.find(page_id);
+  if (it == pending_.end()) return;
+  Reply reply = std::move(it->second.reply);
+  pending_.erase(it);
+  std::move(reply).Run(std::move(result));
+}
+
+void NativeFind::Find(const base::DictValue& params, Reply reply) {
+  const std::string* page_id = params.FindString("pageId");
+  const std::string* text = params.FindString("text");
+  const auto forward = params.FindBool("forward");
+  const auto find_next = params.FindBool("findNext");
+  if (!page_id || !text || !forward || !find_next || text->empty() ||
+      text->size() > 4096 || !base::IsStringUTF8(*text)) {
+    std::move(reply).Run(Fault("invalid_argument", "Invalid find request"));
+    return;
+  }
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  content::WebContents* contents = catalog ? catalog->FindPage(*page_id) : nullptr;
+  if (!contents || contents->GetBrowserContext() != profile_ ||
+      !contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS()) {
+    std::move(reply).Run(Fault("not_found", "Page is not in this Profile"));
+    return;
+  }
+  auto* helper = find_in_page::FindTabHelper::FromWebContents(contents);
+  if (!helper) {
+    find_in_page::FindTabHelper::CreateForWebContents(contents);
+    helper = find_in_page::FindTabHelper::FromWebContents(contents);
+  }
+  if (!helper) {
+    std::move(reply).Run(Fault("backend_unavailable", "Page find is unavailable"));
+    return;
+  }
+  Finish(*page_id, Fault("conflict", "A newer find replaced this request"));
+  if (observed_.emplace(helper, contents).second) helper->AddObserver(this);
+  if (!*find_next) helper->StopFinding(find_in_page::SelectionAction::kClear);
+  pending_.emplace(*page_id, Pending{reinterpret_cast<uintptr_t>(contents),
+                                     reinterpret_cast<uintptr_t>(&contents->GetPrimaryPage()), 0,
+                                     std::move(reply)});
+  helper->StartFinding(base::UTF8ToUTF16(*text), *forward,
+                       /*case_sensitive=*/false, /*find_match=*/true);
+  const int request_id = helper->current_find_request_id();
+  if (auto it = pending_.find(*page_id); it != pending_.end())
+    it->second.request_id = request_id;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(
+          [](base::WeakPtr<NativeFind> self, std::string id, int request) {
+            if (!self) return;
+            auto it = self->pending_.find(id);
+            if (it != self->pending_.end() && it->second.request_id == request)
+              self->Finish(id, Fault("backend_unavailable", "Find timed out"));
+          }, weak_factory_.GetWeakPtr(), *page_id, request_id), base::Seconds(10));
+}
+
+base::DictValue NativeFind::Stop(const base::DictValue& params) {
+  const std::string* page_id = params.FindString("pageId");
+  const std::string* action = params.FindString("action");
+  if (!page_id || !action || (*action != "clear" && *action != "keep"))
+    return Fault("invalid_argument", "Invalid stop-find request");
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  content::WebContents* contents = catalog ? catalog->FindPage(*page_id) : nullptr;
+  if (!contents || contents->GetBrowserContext() != profile_)
+    return Fault("not_found", "Page is not in this Profile");
+  Finish(*page_id, Fault("conflict", "Find was stopped"));
+  if (auto* helper = find_in_page::FindTabHelper::FromWebContents(contents))
+    helper->StopFinding(*action == "keep" ? find_in_page::SelectionAction::kKeep
+                                          : find_in_page::SelectionAction::kClear);
+  base::DictValue value;
+  value.Set("ok", true);
+  base::DictValue result;
+  result.Set("result", std::move(value));
+  return result;
+}
+
+void NativeFind::OnFindResultAvailable(content::WebContents* contents) {
+  auto* helper = find_in_page::FindTabHelper::FromWebContents(contents);
+  if (!helper) return;
+  const auto& found = helper->find_result();
+  if (!found.final_update()) return;
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  std::vector<std::string> stale;
+  std::vector<std::string> matches;
+  for (const auto& [id, pending] : pending_) {
+    if (pending.contents != reinterpret_cast<uintptr_t>(contents)) continue;
+    if (!catalog || catalog->FindPage(id) != contents ||
+        pending.document != reinterpret_cast<uintptr_t>(&contents->GetPrimaryPage())) {
+      stale.push_back(id);
+      continue;
+    }
+    if (pending.request_id == found.request_id()) {
+      matches.push_back(id);
+    }
+  }
+  for (const auto& id : stale)
+    Finish(id, Fault("conflict", "Page changed during find"));
+  for (const auto& id : matches)
+    Finish(id, Result(std::max(0, found.number_of_matches()),
+                      found.active_match_ordinal()));
+}
+
+void NativeFind::OnFindTabHelperDestroyed(find_in_page::FindTabHelper* helper) {
+  auto it = observed_.find(helper);
+  if (it == observed_.end()) return;
+  content::WebContents* contents = it->second;
+  observed_.erase(it);
+  std::vector<std::string> cancelled;
+  for (const auto& [id, pending] : pending_)
+    if (pending.contents == reinterpret_cast<uintptr_t>(contents)) cancelled.push_back(id);
+  for (const auto& id : cancelled)
+    Finish(id, Fault("conflict", "Page closed during find"));
+}
+}  // namespace aux
