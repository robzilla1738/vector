+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/native_find.h"
+
+#include "base/functional/bind.h"
+#include "content/public/test/browser_task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+namespace {
+
+class NativeFindTest : public testing::Test {
+ protected:
+  content::BrowserTaskEnvironment task_environment_;
+  NativeFind finder_{nullptr};
+};
+
+TEST_F(NativeFindTest, RejectsMalformedAndOversizedRequestsBeforePageLookup) {
+  for (const std::string& text : {std::string(), std::string(4097, 'x'),
+                                  std::string("\xff", 1)}) {
+    base::DictValue request;
+    request.Set("pageId", "foreign-page");
+    request.Set("text", text);
+    request.Set("forward", true);
+    request.Set("findNext", false);
+    bool called = false;
+    finder_.Find(request, base::BindOnce(
+        [](bool* called, base::DictValue result) {
+          *called = true;
+          EXPECT_EQ(*result.FindDict("error")->FindString("code"),
+                    "invalid_argument");
+        }, &called));
+    EXPECT_TRUE(called);
+  }
+}
+
+TEST_F(NativeFindTest, RejectsInvalidStopActionBeforePageLookup) {
+  base::DictValue request;
+  request.Set("pageId", "foreign-page");
+  request.Set("action", "activate");
+  base::DictValue result = finder_.Stop(request);
+  EXPECT_EQ(*result.FindDict("error")->FindString("code"),
+            "invalid_argument");
+}
+
+}  // namespace
+}  // namespace aux
