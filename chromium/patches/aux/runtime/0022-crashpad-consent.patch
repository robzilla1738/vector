 bool ChromeCrashReporterClient::GetCollectStatsConsent() {
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_AUX_SHELL)
+  // Crashpad starts before the browser UI. Only an explicit Aux choice and a
+  // configured endpoint may enable uploads; Chromium's metrics choice does not.
+  CFPropertyListRef choice = CFPreferencesCopyAppValue(
+      CFSTR("AuxCrashReportsOptIn"), CFSTR("dev.aux.browser"));
+  CFPropertyListRef consent_endpoint = CFPreferencesCopyAppValue(
+      CFSTR("AuxCrashConsentEndpoint"), CFSTR("dev.aux.browser"));
+  const std::string upload_url = GetUploadUrl();
+  const bool opted_in = choice && CFGetTypeID(choice) == CFBooleanGetTypeID() &&
+                        CFBooleanGetValue(static_cast<CFBooleanRef>(choice));
+  const bool endpoint_matches =
+      consent_endpoint && CFGetTypeID(consent_endpoint) == CFStringGetTypeID() &&
+      base::SysCFStringRefToUTF8(static_cast<CFStringRef>(consent_endpoint)) ==
+          upload_url;
+  if (choice) {
+    CFRelease(choice);
+  }
+  if (consent_endpoint) {
+    CFRelease(consent_endpoint);
+  }
+  return opted_in && endpoint_matches && !upload_url.empty() &&
+         !CFPreferencesAppValueIsForced(CFSTR("AuxCrashReportsOptIn"),
+                                        CFSTR("dev.aux.browser")) &&
+         !CFPreferencesAppValueIsForced(CFSTR("AuxCrashConsentEndpoint"),
+                                        CFSTR("dev.aux.browser"));
+#else
 #if BUILDFLAG(GOOGLE_CHROME_BRANDING)
   bool is_official_chrome_build = true;
 #else
@@ -208,6 +239,7 @@ bool ChromeCrashReporterClient::GetCollectStatsConsent() {
           << " so returning that";
   return settings_consent;
 #endif  // BUILDFLAG(IS_ANDROID)
+#endif  // BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_AUX_SHELL)
 }
 
