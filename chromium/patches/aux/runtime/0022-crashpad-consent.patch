 // found in the LICENSE file.
 
 #include "chrome/app/chrome_crash_reporter_client.h"
+#include "chrome/app/aux_crash_reporting_mac.h"
 
 #include <CoreFoundation/CoreFoundation.h>
+#import <Foundation/Foundation.h>
 
 #include "base/apple/scoped_cftyperef.h"
 #include "base/path_service.h"
 #include "base/rand_util.h"
 #include "base/strings/sys_string_conversions.h"
+#include "chrome/browser/buildflags.h"
 #include "chrome/common/channel_info.h"
 #include "chrome/common/chrome_paths.h"
 #include "components/policy/policy_constants.h"
 #include "components/version_info/version_info.h"
+#include "components/crash/core/app/crashpad.h"
+
+namespace {
+
+NSString* const kAuxCrashUploadURLKey = @"AuxCrashUploadURL";
+CFStringRef const kAuxCrashConsentKey = CFSTR("AuxCrashReportsOptIn");
+CFStringRef const kAuxCrashConsentEndpointKey =
+    CFSTR("AuxCrashConsentEndpoint");
+CFStringRef const kAuxPreferencesDomain = CFSTR("dev.aux.browser");
+
+std::string ConfiguredUploadURL();
+
+bool HasBooleanChoice() {
+  base::apple::ScopedCFTypeRef<CFPropertyListRef> value(
+      CFPreferencesCopyAppValue(kAuxCrashConsentKey, kAuxPreferencesDomain));
+  return value && CFGetTypeID(value.get()) == CFBooleanGetTypeID();
+}
+
+bool ConsentChoiceIsTrue() {
+  base::apple::ScopedCFTypeRef<CFPropertyListRef> value(
+      CFPreferencesCopyAppValue(kAuxCrashConsentKey, kAuxPreferencesDomain));
+  return value && CFGetTypeID(value.get()) == CFBooleanGetTypeID() &&
+         CFBooleanGetValue(static_cast<CFBooleanRef>(value.get()));
+}
+
+bool ConsentEndpointMatches() {
+  base::apple::ScopedCFTypeRef<CFPropertyListRef> value(
+      CFPreferencesCopyAppValue(kAuxCrashConsentEndpointKey,
+                                kAuxPreferencesDomain));
+  return value && CFGetTypeID(value.get()) == CFStringGetTypeID() &&
+         base::SysCFStringRefToUTF8(
+             static_cast<CFStringRef>(value.get())) == ConfiguredUploadURL();
+}
+
+std::string ConfiguredUploadURL() {
+  id value = [[NSBundle mainBundle] objectForInfoDictionaryKey:kAuxCrashUploadURLKey];
+  if (![value isKindOfClass:NSString.class] || [value length] == 0) {
+    return {};
+  }
+  NSURLComponents* url = [NSURLComponents componentsWithString:value];
+  if (!url || ![url.scheme.lowercaseString isEqualToString:@"https"] ||
+      url.host.length == 0 || url.user || url.password || url.fragment ||
+      !url.URL) {
+    return {};
+  }
+  return base::SysNSStringToUTF8(url.URL.absoluteString);
+}
+
+}  // namespace
+
+namespace aux_crash_reporting {
+
+bool HasConfiguredEndpoint() {
+  return !ConfiguredUploadURL().empty();
+}
+
+bool HasUserChoice() {
+  return HasBooleanChoice() && ConsentEndpointMatches();
+}
+
+bool HasConsent() {
+  return HasConfiguredEndpoint() && HasUserChoice() && ConsentChoiceIsTrue() &&
+         !CFPreferencesAppValueIsForced(kAuxCrashConsentKey,
+                                        kAuxPreferencesDomain) &&
+         !CFPreferencesAppValueIsForced(kAuxCrashConsentEndpointKey,
+                                        kAuxPreferencesDomain);
+}
+
+bool SetConsent(bool consent) {
+  if (CFPreferencesAppValueIsForced(kAuxCrashConsentKey,
+                                    kAuxPreferencesDomain) ||
+      CFPreferencesAppValueIsForced(kAuxCrashConsentEndpointKey,
+                                    kAuxPreferencesDomain)) {
+    crash_reporter::SetUploadConsent(false);
+    return false;
+  }
+  if (!HasConfiguredEndpoint()) {
+    consent = false;
+  }
+  CFPreferencesSetAppValue(kAuxCrashConsentKey,
+                           consent ? kCFBooleanTrue : kCFBooleanFalse,
+                           kAuxPreferencesDomain);
+  base::apple::ScopedCFTypeRef<CFStringRef> consent_endpoint =
+      base::SysUTF8ToCFStringRef(ConfiguredUploadURL());
+  CFPreferencesSetAppValue(kAuxCrashConsentEndpointKey,
+                           consent_endpoint.get(), kAuxPreferencesDomain);
+  if (!CFPreferencesAppSynchronize(kAuxPreferencesDomain)) {
+    crash_reporter::SetUploadConsent(false);
+    return false;
+  }
+  crash_reporter::SetUploadConsent(HasConsent());
+  return HasUserChoice() && ConsentChoiceIsTrue() == consent;
+}
+
+}  // namespace aux_crash_reporting
+
+std::string ChromeCrashReporterClient::GetUploadUrl() {
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+  return ConfiguredUploadURL();
+#else
+  return CrashReporterClient::GetUploadUrl();
+#endif
+}
 
