+  aux_zap_applied_origin_.clear();
+  aux_zap_applied_key_ = blink::WebStyleSheetKey();
 #if BUILDFLAG(ENABLE_OFFLINE_PAGES)
   DCHECK(render_frame());
   if (!render_frame()->IsMainFrame())
