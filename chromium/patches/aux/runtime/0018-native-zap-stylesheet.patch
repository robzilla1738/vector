+TEST(AuxZapStylesheetRegistryTest, ExactOriginAndOrderedRevocation) {
+  AuxZapStylesheetRegistry registry;
+  const auto now = AuxZapStylesheetRegistry::Clock::now();
+  using Result = AuxZapStylesheetRegistry::Result;
+  EXPECT_EQ(Result::kAccepted, registry.Update("https://example.test", 1,
+                                               "p { display: none }", now));
+  ASSERT_NE(nullptr, registry.Find("https://example.test"));
+  EXPECT_EQ("p { display: none }", *registry.Find("https://example.test"));
+  EXPECT_EQ(nullptr, registry.Find("https://other.test"));
+
+  EXPECT_EQ(Result::kAccepted,
+            registry.Update("https://example.test", 2, "", now));
+  EXPECT_EQ(nullptr, registry.Find("https://example.test"));
+  EXPECT_EQ(Result::kStale, registry.Update("https://example.test", 1,
+                                            "p { display: none }", now));
+  EXPECT_EQ(nullptr, registry.Find("https://example.test"));
+
+  EXPECT_EQ(Result::kAccepted, registry.Update("https://example.test", 3,
+                                               "h1 { color: red }", now));
+  EXPECT_EQ("h1 { color: red }", *registry.Find("https://example.test"));
+  EXPECT_EQ(Result::kStale,
+            registry.Update("https://example.test", 3, "old", now));
+  EXPECT_EQ("h1 { color: red }", *registry.Find("https://example.test"));
+}
+
+TEST(AuxZapStylesheetRegistryTest, ExpiredTombstoneAndSiteCapacity) {
+  AuxZapStylesheetRegistry registry;
+  const auto now = AuxZapStylesheetRegistry::Clock::now();
+  using Result = AuxZapStylesheetRegistry::Result;
+  EXPECT_EQ(Result::kAccepted,
+            registry.Update("https://removed.test", 5, "", now));
+  EXPECT_EQ(Result::kStale,
+            registry.Update("https://removed.test", 4, "stale", now));
+  EXPECT_EQ(Result::kAccepted, registry.Update("https://new.test", 1, "fresh",
+                                               now + std::chrono::seconds(31)));
+  for (int index = 0; index < 99; ++index) {
+    EXPECT_EQ(Result::kAccepted,
+              registry.Update("https://site" + std::to_string(index) + ".test",
+                              1, "css", now + std::chrono::seconds(31)));
+  }
+  EXPECT_EQ(Result::kCapacity,
+            registry.Update("https://overflow.test", 1, "css",
+                            now + std::chrono::seconds(31)));
+}
