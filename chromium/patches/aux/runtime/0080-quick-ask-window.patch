+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/create_browser_window.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "components/prefs/pref_service.h"
+#include "components/sessions/core/session_id.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/accelerators/global_accelerator_listener/global_accelerator_listener.h"
+#include "ui/base/base_window.h"
+#include "ui/display/screen.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+
+class QuickAskController : public ui::GlobalAcceleratorListener::Observer {
+ public:
+  QuickAskController() { UpdateRegistration(); }
+  ~QuickAskController() override = default;
+
+  QuickAskShortcutStatus Status() const {
+    QuickAskShortcutStatus status;
+    PrefService* prefs = g_browser_process ? g_browser_process->local_state() : nullptr;
+    status.enabled = prefs && prefs->GetBoolean(kQuickAskShortcutEnabledPref);
+    status.registered = registered_;
+    if (status.enabled && !registered_)
+      status.error = "This shortcut is unavailable or in use by another app.";
+    return status;
+  }
+
+  QuickAskShortcutStatus SetEnabled(bool enabled) {
+    if (PrefService* prefs =
+            g_browser_process ? g_browser_process->local_state() : nullptr)
+      prefs->SetBoolean(kQuickAskShortcutEnabledPref, enabled);
+    UpdateRegistration();
+    return Status();
+  }
+
+  bool IsPopup(const BrowserWindowInterface* browser) const {
+    return browser && popup_id_.is_valid() &&
+           browser->GetSessionID() == popup_id_;
+  }
+
+  bool Open(Profile* profile) {
+    if (!profile || profile->IsOffTheRecord())
+      return false;
+    if (BrowserWindowInterface* popup = Popup()) {
+      if (popup->GetProfile() == profile) {
+        popup->GetWindow()->Show();
+        popup->GetWindow()->Activate();
+        return true;
+      }
+      popup->GetWindow()->Close();
+      popup_id_ = SessionID::InvalidValue();
+    }
+    auto* screen = display::Screen::Get();
+    if (!screen)
+      return false;
+    const gfx::Rect work_area =
+        screen->GetDisplayNearestPoint(screen->GetCursorScreenPoint()).work_area();
+    constexpr int kWidth = 520;
+    constexpr int kHeight = 640;
+    const gfx::Rect bounds(
+        work_area.CenterPoint().x() - kWidth / 2,
+        work_area.CenterPoint().y() - kHeight / 2, kWidth, kHeight);
+    // Aux's WebUI shell is installed on normal browser windows. Keep a
+    // distinct session identity for this compact, non-restored window.
+    BrowserWindowCreateParams params(
+        BrowserWindowInterface::Type::TYPE_NORMAL, profile, true);
+    params.initial_bounds = bounds;
+    params.omit_from_session_restore = true;
+    BrowserWindowInterface* popup = CreateBrowserWindow(std::move(params));
+    if (!popup)
+      return false;
+    popup_id_ = popup->GetSessionID();
+    chrome::AddTabAt(popup, GURL(), -1, true);
+    popup->GetWindow()->SetBounds(bounds);
+    popup->GetWindow()->Show();
+    popup->GetWindow()->Activate();
+    return true;
+  }
+
+  bool Dismiss(BrowserWindowInterface* browser) {
+    if (!IsPopup(browser))
+      return false;
+    popup_id_ = SessionID::InvalidValue();
+    browser->GetWindow()->Close();
+    return true;
+  }
+
+  bool Expand(BrowserWindowInterface* browser) {
+    if (!IsPopup(browser))
+      return false;
+    Profile* profile = browser->GetProfile();
+    auto* screen = display::Screen::Get();
+    if (!screen)
+      return false;
+    const gfx::Rect work_area =
+        screen->GetDisplayNearestWindow(browser->GetWindow()->GetNativeWindow())
+            .work_area();
+    const int width = std::min(1200, work_area.width());
+    const int height = std::min(850, work_area.height());
+    const gfx::Rect bounds(work_area.CenterPoint().x() - width / 2,
+                           work_area.CenterPoint().y() - height / 2,
+                           width, height);
+    BrowserWindowCreateParams params(
+        BrowserWindowInterface::Type::TYPE_NORMAL, profile, true);
+    params.initial_bounds = bounds;
+    params.should_trigger_session_restore = false;
+    BrowserWindowInterface* expanded = CreateBrowserWindow(std::move(params));
+    if (!expanded)
+      return false;
+    chrome::AddTabAt(expanded, GURL(), -1, true);
+    expanded->GetWindow()->SetBounds(bounds);
+    expanded->GetWindow()->Show();
+    expanded->GetWindow()->Activate();
+    return Dismiss(browser);
+  }
+
+  void OnKeyPressed(const ui::Accelerator& accelerator) override {
+    BrowserWindowInterface* active =
+        GlobalBrowserCollection::GetInstance()
+            ? GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser()
+            : nullptr;
+    if (active)
+      Open(active->GetProfile());
+  }
+
+  void ExecuteCommand(const std::string& accelerator_group_id,
+                      const std::string& command_id) override {}
+
+ private:
+  BrowserWindowInterface* Popup() const {
+    auto* collection = GlobalBrowserCollection::GetInstance();
+    return collection && popup_id_.is_valid()
+               ? collection->FindBrowserWithID(popup_id_)
+               : nullptr;
+  }
+
+  void UpdateRegistration() {
+    auto* listener = ui::GlobalAcceleratorListener::GetInstance();
+    if (!listener)
+      return;
+    listener->UnregisterAccelerators(this);
+    registered_ = false;
+    PrefService* prefs = g_browser_process ? g_browser_process->local_state() : nullptr;
+    if (prefs && prefs->GetBoolean(kQuickAskShortcutEnabledPref)) {
+      registered_ = listener->RegisterAccelerator(
+          ui::Accelerator(ui::VKEY_SPACE,
+                          ui::EF_COMMAND_DOWN | ui::EF_SHIFT_DOWN),
+          this);
+    }
+  }
+
+  SessionID popup_id_ = SessionID::InvalidValue();
+  bool registered_ = false;
+};
+
+QuickAskController& Controller() {
+  static auto* controller = new QuickAskController();
+  return *controller;
+}
+
+}  // namespace
+
+void InitializeQuickAsk() { Controller(); }
+QuickAskShortcutStatus GetQuickAskShortcutStatus() {
+  return Controller().Status();
+}
+QuickAskShortcutStatus SetQuickAskShortcutEnabled(bool enabled) {
+  return Controller().SetEnabled(enabled);
+}
+bool IsQuickAskWindow(const BrowserWindowInterface* browser) {
+  return Controller().IsPopup(browser);
+}
+bool OpenQuickAsk(Profile* profile) { return Controller().Open(profile); }
+bool DismissQuickAsk(BrowserWindowInterface* browser) {
+  return Controller().Dismiss(browser);
+}
+bool ExpandQuickAsk(BrowserWindowInterface* browser) {
+  return Controller().Expand(browser);
+}
+
+}  // namespace aux
