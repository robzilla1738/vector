+void AuxRuntimeHost::Worker::SendTabsChanged() {
+  if (connection_fd_ < 0)
+    return;
+  base::DictValue note;
+  note.Set("kind", "note");
+  note.Set("type", "native.tabsChanged");
+  note.Set("payload", base::DictValue());
+  const auto json = base::WriteJson(note);
+  if (!json || !SendFrame(*json))
+    Disconnect();
+}
