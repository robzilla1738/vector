+TEST_P(HTMLVideoElementTest, AutoPipRefusesPauseHiddenAndDisabledVideo) {
+  ON_CALL(*MockMediaPlayer(), HasVideo()).WillByDefault(Return(true));
+  ON_CALL(*MockMediaPlayer(), GetReadyState()).WillByDefault(
+      Return(WebMediaPlayer::kReadyStateHaveFutureData));
+  video()->setMuted(true);
+  video()->SetSrc(AtomicString("https://example.com/video.mp4"));
+  test::RunPendingTasks();
+  video()->ReadyStateChanged();
+  video()->setAttribute(html_names::kStyleAttr, AtomicString("width:320px;height:180px"));
+  video()->Play();
+  UpdateAllLifecyclePhasesForTest();
+  ASSERT_FALSE(video()->paused());
+  gfx::Size size;
+  video()->RequestAutoPictureInPictureSize(base::BindOnce(
+      [](gfx::Size* result, gfx::Size current) { *result = current; }, &size));
+  ASSERT_FALSE(size.IsEmpty());
+  GetDocument().GetSettings()->SetPictureInPictureEnabled(false);
+  video()->RequestAutoPictureInPictureSize(base::BindOnce(
+      [](gfx::Size* result, gfx::Size current) { *result = current; }, &size));
+  EXPECT_TRUE(size.IsEmpty());
+  GetDocument().GetSettings()->SetPictureInPictureEnabled(true);
+  video()->RequestAutoPictureInPictureSize(base::BindOnce(
+      [](gfx::Size* result, gfx::Size current) { *result = current; }, &size));
+  ASSERT_FALSE(size.IsEmpty());
+  video()->setAttribute(html_names::kDisablepictureinpictureAttr, g_empty_atom);
+  video()->RequestAutoPictureInPictureSize(base::BindOnce(
+      [](gfx::Size* result, gfx::Size current) { *result = current; }, &size));
+  EXPECT_TRUE(size.IsEmpty());
+  video()->removeAttribute(html_names::kDisablepictureinpictureAttr);
+  video()->setAttribute(html_names::kStyleAttr, AtomicString("visibility:hidden;width:320px;height:180px"));
+  UpdateAllLifecyclePhasesForTest();
+  video()->RequestAutoPictureInPictureSize(base::BindOnce(
+      [](gfx::Size* result, gfx::Size current) { *result = current; }, &size));
+  EXPECT_TRUE(size.IsEmpty());
+  video()->setAttribute(html_names::kStyleAttr, AtomicString("width:320px;height:180px"));
+  video()->pause();
+  UpdateAllLifecyclePhasesForTest();
+  video()->RequestAutoPictureInPictureSize(base::BindOnce(
+      [](gfx::Size* result, gfx::Size current) { *result = current; }, &size));
+  EXPECT_TRUE(size.IsEmpty());
+}
