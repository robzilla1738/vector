+namespace {
+class AutoPipSizeObserver final : public MockMediaSessionPlayerObserver {
+ public:
+  explicit AutoPipSizeObserver(RenderFrameHost* frame)
+      : MockMediaSessionPlayerObserver(frame, media::MediaContentType::kPersistent) {}
+  void OnRequestAutoPictureInPictureSize(
+      int player_id, AutoPictureInPictureSizeCallback callback) override {
+    if (defer) {
+      pending.emplace_back(player_id, std::move(callback));
+    } else {
+      std::move(callback).Run(sizes[player_id]);
+    }
+  }
+  void OnEnterPictureInPicture(int player_id,
+      const std::optional<gfx::Size>& min_size) override {
+    chosen.push_back(player_id);
+    MockMediaSessionPlayerObserver::OnEnterPictureInPicture(player_id, min_size);
+  }
+  void Reply() {
+    auto replies = std::move(pending);
+    pending.clear();
+    for (auto& reply : replies) std::move(reply.second).Run(sizes[reply.first]);
+  }
+  bool defer = false;
+  std::map<int, gfx::Size> sizes;
+  std::vector<std::pair<int, AutoPictureInPictureSizeCallback>> pending;
+  std::vector<int> chosen;
+};
+}
