+    const PlayerIdentifier& player) const {
+  if (!normal_players_.contains(player)) return false;
+  auto* frame = player.observer->render_frame_host();
+  return frame && frame->IsInPrimaryMainFrame() &&
+      frame == web_contents()->GetPrimaryMainFrame() &&
+      !player.observer->IsPaused(player.player_id) &&
+      player.observer->IsPictureInPictureAvailable(player.player_id);
+}
+
+void MediaSessionImpl::SelectAutoPipPlayer(
+    base::RepeatingCallback<bool()> eligible) {
+  if (!CanEnterBrowserInitiatedAutomaticPictureInPicture() ||
+      !base::FeatureList::IsEnabled(
+          blink::features::kBrowserInitiatedAutomaticPictureInPicture)) return;
+  std::vector<PlayerIdentifier> players;
+  for (const auto& item : normal_players_)
+    if (IsAutoPipPlayerEligible(item.first)) players.push_back(item.first);
+  if (players.empty() || players.size() > 64) return;
+  const auto generation = ++auto_pip_generation_;
+  auto_pip_selection_timer_.Start(FROM_HERE, base::Seconds(2),
+      base::BindOnce(&MediaSessionImpl::CancelAutoPipSelection,
+                    weak_factory_.GetWeakPtr(), generation));
+  auto sizes = base::BarrierCallback<AutoPipCandidate>(
+      players.size(), base::BindOnce(&MediaSessionImpl::AutoPipPlayerSizesReady,
+          weak_factory_.GetWeakPtr(), generation,
+          web_contents()->GetPrimaryMainFrame()->GetWeakDocumentPtr(),
+          std::move(eligible)));
+  auto weak = weak_factory_.GetWeakPtr();
+  for (const auto& player : players) {
+    if (!weak || generation != auto_pip_generation_ ||
+        !IsAutoPipPlayerEligible(player)) return;
+    player.observer->OnRequestAutoPictureInPictureSize(player.player_id,
+        base::BindOnce([](base::RepeatingCallback<void(AutoPipCandidate)> sizes,
+                          PlayerIdentifier player, gfx::Size size) {
+          sizes.Run({player, size});
+        }, sizes, player));
+  }
+}
+
+void MediaSessionImpl::AutoPipPlayerSizesReady(
+    uint64_t generation, WeakDocumentPtr document,
+    base::RepeatingCallback<bool()> eligible,
+    std::vector<AutoPipCandidate> candidates) {
+  auto weak = weak_factory_.GetWeakPtr();
+  if (!eligible || !eligible.Run() || !weak) return;
+  if (generation != auto_pip_generation_ ||
+      document.AsRenderFrameHostIfValid() != web_contents()->GetPrimaryMainFrame() ||
+      !CanEnterBrowserInitiatedAutomaticPictureInPicture()) return;
+  std::optional<AutoPipCandidate> best;
+  for (const auto& candidate : candidates) {
+    if (!IsAutoPipPlayerEligible(candidate.player) ||
+        candidate.size.width() < kBrowserAutoPipMinSize.width() ||
+        candidate.size.height() < kBrowserAutoPipMinSize.height()) continue;
+    const auto area = static_cast<int64_t>(candidate.size.width()) * candidate.size.height();
+    const auto best_area = best ? static_cast<int64_t>(best->size.width()) * best->size.height() : 0;
+    if (!best || area > best_area ||
+        (area == best_area && candidate.player < best->player)) best = candidate;
+  }
+  if (!best) return;
+  best->player.observer->OnRequestAutoPictureInPictureSize(best->player.player_id,
+      base::BindOnce(&MediaSessionImpl::AutoPipPlayerRevalidated,
+          weak_factory_.GetWeakPtr(), generation, document, std::move(eligible),
+          best->player, best->size));
+}
+
+void MediaSessionImpl::AutoPipPlayerRevalidated(
+    uint64_t generation, WeakDocumentPtr document,
+    base::RepeatingCallback<bool()> eligible,
+    PlayerIdentifier player, gfx::Size expected_size, gfx::Size current_size) {
+  auto weak = weak_factory_.GetWeakPtr();
+  if (!eligible || !eligible.Run() || !weak) return;
+  if (generation != auto_pip_generation_ || current_size != expected_size ||
+      current_size.IsEmpty() ||
+      document.AsRenderFrameHostIfValid() != web_contents()->GetPrimaryMainFrame() ||
+      !IsAutoPipPlayerEligible(player) ||
+      !CanEnterBrowserInitiatedAutomaticPictureInPicture()) return;
+  auto_pip_selection_timer_.Stop();
+  ++auto_pip_generation_;
+  player.observer->OnEnterPictureInPicture(player.player_id, current_size);
+  if (!weak) return;
+  RecordBrowserInitiatedAutomaticPictureInPictureUkm(false);
+  uma_helper_.RecordEnterPictureInPicture(
+      MediaSessionUmaHelper::EnterPictureInPictureType::kDefaultAutomatic);
+}
+
+void MediaSessionImpl::CancelAutoPipSelection(uint64_t generation) {
+  if (generation == auto_pip_generation_) ++auto_pip_generation_;
+}
