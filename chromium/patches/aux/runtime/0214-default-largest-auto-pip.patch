+void MediaSessionController::OnRequestAutoPictureInPictureSize(
+    int player_id, AutoPictureInPictureSizeCallback callback) {
+  DCHECK_EQ(player_id_, player_id);
+  auto* observer = web_contents_->media_web_contents_observer();
+  auto* frame = render_frame_host();
+  if (!frame || !frame->IsInPrimaryMainFrame() ||
+      !observer->IsMediaPlayerRemoteAvailable(id_)) {
+    std::move(callback).Run(gfx::Size());
+    return;
+  }
+  observer->GetMediaPlayerRemote(id_)->RequestAutoPictureInPictureSize(
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(callback), gfx::Size()));
+}
+
 RenderFrameHost* MediaSessionController::render_frame_host() const {
