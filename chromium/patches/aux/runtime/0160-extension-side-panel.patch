+namespace aux {
+bool CanHostExtensionSidePanel(BrowserWindowInterface* browser) {
+  return browser && !IsQuickAskWindow(browser) && !IsLittleWindow(browser) &&
+         !browser->GetProfile()->IsOffTheRecord() &&
+         browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+         WebUIBrowserWindow::FromBrowser(browser);
+}
+std::optional<base::DictValue> DescribeExtensionSidePanel(BrowserWindowInterface* browser) {
+  if (!CanHostExtensionSidePanel(browser)) {
+    return std::nullopt;
+  }
+  auto* window = WebUIBrowserWindow::FromBrowser(browser);
+  auto* panel = window ? window->GetWebUIBrowserSidePanelUI() : nullptr;
+  const auto key = panel ? panel->GetCurrentEntryKey() : std::nullopt;
+  if (!key || !key->extension_id()) {
+    return std::nullopt;
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(browser->GetProfile());
+  const auto* extension = registry ? registry->GetInstalledExtension(
+      *key->extension_id()) : nullptr;
+  auto* contents = panel->GetWebContentsForId(key->id());
+  if (!contents || contents->GetBrowserContext() != browser->GetProfile() ||
+      contents->GetLastCommittedURL().scheme() != "chrome-extension" ||
+      contents->GetLastCommittedURL().host() != *key->extension_id() ||
+      (contents->GetOuterWebContents() &&
+       WebUIBrowserWindow::FromWebShellWebContents(contents->GetOuterWebContents()) != window)) {
+    return std::nullopt;
+  }
+  auto* active = browser->GetTabStripModel()->GetActiveWebContents();
+  base::DictValue result;
+  result.Set("extensionId", *key->extension_id());
+  result.Set("windowId", base::NumberToString(browser->GetSessionID().id()));
+  result.Set("pageId", active ? base::Value(PageIdentity::GetOrCreate(
+      browser->GetProfile(), active)) : base::Value());
+  result.Set("contentId", guest_contents::GuestContentsHandle::CreateForWebContents(
+      contents)->id().ToString());
+  result.Set("title", extension ? extension->name() : base::UTF16ToUTF8(contents->GetTitle()));
+  result.Set("open", true);
+  return result;
+}
+
+void PublishExtensionSidePanel(BrowserWindowInterface* browser, bool open) {
+  auto payload = DescribeExtensionSidePanel(browser);
+  if (!payload) {
+    return;
+  }
+  payload->Set("open", open);
+  if (!open) {
+    payload->Set("contentId", base::Value());
+  }
+  auto json = base::WriteJson(*payload);
+  if (json) {
+    EmitShellEvent(browser->GetProfile(), "onSidePanel", std::move(*json));
+  }
+}
+namespace {
+void Reply(ExtensionBridge::Callback callback, base::Value value) {
+  auto json = base::WriteJson(value);
+  std::move(callback).Run(json.has_value(), json.value_or(""),
+                         json ? "" : "internal_error", json ? "" : "Could not encode extension state");
+}
+void Reject(ExtensionBridge::Callback callback, std::string code, std::string message) {
+  std::move(callback).Run(false, "", std::move(code), std::move(message));
+}
+base::ListValue DescribeActions(BrowserWindowInterface* browser) {
+  base::ListValue rows;
+  auto* model = ToolbarActionsModel::Get(browser->GetProfile());
+  auto* registry = extensions::ExtensionRegistry::Get(browser->GetProfile());
+  auto* container = ExtensionsContainer::From(*browser);
+  auto* active = browser->GetTabStripModel()->GetActiveWebContents();
+  if (!model || !registry || !container || !active) return rows;
+  const int tab_id = sessions::SessionTabHelper::IdForTab(active).id();
+  auto ids = model->pinned_action_ids();
+  for (const auto& id : model->action_ids()) {
+    if (!model->IsActionPinned(id)) ids.push_back(id);
+  }
+  for (const auto& id : ids) {
+    const auto* extension = registry->enabled_extensions().GetByID(id);
+    auto* action = container->GetActionForId(id);
+    auto* data = extension ? extensions::ExtensionActionManager::Get(
+        browser->GetProfile())->GetExtensionAction(*extension) : nullptr;
+    if (!action || !data) continue;
+    const auto image = action->GetIcon(active, gfx::Size(20, 20)).Rasterize(
+        &active->GetColorProvider());
+    const SkColor color = data->GetBadgeBackgroundColor(tab_id);
+    base::DictValue row;
+    row.Set("id", id);
+    row.Set("name", extension->name());
+    row.Set("iconPng", image.isNull() ? "" : webui::GetBitmapDataUrl(
+        image.GetRepresentation(1.0f).GetBitmap()));
+    row.Set("badgeText", data->GetDisplayBadgeText(tab_id));
+    row.Set("badgeColor", base::StringPrintf("rgba(%u,%u,%u,%.3f)",
+        SkColorGetR(color), SkColorGetG(color), SkColorGetB(color), SkColorGetA(color) / 255.0));
+    row.Set("enabled", action->IsEnabled(active));
+    row.Set("pinned", model->IsActionPinned(id));
+    row.Set("hasPopup", data->HasPopup(tab_id));
+    rows.Append(std::move(row));
+  }
+  return rows;
+}
+base::ListValue DescribeCommands(Profile* profile) {
+  base::ListValue rows;
+  auto* service = extensions::CommandService::Get(profile);
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  if (!service || !registry) return rows;
+  for (const auto& extension : registry->enabled_extensions()) {
+    ui::CommandMap commands;
+    service->GetNamedCommands(extension->id(), extensions::CommandService::ALL,
+        extensions::CommandService::ANY_SCOPE, &commands);
+    for (auto type : {extensions::ActionInfo::Type::kAction,
+                      extensions::ActionInfo::Type::kBrowser,
+                      extensions::ActionInfo::Type::kPage}) {
+      extensions::Command command;
+      if (service->GetExtensionActionCommand(extension->id(), type,
+          extensions::CommandService::ALL, &command, nullptr)) {
+        commands.emplace(command.command_name(), command);
+      }
+    }
+    for (const auto& [name, manifest_command] : commands) {
+      const auto command = service->FindCommandByName(extension->id(), name);
+      base::DictValue row;
+      row.Set("extensionId", extension->id());
+      row.Set("name", name);
+      row.Set("description", extension->name() + " — " +
+          (manifest_command.description().empty() ? "Open extension action"
+           : base::UTF16ToUTF8(manifest_command.description())));
+      row.Set("shortcut", command.accelerator().key_code() == ui::VKEY_UNKNOWN
+          ? "" : ui::Command::AcceleratorToString(command.accelerator()));
+      rows.Append(std::move(row));
+    }
+  }
+  return rows;
+}
+}  // namespace
+
+void PublishExtensionActions(BrowserWindowInterface* browser) {
+  if (!CanHostExtensionSidePanel(browser)) return;
+  auto json = base::WriteJson(DescribeActions(browser));
+  if (json) EmitShellEvent(browser->GetProfile(), "onExtensionActionsChanged", std::move(*json));
+}
+
+bool HandlesExtensionUI(std::string_view method) {
+  return method == "extensionActions" || method == "pinExtensionAction" ||
+      method == "extensionCommands" || method == "setExtensionCommandShortcut" ||
+      method == "showExtensionAction" || method == "extensionSidePanel";
+}
+
+void HandleExtensionUI(Browser* browser, std::string_view method,
+                       const base::ListValue& args, ExtensionBridge::Callback callback) {
+  if (!CanHostExtensionSidePanel(browser)) {
+    Reject(std::move(callback), "forbidden", "Extensions require a regular browser window");
+    return;
+  }
+  if (method == "extensionActions" || method == "extensionCommands") {
+    Reply(std::move(callback), base::Value(method == "extensionActions"
+        ? DescribeActions(browser) : DescribeCommands(browser->GetProfile())));
+    return;
+  }
+  if (method == "extensionSidePanel") {
+    if (args[0].GetString() == "close" && DescribeExtensionSidePanel(browser)) {
+      auto* window = WebUIBrowserWindow::FromBrowser(browser);
+      if (window) window->GetWebUIBrowserSidePanelUI()->Close(
+          SidePanelEntryHideReason::kSidePanelClosed, false);
+    }
+    auto panel = DescribeExtensionSidePanel(browser);
+    Reply(std::move(callback), panel ? base::Value(std::move(*panel)) : base::Value());
+    return;
+  }
+  const auto& id = args[0].GetString();
+  auto* registry = extensions::ExtensionRegistry::Get(browser->GetProfile());
+  const auto* extension = registry ? registry->enabled_extensions().GetByID(id) : nullptr;
+  if (!extension) {
+    Reject(std::move(callback), "not_found", "Extension is not installed and enabled");
+    return;
+  }
+  if (method == "setExtensionCommandShortcut") {
+    auto* service = extensions::CommandService::Get(browser->GetProfile());
+    const auto& name = args[1].GetString();
+    const auto commands = DescribeCommands(browser->GetProfile());
+    const bool exists = std::ranges::any_of(commands, [&](const base::Value& row) {
+      return *row.GetDict().FindString("extensionId") == id &&
+             *row.GetDict().FindString("name") == name;
+    });
+    const auto& shortcut = args[2].GetString();
+    const auto accelerator = extensions::Command::StringToAccelerator(shortcut, name);
+    if (!exists || (!shortcut.empty() && !IsAllowedAuxShortcut(accelerator))) {
+      Reject(std::move(callback), "invalid_argument", "Choose a valid shortcut that macOS does not reserve");
+      return;
+    }
+    service->UpdateKeybindingPrefs(id, name, shortcut);
+    const bool saved = service->FindCommandByName(id, name).accelerator() == accelerator;
+    Reply(std::move(callback), base::Value(saved));
+    return;
+  }
+  auto* model = ToolbarActionsModel::Get(browser->GetProfile());
+  auto* container = ExtensionsContainer::From(*browser);
+  auto* action = container ? container->GetActionForId(id) : nullptr;
+  if (!model || !model->HasAction(id) || !action) {
+    Reject(std::move(callback), "not_found", "Extension has no toolbar action");
+    return;
+  }
+  if (method == "pinExtensionAction") {
+    model->SetActionVisibility(id, args[1].GetBool());
+    Reply(std::move(callback), base::Value(model->IsActionPinned(id) == args[1].GetBool()));
+    return;
+  }
+  if (args.size() > 1 && !args[1].is_none()) {
+    auto* window = WebUIBrowserWindow::FromBrowser(browser);
+    auto* webui_container = window ? static_cast<WebUIToolbarExtensionsContainer*>(container) : nullptr;
+    const auto& rect = args[1].GetDict();
+    const gfx::Rect anchor(base::ClampRound(*rect.FindDouble("x")), base::ClampRound(*rect.FindDouble("y")),
+        base::ClampRound(*rect.FindDouble("width")), base::ClampRound(*rect.FindDouble("height")));
+    if (!webui_container || !webui_container->SetAuxPopupAnchor(id, anchor)) {
+      Reject(std::move(callback), "invalid_argument", "Extension action anchor is outside this window");
+      return;
+    }
+  }
+  if (!action->IsEnabled(browser->GetTabStripModel()->GetActiveWebContents())) {
+    Reject(std::move(callback), "conflict", "Extension action is unavailable on this page");
+    return;
+  }
+  action->ExecuteUserAction(ToolbarActionViewModel::InvocationSource::kToolbarButton);
+  Reply(std::move(callback), base::Value(true));
+  return;
+}
+
+namespace {
+bool UpdateExtensionPlacement(BrowserWindowInterface& browser,
+                               content::WebContents* contents,
+                               content::WebContents* opener, bool created, bool activate) {
+  if (!CanHostExtensionSidePanel(&browser)) return true;
+  auto* profile = browser.GetProfile();
+  auto* catalog = TabCatalog::GetForProfile(profile);
+  const auto page_id = PageIdentity::GetOrCreate(profile, contents);
+  BrowserWindowInterface* owner = nullptr;
+  if (!catalog || catalog->FindPage(page_id, &owner) != contents || owner != &browser ||
+      PageIdentity::FromWebContents(contents)->runtime_owned()) return false;
+  const auto window_id = base::NumberToString(browser.GetSessionID().id());
+  std::string error;
+  auto snapshot = OrganizationStore::Snapshot(profile, window_id, &error);
+  auto* layout = snapshot ? snapshot->FindDict("layout") : nullptr;
+  if (!layout) return false;
+  auto* shared = layout->FindDict("shared");
+  auto* window = layout->FindDict("window");
+  const auto* spaces = shared->FindList("spaces");
+  std::string space_id = *window->FindString("activeSpaceId");
+  if (created && opener) {
+    if (opener->GetBrowserContext() != profile) return false;
+    const auto opener_id = PageIdentity::GetOrCreate(profile, opener);
+    BrowserWindowInterface* opener_owner = nullptr;
+    if (catalog->FindPage(opener_id, &opener_owner) != opener || opener_owner != &browser) return false;
+    const auto& inherited = PageIdentity::FromWebContents(opener)->space_id();
+    if (!inherited.empty()) space_id = inherited;
+  } else if (!created) {
+    const auto& existing = PageIdentity::FromWebContents(contents)->space_id();
+    if (!existing.empty()) space_id = existing;
+  }
+  const auto found = std::ranges::find_if(*spaces, [&](const base::Value& space) {
+    return *space.GetDict().FindString("id") == space_id;
+  });
+  if (found == spaces->end()) return false;
+  const auto* workspace = found->GetDict().FindString("workspaceId");
+  if (created) {
+    shared->FindDict("tabSpace")->Set(page_id, space_id);
+    auto* order = shared->FindDict("order");
+    auto* rows = order->FindList(space_id);
+    if (!rows) rows = order->Set(space_id, base::ListValue())->GetIfList();
+    if (!std::ranges::any_of(*rows, [&](const base::Value& row) { return row.GetString() == page_id; })) {
+      rows->Append(page_id);
+    }
+  }
+  if (activate) {
+    window->Set("activeSpaceId", space_id);
+    window->FindDict("activeTabs")->Set(space_id, page_id);
+  }
+  if (!OrganizationStore::Commit(profile, window_id, *snapshot->FindInt("revision"), *layout, &error)) return false;
+  catalog->BindSpace(page_id, space_id, workspace ? *workspace : "");
+  return true;
+}
+}  // namespace
+
+bool PlaceExtensionTab(BrowserWindowInterface& browser,
+                       content::WebContents* contents,
+                       content::WebContents* opener, bool activate) {
+  return UpdateExtensionPlacement(browser, contents, opener, true, activate);
+}
+bool ActivateExtensionTab(BrowserWindowInterface& browser, content::WebContents* contents) {
+  return UpdateExtensionPlacement(browser, contents, nullptr, false, true);
+}
+
+}  // namespace aux
