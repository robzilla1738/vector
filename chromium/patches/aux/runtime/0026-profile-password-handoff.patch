+    std::move(callback).Run(NativeFault(
+        "conflict", "Another password fill is awaiting user approval"));
+    return;
+  }
+  credential_fill_ = std::make_unique<aux::CredentialFill>(
+      profile_, params.Clone(), std::move(cancelled),
+      base::BindOnce(
+          [](base::WeakPtr<AuxRuntimeHost> owner,
