@@ -0,0 +1,110 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_CREDENTIAL_FILL_H_
+#define CHROME_BROWSER_UI_AUX_CREDENTIAL_FILL_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <atomic>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "base/values.h"
+#include "components/password_manager/core/browser/password_form.h"
+#include "components/password_manager/core/browser/password_store/password_store_consumer.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+class Profile;
+namespace device_reauth {
+class DeviceAuthenticator;
+}
+
+namespace content {
+class RenderFrameHost;
+class WebContents;
+}
+
+namespace aux {
+
+// Pure request boundary. Unknown fields (including credential values and
+// references) are rejected before the password manager is touched.
+bool CredentialFillRequestAllowed(const base::DictValue& request,
+                                  const GURL& active_url,
+                                  const url::Origin& frame_origin);
+bool CredentialFillDocumentMatches(const base::DictValue& request,
+                                   const GURL& active_url,
+                                   const url::Origin& frame_origin,
+                                   int64_t active_navigation_id,
+                                   int64_t original_navigation_id);
+std::u16string CredentialFillAccountLabel(std::u16string_view username,
+                                          bool account_store);
+
+class CredentialFillPrompt {
+ public:
+  virtual ~CredentialFillPrompt() = default;
+  virtual void Close() = 0;
+};
+
+// The prompt exposes account labels only. Passwords remain in the browser
+// process and are sent solely to Chromium's PasswordManagerDriver.
+std::unique_ptr<CredentialFillPrompt> ShowCredentialFillPrompt(
+    const std::string& origin,
+    const std::vector<std::u16string>& accounts,
+    base::OnceCallback<void(std::optional<size_t>)> callback);
+
+// Single-use, Profile-owned handoff. The caller must retain it until the
+// callback runs. No credential data is included in the callback or RPC.
+class CredentialFill final : public password_manager::PasswordStoreConsumer {
+ public:
+  using Callback = base::OnceCallback<void(base::DictValue)>;
+  CredentialFill(Profile* profile,
+                 base::DictValue request,
+                 std::shared_ptr<std::atomic_bool> cancelled,
+                 Callback callback);
+  ~CredentialFill() override;
+  CredentialFill(const CredentialFill&) = delete;
+  CredentialFill& operator=(const CredentialFill&) = delete;
+
+  void Start();
+
+ private:
+  bool ActiveDocument() const;
+  void CheckTarget(base::OnceCallback<void(bool)> callback);
+  void OnTargetChecked(bool valid);
+  void OnGetPasswordStoreResultsOrErrorFrom(
+      password_manager::PasswordStoreInterface* store,
+      password_manager::LoginsResultOrError results) override;
+  void OnAccountChosen(std::optional<size_t> index);
+  void OnAuthenticated(size_t index, bool authorized);
+  void OnTargetRechecked(size_t index, bool valid);
+  void OnFilled(bool success);
+  void Finish(const char* status);
+
+  raw_ptr<Profile> profile_;
+  base::DictValue request_;
+  Callback callback_;
+  std::shared_ptr<std::atomic_bool> cancelled_;
+  base::WeakPtr<content::WebContents> page_;
+  raw_ptr<content::RenderFrameHost> frame_ = nullptr;
+  int64_t navigation_id_ = 0;
+  int pending_stores_ = 0;
+  std::vector<password_manager::PasswordForm> credentials_;
+  std::unique_ptr<CredentialFillPrompt> prompt_;
+  std::unique_ptr<device_reauth::DeviceAuthenticator> authenticator_;
+  base::OneShotTimer deadline_;
+  base::WeakPtrFactory<CredentialFill> weak_factory_{this};
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_CREDENTIAL_FILL_H_
