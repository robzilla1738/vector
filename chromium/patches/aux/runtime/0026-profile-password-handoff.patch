@@ -0,0 +1,84 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/credential_fill.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+namespace {
+
+base::DictValue Request() {
+  base::DictValue request;
+  request.Set("pageId", "page-1");
+  request.Set("expectedUrl", "https://example.test/login");
+  request.Set("usernameSelector", "input[name=user]");
+  request.Set("passwordSelector", "input[type=password]");
+  return request;
+}
+
+TEST(CredentialFillTest, AcceptsOnlyExactHttpsPageAndFrame) {
+  const GURL url("https://example.test/login");
+  EXPECT_TRUE(CredentialFillRequestAllowed(Request(), url,
+                                           url::Origin::Create(url)));
+  EXPECT_FALSE(CredentialFillRequestAllowed(
+      Request(), GURL("https://example.test/other"),
+      url::Origin::Create(url)));
+  EXPECT_FALSE(CredentialFillRequestAllowed(
+      Request(), url,
+      url::Origin::Create(GURL("https://other.test/login"))));
+  auto request = Request();
+  request.Set("expectedUrl", "http://example.test/login");
+  EXPECT_FALSE(CredentialFillRequestAllowed(
+      request, GURL("http://example.test/login"),
+      url::Origin::Create(GURL("http://example.test/login"))));
+}
+
+TEST(CredentialFillTest, RejectsStaleDocumentEvenAtTheSameUrl) {
+  const GURL url("https://example.test/login");
+  const auto origin = url::Origin::Create(url);
+  EXPECT_TRUE(CredentialFillDocumentMatches(Request(), url, origin, 42, 42));
+  EXPECT_FALSE(CredentialFillDocumentMatches(Request(), url, origin, 43, 42));
+  EXPECT_FALSE(CredentialFillDocumentMatches(
+      Request(), GURL("https://example.test/next"), origin, 42, 42));
+}
+
+TEST(CredentialFillTest, RejectsSecretAndCredentialReferenceFields) {
+  const GURL url("https://example.test/login");
+  for (const char* key : {"value", "password", "credentialRef", "accountLabel"}) {
+    auto request = Request();
+    request.Set(key, "secret");
+    EXPECT_FALSE(CredentialFillRequestAllowed(request, url,
+                                              url::Origin::Create(url)));
+  }
+}
+
+TEST(CredentialFillTest, RejectsAmbiguousOrUnsafeSelectors) {
+  const GURL url("https://example.test/login");
+  auto request = Request();
+  request.Set("passwordSelector", "");
+  EXPECT_FALSE(CredentialFillRequestAllowed(request, url,
+                                            url::Origin::Create(url)));
+  request.Set("passwordSelector", "input\n[type=password]");
+  EXPECT_FALSE(CredentialFillRequestAllowed(request, url,
+                                            url::Origin::Create(url)));
+  request.Set("passwordSelector", std::string(1001, 'p'));
+  EXPECT_FALSE(CredentialFillRequestAllowed(request, url,
+                                            url::Origin::Create(url)));
+}
+
+TEST(CredentialFillTest, AccountChoiceStripsUntrustedVisualControls) {
+  const auto label = CredentialFillAccountLabel(
+      u"alice\n\u202eFill for other.test\u2028\u061c", true);
+  EXPECT_EQ(label.find(u'\n'), std::u16string::npos);
+  EXPECT_EQ(label.find(u'\u202e'), std::u16string::npos);
+  EXPECT_EQ(label.find(u'\u2028'), std::u16string::npos);
+  EXPECT_EQ(label.find(u'\u061c'), std::u16string::npos);
+  EXPECT_NE(label.find(u"Account store"), std::u16string::npos);
+  EXPECT_LE(CredentialFillAccountLabel(std::u16string(500, u'a'), false).size(),
+            128u);
+}
+
+}  // namespace
+}  // namespace aux
