@@ -0,0 +1,92 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/credential_fill.h"
+
+#import <Cocoa/Cocoa.h>
+
+#include <utility>
+
+#include "base/memory/weak_ptr.h"
+#include "base/strings/sys_string_conversions.h"
+
+namespace aux {
+namespace {
+
+class MacCredentialFillPrompt final : public CredentialFillPrompt {
+ public:
+  MacCredentialFillPrompt(
+      const std::string& origin,
+      const std::vector<std::u16string>& accounts,
+      base::OnceCallback<void(std::optional<size_t>)> callback)
+      : callback_(std::move(callback)) {
+    NSWindow* window = NSApp.keyWindow;
+    if (!window || accounts.empty())
+      return;
+    alert_ = [[NSAlert alloc] init];
+    alert_.alertStyle = NSAlertStyleInformational;
+    alert_.messageText = @"Fill a saved password?";
+    alert_.informativeText = [NSString
+        stringWithFormat:@"Choose an account for %@. Aux will fill only this "
+                          @"active page. The saved password stays in this "
+                          @"browser Profile.",
+                         base::SysUTF8ToNSString(origin)];
+    [alert_ addButtonWithTitle:@"Fill password"];
+    [alert_ addButtonWithTitle:@"Cancel"];
+
+    popup_ = [[NSPopUpButton alloc]
+        initWithFrame:NSMakeRect(0, 0, 300, 30)
+             pullsDown:NO];
+    for (const auto& account : accounts) {
+      const std::u16string bounded = account.substr(0, 128);
+      [popup_ addItemWithTitle:base::SysUTF16ToNSString(bounded)];
+    }
+    alert_.accessoryView = popup_;
+    auto weak = weak_factory_.GetWeakPtr();
+    [alert_ beginSheetModalForWindow:window
+                  completionHandler:^(NSModalResponse response) {
+                    if (!weak)
+                      return;
+                    auto callback = std::move(weak->callback_);
+                    if (response == NSAlertFirstButtonReturn &&
+                        weak->popup_.indexOfSelectedItem >= 0) {
+                      std::move(callback).Run(static_cast<size_t>(
+                          weak->popup_.indexOfSelectedItem));
+                    } else {
+                      std::move(callback).Run(std::nullopt);
+                    }
+                  }];
+  }
+
+  ~MacCredentialFillPrompt() override { Close(); }
+
+  bool showing() const { return alert_ != nil; }
+
+  void Close() override {
+    weak_factory_.InvalidateWeakPtrs();
+    if (alert_ && alert_.window.sheetParent)
+      [NSApp endSheet:alert_.window returnCode:NSAlertSecondButtonReturn];
+    alert_ = nil;
+    popup_ = nil;
+  }
+
+ private:
+  NSAlert* __strong alert_ = nil;
+  NSPopUpButton* __strong popup_ = nil;
+  base::OnceCallback<void(std::optional<size_t>)> callback_;
+  base::WeakPtrFactory<MacCredentialFillPrompt> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<CredentialFillPrompt> ShowCredentialFillPrompt(
+    const std::string& origin,
+    const std::vector<std::u16string>& accounts,
+    base::OnceCallback<void(std::optional<size_t>)> callback) {
+  auto prompt = std::make_unique<MacCredentialFillPrompt>(
+      origin, accounts, std::move(callback));
+  return prompt->showing() ? std::move(prompt) : nullptr;
+}
+
+}  // namespace aux
