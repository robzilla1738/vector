+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/content_blocking_policy.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+
+TEST(ContentBlockingPolicyTest, ParsesOnlyBoundedHostsLines) {
+  const auto hosts = ParseBlockingHosts(
+      "# comment\n0.0.0.0 ads.example.test # label\n"
+      "tracker.example.test\n127.0.0.1 localhost\n"
+      "||malformed.example.test^\n0.0.0.0 ads.example.test\n",
+      400000);
+  EXPECT_EQ(hosts.size(), 2u);
+  EXPECT_TRUE(hosts.contains("ads.example.test"));
+  EXPECT_TRUE(hosts.contains("tracker.example.test"));
+}
+
+TEST(ContentBlockingPolicyTest, BlocksSubresourcesAndRedirectDestinations) {
+  const BlockingHosts blocked{"example.test"};
+  const BlockingHosts allowed{"allowed.test"};
+  EXPECT_TRUE(ShouldBlockSubresource(GURL("https://ads.example.test/a.js"),
+                                     "news.test", false, true, blocked,
+                                     allowed));
+  EXPECT_FALSE(ShouldBlockSubresource(GURL("https://ads.example.test/"),
+                                      "news.test", true, true, blocked,
+                                      allowed));
+  EXPECT_FALSE(ShouldBlockSubresource(GURL("https://ads.example.test/a.js"),
+                                      "sub.allowed.test", false, true, blocked,
+                                      allowed));
+  EXPECT_FALSE(ShouldBlockSubresource(GURL("https://ads.example.test/a.js"),
+                                      "news.test", false, false, blocked,
+                                      allowed));
+  EXPECT_FALSE(ShouldBlockSubresource(GURL("file:///ads.example.test/a.js"),
+                                      "news.test", false, true, blocked,
+                                      allowed));
+}
+
+TEST(ContentBlockingPolicyTest, ValidatesDomainAndSuffix) {
+  EXPECT_TRUE(IsBlockingHost("ads.example.test"));
+  EXPECT_FALSE(IsBlockingHost("localhost"));
+  EXPECT_FALSE(IsBlockingHost("1.2.3.4"));
+  EXPECT_FALSE(IsBlockingHost("-ads.example.test"));
+  EXPECT_FALSE(IsBlockingHost("ads.example..test"));
+  EXPECT_TRUE(IsAllowedSiteHost("localhost"));
+  EXPECT_TRUE(IsAllowedSiteHost("127.0.0.1"));
+  EXPECT_FALSE(IsAllowedSiteHost("evil.test/path"));
+  EXPECT_TRUE(
+      BlockingHostMatches(BlockingHosts{"example.test"}, "ads.example.test"));
+  EXPECT_FALSE(
+      BlockingHostMatches(BlockingHosts{"example.test"}, "notexample.test"));
+}
+
+}  // namespace aux
