diff --git a/chrome/browser/ui/aux/content_blocking_policy.cc b/chrome/browser/ui/aux/content_blocking_policy.cc
new file mode 100644
index 0000000000..62af9327e7
--- /dev/null
+++ b/chrome/browser/ui/aux/content_blocking_policy.cc
@@ -0,0 +1,121 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/content_blocking_policy.h"
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+
+namespace aux {
+
+bool IsBlockingHost(std::string_view host) {
+  if (host.empty() || host.size() > 253 || host.find('.') == host.npos ||
+      host == "localhost" || host.ends_with(".localhost") ||
+      host.ends_with(".local")) {
+    return false;
+  }
+  size_t label_start = 0;
+  bool all_numeric = true;
+  while (label_start < host.size()) {
+    const size_t end = host.find('.', label_start);
+    const size_t label_end = end == host.npos ? host.size() : end;
+    const auto label = host.substr(label_start, label_end - label_start);
+    if (label.empty() || label.size() > 63 || label.front() == '-' ||
+        label.back() == '-') {
+      return false;
+    }
+    for (char c : label) {
+      if (c >= 'a' && c <= 'z') {
+        all_numeric = false;
+      } else if (c >= '0' && c <= '9') {
+      } else if (c == '-') {
+        all_numeric = false;
+      } else {
+        return false;
+      }
+    }
+    if (end == host.npos) {
+      break;
+    }
+    label_start = end + 1;
+  }
+  return !all_numeric;
+}
+
+bool IsAllowedSiteHost(std::string_view host) {
+  if (host.empty() || host.size() > 253 ||
+      host.find_first_of("/?#@\\") != host.npos) {
+    return false;
+  }
+  const GURL url("https://" + std::string(host) + "/");
+  return url.is_valid() && url.host() == host;
+}
+
+BlockingHosts ParseBlockingHosts(std::string_view text, size_t limit) {
+  BlockingHosts hosts;
+  if (limit == 0) {
+    return hosts;
+  }
+  for (std::string_view line : base::SplitStringPiece(
+           text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    line = line.substr(0, line.find('#'));
+    const auto tokens = base::SplitStringPiece(
+        line, " \t\r", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (tokens.empty() || tokens.size() > 2) {
+      continue;
+    }
+    std::string_view host;
+    if (tokens.size() == 1) {
+      host = tokens.front();
+    } else if (tokens.front() == "0.0.0.0" || tokens.front() == "127.0.0.1" ||
+               tokens.front() == "255.255.255.255" || tokens.front() == "::1") {
+      host = tokens.back();
+    }
+    const std::string normalized = base::ToLowerASCII(host);
+    if (IsBlockingHost(normalized)) {
+      hosts.insert(normalized);
+      if (hosts.size() >= limit) {
+        break;
+      }
+    }
+  }
+  return hosts;
+}
+
+bool BlockingHostMatches(const BlockingHosts& hosts, std::string_view host) {
+  if (host.empty()) {
+    return false;
+  }
+  if (hosts.contains(std::string(host))) {
+    return true;
+  }
+  size_t dot = host.find('.');
+  while (dot != host.npos) {
+    host.remove_prefix(dot + 1);
+    if (hosts.contains(std::string(host))) {
+      return true;
+    }
+    dot = host.find('.');
+  }
+  return false;
+}
+
+bool ShouldBlockSubresource(const GURL& request_url,
+                            std::string_view top_site_host,
+                            bool main_frame,
+                            bool enabled,
+                            const BlockingHosts& blocked,
+                            const BlockingHosts& allowed) {
+  if (main_frame || !enabled || !request_url.SchemeIsHTTPOrHTTPS() ||
+      !BlockingHostMatches(blocked, request_url.host())) {
+    return false;
+  }
+  return !BlockingHostMatches(allowed, top_site_host);
+}
+
+}  // namespace aux
