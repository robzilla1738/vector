new file mode 100644
index 0000000000..30748a798a
--- /dev/null
+++ b/chrome/browser/ui/aux/content_blocking_controller.cc
@@ -0,0 +1,537 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/content_blocking_controller.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/bind_post_task.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "crypto/sha2.h"
+#include "net/base/net_errors.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+
+namespace aux {
+namespace {
+const char kContentBlockingKey = 0;
+constexpr size_t kMaxHosts = 400000;
+constexpr size_t kMaxAllowed = 4096;
+constexpr size_t kMaxSnapshotBytes = 32 * 1024 * 1024;
+#include "chrome/browser/ui/aux/content_blocking_seed.inc"
+
+std::string Digest(std::string_view text) {
+  return base::HexEncodeLower(crypto::SHA256HashString(text));
+}
+
+bool ValidDigest(std::string_view digest) {
+  return digest.size() == 64 && std::ranges::all_of(digest, [](char c) {
+           return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+         });
+}
+
+bool ValidGeneration(std::optional<double> generation) {
+  return generation && std::isfinite(*generation) && *generation >= 1 &&
+         *generation <= 9007199254740991.0 &&
+         std::floor(*generation) == *generation;
+}
+
+base::FilePath SnapshotPath(Profile* profile) {
+  return profile->GetPath()
+      .Append(FILE_PATH_LITERAL("Aux Blocking"))
+      .Append(FILE_PATH_LITERAL("snapshot.json"));
+}
+
+BlockingHosts BuiltInHosts() {
+  BlockingHosts hosts;
+  for (const char* host : kBuiltInBlockingHosts) {
+    hosts.insert(host);
+  }
+  return hosts;
+}
+
+bool IsSortedHostList(const base::ListValue& list,
+                      size_t expected_count,
+                      std::vector<std::string>* hosts) {
+  if (list.size() != expected_count || list.size() > kMaxHosts) {
+    return false;
+  }
+  hosts->reserve(list.size());
+  for (const base::Value& value : list) {
+    const std::string* host = value.GetIfString();
+    if (!host || !IsBlockingHost(*host) ||
+        (!hosts->empty() && hosts->back() >= *host)) {
+      return false;
+    }
+    hosts->push_back(*host);
+  }
+  return true;
+}
+
+std::string JoinHosts(const std::vector<std::string>& hosts) {
+  std::string joined;
+  for (const std::string& host : hosts) {
+    if (!joined.empty()) {
+      joined.push_back('\n');
+    }
+    joined.append(host);
+  }
+  return joined;
+}
+
+bool IncludesBuiltInHosts(const std::vector<std::string>& hosts) {
+  for (const char* built_in : kBuiltInBlockingHosts) {
+    if (!std::binary_search(hosts.begin(), hosts.end(), built_in)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::DictValue Accepted() {
+  base::DictValue result;
+  result.Set("accepted", true);
+  return result;
+}
+
+bool SiteGuardMatches(Profile* profile, const base::DictValue& guard) {
+  const std::string* page_id = guard.FindString("pageId");
+  const std::string* expected_url = guard.FindString("expectedUrl");
+  const auto navigation_id = guard.FindInt("navigationId");
+  if (!page_id || !expected_url || !navigation_id || page_id->size() > 128 ||
+      expected_url->size() > 2048) {
+    return false;
+  }
+  auto* catalog = TabCatalog::GetForProfile(profile);
+  content::WebContents* contents =
+      catalog ? catalog->FindPage(*page_id) : nullptr;
+  const content::NavigationEntry* entry =
+      contents ? contents->GetController().GetLastCommittedEntry() : nullptr;
+  return contents && entry &&
+         contents->GetLastCommittedURL().spec() == *expected_url &&
+         contents->GetLastCommittedURL().SchemeIsHTTPOrHTTPS() &&
+         entry->GetUniqueID() == *navigation_id;
+}
+
+}  // namespace
+
+struct ContentBlockingController::Rules {
+  double generation = 0;
+  std::string digest;
+  bool enabled = true;
+  BlockingHosts blocked = BuiltInHosts();
+  BlockingHosts allowed;
+};
+
+struct ContentBlockingController::Staging {
+  double generation = 0;
+  std::string digest;
+  size_t host_count = 0;
+  bool enabled = true;
+  std::vector<std::string> hosts;
+  BlockingHosts allowed;
+  std::optional<base::DictValue> site_guard;
+};
+
+class BlockingThrottle final : public blink::URLLoaderThrottle {
+ public:
+  BlockingThrottle(
+      std::shared_ptr<const ContentBlockingController::Rules> rules,
+      std::string top_site_host,
+      bool main_frame,
+      base::RepeatingCallback<void(std::string)> on_blocked)
+      : rules_(std::move(rules)),
+        top_site_host_(std::move(top_site_host)),
+        main_frame_(main_frame),
+        on_blocked_(std::move(on_blocked)) {}
+  ~BlockingThrottle() override = default;
+
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override {
+    MaybeBlock(request->url);
+  }
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params) override {
+    MaybeBlock(redirect_info->new_url);
+  }
+
+ private:
+  void MaybeBlock(const GURL& url) {
+    if (!ShouldBlockSubresource(url, top_site_host_, main_frame_,
+                                rules_->enabled, rules_->blocked,
+                                rules_->allowed)) {
+      return;
+    }
+    on_blocked_.Run(top_site_host_);
+    delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT,
+                               "Aux content filter");
+  }
+
+  std::shared_ptr<const ContentBlockingController::Rules> rules_;
+  const std::string top_site_host_;
+  const bool main_frame_;
+  base::RepeatingCallback<void(std::string)> on_blocked_;
+};
+
+ContentBlockingController* ContentBlockingController::ForProfile(
+    Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile) {
+    return nullptr;
+  }
+  auto* owner = static_cast<ContentBlockingController*>(
+      profile->GetUserData(&kContentBlockingKey));
+  if (!owner) {
+    auto created = std::unique_ptr<ContentBlockingController>(
+        new ContentBlockingController(profile));
+    owner = created.get();
+    profile->SetUserData(&kContentBlockingKey, std::move(created));
+  }
+  owner->SyncPrivateRules();
+  return owner;
+}
+
+ContentBlockingController::ContentBlockingController(Profile* profile)
+    : profile_(profile), rules_(std::make_shared<Rules>()) {
+  if (!profile->IsOffTheRecord()) {
+    Load();
+  }
+}
+ContentBlockingController::~ContentBlockingController() = default;
+
+void ContentBlockingController::Load() {
+  std::string text;
+  if (!base::ReadFileToStringWithMaxSize(SnapshotPath(profile_), &text,
+                                         kMaxSnapshotBytes)) {
+    return;
+  }
+  const auto root = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  if (!root) {
+    return;
+  }
+  const auto generation = root->FindDouble("generation");
+  const std::string* digest = root->FindString("hostsDigest");
+  const base::ListValue* host_list = root->FindList("hosts");
+  const base::ListValue* allowed_list = root->FindList("allowedSiteHosts");
+  const auto enabled = root->FindBool("enabled");
+  if (!ValidGeneration(generation) || !digest || !ValidDigest(*digest) ||
+      !host_list || !allowed_list || !enabled ||
+      allowed_list->size() > kMaxAllowed) {
+    return;
+  }
+  std::vector<std::string> hosts;
+  if (!IsSortedHostList(*host_list, host_list->size(), &hosts) ||
+      !IncludesBuiltInHosts(hosts) || Digest(JoinHosts(hosts)) != *digest) {
+    return;
+  }
+  auto next = std::make_shared<Rules>();
+  next->generation = *generation;
+  next->digest = *digest;
+  next->enabled = *enabled;
+  next->blocked = BlockingHosts(hosts.begin(), hosts.end());
+  for (const base::Value& value : *allowed_list) {
+    const std::string* host = value.GetIfString();
+    if (!host || !IsAllowedSiteHost(*host)) {
+      return;
+    }
+    next->allowed.insert(*host);
+  }
+  rules_ = std::move(next);
+}
+
+void ContentBlockingController::SyncPrivateRules() {
+  if (!profile_->IsOffTheRecord()) {
+    return;
+  }
+  auto* original = ForProfile(profile_->GetOriginalProfile());
+  if (original && original->rules_->generation > rules_->generation) {
+    auto next = std::make_shared<Rules>(*original->rules_);
+    for (const auto& [host, allowed] : private_site_overrides_) {
+      if (allowed) {
+        next->allowed.insert(host);
+      } else {
+        next->allowed.erase(host);
+      }
+    }
+    if (private_enabled_override_) {
+      next->enabled = *private_enabled_override_;
+    }
+    rules_ = std::move(next);
+  }
+}
+
+std::optional<base::DictValue> ContentBlockingController::Begin(
+    const base::DictValue& params,
+    std::string* error) {
+  if (profile_->IsOffTheRecord()) {
+    *error = "Private Profiles cannot install filter lists";
+    return std::nullopt;
+  }
+  const std::string* profile_id = params.FindString("profileId");
+  const std::string* digest = params.FindString("hostsDigest");
+  const auto generation = params.FindDouble("generation");
+  const auto host_count = params.FindInt("hostCount");
+  const auto enabled = params.FindBool("enabled");
+  const base::ListValue* allowed = params.FindList("allowedSiteHosts");
+  const base::Value* guard_value = params.Find("siteGuard");
+  const base::DictValue* guard = params.FindDict("siteGuard");
+  if (!profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() || !digest ||
+      !ValidDigest(*digest) || !ValidGeneration(generation) ||
+      *generation <= rules_->generation || !host_count || *host_count < 0 ||
+      *host_count > static_cast<int>(kMaxHosts) || !enabled || !allowed ||
+      allowed->size() > kMaxAllowed) {
+    *error = "Invalid content blocking snapshot header";
+    return std::nullopt;
+  }
+  if (guard_value && (!guard || !SiteGuardMatches(profile_, *guard))) {
+    *error = "Content blocking page changed";
+    return std::nullopt;
+  }
+  auto staged = std::make_unique<Staging>();
+  staged->generation = *generation;
+  staged->digest = *digest;
+  staged->host_count = *host_count;
+  staged->enabled = *enabled;
+  staged->hosts.reserve(*host_count);
+  if (guard) {
+    staged->site_guard = guard->Clone();
+  }
+  for (const base::Value& value : *allowed) {
+    const std::string* host = value.GetIfString();
+    if (!host || !IsAllowedSiteHost(*host)) {
+      *error = "Invalid content blocking site exception";
+      return std::nullopt;
+    }
+    staged->allowed.insert(*host);
+  }
+  staging_ = std::move(staged);
+  return Accepted();
+}
+
+std::optional<base::DictValue> ContentBlockingController::Append(
+    const base::DictValue& params,
+    std::string* error) {
+  const auto generation = params.FindDouble("generation");
+  const auto offset = params.FindInt("offset");
+  const std::string* profile_id = params.FindString("profileId");
+  const base::ListValue* hosts = params.FindList("hosts");
+  if (!staging_ || !profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() ||
+      !generation || *generation != staging_->generation || !offset ||
+      *offset != static_cast<int>(staging_->hosts.size()) || !hosts ||
+      hosts->empty() || hosts->size() > 1024 ||
+      staging_->hosts.size() + hosts->size() > staging_->host_count) {
+    staging_.reset();
+    *error = "Invalid content blocking snapshot chunk";
+    return std::nullopt;
+  }
+  for (const base::Value& value : *hosts) {
+    const std::string* host = value.GetIfString();
+    if (!host || !IsBlockingHost(*host) ||
+        (!staging_->hosts.empty() && staging_->hosts.back() >= *host)) {
+      staging_.reset();
+      *error = "Invalid content blocking host order";
+      return std::nullopt;
+    }
+    staging_->hosts.push_back(*host);
+  }
+  return Accepted();
+}
+
+bool ContentBlockingController::Persist(const Staging& staging,
+                                        std::string* error) {
+  base::DictValue root;
+  root.Set("generation", staging.generation);
+  root.Set("hostsDigest", staging.digest);
+  root.Set("enabled", staging.enabled);
+  base::ListValue hosts;
+  for (const auto& host : staging.hosts) {
+    hosts.Append(host);
+  }
+  root.Set("hosts", std::move(hosts));
+  base::ListValue allowed;
+  for (const auto& host : staging.allowed) {
+    allowed.Append(host);
+  }
+  root.Set("allowedSiteHosts", std::move(allowed));
+  const auto encoded = base::WriteJson(root);
+  const base::FilePath path = SnapshotPath(profile_);
+  const base::FilePath temp = path.AddExtension(FILE_PATH_LITERAL("tmp"));
+  if (!encoded || encoded->size() > kMaxSnapshotBytes ||
+      !base::CreateDirectory(path.DirName()) ||
+      !base::SetPosixFilePermissions(path.DirName(), 0700) ||
+      !base::WriteFile(temp, *encoded) ||
+      !base::SetPosixFilePermissions(temp, 0600) ||
+      !base::ReplaceFile(temp, path, nullptr)) {
+    base::DeleteFile(temp);
+    *error = "Chromium could not persist the filter snapshot";
+    return false;
+  }
+  return true;
+}
+
+std::optional<base::DictValue> ContentBlockingController::Commit(
+    const base::DictValue& params,
+    std::string* error) {
+  const auto generation = params.FindDouble("generation");
+  const std::string* digest = params.FindString("hostsDigest");
+  const std::string* profile_id = params.FindString("profileId");
+  if (!staging_ || !generation || *generation != staging_->generation ||
+      !digest || *digest != staging_->digest || !profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() ||
+      staging_->hosts.size() != staging_->host_count ||
+      !IncludesBuiltInHosts(staging_->hosts) ||
+      Digest(JoinHosts(staging_->hosts)) != staging_->digest) {
+    staging_.reset();
+    *error = "Content blocking snapshot digest mismatch";
+    return std::nullopt;
+  }
+  if (staging_->site_guard &&
+      !SiteGuardMatches(profile_, *staging_->site_guard)) {
+    staging_.reset();
+    *error = "Content blocking page changed";
+    return std::nullopt;
+  }
+  if (!Persist(*staging_, error)) {
+    staging_.reset();
+    return std::nullopt;
+  }
+  auto next = std::make_shared<Rules>();
+  next->generation = staging_->generation;
+  next->digest = staging_->digest;
+  next->enabled = staging_->enabled;
+  next->blocked = BlockingHosts(staging_->hosts.begin(), staging_->hosts.end());
+  next->allowed = std::move(staging_->allowed);
+  const int count = static_cast<int>(next->blocked.size());
+  const double applied_generation = next->generation;
+  const std::string applied_digest = next->digest;
+  rules_ = std::move(next);
+  staging_.reset();
+  base::DictValue receipt;
+  receipt.Set("backend", "subresource_filter");
+  receipt.Set("generation", applied_generation);
+  receipt.Set("hostsDigest", applied_digest);
+  receipt.Set("installedRules", count);
+  return receipt;
+}
+
+std::unique_ptr<blink::URLLoaderThrottle>
+ContentBlockingController::CreateThrottle(
+    const network::ResourceRequest& request,
+    std::string top_site_host) {
+  SyncPrivateRules();
+  if (!rules_->enabled) {
+    return nullptr;
+  }
+  const bool main_frame = request.is_outermost_main_frame;
+  return std::make_unique<BlockingThrottle>(
+      rules_, base::ToLowerASCII(top_site_host), main_frame,
+      base::BindPostTask(
+          base::SequencedTaskRunner::GetCurrentDefault(),
+          base::BindRepeating(&ContentBlockingController::NoteBlocked,
+                              weak_factory_.GetWeakPtr())));
+}
+
+std::unique_ptr<blink::URLLoaderThrottle>
+ContentBlockingController::CreateKeepAliveThrottle(std::string top_site_host) {
+  SyncPrivateRules();
+  if (!rules_->enabled) {
+    return nullptr;
+  }
+  return std::make_unique<BlockingThrottle>(
+      rules_, base::ToLowerASCII(top_site_host), false,
+      base::BindPostTask(
+          base::SequencedTaskRunner::GetCurrentDefault(),
+          base::BindRepeating(&ContentBlockingController::NoteBlocked,
+                              weak_factory_.GetWeakPtr())));
+}
+
+void ContentBlockingController::NoteBlocked(std::string site_host) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  ++total_blocked_;
+  if (!site_host.empty() &&
+      (by_site_.contains(site_host) || by_site_.size() < kMaxAllowed)) {
+    int& count = by_site_[site_host];
+    if (count < std::numeric_limits<int>::max()) ++count;
+  }
+}
+
+bool ContentBlockingController::enabled() const {
+  return rules_->enabled;
+}
+bool ContentBlockingController::IsAllowed(std::string_view site_host) const {
+  return BlockingHostMatches(rules_->allowed, site_host);
+}
+int ContentBlockingController::blocked_count() const {
+  return static_cast<int>(
+      std::min<uint64_t>(total_blocked_, std::numeric_limits<int>::max()));
+}
+int ContentBlockingController::BlockedForSite(
+    std::string_view site_host) const {
+  auto it = by_site_.find(std::string(site_host));
+  return it == by_site_.end() ? 0 : it->second;
+}
+std::vector<std::string> ContentBlockingController::allowed_hosts() const {
+  std::vector<std::string> hosts(rules_->allowed.begin(), rules_->allowed.end());
+  std::sort(hosts.begin(), hosts.end());
+  return hosts;
+}
+bool ContentBlockingController::SetPrivateSiteAllowed(std::string_view host,
+                                                      bool allowed) {
+  if (!profile_->IsOffTheRecord() || !IsAllowedSiteHost(host) ||
+      (private_site_overrides_.size() >= kMaxAllowed &&
+       !private_site_overrides_.contains(std::string(host)))) {
+    return false;
+  }
+  SyncPrivateRules();
+  auto next = std::make_shared<Rules>(*rules_);
+  if (allowed) {
+    if (next->allowed.size() >= kMaxAllowed &&
+        !next->allowed.contains(std::string(host))) {
+      return false;
+    }
+    next->allowed.insert(std::string(host));
+  } else {
+    next->allowed.erase(std::string(host));
+  }
+  private_site_overrides_[std::string(host)] = allowed;
+  rules_ = std::move(next);
+  return true;
+}
+
+bool ContentBlockingController::SetPrivateEnabled(bool enabled) {
+  if (!profile_->IsOffTheRecord()) {
+    return false;
+  }
+  SyncPrivateRules();
+  auto next = std::make_shared<Rules>(*rules_);
+  next->enabled = enabled;
+  private_enabled_override_ = enabled;
+  rules_ = std::move(next);
+  return true;
+}
+
+}  // namespace aux
