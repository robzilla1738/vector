+IN_PROC_BROWSER_TEST_F(NativePersonObserverControllerBrowserTest,
+                       NativeReadSessionRetainsOriginalDocumentAndConnection) {
+  auto* authority = EgressController::ForProfile(browser()->GetProfile());
