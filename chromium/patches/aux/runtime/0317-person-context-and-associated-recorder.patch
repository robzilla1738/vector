+  mojo::AssociatedReceiverSet<mojom::AuxRecorder, std::shared_ptr<ReceiverScope>> receivers_;
+  mojo::AssociatedRemote<mojom::AuxRecorderSink> sink_;
+  base::WeakPtrFactory<AuxRecorderAgent> weak_factory_{this};
+};
