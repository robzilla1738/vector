+TEST_F(PictureInPictureControllerTestWithWidget,
+       EmptyAutomaticTicketRejectsBeforeServiceAndKeepsContext) {
+  V8TestingScope scope;
+  auto& controller = PictureInPictureControllerImpl::From(GetDocument());
+  const base::UnguessableToken empty_ticket;
+  LocalFrame::NotifyUserActivation(
+      &GetFrame(), mojom::blink::UserActivationNotificationType::kTest);
+  controller.SetAutomaticPictureInPictureContext(empty_ticket);
+  EXPECT_CALL(Service(), StartSession(_, _, _, _, _, _, _, _, _, _)).Times(0);
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<PictureInPictureWindow>>(
+          scope.GetScriptState());
+  auto promise = resolver->Promise();
+  controller.EnterAutomaticPictureInPicture(Video(), empty_ticket, resolver);
+  ASSERT_EQ(v8::Promise::kRejected, promise.V8Promise()->State());
+  auto* error = V8DOMException::ToWrappable(
+      scope.GetIsolate(), promise.V8Promise()->Result());
+  ASSERT_NE(error, nullptr);
+  EXPECT_EQ(static_cast<int>(DOMExceptionCode::kNotSupportedError), error->code());
+  // The non-promise browser route also refuses before service setup.
+  controller.EnterAutomaticPictureInPicture(Video(), empty_ticket, nullptr);
+  test::RunPendingTasks();
+  EXPECT_FALSE(controller.IsSessionObserverReceiverBoundForTesting());
+  EXPECT_EQ(nullptr, controller.PictureInPictureElement());
+  EXPECT_EQ(nullptr, controller.pictureInPictureWindow());
+  EXPECT_TRUE(LocalFrame::HasTransientUserActivation(&GetFrame()));
+  ASSERT_TRUE(controller.AutomaticPictureInPictureContext());
+  EXPECT_TRUE(controller.AutomaticPictureInPictureContext()->is_empty());
+}
