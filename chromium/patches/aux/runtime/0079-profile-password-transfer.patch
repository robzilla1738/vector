+constexpr std::string_view kTransferAAD = "aux-vault-transfer:v1";
+constexpr size_t kMaxTransferItems = 500;
+constexpr size_t kMaxTransferBytes = 4'001'024;
+
+struct TransferWriteResult {
+  bool saved = false;
+  size_t exported = 0;
+  size_t skipped = 0;
+};
+
+struct TransferReadResult {
+  bool valid = false;
+  std::vector<password_manager::CSVPassword> passwords;
+  size_t skipped = 0;
+};
+
+bool DeriveTransferKey(std::string_view passphrase,
+                       base::span<const uint8_t> salt,
+                       base::span<uint8_t> key) {
+  return EVP_PBE_scrypt(passphrase.data(), passphrase.size(), salt.data(),
+                        salt.size(), 16384, 8, 1, 64 * 1024 * 1024,
+                        key.data(), key.size()) == 1;
+}
+
+void CleanseTransferPassphrase(std::string* passphrase) {
+  OPENSSL_cleanse(passphrase->data(), passphrase->size());
+}
+
+TransferWriteResult WritePasswordTransfer(
+    base::FilePath destination,
+    std::string passphrase,
+    base::ListValue items,
+    size_t skipped) {
+  base::ScopedClosureRunner cleanse_passphrase(base::BindOnce(
+      &CleanseTransferPassphrase, &passphrase));
+  TransferWriteResult result{false, items.size(), skipped};
+  base::DictValue plain;
+  plain.Set("exportedAt", static_cast<double>(
+      base::Time::Now().InMillisecondsSinceUnixEpoch()));
+  plain.Set("items", std::move(items));
+  auto plaintext = base::WriteJson(base::Value(std::move(plain)));
+  if (!plaintext)
+    return result;
+  if (plaintext->size() > 3'000'000) {
+    OPENSSL_cleanse(plaintext->data(), plaintext->size());
+    return result;
+  }
+  std::array<uint8_t, 16> salt;
+  std::array<uint8_t, 12> nonce;
+  std::array<uint8_t, 32> key;
+  base::RandBytes(salt);
+  base::RandBytes(nonce);
+  if (!DeriveTransferKey(passphrase, salt, key)) {
+    OPENSSL_cleanse(plaintext->data(), plaintext->size());
+    return result;
+  }
+  auto sealed = crypto::aead::Seal(
+      crypto::aead::AES_256_GCM, key, base::as_byte_span(*plaintext), nonce,
+      base::as_byte_span(kTransferAAD));
+  OPENSSL_cleanse(key.data(), key.size());
+  OPENSSL_cleanse(plaintext->data(), plaintext->size());
+  if (sealed.size() < 16)
+    return result;
+  const size_t body_length = sealed.size() - 16;
+  base::DictValue package;
+  package.Set("format", "aux-vault-transfer");
+  package.Set("version", 1);
+  package.Set("kdf", "scrypt-n16384-r8-p1");
+  package.Set("cipher", "aes-256-gcm");
+  package.Set("salt", base::ToLowerASCII(base::HexEncode(salt)));
+  package.Set("nonce", base::ToLowerASCII(base::HexEncode(nonce)));
+  package.Set("tag", base::ToLowerASCII(
+      base::HexEncode(base::span(sealed).subspan(body_length))));
+  package.Set("ciphertext", base::Base64Encode(base::span(sealed).first(body_length)));
+  auto encoded = base::WriteJson(base::Value(std::move(package)));
+  if (!encoded || encoded->size() > kMaxTransferBytes)
+    return result;
+  base::FilePath temporary;
+  if (!base::CreateTemporaryFileInDir(destination.DirName(), &temporary))
+    return result;
+  const bool written = base::WriteFile(temporary, *encoded) &&
+      base::ReplaceFile(temporary, destination, nullptr);
+  if (!written)
+    base::DeleteFile(temporary);
+  result.saved = written;
+  return result;
+}
+
+TransferReadResult ReadPasswordTransfer(base::FilePath path,
+                                        std::string passphrase) {
+  base::ScopedClosureRunner cleanse_passphrase(base::BindOnce(
+      &CleanseTransferPassphrase, &passphrase));
+  TransferReadResult result;
+  std::string encoded;
+  if (!base::ReadFileToStringWithMaxSize(path, &encoded, kMaxTransferBytes))
+    return result;
+  auto package = base::JSONReader::Read(encoded, 0);
+  if (!package || !package->is_dict())
+    return result;
+  const base::DictValue& data = package->GetDict();
+  const std::string* format = data.FindString("format");
+  const std::string* kdf = data.FindString("kdf");
+  const std::string* cipher = data.FindString("cipher");
+  const std::string* salt_hex = data.FindString("salt");
+  const std::string* nonce_hex = data.FindString("nonce");
+  const std::string* tag_hex = data.FindString("tag");
+  const std::string* body_b64 = data.FindString("ciphertext");
+  if (!format || *format != "aux-vault-transfer" ||
+      data.FindInt("version") != 1 || !kdf || *kdf != "scrypt-n16384-r8-p1" ||
+      !cipher || *cipher != "aes-256-gcm" || !salt_hex || !nonce_hex ||
+      !tag_hex || !body_b64 || body_b64->size() > 4'000'000)
+    return result;
+  std::vector<uint8_t> salt, nonce, tag;
+  std::string body;
+  if (!base::HexStringToBytes(*salt_hex, &salt) || salt.size() != 16 ||
+      !base::HexStringToBytes(*nonce_hex, &nonce) || nonce.size() != 12 ||
+      !base::HexStringToBytes(*tag_hex, &tag) || tag.size() != 16 ||
+      !base::Base64Decode(*body_b64, &body))
+    return result;
+  std::array<uint8_t, 32> key;
+  if (!DeriveTransferKey(passphrase, salt, key))
+    return result;
+  std::vector<uint8_t> sealed(base::as_byte_span(body).begin(),
+                              base::as_byte_span(body).end());
+  sealed.insert(sealed.end(), tag.begin(), tag.end());
+  auto opened = crypto::aead::Open(
+      crypto::aead::AES_256_GCM, key, sealed, nonce,
+      base::as_byte_span(kTransferAAD));
+  OPENSSL_cleanse(key.data(), key.size());
+  if (!opened || opened->size() > 3'000'000)
+    return result;
+  std::string plaintext(reinterpret_cast<const char*>(opened->data()),
+                        opened->size());
+  OPENSSL_cleanse(opened->data(), opened->size());
+  auto parsed = base::JSONReader::Read(plaintext, 0);
+  OPENSSL_cleanse(plaintext.data(), plaintext.size());
+  if (!parsed || !parsed->is_dict())
+    return result;
+  const base::ListValue* items = parsed->GetDict().FindList("items");
+  if (!items || items->size() > kMaxTransferItems)
+    return result;
+  for (const auto& item : *items) {
+    if (!item.is_dict())
+      return TransferReadResult();
+    const auto& entry = item.GetDict();
+    const std::string* kind = entry.FindString("kind");
+    const std::string* origin = entry.FindString("origin");
+    const std::string* secret = entry.FindString("secret");
+    if (!kind || !origin || !secret)
+      return TransferReadResult();
+    if (*kind != "password") {
+      ++result.skipped;
+      continue;
+    }
+    GURL url(*origin);
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.has_username() ||
+        url.has_password() || secret->empty() || secret->size() > 4096) {
+      ++result.skipped;
+      continue;
+    }
+    const std::string* username = entry.FindString("username");
+    if (username && username->size() > 200) {
+      ++result.skipped;
+      continue;
+    }
+    result.passwords.emplace_back(url, username ? *username : "", *secret,
+                                  "", password_manager::CSVPassword::Status::kOK);
+  }
+  result.valid = true;
+  return result;
+}
+
