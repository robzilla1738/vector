diff --git a/chrome/browser/ui/aux/owner_mutation_fence.cc b/chrome/browser/ui/aux/owner_mutation_fence.cc
new file mode 100644
index 0000000..e3c14e2
--- /dev/null
+++ b/chrome/browser/ui/aux/owner_mutation_fence.cc
@@ -0,0 +1,27 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/owner_mutation_fence.h"
+
+#include <limits>
+#include <utility>
+#include "base/unguessable_token.h"
+
+namespace aux {
+std::optional<std::string> OwnerMutationFence::Begin() {
+  if (pending_.size() >= 256 || failure_epoch_ == std::numeric_limits<uint64_t>::max())
+    return std::nullopt;
+  auto token = base::UnguessableToken::Create().ToString();
+  pending_.insert(token);
+  observers_.Notify();
+  return token;
+}
+bool OwnerMutationFence::End(const std::string& token, bool success) {
+  if (!pending_.erase(token)) return false;
+  if (!success && failure_epoch_ != std::numeric_limits<uint64_t>::max())
+    ++failure_epoch_;
+  observers_.Notify();
+  return true;
+}
+base::CallbackListSubscription OwnerMutationFence::Observe(base::RepeatingClosure callback) {
+  return observers_.Add(std::move(callback));
+}
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/owner_mutation_fence.h b/chrome/browser/ui/aux/owner_mutation_fence.h
new file mode 100644
index 0000000..48d789e
--- /dev/null
+++ b/chrome/browser/ui/aux/owner_mutation_fence.h
@@ -0,0 +1,28 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_OWNER_MUTATION_FENCE_H_
+#define CHROME_BROWSER_UI_AUX_OWNER_MUTATION_FENCE_H_
+
+#include <cstdint>
+#include <optional>
+#include <set>
+#include <string>
+#include "base/callback_list.h"
+#include "base/functional/callback.h"
+
+namespace aux {
+// UI-sequence Profile boundary: an owner policy mutation must settle before
+// an already queued agent permission answer may cause a native effect.
+class OwnerMutationFence {
+ public:
+  std::optional<std::string> Begin();
+  bool End(const std::string& token, bool success);
+  bool pending() const { return !pending_.empty(); }
+  uint64_t failure_epoch() const { return failure_epoch_; }
+  base::CallbackListSubscription Observe(base::RepeatingClosure callback);
+ private:
+  std::set<std::string> pending_;
+  uint64_t failure_epoch_ = 0;
+  base::RepeatingClosureList observers_;
+};
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/aux/owner_mutation_fence_unittest.cc b/chrome/browser/ui/aux/owner_mutation_fence_unittest.cc
new file mode 100644
index 0000000..ebd83a0
--- /dev/null
+++ b/chrome/browser/ui/aux/owner_mutation_fence_unittest.cc
@@ -0,0 +1,80 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/owner_mutation_fence.h"
+
+#include <vector>
+#include "base/functional/bind.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+TEST(OwnerMutationFenceTest, OverlappingMutationsRequireEveryExactReceipt) {
+  OwnerMutationFence fence;
+  auto first = fence.Begin();
+  auto second = fence.Begin();
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_NE(first, second);
+  EXPECT_FALSE(fence.End("foreign-token", true));
+  EXPECT_TRUE(fence.pending());
+  EXPECT_TRUE(fence.End(*first, true));
+  EXPECT_FALSE(fence.End(*first, true));
+  EXPECT_TRUE(fence.pending());
+  EXPECT_TRUE(fence.End(*second, true));
+  EXPECT_FALSE(fence.pending());
+  EXPECT_EQ(fence.failure_epoch(), 0u);
+}
+TEST(OwnerMutationFenceTest, FailureRetiresTheAnswerEpochBeforeNotification) {
+  OwnerMutationFence fence;
+  auto first = fence.Begin();
+  auto second = fence.Begin();
+  bool observed_failure_while_pending = false;
+  auto subscription = fence.Observe(base::BindRepeating([&] {
+    observed_failure_while_pending = fence.pending() && fence.failure_epoch() == 1;
+  }));
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_TRUE(fence.End(*first, false));
+  EXPECT_TRUE(observed_failure_while_pending);
+  EXPECT_TRUE(fence.End(*second, true));
+  EXPECT_EQ(fence.failure_epoch(), 1u);
+  EXPECT_FALSE(fence.End(*first, false));
+  EXPECT_EQ(fence.failure_epoch(), 1u);
+}
+TEST(OwnerMutationFenceTest, BoundRefusesWithoutReplacingExistingTokens) {
+  OwnerMutationFence fence;
+  std::vector<std::string> tokens;
+  for (int i = 0; i < 256; ++i) {
+    auto token = fence.Begin();
+    ASSERT_TRUE(token);
+    tokens.push_back(*token);
+  }
+  EXPECT_FALSE(fence.Begin());
+  for (const auto& token : tokens) EXPECT_TRUE(fence.End(token, true));
+  EXPECT_FALSE(fence.pending());
+  EXPECT_TRUE(fence.Begin());
+}
+TEST(OwnerMutationFenceTest, ProfileInstancesCannotReleaseEachOther) {
+  OwnerMutationFence first;
+  OwnerMutationFence second;
+  auto token = first.Begin();
+  ASSERT_TRUE(token);
+  EXPECT_FALSE(second.pending());
+  EXPECT_FALSE(second.End(*token, true));
+  EXPECT_TRUE(first.pending());
+  EXPECT_TRUE(first.End(*token, true));
+}
+TEST(OwnerMutationFenceTest, ReceiptObserverMayBeginAnotherMutation) {
+  OwnerMutationFence fence;
+  auto token = fence.Begin();
+  ASSERT_TRUE(token);
+  std::optional<std::string> reentrant;
+  auto subscription = fence.Observe(base::BindRepeating([&] {
+    if (!fence.pending()) reentrant = fence.Begin();
+  }));
+  EXPECT_TRUE(fence.End(*token, true));
+  ASSERT_TRUE(reentrant);
+  EXPECT_TRUE(fence.pending());
+  subscription = {};
+  EXPECT_TRUE(fence.End(*reentrant, true));
+  EXPECT_FALSE(fence.pending());
+}
+}  // namespace aux
