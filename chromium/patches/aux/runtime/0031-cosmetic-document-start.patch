+
+#include "chrome/browser/ui/aux/cosmetic_controller.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+
+TEST(CosmeticControllerTest, AcceptsOnlyBoundedDeclarativeSelectors) {
+  EXPECT_TRUE(ValidCosmeticRule({{"example.test"}, ".cookie-banner"}));
+  EXPECT_TRUE(ValidCosmeticRule({{"example.test"},
+                                 "[data-cookie-consent] > .notice"}));
+  EXPECT_FALSE(ValidCosmeticRule({{}, "body"}));
+  EXPECT_FALSE(ValidCosmeticRule({{}, ".cookie-banner, body"}));
+  EXPECT_FALSE(ValidCosmeticRule({{}, ".cookie-banner{color:red}"}));
+  EXPECT_FALSE(ValidCosmeticRule({{}, ".cookie-banner:has(script)"}));
+  EXPECT_FALSE(ValidCosmeticRule({{"example.test", "a.example.test"},
+                                  ".cookie-banner"}));
+  EXPECT_FALSE(ValidCosmeticRule({{"localhost"}, ".cookie-banner"}));
+  EXPECT_FALSE(ValidCosmeticRule({{"example.test"}, "." + std::string(300, 'a')}));
+}
+
+TEST(CosmeticControllerTest, MatchesOnlySelectedSiteAndSubdomains) {
+  const std::vector<CosmeticRule> rules = {
+      {{}, ".global-cookie"},
+      {{"example.test"}, "[data-cookie-consent]"},
+      {{"shop.example.test"}, ".checkout-overlay"},
+  };
+  EXPECT_EQ(CosmeticStyleForHost(rules, "shop.example.test"),
+            ".global-cookie{display:none!important}\n"
+            "[data-cookie-consent]{display:none!important}\n"
+            ".checkout-overlay{display:none!important}\n");
+  EXPECT_EQ(CosmeticStyleForHost(rules, "notexample.test"),
+            ".global-cookie{display:none!important}\n");
+  EXPECT_EQ(CosmeticRulesDigest(rules).size(), 64u);
+  EXPECT_NE(CosmeticRulesDigest(rules),
+            CosmeticRulesDigest({{{}, ".different"}}));
+}
+
+}  // namespace aux
