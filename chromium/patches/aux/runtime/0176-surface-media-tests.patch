+++ b/chrome/browser/ui/aux/auto_pip_site_policy_unittest.cc
@@ -0,0 +1,19 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/auto_pip_site_policy.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux {
+TEST(AutoPipSitePolicyTest, CallsNeverAutoPip) {
+  for (const auto host : {"slack.com", "work.slack.com", "meet.google.com", "teams.microsoft.com", "teams.live.com"})
+    EXPECT_EQ(AutoPipPolicyForHost(host), AutoPipSitePolicy::kNever);
+}
+TEST(AutoPipSitePolicyTest, YouTubeAllowsInaudiblePlayback) {
+  EXPECT_EQ(AutoPipPolicyForHost("youtube.com"), AutoPipSitePolicy::kEvenInaudible);
+  EXPECT_EQ(AutoPipPolicyForHost("www.youtube.com"), AutoPipSitePolicy::kEvenInaudible);
+}
+TEST(AutoPipSitePolicyTest, LookalikesKeepDefaultPolicy) {
+  for (const auto host : {"notslack.com", "slack.com.example.test", "youtube.com.evil.test", "notyoutube.com", "example.test"})
+    EXPECT_EQ(AutoPipPolicyForHost(host), AutoPipSitePolicy::kDefault);
+}
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/surface_media_browsertest.cc b/chrome/browser/ui/aux/surface_media_browsertest.cc
