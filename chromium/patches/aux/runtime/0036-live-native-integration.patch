+MigrationImport::Files MigrationImport::ReadFiles(base::FilePath directory) {
+  Files files;
+  for (const auto& entry : std::vector<std::pair<const char*, size_t>>{
+           {"manifest.json", kMaxManifestBytes},
+           {"apply-receipt.json", kMaxReceiptBytes},
+           {"native-import-journal.json", kMaxJournalBytes},
+           {"native-import-receipt.json", kMaxReceiptBytes}}) {
+    const auto path = directory.AppendASCII(entry.first);
+    FileState state;
+    state.exists = base::PathExists(path);
+    std::string text;
+    if (state.exists && !base::IsLink(path) &&
+        base::ReadFileToStringWithMaxSize(path, &text, entry.second))
+      state.text = std::move(text);
+    files.emplace(path, std::move(state));
+  }
+  return files;
+}
+
+bool MigrationImport::FlushFiles(Writes writes) {
+  for (const auto& [path, text] : writes) {
+    if (!text) {
+      if (!base::DeleteFile(path)) return false;
+      continue;
+    }
+    if (!base::CreateDirectory(path.DirName()) ||
+        !base::SetPosixFilePermissions(path.DirName(), 0700)) return false;
+    const auto temp = path.AddExtension(FILE_PATH_LITERAL("tmp"));
+    if (!base::WriteFile(temp, *text) ||
+        !base::SetPosixFilePermissions(temp, 0600) ||
+        !base::ReplaceFile(temp, path, nullptr)) {
+      base::DeleteFile(temp);
+      return false;
+    }
+  }
+  return true;
+}
+
+void MigrationImport::EnsureReady(base::OnceClosure callback) {
+  if (ready_) { std::move(callback).Run(); return; }
+  ready_callbacks_.push_back(std::move(callback));
+  if (reading_) return;
+  reading_ = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&MigrationImport::ReadFiles, DataDir(profile_)),
+      base::BindOnce(&MigrationImport::OnFilesRead, weak_factory_.GetWeakPtr()));
+}
+
+void MigrationImport::OnFilesRead(Files files) {
+  files_ = std::move(files);
+  loaded_ = false;
+  reading_ = false;
+  ready_ = true;
+  auto callbacks = std::move(ready_callbacks_);
+  for (auto& callback : callbacks) std::move(callback).Run();
+}
+
+bool MigrationImport::ReadPrivateFile(const base::FilePath& path,
+                                      size_t maximum, std::string* text) {
+  const auto it = files_.find(path);
+  if (it == files_.end() || !it->second.text ||
+      it->second.text->size() > maximum) return false;
+  *text = *it->second.text;
+  return true;
+}
+
+std::optional<base::DictValue> MigrationImport::ReadDict(
+    const base::FilePath& path, size_t maximum) {
+  std::string text;
+  if (!ReadPrivateFile(path, maximum, &text)) return std::nullopt;
+  return base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+}
+
+bool MigrationImport::WritePrivateDict(const base::FilePath& path,
+                                       const base::DictValue& value) {
+  auto text = base::WriteJson(value);
+  if (!text || text->size() > kMaxJournalBytes) return false;
+  files_[path] = FileState{true, *text};
+  writes_.emplace_back(path, std::move(*text));
+  return true;
+}
+
+bool MigrationImport::PathExists(const base::FilePath& path) const {
+  const auto it = files_.find(path);
+  return it != files_.end() && it->second.exists;
+}
+
+bool MigrationImport::DeleteFile(const base::FilePath& path) {
+  files_[path] = FileState{};
+  writes_.emplace_back(path, std::nullopt);
+  return true;
+}
+
+void MigrationImport::CallAsync(BrowserProvider browser, std::string method,
+                                base::DictValue params, Reply reply) {
+  if (busy_) {
+    std::move(reply).Run(std::nullopt, "Another migration operation is in progress");
+    return;
+  }
+  busy_ = true;
+  ready_ = false;
+  EnsureReady(base::BindOnce(&MigrationImport::RunLoaded,
+                            weak_factory_.GetWeakPtr(), std::move(browser),
+                            std::move(method), std::move(params), std::move(reply)));
+}
+
+void MigrationImport::RunLoaded(BrowserProvider browser, std::string method,
+                                base::DictValue params, Reply reply) {
+  auto* window = browser.Run();
+  if (!window) {
+    busy_ = false;
+    std::move(reply).Run(std::nullopt, "The migration window closed");
+    return;
+  }
+  checkpoint_pending_ = false;
+  writes_.clear();
+  std::string error;
+  auto result = Call(window, method, params, &error);
+  if (writes_.empty()) {
+    busy_ = false;
+    std::move(reply).Run(std::move(result), std::move(error));
+    return;
+  }
+  const bool resume = checkpoint_pending_;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&MigrationImport::FlushFiles, std::move(writes_)),
+      base::BindOnce(
+          [](base::WeakPtr<MigrationImport> self, BrowserProvider browser,
+             std::string method, base::DictValue params, Reply reply,
+             std::optional<base::DictValue> result, std::string error,
+             bool resume, bool saved) {
+            if (!self) return;
+            if (!saved) {
+              self->ready_ = false;
+              self->busy_ = false;
+              std::move(reply).Run(std::nullopt, "Could not persist the native migration checkpoint");
+            } else if (resume) {
+              self->RunLoaded(std::move(browser), std::move(method),
+                              std::move(params), std::move(reply));
+            } else {
+              self->busy_ = false;
+              std::move(reply).Run(std::move(result), std::move(error));
+            }
+          }, weak_factory_.GetWeakPtr(), std::move(browser), std::move(method),
+          std::move(params), std::move(reply), std::move(result), std::move(error),
+          resume));
+}
