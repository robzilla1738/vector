+#if BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_AUX_SHELL) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <utility>
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/aux/native_aux_warm_owner.h"
