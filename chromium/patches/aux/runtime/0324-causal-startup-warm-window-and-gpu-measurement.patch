+TEST(NativeStartupFrameTimingTest, ColdRequiresExactOriginalLaunchEndpoint) {
+  NativeStartupFrameScope scope;
+  scope.launch = base::TimeTicks() + base::Seconds(1);
+  scope.measurement_input = scope.launch;
