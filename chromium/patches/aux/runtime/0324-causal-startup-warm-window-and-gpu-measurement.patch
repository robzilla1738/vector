+  output_surface_->EndPaint(base::OnceClosure(), {}, kSurfaceRect, false);
+  const auto actual_token = output_surface_->Flush();
+  ASSERT_TRUE(actual_token.HasData());
+  BlockMainThread();
+  EXPECT_FALSE(full);
+}
