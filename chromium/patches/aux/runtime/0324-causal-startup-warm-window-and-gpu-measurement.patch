+std::optional<gfx::Rect> SkiaRenderer::NativeStockExecutedRect(const DrawQuadParams& params) {
+  if (params.opacity != 1.0f || params.aa_flags != SkCanvas::kNone_QuadAAFlags ||
+      params.draw_region || params.mask_filter_info || params.visible_rect.IsEmpty() ||
+      !params.content_device_transform.NonDegeneratePreserves2dAxisAlignment() ||
+      params.content_device_transform.HasPerspective() || GetContentColorFilter()) return std::nullopt;
+  const auto mapped = params.content_device_transform.MapRect(params.visible_rect);
+  if (!std::isfinite(mapped.x()) || !std::isfinite(mapped.y()) ||
+      !std::isfinite(mapped.width()) || !std::isfinite(mapped.height())) return std::nullopt;
+  auto actual = gfx::ToEnclosedRect(mapped);
+  if (params.scissor_rect) actual.Intersect(*params.scissor_rect);
+  actual.Intersect(current_frame()->root_render_pass->output_rect);
+  return actual.IsEmpty() ? std::nullopt : std::make_optional(actual);
+}
+void SkiaRenderer::RecordNativeStockImage(ExternalUseClient::ImageContext* actual,
+    const gfx::RectF& actual_sample_bounds, const DrawRPDQParams* rpdq,
+    const DrawQuadParams& params) {
+  if (!native_stock_draw_ || current_frame()->current_render_pass != current_frame()->root_render_pass) return;
+  const bool over = params.blend_mode == SkBlendMode::kSrcOver;
+  if (params.blend_mode != SkBlendMode::kSrc && !over) { native_stock_draw_->Invalidate(); return; }
+  const auto actual_rect = NativeStockExecutedRect(params);
+  const auto sample = gfx::ToEnclosingRect(actual_sample_bounds);
+  if (!actual || rpdq || !actual_rect || sample.IsEmpty() ||
+      !actual_sample_bounds.Contains(params.vis_tex_coords)) {
+    // Unsupported overwrite cannot borrow another painted backing.
+    // No coverage is counted for an unsupported source-over foreground.
+    if (!over) native_stock_draw_->Invalidate();
+    return;
+  }
+  native_stock_draw_->AddExecutedOriginalImage(actual, *actual_rect, over, sample);
+}
