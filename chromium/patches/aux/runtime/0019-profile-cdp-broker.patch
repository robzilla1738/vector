diff --git a/chrome/browser/ui/aux/cdp_broker.cc b/chrome/browser/ui/aux/cdp_broker.cc
new file mode 100644
index 0000000000..374710e173
--- /dev/null
+++ b/chrome/browser/ui/aux/cdp_broker.cc
@@ -0,0 +1,274 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/cdp_broker.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <set>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+
+constexpr size_t kMaxCdpMessageBytes = 1024 * 1024;
+constexpr std::array<const char*, 14> kPageDomains = {
+    "Page", "Runtime", "DOM", "DOMSnapshot", "Accessibility", "Input",
+    "Emulation", "Log", "CSS", "Performance", "Overlay", "IO", "Network",
+    "Fetch"};
+
+base::Value::Dict Fault(const char* code, const char* message) {
+  base::Value::Dict error;
+  error.Set("code", code);
+  error.Set("message", message);
+  base::Value::Dict reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+
+bool IsPageURL(const GURL& url) {
+  return url.SchemeIsHTTPOrHTTPS() || url.spec() == "about:blank";
+}
+
+}  // namespace
+
+bool IsCdpMethodAllowed(const std::string& method) {
+  if (method == "Target.setAutoAttach" ||
+      method == "Target.detachFromTarget") {
+    return true;
+  }
+  const size_t dot = method.find('.');
+  if (dot == std::string::npos || dot == 0 || dot + 1 == method.size()) {
+    return false;
+  }
+  const std::string domain = method.substr(0, dot);
+  if (domain == "Network" &&
+      (method == "Network.getAllCookies" || method == "Network.getCookies" ||
+       base::StartsWith(method, "Network.setCookie") ||
+       base::StartsWith(method, "Network.deleteCookie") ||
+       method == "Network.clearBrowserCookies")) {
+    return false;
+  }
+  for (const char* allowed : kPageDomains) {
+    if (domain == allowed) {
+      return true;
+    }
+  }
+  return false;
+}
+
+class CdpBroker::Session final : public content::DevToolsAgentHostClient {
+ public:
+  Session(Profile* profile, uint64_t connection_generation,
+          std::string page_id,
+          scoped_refptr<content::DevToolsAgentHost> host,
+          MessageCallback on_message)
+      : profile_(profile),
+        connection_generation_(connection_generation),
+        page_id_(std::move(page_id)),
+        host_(std::move(host)),
+        on_message_(std::move(on_message)) {}
+
+  ~Session() override {
+    if (host_) {
+      host_->DetachClient(this);
+    }
+  }
+
+  bool Attach() { return host_->AttachClient(this); }
+  bool Owns(content::DevToolsAgentHost* host) const { return host_.get() == host; }
+  bool IsClosed() const { return !host_; }
+  bool OwnsChild(const std::string& session_id) const {
+    return child_sessions_.contains(session_id);
+  }
+
+  void Send(const std::string& message) {
+    host_->DispatchProtocolMessage(this, base::as_byte_span(message));
+  }
+
+  void DispatchProtocolMessage(content::DevToolsAgentHost* host,
+                               base::span<const uint8_t> message) override {
+    auto* catalog = TabCatalog::GetForProfile(profile_);
+    content::WebContents* contents = catalog ? catalog->FindPage(page_id_) : nullptr;
+    if (!Owns(host) || !contents || host->GetWebContents() != contents ||
+        host->GetBrowserContext() != profile_ ||
+        !IsPageURL(contents->GetLastCommittedURL())) {
+      return;
+    }
+    const std::string json(message.begin(), message.end());
+    const auto parsed = base::JSONReader::Read(json);
+    const base::Value::Dict* event = parsed ? parsed->GetIfDict() : nullptr;
+    const std::string* method = event ? event->FindString("method") : nullptr;
+    const base::Value::Dict* params = event ? event->FindDict("params") : nullptr;
+    if (const std::string* session_id =
+            event ? event->FindString("sessionId") : nullptr;
+        session_id && !OwnsChild(*session_id)) {
+      return;
+    }
+    if (method && *method == "Target.attachedToTarget") {
+      const std::string* session_id =
+          params ? params->FindString("sessionId") : nullptr;
+      const base::Value::Dict* info =
+          params ? params->FindDict("targetInfo") : nullptr;
+      const std::string* target_id =
+          info ? info->FindString("targetId") : nullptr;
+      const std::string* type = info ? info->FindString("type") : nullptr;
+      scoped_refptr<content::DevToolsAgentHost> child;
+      if (target_id) {
+        child = content::DevToolsAgentHost::GetForId(*target_id);
+      }
+      if (!session_id || !target_id || !type || *type != "iframe" ||
+          !child || child->GetBrowserContext() != profile_ ||
+          child->GetWebContents() != contents) {
+        return;
+      }
+      child_sessions_.insert(*session_id);
+    } else if (method && *method == "Target.detachedFromTarget") {
+      if (const std::string* child =
+              params ? params->FindString("sessionId") : nullptr) {
+        child_sessions_.erase(*child);
+      }
+    }
+    on_message_.Run(connection_generation_, page_id_,
+                    json);
+  }
+
+  void AgentHostClosed(content::DevToolsAgentHost* host) override {
+    if (Owns(host)) {
+      host_.reset();
+      on_message_.Run(connection_generation_, page_id_,
+                      "{\"method\":\"Inspector.detached\",\"params\":{\"reason\":\"target_closed\"}}");
+    }
+  }
+
+  bool MayAttachToURL(const GURL& url, bool is_webui) override {
+    return !is_webui && IsPageURL(url);
+  }
+
+ private:
+  raw_ptr<Profile> profile_;
+  uint64_t connection_generation_;
+  std::string page_id_;
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  std::set<std::string> child_sessions_;
+  MessageCallback on_message_;
+};
+
+CdpBroker::CdpBroker(Profile* profile, MessageCallback on_message)
+    : profile_(profile), on_message_(std::move(on_message)) {}
+CdpBroker::~CdpBroker() = default;
+
+base::Value::Dict CdpBroker::Dispatch(const std::string& page_id,
+                                      const std::string& message,
+                                      uint64_t connection_generation) {
+  if (connection_generation_ != connection_generation) {
+    DetachAll();
+    connection_generation_ = connection_generation;
+  }
+  if (!profile_ || profile_->IsOffTheRecord()) {
+    return Fault("permission_denied", "CDP requires a regular Profile");
+  }
+  if (message.size() > kMaxCdpMessageBytes) {
+    return Fault("invalid_argument", "CDP message exceeds 1 MiB");
+  }
+  const auto parsed = base::JSONReader::Read(message);
+  const base::Value::Dict* command = parsed ? parsed->GetIfDict() : nullptr;
+  const std::string* method = command ? command->FindString("method") : nullptr;
+  const std::optional<int> id = command ? command->FindInt("id") : std::nullopt;
+  if (!command || !method || !id || *id < 1 ||
+      !IsCdpMethodAllowed(*method)) {
+    return Fault("permission_denied", "CDP method or envelope is not allowed");
+  }
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  content::WebContents* contents = catalog ? catalog->FindPage(page_id) : nullptr;
+  if (!contents || contents->GetBrowserContext() != profile_ ||
+      !IsPageURL(contents->GetLastCommittedURL())) {
+    sessions_.erase(page_id);
+    return Fault("not_found", "Page is outside this Profile or unavailable");
+  }
+  scoped_refptr<content::DevToolsAgentHost> host =
+      content::DevToolsAgentHost::GetOrCreateFor(contents);
+  if (!host || host->GetWebContents() != contents ||
+      host->GetBrowserContext() != profile_) {
+    return Fault("permission_denied", "CDP target ownership changed");
+  }
+  auto it = sessions_.find(page_id);
+  if (it != sessions_.end() && (it->second->IsClosed() ||
+                               !it->second->Owns(host.get()))) {
+    sessions_.erase(it);
+    it = sessions_.end();
+  }
+  if (it == sessions_.end()) {
+    auto session =
+        std::make_unique<Session>(profile_, connection_generation_, page_id,
+                                  std::move(host), on_message_);
+    if (!session->Attach()) {
+      return Fault("backend_unavailable", "Could not attach to page target");
+    }
+    it = sessions_.emplace(page_id, std::move(session)).first;
+  }
+  if (command->Find("sessionId") && !command->FindString("sessionId")) {
+    return Fault("invalid_argument", "Invalid CDP child session");
+  }
+  if (const std::string* session_id = command->FindString("sessionId");
+      session_id && !it->second->OwnsChild(*session_id)) {
+    return Fault("permission_denied", "CDP child session is not owned by this page");
+  }
+  std::string dispatched = message;
+  if (*method == "Target.setAutoAttach") {
+    const base::Value::Dict* params = command->FindDict("params");
+    if (!params || !params->FindBool("autoAttach") ||
+        !params->FindBool("flatten").value_or(false)) {
+      return Fault("invalid_argument", "Flat iframe attachment is required");
+    }
+    base::Value::Dict restricted = command->Clone();
+    base::Value::Dict options = params->Clone();
+    base::Value::List filter;
+    base::Value::Dict iframe;
+    iframe.Set("type", "iframe");
+    filter.Append(std::move(iframe));
+    base::Value::Dict exclude_all;
+    exclude_all.Set("type", "*");
+    exclude_all.Set("exclude", true);
+    filter.Append(std::move(exclude_all));
+    options.Set("filter", std::move(filter));
+    restricted.Set("params", std::move(options));
+    const auto encoded = base::WriteJson(restricted);
+    if (!encoded) {
+      return Fault("invalid_argument", "Invalid iframe attachment request");
+    }
+    dispatched = *encoded;
+  } else if (*method == "Target.detachFromTarget") {
+    const base::Value::Dict* params = command->FindDict("params");
+    const std::string* child = params ? params->FindString("sessionId") : nullptr;
+    if (!child || !it->second->OwnsChild(*child)) {
+      return Fault("permission_denied", "CDP child session is not owned by this page");
+    }
+  }
+  it->second->Send(dispatched);
+  base::Value::Dict result;
+  result.Set("accepted", true);
+  base::Value::Dict reply;
+  reply.Set("result", std::move(result));
+  return reply;
+}
+
+void CdpBroker::DetachAll() {
+  sessions_.clear();
+}
+
+}  // namespace aux
