@@ -0,0 +1,35 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/cdp_broker.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+
+TEST(CdpBrokerMethodTest, AllowsPageScopedAutomation) {
+  EXPECT_TRUE(IsCdpMethodAllowed("Page.navigate"));
+  EXPECT_TRUE(IsCdpMethodAllowed("Runtime.evaluate"));
+  EXPECT_TRUE(IsCdpMethodAllowed("DOM.getDocument"));
+  EXPECT_TRUE(IsCdpMethodAllowed("Network.getResponseBody"));
+  EXPECT_TRUE(IsCdpMethodAllowed("IO.read"));
+  EXPECT_TRUE(IsCdpMethodAllowed("Target.setAutoAttach"));
+  EXPECT_TRUE(IsCdpMethodAllowed("Target.detachFromTarget"));
+}
+
+TEST(CdpBrokerMethodTest, DeniesBrowserTargetAndCookieAuthority) {
+  EXPECT_FALSE(IsCdpMethodAllowed("Browser.getVersion"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Target.attachToTarget"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Storage.getCookies"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Network.getCookies"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Network.getAllCookies"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Network.setCookie"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Network.setCookies"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Network.deleteCookies"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Network.clearBrowserCookies"));
+  EXPECT_FALSE(IsCdpMethodAllowed("Runtime"));
+  EXPECT_FALSE(IsCdpMethodAllowed(".evaluate"));
+}
+
+}  // namespace aux
