+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_CDP_MEASUREMENT_PRODUCER_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_CDP_MEASUREMENT_PRODUCER_H_
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "base/functional/callback.h"
+#include "base/unguessable_token.h"
+#include "content/public/browser/weak_document_ptr.h"
+class BrowserWindowInterface;
+class AuxRuntimeHost;
+namespace content { class NativePlatformInputAdmission; class RenderFrameHost; }
+namespace aux {
+class EgressController;
+class NativeStopInputEndpoint;
+// Only the owned fixture producer can construct this measurement receipt.
+// It does not authorize Stop, resume, or any browser effect.
+class NativeStopInputReceipt final {
+ public:
+  ~NativeStopInputReceipt();
+ private:
+  friend class NativeCdpMeasurementProducer;
+  friend class NativeStopInputEndpoint;
+  friend class EgressController;
+  friend class ::AuxRuntimeHost;
+  NativeStopInputReceipt();
+  base::WeakPtr<BrowserWindowInterface> owner_;
+  base::WeakPtr<EgressController> controller_;
+  content::WeakDocumentPtr shell_document_;
+  base::UnguessableToken id_;
+  std::string run_id_;
+  std::string host_incarnation_;
+  uint64_t connection_generation_ = 0;
+  base::TimeTicks event_ticks_, admitted_ticks_, deadline_;
+};
+// Created solely by fixed native fixture ingress after original unique-window
+// admission. No caller run/page/document/PID/script selector exists here.
+class NativeCdpMeasurementProducer final {
+ public:
+  enum class Operation { kPrepareTakeover, kPrepareStop, kComplete };
+  explicit NativeCdpMeasurementProducer(BrowserWindowInterface* original_owner);
+  ~NativeCdpMeasurementProducer();
+  base::DictValue Run(Operation operation);
+  void WaitForFreshDispatches(base::OnceCallback<void(bool)> callback);
+  base::WeakPtr<NativeCdpMeasurementProducer> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+  // Called only on the original shell's associated native input path.
+  bool AdmitStopInput(const content::NativePlatformInputAdmission& admission);
+  // Fixed renderer endpoint supplies a consumed private Event token and the
+  // existing Stop run. No caller timestamp, child list, or authority enters.
+  std::unique_ptr<NativeStopInputReceipt> TakeStopInput(
+      const base::UnguessableToken& id, content::RenderFrameHost* original_shell,
+      const std::string& run_id);
+ private:
+  friend class NativeStopInputEndpoint;
+  void PollFreshDispatches();
+  void FinishFreshDispatches(bool ready);
+  bool OwnerCurrent() const;
+  std::optional<base::TimeTicks> OriginalStopDeadline() const;
+  base::WeakPtr<BrowserWindowInterface> owner_;
+  base::WeakPtr<EgressController> controller_;
+  uint64_t sequence_ = 0;
+  bool armed_ = false;
+  std::unique_ptr<NativeStopInputReceipt> stop_input_;
+  base::OnceCallback<void(bool)> dispatch_ready_;
+  base::RepeatingTimer dispatch_timer_;
+  base::WeakPtrFactory<NativeCdpMeasurementProducer> weak_factory_{this};
+};
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/aux/native_cdp_retirement_measurement.cc b/chrome/browser/ui/aux/native_cdp_retirement_measurement.cc
new file mode 100644
index 0000000..e99a51c
--- /dev/null
+++ b/chrome/browser/ui/aux/native_cdp_retirement_measurement.cc
@@ -0,0 +1,142 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_cdp_retirement_measurement.h"
+#include <limits>
+#include <utility>
+#include "base/strings/string_number_conversions.h"
+#include "base/unguessable_token.h"
+namespace aux {
+namespace {
+base::DictValue Identity(const base::DictValue& lease) {
+  auto identity = lease.Clone();
+  identity.Remove("expiresAt");
+  return identity;
+}
+std::string Ticks(base::TimeTicks ticks) {
+  return base::NumberToString(ticks.since_origin().InMicroseconds());
+}
+}  // namespace
+NativeCdpRetirementMeasurement::NativeCdpRetirementMeasurement(Mode mode,
+    std::string root_run, std::string owner_incarnation, uint64_t generation,
+    std::vector<std::string> registered_runs,
+    std::map<std::string, OriginalPage> pages)
+    : mode_(mode), root_run_(std::move(root_run)),
+      owner_incarnation_(std::move(owner_incarnation)),
+      connection_generation_(generation), registered_runs_(std::move(registered_runs)),
+      original_pages_(std::move(pages)),
+      nonce_(base::UnguessableToken::Create().ToString()) {
+  if (root_run_.empty() || owner_incarnation_.empty() || !generation ||
+      registered_runs_.empty() || registered_runs_.size() > 128 ||
+      original_pages_.empty() || original_pages_.size() > 20 ||
+      (mode == Mode::kTakeover && original_pages_.size() != 1)) refused_ = true;
+  for (const auto& [id, original] : original_pages_) {
+    auto& page = pages_[id];
+    page.current_count = original.dispatch_count;
+    if (id.empty() || !original.lease.FindString("leaseId") || original.lease.FindString("leaseId")->empty()) refused_ = true;
+  }
+}
+NativeCdpRetirementMeasurement::~NativeCdpRetirementMeasurement() = default;
+void NativeCdpRetirementMeasurement::ApprovedDispatch(const std::string& id,
+    const base::DictValue& lease, base::TimeTicks dispatched, uint64_t count) {
+  const auto original = original_pages_.find(id);
+  auto page = pages_.find(id);
+  if (consumed_ || refused_) return;
+  if (original == original_pages_.end() || page == pages_.end() ||
+      Identity(original->second.lease) != Identity(lease) ||
+      page->second.current_count == std::numeric_limits<uint64_t>::max() ||
+      count != page->second.current_count + 1 || dispatched < armed_) {
+    Refuse(); return;
+  }
+  page->second.current_count = count;
+  page->second.last = dispatched;
+}
+void NativeCdpRetirementMeasurement::RetiredPage(const std::string& id,
+    const base::DictValue& lease, const base::DictValue& scope,
+    base::TimeTicks event, base::TimeTicks admitted, base::TimeTicks last,
+    uint64_t count, bool original_clock_valid) {
+  const auto original = original_pages_.find(id);
+  auto page = pages_.find(id);
+  if (consumed_ || refused_) return;
+  if (original == original_pages_.end() || page == pages_.end() || page->second.retired ||
+      Identity(original->second.lease) != Identity(lease) ||
+      count != page->second.current_count || last != page->second.last ||
+      event < armed_ || admitted < event) { Refuse(); return; }
+  page->second.retired_scope = scope.Clone();
+  page->second.event = event; page->second.admitted = admitted;
+  page->second.retired_count = count; page->second.retired = true;
+  page->second.clock_valid = original_clock_valid;
+}
+void NativeCdpRetirementMeasurement::DocumentDestroyed(const std::string& id,
+    base::TimeTicks destroyed) {
+  auto page = pages_.find(id);
+  if (consumed_ || refused_) return;
+  if (mode_ != Mode::kStop || page == pages_.end() || !page->second.retired ||
+      destroyed.is_null() || destroyed < page->second.admitted ||
+      !page->second.destroyed.is_null()) { Refuse(); return; }
+  page->second.destroyed = destroyed;
+}
+void NativeCdpRetirementMeasurement::Refuse() { refused_ = true; }
+bool NativeCdpRetirementMeasurement::HasFreshDispatches() const {
+  if (!current()) return false;
+  for (const auto& [id, original] : original_pages_) {
+    const auto page = pages_.find(id);
+    if (page == pages_.end() || page->second.retired ||
+        page->second.current_count <= original.dispatch_count || page->second.last < armed_) return false;
+  }
+  return true;
+}
+base::DictValue NativeCdpRetirementMeasurement::ArmedRecord() const {
+  if (refused_ || consumed_) return base::DictValue().Set("producer", "aux-native-cdp-retirement")
+      .Set("version", 1).Set("status", "refused");
+  base::ListValue pages;
+  for (const auto& [id, original] : original_pages_) {
+    base::DictValue scope;
+    for (const auto* field : {"profileId", "tabId", "isolationId", "runId", "taskId", "taskRevision",
+         "frameId", "documentToken", "sourceOrigin", "controlGeneration"}) {
+      if (const auto* value = original.lease.Find(field)) scope.Set(field, value->Clone());
+    }
+    pages.Append(base::DictValue().Set("scope", std::move(scope))
+        .Set("leaseId", *original.lease.FindString("leaseId"))
+        .Set("initialCount", base::NumberToString(original.dispatch_count)));
+  }
+  base::ListValue runs;
+  for (const auto& run : registered_runs_) runs.Append(run);
+  return base::DictValue().Set("producer", "aux-native-cdp-retirement").Set("version", 1)
+      .Set("status", "armed").Set("mode", mode_ == Mode::kStop ? "stop" : "takeover")
+      .Set("nonce", nonce_).Set("hostIncarnation", owner_incarnation_)
+      .Set("connectionGeneration", static_cast<double>(connection_generation_))
+      .Set("rootRunId", root_run_).Set("registeredRuns", std::move(runs))
+      .Set("armedUs", Ticks(armed_)).Set("pages", std::move(pages));
+}
+base::DictValue NativeCdpRetirementMeasurement::Complete(bool original_current) {
+  const auto now = base::TimeTicks::Now();
+  const bool consumed = consumed_; consumed_ = true;
+  if (consumed || refused_ || !original_current || now - armed_ >= base::Seconds(5))
+    return base::DictValue().Set("producer", "aux-native-cdp-retirement")
+        .Set("version", 1).Set("status", "refused");
+  base::ListValue pages;
+  for (const auto& [id, page] : pages_) {
+    if (!page.retired || !page.clock_valid || page.last < armed_ ||
+        page.last > page.admitted || page.current_count != page.retired_count ||
+        page.retired_count <= original_pages_.at(id).dispatch_count ||
+        now <= page.admitted)
+      return base::DictValue().Set("producer", "aux-native-cdp-retirement")
+          .Set("version", 1).Set("status", "refused");
+    pages.Append(base::DictValue().Set("scope", page.retired_scope.Clone())
+        .Set("leaseId", *original_pages_.at(id).lease.FindString("leaseId"))
+        .Set("initialCount", base::NumberToString(original_pages_.at(id).dispatch_count))
+        .Set("eventUs", Ticks(page.event)).Set("admittedUs", Ticks(page.admitted))
+        .Set("lastDispatchUs", Ticks(page.last)).Set("retiredCount", base::NumberToString(page.retired_count))
+        .Set("observedCount", base::NumberToString(page.current_count)).Set("originalClockValid", true)
+        .Set("documentState", page.destroyed.is_null() ? "retained" : "destroyed")
+        .Set("destroyedUs", page.destroyed.is_null() ? "0" : Ticks(page.destroyed)));
+  }
+  base::ListValue runs;
+  for (const auto& run : registered_runs_) runs.Append(run);
+  return base::DictValue().Set("producer", "aux-native-cdp-retirement").Set("version", 1)
+      .Set("status", "sampled").Set("mode", mode_ == Mode::kStop ? "stop" : "takeover")
+      .Set("nonce", nonce_).Set("hostIncarnation", owner_incarnation_)
+      .Set("connectionGeneration", static_cast<double>(connection_generation_))
+      .Set("rootRunId", root_run_).Set("registeredRuns", std::move(runs))
+      .Set("armedUs", Ticks(armed_)).Set("observedUs", Ticks(now)).Set("pages", std::move(pages));
+}
+}  // namespace aux
diff --git a/chrome/browser/ui/aux/native_cdp_retirement_measurement.h b/chrome/browser/ui/aux/native_cdp_retirement_measurement.h
new file mode 100644
index 0000000..908853f
--- /dev/null
+++ b/chrome/browser/ui/aux/native_cdp_retirement_measurement.h
@@ -0,0 +1,69 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_CDP_RETIREMENT_MEASUREMENT_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_CDP_RETIREMENT_MEASUREMENT_H_
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+#include "base/time/time.h"
+#include "base/values.h"
+namespace aux {
+// Measurement only. Original leases come from the native Egress current path;
+// this record cannot install/rearm/authorize an effect or construct a receipt.
+class NativeCdpRetirementMeasurement final {
+ public:
+  enum class Mode { kStop, kTakeover };
+  struct OriginalPage {
+    base::DictValue lease;
+    uint64_t dispatch_count = 0;
+  };
+  NativeCdpRetirementMeasurement(Mode mode, std::string root_run,
+      std::string owner_incarnation, uint64_t connection_generation,
+      std::vector<std::string> registered_runs,
+      std::map<std::string, OriginalPage> pages);
+  ~NativeCdpRetirementMeasurement();
+  NativeCdpRetirementMeasurement(const NativeCdpRetirementMeasurement&) = delete;
+  void ApprovedDispatch(const std::string& page_id,
+      const base::DictValue& original_lease, base::TimeTicks dispatched,
+      uint64_t count);
+  void RetiredPage(const std::string& page_id,
+      const base::DictValue& original_lease,
+      const base::DictValue& original_scope, base::TimeTicks original_event,
+      base::TimeTicks admitted, base::TimeTicks last_dispatch,
+      uint64_t count, bool original_clock_valid);
+  void DocumentDestroyed(const std::string& page_id, base::TimeTicks original_destroyed);
+  void Refuse();
+  bool HasFreshDispatches() const;
+  base::DictValue ArmedRecord() const;
+  base::DictValue Complete(bool original_family_current);
+  const std::string& root_run() const { return root_run_; }
+  const std::vector<std::string>& registered_runs() const { return registered_runs_; }
+  const std::map<std::string, OriginalPage>& original_pages() const { return original_pages_; }
+  const std::string& owner_incarnation() const { return owner_incarnation_; }
+  uint64_t connection_generation() const { return connection_generation_; }
+  Mode mode() const { return mode_; }
+  base::TimeTicks deadline() const { return armed_ + base::Seconds(5); }
+  bool current() const {
+    return !refused_ && !consumed_ && base::TimeTicks::Now() < deadline();
+  }
+ private:
+  struct Page {
+    base::DictValue retired_scope;
+    base::TimeTicks event, admitted, last, destroyed;
+    uint64_t current_count = 0, retired_count = 0;
+    bool retired = false, clock_valid = false;
+  };
+  const Mode mode_;
+  const std::string root_run_;
+  const std::string owner_incarnation_;
+  const uint64_t connection_generation_;
+  const std::vector<std::string> registered_runs_;
+  const std::map<std::string, OriginalPage> original_pages_;
+  const base::TimeTicks armed_ = base::TimeTicks::Now();
+  const std::string nonce_;
+  std::map<std::string, Page> pages_;
+  bool refused_ = false;
+  bool consumed_ = false;
+};
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/aux/native_cdp_retirement_measurement_unittest.cc b/chrome/browser/ui/aux/native_cdp_retirement_measurement_unittest.cc
