diff --git a/chrome/browser/sessions/session_restore.cc b/chrome/browser/sessions/session_restore.cc
--- a/chrome/browser/sessions/session_restore.cc
+++ b/chrome/browser/sessions/session_restore.cc
@@ -1131,7 +1131,7 @@
     DCHECK(web_contents);

     RestoredTab restored_tab(web_contents, is_selected_tab,
-                             tab.extension_app_id.empty(), tab.pinned,
+                             !tab.extension_app_id.empty(), tab.pinned,
                              new_group, tab.split_id);
     restored_tabs.push_back(restored_tab);

diff --git a/chrome/browser/sessions/session_restore_delegate.cc b/chrome/browser/sessions/session_restore_delegate.cc
index cf92997e44..ce288ccacc 100644
--- a/chrome/browser/sessions/session_restore_delegate.cc
+++ b/chrome/browser/sessions/session_restore_delegate.cc
@@ -87,15 +87,24 @@ void SessionRestoreDelegate::RestoreTabs(
   if (tabs.empty())
     return;
 
+  // Keep ordinary background tabs as Chromium's restored placeholders. They
+  // load through the normal tab activation path, preserving their session
+  // navigation, stable identity and place in the strip without startup work.
+  std::vector<RestoredTab> eager_tabs;
+  for (const auto& tab : tabs) {
+    if (tab.is_active() || tab.is_pinned() || tab.is_app())
+      eager_tabs.push_back(tab);
+  }
+  if (eager_tabs.empty()) return;
   SessionRestoreStatsCollector::GetOrCreateInstance(
       restore_started,
       std::make_unique<
           SessionRestoreStatsCollector::UmaStatsReportingDelegate>())
-      ->TrackTabs(tabs);
+      ->TrackTabs(eager_tabs);
 
   std::vector<content::WebContents*> web_contents_vector;
-  web_contents_vector.reserve(tabs.size());
-  for (const auto& tab : tabs) {
+  web_contents_vector.reserve(eager_tabs.size());
+  for (const auto& tab : eager_tabs) {
     CHECK(tab.contents());
     web_contents_vector.push_back(tab.contents());
   }
