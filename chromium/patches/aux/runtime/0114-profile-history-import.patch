+
+void ProfileLibrary::ImportHistory(
+    const base::DictValue &params,
+    base::OnceCallback<void(base::DictValue)> callback) {
+  if (!history_) {
+    std::move(callback).Run(
+        Fault("backend_unavailable", "Chromium HistoryService is unavailable"));
+    return;
+  }
+  const base::ListValue *rows = params.FindList("visits");
+  if (!rows || rows->empty() || rows->size() > 500) {
+    std::move(callback).Run(Fault("invalid_argument", "Invalid history import batch"));
+    return;
+  }
+  auto state = std::make_shared<HistoryImportState>();
+  state->visits.reserve(rows->size());
+  for (const base::Value &value : *rows) {
+    const base::DictValue *row = value.GetIfDict();
+    const std::string *url = row ? row->FindString("url") : nullptr;
+    const std::string *title = row ? row->FindString("title") : nullptr;
+    const std::optional<double> at = row ? row->FindDouble("visitedAt")
+                                          : std::nullopt;
+    if (!url || !ValidWebUrl(*url) || !title || title->size() > 1000 ||
+        !at || !std::isfinite(*at) || *at < 0 ||
+        *at > static_cast<double>((base::Time::Now() + base::Days(1))
+                                      .InMillisecondsSinceUnixEpoch())) {
+      std::move(callback).Run(Fault("invalid_argument", "Invalid history visit"));
+      return;
+    }
+    state->visits.push_back({*url, *title, static_cast<int64_t>(*at)});
+  }
+  state->reply = std::move(callback);
+  ImportHistoryNext(state);
+}
+
+void ProfileLibrary::ImportHistoryNext(
+    std::shared_ptr<HistoryImportState> state) {
+  if (!history_) {
+    std::move(state->reply).Run(
+        Fault("backend_unavailable", "Chromium HistoryService closed"));
+    return;
+  }
+  if (state->next == state->visits.size()) {
+    if (!state->last_added) {
+      base::DictValue result;
+      result.Set("added", state->added);
+      result.Set("skipped", state->skipped);
+      std::move(state->reply).Run(Result(base::Value(std::move(result))));
+      return;
+    }
+    // A final query is a backend queue barrier. Do not report success before
+    // the last imported visit can be read from this Profile's HistoryService.
+    const Visit last = *state->last_added;
+    history_->QueryURLAndVisits(
+        GURL(last.url), history::VisitQuery404sPolicy::kInclude404s,
+        base::BindOnce(
+            [](base::WeakPtr<ProfileLibrary> self,
+               std::shared_ptr<HistoryImportState> state, Visit last,
+               history::QueryURLAndVisitsResult query) {
+              if (!self || !self->history_ || !query.success ||
+                  !std::any_of(query.visits.begin(), query.visits.end(),
+                               [&](const history::VisitRow &visit) {
+                                 return visit.visit_time.InMillisecondsSinceUnixEpoch() ==
+                                        last.visited_at;
+                               })) {
+                std::move(state->reply).Run(Fault(
+                    "backend_unavailable", "Imported history was not confirmed"));
+                return;
+              }
+              base::DictValue result;
+              result.Set("added", state->added);
+              result.Set("skipped", state->skipped);
+              std::move(state->reply).Run(Result(base::Value(std::move(result))));
+            },
+            weak_factory_.GetWeakPtr(), state, last),
+        &tracker_);
+    return;
+  }
+  const Visit visit = state->visits[state->next++];
+  const auto identity = std::make_pair(visit.url, visit.visited_at);
+  if (state->dispatched.contains(identity)) {
+    ++state->skipped;
+    ImportHistoryNext(state);
+    return;
+  }
+  history_->QueryURLAndVisits(
+      GURL(visit.url), history::VisitQuery404sPolicy::kInclude404s,
+      base::BindOnce(
+          [](base::WeakPtr<ProfileLibrary> self,
+             std::shared_ptr<HistoryImportState> state, Visit visit,
+             history::QueryURLAndVisitsResult query) {
+            if (!self || !self->history_) {
+              std::move(state->reply).Run(Fault(
+                  "backend_unavailable", "Chromium HistoryService closed"));
+              return;
+            }
+            const bool exists = query.success &&
+                std::any_of(query.visits.begin(), query.visits.end(),
+                            [&](const history::VisitRow &row) {
+                              return row.visit_time.InMillisecondsSinceUnixEpoch() ==
+                                     visit.visited_at;
+                            });
+            if (exists) {
+              ++state->skipped;
+            } else {
+              const GURL url(visit.url);
+              self->history_->AddPage(
+                  url, base::Time::FromMillisecondsSinceUnixEpoch(
+                           visit.visited_at),
+                  history::SOURCE_OS_MIGRATION_IMPORTED);
+              self->history_->SetPageTitle(url, base::UTF8ToUTF16(visit.title));
+              state->dispatched.insert({visit.url, visit.visited_at});
+              state->last_added = visit;
+              ++state->added;
+            }
+            self->ImportHistoryNext(state);
+          },
+          weak_factory_.GetWeakPtr(), state, visit),
+      &tracker_);
 }
 
