+  bool read_only = false;
+  bool consequential = false;
+};
+
+CONTENT_EXPORT std::vector<DocumentScriptTool> ListDocumentScriptTools(
+    WebContents* web_contents);
+
+CONTENT_EXPORT void ExecuteDocumentScriptTool(
+    WebContents* web_contents,
+    const std::string& name,
+    const std::string& input_arguments,
+    base::OnceCallback<void(std::optional<std::string> result, bool success)>
+        callback);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_DOCUMENT_SCRIPT_TOOLS_H_
