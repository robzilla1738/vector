+// Disable wins when both switches are set, so a private renderer stays off
+// even if the browser command line already enabled WebMCP.
+void AppendBlinkRuntimeFeature(base::CommandLine* command_line,
+                               const char* switch_name,
+                               std::string_view feature) {
+  const std::string existing = command_line->GetSwitchValueASCII(switch_name);
+  if (existing.empty()) {
+    command_line->AppendSwitchASCII(switch_name, feature);
+    return;
+  }
+  for (std::string_view piece : base::SplitStringPiece(
+           existing, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (piece == feature) {
+      return;
+    }
+  }
+  command_line->AppendSwitchASCII(switch_name, existing + "," + std::string(feature));
+}
