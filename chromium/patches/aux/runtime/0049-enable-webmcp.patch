+
+std::vector<DocumentScriptTool> ListDocumentScriptTools(
+    WebContents* web_contents) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  std::vector<DocumentScriptTool> tools;
+  if (!web_contents) {
+    return tools;
+  }
+  RenderFrameHost* main = web_contents->GetPrimaryMainFrame();
+  if (!main) {
+    return tools;
+  }
+  main->ForEachRenderFrameHostWithAction([&](RenderFrameHost* frame) {
+    if (frame->GetMainFrame() != main) {
+      return RenderFrameHost::FrameIterationAction::kSkipChildren;
+    }
+    ModelContextUserData* data = UserDataForFrame(frame);
+    if (!data) {
+      return RenderFrameHost::FrameIterationAction::kContinue;
+    }
+    for (const auto& tool : data->script_tools()) {
+      tools.push_back(ToolInfo(*tool));
+    }
+    return RenderFrameHost::FrameIterationAction::kContinue;
+  });
+  return tools;
 }
 
+void ExecuteDocumentScriptTool(
+    WebContents* web_contents,
+    const std::string& name,
+    const std::string& input_arguments,
+    base::OnceCallback<void(std::optional<std::string> result, bool success)>
+        callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!web_contents) {
+    std::move(callback).Run(std::nullopt, false);
+    return;
+  }
+  RenderFrameHost* main = web_contents->GetPrimaryMainFrame();
+  if (!main) {
+    std::move(callback).Run(std::nullopt, false);
+    return;
+  }
+  ModelContextUserData* owner = nullptr;
+  main->ForEachRenderFrameHostWithAction([&](RenderFrameHost* frame) {
+    if (owner || frame->GetMainFrame() != main) {
+      return owner ? RenderFrameHost::FrameIterationAction::kStop
+                   : RenderFrameHost::FrameIterationAction::kSkipChildren;
+    }
+    ModelContextUserData* data = UserDataForFrame(frame);
+    if (!data) {
+      return RenderFrameHost::FrameIterationAction::kContinue;
+    }
+    for (const auto& tool : data->script_tools()) {
+      if (tool->name == name) {
+        owner = data;
+        return RenderFrameHost::FrameIterationAction::kStop;
+      }
+    }
+    return RenderFrameHost::FrameIterationAction::kContinue;
+  });
+  if (!owner) {
+    std::move(callback).Run(std::nullopt, false);
+    return;
+  }
+  owner->ExecuteOwnedTool(
+      name, input_arguments,
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<std::string>, bool)> callback,
+             const std::optional<std::string>& result, bool success) {
+            std::move(callback).Run(result, success);
+          },
+          std::move(callback)));
+}
+
+DocumentScriptTool::DocumentScriptTool() = default;
+DocumentScriptTool::DocumentScriptTool(DocumentScriptTool&&) = default;
+DocumentScriptTool& DocumentScriptTool::operator=(DocumentScriptTool&&) = default;
+DocumentScriptTool::~DocumentScriptTool() = default;
+
 }  // namespace content
