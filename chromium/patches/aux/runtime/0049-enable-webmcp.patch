+namespace content {
+
+class WebContents;
+
+// A script tool registered on a document via WebMCP. Missing annotations mean
+// the tool is not read-only.
+struct CONTENT_EXPORT DocumentScriptTool {
+  DocumentScriptTool();
+  DocumentScriptTool(DocumentScriptTool&&);
+  DocumentScriptTool& operator=(DocumentScriptTool&&);
+  ~DocumentScriptTool();
