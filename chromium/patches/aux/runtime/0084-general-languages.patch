+    languages.GetAcceptLanguagesList(&effective);
+    base::ListValue selected_json;
+    base::ListValue effective_json;
+    for (const auto& code : selected) selected_json.Append(code);
+    for (const auto& code : effective) effective_json.Append(code);
+    base::ListValue forced_json =
+        prefs->GetList(language::prefs::kForcedLanguages).Clone();
+    base::DictValue result;
+    result.Set("selected", std::move(selected_json));
+    result.Set("effective", std::move(effective_json));
+    result.Set("forced", std::move(forced_json));
+    result.Set("managed", selected_pref->IsManaged());
+    std::move(callback).Run(true, *base::WriteJson(base::Value(std::move(result))),
+                            "", "");
+    return;
+  }
