+#include "chrome/browser/ui/aux/secret_store_mac.h"
+
+#import <Security/Security.h>
+
+#include "base/apple/scoped_cftyperef.h"
+
+namespace aux {
+namespace {
+
+bool ValidName(const std::string& name) {
+  if (name.empty() || name.size() > 64 ||
+      !((name[0] >= 'A' && name[0] <= 'Z') ||
+        (name[0] >= 'a' && name[0] <= 'z'))) {
+    return false;
+  }
+  for (char character : name.substr(1)) {
+    if (!((character >= 'A' && character <= 'Z') ||
+          (character >= 'a' && character <= 'z') ||
+          (character >= '0' && character <= '9') || character == '_' ||
+          character == '-')) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::apple::ScopedCFTypeRef<CFMutableDictionaryRef> Query(
+    const base::FilePath& profile_path,
+    const std::string& name) {
+  base::apple::ScopedCFTypeRef<CFMutableDictionaryRef> query(
+      CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+                                &kCFTypeDictionaryKeyCallBacks,
+                                &kCFTypeDictionaryValueCallBacks));
+  const std::string service = "dev.aux.browser:" + profile_path.AsUTF8Unsafe();
+  base::apple::ScopedCFTypeRef<CFStringRef> service_ref(
+      CFStringCreateWithCString(kCFAllocatorDefault, service.c_str(),
+                                kCFStringEncodingUTF8));
+  base::apple::ScopedCFTypeRef<CFStringRef> account_ref(
+      CFStringCreateWithCString(kCFAllocatorDefault, name.c_str(),
+                                kCFStringEncodingUTF8));
+  if (!query || !service_ref || !account_ref) {
+    return base::apple::ScopedCFTypeRef<CFMutableDictionaryRef>();
+  }
+  CFDictionarySetValue(query.get(), kSecClass, kSecClassGenericPassword);
+  CFDictionarySetValue(query.get(), kSecAttrService, service_ref.get());
+  CFDictionarySetValue(query.get(), kSecAttrAccount, account_ref.get());
+  CFDictionarySetValue(query.get(), kSecAttrSynchronizable, kCFBooleanFalse);
+  return query;
+}
+
+}  // namespace
+
+bool StoreSecret(const base::FilePath& profile_path,
+                 const std::string& name,
+                 const std::string& value,
+                 std::string* error) {
+  if (!ValidName(name) || value.size() > 1024 * 1024) {
+    *error = "Invalid credential name or size";
+    return false;
+  }
+  auto query = Query(profile_path, name);
+  if (!query) {
+    *error = "Cannot prepare the Aux Keychain item";
+    return false;
+  }
+  if (value.empty()) {
+    const OSStatus status = SecItemDelete(query.get());
+    if (status == errSecSuccess || status == errSecItemNotFound) {
+      return true;
+    }
+    *error = "Cannot remove the saved credential from Keychain";
+    return false;
+  }
+  base::apple::ScopedCFTypeRef<CFDataRef> data(
+      CFDataCreate(kCFAllocatorDefault,
+                   reinterpret_cast<const UInt8*>(value.data()), value.size()));
+  if (!data) {
+    *error = "Cannot prepare the credential for Keychain";
+    return false;
+  }
+  base::apple::ScopedCFTypeRef<CFMutableDictionaryRef> update(
+      CFDictionaryCreateMutable(kCFAllocatorDefault, 0,
+                                &kCFTypeDictionaryKeyCallBacks,
+                                &kCFTypeDictionaryValueCallBacks));
+  CFDictionarySetValue(update.get(), kSecValueData, data.get());
+  OSStatus status = SecItemUpdate(query.get(), update.get());
+  if (status == errSecItemNotFound) {
+    CFDictionarySetValue(query.get(), kSecValueData, data.get());
+    status = SecItemAdd(query.get(), nullptr);
+  }
+  if (status != errSecSuccess) {
+    *error = "Cannot save the credential in Keychain";
+    return false;
+  }
+  return true;
+}
+
+bool ReadSecret(const base::FilePath& profile_path,
+                const std::string& name,
+                std::optional<std::string>* value,
+                std::string* error) {
+  if (!ValidName(name)) {
+    *error = "Invalid credential name";
+    return false;
+  }
+  auto query = Query(profile_path, name);
+  if (!query) {
+    *error = "Cannot prepare the Aux Keychain item";
+    return false;
+  }
+  CFDictionarySetValue(query.get(), kSecReturnData, kCFBooleanTrue);
+  CFDictionarySetValue(query.get(), kSecMatchLimit, kSecMatchLimitOne);
+  CFTypeRef copied = nullptr;
+  const OSStatus status = SecItemCopyMatching(query.get(), &copied);
+  base::apple::ScopedCFTypeRef<CFTypeRef> result(copied);
+  if (status == errSecItemNotFound) {
+    *value = std::nullopt;
+    return true;
+  }
+  if (status != errSecSuccess || !result ||
+      CFGetTypeID(result.get()) != CFDataGetTypeID()) {
+    *error = "Saved credential is unavailable from Keychain";
+    return false;
+  }
+  CFDataRef data = static_cast<CFDataRef>(result.get());
+  *value = std::string(reinterpret_cast<const char*>(CFDataGetBytePtr(data)),
+                       CFDataGetLength(data));
+  return true;
+}
+
+}  // namespace aux
