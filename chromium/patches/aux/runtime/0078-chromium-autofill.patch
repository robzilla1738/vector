+autofill::PersonalDataManager* AuxPersonalData(Profile* profile) {
+  auto* data = autofill::PersonalDataManagerFactory::GetForBrowserContext(profile);
+  return data && data->IsDataLoaded() ? data : nullptr;
+}
+
+const autofill::AutofillProfile* AuxAddressProfile(
+    Profile* profile, autofill::PersonalDataManager* data) {
+  const std::string guid =
+      profile->GetPrefs()->GetString(aux::kAutofillProfileGuidPref);
+  return guid.empty() ? nullptr :
+      data->address_data_manager().GetProfileByGUID(guid);
+}
+
+bool AuxCanFillAddressOn(const GURL& url) {
+  return url.SchemeIs("https") ||
+         (url.SchemeIs("http") &&
+          (url.host() == "localhost" || url.host() == "127.0.0.1" ||
+           url.host() == "[::1]"));
+}
