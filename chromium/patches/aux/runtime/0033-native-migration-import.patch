+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/migration_import.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+namespace {
+
+base::DictValue Fixture() {
+  base::DictValue manifest;
+  manifest.Set("format", "aux-electron-to-chromium");
+  manifest.Set("version", 1);
+  manifest.Set("contentHash", std::string(64, 'a'));
+  base::DictValue space;
+  space.Set("id", "space-a");
+  space.Set("name", "Research");
+  space.Set("color", "violet");
+  space.Set("archived", false);
+  base::ListValue spaces;
+  spaces.Append(std::move(space));
+  base::DictValue tab;
+  tab.Set("sourcePageId", "electron-tab-a");
+  tab.Set("spaceId", "space-a");
+  tab.Set("url", "https://example.com/");
+  tab.Set("title", "Example");
+  base::ListValue tabs;
+  tabs.Append(std::move(tab));
+  base::DictValue bookmark;
+  bookmark.Set("url", "https://example.com/docs");
+  bookmark.Set("title", "Docs");
+  bookmark.Set("folderPath", base::ListValue());
+  base::ListValue bookmarks;
+  bookmarks.Append(std::move(bookmark));
+  base::DictValue layout;
+  layout.Set("spaces", std::move(spaces));
+  layout.Set("activeSpaceId", "space-a");
+  base::ListValue order;
+  order.Append("electron-tab-a");
+  layout.Set("order", std::move(order));
+  layout.Set("folders", base::ListValue());
+  layout.Set("pins", base::DictValue());
+  layout.Set("activeTabs", base::DictValue());
+  layout.Set("splits", base::DictValue());
+  layout.Set("splitRatio", 0.5);
+  manifest.Set("layout", std::move(layout));
+  manifest.Set("tabs", std::move(tabs));
+  manifest.Set("bookmarks", std::move(bookmarks));
+  manifest.Set("bookmarkFolders", base::ListValue());
+  return manifest;
+}
+
+TEST(MigrationImportTest, AcceptsBoundedCopiedProfileManifest) {
+  std::string error;
+  EXPECT_TRUE(MigrationImport::ValidateManifestForTest(Fixture(), &error))
+      << error;
+}
+
+TEST(MigrationImportTest, RejectsCredentialBearingAndNonWebAddresses) {
+  for (const char* unsafe : {"https://ada:secret@example.com/",
+                             "javascript:alert(1)", "file:///private/secret"}) {
+    base::DictValue manifest = Fixture();
+    manifest.FindList("tabs")->front().GetDict().Set("url", unsafe);
+    std::string error;
+    EXPECT_FALSE(MigrationImport::ValidateManifestForTest(manifest, &error));
+    EXPECT_FALSE(error.empty());
+  }
+}
+
+TEST(MigrationImportTest, RejectsMissingSpaceAndDuplicateBookmarks) {
+  base::DictValue manifest = Fixture();
+  manifest.FindList("tabs")->front().GetDict().Set("spaceId", "missing");
+  std::string error;
+  EXPECT_FALSE(MigrationImport::ValidateManifestForTest(manifest, &error));
+  manifest = Fixture();
+  manifest.FindList("bookmarks")->Append(
+      manifest.FindList("bookmarks")->front().Clone());
+  error.clear();
+  EXPECT_FALSE(MigrationImport::ValidateManifestForTest(manifest, &error));
+}
+
+}  // namespace
+}  // namespace aux
