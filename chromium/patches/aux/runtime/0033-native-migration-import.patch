+bool MigrationImport::ValidateManifestForTest(const base::DictValue& manifest,
+                                               std::string* error) {
+  if (!Equals(manifest.FindString("format"), "aux-electron-to-chromium") ||
+      manifest.FindInt("version") != 1 ||
+      !Digest(manifest.FindString("contentHash"))) {
+    *error = "Unsupported migration manifest";
+    return false;
+  }
+  const base::DictValue* layout = manifest.FindDict("layout");
+  const base::ListValue* tabs = manifest.FindList("tabs");
+  const base::ListValue* bookmarks = manifest.FindList("bookmarks");
+  const base::ListValue* folders = manifest.FindList("bookmarkFolders");
+  const base::ListValue* spaces = layout ? layout->FindList("spaces") : nullptr;
+  const base::ListValue* order = layout ? layout->FindList("order") : nullptr;
+  const base::ListValue* layout_folders = layout ? layout->FindList("folders") : nullptr;
+  const base::DictValue* pins = layout ? layout->FindDict("pins") : nullptr;
+  const base::DictValue* active_tabs = layout ? layout->FindDict("activeTabs") : nullptr;
+  const base::DictValue* splits = layout ? layout->FindDict("splits") : nullptr;
+  if (!tabs || tabs->size() > 5000 || !bookmarks || bookmarks->size() > 100000 ||
+      !folders || folders->size() > 10000 || !spaces || spaces->empty() ||
+      spaces->size() > 200 || !order || order->size() > 5000 ||
+      !layout_folders || layout_folders->size() > 1000 || !pins ||
+      !active_tabs || !splits || !layout->FindDouble("splitRatio")) {
+    *error = "Migration exceeds native tab, bookmark, or layout limits";
+    return false;
+  }
+  std::set<std::string> space_ids, tab_ids, bookmark_urls, folder_ids;
+  size_t active_spaces = 0;
+  for (const base::Value& item : *spaces) {
+    const base::DictValue* space = item.GetIfDict();
+    const std::string* id = space ? Required(*space, "id") : nullptr;
+    if (!id || !space_ids.insert(*id).second ||
+        !Required(*space, "name", 100) ||
+        !Required(*space, "color", 20) ||
+        (space->FindInt("grain") &&
+         (*space->FindInt("grain") < 0 || *space->FindInt("grain") > 100))) {
+      *error = "Invalid or duplicate migration Space";
+      return false;
+    }
+    if (!space->FindBool("archived").value_or(false)) ++active_spaces;
+  }
+  const std::string* active_space = layout->FindString("activeSpaceId");
+  if (!active_space || !space_ids.contains(*active_space) || !active_spaces) {
+    *error = "Migration active Space is missing";
+    return false;
+  }
+  for (const base::Value& item : *tabs) {
+    const base::DictValue* tab = item.GetIfDict();
+    const std::string* id = tab ? Required(*tab, "sourcePageId") : nullptr;
+    const std::string* space = tab ? tab->FindString("spaceId") : nullptr;
+    if (!id || !tab_ids.insert(*id).second || !space ||
+        !space_ids.contains(*space) || !WebUrl(tab->FindString("url")) ||
+        !tab->FindString("title")) {
+      *error = "Invalid or duplicate migration tab";
+      return false;
+    }
+  }
+  for (const base::Value& item : *layout_folders) {
+    const base::DictValue* folder = item.GetIfDict();
+    const std::string* id = folder ? Required(*folder, "id") : nullptr;
+    const std::string* space = folder ? folder->FindString("spaceId") : nullptr;
+    if (!id || !folder_ids.insert(*id).second || !space ||
+        !space_ids.contains(*space) || !Required(*folder, "name", 100) ||
+        !folder->FindBool("collapsed")) {
+      *error = "Invalid migration tab folder";
+      return false;
+    }
+  }
+  for (const base::Value& item : *tabs) {
+    const base::DictValue& tab = item.GetDict();
+    if (const std::string* folder = tab.FindString("folderId");
+        folder && !folder_ids.contains(*folder)) {
+      *error = "Migration tab folder is missing";
+      return false;
+    }
+  }
+  for (auto it = active_tabs->begin(); it != active_tabs->end(); ++it) {
+    const std::string* id = it->second.GetIfString();
+    if (!space_ids.contains(it->first) || !id || !tab_ids.contains(*id)) {
+      *error = "Migration active tab is missing";
+      return false;
+    }
+  }
+  for (auto it = splits->begin(); it != splits->end(); ++it) {
+    const std::string* id = it->second.GetIfString();
+    if (!tab_ids.contains(it->first) || !id || !tab_ids.contains(*id)) {
+      *error = "Migration split tab is missing";
+      return false;
+    }
+  }
+  for (const base::Value& item : *order) {
+    const std::string* id = item.GetIfString();
+    if (!id || !tab_ids.contains(*id)) {
+      *error = "Migration tab order contains a missing tab";
+      return false;
+    }
+  }
+  for (const base::Value& item : *bookmarks) {
+    const base::DictValue* bookmark = item.GetIfDict();
+    const std::string* url = bookmark ? bookmark->FindString("url") : nullptr;
+    const base::ListValue* path = bookmark ? bookmark->FindList("folderPath") : nullptr;
+    if (!WebUrl(url) || !bookmark_urls.insert(*url).second ||
+        !path || path->size() > 16 || !bookmark->FindString("title")) {
+      *error = "Invalid or duplicate migration bookmark";
+      return false;
+    }
+    for (const base::Value& segment : *path) {
+      const std::string* text = segment.GetIfString();
+      if (!text || text->empty() || text->size() > 200) {
+        *error = "Invalid migration bookmark folder";
+        return false;
+      }
+    }
+  }
+  for (const base::Value& path : *folders) {
+    const base::ListValue* segments = path.GetIfList();
+    if (!segments || segments->size() > 16) {
+      *error = "Invalid migration folder path";
+      return false;
+    }
+    for (const base::Value& segment : *segments) {
+      const std::string* name = segment.GetIfString();
+      if (!name || name->empty() || name->size() > 200) {
+        *error = "Invalid migration folder name";
+        return false;
+      }
+    }
+  }
+  for (auto it = pins->begin(); it != pins->end(); ++it) {
+    if (!space_ids.contains(it->first) || !it->second.is_list() ||
+        it->second.GetList().size() > 500) {
+      *error = "Invalid migration pin collection";
+      return false;
+    }
+    for (const base::Value& pin_value : it->second.GetList()) {
+      const base::DictValue* pin = pin_value.GetIfDict();
+      if (!pin || !WebUrl(pin->FindString("url")) ||
+          !pin->FindString("title")) {
+        *error = "Invalid migration pin";
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool MigrationImport::Load(std::string* error) {
+  if (loaded_) return true;
+  std::string text;
+  if (!ReadPrivateFile(ManifestPath(profile_), kMaxManifestBytes, &text)) {
+    *error = "No verified migration seed is installed in this Profile";
+    return false;
+  }
+  auto manifest = base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+  auto receipt = ReadDict(SeedReceiptPath(profile_), kMaxReceiptBytes);
+  if (!manifest || !receipt ||
+      !ValidateManifestForTest(*manifest, error) ||
+      !Equals(receipt->FindString("format"), "aux-chromium-profile-seed") ||
+      receipt->FindInt("version") != 1 ||
+      !Equals(receipt->FindString("contentHash"),
+              *manifest->FindString("contentHash")) ||
+      !Equals(receipt->FindString("manifestSha256"), Sha256(text))) {
+    if (error->empty()) *error = "Migration seed receipt or manifest digest does not match";
+    return false;
+  }
+  manifest_sha256_ = Sha256(text);
+  content_hash_ = *manifest->FindString("contentHash");
+  manifest_ = std::move(*manifest);
+  loaded_ = true;
+  return true;
+}
+
+bool MigrationImport::VerifyToken(const base::DictValue& params,
+                                   std::string* error) const {
+  if (!Equals(params.FindString("manifestSha256"), manifest_sha256_) ||
+      !Equals(params.FindString("contentHash"), content_hash_)) {
+    *error = "Migration review is stale; review the seed again";
+    return false;
+  }
+  return true;
+}
+
+std::optional<base::DictValue> MigrationImport::Review(
+    BrowserWindowInterface* browser, std::string* error) {
+  if (!Load(error)) return std::nullopt;
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (!model || !model->loaded() || !browser ||
+      browser->GetProfile() != profile_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    *error = "Chromium Profile bookmarks or browser window are not ready";
+    return std::nullopt;
+  }
+  const auto completed = ReadDict(CompletionPath(profile_), kMaxReceiptBytes);
+  const auto journal = ReadDict(JournalPath(profile_), kMaxJournalBytes);
+  if (base::PathExists(CompletionPath(profile_)) && !completed) {
+    *error = "Native migration completion receipt is damaged";
+    return std::nullopt;
+  }
+  if (base::PathExists(JournalPath(profile_)) && !journal) {
+    *error = "Native migration journal is damaged";
+    return std::nullopt;
+  }
+  if (completed &&
+      (!Equals(completed->FindString("format"), "aux-native-migration-complete") ||
+       completed->FindInt("version") != 1 ||
+       !Equals(completed->FindString("contentHash"), content_hash_) ||
+       !Equals(completed->FindString("manifestSha256"), manifest_sha256_))) {
+    *error = "This Profile was imported from a different seed";
+    return std::nullopt;
+  }
+  if (journal &&
+      (!Equals(journal->FindString("format"), "aux-native-migration-journal") ||
+       journal->FindInt("version") != 1 ||
+       !Equals(journal->FindString("contentHash"), content_hash_) ||
+       !Equals(journal->FindString("manifestSha256"), manifest_sha256_) ||
+       !journal->FindDict("priorOrganization"))) {
+    *error = "A different migration is already in progress";
+    return std::nullopt;
+  }
+  base::DictValue result;
+  result.Set("status", completed ? "applied" : journal ? "interrupted" : "ready");
+  result.Set("contentHash", content_hash_);
+  result.Set("manifestSha256", manifest_sha256_);
+  result.Set("tabs", static_cast<int>(manifest_.FindList("tabs")->size()));
+  result.Set("bookmarks", static_cast<int>(manifest_.FindList("bookmarks")->size()));
+  result.Set("bookmarkFolders", static_cast<int>(manifest_.FindList("bookmarkFolders")->size()));
+  result.Set("spaces", static_cast<int>(manifest_.FindDict("layout")->FindList("spaces")->size()));
+  result.Set("omitted", manifest_.FindDict("omitted") ?
+                            manifest_.FindDict("omitted")->Clone() : base::DictValue());
+  const auto seed_receipt = ReadDict(SeedReceiptPath(profile_), kMaxReceiptBytes);
+  result.Set("vaultPending", seed_receipt && seed_receipt->FindDict("vault"));
+  if (journal) result.Set("progress", Progress(*journal));
+  return result;
+}
+
+std::optional<base::DictValue> MigrationImport::Begin(
+    BrowserWindowInterface* browser, const base::DictValue& params,
+    std::string* error) {
+  auto review = Review(browser, error);
+  if (!review || !VerifyToken(params, error)) return std::nullopt;
+  const std::string* status = review->FindString("status");
+  if (*status == "applied") return review;
+  if (*status == "interrupted") return review;
+  if (!params.FindBool("confirmed").value_or(false)) {
+    *error = "Confirm the reviewed migration before importing";
+    return std::nullopt;
+  }
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (ImportRoot(model, content_hash_)) {
+    *error = "An imported bookmark folder already exists without a migration journal";
+    return std::nullopt;
+  }
+  for (const base::Value& item : *manifest_.FindList("bookmarks")) {
+    if (!model->GetNodesByURL(GURL(*item.GetDict().FindString("url"))).empty()) {
+      *error = "A migration bookmark already exists in this Profile";
+      return std::nullopt;
+    }
+  }
+  auto* tabs = browser->GetTabStripModel();
+  if (!tabs || tabs->count() > 1 ||
+      (tabs->count() == 1 &&
+       !tabs->GetWebContentsAt(0)->GetLastCommittedURL().SchemeIs("chrome") &&
+       !tabs->GetWebContentsAt(0)->GetLastCommittedURL().SchemeIs("about"))) {
+    *error = "Import into a new Profile before opening browsing tabs";
+    return std::nullopt;
+  }
+  base::DictValue journal;
+  journal.Set("format", "aux-native-migration-journal");
+  journal.Set("version", 1);
+  journal.Set("contentHash", content_hash_);
+  journal.Set("manifestSha256", manifest_sha256_);
+  journal.Set("folders", 0);
+  journal.Set("bookmarks", 0);
+  journal.Set("tabs", 0);
+  journal.Set("phase", "importing");
+  journal.Set("priorOrganization",
+              profile_->GetPrefs()->GetDict(kOrganizationPref).Clone());
+  if (!WritePrivateDict(JournalPath(profile_), journal)) {
+    *error = "Could not create the private native migration journal";
+    return std::nullopt;
+  }
+  return Progress(journal);
+}
+
+std::optional<base::DictValue> MigrationImport::Batch(
+    BrowserWindowInterface* browser, const base::DictValue& params,
+    std::string* error) {
+  if (!Load(error) || !VerifyToken(params, error)) return std::nullopt;
+  auto journal = ReadDict(JournalPath(profile_), kMaxJournalBytes);
+  const std::string* section = params.FindString("section");
+  const std::optional<int> offset = params.FindInt("offset");
+  if (!journal || !section || !offset || *offset < 0 ||
+      *offset % kBatchSize != 0 ||
+      (!Equals(journal->FindString("phase"), "importing") &&
+       !Equals(journal->FindString("phase"), "committing"))) {
+    *error = "Migration batch is out of sequence or the journal is missing";
+    return std::nullopt;
+  }
+  const base::ListValue* items = nullptr;
+  const char* counter = nullptr;
+  if (*section == "folders") {
+    items = manifest_.FindList("bookmarkFolders"); counter = "folders";
+  } else if (*section == "bookmarks") {
+    items = manifest_.FindList("bookmarks"); counter = "bookmarks";
+  } else if (*section == "tabs") {
+    items = manifest_.FindList("tabs"); counter = "tabs";
+  }
+  if (!items || *offset > static_cast<int>(items->size()) ||
+      *offset > journal->FindInt(counter).value_or(0) ||
+      (*section == "bookmarks" &&
+       journal->FindInt("folders").value_or(0) !=
+           static_cast<int>(manifest_.FindList("bookmarkFolders")->size())) ||
+      (*section == "tabs" &&
+       journal->FindInt("bookmarks").value_or(0) !=
+           static_cast<int>(manifest_.FindList("bookmarks")->size()))) {
+    *error = "Migration batches must complete folders, bookmarks, then tabs";
+    return std::nullopt;
+  }
+  if (Equals(journal->FindString("phase"), "committing"))
+    return Progress(*journal);
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (!model || !model->loaded()) {
+    *error = "Chromium bookmarks are not ready";
+    return std::nullopt;
+  }
+  const bookmarks::BookmarkNode* root = ImportRoot(model, content_hash_);
+  if (!root && *section != "tabs" && !items->empty()) {
+    bookmarks::BookmarkNode::MetaInfoMap metadata;
+    metadata[kImportMeta] = content_hash_;
+    root = model->AddFolder(model->bookmark_bar_node(),
+                            model->bookmark_bar_node()->children().size(),
+                            base::UTF8ToUTF16(ImportFolderName(content_hash_)),
+                            &metadata);
+  }
+  if (root && !AllMarked(root, content_hash_)) {
+    *error = "The imported bookmark folder changed during migration";
+    return std::nullopt;
+  }
+  const int end = std::min(static_cast<int>(items->size()), *offset + kBatchSize);
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  for (int i = *offset; i < end; ++i) {
+    const base::Value& item = (*items)[i];
+    if (*section == "folders") {
+      if (!EnsureFolder(model, root, item.GetList(), content_hash_)) {
+        *error = "Could not create a migration bookmark folder";
+        return std::nullopt;
+      }
+    } else if (*section == "bookmarks") {
+      const base::DictValue& bookmark = item.GetDict();
+      const GURL url(*bookmark.FindString("url"));
+      const auto existing = model->GetNodesByURL(url);
+      if (!existing.empty()) {
+        if (existing.size() != 1 || !IsUnder(existing[0], root)) {
+          *error = "A migration bookmark conflicts with Profile data";
+          return std::nullopt;
+        }
+        continue;
+      }
+      const bookmarks::BookmarkNode* folder = EnsureFolder(
+          model, root, *bookmark.FindList("folderPath"), content_hash_);
+      if (!folder) {
+        *error = "Could not create a migration bookmark folder";
+        return std::nullopt;
+      }
+      bookmarks::BookmarkNode::MetaInfoMap metadata;
+      metadata[kImportMeta] = content_hash_;
+      if (bookmark.FindBool("readingList").value_or(false)) {
+        metadata["aux.readingList"] = "1";
+        if (const base::Value* read_at = bookmark.Find("readAt");
+            read_at && (read_at->is_double() || read_at->is_int()))
+          metadata["aux.readAt"] = base::NumberToString(
+              read_at->is_int() ? read_at->GetInt() : read_at->GetDouble());
+      }
+      const base::Value* created_at = bookmark.Find("createdAt");
+      const double created_ms = created_at && created_at->is_int()
+                                    ? created_at->GetInt()
+                                    : created_at && created_at->is_double()
+                                          ? created_at->GetDouble() : 0;
+      model->AddURL(
+          folder, folder->children().size(),
+          base::UTF8ToUTF16(*bookmark.FindString("title")), url, &metadata,
+          base::Time::FromMillisecondsSinceUnixEpoch(created_ms));
+    } else {
+      const base::DictValue& tab = item.GetDict();
+      const std::string page_id = PageId(content_hash_,
+                                          *tab.FindString("sourcePageId"));
+      if (content::WebContents* existing = catalog->FindPage(page_id)) {
+        if (existing->GetVisibleURL() != GURL(*tab.FindString("url"))) {
+          *error = "An imported tab changed before migration finished";
+          return std::nullopt;
+        }
+        continue;
+      }
+      base::DictValue command;
+      command.Set("kind", "open");
+      command.Set("pageId", page_id);
+      command.Set("url", *tab.FindString("url"));
+      command.Set("background", true);
+      const base::DictValue ack = catalog->Command(
+          browser, "migration-open-" + page_id, command, std::nullopt);
+      if (!Equals(ack.FindString("status"), "applied")) {
+        *error = "Chromium could not create an imported tab";
+        return std::nullopt;
+      }
+    }
+  }
+  journal->Set(counter, std::max(end, journal->FindInt(counter).value_or(0)));
+  if (!WritePrivateDict(JournalPath(profile_), *journal)) {
+    *error = "Could not persist native migration progress";
+    return std::nullopt;
+  }
+  return Progress(*journal);
+}
+
+std::optional<base::DictValue> MigrationImport::Finish(
+    BrowserWindowInterface* browser, const base::DictValue& params,
+    std::string* error) {
+  auto review = Review(browser, error);
+  if (!review || !VerifyToken(params, error)) return std::nullopt;
+  if (Equals(review->FindString("status"), "applied")) return review;
+  auto journal = ReadDict(JournalPath(profile_), kMaxJournalBytes);
+  if (!journal ||
+      journal->FindInt("folders") !=
+          static_cast<int>(manifest_.FindList("bookmarkFolders")->size()) ||
+      journal->FindInt("bookmarks") !=
+          static_cast<int>(manifest_.FindList("bookmarks")->size()) ||
+      journal->FindInt("tabs") !=
+          static_cast<int>(manifest_.FindList("tabs")->size())) {
+    *error = "Native migration batches are incomplete";
+    return std::nullopt;
+  }
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  for (const base::Value& item : *manifest_.FindList("tabs")) {
+    const base::DictValue& tab = item.GetDict();
+    content::WebContents* contents = catalog->FindPage(
+        PageId(content_hash_, *tab.FindString("sourcePageId")));
+    if (!contents || contents->GetVisibleURL() !=
+                         GURL(*tab.FindString("url"))) {
+      *error = "Imported tabs changed before final verification";
+      return std::nullopt;
+    }
+  }
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  const bookmarks::BookmarkNode* root = ImportRoot(model, content_hash_);
+  if (!manifest_.FindList("bookmarks")->empty() &&
+      (!root || !AllMarked(root, content_hash_))) {
+    *error = "Imported bookmarks changed before final verification";
+    return std::nullopt;
+  }
+  for (const base::Value& item : *manifest_.FindList("bookmarks")) {
+    const auto nodes = model->GetNodesByURL(GURL(*item.GetDict().FindString("url")));
+    if (nodes.size() != 1 || !IsUnder(nodes[0], root)) {
+      *error = "Imported bookmarks changed before final verification";
+      return std::nullopt;
+    }
+  }
+  const base::DictValue& source = *manifest_.FindDict("layout");
+  base::DictValue shared, window, active_tabs, tab_space, tab_folder, splits;
+  base::ListValue spaces, archived, order;
+  for (const base::Value& item : *source.FindList("spaces")) {
+    base::DictValue space = item.GetDict().Clone();
+    if (!space.FindInt("grain")) space.Set("grain", 0);
+    (space.FindBool("archived").value_or(false) ? archived : spaces)
+        .Append(std::move(space));
+  }
+  if (spaces.empty()) {
+    *error = "Migration has no active Space";
+    return std::nullopt;
+  }
+  shared.Set("spaces", std::move(spaces));
+  shared.Set("archivedSpaces", std::move(archived));
+  shared.Set("pins", source.FindDict("pins")->Clone());
+  shared.Set("folders", source.FindList("folders")->Clone());
+  for (const base::Value& item : *manifest_.FindList("tabs")) {
+    const base::DictValue& tab = item.GetDict();
+    const std::string page_id = PageId(content_hash_,
+                                        *tab.FindString("sourcePageId"));
+    tab_space.Set(page_id, *tab.FindString("spaceId"));
+    if (const std::string* folder = tab.FindString("folderId"))
+      tab_folder.Set(page_id, *folder);
+  }
+  for (const base::Value& id : *source.FindList("order"))
+    order.Append(PageId(content_hash_, id.GetString()));
+  for (auto it = source.FindDict("activeTabs")->begin();
+       it != source.FindDict("activeTabs")->end(); ++it)
+    active_tabs.Set(it->first, PageId(content_hash_, it->second.GetString()));
+  for (auto it = source.FindDict("splits")->begin();
+       it != source.FindDict("splits")->end(); ++it)
+    splits.Set(PageId(content_hash_, it->first),
+               PageId(content_hash_, it->second.GetString()));
+  window.Set("activeSpaceId", *source.FindString("activeSpaceId"));
+  window.Set("activeTabs", std::move(active_tabs));
+  window.Set("splitRatio", source.FindDouble("splitRatio").value_or(0.5));
+  window.Set("tabSpace", std::move(tab_space));
+  window.Set("order", std::move(order));
+  window.Set("tabFolder", std::move(tab_folder));
+  window.Set("splits", std::move(splits));
+  base::DictValue layout;
+  layout.Set("shared", std::move(shared));
+  layout.Set("window", std::move(window));
+  const std::string window_id =
+      base::NumberToString(browser->GetSessionID().id());
+  auto snapshot = OrganizationStore::Snapshot(profile_, window_id, error);
+  if (!snapshot) return std::nullopt;
+  if (Equals(journal->FindString("phase"), "committing")) {
+    const int before = journal->FindInt("organizationRevision").value_or(-1);
+    const int current = *snapshot->FindInt("revision");
+    if (before < 0 || current < before || current > before + 1 ||
+        (current == before + 1 &&
+         (!snapshot->FindDict("layout") ||
+          *snapshot->FindDict("layout") != layout))) {
+      *error = "Profile organization changed after the migration checkpoint";
+      return std::nullopt;
+    }
+    if (current == before && !OrganizationStore::Commit(
+                                 profile_, window_id, before, layout, error))
+      return std::nullopt;
+  } else {
+    journal->Set("phase", "committing");
+    journal->Set("organizationRevision", *snapshot->FindInt("revision"));
+    if (!WritePrivateDict(JournalPath(profile_), *journal)) {
+      *error = "Could not checkpoint the native organization commit";
+      return std::nullopt;
+    }
+    if (!OrganizationStore::Commit(profile_, window_id,
+                                    *snapshot->FindInt("revision"), layout,
+                                    error)) return std::nullopt;
+  }
+  base::DictValue receipt;
+  receipt.Set("format", "aux-native-migration-complete");
+  receipt.Set("version", 1);
+  receipt.Set("contentHash", content_hash_);
+  receipt.Set("manifestSha256", manifest_sha256_);
+  receipt.Set("tabs", static_cast<int>(manifest_.FindList("tabs")->size()));
+  receipt.Set("bookmarks", static_cast<int>(manifest_.FindList("bookmarks")->size()));
+  const auto seed_receipt = ReadDict(SeedReceiptPath(profile_), kMaxReceiptBytes);
+  if (seed_receipt && seed_receipt->FindDict("vault"))
+    receipt.Set("vault", "pending_native_import");
+  if (!WritePrivateDict(CompletionPath(profile_), receipt)) {
+    *error = "Could not persist native migration completion";
+    return std::nullopt;
+  }
+  base::DeleteFile(JournalPath(profile_));
+  return Review(browser, error);
+}
+
+std::optional<base::DictValue> MigrationImport::Rollback(
+    BrowserWindowInterface* browser, const base::DictValue& params,
+    std::string* error) {
+  if (!Load(error) || !VerifyToken(params, error) ||
+      !params.FindBool("confirmed").value_or(false)) {
+    if (error->empty()) *error = "Confirm rollback of the interrupted import";
+    return std::nullopt;
+  }
+  auto journal = ReadDict(JournalPath(profile_), kMaxJournalBytes);
+  if (!journal || base::PathExists(CompletionPath(profile_))) {
+    *error = "No interrupted migration can be rolled back";
+    return std::nullopt;
+  }
+  if (Equals(journal->FindString("phase"), "committing")) {
+    const int current = profile_->GetPrefs()->GetDict(kOrganizationPref)
+                            .FindInt("revision").value_or(0);
+    const int before = journal->FindInt("organizationRevision").value_or(-1);
+    if (before < 0 || current < before || current > before + 1) {
+      *error = "Profile organization changed after the interrupted import";
+      return std::nullopt;
+    }
+  }
+  auto* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  const bookmarks::BookmarkNode* root = ImportRoot(model, content_hash_);
+  if (root && !AllMarked(root, content_hash_)) {
+    *error = "Imported bookmarks were edited; rollback requires manual review";
+    return std::nullopt;
+  }
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  for (const base::Value& item : *manifest_.FindList("tabs")) {
+    const std::string page_id = PageId(
+        content_hash_, *item.GetDict().FindString("sourcePageId"));
+    BrowserWindowInterface* owner = nullptr;
+    if (catalog->FindPage(page_id, &owner)) {
+      if (owner != browser) {
+        *error = "An imported tab moved to another window";
+        return std::nullopt;
+      }
+      base::DictValue command;
+      command.Set("kind", "close");
+      command.Set("pageId", page_id);
+      const auto ack = catalog->Command(browser, "migration-close-" + page_id,
+                                         command, std::nullopt);
+      if (!Equals(ack.FindString("status"), "applied")) {
+        *error = "Could not close an imported tab";
+        return std::nullopt;
+      }
+    }
+  }
+  if (root) model->Remove(root, bookmarks::metrics::BookmarkEditSource::kUser,
+                           FROM_HERE);
+  if (Equals(journal->FindString("phase"), "committing")) {
+    profile_->GetPrefs()->SetDict(
+        kOrganizationPref, journal->FindDict("priorOrganization")->Clone());
+  }
+  if (!base::DeleteFile(JournalPath(profile_))) {
+    *error = "Could not remove the native migration journal";
+    return std::nullopt;
+  }
+  return Review(browser, error);
+}
+
+std::optional<base::DictValue> MigrationImport::Call(
+    BrowserWindowInterface* browser, std::string_view method,
+    const base::DictValue& params, std::string* error) {
+  if (method == "migrationReview") return Review(browser, error);
+  if (method == "migrationBegin") return Begin(browser, params, error);
+  if (method == "migrationBatch") return Batch(browser, params, error);
+  if (method == "migrationFinish") return Finish(browser, params, error);
+  if (method == "migrationRollback") return Rollback(browser, params, error);
+  *error = "Unsupported migration operation";
+  return std::nullopt;
+}
+
+}  // namespace aux
