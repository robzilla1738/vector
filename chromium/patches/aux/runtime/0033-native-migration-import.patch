+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_MIGRATION_IMPORT_H_
+#define CHROME_BROWSER_UI_AUX_MIGRATION_IMPORT_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/supports_user_data.h"
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace aux {
+
+// A reviewed, resumable import of an offline Electron migration seed. The
+// browser Profile owns this object and its immutable, verified manifest.
+class MigrationImport final : public base::SupportsUserData::Data {
+ public:
+ static MigrationImport* ForProfile(Profile* profile);
+  ~MigrationImport() override;
+  static bool ValidateManifestForTest(const base::DictValue& manifest,
+                                      std::string* error);
+
+  std::optional<base::DictValue> Call(BrowserWindowInterface* browser,
+                                      std::string_view method,
+                                      const base::DictValue& params,
+                                      std::string* error);
+
+ private:
+  explicit MigrationImport(Profile* profile);
+
+  bool Load(std::string* error);
+  std::optional<base::DictValue> Review(BrowserWindowInterface* browser,
+                                        std::string* error);
+  std::optional<base::DictValue> Begin(BrowserWindowInterface* browser,
+                                       const base::DictValue& params,
+                                       std::string* error);
+  std::optional<base::DictValue> Batch(BrowserWindowInterface* browser,
+                                       const base::DictValue& params,
+                                       std::string* error);
+  std::optional<base::DictValue> Finish(BrowserWindowInterface* browser,
+                                        const base::DictValue& params,
+                                        std::string* error);
+  std::optional<base::DictValue> Rollback(BrowserWindowInterface* browser,
+                                          const base::DictValue& params,
+                                          std::string* error);
+  bool VerifyToken(const base::DictValue& params, std::string* error) const;
+
+  const raw_ptr<Profile> profile_;
+  base::DictValue manifest_;
+  std::string manifest_sha256_;
+  std::string content_hash_;
+  bool loaded_ = false;
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_MIGRATION_IMPORT_H_
