+MigrationImport* MigrationImport::ForProfile(Profile* profile) {
+  if (!profile || profile->IsOffTheRecord()) return nullptr;
+  auto* importer = static_cast<MigrationImport*>(
+      profile->GetUserData(&kMigrationImportKey));
+  if (!importer) {
+    auto created = std::unique_ptr<MigrationImport>(new MigrationImport(profile));
+    importer = created.get();
+    profile->SetUserData(&kMigrationImportKey, std::move(created));
+  }
+  return importer;
+}
