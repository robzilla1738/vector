+const char kMigrationImportKey = 0;
+constexpr size_t kMaxManifestBytes = 32 * 1024 * 1024;
+constexpr size_t kMaxReceiptBytes = 4096;
+constexpr size_t kMaxJournalBytes = 512 * 1024;
+constexpr int kBatchSize = 100;
+constexpr char kImportMeta[] = "aux.migration.contentHash";
+
+base::FilePath DataDir(Profile* profile) {
+  return profile->GetPath().AppendASCII("Aux Runtime Data");
+}
+base::FilePath ManifestPath(Profile* profile) {
+  return DataDir(profile).AppendASCII("manifest.json");
+}
+base::FilePath SeedReceiptPath(Profile* profile) {
+  return DataDir(profile).AppendASCII("apply-receipt.json");
+}
+base::FilePath JournalPath(Profile* profile) {
+  return DataDir(profile).AppendASCII("native-import-journal.json");
+}
+base::FilePath CompletionPath(Profile* profile) {
+  return DataDir(profile).AppendASCII("native-import-receipt.json");
+}
+
+std::string Sha256(std::string_view text) {
+  return base::HexEncodeLower(crypto::SHA256HashString(text));
+}
+bool Digest(const std::string* value) {
+  if (!value || value->size() != 64) return false;
+  return std::all_of(value->begin(), value->end(), [](char c) {
+    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+  });
+}
+bool Equals(const std::string* value, std::string_view expected) {
+  return value && *value == expected;
+}
+bool WebUrl(const std::string* value) {
+  if (!value || value->empty() || value->size() > 8192) return false;
+  GURL url(*value);
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() &&
+         !url.has_username() && !url.has_password();
+}
+bool ReadPrivateFile(const base::FilePath& path, size_t maximum,
+                     std::string* data) {
+  return !base::IsLink(path) &&
+         base::ReadFileToStringWithMaxSize(path, data, maximum);
+}
+std::optional<base::DictValue> ReadDict(const base::FilePath& path,
+                                       size_t maximum) {
+  std::string text;
+  if (!ReadPrivateFile(path, maximum, &text)) return std::nullopt;
+  return base::JSONReader::ReadDict(text, base::JSON_PARSE_RFC);
+}
+bool WritePrivateDict(const base::FilePath& path,
+                      const base::DictValue& value) {
+  const auto json = base::WriteJson(value);
+  if (!json || json->size() > kMaxJournalBytes ||
+      !base::CreateDirectory(path.DirName()) ||
+      !base::SetPosixFilePermissions(path.DirName(), 0700)) return false;
+  const base::FilePath temp = path.AddExtension(FILE_PATH_LITERAL("tmp"));
+  if (!base::WriteFile(temp, *json) ||
+      !base::SetPosixFilePermissions(temp, 0600) ||
+      !base::ReplaceFile(temp, path, nullptr)) {
+    base::DeleteFile(temp);
+    return false;
+  }
+  return true;
+}
+const std::string* Required(const base::DictValue& dict, const char* key,
+                            size_t maximum = 200) {
+  const std::string* text = dict.FindString(key);
+  return text && !text->empty() && text->size() <= maximum ? text : nullptr;
+}
+std::string PageId(std::string_view hash, std::string_view source_id) {
+  return "p_" + Sha256(std::string(hash) + ":" + std::string(source_id)).substr(0, 40);
+}
+std::string ImportFolderName(std::string_view hash) {
+  return "Imported from Aux " + std::string(hash.substr(0, 12));
+}
+const bookmarks::BookmarkNode* FindChildFolder(
+    const bookmarks::BookmarkNode* parent, std::u16string_view title) {
+  for (const auto& child : parent->children()) {
+    if (child->is_folder() && child->GetTitle() == title) return child.get();
+  }
+  return nullptr;
+}
+const bookmarks::BookmarkNode* ImportRoot(bookmarks::BookmarkModel* model,
+                                          std::string_view hash) {
+  return FindChildFolder(model->bookmark_bar_node(),
+                         base::UTF8ToUTF16(ImportFolderName(hash)));
+}
+bool IsUnder(const bookmarks::BookmarkNode* node,
+             const bookmarks::BookmarkNode* root) {
+  for (const bookmarks::BookmarkNode* current = node; current;
+       current = current->parent()) {
+    if (current == root) return true;
+  }
+  return false;
+}
+const bookmarks::BookmarkNode* EnsureFolder(bookmarks::BookmarkModel* model,
+                                            const bookmarks::BookmarkNode* root,
+                                            const base::ListValue& path,
+                                            std::string_view hash) {
+  const bookmarks::BookmarkNode* node = root;
+  for (const base::Value& segment : path) {
+    const std::string* name = segment.GetIfString();
+    if (!name || name->empty() || name->size() > 200) return nullptr;
+    const std::u16string title = base::UTF8ToUTF16(*name);
+    const bookmarks::BookmarkNode* child = FindChildFolder(node, title);
+    if (!child) {
+      bookmarks::BookmarkNode::MetaInfoMap metadata;
+      metadata[kImportMeta] = std::string(hash);
+      child = model->AddFolder(node, node->children().size(), title,
+                               &metadata);
+    }
+    node = child;
+  }
+  return node;
+}
+bool AllMarked(const bookmarks::BookmarkNode* node, std::string_view hash) {
+  std::string marker;
+  if (!node->GetMetaInfo(kImportMeta, &marker) || marker != hash) return false;
+  for (const auto& child : node->children()) {
+    if (!AllMarked(child.get(), hash)) return false;
+  }
+  return true;
+}
+base::DictValue Progress(const base::DictValue& journal) {
+  base::DictValue result;
+  result.Set("status", "importing");
+  result.Set("folders", journal.FindInt("folders").value_or(0));
+  result.Set("bookmarks", journal.FindInt("bookmarks").value_or(0));
+  result.Set("tabs", journal.FindInt("tabs").value_or(0));
+  return result;
+}
