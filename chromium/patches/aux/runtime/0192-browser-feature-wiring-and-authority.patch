diff --git a/chrome/browser/ui/aux/journey_fixture_path.h b/chrome/browser/ui/aux/journey_fixture_path.h
new file mode 100644
index 0000000..19ca02d
--- /dev/null
+++ b/chrome/browser/ui/aux/journey_fixture_path.h
@@ -0,0 +1,32 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_JOURNEY_FIXTURE_PATH_H_
+#define CHROME_BROWSER_UI_AUX_JOURNEY_FIXTURE_PATH_H_
+
+#include <sys/stat.h>
+#include <unistd.h>
+#include <string>
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+
+namespace aux {
+// Metadata only: this never opens a Profile, session, credential or Keychain file.
+inline bool OwnedJourneyFixtureRoot(const std::string& value, uid_t owner = geteuid()) {
+  const base::FilePath path(value);
+  if (!path.IsAbsolute() || path.ReferencesParent() || path.value() != path.StripTrailingSeparators().value())
+    return false;
+  const auto parent = path.DirName().value();
+  const auto name = path.BaseName().value();
+  if ((parent != "/tmp" && parent != "/private/tmp") || !name.starts_with("aux-native-journey-") ||
+      name.size() <= std::string("aux-native-journey-").size()) return false;
+  for (char c : name) if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                          (c >= '0' && c <= '9') || c == '-' || c == '_')) return false;
+  struct stat info;
+  if (lstat(value.c_str(), &info) != 0 || !S_ISDIR(info.st_mode) || info.st_uid != owner ||
+      (info.st_mode & 0700) != 0700 || (info.st_mode & 077) != 0) return false;
+  const base::FilePath canonical = base::MakeAbsoluteFilePath(path);
+  return !canonical.empty() && canonical.value() == "/private/tmp/" + name;
+}
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/aux/journey_fixture_path_unittest.cc b/chrome/browser/ui/aux/journey_fixture_path_unittest.cc
new file mode 100644
index 0000000..9fff17a
--- /dev/null
+++ b/chrome/browser/ui/aux/journey_fixture_path_unittest.cc
@@ -0,0 +1,30 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/journey_fixture_path.h"
+#include "base/files/scoped_temp_dir.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+TEST(JourneyFixturePathTest, RefusesTraversalNestedMissingRelativeAndTrailingRoots) {
+  for (const std::string& path : {"aux-native-journey-test", "/tmp/aux-native-journey-missing", "/tmp/aux-native-journey-x/../../owner", "/tmp/aux-native-journey-x/nested", "/tmp/aux-native-journey-x/", "/tmp/aux-native-journey-"})
+    EXPECT_FALSE(OwnedJourneyFixtureRoot(path));
+}
+TEST(JourneyFixturePathTest, AcceptsOnlyOwnedPrivateCanonicalImmediateChild) {
+  base::FilePath path;
+  ASSERT_TRUE(base::CreateTemporaryDirInDir(base::FilePath("/private/tmp"), "aux-native-journey-", &path));
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.Set(path));
+  ASSERT_EQ(chmod(path.value().c_str(), 0700), 0);
+  EXPECT_TRUE(OwnedJourneyFixtureRoot(path.value()));
+  EXPECT_TRUE(OwnedJourneyFixtureRoot("/tmp/" + path.BaseName().value()));
+  EXPECT_FALSE(OwnedJourneyFixtureRoot(path.value(), geteuid() + 1));
+  ASSERT_EQ(chmod(path.value().c_str(), 0750), 0);
+  EXPECT_FALSE(OwnedJourneyFixtureRoot(path.value()));
+  ASSERT_EQ(chmod(path.value().c_str(), 0700), 0);
+  const auto link = base::FilePath(path.value() + "-link");
+  ASSERT_TRUE(base::CreateSymbolicLink(path, link));
+  EXPECT_FALSE(OwnedJourneyFixtureRoot(link.value()));
+  EXPECT_TRUE(base::DeleteFile(link));
+}
+}  // namespace aux
