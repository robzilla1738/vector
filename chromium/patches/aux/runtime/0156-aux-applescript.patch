+++ b/chrome/browser/ui/cocoa/applescript/space_applescript.mm
@@ -0,0 +1,44 @@
+// Copyright 2026 The Aux Authors
+#import "chrome/browser/ui/cocoa/applescript/space_applescript.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/organization_store.h"
+#include "chrome/browser/ui/aux/profile_spaces.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "ui/base/base_window.h"
+@implementation SpaceAppleScript {
+  base::WeakPtr<BrowserWindowInterface> _browser;
+}
+- (instancetype)initWithBrowser:(BrowserWindowInterface*)browser spaceId:(NSString*)spaceId {
+  if (!browser || browser->GetProfile()->IsOffTheRecord()) return nil;
+  if ((self = [super init])) { _browser = browser->GetWeakPtr(); self.uniqueID = spaceId; }
+  return self;
+}
+- (BOOL)belongsToBrowser:(BrowserWindowInterface*)browser { return _browser && _browser.get() == browser; }
+- (NSString*)profile {
+  if (!_browser) return nil;
+  auto directory = _browser->GetProfile()->GetPath().BaseName().AsUTF8Unsafe();
+  return base::SysUTF8ToNSString(directory == "Default" ? "default" : directory);
+}
+- (NSString*)title {
+  if (!_browser) return nil;
+  std::string error;
+  auto snapshot = aux::OrganizationStore::Snapshot(_browser->GetProfile(), base::NumberToString(_browser->GetSessionID().id()), &error);
+  if (!snapshot || !snapshot->FindDict("layout")) return nil;
+  for (const auto& space : *snapshot->FindDict("layout")->FindDict("shared")->FindList("spaces"))
+    if (*space.GetDict().FindString("id") == base::SysNSStringToUTF8(self.uniqueID))
+      return base::SysUTF8ToNSString(*space.GetDict().FindString("name"));
+  return nil;
+}
+- (void)handlesFocusScriptCommand:(NSScriptCommand*)command {
+  std::string error;
+  if (!_browser || !aux::FocusProfileSpace(_browser.get(), base::SysNSStringToUTF8(self.uniqueID), &error)) {
+    command.scriptErrorNumber = -10000;
+    command.scriptErrorString = base::SysUTF8ToNSString(error.empty() ? "This Space or its window is no longer available" : error);
+    return;
+  }
+  _browser->GetWindow()->Activate();
+}
+@end
