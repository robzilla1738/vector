+  std::string error;
+  auto snapshot = aux::OrganizationStore::Snapshot(_browser->GetProfile(), base::NumberToString(_browser->GetSessionID().id()), &error);
+  if (!snapshot || !snapshot->FindDict("layout")) return result;
+  for (const auto& item : *snapshot->FindDict("layout")->FindDict("shared")->FindList("spaces")) {
