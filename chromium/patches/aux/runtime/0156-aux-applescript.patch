+}
+- (SpaceAppleScript*)activeSpace {
+  if (!_browser || _browser->GetProfile()->IsOffTheRecord()) return nil;
+  std::string error;
+  auto snapshot = aux::OrganizationStore::Snapshot(_browser->GetProfile(), base::NumberToString(_browser->GetSessionID().id()), &error);
+  if (!snapshot || !snapshot->FindDict("layout")) return nil;
+  const auto* id = snapshot->FindDict("layout")->FindDict("window")->FindString("activeSpaceId");
+  for (SpaceAppleScript* space in self.spaces) if ([space.uniqueID isEqualToString:base::SysUTF8ToNSString(*id)]) return space;
+  return nil;
+}
+- (void)setActiveSpace:(SpaceAppleScript*)space {
+  // Refuse a Space from a different native window; IDs alone do not grant ownership.
+  for (SpaceAppleScript* owned in self.spaces) if ([owned.uniqueID isEqualToString:space.uniqueID] && [space belongsToBrowser:_browser.get()]) {
+    [owned handlesFocusScriptCommand:[NSScriptCommand currentCommand]]; return;
+  }
+  [NSScriptCommand currentCommand].scriptErrorNumber = -10000;
+  [NSScriptCommand currentCommand].scriptErrorString = @"Choose a Space belonging to this window";
+}
