@@ -8,7 +8,11 @@
 #include "chrome/browser/ui/browser.h"
 #include "chrome/browser/ui/browser_web_contents_delegate/browser_web_contents_delegate.h"
 #include "chrome/browser/ui/webui_browser/webui_browser_window.h"
+#include "chrome/common/webui_url_constants.h"
 #include "chrome/common/chrome_render_frame.mojom.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/reload_type.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/browser/web_contents_observer.h"
 #include "third_party/blink/public/common/associated_interfaces/associated_interface_provider.h"
@@ -48,6 +52,21 @@
     const content::OpenURLParams& params,
     base::OnceCallback<void(content::NavigationHandle&)>
         navigation_handle_callback) {
+  if (source == web_contents() && params.url.SchemeIs("chrome") &&
+      params.url.host() == chrome::kChromeUIAuxHost) {
+    // The Aux WebUI controller requires the top shell WebContents. A document
+    // navigation must stay there instead of opening a guest tab.
+    if (params.url == source->GetLastCommittedURL()) {
+      source->GetController().Reload(content::ReloadType::BYPASSING_CACHE,
+                                     /*check_for_repost=*/false);
+      return source;
+    }
+    auto handle = source->GetController().LoadURLWithParams(
+        content::NavigationController::LoadURLParams(params));
+    if (handle && navigation_handle_callback)
+      std::move(navigation_handle_callback).Run(*handle);
+    return source;
+  }
   return window_->browser()->OpenURL(params,
                                      std::move(navigation_handle_callback));
 }
