+bool NavigationRequest::RevalidateAdmittedNonNetworkOrigin() {
+  if (!admitted_non_network_origin_) return true;
+  if (admitted_non_network_refused_) return false;
+  auto* parent = GetParentFrame();
+  auto admitted = GetContentClient()->browser()
+      ->GetAdmittedNonNetworkOpaqueOrigin(*this);
+  if (!parent || !parent->IsActive() || !parent->IsRenderFrameLive() ||
+      admitted_non_network_parent_.AsRenderFrameHostIfValid() != parent ||
+      admitted_non_network_url_ != GetURL() || !admitted || !admitted->opaque() ||
+      !admitted->CanBeDerivedFrom(GetURL()) ||
+      admitted->GetTupleOrPrecursorTupleIfOpaque() !=
+          admitted_non_network_origin_->GetTupleOrPrecursorTupleIfOpaque()) {
+    admitted_non_network_refused_ = true;
+    return false;
+  }
+  return true;
+}
