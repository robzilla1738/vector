+void WebFrameWidgetImpl::MeasureNativeGuestStage(
+    mojom::blink::NativeGuestStageScopePtr scope,
+    mojo::PendingRemote<mojom::blink::NativeGuestStageReadiness> readiness,
+    mojo::PendingReceiver<mojom::blink::NativeGuestStageInput> input,
+    NativeGuestStageCallback callback) {
+  auto reply = mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+      std::move(callback), mojom::blink::NativeGuestStageSubmissionPtr());
+  if (!scope || !readiness.is_valid() || !input.is_valid() || !widget_base_ ||
+      widget_base_->WillBeDestroyed() || !local_root_ || !ForTopMostMainFrame() ||
+      !local_root_->GetFrame() || !local_root_->GetFrame()->GetDocument() ||
+      scope->request_nonce.is_empty() || !scope->sample_sequence || scope->window_id <= 0 ||
+      scope->shell_widget_routing_id <= 0 || !scope->native_document_generation ||
+      scope->shell_renderer_pid != base::GetCurrentProcId() || scope->shell_sink != frame_sink_id_ ||
+      !scope->shell_sink.is_valid() || !scope->display_sink.is_valid() ||
+      native_command_measurement_pending_ || native_guest_stage_pending_ ||
+      (native_guest_document_stamp_ && native_guest_document_stamp_->armed())) return;
+  Document* document = local_root_->GetFrame()->GetDocument();
+  if (document->Url().Protocol() != "chrome" || document->Url().Host() != "aux" ||
+      document->Token() != scope->shell_document || !ReadNativeGuestStageWitness(*document)) return;
+  native_guest_stage_measurement_.reset(); native_command_measurement_.reset();
+  native_guest_document_stamp_.reset();
+  const aux::ContentPerformanceScope actual{scope->window_id, scope->shell_widget_routing_id,
+      scope->shell_renderer_pid, scope->native_document_generation, scope->shell_sink};
+  auto reader = base::BindRepeating(
+      [](WeakPersistent<WebFrameWidgetImpl> self, WeakPersistent<Document> held)
+          -> std::optional<NativeGuestStageWitness> {
+        if (!self || !held || !self->widget_base_ || self->widget_base_->WillBeDestroyed() ||
+            !self->local_root_ || !self->local_root_->GetFrame() ||
+            self->local_root_->GetFrame()->GetDocument() != held.Get()) return std::nullopt;
+        return ReadNativeGuestStageWitness(*held);
+      }, WrapWeakPersistent(this), WrapWeakPersistent(document));
+  auto scope_reader = base::BindRepeating(
+      [](WeakPersistent<WebFrameWidgetImpl> self, DocumentToken document,
+         aux::ContentPerformanceScope actual) -> std::optional<aux::ContentPerformanceScope> {
+        if (!self || !self->widget_base_ || self->widget_base_->WillBeDestroyed() ||
+            !self->local_root_ || !self->local_root_->GetFrame() ||
+            !self->local_root_->GetFrame()->GetDocument() ||
+            self->local_root_->GetFrame()->GetDocument()->Token() != document ||
+            self->frame_sink_id_ != actual.frame_sink) return std::nullopt;
+        return actual;
+      }, WrapWeakPersistent(this), document->Token(), actual);
+  native_guest_stage_measurement_ = std::make_unique<NativeGuestStageController>(
+      widget_base_.get(), std::move(scope_reader), std::move(reader));
+  native_guest_stage_pending_ = true;
+  const bool armed = native_guest_stage_measurement_->Prepare(std::move(scope),
+      std::move(readiness), std::move(input), base::BindOnce(
+          [](WeakPersistent<WebFrameWidgetImpl> self, NativeGuestStageCallback reply,
