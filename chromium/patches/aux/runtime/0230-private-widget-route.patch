+            if (!self || !self->widget_base_ || self->widget_base_->WillBeDestroyed() ||
+                !self->local_root_ || !self->local_root_->GetFrame() ||
+                !self->local_root_->GetFrame()->GetDocument() || !sample || !sample->scope ||
+                self->local_root_->GetFrame()->GetDocument()->Token() != sample->scope->shell_document ||
+                self->frame_sink_id_ != sample->scope->shell_sink) sample.reset();
+            std::move(reply).Run(std::move(sample));
+          }, WrapWeakPersistent(this), std::move(reply)));
+  if (!armed) native_guest_stage_pending_ = false;
+}
