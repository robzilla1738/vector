--- /dev/null
+++ b/third_party/blink/renderer/core/frame/native_guest_stage_witness_test.cc
@@ -0,0 +1,72 @@
+// Copyright 2026 The Aux Authors
+// Synthetic source-contract cases, not native performance or appearance proof.
+#include "third_party/blink/renderer/core/frame/native_guest_stage_witness.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+namespace blink {
+class NativeGuestStageWitnessTest : public PageTestBase {
+ protected:
+  void Fixture(const char* selection, const char* geometry, const char* dragging,
+      const char* page = "A", const char* style = "") {
+    SetBodyInnerHTML(String("<div id=stage data-stage-instance=9 style='width:400px;height:200px' data-stage-selection-generation=") +
+        selection + " data-unused-geometry-generation=" + geometry + " data-stage-dragging=" + dragging +
+        "><embed class='page-surface webium' type='application/x-chromium-surface-embed' data-page-id=" + page +
+        " data-content-id=OpaqueNativeHandle data-document-epoch=1 style='width:100px;height:100px;" + style + "'></div>");
+    UpdateAllLifecyclePhasesForTest();
+  }
+};
+TEST_F(NativeGuestStageWitnessTest, ActualNextSelectedPageRequired) {
+  Fixture("0", "0", "false");
+  const auto before = ReadNativeGuestStageWitness(GetDocument()); ASSERT_TRUE(before);
+  Fixture("1", "0", "false", "B");
+  const auto after = ReadNativeGuestStageWitness(GetDocument()); ASSERT_TRUE(after);
+  EXPECT_TRUE(NativeGuestStageMatchesInput(NativeGuestStageMetric::kTabSwitch, *before, *after));
+  EXPECT_FALSE(NativeGuestStageMatchesInput(NativeGuestStageMetric::kSplitDrop, *before, *after));
+}
+TEST_F(NativeGuestStageWitnessTest, SamePageABAAndSkippedGenerationCannotCount) {
+  Fixture("1", "0", "false"); const auto before = ReadNativeGuestStageWitness(GetDocument()); ASSERT_TRUE(before);
+  Fixture("2", "0", "false"); auto after = ReadNativeGuestStageWitness(GetDocument()); ASSERT_TRUE(after);
+  EXPECT_FALSE(NativeGuestStageMatchesInput(NativeGuestStageMetric::kTabSwitch, *before, *after));
+  Fixture("3", "0", "false", "B"); after = ReadNativeGuestStageWitness(GetDocument()); ASSERT_TRUE(after);
+  EXPECT_FALSE(NativeGuestStageMatchesInput(NativeGuestStageMetric::kTabSwitch, *before, *after));
+}
+TEST_F(NativeGuestStageWitnessTest, UnknownHiddenAndOffViewportEmbedsRefuse) {
+  Fixture("NaN", "0", "false"); EXPECT_FALSE(ReadNativeGuestStageWitness(GetDocument()));
+  Fixture("01", "0", "false"); EXPECT_FALSE(ReadNativeGuestStageWitness(GetDocument()));
+  Fixture("1", "0", "false", "A", "opacity:0"); EXPECT_FALSE(ReadNativeGuestStageWitness(GetDocument()));
+  Fixture("1", "0", "false", "A", "position:absolute;left:9000px"); EXPECT_FALSE(ReadNativeGuestStageWitness(GetDocument()));
+}
+TEST_F(NativeGuestStageWitnessTest, MatchingDropAndGeometryAreDistinct) {
+  NativeGuestStageWitness before{GetDocument().Token(), 3, 7, true};
+  NativeGuestStageWitness after{GetDocument().Token(), 4, 7, false};
+  before.stage_instance = after.stage_instance = 9;
+  after.pages = {{"A", "native-A", 1, gfx::RectF(0, 0, 100, 100)}, {"B", "native-B", 1, gfx::RectF(110, 0, 100, 100)}};
+  EXPECT_TRUE(NativeGuestStageMatchesInput(NativeGuestStageMetric::kSplitDrop, before, after));
+  EXPECT_FALSE(NativeGuestStageMatchesInput(NativeGuestStageMetric::kDividerFrame, before, after));
+  before.stage_instance = after.stage_instance = 9;
+  before = after; before.split_instance = after.split_instance = 10; before.focused_divider = true; after.focused_divider = true;
+  after.geometry_generation = 8; after.pages[0].bounds.set_width(105);
+  EXPECT_TRUE(NativeGuestStageMatchesInput(NativeGuestStageMetric::kDividerFrame, before, after));
+  after.selection_generation = 5;
+  EXPECT_FALSE(NativeGuestStageMatchesInput(NativeGuestStageMetric::kDividerFrame, before, after));
+}
+TEST_F(NativeGuestStageWitnessTest, CanonicalRoundedPaneAndInnerGuestAreDistinct) {
+  SetBodyInnerHTML(R"HTML(<div class=app><div id=stage data-stage-instance=9 data-stage-selection-generation=1 data-stage-dragging=false style="width:400px;height:200px">
+    <section class=split-stage data-split-instance=10 data-split-geometry-generation=1>
+      <section class=split-pane style="position:relative;width:160px;height:140px;overflow:hidden;border-radius:6px">
+        <embed class="page-surface webium" type="application/x-chromium-surface-embed" data-page-id=A data-content-id=OpaqueNativeHandle data-document-epoch=1 style="position:absolute;top:28px;left:0;width:160px;height:112px">
+      </section>
+    </section></div></div>)HTML");
+  UpdateAllLifecyclePhasesForTest();
+  const auto witness = ReadNativeGuestStageWitness(GetDocument()); ASSERT_TRUE(witness);
+  ASSERT_EQ(witness->pages.size(), 1u);
+  EXPECT_EQ(witness->pages[0].pane_radius, 6);
+  EXPECT_EQ(witness->pages[0].pane_bounds.height(), 140);
+  EXPECT_EQ(witness->pages[0].bounds.height(), 112);
+  auto* pane = GetDocument().QuerySelector(AtomicString(".split-pane")); ASSERT_TRUE(pane);
+  pane->setAttribute(AtomicString("style"), AtomicString("position:relative;width:160px;height:140px;overflow:hidden;border-radius:7px"));
+  UpdateAllLifecyclePhasesForTest();
+  EXPECT_FALSE(ReadNativeGuestStageWitness(GetDocument()));
+}
