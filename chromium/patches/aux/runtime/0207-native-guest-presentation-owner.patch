+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_GUEST_STAGE_SESSION_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_GUEST_STAGE_SESSION_H_
+#include "build/build_config.h"
