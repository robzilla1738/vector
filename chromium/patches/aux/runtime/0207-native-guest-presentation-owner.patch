+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_window.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/renderer_host/render_frame_metadata_provider_impl.h"
+#include "content/browser/renderer_host/render_widget_host_view_base.h"
+#include "content/browser/surface_embed/surface_embed_connector_impl.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "ui/compositor/compositor.h"
+#include "ui/views/widget/widget.h"
+namespace aux {
+std::optional<NativeGuestPresentationOwner> ReadNativeGuestPresentationOwner(
+    base::WeakPtr<WebUIBrowserUI> ui, base::WeakPtr<content::WebContents> child) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!ui || !child || child->IsBeingDestroyed() || !NativePerformanceObservationEnabled())
+    return std::nullopt;
+  auto* web_ui = ui->web_ui();
+  auto* shell = web_ui ? web_ui->GetWebContents() : nullptr;
+  auto* shell_frame = shell ? shell->GetPrimaryMainFrame() : nullptr;
+  auto* frame = child->GetPrimaryMainFrame();
+  auto* window = shell ? WebUIBrowserWindow::FromWebShellWebContents(shell) : nullptr;
+  auto* tab = tabs::TabInterface::GetFromContents(child.get());
+  const auto* identity = PageIdentity::FromWebContents(child.get());
+  auto* connector = child->GetSurfaceEmbedConnector();
+  if (!shell || shell->IsBeingDestroyed() || !shell_frame || !frame || !window ||
+      shell_frame != web_ui->GetRenderFrameHost() || shell == child.get() ||
+      shell_frame->GetLastCommittedURL().spec() != "chrome://aux/" || !window->browser() ||
+      !tab || tab->GetBrowserWindowInterface() != window->browser() ||
+      !identity || identity->runtime_owned() || !IsStageVisible(child.get()) || !connector)
+    return std::nullopt;
+  for (auto* current : {shell_frame, frame})
+    if (!current->IsRenderFrameLive() || current->IsErrorDocument() ||
+        !current->IsInLifecycleState(content::RenderFrameHost::LifecycleState::kActive))
+      return std::nullopt;
+  auto* profile = Profile::FromWebUI(web_ui);
+  const base::FilePath selected(base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("user-data-dir"));
+  if (!profile || profile != window->browser()->GetProfile() ||
+      child->GetBrowserContext() != profile || profile->GetPath().DirName() != selected)
+    return std::nullopt;
+  auto* actual = static_cast<content::SurfaceEmbedConnectorImpl*>(connector);
+  if (!actual->IsVisible() || actual->GetRectInParentViewInDip().IsEmpty() ||
+      actual->GetLocalFrameSizeInPixels().IsEmpty() ||
+      actual->GetParentRenderWidgetHostView() != shell->GetRenderWidgetHostView())
+    return std::nullopt;
+  auto* widget = static_cast<content::RenderWidgetHostImpl*>(frame->GetRenderWidgetHost());
+  auto* process = frame->GetProcess();
+  const viz::SurfaceId surface(connector->GetFrameSinkId(), actual->GetLocalSurfaceId());
+  if (!widget || !process || widget->GetProcess() != process || !process->GetProcess().IsValid() ||
+      widget->GetRoutingID() <= 0 || !surface.is_valid() || widget->GetFrameSinkId() != surface.frame_sink_id())
+    return std::nullopt;
+  auto* compositor = window->widget() ? window->widget()->GetCompositor() : nullptr;
+  auto* shell_widget = static_cast<content::RenderWidgetHostImpl*>(shell_frame->GetRenderWidgetHost());
+  if (!compositor || !compositor->frame_sink_id().is_valid() || !shell_widget ||
+      !shell_widget->GetFrameSinkId().is_valid()) return std::nullopt;
+  const float scale = actual->GetScreenInfos().current().device_scale_factor;
+  if (!std::isfinite(scale) || scale <= 0 || scale > 8) return std::nullopt;
+  const auto native = window->GetAuxAppearanceSnapshot();
+  const auto window_id = native.FindInt("windowId");
+  if (!window_id || *window_id <= 0) return std::nullopt;
+  return NativeGuestPresentationOwner{*window_id, widget->GetRoutingID(), process->GetProcess().Pid(),
+      static_cast<content::RenderFrameHostImpl*>(shell_frame)->GetDocumentToken(),
+      static_cast<content::RenderFrameHostImpl*>(frame)->GetDocumentToken(),
+      compositor->frame_sink_id(), shell_widget->GetFrameSinkId(), surface,
+      actual->GetRectInParentViewInDip(), actual->GetLocalFrameSizeInPixels(), scale};
+}
+bool HasNativeGuestDocumentFrameForTesting(base::WeakPtr<WebUIBrowserUI> ui,
+    base::WeakPtr<content::WebContents> child, const base::UnguessableToken& scope,
+    const viz::SurfaceId& surface, uint32_t token, const gfx::Size& surface_size) {
+  const auto owner = ReadNativeGuestPresentationOwner(ui, child);
+  if (!owner || scope.is_empty() || !token || owner->guest_surface != surface)
+    return false;
+  auto* frame = child->GetPrimaryMainFrame();
+  auto* widget = static_cast<content::RenderWidgetHostImpl*>(frame->GetRenderWidgetHost());
+  auto* metadata = widget->render_frame_metadata_provider();
+  const auto proof = metadata ? metadata->FindAuxGuestFrameForTesting(
+      owner->guest_document.value(), scope, surface.local_surface_id(), token) : std::nullopt;
+  auto* connector = static_cast<content::SurfaceEmbedConnectorImpl*>(child->GetSurfaceEmbedConnector());
+  return proof && connector && !proof->viewport_size_in_pixels.IsEmpty() &&
+      proof->viewport_size_in_pixels == connector->GetLocalFrameSizeInPixels() &&
+      proof->viewport_size_in_pixels == surface_size;
+}
+}  // namespace aux
+#endif
