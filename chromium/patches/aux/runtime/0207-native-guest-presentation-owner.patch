+#include "third_party/blink/public/mojom/widget/native_guest_stage_measurement.mojom.h"
+class WebUIBrowserUI;
+namespace aux { class NativeGuestStagePointerInput; }
+namespace aux {
+// Pure comparison of read-back geometry; it grants no fixture authority.
+bool NativeGuestStageGeometryMatches(const blink::mojom::NativeGuestStageWitness& witness,
+    const NativeGuestStageOwnedSnapshot& owner);
+
+// Native owner of one actual widget's fixed fixture trial. Generated interfaces
+// are private bound-widget pipes, not renderer script/public/debug endpoints.
+class NativeGuestStageSession final : public blink::mojom::NativeGuestStageReadiness {
+ public:
+  using Result = base::OnceCallback<void(blink::mojom::NativeGuestStageScopePtr,
+      blink::mojom::NativeGuestStageSubmissionPtr,
+      viz::mojom::NativeGuestInclusionResultPtr, std::optional<PerformanceInput>, const char*)>;
+  using Prepared = base::OnceCallback<void(blink::mojom::NativeGuestStageScopePtr)>;
+  explicit NativeGuestStageSession(base::WeakPtr<WebUIBrowserUI> ui);
+  ~NativeGuestStageSession() override;
+  bool Prepare(blink::mojom::NativeGuestStageMetric metric, Prepared prepared, Result result);
+  void Ready(blink::mojom::NativeGuestStageScopePtr scope,
+      blink::mojom::NativeGuestStageWitnessPtr baseline, ReadyCallback accepted) override;
+  void Started(blink::mojom::NativeGuestStageScopePtr scope) override;
+  void ObserveNativeInput(const gfx::NativeEvent& event);
+  // Returns true only when the actual owned key event is deferred. Effect must
+  // be the existing registered Aux command, weak-window fenced by its caller.
+  bool DeferConsumedTabSwitch(const gfx::NativeEvent& event, base::OnceClosure effect);
+  void Cancel();
+ private:
+  blink::mojom::NativeGuestStageScopePtr ReadScope();
+  bool StableShell() const;
+  bool StableBaselineDocuments() const;
+  bool StableBaselineSelection() const;
+  bool ArmGuestDocuments();
+  bool StableGuestDocuments() const;
+  void GuestDocumentArmed(uint64_t sequence, bool armed);
+  void StartShellMeasurement();
+  void Submitted(uint64_t sequence, blink::mojom::NativeGuestStageSubmissionPtr sample);
+  void Presented(uint64_t sequence, viz::mojom::NativeGuestInclusionResultPtr sample);
+  void Refuse(const char* reason);
+  base::WeakPtr<WebUIBrowserUI> ui_;
+  std::optional<blink::DocumentToken> last_document_;
+  uint64_t document_generation_ = 0;
+  uint64_t sequence_ = 0;
+  content::WeakDocumentPtr document_;
+  blink::mojom::NativeGuestStageScopePtr scope_;
+  blink::mojom::NativeGuestStageWitnessPtr baseline_;
+  std::optional<NativeGuestStageOwnedSnapshot> baseline_owner_;
+  std::vector<content::WeakDocumentPtr> baseline_documents_;
+  std::vector<content::WeakDocumentPtr> leased_guest_documents_;
+  std::vector<mojo::Remote<blink::mojom::NativeGuestDocumentFrameLease>> guest_leases_;
+  size_t pending_guest_leases_ = 0;
+  std::optional<NativeGuestStageOwnedSnapshot> mutation_owner_;
+  blink::mojom::NativeGuestStageSubmissionPtr submission_;
+  std::optional<PerformanceInput> input_;
+  Result result_;
+  Prepared prepared_;
+  bool renderer_started_ = false;
+  mojo::Receiver<blink::mojom::NativeGuestStageReadiness> readiness_{this};
+  mojo::Remote<blink::mojom::NativeGuestStageInput> input_control_;
+  std::unique_ptr<NativeGuestStagePointerInput> pointer_input_;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<NativeGuestStageSession> weak_factory_{this};
+};
+}  // namespace aux
+#endif
