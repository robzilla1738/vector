+// Copyright 2026 The Aux Authors
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_GUEST_STAGE_MEASUREMENT_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_GUEST_STAGE_MEASUREMENT_H_
+#include <optional>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "cc/trees/aux_performance_content_frame.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/core/frame/native_guest_stage_witness.h"
+namespace blink {
+class WidgetBase;
+class WebInputEvent;
+struct NativeGuestStageSubmission {
+  aux::ContentPerformanceScope scope;
+  NativeGuestStageWitness baseline;
+  NativeGuestStageWitness mutation_witness;
+  base::TimeTicks input;
+  base::TimeTicks mutation;
+  aux::NativePerformanceSwapPromise::Submission submission;
+  bool submitted = false;
+};
+// Receives input ONLY through the actual browser-owned private fixture widget
+// pipe, after its native NSEvent fence. No script/public input endpoint. Sends
+// the exact matching shell submission to native, before Display measurement.
+class CORE_EXPORT NativeGuestStageMeasurement {
+ public:
+  using WitnessReader = base::RepeatingCallback<std::optional<NativeGuestStageWitness>()>;
+  using Result = base::OnceCallback<void(NativeGuestStageSubmission)>;
+  NativeGuestStageMeasurement(WidgetBase* widget,
+      aux::NativeContentFrameMeasurement::ScopeReader read_scope, WitnessReader read_witness);
+  ~NativeGuestStageMeasurement();
+  bool Prepare(NativeGuestStageMetric metric, Result result);
+  bool NativeInput(base::TimeTicks actual_native_input);
+  void SetInputEnabled(bool enabled) { input_enabled_ = enabled; }
+  void Cancel();
+ private:
+  void Input(const WebInputEvent& original);
+  void Lifecycle();
+  void Submitted(aux::NativePerformanceSwapPromise::Submission actual);
+  bool Stable() const;
+  void Finish(bool submitted);
+  base::WeakPtr<WidgetBase> widget_;
+  aux::NativeContentFrameMeasurement::ScopeReader read_scope_;
+  WitnessReader read_witness_;
+  NativeGuestStageMetric metric_ = NativeGuestStageMetric::kTabSwitch;
+  std::optional<NativeGuestStageSubmission> sample_;
+  Result result_;
+  base::TimeTicks armed_;
+  base::TimeTicks last_input_;
+  bool waiting_mutation_ = false;
+  bool input_enabled_ = false;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<NativeGuestStageMeasurement> weak_factory_{this};
+};
+}  // namespace blink
+#endif
diff --git a/third_party/blink/renderer/core/frame/native_guest_stage_witness.cc b/third_party/blink/renderer/core/frame/native_guest_stage_witness.cc
new file mode 100644
index 0000000..8d3e2ef
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/native_guest_stage_witness.cc
@@ -0,0 +1,179 @@
+// Copyright 2026 The Aux Authors
+#include "third_party/blink/renderer/core/frame/native_guest_stage_witness.h"
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include "third_party/blink/renderer/core/display_lock/display_lock_utilities.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/dom/document_lifecycle.h"
+#include "third_party/blink/renderer/core/dom/element.h"
+#include "third_party/blink/renderer/core/dom/dom_token_list.h"
+#include "third_party/blink/renderer/core/dom/static_node_list.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/exported/web_plugin_container_impl.h"
+#include "third_party/blink/renderer/core/html/html_plugin_element.h"
+#include "third_party/blink/renderer/core/layout/layout_box.h"
+#include "third_party/blink/renderer/core/style/computed_style.h"
+#include "third_party/blink/renderer/core/style/superellipse.h"
+namespace blink {
+bool ReadNativeGuestStagePluginGeometry(HTMLPlugInElement& element,
+    gfx::Rect& window, gfx::Rect& clip) {
+  auto& document = element.GetDocument();
+  auto* plugin = element.OwnedPlugin();
+  if (!document.View() || document.Lifecycle().GetState() != DocumentLifecycle::kPaintClean ||
+      !element.isConnected() || !element.GetLayoutObject() || !plugin ||
+      plugin->element_.Get() != &element || !plugin->IsAttached() || !plugin->Plugin() ||
+      !plugin->layer_) return false;
+  gfx::Rect unclipped;
+  plugin->CalculateGeometry(window, clip, unclipped);
+  return !window.IsEmpty() && !clip.IsEmpty() && clip == unclipped;
+}
+namespace {
+constexpr uint64_t kLargestGeneration = 9007199254740991ULL;
+std::optional<uint64_t> Generation(Element& element, const char* name) {
+  const auto& value = element.getAttribute(AtomicString(name));
+  if (value.empty() || value.length() > 16 || (value.length() > 1 && value[0] == '0')) return std::nullopt;
+  uint64_t number = 0;
+  for (unsigned i = 0; i < value.length(); ++i) {
+    if (value[i] < '0' || value[i] > '9') return std::nullopt;
+    number = number * 10 + value[i] - '0';
+    if (number > kLargestGeneration) return std::nullopt;
+  }
+  return number;
+}
+bool Visible(Element& element) {
+  if (!element.isConnected() || !element.GetLayoutObject() ||
+      DisplayLockUtilities::IsDisplayLockedPreventingPaint(&element)) return false;
+  unsigned depth = 0;
+  for (auto* current = &element; current; current = current->parentElement()) {
+    if (++depth > 128 || current->hasAttribute(AtomicString("inert")) ||
+        current->getAttribute(AtomicString("aria-hidden")) == "true") return false;
+    const auto* style = current->GetComputedStyle();
+    if (!style || style->Visibility() != EVisibility::kVisible || style->Opacity() != 1) return false;
+  }
+  const auto rect = element.GetBoundingClientRectNoLifecycleUpdate();
+  return std::isfinite(rect.x()) && std::isfinite(rect.y()) && std::isfinite(rect.width()) &&
+      std::isfinite(rect.height()) && rect.width() > 0 && rect.height() > 0;
+}
+std::optional<std::string> Identity(Element& element, const char* name) {
+  const auto& value = element.getAttribute(AtomicString(name));
+  if (value.empty() || value.length() > 128) return std::nullopt;
+  for (unsigned i = 0; i < value.length(); ++i)
+    if (value[i] < 33 || value[i] > 126) return std::nullopt;
+  return value.Utf8();
+}
+bool SamePages(const NativeGuestStageWitness& a, const NativeGuestStageWitness& b) {
+  if (a.pages.size() != b.pages.size()) return false;
+  for (size_t i = 0; i < a.pages.size(); ++i)
+    if (a.pages[i].page_id != b.pages[i].page_id ||
+        a.pages[i].document_epoch != b.pages[i].document_epoch ||
+        a.pages[i].content_id != b.pages[i].content_id) return false;
+  return true;
+}
+}  // namespace
+std::optional<NativeGuestStageWitness> ReadNativeGuestStageWitness(Document& document) {
+  if (!document.View() || document.Lifecycle().GetState() != DocumentLifecycle::kPaintClean) return std::nullopt;
+  auto* stages = document.QuerySelectorAll(AtomicString("#stage[data-stage-instance][data-stage-selection-generation][data-stage-dragging]"));
+  if (!stages || stages->length() != 1 || !Visible(*stages->item(0))) return std::nullopt;
+  auto* stage = stages->item(0);
+  const auto selection = Generation(*stage, "data-stage-selection-generation");
+  const auto instance = Generation(*stage, "data-stage-instance");
+  uint64_t geometry = 0, split_instance = 0;
+  auto* splits = stage->QuerySelectorAll(AtomicString(".split-stage"));
+  if (!splits || splits->length() > 1) return std::nullopt;
+  if (splits->length()) {
+    const auto generation = Generation(*splits->item(0), "data-split-geometry-generation");
+    const auto lifetime = Generation(*splits->item(0), "data-split-instance");
+    if (!generation || !lifetime || !*lifetime) return std::nullopt;
+    geometry = *generation; split_instance = *lifetime;
+  }
+  const auto& dragging = stage->getAttribute(AtomicString("data-stage-dragging"));
+  if (!selection || !instance || !*instance || (dragging != "true" && dragging != "false")) return std::nullopt;
+  NativeGuestStageWitness result{document.Token(), *selection, geometry, dragging == "true"};
+  result.stage_instance = *instance; result.split_instance = split_instance;
+  auto* focused = document.FocusedElement();
+  result.focused_divider = focused && stage->contains(focused) && Visible(*focused) &&
+      focused->getAttribute(AtomicString("role")) == "separator" && focused->classList().contains(AtomicString("fluid-split-divider"));
+  auto* embeds = stage->QuerySelectorAll(AtomicString("embed.page-surface.webium[type='application/x-chromium-surface-embed']"));
+  if (!embeds || embeds->length() > 4) return std::nullopt;
+  std::set<std::string> pages, contents;
+  const gfx::RectF viewport(document.View()->GetLayoutSize());
+  for (unsigned i = 0; i < embeds->length(); ++i) {
+    auto* embed = embeds->item(i);
+    const auto id = Identity(*embed, "data-page-id");
+    const auto content = Identity(*embed, "data-content-id");
+    const auto epoch = Generation(*embed, "data-document-epoch");
+    const auto bounds = embed->GetBoundingClientRectNoLifecycleUpdate();
+    if (!id || !content || !epoch || !Visible(*embed) || !viewport.Contains(bounds) ||
+        !pages.insert(*id).second || !contents.insert(*content).second) return std::nullopt;
+    std::optional<gfx::Rect> native_plugin;
+    gfx::Rect actual_window, actual_clip;
+    if (auto* plugin_element = DynamicTo<HTMLPlugInElement>(embed);
+        plugin_element && ReadNativeGuestStagePluginGeometry(*plugin_element, actual_window, actual_clip))
+      native_plugin = actual_window;
+    // Missing plugin geometry remains unknown; browser-owned readiness refuses
+    // it. DOM-only witness tests are never native measured evidence.
+    gfx::RectF pane_bounds = native_plugin ? gfx::RectF(*native_plugin) : bounds;
+    float radius = 0;
+    Element* pane = nullptr;
+    for (auto* ancestor = embed->parentElement(); ancestor && ancestor != stage;
+         ancestor = ancestor->parentElement()) {
+      const auto* style = ancestor->GetComputedStyle();
+      if (!style || style->HasTransform() || style->HasClipPath()) return std::nullopt;
+      if (ancestor->classList().contains(AtomicString("split-pane"))) {
+        if (pane) return std::nullopt;
+        pane = ancestor;
+      }
+    }
+    if (split_instance) {
+      if (!pane || !Visible(*pane)) return std::nullopt;
+      const auto* style = pane->GetComputedStyle();
+      if (style->OverflowX() != EOverflow::kHidden || style->OverflowY() != EOverflow::kHidden ||
+          style->CornerTopLeftShape() != Superellipse::Round() ||
+          style->CornerTopRightShape() != Superellipse::Round() ||
+          style->CornerBottomLeftShape() != Superellipse::Round() ||
+          style->CornerBottomRightShape() != Superellipse::Round()) return std::nullopt;
+      bool minimal = false;
+      for (auto* ancestor = stage->parentElement(); ancestor; ancestor = ancestor->parentElement())
+        if (ancestor->classList().contains(AtomicString("app"))) {
+          minimal = ancestor->classList().contains(AtomicString("minimal-ui")); break;
+        }
+      const float canonical_radius = minimal ? 0 : 6 * style->EffectiveZoom();
+      for (const auto& corner : {style->BorderTopLeftRadius(), style->BorderTopRightRadius(),
+                               style->BorderBottomLeftRadius(), style->BorderBottomRightRadius()})
+        if (!corner.Width().IsFixed() || !corner.Height().IsFixed() ||
+            corner.Width().Pixels() != canonical_radius || corner.Height().Pixels() != canonical_radius)
+          return std::nullopt;
+      auto* box = DynamicTo<LayoutBox>(pane->GetLayoutObject());
+      if (!box) return std::nullopt;
+      pane_bounds = gfx::RectF(box->LocalToAbsoluteRect(box->PhysicalBorderBoxRect(),
+          {MapCoordinatesMode::kTraverseDocumentBoundaries}));
+      if ((native_plugin && !pane_bounds.Contains(gfx::RectF(*native_plugin))) ||
+          !std::isfinite(canonical_radius) || canonical_radius < 0 ||
+          2 * canonical_radius > std::min(pane_bounds.width(), pane_bounds.height())) return std::nullopt;
+      radius = canonical_radius;
+    } else if (pane) return std::nullopt;
+    result.pages.push_back({*id, *content, *epoch, bounds, pane_bounds, radius, native_plugin});
+  }
+  return result;
+}
+bool NativeGuestStageMatchesInput(NativeGuestStageMetric metric,
+    const NativeGuestStageWitness& before, const NativeGuestStageWitness& after) {
+  if (!before.stage_instance || before.stage_instance != after.stage_instance || before.document != after.document || after.dragging || after.pages.empty() || after.pages.size() > 4) return false;
+  if (metric == NativeGuestStageMetric::kDividerFrame) {
+    if (!before.split_instance || before.split_instance != after.split_instance || before.dragging || !before.focused_divider || !after.focused_divider || before.pages.size() < 2 ||
+        !SamePages(before, after) || before.selection_generation != after.selection_generation ||
+        before.geometry_generation >= kLargestGeneration || after.geometry_generation != before.geometry_generation + 1) return false;
+    for (size_t i = 0; i < before.pages.size(); ++i)
+      if (before.pages[i].bounds != after.pages[i].bounds) return true;
+    return false;
+  }
+  if (before.selection_generation >= kLargestGeneration ||
+      after.selection_generation != before.selection_generation + 1 || SamePages(before, after)) return false;
+  if (metric == NativeGuestStageMetric::kSplitDrop)
+    return before.dragging && before.pages.empty() && after.pages.size() >= 2;
+  return metric == NativeGuestStageMetric::kTabSwitch && !before.dragging &&
+      before.pages.size() == 1 && after.pages.size() == 1 &&
+      before.pages[0].page_id != after.pages[0].page_id;
+}
+}  // namespace blink
diff --git a/third_party/blink/renderer/core/frame/native_guest_stage_witness.h b/third_party/blink/renderer/core/frame/native_guest_stage_witness.h
new file mode 100644
