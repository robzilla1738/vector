+#include "third_party/blink/public/mojom/widget/native_guest_stage_measurement.mojom-blink.h"
+#include "third_party/blink/renderer/core/frame/native_guest_stage_measurement.h"
+namespace blink {
+// Created only by the actual top-most WebFrameWidget owner after fixed current
+// chrome://aux document/widget/sink scope validation. No script receiver.
+class CORE_EXPORT NativeGuestStageController final : public mojom::blink::NativeGuestStageInput {
+ public:
+  using Result = base::OnceCallback<void(mojom::blink::NativeGuestStageSubmissionPtr)>;
+  NativeGuestStageController(WidgetBase* widget,
+      aux::NativeContentFrameMeasurement::ScopeReader read_scope,
+      NativeGuestStageMeasurement::WitnessReader read_witness);
+  ~NativeGuestStageController() override;
+  bool Prepare(mojom::blink::NativeGuestStageScopePtr scope,
+      mojo::PendingRemote<mojom::blink::NativeGuestStageReadiness> ready,
+      mojo::PendingReceiver<mojom::blink::NativeGuestStageInput> input,
+      Result result);
+  void ArmConsumedNativeInput(const base::UnguessableToken& nonce,
+      base::TimeTicks original, ArmConsumedNativeInputCallback accepted) override;
+ private:
+  void Accepted(bool accepted);
+  void Complete(NativeGuestStageSubmission sample);
+  void Cancel();
+  NativeGuestStageMeasurement::WitnessReader read_witness_;
+  NativeGuestStageMeasurement measurement_;
+  mojom::blink::NativeGuestStageScopePtr scope_;
+  Result result_;
+  bool ready_ = false;
+  mojo::Remote<mojom::blink::NativeGuestStageReadiness> readiness_;
+  mojo::Receiver<mojom::blink::NativeGuestStageInput> input_{this};
+  base::WeakPtrFactory<NativeGuestStageController> weak_factory_{this};
+};
+}  // namespace blink
+#endif
diff --git a/third_party/blink/renderer/core/frame/native_guest_stage_measurement.cc b/third_party/blink/renderer/core/frame/native_guest_stage_measurement.cc
new file mode 100644
index 0000000..dda7bc5
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/native_guest_stage_measurement.cc
@@ -0,0 +1,118 @@
+// Copyright 2026 The Aux Authors
+#include "third_party/blink/renderer/core/frame/native_guest_stage_measurement.h"
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "cc/trees/layer_tree_host.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "third_party/blink/renderer/platform/widget/widget_base.h"
+namespace blink {
+NativeGuestStageMeasurement::NativeGuestStageMeasurement(WidgetBase* widget,
+    aux::NativeContentFrameMeasurement::ScopeReader read_scope, WitnessReader read_witness)
+    : widget_(widget ? widget->GetWeakPtr() : base::WeakPtr<WidgetBase>()),
+      read_scope_(std::move(read_scope)), read_witness_(std::move(read_witness)) {
+  // WebFrameWidget owner must reject overlap with any other performance owner
+  // before construction; the actual lifecycle callback slot has one owner.
+  if (widget_) {
+    widget_->SetPerformanceInputCallbackForTesting(base::BindRepeating(
+        &NativeGuestStageMeasurement::Input, weak_factory_.GetWeakPtr()));
+    widget_->SetPerformanceLifecycleCallbackForTesting(base::BindRepeating(
+        &NativeGuestStageMeasurement::Lifecycle, weak_factory_.GetWeakPtr()));
+  }
+}
+NativeGuestStageMeasurement::~NativeGuestStageMeasurement() {
+  if (widget_) {
+    widget_->SetPerformanceInputCallbackForTesting({});
+    widget_->SetPerformanceLifecycleCallbackForTesting({});
+  }
+  Cancel();
+}
+bool NativeGuestStageMeasurement::Stable() const {
+  if (!sample_ || !widget_ || widget_->WillBeDestroyed() || !widget_->LayerTreeHost() ||
+      read_scope_.is_null() || read_witness_.is_null()) return false;
+  const auto scope = read_scope_.Run();
+  return scope && *scope == sample_->scope;
+}
+bool NativeGuestStageMeasurement::Prepare(NativeGuestStageMetric metric, Result result) {
+  if (sample_ || result.is_null() || !widget_ || widget_->WillBeDestroyed() ||
+      !widget_->LayerTreeHost() || read_scope_.is_null() || read_witness_.is_null() ||
+      !base::TimeTicks::IsConsistentAcrossProcesses()) return false;
+  const auto scope = read_scope_.Run();
+  const auto baseline = read_witness_.Run();
+  if (!scope || !baseline ||
+      (metric == NativeGuestStageMetric::kSplitDrop && (!baseline->dragging || !baseline->pages.empty())) ||
+      (metric == NativeGuestStageMetric::kDividerFrame && (baseline->dragging || !baseline->focused_divider || baseline->pages.size() < 2)) ||
+      (metric == NativeGuestStageMetric::kTabSwitch && (baseline->dragging || baseline->pages.size() != 1))) return false;
+  sample_.emplace(); sample_->scope = *scope; sample_->baseline = *baseline;
+  metric_ = metric; result_ = std::move(result); armed_ = base::TimeTicks::Now();
+  timeout_.Start(FROM_HERE, base::Seconds(5), base::BindOnce(
+      &NativeGuestStageMeasurement::Cancel, weak_factory_.GetWeakPtr()));
+  return true;
+}
+void NativeGuestStageMeasurement::Input(const WebInputEvent& original) {
+  if (!input_enabled_ || !sample_ || !sample_->input.is_null() ||
+      (original.GetModifiers() & WebInputEvent::kIsAutoRepeat)) return;
+  const auto type = original.GetType();
+  if (metric_ == NativeGuestStageMetric::kSplitDrop &&
+      (type != WebInputEvent::Type::kMouseUp ||
+       static_cast<const WebMouseEvent&>(original).button != WebPointerProperties::Button::kLeft)) return;
+  if (metric_ == NativeGuestStageMetric::kDividerFrame &&
+      (type != WebInputEvent::Type::kMouseMove ||
+       !(original.GetModifiers() & WebInputEvent::kLeftButtonDown))) return;
+  if (metric_ == NativeGuestStageMetric::kTabSwitch && type != WebInputEvent::Type::kRawKeyDown) return;
+  // Actual pre-dispatch input endpoint. Browser must independently pair the raw
+  // TimeTicks with its genuine NSEvent; this callback is not presentation proof.
+  NativeInput(original.TimeStamp());
+}
+bool NativeGuestStageMeasurement::NativeInput(base::TimeTicks input) {
+  const auto now = base::TimeTicks::Now();
+  if (!input_enabled_ || !Stable() || !sample_->input.is_null() || input.is_null() || input < armed_ ||
+      input <= last_input_ || input > now || now - input > base::Seconds(1) ||
+      !base::TimeTicks::IsConsistentAcrossProcesses()) { Cancel(); return false; }
+  // READY fixes a DOM baseline before input. If any unrelated mutation happened
+  // between readiness and native dispatch, do not attribute it to this input.
+  const auto baseline = read_witness_.Run();
+  if (!baseline || baseline->document != sample_->baseline.document ||
+      baseline->stage_instance != sample_->baseline.stage_instance ||
+      baseline->split_instance != sample_->baseline.split_instance ||
+      baseline->selection_generation != sample_->baseline.selection_generation ||
+      baseline->geometry_generation != sample_->baseline.geometry_generation ||
+      baseline->dragging != sample_->baseline.dragging || baseline->pages != sample_->baseline.pages) {
+    Cancel(); return false;
+  }
+  sample_->input = input; last_input_ = input; waiting_mutation_ = true;
+  return true;
+}
+void NativeGuestStageMeasurement::Lifecycle() {
+  if (!waiting_mutation_) return;
+  if (!Stable()) { Cancel(); return; }
+  const auto current = read_witness_.Run();
+  if (!current || !NativeGuestStageMatchesInput(metric_, sample_->baseline, *current)) return;
+  sample_->mutation_witness = *current;
+  sample_->mutation = base::TimeTicks::Now(); waiting_mutation_ = false;
+  widget_->LayerTreeHost()->QueueSwapPromise(std::make_unique<aux::NativePerformanceSwapPromise>(
+      base::SingleThreadTaskRunner::GetCurrentDefault(), base::BindOnce(
+          &NativeGuestStageMeasurement::Submitted, weak_factory_.GetWeakPtr())));
+}
+void NativeGuestStageMeasurement::Submitted(aux::NativePerformanceSwapPromise::Submission actual) {
+  if (!sample_) return;
+  sample_->submission = actual;
+  const auto current = Stable() ? read_witness_.Run() : std::nullopt;
+  const bool stable = current && current->document == sample_->mutation_witness.document &&
+      current->stage_instance == sample_->mutation_witness.stage_instance &&
+      current->split_instance == sample_->mutation_witness.split_instance &&
+      current->selection_generation == sample_->mutation_witness.selection_generation &&
+      current->geometry_generation == sample_->mutation_witness.geometry_generation &&
+      current->pages == sample_->mutation_witness.pages && !current->dragging;
+  Finish(stable && actual.activated && actual.submitted_frame && actual.frame_token &&
+      actual.failure_reason < 0 && !actual.commit.is_null() && !actual.submitted.is_null() &&
+      sample_->input <= sample_->mutation && sample_->mutation <= actual.commit && actual.commit <= actual.submitted);
+}
+void NativeGuestStageMeasurement::Finish(bool submitted) {
+  if (!sample_) return;
+  timeout_.Stop(); waiting_mutation_ = false; input_enabled_ = false; sample_->submitted = submitted;
+  auto sample = std::move(*sample_); sample_.reset(); armed_ = {};
+  if (result_) std::move(result_).Run(std::move(sample));
+}
+void NativeGuestStageMeasurement::Cancel() { Finish(false); }
+}  // namespace blink
diff --git a/third_party/blink/renderer/core/frame/native_guest_stage_measurement.h b/third_party/blink/renderer/core/frame/native_guest_stage_measurement.h
