index 0000000..0782432
--- /dev/null
+++ b/chrome/browser/ui/aux/native_guest_presentation_fixture.cc
@@ -0,0 +1,193 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_guest_presentation_fixture.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <iostream>
+#include <cstring>
+#include <algorithm>
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_ui.h"
+namespace aux {
+namespace {
+const char* Metric(blink::mojom::NativeGuestStageMetric metric) {
+  switch (metric) {
+    case blink::mojom::NativeGuestStageMetric::kSplitDrop: return "split-drop";
+    case blink::mojom::NativeGuestStageMetric::kDividerFrame: return "divider-frame";
+    case blink::mojom::NativeGuestStageMetric::kTabSwitch: return "tab-switch";
+  }
+  return nullptr;
+}
+base::DictValue Sink(const viz::FrameSinkId& sink) {
+  return base::DictValue().Set("clientId", static_cast<double>(sink.client_id()))
+      .Set("sinkId", static_cast<double>(sink.sink_id()));
+}
+bool ValidScope(const blink::mojom::NativeGuestStageScope* scope) {
+  return scope && Metric(scope->metric) && !scope->request_nonce.is_empty() &&
+      scope->sample_sequence && scope->window_id > 0 && scope->shell_widget_routing_id > 0 &&
+      scope->shell_renderer_pid > 0 && scope->native_document_generation &&
+      scope->shell_sink.is_valid() && scope->display_sink.is_valid();
+}
+base::DictValue Record(const char* status, const char* reason,
+    const blink::mojom::NativeGuestStageScope* scope) {
+  auto record = base::DictValue().Set("producer", "aux-native-guest-presentation")
+      .Set("version", 1).Set("status", status).Set("measured", false).Set("reason", reason);
+  if (ValidScope(scope)) {
+    record.Set("metric", Metric(scope->metric));
+    record.Set("requestNonce", scope->request_nonce.ToString());
+    record.Set("sampleSequence", base::NumberToString(scope->sample_sequence));
+    record.Set("windowId", scope->window_id); record.Set("widgetRoutingId", scope->shell_widget_routing_id);
+    record.Set("rendererPid", scope->shell_renderer_pid);
+    record.Set("nativeDocumentGeneration", base::NumberToString(scope->native_document_generation));
+    record.Set("shellSink", Sink(scope->shell_sink)); record.Set("displaySink", Sink(scope->display_sink));
+  }
+  return record;
+}
+void Tick(base::DictValue& record, const char* key, base::TimeTicks value) {
+  if (value.is_null()) record.Set(key, base::Value());
+  else record.Set(key, base::NumberToString(value.since_origin().InMicroseconds()));
+}
+void Emit(const char* prefix, const base::DictValue& record) {
+  // Fixed records only; no URLs, text, document tokens or caller JSON. Private
+  // owned-fixture transport is bounded and absent from production advertising.
+  static unsigned count = 0;
+  if (!NativePerformanceObservationEnabled() || count >= 4000) return;
+  const auto json = base::WriteJson(record);
+  if (!json || json->size() > 16384) return;
+  ++count; std::cerr << prefix << *json << std::endl;
+}
+}
+base::DictValue EncodeGuestPresentationReady(const blink::mojom::NativeGuestStageScope& scope) {
+  return Record(ValidScope(&scope) ? "ready" : "refused",
+      ValidScope(&scope) ? "ready" : "invalid_scope", &scope);
+}
+base::DictValue EncodeGuestPresentationComplete(const blink::mojom::NativeGuestStageScope* scope,
+    const blink::mojom::NativeGuestStageSubmission* submission,
+    const viz::mojom::NativeGuestInclusionResult* presentation,
+    const std::optional<PerformanceInput>& input, const char* reason) {
+  const bool claimed_measurement = reason && std::strcmp(reason, "measured") == 0;
+  auto record = Record("refused", claimed_measurement ?
+      (input ? "invalid_presentation_pair" : "no_native_input") :
+      (reason ? reason : "invalid_presentation_pair"), scope);
+  if (input) {
+    const char* kind = input->kind == PerformanceInputKind::kKeyDown ? "keydown" :
+        input->kind == PerformanceInputKind::kLeftMouseUp ? "left-up" : "left-drag";
+    record.Set("originalInputKind", kind); record.Set("sourcePid", input->source_pid);
+    Tick(record, "nativeInputUs", input->event_ticks); Tick(record, "nativeObservedUs", input->observed_ticks);
+  }
+  if (!ValidScope(scope) || !submission || !submission->scope || !submission->mutation_witness ||
+      !presentation || !presentation->scope || !input ||
+      input->source_pid < 0 || input->observed_ticks < input->event_ticks ||
+      (scope->metric == blink::mojom::NativeGuestStageMetric::kTabSwitch ?
+          input->kind != PerformanceInputKind::kKeyDown :
+       scope->metric == blink::mojom::NativeGuestStageMetric::kSplitDrop ?
+          input->kind != PerformanceInputKind::kLeftMouseUp :
+          input->kind != PerformanceInputKind::kLeftMouseDragged) ||
+      presentation->drawn.empty() || presentation->drawn.size() > 5 ||
+      std::ranges::any_of(presentation->drawn, [](const auto& frame) {
+        return !frame || !frame->surface.is_valid() || !frame->token || frame->visible_bounds.IsEmpty() || frame->surface_size.IsEmpty();
+      }) ||
+      !submission->scope->Equals(*scope) || !submission->submitted || !submission->activated ||
+      !submission->submitted_frame || submission->submission_failure >= 0 || !submission->shell_frame_token ||
+      !presentation->measured || !presentation->elapsed ||
+      submission->input != input->event_ticks || input->target.window_id != scope->window_id ||
+      input->target.content_id != scope->shell_widget_routing_id ||
+      input->target.process_id != scope->shell_renderer_pid ||
+      input->target.document_generation != scope->native_document_generation ||
+      submission->input.is_null() || submission->input > submission->mutation ||
+      submission->mutation > submission->commit || submission->commit > submission->submitted_at ||
+      presentation->scope->display_sink != scope->display_sink || presentation->scope->shell_sink != scope->shell_sink ||
+      presentation->scope->mutation_shell_token != submission->shell_frame_token ||
+      presentation->scope->input != submission->input || presentation->scope->mutation != submission->mutation ||
+      presentation->scope->shell_submission != submission->submitted_at) return record;
+  const auto elapsed = ValidatedPresentationInterval(input->event_ticks,
+      submission->mutation, base::TimeTicks::Now(), presentation->feedback);
+  if (!elapsed || elapsed != presentation->elapsed || presentation->draw.is_null() ||
+      presentation->draw < submission->submitted_at || presentation->swap.is_null() ||
+      presentation->swap.swap_start < presentation->draw ||
+      presentation->swap.swap_end < presentation->swap.swap_start ||
+      presentation->feedback.timestamp < presentation->swap.swap_end) return record;
+  record.Set("status", "measured"); record.Set("measured", true); record.Set("reason", "measured");
+  Tick(record, "rendererInputUs", submission->input); Tick(record, "mutationUs", submission->mutation);
+  Tick(record, "commitUs", submission->commit); Tick(record, "submittedUs", submission->submitted_at);
+  Tick(record, "drawUs", presentation->draw); Tick(record, "swapStartUs", presentation->swap.swap_start);
+  Tick(record, "swapEndUs", presentation->swap.swap_end); Tick(record, "presentedUs", presentation->feedback.timestamp);
+  record.Set("shellFrameToken", static_cast<double>(submission->shell_frame_token));
+  record.Set("feedbackFlags", static_cast<double>(presentation->feedback.flags));
+  record.Set("elapsedUs", base::NumberToString(elapsed->InMicroseconds()));
+  base::ListValue drawn;
+  for (const auto& frame : presentation->drawn) {
+    if (!frame) continue;
+    auto surface = base::DictValue().Set("frameSink", Sink(frame->surface.frame_sink_id()))
+        .Set("parentSequenceNumber", static_cast<double>(frame->surface.local_surface_id().parent_sequence_number()))
+        .Set("childSequenceNumber", static_cast<double>(frame->surface.local_surface_id().child_sequence_number()))
+        .Set("embedToken", frame->surface.local_surface_id().embed_token().ToString());
+    drawn.Append(base::DictValue().Set("surface", std::move(surface)).Set("token", static_cast<double>(frame->token))
+        .Set("surfaceSize", base::DictValue().Set("width", frame->surface_size.width()).Set("height", frame->surface_size.height()))
+        .Set("visibleBounds", base::DictValue().Set("x", frame->visible_bounds.x()).Set("y", frame->visible_bounds.y())
+          .Set("width", frame->visible_bounds.width()).Set("height", frame->visible_bounds.height())));
+  }
+  record.Set("drawn", std::move(drawn)); return record;
+}
+NativeGuestPresentationFixture::NativeGuestPresentationFixture(base::WeakPtr<WebUIBrowserUI> ui)
+    : ui_(ui), session_(ui) {}
+NativeGuestPresentationFixture::~NativeGuestPresentationFixture() {
+  weak_factory_.InvalidateWeakPtrs(); session_.Cancel();
+}
+bool NativeGuestPresentationFixture::Stable() const {
+  const auto shell = ReadNativeGuestStageShellOwner(ui_);
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  return shell && ui_ && ui_->web_ui() && ui_->web_ui()->GetWebContents() && frame &&
+      ui_->web_ui()->GetWebContents()->GetPrimaryMainFrame() == frame;
+}
+void NativeGuestPresentationFixture::Prepare(blink::mojom::NativeGuestStageMetric metric, Reply ready) {
+  if (active_ || record_ || ready_ || completed_) {
+    std::move(ready).Run(Record("refused", "prior_sample_unconsumed", nullptr)); return;
+  }
+  auto* shell = ui_ && ui_->web_ui() ? ui_->web_ui()->GetWebContents() : nullptr;
+  auto* frame = shell ? shell->GetPrimaryMainFrame() : nullptr;
+  if (!ReadNativeGuestStageShellOwner(ui_) || !frame) {
+    record_ = Record("refused", "unavailable_owned_scope", nullptr);
+    std::move(ready).Run(record_->Clone()); return;
+  }
+  document_ = frame->GetWeakDocumentPtr(); active_ = true; ready_ = std::move(ready);
+  session_.Prepare(metric, base::BindOnce(&NativeGuestPresentationFixture::Ready, weak_factory_.GetWeakPtr()),
+      base::BindOnce(&NativeGuestPresentationFixture::Finished, weak_factory_.GetWeakPtr()));
+}
+void NativeGuestPresentationFixture::Ready(blink::mojom::NativeGuestStageScopePtr scope) {
+  if (!ready_) return;
+  if (!scope || !Stable()) { session_.Cancel(); return; }
+  auto record = EncodeGuestPresentationReady(*scope);
+  Emit("AUX_NATIVE_GUEST_PRESENTATION_READY_V1 ", record);
+  std::move(ready_).Run(std::move(record));
+}
+void NativeGuestPresentationFixture::Finished(blink::mojom::NativeGuestStageScopePtr scope,
+    blink::mojom::NativeGuestStageSubmissionPtr submission,
+    viz::mojom::NativeGuestInclusionResultPtr presentation, std::optional<PerformanceInput> input, const char* reason) {
+  auto record = EncodeGuestPresentationComplete(scope.get(), submission.get(), presentation.get(), input, reason);
+  // Preserve an existing original refusal. Ownership loss can invalidate a
+  // positive outcome, but must not replace a more specific failure reason.
+  if (!Stable() && record.FindBool("measured").value_or(false)) {
+    record.Set("status", "refused"); record.Set("measured", false);
+    record.Set("reason", "stale_owned_document"); record.Remove("elapsedUs");
+  }
+  active_ = false; Emit("AUX_NATIVE_GUEST_PRESENTATION_V1 ", record);
+  record_ = std::move(record);
+  if (ready_) std::move(ready_).Run(record_->Clone());
+  if (completed_) { auto reply = std::move(completed_); auto record = std::move(*record_); record_.reset(); std::move(reply).Run(std::move(record)); }
+}
+void NativeGuestPresentationFixture::Complete(Reply completed) {
+  if (completed_) { std::move(completed).Run(Record("refused", "completion_already_waiting", nullptr)); return; }
+  if (record_) { auto record = std::move(*record_); record_.reset(); std::move(completed).Run(std::move(record)); return; }
+  if (!active_ || ready_) { std::move(completed).Run(Record("refused", "no_prepared_sample", nullptr)); return; }
+  completed_ = std::move(completed);
+}
+bool NativeGuestPresentationFixture::DeferConsumedTabSwitch(const gfx::NativeEvent& event, base::OnceClosure effect) {
+  return active_ && Stable() && session_.DeferConsumedTabSwitch(event, std::move(effect));
+}
+}  // namespace aux
+#endif
