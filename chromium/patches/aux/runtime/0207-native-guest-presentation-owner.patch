@@ -0,0 +1,38 @@
+// Copyright 2026 The Aux Authors
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_GUEST_DOCUMENT_FRAME_STAMP_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_GUEST_DOCUMENT_FRAME_STAMP_H_
+#include <optional>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "third_party/blink/public/mojom/widget/native_guest_stage_measurement.mojom-blink.h"
+#include "third_party/blink/public/common/tokens/tokens.h"
+#include "third_party/blink/renderer/core/core_export.h"
+namespace blink {
+class WidgetBase;
+// Private lease on one actual guest widget. The owner supplies a fixed reader
+// of its current, paint-clean main Document, never a script/caller snapshot.
+// Its exclusive lifecycle slot must be reserved before construction.
+class CORE_EXPORT NativeGuestDocumentFrameStamp final : public mojom::blink::NativeGuestDocumentFrameLease {
+ public:
+  using ReadDocument = base::RepeatingCallback<std::optional<DocumentToken>()>;
+  NativeGuestDocumentFrameStamp(WidgetBase* widget, ReadDocument read_document);
+  ~NativeGuestDocumentFrameStamp() override;
+  bool Arm(DocumentToken expected, base::UnguessableToken scope,
+      mojo::PendingReceiver<mojom::blink::NativeGuestDocumentFrameLease> lease);
+  void Stop() override;
+  void Cancel();
+  bool armed() const { return expected_.has_value(); }
+ private:
+  void Lifecycle();
+  base::WeakPtr<WidgetBase> widget_;
+  ReadDocument read_document_;
+  std::optional<DocumentToken> expected_;
+  std::optional<base::UnguessableToken> scope_;
+  base::OneShotTimer timeout_;
+  mojo::Receiver<mojom::blink::NativeGuestDocumentFrameLease> lease_{this};
+  base::WeakPtrFactory<NativeGuestDocumentFrameStamp> weak_factory_{this};
+};
+}  // namespace blink
+#endif
diff --git a/third_party/blink/renderer/core/frame/native_guest_stage_controller.cc b/third_party/blink/renderer/core/frame/native_guest_stage_controller.cc
new file mode 100644
index 0000000..329a104
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/native_guest_stage_controller.cc
@@ -0,0 +1,84 @@
+// Copyright 2026 The Aux Authors
+#include "third_party/blink/renderer/core/frame/native_guest_stage_controller.h"
+#include <utility>
+#include "base/functional/bind.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+namespace blink {
+namespace {
+mojom::blink::NativeGuestStageWitnessPtr Witness(const NativeGuestStageWitness& sample) {
+  auto out = mojom::blink::NativeGuestStageWitness::New();
+  out->document = sample.document; out->selection_generation = sample.selection_generation;
+  out->geometry_generation = sample.geometry_generation; out->stage_instance = sample.stage_instance;
+  out->split_instance = sample.split_instance; out->dragging = sample.dragging;
+  out->focused_divider = sample.focused_divider;
+  for (const auto& page : sample.pages) {
+    auto item = mojom::blink::NativeGuestStagePage::New();
+    item->page_id = String::FromUTF8(page.page_id); item->content_id = String::FromUTF8(page.content_id);
+    item->document_epoch = page.document_epoch; item->bounds = page.bounds;
+    item->pane_bounds = page.pane_bounds; item->pane_radius = page.pane_radius;
+    item->plugin_bounds_in_parent_pixels = page.plugin_bounds_in_parent_pixels;
+    out->pages.push_back(std::move(item));
+  }
+  return out;
+}
+}  // namespace
+NativeGuestStageController::NativeGuestStageController(WidgetBase* widget,
+    aux::NativeContentFrameMeasurement::ScopeReader read_scope,
+    NativeGuestStageMeasurement::WitnessReader read_witness)
+    : read_witness_(read_witness), measurement_(widget, std::move(read_scope), std::move(read_witness)) {}
+NativeGuestStageController::~NativeGuestStageController() { Cancel(); }
+bool NativeGuestStageController::Prepare(mojom::blink::NativeGuestStageScopePtr scope,
+    mojo::PendingRemote<mojom::blink::NativeGuestStageReadiness> ready,
+    mojo::PendingReceiver<mojom::blink::NativeGuestStageInput> input, Result result) {
+  if (result_ || !scope || scope->request_nonce.is_empty() || !ready.is_valid() || !input.is_valid() ||
+      result.is_null() || read_witness_.is_null()) return false;
+  const auto baseline = read_witness_.Run();
+  if (!baseline || baseline->document != scope->shell_document) return false;
+  NativeGuestStageMetric metric;
+  switch (scope->metric) {
+    case mojom::blink::NativeGuestStageMetric::kSplitDrop: metric = NativeGuestStageMetric::kSplitDrop; break;
+    case mojom::blink::NativeGuestStageMetric::kDividerFrame: metric = NativeGuestStageMetric::kDividerFrame; break;
+    case mojom::blink::NativeGuestStageMetric::kTabSwitch: metric = NativeGuestStageMetric::kTabSwitch; break;
+  }
+  scope_ = std::move(scope); result_ = std::move(result); ready_ = false;
+  if (!measurement_.Prepare(metric, base::BindOnce(
+      &NativeGuestStageController::Complete, weak_factory_.GetWeakPtr()))) {
+    scope_.reset(); result_.Reset(); return false;
+  }
+  readiness_.Bind(std::move(ready)); input_.Bind(std::move(input));
+  input_.set_disconnect_handler(base::BindOnce(&NativeGuestStageController::Cancel, weak_factory_.GetWeakPtr()));
+  readiness_.set_disconnect_handler(base::BindOnce(
+      [](base::WeakPtr<NativeGuestStageController> self) { if (self && !self->ready_) self->Cancel(); },
+      weak_factory_.GetWeakPtr()));
+  readiness_->Ready(scope_->Clone(), Witness(*baseline), base::BindOnce(
+      &NativeGuestStageController::Accepted, weak_factory_.GetWeakPtr()));
+  return true;
+}
+void NativeGuestStageController::Accepted(bool accepted) {
+  if (!result_) return;
+  if (!accepted) { Cancel(); return; }
+  ready_ = true; measurement_.SetInputEnabled(true); readiness_->Started(scope_->Clone()); readiness_.reset();
+}
+void NativeGuestStageController::ArmConsumedNativeInput(const base::UnguessableToken& nonce,
+    base::TimeTicks original, ArmConsumedNativeInputCallback accepted) {
+  const bool allowed = ready_ && result_ && scope_ && nonce == scope_->request_nonce &&
+      scope_->metric == mojom::blink::NativeGuestStageMetric::kTabSwitch;
+  const bool armed = allowed && measurement_.NativeInput(original);
+  std::move(accepted).Run(armed);
+}
+void NativeGuestStageController::Complete(NativeGuestStageSubmission sample) {
+  if (!result_) return;
+  auto out = mojom::blink::NativeGuestStageSubmission::New();
+  out->scope = scope_->Clone(); out->baseline = Witness(sample.baseline);
+  if (!sample.mutation.is_null())
+    out->mutation_witness = Witness(sample.mutation_witness);
+  out->submitted = ready_ && sample.submitted;
+  out->input = sample.input; out->mutation = sample.mutation;
+  out->commit = sample.submission.commit; out->submitted_at = sample.submission.submitted;
+  out->shell_frame_token = sample.submission.frame_token; out->activated = sample.submission.activated;
+  out->submitted_frame = sample.submission.submitted_frame; out->submission_failure = sample.submission.failure_reason;
+  ready_ = false; readiness_.reset(); input_.reset(); scope_.reset();
+  std::move(result_).Run(std::move(out));
+}
+void NativeGuestStageController::Cancel() { measurement_.Cancel(); }
+}  // namespace blink
