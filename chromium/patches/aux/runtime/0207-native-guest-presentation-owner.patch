+// native Profile/window pages and handles; reject omitted/foreign visible guests.
+// Does not read URL/text, create handles, or claim rendering/presentation.
+std::optional<NativeGuestStageOwnedSnapshot> ReadNativeGuestStageOwnedSnapshot(
