--- /dev/null
+++ b/third_party/blink/renderer/core/frame/native_guest_stage_witness.h
@@ -0,0 +1,41 @@
+// Copyright 2026 The Aux Authors
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_GUEST_STAGE_WITNESS_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_GUEST_STAGE_WITNESS_H_
+#include <optional>
+#include <string>
+#include <vector>
+#include "third_party/blink/public/common/tokens/tokens.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/rect.h"
+namespace blink {
+class Document;
+enum class NativeGuestStageMetric { kSplitDrop, kDividerFrame, kTabSwitch };
+struct NativeGuestStagePage {
+  std::string page_id;
+  std::string content_id;
+  uint64_t document_epoch = 0;
+  gfx::RectF bounds;
+  gfx::RectF pane_bounds;
+  float pane_radius = 0;
+  std::optional<gfx::Rect> plugin_bounds_in_parent_pixels;
+  bool operator==(const NativeGuestStagePage&) const = default;
+};
+struct NativeGuestStageWitness {
+  DocumentToken document;
+  uint64_t selection_generation = 0;
+  uint64_t geometry_generation = 0;
+  bool dragging = false;
+  bool focused_divider = false;
+  std::vector<NativeGuestStagePage> pages;
+  uint64_t stage_instance = 0;
+  uint64_t split_instance = 0;
+};
+// Fixed actual product DOM, read at paint-clean without triggering a lifecycle.
+// Opaque identities are sent only over the browser-owned private pipe. They are
+// NOT authority: native must resolve/revalidate actual owner/document/connector.
+CORE_EXPORT std::optional<NativeGuestStageWitness> ReadNativeGuestStageWitness(Document& document);
+CORE_EXPORT bool NativeGuestStageMatchesInput(NativeGuestStageMetric metric,
+    const NativeGuestStageWitness& before, const NativeGuestStageWitness& after);
+}  // namespace blink
+#endif
diff --git a/third_party/blink/renderer/core/frame/native_guest_stage_witness_test.cc b/third_party/blink/renderer/core/frame/native_guest_stage_witness_test.cc
