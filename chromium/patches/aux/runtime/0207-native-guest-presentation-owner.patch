@@ -0,0 +1,107 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_guest_stage_owner.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <set>
+#include "base/command_line.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/native_performance_observer.h"
+#include "chrome/browser/ui/aux/page_identity.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "chrome/browser/ui/aux/surface_visibility.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_window.h"
+#include "components/guest_contents/browser/guest_contents_handle.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/browser/surface_embed/surface_embed_connector_impl.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "ui/compositor/compositor.h"
+#include "ui/views/widget/widget.h"
+namespace aux {
+std::optional<NativeGuestStageOwnedSnapshot> ReadNativeGuestStageShellOwner(
+    base::WeakPtr<WebUIBrowserUI> ui) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!ui || !NativePerformanceObservationEnabled())
+    return std::nullopt;
+  auto* web_ui = ui->web_ui();
+  auto* shell = web_ui ? web_ui->GetWebContents() : nullptr;
+  auto* frame = shell ? shell->GetPrimaryMainFrame() : nullptr;
+  auto* window = shell ? WebUIBrowserWindow::FromWebShellWebContents(shell) : nullptr;
+  if (!shell || shell->IsBeingDestroyed() || !frame || !window || !window->browser() ||
+      frame != web_ui->GetRenderFrameHost() || !frame->IsRenderFrameLive() ||
+      frame->IsErrorDocument() || !frame->IsInLifecycleState(content::RenderFrameHost::LifecycleState::kActive) ||
+      frame->GetLastCommittedURL().spec() != "chrome://aux/") return std::nullopt;
+  auto* profile = Profile::FromWebUI(web_ui);
+  const base::FilePath selected(base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("user-data-dir"));
+  if (!profile || profile != window->browser()->GetProfile() || profile->GetPath().DirName() != selected)
+    return std::nullopt;
+  auto* widget = static_cast<content::RenderWidgetHostImpl*>(frame->GetRenderWidgetHost());
+  auto* process = frame->GetProcess();
+  auto* compositor = window->widget() ? window->widget()->GetCompositor() : nullptr;
+  const auto native = window->GetAuxAppearanceSnapshot();
+  const auto window_id = native.FindInt("windowId");
+  if (!widget || !process || widget->GetProcess() != process || !process->GetProcess().IsValid() ||
+      widget->GetRoutingID() <= 0 || !widget->GetFrameSinkId().is_valid() || !compositor ||
+      !compositor->frame_sink_id().is_valid() || !window_id || *window_id <= 0) return std::nullopt;
+  NativeGuestStageOwnedSnapshot result;
+  result.window_id = *window_id;
+  result.shell_widget_routing_id = widget->GetRoutingID();
+  result.shell_renderer_pid = process->GetProcess().Pid();
+  result.shell_document = static_cast<content::RenderFrameHostImpl*>(frame)->GetDocumentToken();
+  result.shell_sink = widget->GetFrameSinkId(); result.display_sink = compositor->frame_sink_id();
+  return result;
+}
+std::optional<NativeGuestStageOwnedSnapshot> ReadNativeGuestStageOwnedSnapshot(
+    base::WeakPtr<WebUIBrowserUI> ui,
+    const std::vector<NativeGuestStagePageIdentity>& asserted_pages) {
+  if (asserted_pages.size() > 4) return std::nullopt;
+  auto shell_owner = ReadNativeGuestStageShellOwner(ui);
+  if (!shell_owner) return std::nullopt;
+  auto* web_ui = ui->web_ui();
+  auto* shell = web_ui->GetWebContents();
+  auto* window = WebUIBrowserWindow::FromWebShellWebContents(shell);
+  auto* profile = Profile::FromWebUI(web_ui);
+  auto* catalog = TabCatalog::GetForProfile(profile);
+  auto* tabs = window->browser()->GetTabStripModel();
+  if (!catalog || !tabs) return std::nullopt;
+  auto result = *shell_owner;
+  std::set<content::WebContents*> expected;
+  std::set<std::string> handles;
+  for (const auto& assertion : asserted_pages) {
+    if (!PageIdentity::IsValid(assertion.page_id) || assertion.content_id.empty() ||
+        assertion.content_id.size() > 128 || !handles.insert(assertion.content_id).second)
+      return std::nullopt;
+    BrowserWindowInterface* owner = nullptr;
+    auto* guest = catalog->FindPage(assertion.page_id, &owner);
+    auto* identity = guest ? PageIdentity::FromWebContents(guest) : nullptr;
+    auto* handle = guest ? guest_contents::GuestContentsHandle::FromWebContents(guest) : nullptr;
+    if (!guest || owner != window->browser() || !identity || identity->id() != assertion.page_id ||
+        identity->runtime_owned() || !handle || handle->id().ToString() != assertion.content_id ||
+        !expected.insert(guest).second) return std::nullopt;
+    auto actual = ReadNativeGuestPresentationOwner(ui, guest->GetWeakPtr());
+    if (!actual || actual->window_id != result.window_id || actual->shell_document != result.shell_document ||
+        actual->display_sink != result.display_sink || actual->shell_sink != result.shell_sink)
+      return std::nullopt;
+    result.identities.push_back(assertion); result.guests.push_back(*actual);
+  }
+  // Compare actual connector visibility in the exact shell, not page labels or
+  // IsStageVisible alone: a drag scrim can temporarily remove the rendered embed.
+  std::set<content::WebContents*> attached;
+  for (int index = 0; index < tabs->count(); ++index) {
+    auto* guest = tabs->GetWebContentsAt(index);
+    auto* connector = guest ? guest->GetSurfaceEmbedConnector() : nullptr;
+    if (!connector) continue;
+    auto* actual = static_cast<content::SurfaceEmbedConnectorImpl*>(connector);
+    if (actual->IsVisible() && actual->GetParentRenderWidgetHostView() == shell->GetRenderWidgetHostView())
+      attached.insert(guest);
+  }
+  if (attached != expected) return std::nullopt;
+  return result;
+}
+}  // namespace aux
+#endif
