+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_GUEST_STAGE_CONTROLLER_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_FRAME_NATIVE_GUEST_STAGE_CONTROLLER_H_
