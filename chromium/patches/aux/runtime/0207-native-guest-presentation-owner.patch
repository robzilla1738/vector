+// Copyright 2026 The Aux Authors
+#include "content/browser/renderer_host/render_frame_metadata_provider_impl.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/test/task_environment.h"
+#include "cc/trees/render_frame_metadata.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace content {
+namespace {
+class GuestMetadataQueueClient final : public FrameTokenMessageQueue::Client {
+ public:
+  void OnInvalidFrameToken(uint32_t token) override { ADD_FAILURE() << token; }
+  std::string GetMainFrameLastCommittedURLSpec() override { return {}; }
+};
+TEST(NativeGuestFrameMetadata, ExactActivatedTupleAndScopeReset) {
+  base::test::TaskEnvironment environment;
+  GuestMetadataQueueClient queue;
+  RenderFrameMetadataProviderImpl provider(
+      base::SingleThreadTaskRunner::GetCurrentDefault(), &queue);
+  mojo::Remote<cc::mojom::RenderFrameMetadataObserverClient> client;
+  mojo::PendingRemote<cc::mojom::RenderFrameMetadataObserver> observer;
+  auto unused_observer_receiver = observer.InitWithNewPipeAndPassReceiver();
+  provider.Bind(client.BindNewPipeAndPassReceiver(), std::move(observer));
+  const auto document = base::UnguessableToken::Create();
+  const auto scope = base::UnguessableToken::Create();
+  cc::RenderFrameMetadata metadata;
+  metadata.aux_guest_document_for_testing = document;
+  metadata.aux_guest_scope_for_testing = scope;
+  metadata.local_surface_id = viz::LocalSurfaceId(
+      1, 1, base::UnguessableToken::Create());
+  client->OnRenderFrameMetadataChanged(10, metadata);
+  environment.RunUntilIdle();
+  // Metadata arrival before the actual queued activation is insufficient.
+  EXPECT_FALSE(provider.FindAuxGuestFrameForTesting(
+      document, scope, *metadata.local_surface_id, 10));
+  provider.DidProcessFrame(10, base::TimeTicks::Now());
+  EXPECT_TRUE(provider.FindAuxGuestFrameForTesting(
+      document, scope, *metadata.local_surface_id, 10));
+  EXPECT_FALSE(provider.FindAuxGuestFrameForTesting(
+      document, scope, *metadata.local_surface_id, 11));
+  EXPECT_FALSE(provider.FindAuxGuestFrameForTesting(
+      document, base::UnguessableToken::Create(), *metadata.local_surface_id, 10));
+  EXPECT_FALSE(provider.FindAuxGuestFrameForTesting(
+      base::UnguessableToken::Create(), scope, *metadata.local_surface_id, 10));
+  EXPECT_FALSE(provider.FindAuxGuestFrameForTesting(document, scope,
+      viz::LocalSurfaceId(2, 1, base::UnguessableToken::Create()), 10));
+  // A newer exact token must not relabel the already observed older frame.
+  client->OnRenderFrameMetadataChanged(11, metadata);
+  environment.RunUntilIdle();
+  provider.DidProcessFrame(11, base::TimeTicks::Now());
+  EXPECT_TRUE(provider.FindAuxGuestFrameForTesting(
+      document, scope, *metadata.local_surface_id, 10));
+  EXPECT_TRUE(provider.FindAuxGuestFrameForTesting(
+      document, scope, *metadata.local_surface_id, 11));
+  metadata.aux_guest_scope_for_testing = base::UnguessableToken::Create();
+  client->OnRenderFrameMetadataChanged(12, metadata);
+  environment.RunUntilIdle();
+  provider.DidProcessFrame(12, base::TimeTicks::Now());
+  EXPECT_FALSE(provider.FindAuxGuestFrameForTesting(
+      document, scope, *metadata.local_surface_id, 10));
+  EXPECT_TRUE(provider.FindAuxGuestFrameForTesting(document,
+      *metadata.aux_guest_scope_for_testing, *metadata.local_surface_id, 12));
+  provider.ResetFrameTokenMessageQueue();
+  EXPECT_FALSE(provider.FindAuxGuestFrameForTesting(document,
+      *metadata.aux_guest_scope_for_testing, *metadata.local_surface_id, 12));
+}
+TEST(NativeGuestFrameMetadata, AbsentMarkerCannotBorrowPriorDocument) {
+  base::test::TaskEnvironment environment;
+  GuestMetadataQueueClient queue;
+  RenderFrameMetadataProviderImpl provider(
+      base::SingleThreadTaskRunner::GetCurrentDefault(), &queue);
+  mojo::Remote<cc::mojom::RenderFrameMetadataObserverClient> client;
+  mojo::PendingRemote<cc::mojom::RenderFrameMetadataObserver> observer;
+  auto unused_observer_receiver = observer.InitWithNewPipeAndPassReceiver();
+  provider.Bind(client.BindNewPipeAndPassReceiver(), std::move(observer));
+  cc::RenderFrameMetadata metadata;
+  metadata.aux_guest_document_for_testing = base::UnguessableToken::Create();
+  metadata.aux_guest_scope_for_testing = base::UnguessableToken::Create();
+  metadata.local_surface_id = viz::LocalSurfaceId(
+      1, 1, base::UnguessableToken::Create());
+  const auto previous = metadata;
+  client->OnRenderFrameMetadataChanged(1, metadata);
+  environment.RunUntilIdle(); provider.DidProcessFrame(1, base::TimeTicks::Now());
+  metadata.aux_guest_document_for_testing.reset();
+  metadata.aux_guest_scope_for_testing.reset();
+  client->OnRenderFrameMetadataChanged(2, metadata);
+  environment.RunUntilIdle(); provider.DidProcessFrame(2, base::TimeTicks::Now());
+  EXPECT_FALSE(provider.aux_guest_activated_frame_for_testing());
+  EXPECT_FALSE(provider.FindAuxGuestFrameForTesting(
+      *previous.aux_guest_document_for_testing,
+      *previous.aux_guest_scope_for_testing, *previous.local_surface_id, 1));
+}
+}  // namespace
+}  // namespace content
diff --git a/third_party/blink/public/mojom/widget/native_guest_stage_measurement.mojom b/third_party/blink/public/mojom/widget/native_guest_stage_measurement.mojom
new file mode 100644
index 0000000..71e2fac
--- /dev/null
+++ b/third_party/blink/public/mojom/widget/native_guest_stage_measurement.mojom
@@ -0,0 +1,86 @@
+// Copyright 2026 The Aux Authors
+module blink.mojom;
+import "mojo/public/mojom/base/time.mojom";
+import "mojo/public/mojom/base/unguessable_token.mojom";
+import "services/viz/public/mojom/compositing/frame_sink_id.mojom";
+import "third_party/blink/public/mojom/tokens/tokens.mojom";
+import "ui/gfx/geometry/mojom/geometry.mojom";
+
+// Internal owned-fixture instrumentation. These are continuity assertions on an
+// already bound widget, never IDs usable to select another window/document.
+enum NativeGuestStageMetric { kSplitDrop, kDividerFrame, kTabSwitch };
+struct NativeGuestStageScope {
+  NativeGuestStageMetric metric;
+  mojo_base.mojom.UnguessableToken request_nonce;
+  uint64 sample_sequence;
+  int32 window_id;
+  int32 shell_widget_routing_id;
+  int32 shell_renderer_pid;
+  uint64 native_document_generation;
+  DocumentToken shell_document;
+  viz.mojom.FrameSinkId shell_sink;
+  viz.mojom.FrameSinkId display_sink;
+};
+struct NativeGuestStagePage {
+  string page_id;
+  string content_id;
+  uint64 document_epoch;
+  gfx.mojom.RectF bounds;
+  gfx.mojom.RectF pane_bounds;
+  float pane_radius;
+  gfx.mojom.Rect? plugin_bounds_in_parent_pixels;
+};
+struct NativeGuestStageWitness {
+  DocumentToken document;
+  uint64 selection_generation;
+  uint64 geometry_generation;
+  uint64 stage_instance;
+  uint64 split_instance;
+  bool dragging;
+  bool focused_divider;
+  array<NativeGuestStagePage> pages;
+};
+struct NativeGuestStageSubmission {
+  NativeGuestStageScope scope;
+  NativeGuestStageWitness baseline;
+  NativeGuestStageWitness? mutation_witness;
+  bool submitted;
+  mojo_base.mojom.TimeTicks input;
+  mojo_base.mojom.TimeTicks mutation;
+  mojo_base.mojom.TimeTicks commit;
+  mojo_base.mojom.TimeTicks submitted_at;
+  uint32 shell_frame_token;
+  bool activated;
+  bool submitted_frame;
+  int32 submission_failure;
+};
+// Browser validates actual prepared DOM identities through existing Profile/tab
+// ownership before ACK. No ready record may precede this genuine acceptance.
+interface NativeGuestStageReadiness {
+  Ready(NativeGuestStageScope scope, NativeGuestStageWitness baseline)
+      => (bool accepted);
+  // Actual renderer ACK has been processed and its input observer is armed.
+  Started(NativeGuestStageScope scope);
+};
+// Separate private control pipe is retained only by the owning native session.
+// Used solely for an AppKit-consumed command, before its real effect executes.
+// Normal pointer inputs are observed in WidgetBase's actual pre-handler path.
+interface NativeGuestStageInput {
+  ArmConsumedNativeInput(mojo_base.mojom.UnguessableToken request_nonce,
+      mojo_base.mojom.TimeTicks actual_native_input) => (bool accepted);
+};
+
+// Private native-fixture grant on an already bound actual guest widget. Both
+// document and nonce are browser-owned continuity fences, never selectors.
+struct NativeGuestDocumentFrameScope {
+  DocumentToken document;
+  mojo_base.mojom.UnguessableToken request_nonce;
+  int32 widget_routing_id;
+  int32 renderer_pid;
+  viz.mojom.FrameSinkId frame_sink;
+};
+// Disconnect revokes the marker and clears its pending-tree state. This pipe is
+// retained only by the native fixture session; there is no public receiver.
+interface NativeGuestDocumentFrameLease {
+  Stop();
+};
diff --git a/third_party/blink/renderer/core/frame/native_guest_document_frame_stamp.cc b/third_party/blink/renderer/core/frame/native_guest_document_frame_stamp.cc
new file mode 100644
index 0000000..3e36cf3
--- /dev/null
+++ b/third_party/blink/renderer/core/frame/native_guest_document_frame_stamp.cc
@@ -0,0 +1,50 @@
+// Copyright 2026 The Aux Authors
+#include "third_party/blink/renderer/core/frame/native_guest_document_frame_stamp.h"
+#include <utility>
+#include "base/functional/bind.h"
+#include "cc/trees/layer_tree_host.h"
+#include "third_party/blink/renderer/platform/widget/widget_base.h"
+namespace blink {
+NativeGuestDocumentFrameStamp::NativeGuestDocumentFrameStamp(
+    WidgetBase* widget, ReadDocument read_document)
+    : widget_(widget ? widget->GetWeakPtr() : base::WeakPtr<WidgetBase>()),
+      read_document_(std::move(read_document)) {}
+NativeGuestDocumentFrameStamp::~NativeGuestDocumentFrameStamp() { Cancel(); }
+bool NativeGuestDocumentFrameStamp::Arm(DocumentToken expected,
+    base::UnguessableToken scope,
+    mojo::PendingReceiver<mojom::blink::NativeGuestDocumentFrameLease> lease) {
+  if (expected_ || !lease.is_valid() || scope.is_empty() || read_document_.is_null() || !widget_ ||
+      widget_->WillBeDestroyed() || !widget_->LayerTreeHost()) return false;
+  // Actual current-document validation is repeated at each completed lifecycle.
+  // Hidden guests can arm without inventing a paint; the first real lifecycle
+  // after attachment supplies the marker to its matching cc commit.
+  expected_ = expected; scope_ = scope;
+  lease_.Bind(std::move(lease));
+  lease_.set_disconnect_handler(base::BindOnce(
+      &NativeGuestDocumentFrameStamp::Cancel, weak_factory_.GetWeakPtr()));
+  widget_->SetPerformanceLifecycleCallbackForTesting(base::BindRepeating(
+      &NativeGuestDocumentFrameStamp::Lifecycle, weak_factory_.GetWeakPtr()));
+  timeout_.Start(FROM_HERE, base::Seconds(6), base::BindOnce(
+      &NativeGuestDocumentFrameStamp::Cancel, weak_factory_.GetWeakPtr()));
+  widget_->LayerTreeHost()->SetNeedsCommit();
+  return true;
+}
+void NativeGuestDocumentFrameStamp::Lifecycle() {
+  if (!expected_ || !scope_ || !widget_ || widget_->WillBeDestroyed() ||
+      !widget_->LayerTreeHost()) { Cancel(); return; }
+  const auto document = read_document_.Run();
+  if (!document || *document != *expected_) { Cancel(); return; }
+  // This is the actual paint-clean document for this widget's pending tree.
+  // Metadata later reads the activated tree, not the current browser RFH.
+  widget_->LayerTreeHost()->SetAuxGuestDocumentForTesting(document->value(), *scope_);
+}
+void NativeGuestDocumentFrameStamp::Stop() { Cancel(); }
+void NativeGuestDocumentFrameStamp::Cancel() {
+  timeout_.Stop(); lease_.reset();
+  if (expected_ && widget_ && !widget_->WillBeDestroyed() && widget_->LayerTreeHost()) {
+    widget_->SetPerformanceLifecycleCallbackForTesting({});
+    widget_->LayerTreeHost()->SetAuxGuestDocumentForTesting(std::nullopt, std::nullopt);
+  }
+  expected_.reset(); scope_.reset();
+}
+}  // namespace blink
diff --git a/third_party/blink/renderer/core/frame/native_guest_document_frame_stamp.h b/third_party/blink/renderer/core/frame/native_guest_document_frame_stamp.h
