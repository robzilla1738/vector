@@ -0,0 +1,32 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_guest_stage_input_mac.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#import <Cocoa/Cocoa.h>
+#include "base/apple/owned_objc.h"
+#include "chrome/browser/ui/aux/native_guest_stage_owner.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_window.h"
+#include "content/public/browser/web_ui.h"
+namespace aux {
+struct NativeGuestStagePointerInput::Impl { id __strong monitor = nil; };
+NativeGuestStagePointerInput::NativeGuestStagePointerInput(
+    base::WeakPtr<WebUIBrowserUI> ui,
+    base::RepeatingCallback<void(const gfx::NativeEvent&)> observed)
+    : impl_(std::make_unique<Impl>()) {
+  if (observed.is_null() || !ReadNativeGuestStageShellOwner(ui)) return;
+  impl_->monitor = [NSEvent addLocalMonitorForEventsMatchingMask:
+      (NSEventMaskLeftMouseUp | NSEventMaskLeftMouseDragged)
+      handler:^NSEvent*(NSEvent* original) {
+        if (!ui || !ReadNativeGuestStageShellOwner(ui)) return original;
+        auto* window = WebUIBrowserWindow::FromWebShellWebContents(ui->web_ui()->GetWebContents());
+        // Compare only the event's window pointer; no foreign-window readout.
+        if (!window || original.window != window->GetNativeWindow().GetNativeNSWindow()) return original;
+        observed.Run(base::apple::OwnedNSEvent(original));
+        return original;
+      }];
+}
+NativeGuestStagePointerInput::~NativeGuestStagePointerInput() {
+  if (impl_->monitor) [NSEvent removeMonitor:impl_->monitor];
+}
+}  // namespace aux
+#endif
