diff --git a/chrome/browser/ui/aux/native_guest_stage_session.cc b/chrome/browser/ui/aux/native_guest_stage_session.cc
new file mode 100644
index 0000000..f68af06
--- /dev/null
+++ b/chrome/browser/ui/aux/native_guest_stage_session.cc
@@ -0,0 +1,384 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_guest_stage_session.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <algorithm>
+#include <cmath>
+#include <set>
+#include <utility>
+#include "base/functional/bind.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "chrome/browser/ui/aux/native_guest_stage_input_mac.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "chrome/browser/ui/aux/page_identity.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
+#include "content/public/browser/render_process_host.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_window.h"
+#include "content/browser/renderer_host/render_widget_host_impl.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_ui.h"
+#include "ui/compositor/compositor.h"
+#include "ui/gfx/geometry/point_conversions.h"
+#include "ui/gfx/geometry/size_conversions.h"
+#include "ui/views/widget/widget.h"
+namespace aux {
+namespace {
+constexpr uint64_t kLargestSafeCounter = 9007199254740991ULL;
+bool SameScope(const blink::mojom::NativeGuestStageScope& a,
+    const blink::mojom::NativeGuestStageScope& b) {
+  return a.metric == b.metric && a.request_nonce == b.request_nonce &&
+      a.sample_sequence == b.sample_sequence && a.window_id == b.window_id &&
+      a.shell_widget_routing_id == b.shell_widget_routing_id &&
+      a.shell_renderer_pid == b.shell_renderer_pid &&
+      a.native_document_generation == b.native_document_generation &&
+      a.shell_document == b.shell_document && a.shell_sink == b.shell_sink &&
+      a.display_sink == b.display_sink;
+}
+std::optional<std::vector<NativeGuestStagePageIdentity>> Pages(
+    const blink::mojom::NativeGuestStageWitness& witness) {
+  if (!witness.stage_instance || !witness.selection_generation || witness.pages.size() > 4)
+    return std::nullopt;
+  std::vector<NativeGuestStagePageIdentity> pages;
+  for (const auto& page : witness.pages) {
+    if (!page || page->page_id.empty() || page->page_id.size() > 128 ||
+        page->content_id.empty() || page->content_id.size() > 128 ||
+        !std::isfinite(page->bounds.x()) || !std::isfinite(page->bounds.y()) ||
+        !std::isfinite(page->bounds.width()) || !std::isfinite(page->bounds.height()) ||
+        page->bounds.width() <= 0 || page->bounds.height() <= 0 ||
+        !page->plugin_bounds_in_parent_pixels || page->plugin_bounds_in_parent_pixels->IsEmpty() ||
+        !std::isfinite(page->pane_bounds.x()) || !std::isfinite(page->pane_bounds.y()) ||
+        !std::isfinite(page->pane_bounds.width()) || !std::isfinite(page->pane_bounds.height()) ||
+        !std::isfinite(page->pane_radius) || page->pane_radius < 0 ||
+        page->pane_bounds.IsEmpty() || !page->pane_bounds.Contains(gfx::RectF(*page->plugin_bounds_in_parent_pixels)) ||
+        2 * page->pane_radius > std::min(page->pane_bounds.width(), page->pane_bounds.height())) return std::nullopt;
+    pages.push_back({page->page_id, page->content_id});
+  }
+  return pages;
+}
+bool SameWitness(const blink::mojom::NativeGuestStageWitness& a,
+    const blink::mojom::NativeGuestStageWitness& b) {
+  return a.Equals(b);
+}
+}  // namespace
+bool NativeGuestStageGeometryMatches(const blink::mojom::NativeGuestStageWitness& witness,
+    const NativeGuestStageOwnedSnapshot& owner) {
+  if (witness.pages.size() != owner.guests.size()) return false;
+  for (size_t i = 0; i < witness.pages.size(); ++i) {
+    const auto& page = witness.pages[i]; const auto& guest = owner.guests[i];
+    if (!page || !page->plugin_bounds_in_parent_pixels ||
+        !std::isfinite(guest.device_scale_factor) || guest.device_scale_factor <= 0) return false;
+    const auto& pixels = *page->plugin_bounds_in_parent_pixels;
+    const float inverse = 1 / guest.device_scale_factor;
+    const gfx::Rect dip(gfx::ScaleToFlooredPoint(pixels.origin(), inverse),
+        gfx::ScaleToCeiledSize(pixels.size(), inverse));
+    if (dip != guest.native_bounds_in_parent_dip || pixels.size() != guest.native_frame_size_in_pixels ||
+        (!witness.split_instance && (page->pane_radius != 0 || page->pane_bounds != gfx::RectF(pixels))))
+      return false;
+  }
+  return true;
+}
+NativeGuestStageSession::NativeGuestStageSession(base::WeakPtr<WebUIBrowserUI> ui)
+    : ui_(std::move(ui)) {}
+NativeGuestStageSession::~NativeGuestStageSession() { Cancel(); }
+blink::mojom::NativeGuestStageScopePtr NativeGuestStageSession::ReadScope() {
+  const auto actual = ReadNativeGuestStageShellOwner(ui_);
+  if (!actual) return nullptr;
+  if (!last_document_ || *last_document_ != actual->shell_document) {
+    if (document_generation_ == kLargestSafeCounter) return nullptr;
+    last_document_ = actual->shell_document; ++document_generation_;
+  }
+  auto scope = blink::mojom::NativeGuestStageScope::New();
+  scope->window_id = actual->window_id;
+  scope->shell_widget_routing_id = actual->shell_widget_routing_id;
+  scope->shell_renderer_pid = actual->shell_renderer_pid;
+  scope->native_document_generation = document_generation_;
+  scope->shell_document = actual->shell_document;
+  scope->shell_sink = actual->shell_sink; scope->display_sink = actual->display_sink;
+  return scope;
+}
+bool NativeGuestStageSession::StableShell() const {
+  const auto actual = ReadNativeGuestStageShellOwner(ui_);
+  return scope_ && actual && document_.AsRenderFrameHostIfValid() &&
+      actual->window_id == scope_->window_id &&
+      actual->shell_widget_routing_id == scope_->shell_widget_routing_id &&
+      actual->shell_renderer_pid == scope_->shell_renderer_pid &&
+      actual->shell_document == scope_->shell_document && actual->shell_sink == scope_->shell_sink &&
+      actual->display_sink == scope_->display_sink;
+}
+bool NativeGuestStageSession::StableBaselineDocuments() const {
+  if (!StableShell() || !baseline_owner_ || baseline_documents_.size() != baseline_owner_->identities.size())
+    return false;
+  auto* window = WebUIBrowserWindow::FromWebShellWebContents(ui_->web_ui()->GetWebContents());
+  auto* catalog = TabCatalog::GetForProfile(Profile::FromWebUI(ui_->web_ui()));
+  if (!window || !catalog) return false;
+  for (size_t index = 0; index < baseline_documents_.size(); ++index) {
+    BrowserWindowInterface* owner = nullptr;
+    auto* page = catalog->FindPage(baseline_owner_->identities[index].page_id, &owner);
+    auto* current = baseline_documents_[index].AsRenderFrameHostIfValid();
+    if (!page || owner != window->browser() || !current || page->GetPrimaryMainFrame() != current)
+      return false;
+  }
+  return true;
+}
+bool NativeGuestStageSession::StableBaselineSelection() const {
+  const auto pages = baseline_ ? Pages(*baseline_) : std::nullopt;
+  const auto owner = pages ? ReadNativeGuestStageOwnedSnapshot(ui_, *pages) : std::nullopt;
+  return owner && baseline_owner_ && *owner == *baseline_owner_ && StableBaselineDocuments();
+}
+bool NativeGuestStageSession::Prepare(blink::mojom::NativeGuestStageMetric metric, Prepared prepared, Result result) {
+  if (result.is_null() || prepared.is_null()) return false;
+  auto scope = ReadScope();
+  if (result_ || !scope || sequence_ == kLargestSafeCounter ||
+      !base::TimeTicks::IsConsistentAcrossProcesses()) {
+    std::move(result).Run(nullptr, nullptr, nullptr, std::nullopt, "unavailable_owned_scope"); return false;
+  }
+  scope->metric = metric; scope->request_nonce = base::UnguessableToken::Create();
+  scope->sample_sequence = ++sequence_; scope_ = std::move(scope);
+  auto* frame = ui_->web_ui()->GetWebContents()->GetPrimaryMainFrame();
+  document_ = frame->GetWeakDocumentPtr(); result_ = std::move(result); prepared_ = std::move(prepared);
+  baseline_.reset(); baseline_owner_.reset(); baseline_documents_.clear(); mutation_owner_.reset(); submission_.reset(); input_.reset(); renderer_started_ = false;
+  readiness_.reset(); input_control_.reset();
+  timeout_.Start(FROM_HERE, base::Seconds(6), base::BindOnce(
+      &NativeGuestStageSession::Refuse, weak_factory_.GetWeakPtr(), "timeout"));
+  if (!ArmGuestDocuments()) { Refuse("guest_document_lease_refused"); return false; }
+  return true;
+}
+bool NativeGuestStageSession::StableGuestDocuments() const {
+  if (!StableShell() || leased_guest_documents_.empty() ||
+      leased_guest_documents_.size() != guest_leases_.size()) return false;
+  auto* window = WebUIBrowserWindow::FromWebShellWebContents(ui_->web_ui()->GetWebContents());
+  auto* tabs = window->browser()->GetTabStripModel();
+  if (!tabs || static_cast<size_t>(tabs->count()) != leased_guest_documents_.size()) return false;
+  std::set<content::RenderFrameHost*> current;
+  for (int index = 0; index < tabs->count(); ++index) {
+    auto* contents = tabs->GetWebContentsAt(index);
+    if (!contents || contents->IsBeingDestroyed() || !contents->GetPrimaryMainFrame()) return false;
+    current.insert(contents->GetPrimaryMainFrame());
+  }
+  for (size_t index = 0; index < leased_guest_documents_.size(); ++index) {
+    auto* frame = leased_guest_documents_[index].AsRenderFrameHostIfValid();
+    if (!frame || !current.erase(frame) || !guest_leases_[index].is_bound()) return false;
+  }
+  if (!current.empty()) return false;
+  return true;
+}
+bool NativeGuestStageSession::ArmGuestDocuments() {
+  if (!StableShell()) return false;
+  auto* web_ui = ui_->web_ui();
+  auto* window = WebUIBrowserWindow::FromWebShellWebContents(web_ui->GetWebContents());
+  auto* tabs = window->browser()->GetTabStripModel();
+  auto* profile = Profile::FromWebUI(web_ui);
+  if (!tabs || tabs->count() < 1 || tabs->count() > 32) return false;
+  guest_leases_.clear(); leased_guest_documents_.clear();
+  pending_guest_leases_ = tabs->count();
+  for (int index = 0; index < tabs->count(); ++index) {
+    auto* contents = tabs->GetWebContentsAt(index);
+    auto* frame = contents ? contents->GetPrimaryMainFrame() : nullptr;
+    auto* identity = contents ? PageIdentity::FromWebContents(contents) : nullptr;
+    auto* widget = frame ? static_cast<content::RenderWidgetHostImpl*>(frame->GetRenderWidgetHost()) : nullptr;
+    auto* process = frame ? frame->GetProcess() : nullptr;
+    if (!contents || contents->IsBeingDestroyed() || contents->GetBrowserContext() != profile ||
+        !identity || identity->runtime_owned() || !frame || !frame->IsRenderFrameLive() ||
+        frame->IsErrorDocument() || !frame->IsInLifecycleState(content::RenderFrameHost::LifecycleState::kActive) ||
+        !widget || widget->GetRoutingID() <= 0 || !widget->GetFrameSinkId().is_valid() ||
+        !process || widget->GetProcess() != process || !process->GetProcess().IsValid()) return false;
+    auto grant = blink::mojom::NativeGuestDocumentFrameScope::New();
+    grant->document = static_cast<content::RenderFrameHostImpl*>(frame)->GetDocumentToken();
+    grant->request_nonce = scope_->request_nonce; grant->widget_routing_id = widget->GetRoutingID();
+    grant->renderer_pid = process->GetProcess().Pid(); grant->frame_sink = widget->GetFrameSinkId();
+    leased_guest_documents_.push_back(frame->GetWeakDocumentPtr());
+    guest_leases_.emplace_back();
+    auto receiver = guest_leases_.back().BindNewPipeAndPassReceiver();
+    guest_leases_.back().set_disconnect_handler(base::BindOnce(
+        [](base::WeakPtr<NativeGuestStageSession> session, uint64_t sequence) {
+          if (session && session->sequence_ == sequence && session->result_)
+            session->Refuse("guest_document_lease_disconnected");
+        }, weak_factory_.GetWeakPtr(), sequence_));
+    // Only the current native fixture's existing window tabs receive this
+    // private bound-widget grant. No public selector or new contents are made.
+    widget->BeginNativeGuestDocumentFrameForTesting(std::move(grant), std::move(receiver),
+        base::BindOnce(&NativeGuestStageSession::GuestDocumentArmed,
+                      weak_factory_.GetWeakPtr(), sequence_));
+    if (!result_) return false;
+  }
+  return true;
+}
+void NativeGuestStageSession::GuestDocumentArmed(uint64_t sequence, bool armed) {
+  if (!result_ || sequence != sequence_) return;
+  if (!armed || !pending_guest_leases_ || !StableGuestDocuments()) {
+    Refuse("guest_document_lease_refused"); return;
+  }
+  if (--pending_guest_leases_ == 0) StartShellMeasurement();
+}
+void NativeGuestStageSession::StartShellMeasurement() {
+  if (!result_ || !StableGuestDocuments()) { Refuse("stale_guest_document_lease"); return; }
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  if (!frame) { Refuse("stale_shell_document"); return; }
+  auto readiness = readiness_.BindNewPipeAndPassRemote();
+  readiness_.set_disconnect_handler(base::BindOnce(
+      [](base::WeakPtr<NativeGuestStageSession> session) {
+        if (session && session->result_ && !session->baseline_) session->Refuse("readiness_disconnected");
+      }, weak_factory_.GetWeakPtr()));
+  static_cast<content::RenderWidgetHostImpl*>(frame->GetRenderWidgetHost())
+      ->MeasureNativeGuestStageForTesting(scope_->Clone(), std::move(readiness),
+          input_control_.BindNewPipeAndPassReceiver(), base::BindOnce(
+              &NativeGuestStageSession::Submitted, weak_factory_.GetWeakPtr(), sequence_));
+}
+
+void NativeGuestStageSession::Ready(blink::mojom::NativeGuestStageScopePtr scope,
+    blink::mojom::NativeGuestStageWitnessPtr baseline, ReadyCallback accepted) {
+  const auto pages = baseline ? Pages(*baseline) : std::nullopt;
+  const auto owner = pages ? ReadNativeGuestStageOwnedSnapshot(ui_, *pages) : std::nullopt;
+  const bool valid = result_ && !baseline_ && scope && baseline && pages && owner && scope_ &&
+      SameScope(*scope_, *scope) && StableGuestDocuments() && NativeGuestStageGeometryMatches(*baseline, *owner) && baseline->document == scope_->shell_document &&
+      ((scope_->metric == blink::mojom::NativeGuestStageMetric::kSplitDrop && baseline->dragging && pages->empty()) ||
+       (scope_->metric == blink::mojom::NativeGuestStageMetric::kDividerFrame && !baseline->dragging &&
+        baseline->focused_divider && baseline->split_instance && baseline->geometry_generation && pages->size() >= 2) ||
+       (scope_->metric == blink::mojom::NativeGuestStageMetric::kTabSwitch && !baseline->dragging && pages->size() == 1));
+  if (valid) {
+    baseline_ = std::move(baseline); baseline_owner_ = *owner;
+    auto* catalog = TabCatalog::GetForProfile(Profile::FromWebUI(ui_->web_ui()));
+    for (const auto& page : *pages) {
+      auto* contents = catalog->FindPage(page.page_id);
+      baseline_documents_.push_back(contents->GetPrimaryMainFrame()->GetWeakDocumentPtr());
+    }
+  }
+  std::move(accepted).Run(valid);
+  if (!valid) Refuse("invalid_readiness");
+
+}
+void NativeGuestStageSession::Started(blink::mojom::NativeGuestStageScopePtr scope) {
+  if (!result_ || !prepared_ || !baseline_ || !scope_ || !scope ||
+      !SameScope(*scope_, *scope) || !StableGuestDocuments() || !StableBaselineSelection()) { Refuse("invalid_renderer_started"); return; }
+  renderer_started_ = true;
+  if (scope_->metric != blink::mojom::NativeGuestStageMetric::kTabSwitch)
+    pointer_input_ = std::make_unique<NativeGuestStagePointerInput>(ui_, base::BindRepeating(
+        &NativeGuestStageSession::ObserveNativeInput, weak_factory_.GetWeakPtr()));
+  std::move(prepared_).Run(scope_->Clone());
+}
+void NativeGuestStageSession::ObserveNativeInput(const gfx::NativeEvent& event) {
+  if (!result_ || !baseline_ || !renderer_started_ || !StableBaselineSelection()) return;
+  const auto actual = ReadNativePerformanceInput(event, base::BindRepeating(
+      [](base::WeakPtr<NativeGuestStageSession> session) -> std::optional<PerformanceTarget> {
+        if (!session || !session->StableShell()) return std::nullopt;
+        const auto& scope = *session->scope_;
+        return PerformanceTarget{scope.window_id, scope.shell_widget_routing_id,
+            scope.shell_renderer_pid, scope.native_document_generation};
+      }, weak_factory_.GetWeakPtr()));
+  if (!actual) return;
+  const auto expected = scope_->metric == blink::mojom::NativeGuestStageMetric::kSplitDrop
+      ? PerformanceInputKind::kLeftMouseUp : scope_->metric == blink::mojom::NativeGuestStageMetric::kDividerFrame
+      ? PerformanceInputKind::kLeftMouseDragged : PerformanceInputKind::kKeyDown;
+  if (actual->kind != expected) return;
+  if (input_) { Refuse("multiple_native_inputs"); return; }
+  input_ = *actual;
+}
+bool NativeGuestStageSession::DeferConsumedTabSwitch(const gfx::NativeEvent& event,
+    base::OnceClosure effect) {
+  if (effect.is_null() || !result_ || !baseline_ || !renderer_started_ || !StableBaselineSelection() ||
+      scope_->metric != blink::mojom::NativeGuestStageMetric::kTabSwitch || !input_control_.is_bound()) return false;
+  ObserveNativeInput(event);
+  if (!result_ || !input_) return false;
+  input_control_->ArmConsumedNativeInput(scope_->request_nonce, input_->event_ticks,
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(base::BindOnce(
+          [](base::WeakPtr<NativeGuestStageSession> session, base::OnceClosure effect, bool accepted) {
+            // ACK precedes measured mutation. Cancellation/disconnect refuses
+            // measurement but still invokes the caller's weak-window fenced
+            // real registered command exactly once, never a Chrome fallback.
+            if (session && session->result_ && (!accepted || !session->StableShell()))
+              session->Refuse("consumed_input_not_armed");
+            std::move(effect).Run();
+          }, weak_factory_.GetWeakPtr(), std::move(effect)), false));
+  return true;
+}
+void NativeGuestStageSession::Submitted(uint64_t sequence,
+    blink::mojom::NativeGuestStageSubmissionPtr sample) {
+  if (!result_ || sequence != sequence_) return;
+  if (!sample || !sample->scope || !sample->baseline || !sample->mutation_witness || !baseline_ ||
+      !input_ || !scope_ || !StableShell() || !SameScope(*scope_, *sample->scope) ||
+      !SameWitness(*baseline_, *sample->baseline) || !StableBaselineDocuments() || !sample->submitted || !sample->activated ||
+      !sample->submitted_frame || sample->submission_failure >= 0 || !sample->shell_frame_token ||
+      sample->input != input_->event_ticks || sample->input.is_null() ||
+      sample->input > sample->mutation || sample->mutation > sample->commit ||
+      sample->commit > sample->submitted_at || sample->submitted_at > base::TimeTicks::Now() ||
+      sample->mutation_witness->document != scope_->shell_document || sample->mutation_witness->dragging) {
+    Refuse("invalid_submission_pair"); return;
+  }
+  const auto pages = Pages(*sample->mutation_witness);
+  const auto owner = pages ? ReadNativeGuestStageOwnedSnapshot(ui_, *pages) : std::nullopt;
+  if (!owner || owner->guests.empty() || !NativeGuestStageGeometryMatches(*sample->mutation_witness, *owner)) { Refuse("unavailable_mutation_owner"); return; }
+  mutation_owner_ = *owner; submission_ = std::move(sample);
+  auto request = viz::mojom::NativeGuestInclusionScope::New();
+  request->display_sink = owner->display_sink; request->shell_sink = owner->shell_sink;
+  request->mutation_shell_token = submission_->shell_frame_token;
+  request->input = submission_->input; request->mutation = submission_->mutation;
+  request->shell_submission = submission_->submitted_at;
+  for (size_t i = 0; i < owner->guests.size(); ++i) {
+    const auto& guest = owner->guests[i];
+    const auto& page = submission_->mutation_witness->pages[i];
+    request->guests.push_back(guest.guest_surface);
+    request->shapes.push_back(viz::mojom::NativeGuestExpectedShape::New(
+        guest.guest_surface, *page->plugin_bounds_in_parent_pixels, page->pane_bounds, page->pane_radius));
+  }
+  auto* window = WebUIBrowserWindow::FromWebShellWebContents(ui_->web_ui()->GetWebContents());
+  window->widget()->GetCompositor()->MeasureNativeGuestInclusion(std::move(request), base::BindOnce(
+      &NativeGuestStageSession::Presented, weak_factory_.GetWeakPtr(), sequence_));
+}
+void NativeGuestStageSession::Presented(uint64_t sequence,
+    viz::mojom::NativeGuestInclusionResultPtr sample) {
+  if (!result_ || sequence != sequence_) return;
+  const auto pages = submission_ && submission_->mutation_witness ?
+      Pages(*submission_->mutation_witness) : std::nullopt;
+  const auto owner = pages ? ReadNativeGuestStageOwnedSnapshot(ui_, *pages) : std::nullopt;
+  std::vector<viz::SurfaceId> expected_surfaces;
+  if (owner) for (const auto& guest : owner->guests) expected_surfaces.push_back(guest.guest_surface);
+  const auto interval = sample && input_ ? ValidatedPresentationInterval(
+      input_->event_ticks, submission_->mutation, base::TimeTicks::Now(), sample->feedback) : std::nullopt;
+  if (!StableGuestDocuments() || !StableBaselineDocuments() || !mutation_owner_ || !owner || *owner != *mutation_owner_ || !sample ||
+      !sample->scope || !sample->measured || !sample->elapsed || !submission_ ||
+      sample->scope->display_sink != scope_->display_sink || sample->scope->shell_sink != scope_->shell_sink ||
+      sample->scope->mutation_shell_token != submission_->shell_frame_token ||
+      sample->scope->input != submission_->input || sample->scope->mutation != submission_->mutation ||
+      sample->scope->shell_submission != submission_->submitted_at ||
+      sample->scope->guests != expected_surfaces || sample->scope->shapes.size() != owner->guests.size() ||
+      !interval || sample->elapsed != interval) {
+    Refuse("invalid_presentation_pair"); return;
+  }
+  auto* catalog = TabCatalog::GetForProfile(Profile::FromWebUI(ui_->web_ui()));
+  for (size_t index = 0; index < owner->guests.size(); ++index) {
+    const auto& guest = owner->guests[index];
+    const auto& shape = sample->scope->shapes[index];
+    const auto& page = submission_->mutation_witness->pages[index];
+    if (!shape || shape->surface != guest.guest_surface ||
+        shape->inner_in_shell_pixels != *page->plugin_bounds_in_parent_pixels ||
+        shape->pane_in_shell_pixels != page->pane_bounds || shape->radius != page->pane_radius) {
+      Refuse("invalid_bound_pane_shape"); return;
+    }
+    auto* contents = catalog->FindPage(owner->identities[index].page_id);
+    bool matched = false;
+    for (const auto& drawn : sample->drawn)
+      matched |= contents && drawn && drawn->surface == guest.guest_surface &&
+          HasNativeGuestDocumentFrameForTesting(ui_, contents->GetWeakPtr(),
+              scope_->request_nonce, drawn->surface, drawn->token, drawn->surface_size);
+    if (!matched) { Refuse("guest_document_frame_not_included"); return; }
+  }
+  timeout_.Stop(); pointer_input_.reset(); guest_leases_.clear(); leased_guest_documents_.clear(); pending_guest_leases_ = 0; auto result = std::move(result_); readiness_.reset(); input_control_.reset();
+  std::move(result).Run(scope_->Clone(), std::move(submission_), std::move(sample), input_, "measured");
+}
+void NativeGuestStageSession::Refuse(const char* reason) {
+  // Move first: revoking the control pipe may synchronously invoke the default
+  // consumed-command callback. It must not recursively refuse this sample.
+  auto result = std::move(result_);
+  auto scope = scope_ ? scope_->Clone() : nullptr;
+  timeout_.Stop(); pointer_input_.reset(); guest_leases_.clear(); leased_guest_documents_.clear(); pending_guest_leases_ = 0; readiness_.reset(); input_control_.reset(); baseline_.reset(); scope_.reset();
+  baseline_owner_.reset(); baseline_documents_.clear(); mutation_owner_.reset(); renderer_started_ = false; prepared_.Reset(); auto input = input_; input_.reset();
+  if (result) std::move(result).Run(std::move(scope), std::move(submission_), nullptr, input, reason);
+}
+void NativeGuestStageSession::Cancel() { Refuse("cancelled"); }
+}  // namespace aux
+#endif
