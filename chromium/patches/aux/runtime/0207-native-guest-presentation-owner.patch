@@ -0,0 +1,45 @@
+// Copyright 2026 The Aux Authors
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_GUEST_PRESENTATION_FIXTURE_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_GUEST_PRESENTATION_FIXTURE_H_
+#include "build/build_config.h"
+#include "chrome/browser/buildflags.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include "base/values.h"
+#include "chrome/browser/ui/aux/native_guest_stage_session.h"
+namespace aux {
+// Fixed structured native records; these codec functions grant no authority.
+base::DictValue EncodeGuestPresentationReady(const blink::mojom::NativeGuestStageScope& scope);
+base::DictValue EncodeGuestPresentationComplete(
+    const blink::mojom::NativeGuestStageScope* scope,
+    const blink::mojom::NativeGuestStageSubmission* submission,
+    const viz::mojom::NativeGuestInclusionResult* presentation,
+    const std::optional<PerformanceInput>& input, const char* reason);
+// One private fixture sample on the actual controller. Prepare is zero-argument
+// per fixed metric; Complete is a one-use read/await, never a selector.
+class NativeGuestPresentationFixture final {
+ public:
+  using Reply = base::OnceCallback<void(base::DictValue)>;
+  explicit NativeGuestPresentationFixture(base::WeakPtr<WebUIBrowserUI> ui);
+  ~NativeGuestPresentationFixture();
+  void Prepare(blink::mojom::NativeGuestStageMetric metric, Reply ready);
+  void Complete(Reply completed);
+  bool DeferConsumedTabSwitch(const gfx::NativeEvent& event, base::OnceClosure effect);
+ private:
+  bool Stable() const;
+  void Ready(blink::mojom::NativeGuestStageScopePtr scope);
+  void Finished(blink::mojom::NativeGuestStageScopePtr scope,
+      blink::mojom::NativeGuestStageSubmissionPtr submission,
+      viz::mojom::NativeGuestInclusionResultPtr presentation,
+      std::optional<PerformanceInput> input, const char* reason);
+  base::WeakPtr<WebUIBrowserUI> ui_;
+  NativeGuestStageSession session_;
+  content::WeakDocumentPtr document_;
+  bool active_ = false;
+  Reply ready_;
+  Reply completed_;
+  std::optional<base::DictValue> record_;
+  base::WeakPtrFactory<NativeGuestPresentationFixture> weak_factory_{this};
+};
+}  // namespace aux
+#endif
+#endif
diff --git a/chrome/browser/ui/aux/native_guest_presentation_fixture_unittest.cc b/chrome/browser/ui/aux/native_guest_presentation_fixture_unittest.cc
