+namespace aux {
+TEST(EgressProjectionTest, MatchesRuntimeUnicodeWindowGolden) {
+  const auto normalized = EgressNormalize("ＡＢＣＤＥＦＧＨＩＪＫＬ");
+  ASSERT_TRUE(normalized);
+  EXPECT_EQ(*normalized, u"abcdefghijkl");
+  EXPECT_EQ(EgressWindows(*normalized, 12),
+            std::set<std::string>{EgressHash("abcdefghijkl")});
+  const auto whitespace = EgressNormalize("ABC\t\nDEF GHIJ");
+  ASSERT_TRUE(whitespace);
+  EXPECT_EQ(*whitespace, u"abc def ghij");
+}
+TEST(EgressProjectionTest, NativeBytesNeverAppearInWireAndHeadersChangeDigest) {
+  network::ResourceRequest request;
+  request.url = GURL("https://example.test/?q=query-secret-18391");
+  request.method = "POST";
+  request.request_body = base::MakeRefCounted<network::ResourceRequestBody>();
+  request.request_body->AppendCopyOfBytes(
+      base::as_byte_span(std::string_view("body-secret-28491")));
+  net::HttpRequestHeaders headers;
+  headers.SetHeader("Cookie", "sid=cookie-secret-29811");
+  auto first = ProjectEgressRequest(request, headers, true);
+  ASSERT_TRUE(first);
+  EXPECT_EQ(*first->wire.FindString("requestDigest"),
+            "441668bfbd03947f1fa979a3e7d95b1f99b6ca7d195d8f7f7524013d36396aff");
+  EXPECT_EQ(*first->wire.FindString("phase"), "send");
+  EXPECT_TRUE(first->wire.FindBool("headersComplete").value_or(false));
+  EXPECT_FALSE(first->wire.contains("bodyBase64"));
+  EXPECT_FALSE(first->wire.contains("headers"));
+  EXPECT_FALSE(first->wire.contains("url"));
+  headers.SetHeader("X-Custom", "mutation");
+  auto second = ProjectEgressRequest(request, headers, true);
+  ASSERT_TRUE(second);
+  EXPECT_NE(*first->wire.FindString("requestDigest"),
+            *second->wire.FindString("requestDigest"));
+  auto preflight = ProjectEgressRequest(request, headers, false);
+  ASSERT_TRUE(preflight);
+  EXPECT_FALSE(preflight->wire.FindBool("headersComplete").value_or(true));
+  EXPECT_NE(*second->wire.FindString("requestDigest"),
+            *preflight->wire.FindString("requestDigest"));
+}
+TEST(EgressProjectionTest, RejectsBinaryOversizeAndOpaqueBody) {
+  network::ResourceRequest request;
+  request.url = GURL("https://example.test/");
+  request.method = "POST";
+  request.request_body = base::MakeRefCounted<network::ResourceRequestBody>();
+  const std::string binary(1, static_cast<char>(255));
+  request.request_body->AppendCopyOfBytes(base::as_byte_span(binary));
+  EXPECT_FALSE(ProjectEgressRequest(request, {}, true));
+  request.request_body = base::MakeRefCounted<network::ResourceRequestBody>();
+  const std::string oversized(65537, 'x');
+  request.request_body->AppendCopyOfBytes(base::as_byte_span(oversized));
+  EXPECT_FALSE(ProjectEgressRequest(request, {}, true));
+  request.request_body = base::MakeRefCounted<network::ResourceRequestBody>();
+  request.request_body->AppendFileRange(base::FilePath("/tmp/egress-no-read"),
+                                        0, 4, base::Time());
+  EXPECT_FALSE(ProjectEgressRequest(request, {}, true));
+  request.request_body = nullptr;
+  net::HttpRequestHeaders headers;
+  headers.SetHeader("X-Large", std::string(16385, 'a'));
+  EXPECT_FALSE(ProjectEgressRequest(request, headers, true));
+}
