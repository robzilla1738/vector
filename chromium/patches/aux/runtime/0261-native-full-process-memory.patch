diff --git a/chrome/browser/ui/aux/native_process_footprint_unittest.cc b/chrome/browser/ui/aux/native_process_footprint_unittest.cc
new file mode 100644
index 0000000..cc7c017
--- /dev/null
+++ b/chrome/browser/ui/aux/native_process_footprint_unittest.cc
@@ -0,0 +1,25 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_process_footprint.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include "base/process/process_handle.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux {
+TEST(NativeProcessFootprintTest, CurrentKernelProcessHasStableIdentityAndPositiveFootprint) {
+  const auto before = ReadNativeProcessFootprint(base::GetCurrentProcId());
+  const auto after = ReadNativeProcessFootprint(base::GetCurrentProcId());
+  ASSERT_TRUE(before); ASSERT_TRUE(after);
+  EXPECT_EQ(before->pid, base::GetCurrentProcId());
+  EXPECT_EQ(before->process_uuid.size(), 32u);
+  EXPECT_EQ(before->process_uuid, after->process_uuid);
+  EXPECT_EQ(before->process_start_absolute, after->process_start_absolute);
+  EXPECT_GT(before->physical_bytes, 0u); EXPECT_GT(after->physical_bytes, 0u);
+  EXPECT_GT(before->process_start_absolute, 0u);
+  EXPECT_LE(before->sample_start, before->sample_end);
+  EXPECT_LE(before->sample_end, after->sample_start);
+}
+TEST(NativeProcessFootprintTest, InvalidProcessCannotSelectTheCallerOrAnEstimate) {
+  EXPECT_FALSE(ReadNativeProcessFootprint(0));
+  EXPECT_FALSE(ReadNativeProcessFootprint(-1));
+}
+}  // namespace aux
+#endif
diff --git a/chrome/browser/ui/aux/native_process_memory_sampler.cc b/chrome/browser/ui/aux/native_process_memory_sampler.cc
new file mode 100644
index 0000000..3f9beb2
--- /dev/null
+++ b/chrome/browser/ui/aux/native_process_memory_sampler.cc
@@ -0,0 +1,187 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_process_memory_sampler.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui_browser/webui_browser_ui.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+namespace aux {
+namespace {
+base::DictValue Refused(bool preparing = false) {
+  return base::DictValue().Set("producer", preparing ? "aux-native-subagent-preparation" : "aux-native-process-memory")
+      .Set("version", 1).Set("status", "refused");
+}
+base::ListValue Footprint(const NativeProcessFootprint& value, base::TimeTicks origin) {
+  // Exact integer offsets preserve kernel sampling times without repeated keys.
+  // The record's native sampleStartUs is the common TimeTicks origin.
+  return base::ListValue().Append(base::NumberToString(value.physical_bytes))
+      .Append(base::NumberToString((value.sample_start - origin).InMicroseconds()))
+      .Append(base::NumberToString((value.sample_end - origin).InMicroseconds()));
+}
+bool SameProcess(const NativeProcessFootprint& first, const NativeProcessFootprint& last) {
+  return first.pid == last.pid && first.process_uuid == last.process_uuid &&
+      first.process_start_absolute == last.process_start_absolute &&
+      first.sample_end <= last.sample_start;
+}
+}  // namespace
+NativeProcessMemorySampler::NativeProcessMemorySampler(base::WeakPtr<WebUIBrowserUI> ui)
+    : ui_(ui) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  owner_ = ReadNativeGuestStageShellOwner(ui_);
+  auto* shell = ui_ && ui_->web_ui() ? ui_->web_ui()->GetWebContents() : nullptr;
+  auto* frame = shell ? shell->GetPrimaryMainFrame() : nullptr;
+  auto* profile = ui_ && ui_->web_ui() ? Profile::FromWebUI(ui_->web_ui()) : nullptr;
+  if (!owner_ || !frame || !profile || profile->IsOffTheRecord()) { owner_.reset(); return; }
+  document_ = frame->GetWeakDocumentPtr();
+  host_ = AuxRuntimeHost::ForProfile(profile)->GetWeakPtr();
+}
+NativeProcessMemorySampler::~NativeProcessMemorySampler() {
+  timeout_.Stop(); weak_factory_.InvalidateWeakPtrs();
+  owner_.reset(); ui_.reset(); host_.reset();
+  if (pending_) std::move(pending_).Run(Refused(preparing_));
+}
+bool NativeProcessMemorySampler::Current() const {
+  auto* frame = document_.AsRenderFrameHostIfValid();
+  auto* shell = ui_ && ui_->web_ui() ? ui_->web_ui()->GetWebContents() : nullptr;
+  return owner_ && host_ && frame && shell && shell->GetPrimaryMainFrame() == frame &&
+      ReadNativeGuestStageShellOwner(ui_) == owner_;
+}
+bool NativeProcessMemorySampler::Begin(base::OnceCallback<void(base::DictValue)> callback, bool preparing) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (pending_ || sequence_ >= 4000 || !Current()) {
+    std::move(callback).Run(Refused(preparing)); return false;
+  }
+  pending_ = std::move(callback); preparing_ = preparing;
+  ++sequence_; sample_started_ = base::TimeTicks::Now();
+  timeout_.Start(FROM_HERE, base::Seconds(5),
+      base::BindOnce(&NativeProcessMemorySampler::Refuse, weak_factory_.GetWeakPtr()));
+  return true;
+}
+void NativeProcessMemorySampler::PrepareSubagents(base::OnceCallback<void(base::DictValue)> callback) {
+  if (!Begin(std::move(callback), true)) return;
+  host_->ReadPerformanceSubagentPreparation(
+      base::BindOnce(&NativeProcessMemorySampler::PreparationSampled, weak_factory_.GetWeakPtr()));
+}
+void NativeProcessMemorySampler::PreparationSampled(std::optional<RuntimeWorkload> preparation) {
+  if (!pending_) return;
+  if (!preparing_ || !Current() || !preparation || preparation->issued < sample_started_ ||
+      base::TimeTicks::Now() - sample_started_ > base::Seconds(5)) { Refuse(); return; }
+  auto record = base::DictValue().Set("producer", "aux-native-subagent-preparation")
+      .Set("version", 1).Set("status", "ready").Set("windowId", owner_->window_id)
+      .Set("widgetRoutingId", owner_->shell_widget_routing_id)
+      .Set("requestNonce", nonce_.ToString()).Set("sampleSequence", base::NumberToString(sequence_))
+      .Set("runtimePid", preparation->identity.pid)
+      .Set("runtimeConnectionGeneration", base::NumberToString(preparation->identity.connection_generation))
+      .Set("issuedUs", base::NumberToString(preparation->issued.since_origin().InMicroseconds()))
+      .Set("receivedUs", base::NumberToString(preparation->received.since_origin().InMicroseconds()))
+      .Set("preparation", std::move(preparation->record));
+  const auto json = base::WriteJson(record);
+  if (!json || json->size() > 12 * 1024) { Refuse(); return; }
+  Finish(std::move(record));
+}
+void NativeProcessMemorySampler::Sample(base::OnceCallback<void(base::DictValue)> callback) {
+  if (!Begin(std::move(callback), false)) return;
+  host_->ReadPerformanceProcessWorkload(
+      base::BindOnce(&NativeProcessMemorySampler::WorkloadBefore, weak_factory_.GetWeakPtr()));
+}
+void NativeProcessMemorySampler::WorkloadBefore(std::optional<RuntimeWorkload> workload) {
+  if (!pending_) return;
+  if (!Current() || !workload || workload->issued < sample_started_) { Refuse(); return; }
+  workload_before_ = std::move(workload);
+  before_ = ReadNativeBrowserMemorySample(ui_);
+  if (!before_ || before_->inventory.shell != *owner_ ||
+      before_->sample_start < workload_before_->received) { Refuse(); return; }
+  host_->ReadPerformanceProcessMemory(
+      base::BindOnce(&NativeProcessMemorySampler::RuntimeSampled, weak_factory_.GetWeakPtr()));
+}
+void NativeProcessMemorySampler::RuntimeSampled(std::optional<RuntimeMemory> memory) {
+  if (!pending_) return;
+  if (!Current() || !memory || !before_ || !workload_before_ ||
+      memory->identity != workload_before_->identity || memory->peer != workload_before_->peer ||
+      before_->inventory.processes.contains(memory->identity.pid) ||
+      memory->before.sample_start < before_->sample_end) { Refuse(); return; }
+  runtime_ = std::move(memory);
+  after_ = ReadNativeBrowserMemorySample(ui_);
+  if (!after_ || after_->inventory != before_->inventory ||
+      after_->sample_start < runtime_->after.sample_end || !Current()) { Refuse(); return; }
+  host_->ReadPerformanceProcessWorkload(
+      base::BindOnce(&NativeProcessMemorySampler::WorkloadAfter, weak_factory_.GetWeakPtr()));
+}
+void NativeProcessMemorySampler::WorkloadAfter(std::optional<RuntimeWorkload> workload) {
+  if (!pending_) return;
+  if (!Current() || !before_ || !after_ || !runtime_ || !workload_before_ || !workload ||
+      workload->identity != runtime_->identity || workload->peer != runtime_->peer ||
+      workload->issued < after_->sample_end || !SameProcess(runtime_->before, runtime_->after) ||
+      ReadNativeBrowserMemoryInventory(ui_) != before_->inventory ||
+      base::TimeTicks::Now() - sample_started_ > base::Seconds(5)) { Refuse(); return; }
+  auto first_identity = workload_before_->record.Clone();
+  auto last_identity = workload->record.Clone();
+  first_identity.Remove("observedAt"); last_identity.Remove("observedAt");
+  if (first_identity != last_identity ||
+      workload->record.FindDouble("observedAt") < workload_before_->record.FindDouble("observedAt")) {
+    Refuse(); return;
+  }
+  workload_after_ = std::move(workload);
+  const auto& identity = runtime_->identity;
+  base::ListValue processes;
+  for (const auto& entry : before_->inventory.processes) {
+    const auto& first = before_->footprints.at(entry.first);
+    const auto& last = after_->footprints.at(entry.first);
+    if (!SameProcess(first.before, last.after)) { Refuse(); return; }
+    base::ListValue host_ids;
+    for (int id : entry.second.host_ids) host_ids.Append(id);
+    base::ListValue readings;
+    readings.Append(Footprint(first.before, sample_started_)); readings.Append(Footprint(first.after, sample_started_));
+    readings.Append(Footprint(last.before, sample_started_)); readings.Append(Footprint(last.after, sample_started_));
+    processes.Append(base::ListValue().Append(entry.first).Append(entry.second.role)
+        .Append(entry.second.process_type).Append(std::move(host_ids))
+        .Append(first.before.process_uuid)
+        .Append(base::NumberToString(first.before.process_start_absolute))
+        .Append(std::move(readings)));
+  }
+  base::ListValue readings;
+  readings.Append(Footprint(runtime_->before, sample_started_)); readings.Append(Footprint(runtime_->after, sample_started_));
+  processes.Append(base::ListValue().Append(identity.pid).Append("runtime")
+      .Append(base::Value()).Append(base::ListValue())
+      .Append(runtime_->before.process_uuid)
+      .Append(base::NumberToString(runtime_->before.process_start_absolute))
+      .Append(std::move(readings)).Append(base::NumberToString(identity.connection_generation)));
+  auto record = base::DictValue().Set("producer", "aux-native-process-memory")
+      .Set("version", 1).Set("status", "sampled").Set("windowId", owner_->window_id)
+      .Set("widgetRoutingId", owner_->shell_widget_routing_id)
+      .Set("requestNonce", nonce_.ToString()).Set("sampleSequence", base::NumberToString(sequence_))
+      .Set("sampleStartUs", base::NumberToString(sample_started_.since_origin().InMicroseconds()))
+      .Set("sampleEndUs", base::NumberToString(base::TimeTicks::Now().since_origin().InMicroseconds()))
+      .Set("processes", std::move(processes))
+      // Both original records were compared before lossless compaction. Keep
+      // every common authority primitive and BOTH original observation times.
+      .Set("workload", std::move(first_identity))
+      .Set("workloadObservedAt", base::ListValue()
+          .Append(workload_before_->record.Find("observedAt")->Clone())
+          .Append(workload_after_->record.Find("observedAt")->Clone()))
+      .Set("workloadRequestTimes", base::ListValue()
+          .Append(base::NumberToString((workload_before_->issued - sample_started_).InMicroseconds()))
+          .Append(base::NumberToString((workload_before_->received - sample_started_).InMicroseconds()))
+          .Append(base::NumberToString((workload_after_->issued - sample_started_).InMicroseconds()))
+          .Append(base::NumberToString((workload_after_->received - sample_started_).InMicroseconds())));
+  const auto json = base::WriteJson(record);
+  if (!json || json->size() > 12 * 1024) { Refuse(); return; }
+  Finish(std::move(record));
+}
+void NativeProcessMemorySampler::Refuse() { if (pending_) Finish(Refused(preparing_)); }
+void NativeProcessMemorySampler::Finish(base::DictValue record) {
+  timeout_.Stop(); weak_factory_.InvalidateWeakPtrs();
+  before_.reset(); after_.reset(); runtime_.reset();
+  workload_before_.reset(); workload_after_.reset(); sample_started_ = {};
+  preparing_ = false;
+  auto callback = std::move(pending_);
+  std::move(callback).Run(std::move(record));
+}
+}  // namespace aux
+#endif
