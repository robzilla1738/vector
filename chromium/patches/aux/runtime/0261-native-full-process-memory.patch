diff --git a/chrome/browser/ui/aux/native_process_footprint.cc b/chrome/browser/ui/aux/native_process_footprint.cc
new file mode 100644
index 0000000..4a560a7
--- /dev/null
+++ b/chrome/browser/ui/aux/native_process_footprint.cc
@@ -0,0 +1,24 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_process_footprint.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <libproc.h>
+#include <sys/resource.h>
+#include <algorithm>
+#include "base/strings/string_number_conversions.h"
+namespace aux {
+std::optional<NativeProcessFootprint> ReadNativeProcessFootprint(base::ProcessId pid) {
+  if (pid <= 0) return std::nullopt;
+  rusage_info_v4 memory{};
+  const auto started = base::TimeTicks::Now();
+  if (proc_pid_rusage(pid, RUSAGE_INFO_V4,
+      reinterpret_cast<rusage_info_t*>(&memory)) != 0) return std::nullopt;
+  const auto completed = base::TimeTicks::Now();
+  if (!memory.ri_phys_footprint || !memory.ri_proc_start_abstime ||
+      memory.ri_proc_exit_abstime ||
+      std::ranges::all_of(memory.ri_uuid, [](uint8_t value) { return value == 0; }))
+    return std::nullopt;
+  return NativeProcessFootprint{pid, memory.ri_phys_footprint,
+      base::HexEncode(memory.ri_uuid), memory.ri_proc_start_abstime, started, completed};
+}
+}  // namespace aux
+#endif
