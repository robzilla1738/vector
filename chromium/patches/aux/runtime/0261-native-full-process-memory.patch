diff --git a/chrome/browser/ui/aux/native_browser_memory_sample.cc b/chrome/browser/ui/aux/native_browser_memory_sample.cc
new file mode 100644
index 0000000..5070cb6
--- /dev/null
+++ b/chrome/browser/ui/aux/native_browser_memory_sample.cc
@@ -0,0 +1,36 @@
+// Copyright 2026 The Aux Authors
+#include "chrome/browser/ui/aux/native_browser_memory_sample.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <utility>
+#include "content/public/browser/browser_thread.h"
+namespace aux {
+std::optional<NativeBrowserMemorySample> ReadNativeBrowserMemorySample(
+    base::WeakPtr<WebUIBrowserUI> ui) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const auto started = base::TimeTicks::Now();
+  const auto inventory = ReadNativeBrowserMemoryInventory(ui);
+  if (!inventory) return std::nullopt;
+  std::map<base::ProcessId, NativeProcessFootprint> initial;
+  for (const auto& entry : inventory->processes) {
+    const auto footprint = ReadNativeProcessFootprint(entry.first);
+    if (!footprint) return std::nullopt;
+    initial.emplace(entry.first, *footprint);
+  }
+  if (ReadNativeBrowserMemoryInventory(ui) != inventory) return std::nullopt;
+  NativeBrowserMemorySample sample{*inventory, started, {}, {}};
+  for (const auto& entry : inventory->processes) {
+    const auto footprint = ReadNativeProcessFootprint(entry.first);
+    const auto& before = initial.at(entry.first);
+    if (!footprint || footprint->pid != before.pid ||
+        footprint->process_uuid != before.process_uuid ||
+        footprint->process_start_absolute != before.process_start_absolute ||
+        footprint->sample_start < before.sample_end) return std::nullopt;
+    sample.footprints.emplace(entry.first,
+        NativeBracketedProcessFootprint{before, *footprint});
+  }
+  if (ReadNativeBrowserMemoryInventory(ui) != inventory) return std::nullopt;
+  sample.sample_end = base::TimeTicks::Now();
+  return sample;
+}
+}  // namespace aux
+#endif
