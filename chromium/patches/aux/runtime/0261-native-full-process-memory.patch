diff --git a/chrome/browser/ui/aux/native_runtime_memory_worker_unittest.cc b/chrome/browser/ui/aux/native_runtime_memory_worker_unittest.cc
new file mode 100644
index 0000000..6546b9b
--- /dev/null
+++ b/chrome/browser/ui/aux/native_runtime_memory_worker_unittest.cc
@@ -0,0 +1,334 @@
+// Copyright 2026 The Aux Authors
+// Genuine local socket/kernel source tests; not native performance qualification.
+#include "chrome/browser/ui/aux/runtime_host.h"
+#if BUILDFLAG(IS_MAC) && BUILDFLAG(AUX_ALLOW_REMOTE_DEBUGGING_FOR_TESTS)
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <cstring>
+#include <chrono>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include "base/command_line.h"
+#include "base/files/scoped_file.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/process/kill.h"
+#include "base/uuid.h"
+#include "base/test/task_environment.h"
+#include "base/test/multiprocess_test.h"
+#include "testing/multiprocess_func_list.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+// Distinct from AuxRuntimeHostPerformanceTestPeer in organization tests.
+// Installs only an actual connected test endpoint and its real OS peer process;
+// all fixed RPC serialization, response dispatch, peer and kernel checks remain
+// the genuine Worker production implementation.
+class AuxRuntimeHostMemoryTestPeer {
+ public:
+  using Worker = AuxRuntimeHost::Worker;
+  using Workload = AuxRuntimeHost::PerformanceProcessWorkload;
+  using Memory = AuxRuntimeHost::PerformanceProcessMemory;
+  static std::unique_ptr<Worker> Create(int connected_fd, base::Process process) {
+    auto worker = std::make_unique<Worker>(base::FilePath(), "disposable-source-test",
+        base::SequencedTaskRunner::GetCurrentDefault(), base::WeakPtr<AuxRuntimeHost>());
+    worker->connection_fd_ = connected_fd;
+    worker->connection_generation_ = 1;
+    worker->process_ = std::move(process);
+    return worker;
+  }
+  static void Read(Worker& worker, AuxRuntimeHost::PerformanceWorkloadCallback callback) {
+    worker.ReadPerformanceProcessWorkload(std::move(callback));
+  }
+  static void Prepare(Worker& worker, AuxRuntimeHost::PerformanceWorkloadCallback callback) {
+    worker.ReadPerformanceObservation(AuxRuntimeHost::PerformanceObservation::kPreparation, std::move(callback));
+  }
+  static std::optional<Memory> Kernel(Worker& worker) {
+    return worker.ReadPerformanceProcessMemory();
+  }
+  static bool Pump(Worker& worker) { return worker.Pump(); }
+  static bool Ready(Worker& worker) {
+    pollfd pending{worker.connection_fd_, POLLIN, 0};
+    return HANDLE_EINTR(poll(&pending, 1, 2000)) == 1 && (pending.revents & (POLLIN | POLLHUP));
+  }
+  static void Disconnect(Worker& worker) { worker.Disconnect(); }
+};
+
+namespace {
+std::optional<std::string> ReadLine(int fd) {
+  std::string frame;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+  for (size_t count = 0; count < 16384; ++count) {
+    pollfd pending{fd, POLLIN, 0};
+    const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now()).count();
+    if (remaining <= 0 || HANDLE_EINTR(poll(&pending, 1, static_cast<int>(remaining))) != 1 || !(pending.revents & POLLIN)) return std::nullopt;
+    char value;
+    if (HANDLE_EINTR(read(fd, &value, 1)) != 1) return std::nullopt;
+    if (value == '\n') return frame;
+    frame.push_back(value);
+  }
+  return std::nullopt;
+}
+bool SendLine(int fd, const std::string& line) {
+  const std::string frame = line + "\n";
+  return HANDLE_EINTR(write(fd, frame.data(), frame.size())) == static_cast<ssize_t>(frame.size());
+}
+}  // namespace
+
+MULTIPROCESS_TEST_MAIN(AuxNativeMemorySocketPeer) {
+  const auto path = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("aux-memory-test-socket");
+  constexpr int control = 4;
+  base::ScopedFD socket_fd(socket(AF_UNIX, SOCK_STREAM, 0));
+  if (!socket_fd.is_valid() || path.empty()) return 1;
+  const int no_sigpipe = 1;
+  if (setsockopt(socket_fd.get(), SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe)) != 0 ||
+      setsockopt(control, SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe)) != 0) return 9;
+  sockaddr_un address{}; address.sun_family = AF_UNIX;
+  if (path.size() >= sizeof(address.sun_path)) return 2;
+  std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+  if (connect(socket_fd.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) return 3;
+  // This is an owned child endpoint. Its real audit token/PID/kernel footprint,
+  // rather than the parent process or a synthetic identity, enter production.
+  for (int frame = 0; frame < 64; ++frame) {
+    pollfd pending[] = {{socket_fd.get(), POLLIN, 0}, {control, POLLIN, 0}};
+    if (HANDLE_EINTR(poll(pending, 2, 5000)) <= 0) return 4;
+    if (pending[0].revents & POLLIN) {
+      const auto request = ReadLine(socket_fd.get());
+      if (!request || !SendLine(control, *request)) return 5;
+    }
+    if (pending[1].revents & POLLIN) {
+      const auto reply = ReadLine(control);
+      if (!reply) return 6;
+      if (*reply == "CLOSE") return 0;
+      if (!SendLine(socket_fd.get(), *reply)) return 7;
+    }
+    if ((pending[0].revents | pending[1].revents) & (POLLERR | POLLHUP | POLLNVAL)) return 0;
+  }
+  return 8;
+}
+
+namespace {
+using Peer = AuxRuntimeHostMemoryTestPeer;
+struct Answer {
+  bool called = false;
+  std::optional<Peer::Workload> value;
+};
+base::OnceCallback<void(std::optional<Peer::Workload>)> Completion(Answer* answer) {
+  return base::BindOnce([](Answer* answer, std::optional<Peer::Workload> value) {
+    answer->called = true;
+    answer->value = std::move(value);
+  }, base::Unretained(answer));
+}
+base::DictValue Idle() {
+  return base::DictValue().Set("producer", "aux-runtime-subagent-workload")
+      .Set("version", 1).Set("status", "idle").Set("activeExecutions", 0)
+      .Set("observedAt", 1780000000000.0);
+}
+class NativeRuntimeMemoryWorkerTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(directory_.CreateUniqueTempDir());
+    base::ScopedFD listener(socket(AF_UNIX, SOCK_STREAM, 0));
+    ASSERT_TRUE(listener.is_valid());
+    const auto path = directory_.GetPath().Append("peer.sock").value();
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    ASSERT_LT(path.size(), sizeof(address.sun_path));
+    std::memcpy(address.sun_path, path.c_str(), path.size() + 1);
+    ASSERT_EQ(bind(listener.get(), reinterpret_cast<sockaddr*>(&address), sizeof(address)), 0);
+    ASSERT_EQ(listen(listener.get(), 1), 0);
+    int controls[2];
+    ASSERT_EQ(socketpair(AF_UNIX, SOCK_STREAM, 0, controls), 0);
+    peer_.reset(controls[0]); base::ScopedFD child_control(controls[1]);
+    auto command = base::GetMultiProcessTestChildBaseCommandLine();
+    command.AppendSwitchASCII("aux-memory-test-socket", path);
+    base::LaunchOptions options; options.fds_to_remap.emplace_back(child_control.get(), 4);
+    const int no_sigpipe = 1;
+    ASSERT_EQ(setsockopt(peer_.get(), SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe)), 0);
+    ASSERT_EQ(setsockopt(child_control.get(), SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe)), 0);
+    child_ = base::SpawnMultiProcessTestChild("AuxNativeMemorySocketPeer", command, options);
+    ASSERT_TRUE(child_.IsValid()); ASSERT_FALSE(child_.is_current());
+    pollfd pending{listener.get(), POLLIN, 0};
+    ASSERT_EQ(HANDLE_EINTR(poll(&pending, 1, 5000)), 1);
+    base::ScopedFD accepted(accept(listener.get(), nullptr, nullptr));
+    ASSERT_TRUE(accepted.is_valid());
+    ASSERT_EQ(setsockopt(accepted.get(), SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe)), 0);
+    worker_ = Peer::Create(accepted.release(), child_.Duplicate());
+  }
+  void TearDown() override {
+    if (worker_) Peer::Disconnect(*worker_);
+    else if (child_.IsValid()) child_.Terminate(0, false);
+    worker_.reset();
+    peer_.reset();
+    if (child_.IsValid()) {
+      int code = -1;
+      const bool reaped = base::WaitForMultiprocessTestChildExit(child_, base::Seconds(3), &code);
+      EXPECT_TRUE(reaped);
+      if (!reaped) {
+        // Preserve the failed assertion and the exact owned child until reaped.
+        base::TerminateMultiProcessTestChild(child_, base::Process::kResultCodeKilledBadMessage, false);
+        base::EnsureProcessTerminated(std::move(child_));
+      } else child_.Close();
+    }
+  }
+  std::optional<base::DictValue> Request() {
+    const auto frame = ReadLine(peer_.get());
+    auto parsed = frame ? base::JSONReader::Read(*frame, base::JSON_PARSE_RFC) : std::nullopt;
+    return parsed && parsed->is_dict() ? std::make_optional(parsed->GetDict().Clone()) : std::nullopt;
+  }
+  bool Reply(int id, base::DictValue result) {
+    const auto json = base::WriteJson(base::DictValue().Set("kind", "res")
+        .Set("id", id).Set("result", std::move(result)));
+    if (!json) return false;
+    return SendLine(peer_.get(), *json) && Peer::Ready(*worker_);
+  }
+  void CheckFixedRequest(const base::DictValue& request, const char* expected = "performance.subagentWorkload") {
+    const auto* method = request.FindString("method");
+    const auto* kind = request.FindString("kind");
+    const auto* params = request.FindDict("params");
+    ASSERT_NE(method, nullptr); ASSERT_NE(kind, nullptr); ASSERT_NE(params, nullptr);
+    EXPECT_EQ(*method, expected);
+    EXPECT_EQ(*kind, "req"); EXPECT_TRUE(params->empty());
+    EXPECT_FALSE(request.contains("desktopUser"));
+  }
+  base::test::TaskEnvironment environment_{base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  base::ScopedTempDir directory_;
+  base::ScopedFD peer_;
+  base::Process child_;
+  std::unique_ptr<Peer::Worker> worker_;
+  Answer first_, last_;
+};
+
+TEST_F(NativeRuntimeMemoryWorkerTest, FreshOriginalPeerRequestsBracketGenuineKernelReadings) {
+  Peer::Read(*worker_, Completion(&first_));
+  const auto first = Request(); ASSERT_TRUE(first); CheckFixedRequest(*first);
+  const auto first_id = first->FindInt("id"); ASSERT_TRUE(first_id);
+  ASSERT_TRUE(Reply(*first_id, Idle())); ASSERT_TRUE(Peer::Pump(*worker_));
+  ASSERT_TRUE(first_.called); ASSERT_TRUE(first_.value);
+  const auto memory = Peer::Kernel(*worker_); ASSERT_TRUE(memory);
+  EXPECT_EQ(memory->identity, first_.value->identity);
+  EXPECT_EQ(memory->peer, first_.value->peer);
+  EXPECT_EQ(memory->identity.pid, child_.Pid());
+  EXPECT_NE(memory->identity.pid, base::Process::Current().Pid());
+  EXPECT_GT(memory->before.physical_bytes, 0u);
+  EXPECT_GT(memory->after.physical_bytes, 0u);
+  EXPECT_EQ(memory->before.process_uuid, memory->after.process_uuid);
+  EXPECT_EQ(memory->before.process_start_absolute, memory->after.process_start_absolute);
+  EXPECT_LE(first_.value->received, memory->before.sample_start);
+  EXPECT_LE(memory->before.sample_end, memory->after.sample_start);
+  Peer::Read(*worker_, Completion(&last_));
+  const auto last = Request(); ASSERT_TRUE(last); CheckFixedRequest(*last);
+  const auto last_id = last->FindInt("id"); ASSERT_TRUE(last_id); EXPECT_NE(*last_id, *first_id);
+  auto second = Idle(); second.Set("observedAt", 1780000000001.0);
+  ASSERT_TRUE(Reply(*last_id, std::move(second))); ASSERT_TRUE(Peer::Pump(*worker_));
+  ASSERT_TRUE(last_.called); ASSERT_TRUE(last_.value);
+  EXPECT_EQ(last_.value->identity, memory->identity); EXPECT_EQ(last_.value->peer, memory->peer);
+  EXPECT_LE(memory->after.sample_end, last_.value->issued);
+  EXPECT_LE(last_.value->issued, last_.value->received);
+  EXPECT_EQ(first_.value->record.FindDouble("observedAt"), 1780000000000.0);
+  EXPECT_EQ(last_.value->record.FindDouble("observedAt"), 1780000000001.0);
+}
+TEST_F(NativeRuntimeMemoryWorkerTest, PriorAndWrongRequestIdsCannotCompleteFreshSecondObservation) {
+  Peer::Read(*worker_, Completion(&first_));
+  const auto first = Request(); ASSERT_TRUE(first);
+  const auto first_id = first->FindInt("id"); ASSERT_TRUE(first_id);
+  ASSERT_TRUE(Reply(*first_id + 100, Idle())); ASSERT_TRUE(Peer::Pump(*worker_));
+  EXPECT_FALSE(first_.called);
+  ASSERT_TRUE(Reply(*first_id, Idle())); ASSERT_TRUE(Peer::Pump(*worker_));
+  ASSERT_TRUE(first_.called); ASSERT_TRUE(first_.value);
+  Peer::Read(*worker_, Completion(&last_));
+  const auto last = Request(); ASSERT_TRUE(last);
+  const auto last_id = last->FindInt("id"); ASSERT_TRUE(last_id); ASSERT_NE(*last_id, *first_id);
+  ASSERT_TRUE(Reply(*first_id, Idle())); ASSERT_TRUE(Peer::Pump(*worker_));
+  EXPECT_FALSE(last_.called);
+  ASSERT_TRUE(Reply(*last_id, Idle())); ASSERT_TRUE(Peer::Pump(*worker_));
+  EXPECT_TRUE(last_.called); EXPECT_TRUE(last_.value);
+}
+TEST_F(NativeRuntimeMemoryWorkerTest, ClosedOriginalSocketRefusesOutstandingObservationAndKernel) {
+  Peer::Read(*worker_, Completion(&first_));
+  ASSERT_TRUE(Request());
+  ASSERT_TRUE(SendLine(peer_.get(), "CLOSE"));
+  ASSERT_TRUE(Peer::Ready(*worker_));
+  EXPECT_FALSE(Peer::Pump(*worker_));
+  ASSERT_TRUE(first_.called); EXPECT_FALSE(first_.value);
+  EXPECT_FALSE(Peer::Kernel(*worker_));
+}
+TEST_F(NativeRuntimeMemoryWorkerTest, DisconnectRetiresPendingBeforeReentrantObservation) {
+  Peer::Read(*worker_, base::BindOnce(
+      [](Peer::Worker* worker, Answer* first, Answer* last, std::optional<Peer::Workload> value) {
+        first->called = true; first->value = std::move(value);
+        Peer::Read(*worker, Completion(last));
+      }, base::Unretained(worker_.get()), base::Unretained(&first_), base::Unretained(&last_)));
+  ASSERT_TRUE(Request());
+  Peer::Disconnect(*worker_);
+  ASSERT_TRUE(first_.called); EXPECT_FALSE(first_.value);
+  ASSERT_TRUE(last_.called); EXPECT_FALSE(last_.value);
+  EXPECT_FALSE(Peer::Kernel(*worker_));
+}
+TEST_F(NativeRuntimeMemoryWorkerTest, ResponseAfterFiveSecondReceiptBoundCannotAttestFreshness) {
+  Peer::Read(*worker_, Completion(&first_));
+  const auto request = Request(); ASSERT_TRUE(request);
+  const auto id = request->FindInt("id"); ASSERT_TRUE(id);
+  environment_.FastForwardBy(base::Seconds(6));
+  ASSERT_TRUE(Reply(*id, Idle())); ASSERT_TRUE(Peer::Pump(*worker_));
+  ASSERT_TRUE(first_.called); EXPECT_FALSE(first_.value);
+}
+TEST_F(NativeRuntimeMemoryWorkerTest, FixedPreparationRetainsOriginalReadyAndRefusesOtherStatusesOrProducers) {
+  for (int index = 0; index < 3; ++index) {
+    first_ = {};
+    Peer::Prepare(*worker_, Completion(&first_));
+    const auto request = Request(); ASSERT_TRUE(request);
+    CheckFixedRequest(*request, "performance.subagentPreparation");
+    const auto id = request->FindInt("id"); ASSERT_TRUE(id);
+    auto record = Idle();
+    if (index != 1) record.Set("producer", "aux-runtime-subagent-preparation");
+    if (index == 0) { record.Set("status", "refused"); record.Remove("observedAt"); }
+    if (index == 2) {
+      record.Set("status", "ready"); record.Remove("activeExecutions");
+      record.Set("parentRunId", base::Uuid::GenerateRandomV4().AsLowercaseString());
+      record.Set("taskId", base::Uuid::GenerateRandomV4().AsLowercaseString());
+      record.Set("workspaceId", base::Uuid::GenerateRandomV4().AsLowercaseString());
+      record.Set("taskRevision", 1); record.Set("deadlineAt", 1780000180000.0);
+      base::ListValue pages;
+      for (int page = 0; page < 5; ++page) {
+        pages.Append(base::DictValue().Set("pageId", base::Uuid::GenerateRandomV4().AsLowercaseString())
+            .Set("sessionId", base::Uuid::GenerateRandomV4().AsLowercaseString()).Set("documentEpoch", 1)
+            .Set("sourcePageId", base::Uuid::GenerateRandomV4().AsLowercaseString())
+            .Set("sourceSessionId", base::Uuid::GenerateRandomV4().AsLowercaseString()).Set("sourceDocumentEpoch", 1));
+      }
+      record.Set("pages", std::move(pages));
+    }
+    const auto original = record.Clone();
+    ASSERT_TRUE(Reply(*id, std::move(record))); ASSERT_TRUE(Peer::Pump(*worker_));
+    ASSERT_TRUE(first_.called);
+    if (index == 2) { ASSERT_TRUE(first_.value); EXPECT_EQ(first_.value->record, original); EXPECT_EQ(first_.value->identity.pid, child_.Pid()); }
+    else EXPECT_FALSE(first_.value);
+  }
+}
+TEST_F(NativeRuntimeMemoryWorkerTest, RefusedUnknownOrOversizedOriginalRecordsNeverBecomeMemoryProof) {
+  for (int index = 0; index < 8; ++index) {
+    first_ = {};
+    Peer::Read(*worker_, Completion(&first_));
+    const auto request = Request(); ASSERT_TRUE(request);
+    const auto id = request->FindInt("id"); ASSERT_TRUE(id);
+    auto record = Idle();
+    if (index == 0) record.Set("status", "refused");
+    if (index == 1) record.Set("producer", "foreign-producer");
+    if (index == 2) record.Set("padding", std::string(8193, 'x'));
+    if (index == 3) record.Set("observedAt", "untrusted-string");
+    if (index == 4) record.Set("observedAt", 1.5);
+    if (index == 5) record.Set("observedAt", 9007199254740992.0);
+    if (index == 6) record.Set("observedAt", -1);
+    if (index == 7) record.Remove("observedAt");
+    ASSERT_TRUE(Reply(*id, std::move(record))); ASSERT_TRUE(Peer::Pump(*worker_));
+    ASSERT_TRUE(first_.called); EXPECT_FALSE(first_.value);
+  }
+}
