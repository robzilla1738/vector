+        return NativeResult(base::Value(std::move(result)));
+      }
+      if (content::WebContents* active =
+              target->GetTabStripModel()->GetActiveWebContents()) {
+        previous_target_page_id =
+            aux::PageIdentity::GetOrCreate(profile_, active);
+      }
+    }
+
+    // Chromium's own transfer path preserves the TabModel, group and split
+    // metadata. The Aux page identity remains attached to the WebContents.
+    if (target) {
+      chrome::MoveTabsToExistingWindow(source, target, {source_index});
+    } else {
+      if (!chrome::CanMoveTabsToNewWindow(source, {source_index})) {
+        return NativeFault("conflict", "This window has no other tab to leave behind");
