+        source_active = active->Clone();
+      }
+      if (*id == destination_window_id && active) {
+        destination_active = active->Clone();
+      }
+    }
+    result.Set("sourceActivePageId", std::move(source_active));
+    result.Set("activePageId", std::move(destination_active));
+    return NativeResult(base::Value(std::move(result)));
+  }
