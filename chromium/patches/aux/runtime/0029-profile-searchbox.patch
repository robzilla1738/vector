@@ -0,0 +1,54 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/profile_search_engine.h"
+
+#include "chrome/browser/search_engines/template_url_service_test_util.h"
+#include "components/search_engines/template_url_service.h"
+#include "content/public/test/browser_task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aux {
+namespace {
+
+class ProfileSearchEngineTest : public testing::Test {
+ protected:
+  content::BrowserTaskEnvironment task_environment_;
+  TemplateURLServiceTestUtil search_service_;
+};
+
+TEST_F(ProfileSearchEngineTest, SelectsAndResolvesProfileDefault) {
+  search_service_.VerifyLoad();
+  ASSERT_EQ(ProfileSearchEngine::Set(search_service_.profile(),
+                                     "https://search.example/?q=%s"),
+            ProfileSearchEngine::SetResult::kOk);
+  EXPECT_EQ(ProfileSearchEngine::CurrentTemplate(search_service_.profile()),
+            "https://search.example/?q=%s");
+  EXPECT_EQ(ProfileSearchEngine::Resolve(search_service_.profile(),
+                                         "aux browser"),
+            "https://search.example/?q=aux+browser");
+  ASSERT_EQ(ProfileSearchEngine::Set(search_service_.profile(),
+                                     "https://other.example/?a=%s&b=%s"),
+            ProfileSearchEngine::SetResult::kOk);
+  EXPECT_EQ(ProfileSearchEngine::CurrentTemplate(search_service_.profile()),
+            "https://other.example/?a=%s&b=%s");
+}
+
+TEST_F(ProfileSearchEngineTest, RejectsUnsafeTemplatesWithoutChangingDefault) {
+  search_service_.VerifyLoad();
+  ASSERT_EQ(ProfileSearchEngine::Set(search_service_.profile(),
+                                     "https://search.example/?q=%s"),
+            ProfileSearchEngine::SetResult::kOk);
+  for (const char* candidate : {"javascript:alert(%s)",
+                                "https://user:pass@example.com/?q=%s",
+                                "https://%s.example.com/"}) {
+    EXPECT_EQ(ProfileSearchEngine::Set(search_service_.profile(), candidate),
+              ProfileSearchEngine::SetResult::kInvalid);
+  }
+  EXPECT_EQ(ProfileSearchEngine::CurrentTemplate(search_service_.profile()),
+            "https://search.example/?q=%s");
+}
+
+}  // namespace
+}  // namespace aux
