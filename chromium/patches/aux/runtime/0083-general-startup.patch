   const base::ListValue* list = &args;
+  if (method == "startupPreferences") {
+    auto* profile = browser_->GetProfile();
+    if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+      std::move(callback).Run(false, "", "forbidden",
+                              "Startup preferences require a regular profile");
+      return;
+    }
+    auto* prefs = profile->GetPrefs();
+    const bool managed = SessionStartupPref::TypeIsManaged(prefs) ||
+                         SessionStartupPref::URLsAreManaged(prefs);
+    if (!list->empty()) {
+      if (managed) {
+        std::move(callback).Run(false, "", "forbidden",
+                                "Startup preferences are managed by policy");
+        return;
+      }
+      const base::DictValue& input = (*list)[0].GetDict();
+      const std::string* mode = input.FindString("mode");
+      const base::ListValue* urls = input.FindList("urls");
+      if (!mode || !urls || urls->size() > 20) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Invalid startup preferences");
+        return;
+      }
+      SessionStartupPref::Type type;
+      if (*mode == "new-tab") {
+        type = SessionStartupPref::DEFAULT;
+      } else if (*mode == "continue") {
+        type = SessionStartupPref::LAST;
+      } else if (*mode == "pages") {
+        type = SessionStartupPref::URLS;
+      } else if (*mode == "continue-and-pages") {
+        type = SessionStartupPref::LAST_AND_URLS;
+      } else {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Unknown startup mode");
+        return;
+      }
+      if ((type == SessionStartupPref::URLS ||
+           type == SessionStartupPref::LAST_AND_URLS) && urls->empty()) {
+        std::move(callback).Run(false, "", "invalid_argument",
+                                "Add a startup page first");
+        return;
+      }
+      SessionStartupPref next(type);
+      for (const base::Value& value : *urls) {
+        if (!value.is_string()) {
+          std::move(callback).Run(false, "", "invalid_argument",
+                                  "Invalid startup page");
+          return;
+        }
+        const GURL url(value.GetString());
+        if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+            !url.username().empty() || !url.password().empty() ||
+            url.spec().size() > 2048) {
+          std::move(callback).Run(false, "", "invalid_argument",
+                                  "Startup pages must be ordinary web URLs");
+          return;
+        }
+        next.urls.push_back(url);
+      }
+      SessionStartupPref::SetStartupPref(profile, next);
+    }
+    const SessionStartupPref current = SessionStartupPref::GetStartupPref(profile);
+    base::DictValue result;
+    switch (current.type) {
+      case SessionStartupPref::DEFAULT:
+        result.Set("mode", "new-tab");
+        break;
+      case SessionStartupPref::LAST:
+        result.Set("mode", "continue");
+        break;
+      case SessionStartupPref::URLS:
+        result.Set("mode", "pages");
+        break;
+      case SessionStartupPref::LAST_AND_URLS:
+        result.Set("mode", "continue-and-pages");
+        break;
+    }
+    base::ListValue saved_urls;
+    for (const GURL& url : current.urls)
