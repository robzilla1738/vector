+void ChromeContentBrowserClient::OnNativeManualDocumentPictureInPicture(
+    content::RenderFrameHost& frame) {
+#if BUILDFLAG(ENABLE_AUX_SHELL) && !BUILDFLAG(IS_ANDROID)
+  auto* contents = content::WebContents::FromRenderFrameHost(&frame);
+  if (!contents || !frame.IsActive() || !frame.IsRenderFrameLive() ||
+      contents->GetPrimaryMainFrame() != &frame) {
+    return;
+  }
+  if (auto* helper = AutoPictureInPictureTabHelper::FromWebContents(contents)) {
+    helper->OnNativeManualDocumentPictureInPicture(frame);
+  }
+#endif
+}
