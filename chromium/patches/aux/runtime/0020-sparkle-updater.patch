+def _aux_sparkle_parts(config):
+    """Nested Sparkle code must be signed from the inside out."""
+    prefix = '{.app_product}.app/Contents/Frameworks/Sparkle.framework'.format(
+        config
+    )
+    options = CodeSignOptions.FULL_HARDENED_RUNTIME_OPTIONS
+    verify = VerifyOptions.STRICT
+    return {
+        'aux-sparkle-installer': CodeSignedProduct(
+            prefix + '/Versions/B/XPCServices/Installer.xpc',
+            'org.sparkle-project.InstallerLauncher',
+            options=options, verify_options=verify,
+        ),
+        'aux-sparkle-downloader': CodeSignedProduct(
+            prefix + '/Versions/B/XPCServices/Downloader.xpc',
+            'org.sparkle-project.DownloaderService',
+            options=options, verify_options=verify,
+        ),
+        'aux-sparkle-autoupdate': CodeSignedProduct(
+            prefix + '/Versions/B/Autoupdate',
+            'org.sparkle-project.Autoupdate',
+            options=options, verify_options=verify,
+            sign_with_identifier=True,
+        ),
+        'aux-sparkle-updater': CodeSignedProduct(
+            prefix + '/Versions/B/Updater.app',
+            'org.sparkle-project.Sparkle.Updater',
+            options=options, verify_options=verify,
+        ),
+        'aux-sparkle-framework': CodeSignedProduct(
+            prefix, 'org.sparkle-project.Sparkle',
+            options=options, verify_options=VerifyOptions.DEEP | verify,
+        ),
+    }
+
+
