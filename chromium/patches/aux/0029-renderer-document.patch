+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_AUTO_PIP_SITE_POLICY_H_
+#define CHROME_BROWSER_UI_AUX_AUTO_PIP_SITE_POLICY_H_
+#include <string_view>
+namespace aux {
+enum class AutoPipSitePolicy { kDefault, kNever, kEvenInaudible };
+inline AutoPipSitePolicy AutoPipPolicyForHost(std::string_view host) {
+  const auto matches = [host](std::string_view suffix) {
+    return host == suffix || (host.size() > suffix.size() &&
+        host[host.size() - suffix.size() - 1] == '.' && host.ends_with(suffix));
+  };
+  if (matches("slack.com") || matches("meet.google.com") ||
+      matches("teams.microsoft.com") || matches("teams.live.com"))
+    return AutoPipSitePolicy::kNever;
+  return matches("youtube.com") ? AutoPipSitePolicy::kEvenInaudible : AutoPipSitePolicy::kDefault;
+}
+}  // namespace aux
+#endif  // CHROME_BROWSER_UI_AUX_AUTO_PIP_SITE_POLICY_H_
