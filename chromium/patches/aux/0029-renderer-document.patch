+
+#include "chrome/browser/ui/aux/webmcp.h"
+
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/aux/tab_catalog.h"
+#include "content/public/browser/document_script_tools.h"
+#include "content/public/browser/web_contents.h"
+
+namespace aux {
+namespace {
+
+base::DictValue Fault(std::string code, std::string message) {
+  base::DictValue error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::DictValue reply;
+  reply.Set("error", std::move(error));
+  return reply;
+}
+
+base::DictValue Result(base::DictValue result) {
+  base::DictValue reply;
+  reply.Set("result", std::move(result));
+  return reply;
+}
+
+content::WebContents* PageContents(Profile* profile,
+                                   const base::DictValue& params,
+                                   base::DictValue* fault) {
+  if (!profile || profile->IsOffTheRecord()) {
+    *fault = Fault("capability_unsupported",
+                   "WebMCP is not available in a private window");
+    return nullptr;
+  }
+  const std::string* page_id = params.FindString("pageId");
+  if (!page_id || page_id->empty()) {
+    *fault = Fault("invalid_argument", "WebMCP requires a page");
+    return nullptr;
+  }
+  TabCatalog* catalog = TabCatalog::GetForProfile(profile);
+  content::WebContents* contents = catalog ? catalog->FindPage(*page_id) : nullptr;
+  if (!contents) {
+    *fault = Fault("not_found", "Page is not open");
+    return nullptr;
+  }
+  if (contents->GetBrowserContext()->IsOffTheRecord()) {
+    *fault = Fault("capability_unsupported",
+                   "WebMCP is not available in a private window");
+    return nullptr;
+  }
+  return contents;
+}
+
+}  // namespace
+
+void ListWebmcpTools(Profile* profile,
+                     const base::DictValue& params,
+                     base::OnceCallback<void(base::DictValue)> callback) {
+  base::DictValue fault;
+  content::WebContents* contents = PageContents(profile, params, &fault);
+  if (!contents) {
+    std::move(callback).Run(std::move(fault));
+    return;
+  }
+  base::ListValue tools;
+  for (const content::DocumentScriptTool& tool :
+       content::ListDocumentScriptTools(contents)) {
+    base::DictValue item;
+    item.Set("name", tool.name);
+    item.Set("description", tool.description);
+    if (tool.title) {
+      item.Set("title", *tool.title);
+    }
+    item.Set("readOnly", tool.read_only);
+    item.Set("consequential", tool.consequential);
+    tools.Append(std::move(item));
+  }
+  base::DictValue result;
+  result.Set("tools", std::move(tools));
+  std::move(callback).Run(Result(std::move(result)));
+}
+
+void CallWebmcpTool(Profile* profile,
+                    const base::DictValue& params,
+                    base::OnceCallback<void(base::DictValue)> callback) {
+  base::DictValue fault;
+  content::WebContents* contents = PageContents(profile, params, &fault);
+  if (!contents) {
+    std::move(callback).Run(std::move(fault));
+    return;
+  }
+  const std::string* name = params.FindString("name");
+  const std::string* input = params.FindString("input");
+  if (!name || name->empty() || !input) {
+    std::move(callback).Run(Fault("invalid_argument", "WebMCP call requires a tool name and input"));
+    return;
+  }
+  content::ExecuteDocumentScriptTool(
+      contents, *name, *input,
+      base::BindOnce(
+          [](base::OnceCallback<void(base::DictValue)> callback,
+             std::optional<std::string> tool_result, bool success) {
+            base::DictValue result;
+            if (tool_result) {
+              result.Set("result", *tool_result);
+            } else {
+              result.Set("result", base::Value());
+            }
+            result.Set("success", success);
+            std::move(callback).Run(Result(std::move(result)));
+          },
+          std::move(callback)));
+}
+
+}  // namespace aux
