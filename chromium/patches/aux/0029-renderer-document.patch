--- /dev/null
+++ b/chrome/renderer/aux_zap_stylesheet_registry.h
@@ -0,0 +1,101 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_RENDERER_AUX_ZAP_STYLESHEET_REGISTRY_H_
+#define CHROME_RENDERER_AUX_ZAP_STYLESHEET_REGISTRY_H_
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <string>
+
+// Renderer processes belong to one BrowserContext. Keep exact-origin styles
+// for inherited-origin documents (about:blank and blob) which may be created
+// without a network navigation. The browser provides monotonic sequence
+// numbers; a late message cannot restore a revoked style.
+class AuxZapStylesheetRegistry {
+ public:
+  enum class Result { kAccepted, kStale, kCapacity };
+  using Clock = std::chrono::steady_clock;
+
+  AuxZapStylesheetRegistry();
+  ~AuxZapStylesheetRegistry();
+
+  Result Update(const std::string& origin,
+                uint64_t sequence,
+                const std::string& stylesheet,
+                Clock::time_point now) {
+    Prune(now);
+    auto it = entries_.find(origin);
+    if (it == entries_.end() && stylesheet.empty() && sequence == 0) {
+      return Result::kAccepted;
+    }
+    if (it != entries_.end()) {
+      if (sequence < it->second.sequence ||
+          (sequence == it->second.sequence &&
+           stylesheet != it->second.stylesheet)) {
+        return Result::kStale;
+      }
+    }
+    if (!stylesheet.empty() &&
+        (it == entries_.end() || it->second.stylesheet.empty()) &&
+        live_styles_ >= kMaxLiveStyles) {
+      return Result::kCapacity;
+    }
+    if (it == entries_.end()) {
+      if (stylesheet.empty() && tombstones_ >= kMaxTombstones) {
+        return Result::kCapacity;
+      }
+      it = entries_.emplace(origin, Entry{}).first;
+    } else if (it->second.stylesheet.empty()) {
+      --tombstones_;
+    } else {
+      --live_styles_;
+    }
+    it->second = {
+        sequence, stylesheet,
+        stylesheet.empty() ? now + kTombstoneLifetime : Clock::time_point{}};
+    if (stylesheet.empty()) {
+      ++tombstones_;
+    } else {
+      ++live_styles_;
+    }
+    return Result::kAccepted;
+  }
+
+  const std::string* Find(const std::string& origin) const {
+    auto it = entries_.find(origin);
+    return it == entries_.end() || it->second.stylesheet.empty()
+               ? nullptr
+               : &it->second.stylesheet;
+  }
+
+ private:
+  struct Entry {
+    uint64_t sequence = 0;
+    std::string stylesheet;
+    Clock::time_point expires_at;
+  };
+  static constexpr size_t kMaxLiveStyles = 512;
+  static constexpr size_t kMaxTombstones = 5000;
+  static constexpr auto kTombstoneLifetime = std::chrono::seconds(30);
+
+  void Prune(Clock::time_point now) {
+    for (auto it = entries_.begin(); it != entries_.end();) {
+      if (it->second.stylesheet.empty() && it->second.expires_at <= now) {
+        it = entries_.erase(it);
+        --tombstones_;
+      } else {
+        ++it;
+      }
+    }
+  }
+
+  std::map<std::string, Entry> entries_;
+  size_t live_styles_ = 0;
+  size_t tombstones_ = 0;
+};
+
+#endif  // CHROME_RENDERER_AUX_ZAP_STYLESHEET_REGISTRY_H_
