+const char kZapControllerKey = 0;
+constexpr size_t kMaxStylesheetBytes = 80000;
+
+base::DictValue Fault(const std::string& message) {
+  base::DictValue error;
+  error.Set("code", "invalid_argument");
+  error.Set("message", message);
+  base::DictValue response;
+  response.Set("error", std::move(error));
+  return response;
+}
+
+std::string Hash(const std::string& stylesheet) {
+  return base::ToLowerASCII(
+      base::HexEncode(crypto::SHA256HashString(stylesheet)));
+}
+
+}  // namespace
+
+struct ZapController::FrameRequest {
+  mojo::AssociatedRemote<chrome::mojom::ChromeRenderFrame> remote;
+  FrameCallback callback;
+};
+
+ZapController* ZapController::ForProfile(Profile* profile) {
+  if (!profile) {
+    return nullptr;
+  }
+  auto* controller =
+      static_cast<ZapController*>(profile->GetUserData(&kZapControllerKey));
+  if (!controller) {
+    auto created = std::unique_ptr<ZapController>(new ZapController(profile));
+    controller = created.get();
+    profile->SetUserData(&kZapControllerKey, std::move(created));
+  }
+  return controller;
+}
+
+ZapController::ZapController(Profile* profile) : profile_(profile) {}
+ZapController::~ZapController() = default;
+
+bool ZapController::Validate(const base::DictValue& request) const {
+  const std::string* profile_id = request.FindString("profileId");
+  const std::string* origin = request.FindString("origin");
+  const std::string* stylesheet = request.FindString("stylesheet");
+  const std::string* hash = request.FindString("stylesheetSha256");
+  const std::string* phase = request.FindString("phase");
+  const std::string* scope = request.FindString("frameScope");
+  const std::optional<int> revision = request.FindInt("revision");
+  if (!profile_id ||
+      *profile_id != profile_->GetPath().BaseName().AsUTF8Unsafe() || !origin ||
+      !stylesheet || !hash || !phase || !scope || !revision || *revision < 0 ||
+      stylesheet->size() > kMaxStylesheetBytes || *phase != "document_start" ||
+      *scope != "matching_origin" || Hash(*stylesheet) != *hash) {
+    return false;
+  }
+  const GURL url(*origin);
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() &&
+         url::Origin::Create(url).Serialize() == *origin;
+}
+
+void ZapController::EnsureReady(ReadyCallback callback) {
+  if (ready_) {
+    std::move(callback).Run(true);
+    return;
+  }
+  if (profile_->IsOffTheRecord()) {
+    ready_ = true;
+    std::move(callback).Run(true);
+    return;
+  }
+  pending_ready_.push_back(std::move(callback));
+  if (loading_) {
+    return;
+  }
+  loading_ = true;
+  AuxRuntimeHost* host = AuxRuntimeHost::ForProfile(profile_);
+  if (!host) {
+    loading_ = false;
+    auto callbacks = std::move(pending_ready_);
+    for (auto& pending : callbacks) {
+      std::move(pending).Run(false);
+    }
+    return;
+  }
+  base::DictValue params;
+  params.Set("profileId", profile_->GetPath().BaseName().AsUTF8Unsafe());
+  const auto params_json = base::WriteJson(params);
+  host->CallInternal(
+      "zap.snapshot", *params_json,
+      base::BindOnce(
+          [](base::WeakPtr<ZapController> owner,
+             AuxRuntimeHost::Response response) {
+            if (!owner) {
+              return;
+            }
+            bool valid = response.ok;
+            std::map<std::string, Policy> policies;
+            const auto parsed =
+                valid ? base::JSONReader::Read(response.result_json,
+                                               base::JSON_PARSE_RFC)
+                      : std::nullopt;
+            const base::ListValue* list =
+                parsed ? parsed->GetIfList() : nullptr;
+            valid = list && list->size() <= 100;
+            if (valid) {
+              for (const base::Value& value : *list) {
+                const base::DictValue* request = value.GetIfDict();
+                if (!request || !owner->Validate(*request)) {
+                  valid = false;
+                  break;
+                }
+                const std::string& origin = *request->FindString("origin");
+                if (!policies
+                         .emplace(
+                             origin,
+                             Policy{*request->FindInt("revision"),
+                                    *request->FindString("stylesheet"),
+                                    *request->FindString("stylesheetSha256")})
+                         .second) {
+                  valid = false;
+                  break;
+                }
+              }
+            }
+            if (valid) {
+              owner->policies_ = std::move(policies);
+              for (const auto& [origin, policy] : owner->policies_) {
+                owner->sequence_by_origin_[origin] = ++owner->next_sequence_;
+              }
+              owner->ready_ = true;
+            }
+            owner->loading_ = false;
+            auto callbacks = std::move(owner->pending_ready_);
+            for (auto& pending : callbacks) {
+              std::move(pending).Run(valid);
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+const std::string* ZapController::StyleForOrigin(
+    const std::string& origin) const {
+  auto it = policies_.find(origin);
+  return it == policies_.end() ? nullptr : &it->second.stylesheet;
+}
+
+void ZapController::PrepareFrame(content::RenderFrameHost* frame,
+                                 const std::string& origin,
+                                 FrameCallback callback) {
+  if (!frame) {
+    std::move(callback).Run(false, false);
+    return;
+  }
+  const int request_id = next_frame_request_id_++;
+  auto request = std::make_unique<FrameRequest>();
+  request->callback = std::move(callback);
+  frame->GetRemoteAssociatedInterfaces()->GetInterface(&request->remote);
+  request->remote.set_disconnect_handler(
+      base::BindOnce(&ZapController::OnFrameResult, weak_factory_.GetWeakPtr(),
+                     request_id, false, false));
+  const std::string* zap_stylesheet = StyleForOrigin(origin);
+  std::string stylesheet = zap_stylesheet ? *zap_stylesheet : "";
+  if (auto* cosmetic = CosmeticController::ForProfile(profile_)) {
+    stylesheet.append(cosmetic->StyleForOrigin(origin));
+  }
+  const auto sequence_it = sequence_by_origin_.find(origin);
+  const uint64_t sequence =
+      sequence_it == sequence_by_origin_.end() ? 0 : sequence_it->second;
+  frame_requests_.emplace(request_id, std::move(request));
+  frame_requests_.at(request_id)
+      ->remote->SetAuxZapStylesheet(
+          origin, sequence, stylesheet,
+          base::BindOnce(&ZapController::OnFrameResult,
+                         weak_factory_.GetWeakPtr(), request_id));
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ZapController::OnFrameResult, weak_factory_.GetWeakPtr(),
+                     request_id, false, false),
+      base::Seconds(10));
+}
+
+void ZapController::RefreshCosmetic(base::OnceCallback<void(bool)> callback) {
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  if (!catalog) {
+    std::move(callback).Run(false);
+    return;
+  }
+  const base::DictValue snapshot = catalog->Snapshot();
+  const base::ListValue* tabs = snapshot.FindList("tabs");
+  if (!tabs) {
+    std::move(callback).Run(false);
+    return;
+  }
+  std::vector<std::pair<content::GlobalRenderFrameHostId, std::string>> targets;
+  for (const base::Value& tab : *tabs) {
+    const std::string* page_id = tab.GetDict().FindString("pageId");
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id) : nullptr;
+    if (!contents) {
+      continue;
+    }
+    contents->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+      const std::string origin = frame->GetLastCommittedOrigin().Serialize();
+      const GURL url(origin);
+      if (url.SchemeIsHTTPOrHTTPS()) {
+        targets.emplace_back(frame->GetGlobalId(), origin);
+      }
+    });
+  }
+  if (targets.size() > 5000) {
+    std::move(callback).Run(false);
+    return;
+  }
+  std::set<std::string> origins;
+  for (const auto& target : targets) {
+    origins.insert(target.second);
+  }
+  for (const auto& origin : origins) {
+    sequence_by_origin_[origin] = ++next_sequence_;
+  }
+  if (targets.empty()) {
+    std::move(callback).Run(true);
+    return;
+  }
+  struct Pending {
+    size_t remaining;
+    bool valid = true;
+    base::OnceCallback<void(bool)> callback;
+  };
+  auto pending = std::make_shared<Pending>();
+  pending->remaining = targets.size();
+  pending->callback = std::move(callback);
+  for (const auto& [frame_id, origin] : targets) {
+    const std::string* zap_style = StyleForOrigin(origin);
+    const bool expect_style = (zap_style && !zap_style->empty()) ||
+                              !CosmeticController::ForProfile(profile_)
+                                   ->StyleForOrigin(origin)
+                                   .empty();
+    PrepareFrame(content::RenderFrameHost::FromID(frame_id), origin,
+                 base::BindOnce(
+                     [](std::shared_ptr<Pending> pending,
+                        content::GlobalRenderFrameHostId frame_id,
+                        std::string origin, bool expect_style, bool accepted,
+                        bool applied) {
+                       auto* current = content::RenderFrameHost::FromID(frame_id);
+                       if (current &&
+                           current->GetLastCommittedOrigin().Serialize() == origin) {
+                         pending->valid &= accepted && (!expect_style || applied);
+                       }
+                       if (--pending->remaining == 0) {
+                         std::move(pending->callback).Run(pending->valid);
+                       }
+                     },
+                     pending, frame_id, origin, expect_style));
+  }
+}
+
+void ZapController::OnFrameResult(int request_id, bool accepted, bool applied) {
+  auto it = frame_requests_.find(request_id);
+  if (it == frame_requests_.end()) {
+    return;
+  }
+  auto request = std::move(it->second);
+  frame_requests_.erase(it);
+  std::move(request->callback).Run(accepted, applied);
+}
+
+void ZapController::Install(const base::DictValue& request,
+                            InstallCallback callback) {
+  if (!ready_ || !Validate(request)) {
+    std::move(callback).Run(Fault("Invalid Zap stylesheet installation"));
+    return;
+  }
+  const std::string origin = *request.FindString("origin");
+  const std::string stylesheet = *request.FindString("stylesheet");
+  const std::string hash = *request.FindString("stylesheetSha256");
+  const int revision = *request.FindInt("revision");
+  const auto previous_it = policies_.find(origin);
+  if (previous_it == policies_.end() && !stylesheet.empty() &&
+      policies_.size() >= 100) {
+    std::move(callback).Run(Fault("Zap is limited to 100 Profile origins"));
+    return;
+  }
+  if (previous_it != policies_.end() &&
+      previous_it->second.revision > revision) {
+    std::move(callback).Run(Fault("Zap policy revision is stale"));
+    return;
+  }
+  if (previous_it != policies_.end() &&
+      previous_it->second.revision == revision &&
+      previous_it->second.sha256 != hash) {
+    std::move(callback).Run(Fault("Zap revision conflicts with installed CSS"));
+    return;
+  }
+
+  struct Target {
+    std::string page_id;
+    content::GlobalRenderFrameHostId frame_id;
+    int64_t epoch;
+    bool matching_origin;
+  };
+  std::vector<Target> targets;
+  auto* catalog = TabCatalog::GetForProfile(profile_);
+  if (!catalog) {
+    std::move(callback).Run(Fault("Tab catalog is unavailable"));
+    return;
+  }
+  base::DictValue snapshot = catalog->Snapshot();
+  const base::ListValue* tabs = snapshot.FindList("tabs");
+  if (!tabs) {
+    std::move(callback).Run(Fault("Tab catalog is unavailable"));
+    return;
+  }
+  for (const base::Value& tab : *tabs) {
+    const std::string* page_id = tab.GetDict().FindString("pageId");
+    content::WebContents* contents =
+        page_id ? catalog->FindPage(*page_id) : nullptr;
+    if (!contents) {
+      continue;
+    }
+    contents->ForEachRenderFrameHost([&](content::RenderFrameHost* frame) {
+      const bool matching_origin =
+          frame->GetLastCommittedOrigin().Serialize() == origin;
+      if (matching_origin || stylesheet.empty()) {
+        targets.push_back({*page_id, frame->GetGlobalId(),
+                           frame->GetNavigationId(), matching_origin});
+      }
+    });
+  }
+  const size_t matching_count = std::count_if(
+      targets.begin(), targets.end(),
+      [](const Target& target) { return target.matching_origin; });
+  if (matching_count > 500 || targets.size() > 5000) {
+    std::move(callback).Run(Fault("Too many active Zap documents"));
+    return;
+  }
+
+  const std::optional<Policy> previous =
+      previous_it == policies_.end()
+          ? std::nullopt
+          : std::optional<Policy>(previous_it->second);
+  policies_[origin] = Policy{revision, stylesheet, hash};
+  sequence_by_origin_[origin] = ++next_sequence_;
+  struct Pending {
+    size_t remaining = 0;
+    bool failed = false;
+    base::ListValue documents;
+    InstallCallback callback;
+    base::DictValue receipt;
+    std::vector<Target> targets;
+    std::optional<Policy> previous;
+    std::string origin;
+    base::WeakPtr<ZapController> owner;
+  };
+  auto pending = std::make_shared<Pending>();
+  pending->remaining = targets.size();
+  pending->targets = std::move(targets);
+  pending->previous = previous;
+  pending->origin = origin;
+  pending->owner = weak_factory_.GetWeakPtr();
+  pending->callback = std::move(callback);
+  pending->receipt.Set("profileId", *request.FindString("profileId"));
+  pending->receipt.Set("origin", origin);
+  pending->receipt.Set("revision", revision);
+  pending->receipt.Set("stylesheetSha256", hash);
+  pending->receipt.Set("phase", "document_start");
+  pending->receipt.Set("futureDocuments", true);
+
+  if (pending->remaining == 0) {
+    if (stylesheet.empty()) {
+      policies_.erase(origin);
+    }
+    pending->receipt.Set(
+        "appliedAt",
+        static_cast<double>(base::Time::Now().InMillisecondsSinceUnixEpoch()));
+    pending->receipt.Set("activeDocuments", base::ListValue());
+    base::DictValue response;
+    response.Set("result", std::move(pending->receipt));
+    std::move(pending->callback).Run(std::move(response));
+    return;
+  }
+  for (const Target& target : pending->targets) {
+    content::RenderFrameHost* frame =
+        content::RenderFrameHost::FromID(target.frame_id);
+    PrepareFrame(
+        frame, origin,
+        base::BindOnce(
+            [](std::shared_ptr<Pending> pending, Target target, bool accepted,
+               bool applied) {
+              content::RenderFrameHost* current =
+                  content::RenderFrameHost::FromID(target.frame_id);
+              const bool same_document =
+                  current && current->GetNavigationId() == target.epoch &&
+                  current->GetLastCommittedOrigin().Serialize() ==
+                      pending->origin;
+              if (same_document && target.matching_origin) {
+                base::DictValue document;
+                document.Set("pageId", target.page_id);
+                document.Set(
+                    "documentEpoch",
+                    static_cast<double>(std::max<int64_t>(0, target.epoch)));
+                document.Set("frameOrigin", pending->origin);
+                document.Set("applied", accepted && applied);
+                pending->documents.Append(std::move(document));
+                if (!accepted ||
+                    (!applied && pending->owner &&
+                     !pending->owner->StyleForOrigin(pending->origin)
+                          ->empty())) {
+                  pending->failed = true;
+                }
+              }
+              if (current && !accepted) {
+                pending->failed = true;
+              }
+              if (--pending->remaining != 0) {
+                return;
+              }
+              if (!pending->owner) {
+                std::move(pending->callback)
+                    .Run(Fault("Zap Profile closed during installation"));
+                return;
+              }
+              if (!pending->failed) {
+                pending->receipt.Set(
+                    "appliedAt",
+                    static_cast<double>(
+                        base::Time::Now().InMillisecondsSinceUnixEpoch()));
+                pending->receipt.Set("activeDocuments",
+                                     std::move(pending->documents));
+                base::DictValue response;
+                response.Set("result", std::move(pending->receipt));
+                std::move(pending->callback).Run(std::move(response));
+                return;
+              }
+              // The runtime has not saved this edit. Restore the previous
+              // policy and wait for every surviving active frame to acknowledge
+              // rollback.
+              if (pending->previous) {
+                pending->owner->policies_[pending->origin] = *pending->previous;
+              } else {
+                pending->owner->policies_.erase(pending->origin);
+              }
+              struct Rollback {
+                size_t remaining = 0;
+                InstallCallback callback;
+              };
+              auto rollback = std::make_shared<Rollback>();
+              rollback->callback = std::move(pending->callback);
+              for (const Target& item : pending->targets) {
+                if (content::RenderFrameHost::FromID(item.frame_id)) {
+                  ++rollback->remaining;
+                }
+              }
+              if (!rollback->remaining) {
+                std::move(rollback->callback)
+                    .Run(Fault("Zap active document rejected the stylesheet"));
+                return;
+              }
+              for (const Target& item : pending->targets) {
+                content::RenderFrameHost* rollback_frame =
+                    content::RenderFrameHost::FromID(item.frame_id);
+                if (!rollback_frame) {
+                  continue;
+                }
+                pending->owner->PrepareFrame(
+                    rollback_frame, pending->origin,
+                    base::BindOnce(
+                        [](std::shared_ptr<Rollback> rollback, bool, bool) {
+                          if (--rollback->remaining == 0) {
+                            std::move(rollback->callback)
+                                .Run(Fault("Zap active document rejected the "
+                                           "stylesheet"));
+                          }
+                        },
+                        rollback));
+              }
+            },
+            pending, target));
+  }
+}
+
+namespace {
+
+void StopNavigation(content::WebContents* contents) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<content::WebContents> weak_contents) {
+                       if (weak_contents) {
+                         weak_contents->Stop();
+                       }
+                     },
+                     contents->GetWeakPtr()));
+}
+
+class ZapCommitCondition final : public content::CommitDeferringCondition {
+ public:
+  explicit ZapCommitCondition(content::NavigationHandle& navigation)
+      : CommitDeferringCondition(navigation) {}
+  ~ZapCommitCondition() override = default;
+
+  Result WillCommitNavigation(base::OnceClosure resume) override {
+    content::NavigationHandle& navigation = GetNavigationHandle();
+    Profile* profile = Profile::FromBrowserContext(
+        navigation.GetWebContents()->GetBrowserContext());
+    ZapController* controller = ZapController::ForProfile(profile);
+    if (!controller) {
+      return Result::kProceed;
+    }
+    const std::string origin =
+        url::Origin::Create(navigation.GetURL()).Serialize();
+    controller->EnsureReady(base::BindOnce(
+        [](base::WeakPtr<ZapCommitCondition> condition, std::string origin,
+           base::OnceClosure resume, bool ready) {
+          if (!condition) {
+            return;
+          }
+          if (!ready) {
+            // A saved policy may exist: do not commit a document without
+            // loading the authoritative Profile snapshot.
+            StopNavigation(condition->GetNavigationHandle().GetWebContents());
+            return;
+          }
+          ZapController* controller = ZapController::ForProfile(
+              Profile::FromBrowserContext(condition->GetNavigationHandle()
+                                              .GetWebContents()
+                                              ->GetBrowserContext()));
+          content::RenderFrameHost* frame =
+              condition->GetNavigationHandle().GetRenderFrameHost();
+          if (!controller || !frame) {
+            StopNavigation(condition->GetNavigationHandle().GetWebContents());
+            return;
+          }
+          controller->PrepareFrame(
+              frame, origin,
+              base::BindOnce(
+                  [](base::WeakPtr<ZapCommitCondition> condition,
+                     base::OnceClosure resume, bool accepted, bool) {
+                    if (!condition) {
+                      return;
+                    }
+                    if (!accepted) {
+                      StopNavigation(
+                          condition->GetNavigationHandle().GetWebContents());
+                      return;
+                    }
+                    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                        FROM_HERE, std::move(resume));
+                  },
+                  condition, std::move(resume)));
+        },
+        weak_factory_.GetWeakPtr(), origin, std::move(resume)));
+    return Result::kDefer;
+  }
+
+  const char* TraceEventName() const override {
+    return "AuxZapCommitCondition";
+  }
+
+ private:
+  base::WeakPtrFactory<ZapCommitCondition> weak_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<content::CommitDeferringCondition> MaybeCreateZapCondition(
+    content::NavigationHandle& navigation) {
+  if (navigation.IsSameDocument() ||
+      !navigation.GetURL().SchemeIsHTTPOrHTTPS()) {
+    return nullptr;
+  }
+  Profile* profile = Profile::FromBrowserContext(
+      navigation.GetWebContents()->GetBrowserContext());
+  if (!profile) {
+    return nullptr;
+  }
+  return std::make_unique<ZapCommitCondition>(navigation);
+}
+
+}  // namespace aux
