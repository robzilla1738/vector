+  // following Preview/egress check. The final guard reevaluates current rules
+  // without substituting a current/foreground document or caller origin.
+  EnsureReady(base::BindOnce([](base::WeakPtr<ContentBlockingController> owner,
+      ContentFilterSourceScope scope, ContentFilterSourceScope::RequestSource source,
+      GURL url, base::OnceCallback<void(OwnerCurrent)> callback, bool ready) {
