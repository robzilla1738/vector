+void ContentBlockingController::AdmitWebSocket(content::RenderFrameHost* frame,
+    int render_process_id, const url::Origin& initiator,
+    const net::IsolationInfo& isolation_info, const GURL& url,
+    base::OnceCallback<void(OwnerCurrent)> callback) {
