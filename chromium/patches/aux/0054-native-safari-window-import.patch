new file mode 100644
index 0000000..d164b39
--- /dev/null
+++ b/chrome/browser/ui/aux/browser_safari_window_mac.mm
@@ -0,0 +1,189 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/browser_safari_window.h"
+#import <AppKit/AppKit.h>
+#import <ScriptingBridge/ScriptingBridge.h>
+#include <libproc.h>
+#include <Security/Security.h>
+#include <atomic>
+#include <limits>
+#include <optional>
+#include "base/apple/scoped_cftyperef.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/thread_pool.h"
+@interface AuxSafariEventErrors : NSObject <SBApplicationDelegate>
+@property(nonatomic) BOOL failed;
+@end
+@implementation AuxSafariEventErrors
+@synthesize failed = _failed;
+- (id)eventDidFail:(const AppleEvent*)event withError:(NSError*)error {
+  self.failed = YES;
+  return nil;
+}
+@end
+namespace aux {
+namespace {
+struct ProcessIdentity { int32_t pid; uint64_t seconds; uint64_t microseconds; };
+struct WindowMetadata { int32_t id; std::string title; };
+struct WindowChoice { ProcessIdentity process; std::vector<WindowMetadata> windows; };
+bool ProcessCurrent(const ProcessIdentity& original) {
+  struct proc_bsdinfo info;
+  return proc_pidinfo(original.pid, PROC_PIDTBSDINFO, 0, &info, sizeof(info)) == sizeof(info) &&
+      info.pbi_start_tvsec == original.seconds && info.pbi_start_tvusec == original.microseconds;
+}
+bool GenuineSafari(int32_t pid) {
+  NSDictionary* attributes = @{(__bridge NSString*)kSecGuestAttributePid : @(pid)};
+  base::apple::ScopedCFTypeRef<SecCodeRef> code;
+  base::apple::ScopedCFTypeRef<SecRequirementRef> requirement;
+  return SecCodeCopyGuestWithAttributes(nullptr, (__bridge CFDictionaryRef)attributes,
+             kSecCSDefaultFlags, code.InitializeInto()) == errSecSuccess &&
+      SecRequirementCreateWithString(CFSTR("identifier \"com.apple.Safari\" and anchor apple"),
+             kSecCSDefaultFlags, requirement.InitializeInto()) == errSecSuccess &&
+      SecCodeCheckValidity(code.get(), kSecCSDefaultFlags, requirement.get()) == errSecSuccess;
+}
+SBApplication* Application(const ProcessIdentity& identity, AuxSafariEventErrors* errors) {
+  if (!ProcessCurrent(identity) || !GenuineSafari(identity.pid)) return nil;
+  SBApplication* application = [[SBApplication alloc] initWithProcessIdentifier:identity.pid];
+  application.delegate = errors;
+  application.timeout = 2 * 60;  // Apple-event ticks; bounded original local read.
+  application.sendMode = kAEWaitReply | kAENeverInteract;
+  return application.isRunning ? application : nil;
+}
+base::expected<WindowChoice, std::string> ReadMetadata(const std::shared_ptr<std::atomic_bool>& cancelled) {
+  @autoreleasepool {
+    NSArray<NSRunningApplication*>* applications = [NSRunningApplication runningApplicationsWithBundleIdentifier:@"com.apple.Safari"];
+    if (cancelled->load() || applications.count != 1) return base::unexpected("Open the original Safari application before choosing a window.");
+    const int32_t pid = applications.firstObject.processIdentifier;
+    struct proc_bsdinfo info;
+    if (proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &info, sizeof(info)) != sizeof(info) || !GenuineSafari(pid)) return base::unexpected("The original Safari process could not be verified.");
+    WindowChoice result{{pid, info.pbi_start_tvsec, info.pbi_start_tvusec}, {}};
+    AuxSafariEventErrors* errors = [[AuxSafariEventErrors alloc] init];
+    SBApplication* application = Application(result.process, errors);
+    NSArray* windows = [[application elementArrayWithCode:'cwin'] get];
+    if (!application || errors.failed || ![windows isKindOfClass:[NSArray class]] || windows.count > 256) return base::unexpected("Safari window metadata is unavailable. Review macOS Automation permission for Aux.");
+    for (SBObject* window in windows) {
+      if (![window isKindOfClass:[SBObject class]]) return base::unexpected("Safari returned invalid window references.");
+      if (cancelled->load()) return base::unexpected("The original Safari selection was cancelled.");
+      id identifier = [[window propertyWithCode:'ID  '] get];
+      id title = [[window propertyWithCode:'pnam'] get];
+      if (errors.failed || ![identifier isKindOfClass:[NSNumber class]] || ![title isKindOfClass:[NSString class]]) return base::unexpected("The original Safari windows changed while being reviewed.");
+      const int64_t value = [identifier longLongValue];
+      if (value <= 0 || value > std::numeric_limits<int32_t>::max() || [title length] > 4096) return base::unexpected("Safari returned invalid window metadata.");
+      result.windows.push_back({static_cast<int32_t>(value), base::SysNSStringToUTF8(title)});
+    }
+    if (result.windows.empty() || cancelled->load() || !ProcessCurrent(result.process)) return base::unexpected("The original Safari windows are no longer available.");
+    return result;
+  }
+}
+base::expected<std::shared_ptr<const SafariWindowSnapshot>, std::string> CaptureSelected(
+    ProcessIdentity process, int32_t selected, const std::shared_ptr<std::atomic_bool>& cancelled) {
+  @autoreleasepool {
+    auto result = std::make_shared<SafariWindowSnapshot>();
+    result->pid = process.pid; result->process_start_seconds = process.seconds;
+    result->process_start_microseconds = process.microseconds; result->window_id = selected;
+    AuxSafariEventErrors* errors = [[AuxSafariEventErrors alloc] init];
+    SBApplication* application = Application(process, errors);
+    SBObject* window = [[application elementArrayWithCode:'cwin'] objectWithID:@(selected)];
+    id identifier = [[window propertyWithCode:'ID  '] get];
+    if (cancelled->load() || !application || errors.failed || ![identifier isKindOfClass:[NSNumber class]] || [identifier longLongValue] != selected) return base::unexpected("The selected original Safari window is unavailable.");
+    // Only this exact selected window's tabs are requested, never application
+    // documents/all windows, HTML, cookies, text or Javascript execution.
+    NSArray* tabs = [[window elementArrayWithCode:'bTab'] get];
+    if (errors.failed || ![tabs isKindOfClass:[NSArray class]] || tabs.count > 10000) return base::unexpected("The selected Safari tab list could not be captured safely.");
+    std::vector<std::string> urls;
+    for (SBObject* tab in tabs) {
+      if (![tab isKindOfClass:[SBObject class]]) return base::unexpected("Safari returned invalid tab references.");
+      if (cancelled->load() || !ProcessCurrent(process)) return base::unexpected("The original Safari selection was retired.");
+      id address = [[tab propertyWithCode:'pURL'] get]; id title = [[tab propertyWithCode:'pnam'] get];
+      if (errors.failed || ![address isKindOfClass:[NSString class]] || ![title isKindOfClass:[NSString class]] || [address length] > 8192 || [title length] > 4096) return base::unexpected("The selected Safari tabs changed while being captured.");
+      std::string captured = base::SysNSStringToUTF8(address);
+      urls.push_back(captured);
+      GURL url(captured);
+      if (url.is_valid() && url.SchemeIsHTTPOrHTTPS() && !url.has_username() && !url.has_password()) result->tabs.push_back({url, base::SysNSStringToUTF16(title), selected, false});
+    }
+    NSArray* after = [[window elementArrayWithCode:'bTab'] get];
+    if (errors.failed || ![after isKindOfClass:[NSArray class]] || after.count != urls.size()) return base::unexpected("The selected Safari tab list changed during capture.");
+    for (NSUInteger index = 0; index < after.count; ++index) {
+      if (cancelled->load()) return base::unexpected("The original Safari selection was cancelled.");
+      if (![after[index] isKindOfClass:[SBObject class]]) return base::unexpected("Safari returned invalid tab references.");
+      id address = [[after[index] propertyWithCode:'pURL'] get];
+      if (errors.failed || ![address isKindOfClass:[NSString class]] || base::SysNSStringToUTF8(address) != urls[index]) return base::unexpected("The selected Safari tabs changed during capture.");
+    }
+    identifier = [[window propertyWithCode:'ID  '] get];
+    if (errors.failed || ![identifier isKindOfClass:[NSNumber class]] || [identifier longLongValue] != selected || cancelled->load() || !ProcessCurrent(process)) return base::unexpected("The original Safari window was retired before capture completed.");
+    return std::shared_ptr<const SafariWindowSnapshot>(std::move(result));
+  }
+}
+class Picker final : public BrowserSafariWindowPicker {
+ public:
+  Picker(NSWindow* window, Current current, Selected selected) : window_(window), current_(std::move(current)), selected_(std::move(selected)), cancelled_(std::make_shared<std::atomic_bool>(false)), worker_(base::ThreadPool::CreateSingleThreadTaskRunner({base::MayBlock(), base::TaskPriority::USER_VISIBLE, base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {}
+  void Start() {
+    alert_ = [[NSAlert alloc] init]; alert_.messageText = @"Choose a Safari window";
+    alert_.informativeText = @"Aux will read Safari window titles so you can choose one window. Safari cannot report whether a window is private. Only the window you then select will have its tab URLs copied to Aux. No cookies, page contents or passwords are read.";
+    [alert_ addButtonWithTitle:@"Review windows"]; [alert_ addButtonWithTitle:@"Cancel"];
+    auto weak = weak_factory_.GetWeakPtr();
+    [alert_ beginSheetModalForWindow:window_ completionHandler:^(NSModalResponse response) { if (weak) weak->Reviewed(response); }];
+  }
+  void Cancel() override {
+    cancelled_->store(true);
+    if (alert_) [NSApp endSheet:alert_.window returnCode:NSModalResponseCancel];
+    // A pending Apple event must actually return before the completion joins.
+  }
+ private:
+  void Finish(base::expected<std::shared_ptr<const SafariWindowSnapshot>, std::string> result) {
+    alert_ = nil;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce(std::move(selected_), std::move(result)));
+  }
+  void Reviewed(NSModalResponse response) {
+    alert_ = nil;
+    if (response != NSAlertFirstButtonReturn || cancelled_->load() || !current_.Run()) { Finish(base::unexpected("The original Safari window review was cancelled.")); return; }
+    if (!worker_->PostTaskAndReplyWithResult(FROM_HERE, base::BindOnce(&ReadMetadata, cancelled_), base::BindOnce(&Picker::Choose, weak_factory_.GetWeakPtr()))) Finish(base::unexpected("Safari window review could not start during shutdown."));
+  }
+  void Choose(base::expected<WindowChoice, std::string> choices) {
+    if (!choices || cancelled_->load() || !current_.Run()) { Finish(base::unexpected(choices ? "The original Safari review was retired." : choices.error())); return; }
+    choices_ = std::move(*choices);
+    alert_ = [[NSAlert alloc] init]; alert_.messageText = @"Copy tabs from one Safari window";
+    alert_.informativeText = @"Safari cannot identify private windows. Choose only a window whose tab URLs you want saved in your Aux Profile.";
+    popup_ = [[NSPopUpButton alloc] initWithFrame:NSMakeRect(0, 0, 420, 28) pullsDown:NO];
+    for (const auto& choice : choices_->windows) {
+      NSString* title = base::SysUTF8ToNSString(choice.title);
+      if (title.length > 160) title = [title substringToIndex:160];
+      [popup_ addItemWithTitle:[NSString stringWithFormat:@"Window %d — %@", choice.id, title]];
+    }
+    alert_.accessoryView = popup_; [alert_ addButtonWithTitle:@"Copy chosen tabs"]; [alert_ addButtonWithTitle:@"Cancel"];
+    auto weak = weak_factory_.GetWeakPtr();
+    [alert_ beginSheetModalForWindow:window_ completionHandler:^(NSModalResponse response) { if (weak) weak->SelectedWindow(response); }];
+  }
+  void SelectedWindow(NSModalResponse response) {
+    alert_ = nil;
+    if (response != NSAlertFirstButtonReturn || cancelled_->load() || !current_.Run() || !choices_ || popup_.indexOfSelectedItem < 0 || size_t(popup_.indexOfSelectedItem) >= choices_->windows.size()) { Finish(base::unexpected("The original Safari selection was cancelled.")); return; }
+    const auto original = choices_->process; const int32_t id = choices_->windows[popup_.indexOfSelectedItem].id;
+    if (!worker_->PostTaskAndReplyWithResult(FROM_HERE, base::BindOnce(&CaptureSelected, original, id, cancelled_), base::BindOnce(&Picker::Captured, weak_factory_.GetWeakPtr()))) Finish(base::unexpected("Safari capture could not start during shutdown."));
+  }
+  void Captured(base::expected<std::shared_ptr<const SafariWindowSnapshot>, std::string> result) {
+    if (cancelled_->load() || !current_.Run()) result = base::unexpected("The original Safari selection was retired before publication.");
+    Finish(std::move(result));
+  }
+  NSWindow* __weak window_;
+  NSAlert* __strong alert_;
+  NSPopUpButton* __strong popup_;
+  Current current_; Selected selected_;
+  std::optional<WindowChoice> choices_;
+  std::shared_ptr<std::atomic_bool> cancelled_;
+  scoped_refptr<base::SingleThreadTaskRunner> worker_;
+  base::WeakPtrFactory<Picker> weak_factory_{this};
+};
+}  // namespace
+bool SafariWindowSnapshot::OriginalProcessIsCurrent() const {
+  return ProcessCurrent({pid, process_start_seconds, process_start_microseconds});
+}
+std::unique_ptr<BrowserSafariWindowPicker> BrowserSafariWindowPicker::Show(gfx::NativeWindow original, Current current, Selected selected) {
+  NSWindow* window = original.GetNativeNSWindow();
+  if (!window || !window.visible || !current || !current.Run()) return nullptr;
+  auto picker = std::make_unique<Picker>(window, std::move(current), std::move(selected)); picker->Start(); return picker;
+}
