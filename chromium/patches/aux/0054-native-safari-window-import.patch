+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_BROWSER_SAFARI_WINDOW_H_
+#define CHROME_BROWSER_UI_AUX_BROWSER_SAFARI_WINDOW_H_
+#include <memory>
+#include <cstdint>
+#include "base/functional/callback.h"
+#include "base/types/expected.h"
+#include "chrome/browser/ui/aux/browser_import_picker.h"
