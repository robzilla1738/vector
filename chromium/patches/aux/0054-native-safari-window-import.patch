+namespace aux {
+struct SafariWindowSnapshot {
+  int32_t pid;
+  uint64_t process_start_seconds;
+  uint64_t process_start_microseconds;
+  int32_t window_id;
+  std::vector<ImportedProfileTab> tabs;
+  // The selected window is captured once, after explicit native review. No
+  // subsequent all-window scans or tab URL reads happen during import effects.
+  bool OriginalProcessIsCurrent() const;
+};
+class BrowserSafariWindowPicker : public BrowserImportPicker {
+ public:
+  using Current = base::RepeatingCallback<bool()>;
+  using Selected = base::OnceCallback<void(base::expected<std::shared_ptr<const SafariWindowSnapshot>, std::string>)>;
+  static std::unique_ptr<BrowserSafariWindowPicker> Show(gfx::NativeWindow original_window, Current current, Selected selected);
+};
+}  // namespace aux
+#endif
