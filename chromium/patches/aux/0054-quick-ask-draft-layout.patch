+  bool SetLayout(BrowserWindowInterface* browser, bool conversation,
+                 int draft_height) {
+    if (!IsPopup(browser) || browser->GetProfile()->IsOffTheRecord())
+      return false;
+    auto* screen = display::Screen::Get();
+    if (!screen) return false;
+    const gfx::Rect work_area = screen->GetDisplayNearestWindow(
+        browser->GetWindow()->GetNativeWindow()).work_area();
+    gfx::Rect bounds = browser->GetWindow()->GetBounds();
+    const int width = std::min(conversation ? 520 : 440, work_area.width());
+    const int height = std::min(conversation ? 640 : std::clamp(draft_height, 184, 360),
+                                work_area.height());
+    bounds.set_x(bounds.CenterPoint().x() - width / 2);
+    bounds.set_size(gfx::Size(width, height));
+    bounds.AdjustToFit(work_area);
+    if (bounds != browser->GetWindow()->GetBounds())
+      browser->GetWindow()->SetBounds(bounds);
     return true;
   }
 
