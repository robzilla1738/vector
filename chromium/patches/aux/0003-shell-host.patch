+bool WebUIBrowserUI::EvidenceDocumentsCurrent(
+    const std::string& selection_id) const {
+  if (!evidence_document_selection_ ||
+      evidence_document_selection_->id != selection_id ||
+      !evidence_document_selection_->window ||
+      evidence_document_selection_->window.get() != browser_ ||
+      !IsAuthorizedAuxDocument()) {
+    return false;
+  }
+  auto* frame =
+      evidence_document_selection_->document.AsRenderFrameHostIfValid();
+  return frame && frame->IsActive() && frame->IsRenderFrameLive() &&
+         frame == web_ui()->GetRenderFrameHost() &&
+         frame == web_ui()->GetWebContents()->GetPrimaryMainFrame();
+}
