+        {"delete", ui::VKEY_DELETE}, {"left", ui::VKEY_LEFT},
+        {"right", ui::VKEY_RIGHT}, {"up", ui::VKEY_UP},
+        {"down", ui::VKEY_DOWN}, {"home", ui::VKEY_HOME},
+        {"end", ui::VKEY_END}, {"pageup", ui::VKEY_PRIOR},
+        {"pagedown", ui::VKEY_NEXT}};
