@@ -0,0 +1,62 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_SHELL_WARMUP_MANAGER_H_
+#define CHROME_BROWSER_UI_AUX_SHELL_WARMUP_MANAGER_H_
+
+#include <memory>
+
+#include "base/memory/weak_ptr.h"
+#include "base/memory_coordinator/memory_consumer.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile_manager_observer.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "content/public/browser/spare_render_process_host_manager.h"
+
+class Profile;
+class ProfileManager;
+class ScopedProfileKeepAlive;
+
+namespace aux {
+
+// BrowserProcessImpl owns this service and destroys it before ProfileManager.
+// The upstream spare remains an unprivileged, unused renderer; every normal
+// process suitability and WebUI admission check still runs when it is taken.
+class ShellWarmupManager final
+    : public ProfileObserver,
+      public ProfileManagerObserver,
+      public content::SpareRenderProcessHostManager::Observer,
+      public base::PassiveMemoryConsumer {
+ public:
+  ShellWarmupManager();
+  ~ShellWarmupManager() override;
+  ShellWarmupManager(const ShellWarmupManager&) = delete;
+  ShellWarmupManager& operator=(const ShellWarmupManager&) = delete;
+
+  static ShellWarmupManager* Get();
+  void UseProfile(Profile* profile);
+
+ private:
+  void ScheduleRefill();
+  void Refill();
+  void ReleaseProfile();
+  bool CanWarm() const;
+  void OnUpdateMemoryLimit() override;
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+  void OnProfileMarkedForPermanentDeletion(Profile* profile) override;
+  void OnProfileManagerDestroying() override;
+  void OnSpareRenderProcessHostRemoved(content::RenderProcessHost* host) override;
+
+  std::unique_ptr<ScopedProfileKeepAlive> profile_keep_alive_;
+  base::ScopedObservation<Profile, ProfileObserver> profile_observation_{this};
+  base::ScopedObservation<ProfileManager, ProfileManagerObserver>
+      manager_observation_{this};
+  base::MemoryConsumerRegistration memory_registration_;
+  bool refill_pending_ = false;
+  base::WeakPtrFactory<ShellWarmupManager> weak_factory_{this};
+};
+
+}  // namespace aux
+#endif  // CHROME_BROWSER_UI_AUX_SHELL_WARMUP_MANAGER_H_
