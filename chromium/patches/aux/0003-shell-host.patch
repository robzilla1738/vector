@@ -0,0 +1,283 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/webui_browser/aux_omnibox_handler.h"
+
+#include <cstdint>
+#include <memory>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/ui/aux/page_identity.h"
+#include "chrome/browser/predictors/autocomplete_action_predictor.h"
+#include "chrome/browser/predictors/autocomplete_action_predictor_factory.h"
+#include "chrome/browser/predictors/loading_predictor.h"
+#include "chrome/browser/predictors/loading_predictor_factory.h"
+#include "chrome/browser/preloading/prefetch/search_prefetch/search_prefetch_service.h"
+#include "chrome/browser/preloading/prefetch/search_prefetch/search_prefetch_service_factory.h"
+#include "chrome/browser/preloading/search_preload/search_preload_service.h"
+#include "chrome/browser/preloading/search_preload/search_preload_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/cr_components/searchbox/searchbox_omnibox_client.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/omnibox/browser/autocomplete_controller.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+#include "components/omnibox/browser/fusebox_action.mojom.h"
+#include "components/omnibox/browser/omnibox_popup_selection.h"
+#include "components/omnibox/browser/searchbox_utils.h"
+#include "components/safe_browsing/buildflags.h"
+#include "extensions/buildflags/buildflags.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "services/network/public/cpp/constants.h"
+#include "services/network/public/cpp/resource_request_body.h"
+#include "content/public/browser/page_navigator.h"
+#include "third_party/metrics_proto/omnibox_event.pb.h"
+
+#if BUILDFLAG(ENABLE_EXTENSIONS) && BUILDFLAG(SAFE_BROWSING_AVAILABLE)
+#include "chrome/browser/safe_browsing/extension_telemetry/extension_telemetry_service.h"
+#endif
+
+namespace {
+class AuxOmniboxClient final : public SearchboxOmniboxClient {
+ public:
+  AuxOmniboxClient(Profile* profile, content::WebContents* shell,
+                   AuxOmniboxHandler::Target resolver)
+      : SearchboxOmniboxClient(profile, shell), resolver_(std::move(resolver)) {}
+  void SetTarget(content::WebContents* target) {
+    accepted_url_ = GURL();
+    document_ = target ? std::make_optional(target->GetPrimaryMainFrame()->GetWeakDocumentPtr()) : std::nullopt;
+    target_ = target ? target->GetWeakPtr() : base::WeakPtr<content::WebContents>();
+    url_ = target ? target->GetLastCommittedURL() : GURL();
+    title_ = target ? target->GetTitle() : std::u16string();
+  }
+  void ArmAcceptance(const AutocompleteMatch& match) {
+    accepted_url_ = match.destination_url;
+  }
+  void OnAutocompleteAccept(const GURL& destination_url,
+      TemplateURLRef::PostContent* post_content, WindowOpenDisposition disposition,
+      ui::PageTransition transition, AutocompleteMatchType::Type match_type,
+      base::TimeTicks timestamp, bool without_scheme, bool http_scheme,
+      const std::u16string& text, const AutocompleteMatch& match,
+      const AutocompleteMatch& alternative) override {
+    // A search-engine confirmation may complete after the renderer's request.
+    // A replacement query, document or active tab cannot inherit that acceptance.
+    auto* current = resolver_.Run();
+    if (!accepted_url_.is_valid() || match.destination_url != accepted_url_ ||
+        current != target_.get() || (document_ && (!current ||
+        !document_->AsRenderFrameHostIfValid() ||
+        document_->AsRenderFrameHostIfValid() != current->GetPrimaryMainFrame()))) return;
+    accepted_url_ = GURL();
+#if BUILDFLAG(ENABLE_EXTENSIONS) && BUILDFLAG(SAFE_BROWSING_AVAILABLE)
+    if (AutocompleteMatch::IsSearchType(match.type)) {
+      if (auto* telemetry = safe_browsing::ExtensionTelemetryService::Get(profile_))
+        telemetry->OnOmniboxSearch(match);
+    }
+#endif
+    content::OpenURLParams params(destination_url, content::Referrer(), disposition,
+                                  transition, false);
+    if (post_content) {
+      params.post_data = network::ResourceRequestBody::CreateFromBytes(
+          std::vector<uint8_t>(post_content->second.begin(), post_content->second.end()));
+      params.extra_headers = "Content-Type: " + post_content->first + "\r\n";
+    }
+    for (const auto& [name, value] : match.extra_headers)
+      params.extra_headers += name + ": " + value + "\r\n";
+    web_contents_->OpenURL(params, {});
+  }
+  bool CurrentPageExists() const override { return !!target_; }
+  const GURL& GetURL() const override { return url_; }
+  const std::u16string& GetTitle() const override { return title_; }
+  metrics::OmniboxEventProto::PageClassification GetPageClassification(
+      bool is_prefetch) const override {
+    return !target_ || url_.IsAboutBlank()
+        ? metrics::OmniboxEventProto::NTP_REALBOX
+        : metrics::OmniboxEventProto::OTHER;
+  }
+ private:
+  AuxOmniboxHandler::Target resolver_;
+  base::WeakPtr<content::WebContents> target_;
+  std::optional<content::WeakDocumentPtr> document_;
+  GURL accepted_url_;
+  GURL url_;
+  std::u16string title_;
+};
+}  // namespace
+
+AuxOmniboxHandler::AuxOmniboxHandler(Profile* profile,
+    content::WebContents* shell, Target target, Update update)
+    : SearchboxHandler({}, {}, profile, shell,
+          std::make_unique<AuxOmniboxClient>(profile, shell, target)),
+      target_resolver_(std::move(target)), update_(std::move(update)) {
+  autocomplete_controller_observation_.Observe(autocomplete_controller());
+}
+AuxOmniboxHandler::~AuxOmniboxHandler() = default;
+
+bool AuxOmniboxHandler::Start(int query_id, const std::u16string& input,
+                              bool on_focus) {
+  if (query_id <= current_query_id_) return false;
+  live_ = false;
+  StopAutocomplete(true);
+  auto* target = target_resolver_.Run();
+  target_ = target ? target->GetWeakPtr() : base::WeakPtr<content::WebContents>();
+  document_ = target ? std::make_optional(
+      target->GetPrimaryMainFrame()->GetWeakDocumentPtr()) : std::nullopt;
+  static_cast<AuxOmniboxClient*>(client())->SetTarget(target);
+  current_query_id_ = query_id;
+  live_ = true;
+  OnFocusChanged(true);
+  QueryAutocomplete(query_id, std::nullopt, input, false, input.size(),
+      omnibox::SuggestInventory::SUGGEST_INVENTORY_DEFAULT, on_focus, "",
+      searchbox::mojom::InputMethod::kKeyboard);
+  return true;
+}
+
+bool AuxOmniboxHandler::Stop(int query_id) {
+  if (query_id != current_query_id_) return false;
+  live_ = false;
+  StopAutocomplete(true);
+  OnFocusChanged(false);
+  return true;
+}
+
+bool AuxOmniboxHandler::TargetIsCurrent() const {
+  auto* current = target_resolver_.Run();
+  if (current != target_.get()) return false;
+  return !document_ || (current && document_->AsRenderFrameHostIfValid() &&
+      current->GetPrimaryMainFrame() &&
+      document_->AsRenderFrameHostIfValid() == current->GetPrimaryMainFrame());
+}
+
+bool AuxOmniboxHandler::Open(int query_id, const base::DictValue* selection,
+                             WindowOpenDisposition disposition) {
+  if (!live_ || query_id != current_query_id_ || !TargetIsCurrent()) return false;
+  AutocompleteMatch accepted;
+  int index = OmniboxPopupSelection::kNoMatch;
+  if (selection) {
+    if (static_cast<uint32_t>(*selection->FindDouble("sequenceId")) !=
+        autocomplete_controller()->result().sequence_id()) return false;
+    const auto native_index = static_cast<size_t>(*selection->FindDouble("index"));
+    const auto* match = GetMatchWithUrl(native_index, GURL(*selection->FindString("url")));
+    if (!match) return false;
+    index = static_cast<int>(native_index);
+    accepted = *match;
+  } else {
+    const auto* match = autocomplete_controller()->result().default_match();
+    if (match) {
+      accepted = *match;
+      int position = 0;
+      for (const auto& result : autocomplete_controller()->result()) {
+        if (&result == match) { index = position; break; }
+        ++position;
+      }
+    } else searchbox::ClassifyString(client(), autocomplete_controller()->input().text(),
+        false, true, &accepted);
+    if (!accepted.destination_url.is_valid()) return false;
+  }
+  if (!target_ && disposition == WindowOpenDisposition::CURRENT_TAB)
+    disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  live_ = false;
+  static_cast<AuxOmniboxClient*>(client())->ArmAcceptance(accepted);
+  OpenMatch(OmniboxPopupSelection(index), accepted, disposition,
+            base::TimeTicks::Now());
+  StopAutocomplete(false);
+  return true;
+}
+
+bool AuxOmniboxHandler::Hint(const std::string& page_id,
+                              const GURL& expected_url, const GURL& url) {
+  auto* target = target_resolver_.Run();
+  auto* identity = target ? aux::PageIdentity::FromWebContents(target) : nullptr;
+  if (!target || !identity || identity->id() != page_id ||
+      target->GetBrowserContext() != profile_ ||
+      target->GetLastCommittedURL() != expected_url ||
+      !url.SchemeIsHTTPOrHTTPS() || url == expected_url || profile_->IsOffTheRecord())
+    return false;
+  const auto weak = weak_factory_.GetWeakPtr();
+  const auto original = target->GetWeakPtr();
+  const auto document = target->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  if (auto* loading = predictors::LoadingPredictorFactory::GetForProfile(profile_))
+    loading->PrepareForPageLoad(std::nullopt, url, predictors::HintOrigin::OMNIBOX,
+        network::GetNoOpNetworkRestrictionsId(), true);
+  if (!weak || !original) return false;
+  if (target_resolver_.Run() != original.get() ||
+      original->GetLastCommittedURL() != expected_url ||
+      !document.AsRenderFrameHostIfValid() ||
+      document.AsRenderFrameHostIfValid() != original->GetPrimaryMainFrame()) return false;
+  if (auto* predictor = predictors::AutocompleteActionPredictorFactory::GetForProfile(profile_))
+    predictor->StartPrerendering(url, *original);
+  return true;
+}
+
+void AuxOmniboxHandler::OnResultChanged(AutocompleteController* controller,
+                                        bool default_match_changed) {
+  if (!live_ || !TargetIsCurrent()) return;
+  const auto& result = controller->result();
+  const auto sequence = result.sequence_id();
+  base::ListValue items;
+  auto* bookmarks = BookmarkModelFactory::GetForBrowserContext(profile_);
+  size_t index = 0;
+  for (const auto& match : result) {
+    const size_t native_index = index++;
+    if (match.ShouldHideBasedOnStarterPack(client()->GetTemplateURLService()) || !match.destination_url.is_valid() ||
+        !(match.destination_url.SchemeIsHTTPOrHTTPS() ||
+          match.destination_url.SchemeIs("chrome") ||
+          match.destination_url.SchemeIs("about"))) continue;
+    const auto native_type = AutocompleteMatchType::ToString(match.type);
+    const std::string type = AutocompleteMatch::IsSearchType(match.type) ? "search"
+        : bookmarks && bookmarks->IsBookmarked(match.destination_url) ? "bookmark"
+        : native_type.find("history") != std::string::npos ? "history"
+        : native_type.find("tab") != std::string::npos ? "tab" : "typed";
+    base::DictValue item;
+    item.Set("id", base::NumberToString(current_query_id_) + ":" +
+        base::NumberToString(sequence) + ":" + base::NumberToString(native_index));
+    item.Set("index", static_cast<int>(native_index));
+    item.Set("type", type);
+    item.Set("url", match.destination_url.spec());
+    const auto title = match.contents.empty() ? match.fill_into_edit : match.contents;
+    item.Set("title", title.empty() ? match.destination_url.spec() : base::UTF16ToUTF8(title));
+    if (!match.description.empty())
+      item.Set("description", base::UTF16ToUTF8(match.description));
+    items.Append(std::move(item));
+  }
+  base::DictValue update;
+  update.Set("queryId", current_query_id_);
+  update.Set("sequenceId", static_cast<double>(sequence));
+  update.Set("input", base::UTF16ToUTF8(controller->input().text()));
+  update.Set("done", controller->done());
+  update.Set("items", std::move(items));
+  const auto weak = weak_factory_.GetWeakPtr();
+  update_.Run(std::move(update));
+  if (weak) PredictNavigation(result);
+}
+
+void AuxOmniboxHandler::PredictNavigation(const AutocompleteResult& result) {
+  if (!target_ || !TargetIsCurrent() || result.empty()) return;
+  if (auto* preload = SearchPreloadServiceFactory::GetForProfile(profile_))
+    preload->OnAutocompleteResultChanged(target_.get(), result);
+  if (autocomplete_controller()->done()) {
+    if (auto* prefetch = SearchPrefetchServiceFactory::GetForProfile(profile_))
+      prefetch->OnResultChanged(target_.get(), result);
+  }
+  const auto* default_match = result.default_match();
+  if (!default_match) return;
+  const auto& match = *default_match;
+  auto* predictor = predictors::AutocompleteActionPredictorFactory::GetForProfile(profile_);
+  if (!predictor || autocomplete_controller()->input().text().empty()) return;
+  predictor->RegisterTransitionalMatches(autocomplete_controller()->input().text(), result);
+  const auto action = predictor->RecommendAction(
+      autocomplete_controller()->input().text(), match, target_.get());
+  if (action == predictors::AutocompleteActionPredictor::ACTION_PRERENDER &&
+      match.destination_url != target_->GetLastCommittedURL()) {
+    predictor->StartPrerendering(match.destination_url, *target_);
+  } else if (action == predictors::AutocompleteActionPredictor::ACTION_PRECONNECT) {
+    if (auto* loading = predictors::LoadingPredictorFactory::GetForProfile(profile_))
+      loading->PrepareForPageLoad(std::nullopt, match.destination_url,
+          predictors::HintOrigin::OMNIBOX, network::GetNoOpNetworkRestrictionsId(),
+          predictors::AutocompleteActionPredictor::IsPreconnectable(match));
+  }
+}
