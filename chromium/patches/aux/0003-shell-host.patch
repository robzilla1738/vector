 void WebUIBrowserClientView::DraggableRegionsChanged(
     const std::vector<blink::mojom::DraggableRegionPtr>& regions) {
   SkRegion draggable_region;
+  // Union every draggable rect, then subtract every no-drag rect. Blink reports
+  // regions in preorder, so applying each op as it arrives lets a later drag
+  // rect cover a control that already opted out.
+  for (const blink::mojom::DraggableRegionPtr& region : regions) {
+    if (!region->draggable) {
+      continue;
+    }
+    draggable_region.op(
+        SkIRect::MakeXYWH(region->bounds.x(), region->bounds.y(),
+                          region->bounds.width(), region->bounds.height()),
+        SkRegion::kUnion_Op);
+  }
   for (const blink::mojom::DraggableRegionPtr& region : regions) {
+    if (region->draggable) {
