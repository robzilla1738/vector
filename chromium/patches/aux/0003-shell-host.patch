+class AuxStatusBubble final : public StatusBubble {
+ public:
+  explicit AuxStatusBubble(BrowserWindowInterface* browser)
+      : browser_(browser) {}
+
+  void SetStatus(const std::u16string& status) override {
+    status_ = base::UTF16ToUTF8(status);
+    Publish(status_);
+  }
+
+  void SetURL(const GURL& url) override {
+    url_ = url.is_empty() ? std::string() : url.possibly_invalid_spec();
+    Publish(url_.empty() ? status_ : url_);
+  }
+
+  void Hide() override { Publish(""); }
+  void MouseMoved(bool) override {}
+
+ private:
+  void Publish(std::string text) {
+    auto* contents = browser_->GetTabStripModel()->GetActiveWebContents();
+    if (!contents) return;
+    Profile* profile = browser_->GetProfile();
+    const std::string page_id = aux::PageIdentity::GetOrCreate(profile, contents);
+    if (page_id.empty()) return;
+    if (text.size() > 2048) text = base::TruncateUTF8ToByteSize(text, 2048);
+    if (page_id == last_page_id_ && text == last_text_) return;
+    last_page_id_ = page_id;
+    last_text_ = text;
+    base::DictValue payload;
+    payload.Set("pageId", page_id);
+    payload.Set("text", std::move(text));
+    if (auto json = base::WriteJson(payload))
+      aux::EmitShellEvent(profile, "onLinkStatus", std::move(*json));
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::string status_;
+  std::string url_;
+  std::string last_page_id_;
+  std::string last_text_;
+};
+#endif
