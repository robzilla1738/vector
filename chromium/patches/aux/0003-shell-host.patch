diff --git a/chrome/browser/resources/aux_host/aux_host_bootstrap.ts b/chrome/browser/resources/aux_host/aux_host_bootstrap.ts
new file mode 100644
index 0000000..fa3ccd1
--- /dev/null
+++ b/chrome/browser/resources/aux_host/aux_host_bootstrap.ts
@@ -0,0 +1,133 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {ShellHostClientReceiver, ShellHostFactory, ShellHostRemote, WindowKind} from './shell_host.mojom-webui.js';
+import {featureStagesFor} from './aux_feature_stages.js';
+interface Port {
+  host: 'chromium-fork';
+  windowId: string;
+  profileId: string;
+  platform: string;
+  privateMode: boolean;
+  windowKind: 'normal'|'private'|'little'|'quick-ask';
+  capabilities: {buildId: string; sourceCommit: string; methods: string[];
+                 testClockScale?: number; nativePerformance?: boolean};
+  featureStages: ReturnType<typeof featureStagesFor>;
+  testClockScale?: number;
+  performanceCommit?: (queryId: number) => Promise<void>;
+  request(method: string, args: unknown[]): Promise<unknown>;
+  subscribe(event: string, callback: (...args: unknown[]) => void): () => void;
+}
+
+declare global {
+  interface Window {
+    auxChromiumHost?: Port;
+    auxChromiumHostReady?: Promise<void>;
+  }
+}
+
+const remote = new ShellHostRemote();
+const listeners = new Map<string, Set<(...args: unknown[]) => void>>();
+const hostEvents = new Set([
+  'onEvent', 'onOmniboxResult', 'onTabsPatch', 'onDictation', 'onSidebarEdge', 'onToolbarEdge',
+  'onOrganizationChanged', 'onShortcut', 'onSiteZoomChanged',
+  'onRuntimeStatus', 'onLoading', 'onAudio', 'onDownload',
+  'onHttpAuthChanged', 'onTabsPlacement', 'onQuickAskState',
+  'onPageAction', 'onVaultOffer', 'onLinkStatus', 'onTranslationChanged',
+  'onRunAttentionActivated',
+  'onPictureInPicture', 'onExtensionActionsChanged', 'onSidePanel',
+  'onFocusSpace', 'onRoutedOpen', 'onRoutePrompt',
+]);
+const client = new ShellHostClientReceiver({
+  onEvent(eventName: string, payloadJson: string) {
+    if (!hostEvents.has(eventName)) return;
+    let payload: unknown;
+    try {
+      payload = JSON.parse(payloadJson);
+    } catch {
+      return;
+    }
+    for (const listener of listeners.get(eventName) ?? []) {
+      listener(payload);
+    }
+  },
+});
+ShellHostFactory.getRemote().createShellHost(
+    remote.$.bindNewPipeAndPassReceiver(), client.$.bindNewPipeAndPassRemote());
+
+window.auxChromiumHostReady = remote.getIdentity().then(async identity => {
+  if (!identity.windowId || !identity.profileId) {
+    throw new Error('The Aux browser rejected this shell document.');
+  }
+  const capabilityResponse = await remote.request('capabilities', '[]');
+  if (!capabilityResponse.ok) {
+    throw new Error(`Aux capabilities are unavailable: ${capabilityResponse.errorCode}`);
+  }
+  const capabilities = JSON.parse(capabilityResponse.resultJson) as
+      {buildId: string; sourceCommit: string; methods: string[];
+       testClockScale?: number; nativePerformance?: boolean};
+  if (!capabilities.buildId || !/^[a-f0-9]{40}(\+dirty)?$/.test(capabilities.sourceCommit) ||
+      !Array.isArray(capabilities.methods) ||
+      !capabilities.methods.every(method => typeof method === 'string') ||
+      (capabilities.testClockScale !== undefined &&
+       (typeof capabilities.testClockScale !== 'number' ||
+        !Number.isFinite(capabilities.testClockScale) ||
+        capabilities.testClockScale < 1 || capabilities.testClockScale > 100000))) {
+    throw new Error('The Aux browser returned invalid capabilities.');
+  }
+  if (capabilities.nativePerformance !== undefined && typeof capabilities.nativePerformance !== "boolean") {
+    throw new Error("The Aux browser returned invalid benchmark metadata.");
+  }
+  const featureStages = featureStagesFor(capabilities.methods);
+  const windowKinds: Record<WindowKind, Port['windowKind']> = {
+    [WindowKind.kNormal]: 'normal',
+    [WindowKind.kPrivate]: 'private',
+    [WindowKind.kLittle]: 'little',
+    [WindowKind.kQuickAsk]: 'quick-ask',
+  };
+  window.auxChromiumHost = {
+    host: 'chromium-fork',
+    windowId: identity.windowId,
+    profileId: identity.profileId,
+    platform: 'darwin',
+    privateMode: identity.privateMode,
+    windowKind: windowKinds[identity.windowKind],
+    capabilities,
+    featureStages,
+    ...(capabilities.nativePerformance === true ? {
+      async performanceCommit(queryId: number) {
+        if (!Number.isSafeInteger(queryId) || queryId <= 0) return;
+        const response = await remote.request("performance.commitQuery", JSON.stringify([queryId]));
+        if (!response.ok) throw new Error(`${response.errorCode}: ${response.errorMessage}`);
+      },
+    } : {}),
+    ...(capabilities.testClockScale !== undefined ?
+        {testClockScale: capabilities.testClockScale} : {}),
+    async request(method, args) {
+      // Optional versions are omitted on activation. JSON arrays encode an
+      // explicit undefined as null, which is not a valid catalog version.
+      const commandArgs = args.length === 2 && args[1] === undefined ?
+          args.slice(0, 1) : args;
+      const requestArgs = method === 'tabCommand' ?
+          [crypto.randomUUID(), ...commandArgs] : args;
+      const response = await remote.request(method, JSON.stringify(requestArgs));
+      if (!response.ok) {
+        throw new Error(`${response.errorCode}: ${response.errorMessage}`);
+      }
+      return JSON.parse(response.resultJson);
+    },
+    subscribe(event, callback) {
+      if (!hostEvents.has(event)) return () => {};
+      const callbacks = listeners.get(event) ?? new Set();
+      callbacks.add(callback);
+      listeners.set(event, callbacks);
+      return () => {
+        callbacks.delete(callback);
+        if (callbacks.size === 0) {
+          listeners.delete(event);
+        }
+      };
+    },
+  };
+});
diff --git a/chrome/browser/ui/aux/shell_warmup_manager.cc b/chrome/browser/ui/aux/shell_warmup_manager.cc
new file mode 100644
index 0000000..756dac4
--- /dev/null
+++ b/chrome/browser/ui/aux/shell_warmup_manager.cc
@@ -0,0 +1,152 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/shell_warmup_manager.h"
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/time/time.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "chrome/browser/profiles/keep_alive/profile_keep_alive_types.h"
+#include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_attributes_entry.h"
+#include "chrome/browser/profiles/profile_attributes_storage.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "content/public/browser/browser_task_traits.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_process_host.h"
+
+namespace aux {
+namespace {
+ShellWarmupManager* g_manager = nullptr;
+constexpr base::MemoryConsumerTraits kTraits(
+    base::MemoryConsumerTraits::ConsumerType::kPassive,
+    base::MemoryConsumerTraits::InProcess::kNo);
+}  // namespace
+
+ShellWarmupManager::ShellWarmupManager()
+    : memory_registration_("AuxShellWarmupManager", kTraits, this) {
+  CHECK(!g_manager);
+  g_manager = this;
+  content::SpareRenderProcessHostManager::Get().AddObserver(this);
+}
+
+ShellWarmupManager::~ShellWarmupManager() {
+  g_manager = nullptr;
+  content::SpareRenderProcessHostManager::Get().RemoveObserver(this);
+  manager_observation_.Reset();
+  ReleaseProfile();
+}
+
+ShellWarmupManager* ShellWarmupManager::Get() {
+  return g_manager;
+}
+
+void ShellWarmupManager::UseProfile(Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile || !profile->IsRegularProfile() || profile->ShutdownStarted() ||
+      browser_shutdown::IsTryingToQuit() ||
+      browser_shutdown::HasShutdownStarted()) {
+    return;
+  }
+  auto* manager = g_browser_process->profile_manager();
+  auto* entry = manager->GetProfileAttributesStorage()
+                    .GetProfileAttributesWithPath(profile->GetPath());
+  // Do not change the existing lifetime of ephemeral profiles.
+  if (!entry || entry->IsEphemeral()) {
+    return;
+  }
+  if (profile_keep_alive_ && profile_keep_alive_->profile() == profile) {
+    ScheduleRefill();
+    return;
+  }
+  auto keep_alive = ScopedProfileKeepAlive::TryAcquire(
+      profile, ProfileKeepAliveOrigin::kAuxShellWarmup);
+  if (!keep_alive) {
+    return;
+  }
+  ReleaseProfile();
+  profile_keep_alive_ = std::move(keep_alive);
+  profile_observation_.Observe(profile);
+  if (!manager_observation_.IsObserving()) {
+    manager_observation_.Observe(manager);
+  }
+  ScheduleRefill();
+}
+
+bool ShellWarmupManager::CanWarm() const {
+  return profile_keep_alive_ && profile_keep_alive_->profile() &&
+         !profile_keep_alive_->profile()->ShutdownStarted() &&
+         !browser_shutdown::IsTryingToQuit() &&
+         !browser_shutdown::HasShutdownStarted() &&
+         memory_limit() > base::MemoryLimit::ModeratePressureThreshold() &&
+         !content::RenderProcessHost::IsProcessLimitReached();
+}
+
+void ShellWarmupManager::ScheduleRefill() {
+  if (refill_pending_ || !CanWarm()) {
+    return;
+  }
+  refill_pending_ = true;
+  // Avoid the first frame and yield to interactive browser work. The browser
+  // scheduler owns BEST_EFFORT execution; no polling timer or hidden shell runs.
+  content::GetUIThreadTaskRunner({base::TaskPriority::BEST_EFFORT})
+      ->PostDelayedTask(FROM_HERE,
+                        base::BindOnce(&ShellWarmupManager::Refill,
+                                       weak_factory_.GetWeakPtr()),
+                        base::Seconds(5));
+}
+
+void ShellWarmupManager::OnUpdateMemoryLimit() {
+  ScheduleRefill();
+}
+
+void ShellWarmupManager::Refill() {
+  refill_pending_ = false;
+  if (!CanWarm()) {
+    return;
+  }
+  auto& spare_manager = content::SpareRenderProcessHostManager::Get();
+  // Do not evict another Profile's spare or turn competing warmup clients
+  // into a refill loop. Existing matching spares are already sufficient.
+  if (!spare_manager.GetSpares().empty()) {
+    return;
+  }
+  spare_manager.WarmupSpare(profile_keep_alive_->profile());
+}
+
+void ShellWarmupManager::ReleaseProfile() {
+  weak_factory_.InvalidateWeakPtrs();
+  refill_pending_ = false;
+  profile_observation_.Reset();
+  profile_keep_alive_.reset();
+}
+
+void ShellWarmupManager::OnProfileWillBeDestroyed(Profile* profile) {
+  ReleaseProfile();
+}
+
+void ShellWarmupManager::OnProfileMarkedForPermanentDeletion(Profile* profile) {
+  if (profile_keep_alive_ && profile_keep_alive_->profile() == profile) {
+    ReleaseProfile();
+  }
+}
+
+void ShellWarmupManager::OnProfileManagerDestroying() {
+  manager_observation_.Reset();
+  ReleaseProfile();
+}
+
+void ShellWarmupManager::OnSpareRenderProcessHostRemoved(
+    content::RenderProcessHost* host) {
+  if (profile_keep_alive_ &&
+      host->GetBrowserContext() == profile_keep_alive_->profile()) {
+    ScheduleRefill();
+  }
+}
+
+}  // namespace aux
