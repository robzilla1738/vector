+#ifndef CHROME_BROWSER_UI_AUX_TASK_ATTENTION_MAC_H_
+#define CHROME_BROWSER_UI_AUX_TASK_ATTENTION_MAC_H_
+#include <cstddef>
+namespace base { class UnguessableToken; }
+namespace aux {
+// Counts belong to actual native attention states and are removed on retirement.
+void SetTaskAttentionBadge(const base::UnguessableToken& owner, size_t count);
+void PlayTaskCompletionSound(const base::UnguessableToken& owner);
+}  // namespace aux
