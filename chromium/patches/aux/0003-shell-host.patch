+void WebUIBrowserUI::CreateShellHost(
+    mojo::PendingReceiver<aux::mojom::ShellHost> host,
+    mojo::PendingRemote<aux::mojom::ShellHostClient> client) {
+  if (dictation_) {
+    dictation_->CancelAll();
+  }
+  evidence_document_selection_.reset();
+  shell_host_receiver_.reset();
+  shell_host_client_.reset();
+  tab_catalog_subscription_ = {};
+  runtime_event_subscription_ = {};
+  shell_events_subscription_ = {};
+  organization_pref_registrar_.reset();
+  edge_monitor_.reset();
+  if (IsAuthorizedAuxDocument()) {
+    shell_host_receiver_.Bind(std::move(host));
+    shell_host_client_.Bind(std::move(client));
+    shell_host_client_.set_disconnect_handler(base::BindOnce(
+        [](base::WeakPtr<WebUIBrowserUI> ui) {
+          if (ui && ui->dictation_) {
+            ui->dictation_->CancelAll();
+          }
+          if (ui) {
+            ui->shell_host_receiver_.reset();
+            ui->shell_host_client_.reset();
+          }
+        },
+        weak_factory_.GetWeakPtr()));
+    if (!browser_->GetProfile()->IsOffTheRecord()) {
+      organization_pref_registrar_ = std::make_unique<PrefChangeRegistrar>();
+      organization_pref_registrar_->Init(browser_->GetProfile()->GetPrefs());
+      organization_pref_registrar_->Add(
+          aux::kOrganizationPref,
+          base::BindRepeating([](base::WeakPtr<WebUIBrowserUI> ui) {
+            if (!ui || !ui->IsAuthorizedAuxDocument() ||
+                !ui->shell_host_client_.is_bound()) {
+              return;
+            }
+            const int revision =
+                ui->browser_->GetProfile()->GetPrefs()
+                    ->GetDict(aux::kOrganizationPref)
+                    .FindInt("revision")
+                    .value_or(0);
+            ui->shell_host_client_->OnEvent(
+                "onOrganizationChanged", base::NumberToString(revision));
+          }, weak_factory_.GetWeakPtr()));
+    }
+    edge_monitor_ = std::make_unique<AuxShellEdgeMonitor>(
+        browser_window(),
+        base::BindRepeating(
+            [](base::WeakPtr<WebUIBrowserUI> ui, bool sidebar,
+               bool toolbar) {
+              if (!ui || !ui->IsAuthorizedAuxDocument() ||
+                  !ui->shell_host_client_.is_bound()) {
+                return;
+              }
+              ui->shell_host_client_->OnEvent("onSidebarEdge",
+                                               sidebar ? "true" : "false");
+              ui->shell_host_client_->OnEvent("onToolbarEdge",
+                                               toolbar ? "true" : "false");
+            },
+            weak_factory_.GetWeakPtr()));
+    if (auto* catalog = aux::TabCatalog::GetForProfile(browser_->GetProfile())) {
+      tab_catalog_subscription_ = catalog->ObserveChanges(base::BindRepeating(
+          [](base::WeakPtr<WebUIBrowserUI> ui, const std::string& patch) {
+            if (ui && ui->IsAuthorizedAuxDocument() &&
+                ui->shell_host_client_.is_bound()) {
+              ui->shell_host_client_->OnEvent("onTabsPatch", patch);
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+    }
+    if (auto* runtime = AuxRuntimeHost::ForProfile(browser_->GetProfile())) {
+      runtime_event_subscription_ = runtime->ObserveEvents(
+          base::BindRepeating([](base::WeakPtr<WebUIBrowserUI> ui,
+                                 const std::string& event_name,
+                                 const std::string& payload_json) {
+            if (ui && ui->IsAuthorizedAuxDocument() &&
+                ui->shell_host_client_.is_bound()) {
+              ui->shell_host_client_->OnEvent(event_name, payload_json);
+            }
+          }, weak_factory_.GetWeakPtr()));
+    }
+    shell_events_subscription_ = aux::ObserveShellEvents(
+        browser_->GetProfile(),
+        base::BindRepeating([](base::WeakPtr<WebUIBrowserUI> ui,
+                               const std::string& event_name,
+                               const std::string& payload_json) {
+          if (ui && ui->IsAuthorizedAuxDocument() &&
+              ui->shell_host_client_.is_bound()) {
+            if (event_name == "onVaultOffer" ||
+                event_name == "onLinkStatus") {
+              auto payload = base::JSONReader::Read(payload_json,
+                                                    base::JSON_PARSE_RFC);
+              const std::string* page_id = payload && payload->is_dict()
+                  ? payload->GetDict().FindString("pageId") : nullptr;
+              BrowserWindowInterface* owner = nullptr;
+              auto* catalog = aux::TabCatalog::GetForProfile(
+                  ui->browser_->GetProfile());
+              if (!page_id || !catalog ||
+                  !catalog->FindPage(*page_id, &owner) ||
+                  owner != ui->browser_) {
+                return;
+              }
+            }
+            ui->shell_host_client_->OnEvent(event_name, payload_json);
+          }
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+}
+
+bool WebUIBrowserUI::IsAuthorizedAuxDocument() const {
+  const content::RenderFrameHost* frame = web_ui()->GetRenderFrameHost();
+  content::WebContents* contents = web_ui()->GetWebContents();
+  WebUIBrowserWindow* window =
+      WebUIBrowserWindow::FromWebShellWebContents(contents);
+  return frame &&
+         frame->GetLastCommittedURL().SchemeIs(content::kChromeUIScheme) &&
+         frame->GetLastCommittedURL().host() ==
+             chrome::kChromeUIAuxHost &&
+         window && browser_ && window->browser() == browser_ &&
+         Profile::FromWebUI(web_ui()) == browser_->GetProfile();
+}
+
+void WebUIBrowserUI::GetIdentity(GetIdentityCallback callback) {
+  if (!IsAuthorizedAuxDocument()) {
+    std::move(callback).Run("", "", true, aux::mojom::WindowKind::kPrivate);
+    return;
+  }
+  Profile* profile = browser_->GetProfile();
+  std::move(callback).Run(
+      base::NumberToString(browser_->GetSessionID().id()),
+      AuxRuntimeHost::ProfileId(profile), profile->IsOffTheRecord(),
+      profile->IsOffTheRecord()         ? aux::mojom::WindowKind::kPrivate
+      : aux::IsQuickAskWindow(browser_) ? aux::mojom::WindowKind::kQuickAsk
+      : aux::IsLittleWindow(browser_)   ? aux::mojom::WindowKind::kLittle
+                                        : aux::mojom::WindowKind::kNormal);
+}
+
+void WebUIBrowserUI::Request(const std::string& method,
+                             const std::string& args_json,
+                             RequestCallback callback) {
+  if (!IsAuthorizedAuxDocument()) {
+    std::move(callback).Run(false, "", "forbidden",
+                            "This Aux shell document is not authorized.");
+    return;
+  }
+  if (args_json.size() > 1024 * 1024) {
+    std::move(callback).Run(false, "", "invalid_argument",
+                            "Aux shell arguments are too large");
+    return;
+  }
+  const auto args = base::JSONReader::Read(args_json, base::JSON_PARSE_RFC);
+  const base::ListValue* list = args ? args->GetIfList() : nullptr;
+  if (!list) {
+    std::move(callback).Run(false, "", "invalid_argument",
+                            "Aux shell arguments must be an array");
+    return;
+  }
+  const auto& registry = aux::AuxMethodRegistry::Get();
+  if (method == "capabilities") {
+    if (!list->empty()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "Capabilities take no arguments");
+      return;
+    }
+    auto* host = AuxRuntimeHost::ForProfile(browser_->GetProfile());
+    if (!host) {
+      std::move(callback).Run(false, "", "backend_unavailable",
+                              "This browser Profile is closing");
+      return;
+    }
+    auto capabilities = host->Capabilities();
+    if (NativePerformance::Enabled()) capabilities.Set("nativePerformance", true);
+    std::move(callback).Run(true, *base::WriteJson(capabilities), "", "");
+    return;
+  }
+  // Disposable-profile telemetry cannot be invoked through the runtime API.
+  // Its clock and window are taken from original native input ownership.
+  if (method == "performance.commitQuery" && NativePerformance::Enabled()) {
+    const auto query = list->size() == 1 ? (*list)[0].GetIfInt() : std::nullopt;
+    auto* window = WebUIBrowserWindow::FromWebShellWebContents(
+        web_ui()->GetWebContents());
+    auto* observer = window ? NativePerformance::ForWidget(window->widget()) : nullptr;
+    if (!query || *query <= 0 || !observer || !browser_->IsActive()) {
+      std::move(callback).Run(false, "", "invalid_argument",
+                              "The original benchmark query is unavailable.");
+      return;
+    }
+    observer->CommitQuery(*query);
+    std::move(callback).Run(true, "null", "", "");
+    return;
+  }
+  std::string validation_error;
+  if (method != "invoke" &&
+      !registry.Validate(method, base::Value(list->Clone()),
+                         &validation_error)) {
+    std::move(callback).Run(false, "", "invalid_argument", validation_error);
+    return;
+  }
+  if (method == "auth.confirm") {
+    if (!aux_device_confirmation_) {
+      aux_device_confirmation_ = std::make_unique<AuxDeviceConfirmation>(
+          browser_->GetProfile(), browser_, web_ui()->GetWebContents(),
+          base::BindRepeating([](base::WeakPtr<WebUIBrowserUI> ui) {
+            return ui && ui->IsAuthorizedAuxDocument() && ui->browser_->IsActive();
+          }, weak_factory_.GetWeakPtr()));
+    }
+    aux_device_confirmation_->Confirm((*list)[0].GetDict(), std::move(callback));
+    return;
+  }
+  if (method == "omnibox.start" || method == "omnibox.stop" ||
+      method == "omnibox.open" || method == "preloadNavigation") {
+    if (!aux_omnibox_handler_) {
+      aux_omnibox_handler_ = std::make_unique<AuxOmniboxHandler>(
+          browser_->GetProfile(), web_ui()->GetWebContents(),
+          base::BindRepeating([](base::WeakPtr<WebUIBrowserUI> ui)
+              -> content::WebContents* {
+            if (!ui || !ui->IsAuthorizedAuxDocument()) return nullptr;
+            return ui->browser_->GetTabStripModel()->GetActiveWebContents();
+          }, weak_factory_.GetWeakPtr()),
+          base::BindRepeating([](base::WeakPtr<WebUIBrowserUI> ui,
+                                 base::DictValue result) {
+            if (!ui || !ui->IsAuthorizedAuxDocument() ||
+                !ui->shell_host_client_.is_bound()) return;
+            ui->shell_host_client_->OnEvent("onOmniboxResult",
+                *base::WriteJson(result));
+          }, weak_factory_.GetWeakPtr()));
+    }
+    bool accepted = false;
+    if (method == "omnibox.stop") {
+      accepted = aux_omnibox_handler_->Stop(static_cast<int>((*list)[0].GetDouble()));
+    } else {
+      const auto& params = (*list)[0].GetDict();
+      if (method == "preloadNavigation") {
+        accepted = aux_omnibox_handler_->Hint(*params.FindString("pageId"),
+            GURL(*params.FindString("expectedUrl")), GURL(*params.FindString("url")));
+      } else if (method == "omnibox.start") {
+        accepted = aux_omnibox_handler_->Start(static_cast<int>(*params.FindDouble("queryId")),
+            base::UTF8ToUTF16(*params.FindString("input")),
+            *params.FindBool("onFocus"));
+      } else {
+        const auto& requested = *params.FindString("disposition");
+        const auto disposition = requested == "current-tab"
+            ? WindowOpenDisposition::CURRENT_TAB
+            : requested == "new-background-tab"
+                ? WindowOpenDisposition::NEW_BACKGROUND_TAB
+                : WindowOpenDisposition::NEW_FOREGROUND_TAB;
+        accepted = aux_omnibox_handler_->Open(static_cast<int>(*params.FindDouble("queryId")),
+            params.FindDict("match"), disposition);
+      }
+    }
+    std::move(callback).Run(true, *base::WriteJson(base::Value(accepted)), "", "");
+    return;
+  }
+  const auto group = registry.ShellGroup(method);
+  switch (group) {
+    case aux::AuxShellMethodGroup::kContent:
+      HandleAuxContentRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kCredentials:
+      HandleAuxCredentialsRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kDictation:
+      HandleAuxDictationRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kBlocking:
+      HandleAuxBlockingRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kRecovery:
+      HandleAuxRecoveryRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kProfiles:
+      HandleAuxProfilesRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kPageControls:
+      HandleAuxPageControlsRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kExtensions:
+      HandleAuxExtensionsRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kLibrary:
+      HandleAuxLibraryRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kSurfaces:
+      HandleAuxSurfacesRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kTabs:
+      HandleAuxTabsRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kHealth:
+      HandleAuxHealthRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kWindow:
+      HandleAuxWindowRequest(method, *list, std::move(callback));
+      return;
+    case aux::AuxShellMethodGroup::kNone:
+      break;
+  }
+  if (method != "invoke") {
+    std::move(callback).Run(false, "", "not_found",
+                            "Unsupported Aux shell method: " + method);
+    return;
+  }
+  if (!list || list->size() < 1 || list->size() > 2 ||
+      !(*list)[0].is_string() || (*list)[0].GetString().empty() ||
+      (*list)[0].GetString().size() > 128) {
+    std::move(callback).Run(false, "", "invalid_argument",
+                            "Invalid Aux shell invocation");
+    return;
+  }
+  const base::Value params =
+      list->size() == 2 ? (*list)[1].Clone() : base::Value();
+  const auto params_json = base::WriteJson(params);
+  if (!params_json) {
+    std::move(callback).Run(false, "", "invalid_argument",
+                            "Invalid Aux API arguments");
+    return;
+  }
+  AuxRuntimeHost* host = AuxRuntimeHost::ForProfile(browser_->GetProfile());
+  if (!host) {
+    std::move(callback).Run(false, "", "forbidden",
+                            "This Profile runtime is unavailable");
+    return;
+  }
+  auto reply = base::BindOnce(
+          [](RequestCallback callback, AuxRuntimeHost::Response response) {
+            std::move(callback).Run(response.ok, response.result_json,
+                                    response.error_code,
+                                    response.error_message);
+          },
+          std::move(callback));
+  const auto& api_method = (*list)[0].GetString();
+  if (api_method == "runs.start" || api_method == "runs.reconcileStart" || api_method == "runs.useLocalExecution" || api_method == "runs.retryCloudSetup" || api_method == "tasks.start" ||
+      api_method == "runs.retry" || api_method == "runs.branch" ||
+      api_method == "runs.branch.list" ||
+      api_method == "runs.answer" || api_method == "runs.continueBudget" ||
+      api_method == "runs.retryModelSetup" ||
+      api_method == "coding.undo" || api_method == "coding.preview" ||
+      api_method == "coding.previewClose" ||
+      api_method == "coding.worktreeInspect" ||
+      api_method == "coding.worktreeArchive" ||
+      api_method == "packages.install" || api_method == "packages.remove" ||
+      api_method == "packages.defaults" ||
+      api_method == "agent.images.generate" || api_method == "agent.pageSummary" ||
+      api_method == "customization.css.propose" ||
+      api_method == "agent.utility.intent" || api_method == "agent.tidy.propose" ||
+      api_method == "agent.tabName.suggest" || api_method == "routines.skills.preview" || api_method == "routines.skills.import" || api_method == "import.preview" || api_method == "import.selectExport" || api_method == "import.extensions.review" || api_method == "import.selectWindow" || api_method == "import.exportStatus" ||
+      api_method == "import.cancelExport" || api_method == "import.run" ||
+        api_method == "import.status" || api_method == "import.cancel" ||
+        api_method == "settings.set" || api_method == "models.auth.start" ||
+      api_method == "models.auth.status" || api_method == "models.auth.cancel" ||
+      api_method == "models.auth.accounts" || api_method == "models.auth.disconnect" ||
+      api_method == "models.copilot.setup" || api_method == "models.copilot.install" ||
+      api_method == "models.copilot.start" || api_method == "models.copilot.status" ||
+      api_method == "models.copilot.cancel" || api_method == "models.copilot.accounts" ||
+      api_method == "models.copilot.disconnect" || api_method == "models.copilot.catalog" ||
+        api_method == "settings.remoteDebugging.get" || api_method == "settings.remoteDebugging.set" ||
+      api_method == "projects.files" || api_method == "projects.file" || api_method == "projects.changes" ||
+      api_method == "settings.cloud.status" || api_method == "settings.cloud.configure" ||
+      api_method == "settings.cloud.clear" || api_method == "agentConnections.install" || api_method == "developer.cli.install" || api_method == "terminal.listeners" || api_method == "terminal.preview" || api_method == "terminal.previewClose" || api_method == "terminal.start" ||
+      api_method == "terminal.read" || api_method == "terminal.input" ||
+      api_method == "terminal.resize" || api_method == "terminal.close")
+    host->CallApiFromWindow(browser_->GetWeakPtr(), web_ui()->GetRenderFrameHost()->GetWeakDocumentPtr(),
+        api_method, *params_json, std::move(reply));
+  else
+    host->CallApi(api_method, *params_json, std::move(reply));
+}
