diff --git a/chrome/browser/ui/aux/task_attention_mac.mm b/chrome/browser/ui/aux/task_attention_mac.mm
new file mode 100644
index 0000000..fb9c230
--- /dev/null
+++ b/chrome/browser/ui/aux/task_attention_mac.mm
@@ -0,0 +1,89 @@
+// Copyright 2026 The Aux Authors. BSD-3-Clause.
+#include "chrome/browser/ui/aux/task_attention_mac.h"
+#import <Cocoa/Cocoa.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <map>
+#include <numbers>
+#include <vector>
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/unguessable_token.h"
+namespace aux {
+namespace {
+struct Attention {
+  size_t count = 0;
+  NSSound* __strong sound = nil;
+};
+std::map<base::UnguessableToken, Attention>& AttentionStates() {
+  static base::NoDestructor<std::map<base::UnguessableToken, Attention>> states;
+  return *states;
+}
+NSSound* MakeCompletionSound() {
+  // Aux-authored ascending two-note chime: 400 ms, mono PCM, gentle attack and
+  // release. It uses no system alert, downloaded asset or recorded user audio.
+  constexpr uint32_t rate = 44100;
+  constexpr uint32_t samples = rate * 2 / 5;
+  std::vector<uint8_t> wave;
+  wave.reserve(44 + samples * 2);
+  const auto u16 = [&](uint16_t value) {
+    wave.push_back(value & 255);
+    wave.push_back(value >> 8);
+  };
+  const auto u32 = [&](uint32_t value) {
+    u16(value & 65535);
+    u16(value >> 16);
+  };
+  const auto tag = [&](char a, char b, char c, char d) {
+    wave.push_back(a); wave.push_back(b); wave.push_back(c); wave.push_back(d);
+  };
+  tag('R', 'I', 'F', 'F'); u32(36 + samples * 2);
+  tag('W', 'A', 'V', 'E'); tag('f', 'm', 't', ' '); u32(16);
+  u16(1); u16(1); u32(rate); u32(rate * 2); u16(2); u16(16);
+  tag('d', 'a', 't', 'a'); u32(samples * 2);
+  for (uint32_t i = 0; i < samples; ++i) {
+    const double time = static_cast<double>(i) / rate;
+    const double start = time < 0.16 ? 0.0 : 0.16;
+    const double duration = time < 0.16 ? 0.14 : 0.24;
+    const double position = time - start;
+    const double envelope = std::clamp(
+        std::min(position / 0.012, (duration - position) / 0.065), 0.0, 1.0);
+    const double frequency = time < 0.16 ? 523.25 : 659.25;
+    const double phase = 2 * std::numbers::pi * frequency * position;
+    const auto sample = static_cast<int16_t>(
+        16384 * envelope * (std::sin(phase) + 0.15 * std::sin(phase * 2)));
+    u16(static_cast<uint16_t>(sample));
+  }
+  NSData* data = [NSData dataWithBytes:wave.data() length:wave.size()];
+  return [[NSSound alloc] initWithData:data];
+}
+}  // namespace
+void SetTaskAttentionBadge(const base::UnguessableToken& owner, size_t count) {
+  auto& states = AttentionStates();
+  if (count) {
+    states[owner].count = count;
+  } else {
+    const auto found = states.find(owner);
+    if (found != states.end()) {
+      [found->second.sound stop];
+      states.erase(found);  // ARC releases the state's exact retained sound.
+    }
+  }
+  size_t total = 0;
+  for (const auto& [id, state] : states) total += state.count;
+  NSDockTile* tile = NSApplication.sharedApplication.dockTile;
+  tile.badgeLabel = total ? base::SysUTF8ToNSString(base::NumberToString(total)) : nil;
+  [tile display];
+}
+void PlayTaskCompletionSound(const base::UnguessableToken& owner) {
+  auto& states = AttentionStates();
+  const auto found = states.find(owner);
+  if (found == states.end()) return;
+  [found->second.sound stop];
+  found->second.sound = MakeCompletionSound();
+  found->second.sound.volume = 0.35f;
+  [found->second.sound play];
+}
+}  // namespace aux
