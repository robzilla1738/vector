+void WebUIBrowserUI::MultiFilesSelected(
+    const std::vector<ui::SelectedFileInfo>& files) {
+  scoped_refptr<ui::SelectFileDialog> dialog = std::move(open_file_dialog_);
+  auto callback = std::move(file_dialog_callback_);
+  const auto purpose =
+      std::exchange(file_dialog_purpose_, FileDialogPurpose::kNone);
+  if (purpose != FileDialogPurpose::kEvidenceDocuments ||
+      !evidence_document_selection_ ||
+      !EvidenceDocumentsCurrent(evidence_document_selection_->id)) {
+    evidence_document_selection_.reset();
+    std::move(callback).Run(false, "", "ref_stale",
+                            "Original document selection is unavailable");
+    return;
+  }
+  if (files.empty()) {
+    evidence_document_selection_.reset();
+    std::move(callback).Run(true, "null", "", "");
+    return;
+  }
+  auto& selection = *evidence_document_selection_;
+  selection.paths.reserve(files.size());
+  for (const auto& file : files) {
+    selection.paths.push_back(file.path());
+  }
+  if (!selection.paths.front().empty()) {
+    browser_->GetProfile()->set_last_selected_directory(
+        selection.paths.front().DirName());
+  }
+  base::DictValue result;
+  result.Set("selectionId", selection.id);
+  result.Set("count", static_cast<double>(selection.paths.size()));
+  std::move(callback).Run(true, *base::WriteJson(result), "", "");
+}
+
+void WebUIBrowserUI::ReadAuxEvidenceDocument(const std::string& selection_id,
+                                             double index,
+                                             RequestCallback callback) {
+  if (!EvidenceDocumentsCurrent(selection_id)) {
+    if (evidence_document_selection_ &&
+        evidence_document_selection_->id == selection_id) {
+      evidence_document_selection_.reset();
+    }
+    std::move(callback).Run(false, "", "ref_stale",
+                            "Original document selection is unavailable");
+    return;
+  }
+  auto& selection = *evidence_document_selection_;
+  if (!std::isfinite(index) || index < 0 || std::floor(index) != index ||
+      index > 9007199254740991.0 ||
+      index >= static_cast<double>(selection.paths.size())) {
+    std::move(callback).Run(false, "", "invalid_argument",
+                            "Document selection index is out of range");
+    return;
+  }
+  if (selection.reading) {
+    std::move(callback).Run(false, "", "conflict",
+                            "A document read is already in progress");
+    return;
+  }
+  selection.reading = true;
+  const base::FilePath path = selection.paths[static_cast<size_t>(index)];
+  const std::string filename =
+      base::UTF16ToUTF8(path.BaseName().LossyDisplayName());
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadAuxEvidence, path, false),
+      base::BindOnce(
+          [](base::WeakPtr<WebUIBrowserUI> self, std::string selection_id,
+             std::string filename, RequestCallback callback,
+             std::optional<std::string> result) {
+            if (!self || !self->EvidenceDocumentsCurrent(selection_id)) {
+              if (self && self->evidence_document_selection_ &&
+                  self->evidence_document_selection_->id == selection_id) {
+                self->evidence_document_selection_.reset();
+              }
+              std::move(callback).Run(
+                  false, "", "ref_stale",
+                  "Original document selection is unavailable");
+              return;
+            }
+            self->evidence_document_selection_->reading = false;
+            std::move(callback).Run(
+                result.has_value(), result.value_or(""),
+                result ? "" : "invalid_argument",
+                result
+                    ? ""
+                    : filename +
+                          ": could not read a UTF-8 text document up to 2 MiB");
+          },
+          weak_factory_.GetWeakPtr(), selection_id, filename,
+          std::move(callback)));
+}
+
+void WebUIBrowserUI::FileSelectionCanceled() {
+  scoped_refptr<ui::SelectFileDialog> dialog = std::move(open_file_dialog_);
+  const auto purpose = file_dialog_purpose_;
+  file_dialog_purpose_ = FileDialogPurpose::kNone;
+  save_file_content_.clear();
+  password_transfer_passphrase_.clear();
+  save_file_source_.clear();
+  save_file_source_size_ = 0;
+  save_pdf_page_id_.clear();
+  save_pdf_document_ = {};
+  if (purpose == FileDialogPurpose::kEvidenceDocuments) {
+    evidence_document_selection_.reset();
+  }
+  if (purpose == FileDialogPurpose::kDownloadFolder) {
+    auto* prefs = DownloadPrefs::FromBrowserContext(browser_->GetProfile());
+    base::DictValue result;
+    result.Set("path", prefs->DownloadPath().AsUTF8Unsafe());
+    result.Set("custom", prefs->DownloadPath() !=
+                             DownloadPrefs::GetDefaultDownloadDirectory());
+    std::move(file_dialog_callback_)
+        .Run(true, *base::WriteJson(base::Value(std::move(result))), "", "");
+    return;
+  }
+  std::move(file_dialog_callback_).Run(true, "null", "", "");
+}
