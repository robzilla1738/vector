+void WebUIBrowserSidePanelUI::CheckGuestNavigation(content::NavigationHandle* navigation) {
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+  const auto key = GetCurrentEntryKey();
+  if (!navigation->IsInPrimaryMainFrame() || !key || !key->extension_id()) return;
+  const GURL& url = navigation->GetURL();
+  if (url.scheme() == "chrome-extension" && url.host() == *key->extension_id()) return;
+  aux::PublishExtensionSidePanel(browser(), false);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+      base::BindOnce(&WebUIBrowserSidePanelUI::CloseNavigatedGuest,
+          weak_factory_.GetWeakPtr(),
+          guest_contents::GuestContentsHandle::CreateForWebContents(web_contents())->id()));
+#endif
+}
+void WebUIBrowserSidePanelUI::DidStartNavigation(content::NavigationHandle* navigation) {
+  CheckGuestNavigation(navigation);
+}
+void WebUIBrowserSidePanelUI::DidRedirectNavigation(content::NavigationHandle* navigation) {
+  CheckGuestNavigation(navigation);
+}
+void WebUIBrowserSidePanelUI::DidFinishNavigation(content::NavigationHandle* navigation) {
+#if BUILDFLAG(ENABLE_AUX_SHELL)
+  if (navigation->IsInPrimaryMainFrame() && navigation->HasCommitted()) {
+    aux::PublishExtensionSidePanel(browser(), true);
+  }
+#endif
+}
+void WebUIBrowserSidePanelUI::CloseNavigatedGuest(base::UnguessableToken content_id) {
+  if (!web_contents() || guest_contents::GuestContentsHandle::CreateForWebContents(
+          web_contents())->id() != content_id) return;
+  Close(SidePanelEntryHideReason::kSidePanelClosed, true);
 }
 
