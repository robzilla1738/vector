+    if (entry == native_cloud_previews_.end()) { std::move(callback).Run(NativeResult(base::Value(base::DictValue().Set("closed", true)))); return; }
+    if (entry->second.token != *token) { fail("Original cloud Preview close owner changed"); return; }
