+void NativePerformance::RecordShellRole() {
+#if BUILDFLAG(IS_MAC)
+  if (!Enabled() || retired_ || !web_contents() || shell_role_recorded_)
+    return;
+  auto* frame = web_contents()->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive() ||
+      !frame->GetLastCommittedURL().SchemeIs("chrome") ||
+      frame->GetLastCommittedURL().host() != "aux")
+    return;
+  const auto pid = frame->GetProcess()->GetProcess().Pid();
+  rusage_info_v0 usage{};
+  if (pid <= 0 ||
+      proc_pid_rusage(pid, RUSAGE_INFO_V0,
+                      reinterpret_cast<rusage_info_t*>(&usage)) != 0 ||
+      !usage.ri_proc_start_abstime || usage.ri_proc_exit_abstime)
+    return;
+  auto json = base::WriteJson(
+      base::DictValue()
+          .Set("event", "AUX_PERF_SHELL_ROLE")
+          .Set("browserPid", getpid())
+          .Set("pid", pid)
+          .Set("startMachTicks",
+               base::NumberToString(usage.ri_proc_start_abstime)));
+  if (!json)
+    return;
+  shell_role_recorded_ = true;
+  fprintf(stderr, "%s\n", json->c_str());
+#endif
+}
+
+void NativePerformance::RetireShellRole() {
+#if BUILDFLAG(IS_MAC)
+  if (!shell_role_recorded_)
+    return;
+  shell_role_recorded_ = false;
+  if (!Enabled())
+    return;
+  auto json = base::WriteJson(base::DictValue()
+                                  .Set("event", "AUX_PERF_SHELL_RETIRED")
+                                  .Set("browserPid", getpid()));
+  if (json)
+    fprintf(stderr, "%s\n", json->c_str());
+#endif
+}
