@@ -0,0 +1,454 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/tab_catalog.h"
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_keyed_service_factory.h"
+#include "chrome/browser/profiles/profile_selections.h"
+#include "chrome/browser/ui/aux/page_identity.h"
+#include "chrome/browser/ui/browser_manager_service_factory.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "components/sessions/core/session_id.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace aux {
+namespace {
+
+class TabCatalogFactory final : public ProfileKeyedServiceFactory {
+ public:
+  static TabCatalogFactory* GetInstance() {
+    static base::NoDestructor<TabCatalogFactory> factory;
+    return factory.get();
+  }
+
+  TabCatalogFactory(const TabCatalogFactory&) = delete;
+  TabCatalogFactory& operator=(const TabCatalogFactory&) = delete;
+
+  TabCatalog* Get(Profile* profile) {
+    return static_cast<TabCatalog*>(
+        GetServiceForBrowserContext(profile, /*create=*/true));
+  }
+
+ private:
+  friend base::NoDestructor<TabCatalogFactory>;
+
+  TabCatalogFactory()
+      : ProfileKeyedServiceFactory(
+            "AuxTabCatalog",
+            ProfileSelections::BuildForRegularAndIncognito()) {
+    DependsOn(BrowserManagerServiceFactory::GetInstance());
+  }
+  ~TabCatalogFactory() override = default;
+
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override {
+    return std::make_unique<TabCatalog>(Profile::FromBrowserContext(context));
+  }
+};
+
+int64_t NowMs() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+}  // namespace
+
+TabCatalog* TabCatalog::GetForProfile(Profile* profile) {
+  return profile ? TabCatalogFactory::GetInstance()->Get(profile) : nullptr;
+}
+
+TabCatalog::TabCatalog(Profile* profile)
+    : profile_(profile),
+      browsers_(ProfileBrowserCollection::GetForProfile(profile)) {
+  if (browsers_) {
+    browser_observation_.Observe(browsers_);
+    browsers_->ForEach([this](BrowserWindowInterface* browser) {
+      ObserveBrowser(browser);
+      return true;
+    });
+  }
+  base::Value::Dict initial = Snapshot();
+  for (const base::Value& value : *initial.FindList("tabs")) {
+    published_pages_.insert(*value.GetDict().FindString("pageId"));
+  }
+}
+
+TabCatalog::~TabCatalog() {
+  Shutdown();
+}
+
+void TabCatalog::Shutdown() {
+  browser_observation_.Reset();
+  for (TabStripModel* model : observed_) {
+    model->RemoveObserver(this);
+  }
+  observed_.clear();
+  browsers_ = nullptr;
+  profile_ = nullptr;
+}
+
+void TabCatalog::ObserveBrowser(BrowserWindowInterface* browser) {
+  if (!browser || browser->GetProfile() != profile_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  TabStripModel* model = browser->GetTabStripModel();
+  if (model && observed_.insert(model).second) {
+    model->AddObserver(this);
+  }
+}
+
+void TabCatalog::ForgetBrowser(BrowserWindowInterface* browser) {
+  TabStripModel* model = browser->GetTabStripModel();
+  if (model && observed_.erase(model)) {
+    model->RemoveObserver(this);
+  }
+}
+
+void TabCatalog::Changed() {
+  const int previous_version = version_;
+  ++version_;
+  base::Value::Dict snapshot = Snapshot();
+  base::Value::List ops;
+  std::set<std::string> current_pages;
+  for (const base::Value& value : *snapshot.FindList("tabs")) {
+    const base::Value::Dict& tab = value.GetDict();
+    current_pages.insert(*tab.FindString("pageId"));
+    base::Value::Dict operation;
+    operation.Set("op", "upsert");
+    operation.Set("tab", tab.Clone());
+    ops.Append(std::move(operation));
+  }
+  for (const std::string& page_id : published_pages_) {
+    if (!current_pages.contains(page_id)) {
+      base::Value::Dict operation;
+      operation.Set("op", "remove");
+      operation.Set("pageId", page_id);
+      ops.Append(std::move(operation));
+    }
+  }
+  published_pages_ = std::move(current_pages);
+  for (const base::Value& value : *snapshot.FindList("windows")) {
+    base::Value::Dict operation;
+    operation.Set("op", "window");
+    operation.Set("window", value.GetDict().Clone());
+    ops.Append(std::move(operation));
+  }
+  if (ops.empty()) {
+    return;
+  }
+  base::Value::Dict patch;
+  patch.Set("version", version_);
+  patch.Set("baseVersion", previous_version);
+  patch.Set("ops", std::move(ops));
+  patch.Set("ts", static_cast<double>(NowMs()));
+  if (auto json = base::WriteJson(patch)) {
+    observers_.Notify(*json);
+  }
+}
+
+base::CallbackListSubscription TabCatalog::ObserveChanges(
+    base::RepeatingCallback<void(const std::string&)> callback) {
+  return observers_.Add(std::move(callback));
+}
+
+void TabCatalog::OnBrowserCreated(BrowserWindowInterface* browser) {
+  ObserveBrowser(browser);
+  Changed();
+}
+
+void TabCatalog::OnBrowserClosed(BrowserWindowInterface* browser) {
+  ForgetBrowser(browser);
+  Changed();
+}
+
+void TabCatalog::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (const auto* replacement = change.GetReplace()) {
+    if (auto* identity =
+            PageIdentity::FromWebContents(replacement->old_contents)) {
+      ++generations_[identity->id()];
+    }
+    PageIdentity::Transfer(replacement->old_contents,
+                           replacement->new_contents);
+  }
+  Changed();
+}
+
+void TabCatalog::OnTabChangedAt(tabs::TabInterface* tab,
+                                TabChangeType change_type) {
+  Changed();
+}
+
+void TabCatalog::OnTabStripModelDestroyed(TabStripModel* model) {
+  observed_.erase(model);
+  Changed();
+}
+
+std::string TabCatalog::WindowId(const BrowserWindowInterface* browser) const {
+  return base::NumberToString(browser->GetSessionID().id());
+}
+
+base::Value::Dict TabCatalog::TabRecord(BrowserWindowInterface* browser,
+                                        content::WebContents* contents) {
+  const std::string id = PageIdentity::GetOrCreate(profile_, contents);
+  const int64_t now = NowMs();
+  created_at_.try_emplace(id, now);
+  if (browser->GetTabStripModel()->GetActiveWebContents() == contents) {
+    last_active_at_[id] = now;
+  }
+  base::Value::Dict tab;
+  tab.Set("pageId", id);
+  tab.Set("windowId", WindowId(browser));
+  tab.Set("url", contents->GetLastCommittedURL().spec());
+  tab.Set("title", base::UTF16ToUTF8(contents->GetTitle()));
+  tab.Set("loading", contents->IsLoading());
+  tab.Set("muted", contents->IsAudioMuted());
+  tab.Set("audible", contents->IsCurrentlyAudible());
+  tab.Set("canGoBack", contents->GetController().CanGoBack());
+  tab.Set("canGoForward", contents->GetController().CanGoForward());
+  tab.Set("popup", false);
+  tab.Set("crashed", contents->IsCrashed());
+  tab.Set("runtimeOwned", false);
+  tab.Set("generation", generations_[id]);
+  tab.Set("createdAt", static_cast<double>(created_at_.at(id)));
+  tab.Set(
+      "lastActiveAt",
+      static_cast<double>(last_active_at_.try_emplace(id, now).first->second));
+  return tab;
+}
+
+base::Value::Dict TabCatalog::Snapshot() {
+  base::Value::List tabs;
+  base::Value::List windows;
+  if (browsers_) {
+    browsers_->ForEach([&](BrowserWindowInterface* browser) {
+      if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+        return true;
+      }
+      TabStripModel* model = browser->GetTabStripModel();
+      base::Value::List order;
+      base::Value active;
+      for (int index = 0; index < model->count(); ++index) {
+        content::WebContents* contents = model->GetWebContentsAt(index);
+        base::Value::Dict record = TabRecord(browser, contents);
+        const std::string* id = record.FindString("pageId");
+        order.Append(*id);
+        if (index == model->active_index()) {
+          active = base::Value(*id);
+        }
+        tabs.Append(std::move(record));
+      }
+      base::Value::Dict window;
+      window.Set("windowId", WindowId(browser));
+      window.Set("order", std::move(order));
+      window.Set("activePageId", std::move(active));
+      windows.Append(std::move(window));
+      return true;
+    });
+  }
+  base::Value::Dict snapshot;
+  snapshot.Set("version", version_);
+  snapshot.Set("tabs", std::move(tabs));
+  snapshot.Set("windows", std::move(windows));
+  return snapshot;
+}
+
+content::WebContents* TabCatalog::FindPage(const std::string& page_id,
+                                           BrowserWindowInterface** owner) {
+  content::WebContents* found = nullptr;
+  if (!browsers_) {
+    return nullptr;
+  }
+  browsers_->ForEach([&](BrowserWindowInterface* browser) {
+    if (browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+      return true;
+    }
+    TabStripModel* model = browser->GetTabStripModel();
+    for (int index = 0; index < model->count(); ++index) {
+      content::WebContents* contents = model->GetWebContentsAt(index);
+      if (PageIdentity::GetOrCreate(profile_, contents) == page_id) {
+        found = contents;
+        if (owner) {
+          *owner = browser;
+        }
+        return false;
+      }
+    }
+    return true;
+  });
+  return found;
+}
+
+base::Value::Dict TabCatalog::Reject(const std::string& command_id,
+                                     std::string code,
+                                     std::string message) const {
+  base::Value::Dict error;
+  error.Set("code", std::move(code));
+  error.Set("message", std::move(message));
+  base::Value::Dict ack;
+  ack.Set("commandId", command_id);
+  ack.Set("status", "rejected");
+  ack.Set("catalogVersion", version_);
+  ack.Set("error", std::move(error));
+  return ack;
+}
+
+base::Value::Dict TabCatalog::Command(BrowserWindowInterface* issuer,
+                                      const std::string& command_id,
+                                      const base::Value::Dict& command,
+                                      std::optional<int> expected_version) {
+  if (auto existing = command_acks_.find(command_id);
+      existing != command_acks_.end()) {
+    base::Value::Dict ack = existing->second.Clone();
+    ack.Set("status", "duplicate");
+    return ack;
+  }
+  if (!issuer || issuer->GetProfile() != profile_ ||
+      issuer->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return Reject(command_id, "forbidden",
+                  "The tab command has no owning window");
+  }
+  if (expected_version && *expected_version != version_) {
+    return Reject(command_id, "stale_tab",
+                  "The tab catalog changed; refresh before retrying");
+  }
+  const std::string* kind = command.FindString("kind");
+  if (!kind) {
+    return Reject(command_id, "invalid_params", "Missing tab command kind");
+  }
+  TabStripModel* model = issuer->GetTabStripModel();
+  std::string result_page_id;
+  if (*kind == "open") {
+    const std::string* url_text = command.FindString("url");
+    const GURL url(url_text ? *url_text : "");
+    if (url_text && !url_text->empty() && !url.is_valid()) {
+      return Reject(command_id, "invalid_params", "Invalid tab URL");
+    }
+    std::set<content::WebContents*> before;
+    for (int index = 0; index < model->count(); ++index) {
+      before.insert(model->GetWebContentsAt(index));
+    }
+    const int position = command.FindInt("index").value_or(-1);
+    const bool foreground =
+        command.FindBool("activate")
+            .value_or(!command.FindBool("background").value_or(false));
+    model->delegate()->AddTabAt(url, position, foreground);
+    for (int index = 0; index < model->count(); ++index) {
+      content::WebContents* candidate = model->GetWebContentsAt(index);
+      if (!before.contains(candidate)) {
+        result_page_id = PageIdentity::GetOrCreate(profile_, candidate);
+        break;
+      }
+    }
+    if (result_page_id.empty()) {
+      return Reject(command_id, "backend_unavailable",
+                    "Chromium did not create the tab");
+    }
+  } else if (*kind == "reorder") {
+    const base::Value::List* order = command.FindList("order");
+    if (!order || order->size() != static_cast<size_t>(model->count())) {
+      return Reject(command_id, "invalid_params",
+                    "Tab order must contain every tab in this window");
+    }
+    std::set<std::string> unique;
+    for (const base::Value& value : *order) {
+      if (!value.is_string() || !unique.insert(value.GetString()).second) {
+        return Reject(command_id, "invalid_params",
+                      "Duplicate or invalid tab in order");
+      }
+      BrowserWindowInterface* owner = nullptr;
+      if (!FindPage(value.GetString(), &owner) || owner != issuer) {
+        return Reject(command_id, "forbidden", "Tab order crosses a window");
+      }
+    }
+    for (size_t destination = 0; destination < order->size(); ++destination) {
+      content::WebContents* contents =
+          FindPage((*order)[destination].GetString());
+      const int source = model->GetIndexOfWebContents(contents);
+      if (source != static_cast<int>(destination)) {
+        model->MoveWebContentsAt(source, static_cast<int>(destination), false);
+      }
+    }
+  } else {
+    const std::string* page_id = command.FindString("pageId");
+    BrowserWindowInterface* owner = nullptr;
+    content::WebContents* contents =
+        page_id ? FindPage(*page_id, &owner) : nullptr;
+    if (!contents || !owner || owner != issuer) {
+      return Reject(command_id, "not_found", "Tab is not in this window");
+    }
+    result_page_id = *page_id;
+    const int index = model->GetIndexOfWebContents(contents);
+    if (*kind == "activate") {
+      model->ActivateTabAt(index);
+    } else if (*kind == "close") {
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    } else if (*kind == "navigate") {
+      const std::string* url_text = command.FindString("url");
+      const GURL url(url_text ? *url_text : "");
+      if (!url.is_valid()) {
+        return Reject(command_id, "invalid_params", "Invalid navigation URL");
+      }
+      content::NavigationController::LoadURLParams load(url);
+      contents->GetController().LoadURLWithParams(load);
+    } else if (*kind == "back") {
+      if (contents->GetController().CanGoBack()) {
+        contents->GetController().GoBack();
+      }
+    } else if (*kind == "forward") {
+      if (contents->GetController().CanGoForward()) {
+        contents->GetController().GoForward();
+      }
+    } else if (*kind == "reload") {
+      contents->GetController().Reload(
+          command.FindBool("hard").value_or(false)
+              ? content::ReloadType::BYPASSING_CACHE
+              : content::ReloadType::NORMAL,
+          true);
+    } else if (*kind == "stop") {
+      contents->Stop();
+    } else if (*kind == "setMuted") {
+      const std::optional<bool> muted = command.FindBool("muted");
+      if (!muted) {
+        return Reject(command_id, "invalid_params", "Missing muted state");
+      }
+      contents->SetAudioMuted(*muted);
+    } else {
+      return Reject(command_id, "not_found", "Unsupported tab command");
+    }
+  }
+  base::Value::Dict ack;
+  ack.Set("commandId", command_id);
+  ack.Set("status", "applied");
+  ack.Set("catalogVersion", version_);
+  ack.Set("pageId", result_page_id);
+  command_acks_[command_id] = ack.Clone();
+  ack_order_.push_back(command_id);
+  if (ack_order_.size() > 1024) {
+    command_acks_.erase(ack_order_.front());
+    ack_order_.pop_front();
+  }
+  return ack;
+}
+
+}  // namespace aux
