+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_AUX_ORGANIZATION_STORE_H_
+#define CHROME_BROWSER_UI_AUX_ORGANIZATION_STORE_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/values.h"
+
+class Profile;
+
+namespace aux {
+
+inline constexpr char kOrganizationPref[] = "aux.organization.v1";
+
+// Profile-owned browser organization. The caller supplies only the window ID
+// derived from its authorized WebUI; no renderer-provided Profile or window ID
+// is ever read. Every commit compares the current revision before writing.
+class OrganizationStore {
+ public:
+  static std::optional<base::Value::Dict> Snapshot(Profile* profile,
+                                                   std::string_view window_id,
+                                                   std::string* error);
+  static std::optional<base::Value::Dict> Commit(
+      Profile* profile,
+      std::string_view window_id,
+      int expected_revision,
+      const base::Value::Dict& layout,
+      std::string* error);
+};
+
+}  // namespace aux
+
+#endif  // CHROME_BROWSER_UI_AUX_ORGANIZATION_STORE_H_
