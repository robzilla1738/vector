diff --git a/chrome/browser/ui/aux/organization_store.cc b/chrome/browser/ui/aux/organization_store.cc
new file mode 100644
index 0000000000..80007e42b2
--- /dev/null
+++ b/chrome/browser/ui/aux/organization_store.cc
@@ -0,0 +1,349 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/aux/organization_store.h"
+
+#include <initializer_list>
+#include <limits>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "components/prefs/pref_service.h"
+
+namespace aux {
+namespace {
+
+constexpr size_t kMaxLayoutBytes = 256 * 1024;
+constexpr size_t kMaxWindows = 64;
+
+bool Text(const base::Value* value, size_t max_units, bool nonempty = true) {
+  const std::string* text = value ? value->GetIfString() : nullptr;
+  return text && base::UTF8ToUTF16(*text).size() <= max_units &&
+         (!nonempty || !text->empty());
+}
+
+bool Id(const base::Value* value) {
+  return Text(value, 200);
+}
+
+bool HasOnly(const base::Value::Dict& dict,
+             std::initializer_list<std::string_view> names) {
+  for (auto it = dict.begin(); it != dict.end(); ++it) {
+    bool permitted = false;
+    for (std::string_view name : names) {
+      if (it->first == name) {
+        permitted = true;
+        break;
+      }
+    }
+    if (!permitted) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool Color(const base::Value* value) {
+  const std::string* color = value ? value->GetIfString() : nullptr;
+  return color && (*color == "blue" || *color == "violet" ||
+                   *color == "pink" || *color == "orange" ||
+                   *color == "green" || *color == "teal" ||
+                   *color == "slate");
+}
+
+bool Space(const base::Value& value) {
+  const base::Value::Dict* space = value.GetIfDict();
+  if (!space || !HasOnly(*space, {"id", "name", "color", "grain",
+                                 "workspaceId", "archived"}) ||
+      !Id(space->Find("id")) || !Text(space->Find("name"), 100) ||
+      !Color(space->Find("color"))) {
+    return false;
+  }
+  const std::optional<int> grain = space->FindInt("grain");
+  if (!grain || *grain < 0 || *grain > 100) {
+    return false;
+  }
+  const base::Value* workspace = space->Find("workspaceId");
+  const base::Value* archived = space->Find("archived");
+  return (!workspace || Id(workspace)) &&
+         (!archived || archived->is_bool());
+}
+
+bool Folder(const base::Value& value) {
+  const base::Value::Dict* folder = value.GetIfDict();
+  if (!folder ||
+      !HasOnly(*folder, {"id", "name", "spaceId", "collapsed", "color",
+                         "emoji"}) ||
+      !Id(folder->Find("id")) || !Text(folder->Find("name"), 200) ||
+      !Id(folder->Find("spaceId")) || !folder->FindBool("collapsed")) {
+    return false;
+  }
+  const base::Value* color = folder->Find("color");
+  const base::Value* emoji = folder->Find("emoji");
+  return (!color || Color(color)) && (!emoji || Text(emoji, 16, false));
+}
+
+bool IdRecord(const base::Value::Dict* record) {
+  if (!record) {
+    return false;
+  }
+  for (auto it = record->begin(); it != record->end(); ++it) {
+    if (it->first.empty() || it->first.size() > 200 || !Id(&it->second)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool Shared(const base::Value::Dict* shared) {
+  if (!shared ||
+      !HasOnly(*shared, {"spaces", "archivedSpaces", "pins", "folders"})) {
+    return false;
+  }
+  const base::Value::List* spaces = shared->FindList("spaces");
+  const base::Value::List* archived = shared->FindList("archivedSpaces");
+  const base::Value::List* folders = shared->FindList("folders");
+  const base::Value::Dict* pins = shared->FindDict("pins");
+  if (!spaces || spaces->empty() || spaces->size() > 200 || !archived ||
+      archived->size() > 200 || !folders || folders->size() > 1000 ||
+      !pins) {
+    return false;
+  }
+  for (const base::Value& space : *spaces) {
+    if (!Space(space)) {
+      return false;
+    }
+  }
+  for (const base::Value& space : *archived) {
+    if (!Space(space)) {
+      return false;
+    }
+  }
+  for (const base::Value& folder : *folders) {
+    if (!Folder(folder)) {
+      return false;
+    }
+  }
+  for (auto it = pins->begin(); it != pins->end(); ++it) {
+    if (it->first.empty() || it->first.size() > 200 || !it->second.is_list() ||
+        it->second.GetList().size() > 500) {
+      return false;
+    }
+    for (const base::Value& value : it->second.GetList()) {
+      const base::Value::Dict* pin = value.GetIfDict();
+      if (!pin || !HasOnly(*pin, {"url", "title"}) ||
+          !Text(pin->Find("url"), 2048) ||
+          !Text(pin->Find("title"), 500, false)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool Window(const base::Value::Dict* window) {
+  if (!window || !HasOnly(*window, {"activeSpaceId", "activeTabs",
+                                 "splitRatio", "tabSpace", "order",
+                                 "tabFolder", "splits"}) ||
+      !Id(window->Find("activeSpaceId")) ||
+      !IdRecord(window->FindDict("activeTabs")) ||
+      !IdRecord(window->FindDict("tabSpace")) ||
+      !IdRecord(window->FindDict("tabFolder")) ||
+      !IdRecord(window->FindDict("splits"))) {
+    return false;
+  }
+  const std::optional<double> ratio = window->FindDouble("splitRatio");
+  const base::Value::List* order = window->FindList("order");
+  if (!ratio || *ratio < 0.1 || *ratio > 0.9 || !order ||
+      order->size() > 5000) {
+    return false;
+  }
+  for (const base::Value& page_id : *order) {
+    if (!Id(&page_id)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ValidLayout(const base::Value::Dict& layout) {
+  if (!HasOnly(layout, {"shared", "window"}) ||
+      !Shared(layout.FindDict("shared")) ||
+      !Window(layout.FindDict("window"))) {
+    return false;
+  }
+  const auto json = base::WriteJson(layout);
+  return json && json->size() <= kMaxLayoutBytes;
+}
+
+base::Value::Dict DefaultWindow(const base::Value::Dict& shared) {
+  const base::Value::List& spaces = *shared.FindList("spaces");
+  base::Value::Dict window;
+  window.Set("activeSpaceId", *spaces[0].GetDict().FindString("id"));
+  window.Set("activeTabs", base::Value::Dict());
+  window.Set("splitRatio", 0.5);
+  window.Set("tabSpace", base::Value::Dict());
+  window.Set("order", base::Value::List());
+  window.Set("tabFolder", base::Value::Dict());
+  window.Set("splits", base::Value::Dict());
+  return window;
+}
+
+bool ValidDocument(const base::Value::Dict& document) {
+  if (document.empty()) {
+    return true;
+  }
+  if (!HasOnly(document, {"revision", "shared", "windows", "windowOrder"})) {
+    return false;
+  }
+  const std::optional<int> revision = document.FindInt("revision");
+  const base::Value::Dict* shared = document.FindDict("shared");
+  const base::Value::Dict* windows = document.FindDict("windows");
+  const base::Value::List* window_order = document.FindList("windowOrder");
+  if (!revision || *revision < 1 || !Shared(shared) || !windows ||
+      windows->size() > kMaxWindows || !window_order ||
+      window_order->size() != windows->size()) {
+    return false;
+  }
+  std::set<std::string> seen;
+  for (const base::Value& id : *window_order) {
+    if (!Id(&id) || !windows->Find(id.GetString()) ||
+        !seen.insert(id.GetString()).second) {
+      return false;
+    }
+  }
+  for (auto it = windows->begin(); it != windows->end(); ++it) {
+    if (it->first.empty() || it->first.size() > 200 ||
+        !Window(it->second.GetIfDict())) {
+      return false;
+    }
+    base::Value::Dict layout;
+    layout.Set("shared", shared->Clone());
+    layout.Set("window", it->second.Clone());
+    if (!ValidLayout(layout)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+base::Value::Dict MakeSnapshot(const base::Value::Dict& document,
+                               std::string_view window_id) {
+  base::Value::Dict snapshot;
+  if (document.empty()) {
+    snapshot.Set("revision", 0);
+    snapshot.Set("layout", base::Value());
+    return snapshot;
+  }
+  const base::Value::Dict& shared = *document.FindDict("shared");
+  const base::Value::Dict& windows = *document.FindDict("windows");
+  base::Value::Dict layout;
+  layout.Set("shared", shared.Clone());
+  const base::Value::Dict* window = windows.FindDict(window_id);
+  layout.Set("window", window ? window->Clone() : DefaultWindow(shared));
+  snapshot.Set("revision", document.FindInt("revision").value());
+  snapshot.Set("layout", std::move(layout));
+  return snapshot;
+}
+
+}  // namespace
+
+std::optional<base::Value::Dict> OrganizationStore::Snapshot(
+    Profile* profile,
+    std::string_view window_id,
+    std::string* error) {
+  if (!profile || profile->IsOffTheRecord() || window_id.empty() ||
+      window_id.size() > 200) {
+    *error = "Organization is unavailable for this browser window";
+    return std::nullopt;
+  }
+  const base::Value::Dict& document =
+      profile->GetPrefs()->GetDict(kOrganizationPref);
+  if (!ValidDocument(document)) {
+    *error = "The Profile organization preference is invalid";
+    return std::nullopt;
+  }
+  return MakeSnapshot(document, window_id);
+}
+
+std::optional<base::Value::Dict> OrganizationStore::Commit(
+    Profile* profile,
+    std::string_view window_id,
+    int expected_revision,
+    const base::Value::Dict& layout,
+    std::string* error) {
+  if (!ValidLayout(layout) || expected_revision < 0) {
+    *error = "Invalid Profile organization layout";
+    return std::nullopt;
+  }
+  if (!Snapshot(profile, window_id, error)) {
+    return std::nullopt;
+  }
+  const base::Value::Dict& current =
+      profile->GetPrefs()->GetDict(kOrganizationPref);
+  const int revision = current.FindInt("revision").value_or(0);
+  if (expected_revision != revision) {
+    *error = "Organization revision conflict";
+    return std::nullopt;
+  }
+  if (revision == std::numeric_limits<int>::max()) {
+    *error = "Organization revision exhausted";
+    return std::nullopt;
+  }
+  base::Value::Dict windows = current.empty()
+                                  ? base::Value::Dict()
+                                  : current.FindDict("windows")->Clone();
+  windows.Remove(window_id);
+  windows.Set(window_id, layout.FindDict("window")->Clone());
+  std::vector<std::string> ids;
+  if (!current.empty()) {
+    for (const base::Value& id : *current.FindList("windowOrder")) {
+      if (id.GetString() != window_id) {
+        ids.push_back(id.GetString());
+      }
+    }
+  }
+  ids.emplace_back(window_id);
+  std::set<std::string> active_windows;
+  if (auto* browsers = ProfileBrowserCollection::GetForProfile(profile)) {
+    browsers->ForEach([&active_windows](BrowserWindowInterface* browser) {
+      active_windows.insert(base::NumberToString(browser->GetSessionID().id()));
+      return true;
+    });
+  }
+  while (ids.size() > kMaxWindows) {
+    auto oldest_inactive = ids.begin();
+    while (oldest_inactive != ids.end() &&
+           active_windows.contains(*oldest_inactive)) {
+      ++oldest_inactive;
+    }
+    if (oldest_inactive == ids.end()) {
+      *error = "Too many active browser windows for organization storage";
+      return std::nullopt;
+    }
+    windows.Remove(*oldest_inactive);
+    ids.erase(oldest_inactive);
+  }
+  base::Value::List window_order;
+  for (const std::string& id : ids) {
+    window_order.Append(id);
+  }
+  base::Value::Dict next;
+  next.Set("revision", revision + 1);
+  next.Set("shared", layout.FindDict("shared")->Clone());
+  next.Set("windows", std::move(windows));
+  next.Set("windowOrder", std::move(window_order));
+  profile->GetPrefs()->SetDict(kOrganizationPref, next.Clone());
+  return MakeSnapshot(next, window_id);
+}
+
+}  // namespace aux
