@@ -0,0 +1,63 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/surface_visibility.h"
+#include <algorithm>
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/picture_in_picture/auto_picture_in_picture_tab_helper.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/aux/page_identity.h"
+#include "components/sessions/core/session_id.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace aux {
+namespace {
+class StageVisibility final : public content::WebContentsUserData<StageVisibility> {
+ public:
+  bool visible = false;
+  int owner = -1;
+ private:
+  friend class content::WebContentsUserData<StageVisibility>;
+  explicit StageVisibility(content::WebContents* contents)
+      : content::WebContentsUserData<StageVisibility>(*contents) {}
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(StageVisibility);
+}  // namespace
+bool IsStageVisible(content::WebContents* contents) {
+  const auto* state = StageVisibility::FromWebContents(contents);
+  const auto* tab = tabs::TabInterface::GetFromContents(contents);
+  const auto* owner = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return state && state->visible && owner && owner->GetSessionID().id() == state->owner;
+}
+void SetStageVisible(BrowserWindowInterface* window,
+                     const std::vector<content::WebContents*>& pages) {
+  auto* model = window->GetTabStripModel();
+  std::vector<base::WeakPtr<content::WebContents>> changed;
+  // Commit all visibility bits before notifying auto-PiP about the selection.
+  for (int index = 0; index < model->count(); ++index) {
+    auto* contents = model->GetWebContentsAt(index);
+    const auto* identity = PageIdentity::FromWebContents(contents);
+    if (identity && identity->runtime_owned()) continue;
+    StageVisibility::CreateForWebContents(contents);
+    auto* state = StageVisibility::FromWebContents(contents);
+    const bool visible = std::ranges::find(pages, contents) != pages.end();
+    if (visible != IsStageVisible(contents)) changed.push_back(contents->GetWeakPtr());
+    state->owner = window->GetSessionID().id();
+    state->visible = visible;
+  }
+  for (const auto& weak : changed) {
+    auto* contents = weak.get();
+    const auto* tab = contents ? tabs::TabInterface::GetFromContents(contents) : nullptr;
+    if (!tab || tab->GetBrowserWindowInterface() != window) continue;
+    if (IsStageVisible(contents)) contents->WasShown();
+    else if (contents != model->GetActiveWebContents()) contents->WasHidden();
+    if (!weak) continue;
+    if (auto* helper = AutoPictureInPictureTabHelper::FromWebContents(contents))
+      helper->OnTabActivatedChanged(contents == model->GetActiveWebContents() || IsStageVisible(contents));
+  }
+}
+}  // namespace aux
