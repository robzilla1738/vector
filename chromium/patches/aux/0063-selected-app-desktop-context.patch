+namespace {
+using CF = base::apple::ScopedCFTypeRef<CFTypeRef>;
+CF Attribute(AXUIElementRef element, CFStringRef name) {
+  CFTypeRef value = nullptr;
+  AXUIElementSetMessagingTimeout(element, 0.04);
+  if (AXUIElementCopyAttributeValue(element, name, &value) != kAXErrorSuccess) {
+    return CF();
+  }
+  return CF(value);
+}
+std::string String(CFTypeRef value) {
+  return value && CFGetTypeID(value) == CFStringGetTypeID() &&
+                 CFStringGetLength(static_cast<CFStringRef>(value)) <= 32768
+             ? base::SysCFStringRefToUTF8(static_cast<CFStringRef>(value))
+             : "";
+}
+std::string Text(AXUIElementRef element, CFStringRef name) {
+  return String(Attribute(element, name).get());
+}
+CF VisibleChildren(AXUIElementRef element, size_t maximum) {
+  CFArrayRef values = nullptr;
+  AXUIElementSetMessagingTimeout(element, 0.04);
+  if (AXUIElementCopyAttributeValues(element, kAXVisibleChildrenAttribute, 0,
+                                     maximum, &values) != kAXErrorSuccess) {
+    return CF();
+  }
+  return CF(values);
+}
+bool ExcludedApp(const std::string& bundle) {
+  static const base::NoDestructor<std::set<std::string>> excluded(
+      {"com.1password.1password", "com.agilebits.onepassword7",
+       "com.apple.keychainaccess", "com.apple.Passwords",
+       "com.bitwarden.desktop", "com.lastpass.LastPass",
+       "com.dashlane.Dashlane"});
+  static const base::NoDestructor<std::set<std::string>> browsers(
+      {"com.apple.Safari", "com.google.Chrome", "com.google.Chrome.canary",
+       "org.chromium.Chromium", "com.microsoft.edgemac", "com.brave.Browser",
+       "org.mozilla.firefox", "company.thebrowser.Browser",
+       "company.thebrowser.dia", "com.aside.browser"});
+  if (excluded->contains(bundle) || browsers->contains(bundle) ||
+      bundle == base::SysNSStringToUTF8(
+                    NSRunningApplication.currentApplication.bundleIdentifier)) {
+    return true;
+  }
+  NSURL* location = [NSWorkspace.sharedWorkspace
+      URLForApplicationWithBundleIdentifier:base::SysUTF8ToNSString(bundle)];
+  NSBundle* application = location ? [NSBundle bundleWithURL:location] : nil;
+  id types = application.infoDictionary[@"CFBundleURLTypes"];
+  if (types && ![types isKindOfClass:NSArray.class]) {
+    return true;
+  }
+  for (id type in types) {
+    if (![type isKindOfClass:NSDictionary.class]) {
+      return true;
+    }
+    id schemes = type[@"CFBundleURLSchemes"];
+    if (schemes && ![schemes isKindOfClass:NSArray.class]) {
+      return true;
+    }
+    for (id scheme in schemes) {
+      if (![scheme isKindOfClass:NSString.class]) {
+        return true;
+      }
+      if ([[scheme lowercaseString] isEqualToString:@"http"] ||
+          [[scheme lowercaseString] isEqualToString:@"https"]) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+bool IsElement(CFTypeRef value) {
+  return value && CFGetTypeID(value) == AXUIElementGetTypeID();
+}
+bool Sensitive(AXUIElementRef element) {
+  auto role = Text(element, kAXRoleAttribute);
+  auto subrole = Text(element, kAXSubroleAttribute);
+  if (role.empty() ||
+      subrole == base::SysCFStringRefToUTF8(kAXSecureTextFieldSubrole)) {
+    return true;
+  }
+  // An editable field without a known subrole is not permission to OCR around
+  // it.
+  return role == "AXTextField" && subrole.empty();
+}
+bool Bounds(AXUIElementRef element, CGRect* result) {
+  auto position = Attribute(element, kAXPositionAttribute);
+  auto size = Attribute(element, kAXSizeAttribute);
+  CGPoint point;
+  CGSize extent;
+  if (!position || !size || CFGetTypeID(position.get()) != AXValueGetTypeID() ||
+      CFGetTypeID(size.get()) != AXValueGetTypeID() ||
+      !AXValueGetValue(static_cast<AXValueRef>(position.get()),
+                       static_cast<AXValueType>(kAXValueCGPointType), &point) ||
+      !AXValueGetValue(static_cast<AXValueRef>(size.get()),
+                       static_cast<AXValueType>(kAXValueCGSizeType), &extent)) {
+    return false;
+  }
+  *result = CGRectMake(point.x, point.y, extent.width, extent.height);
+  return extent.width > 0 && extent.height > 0;
+}
+struct Sample {
+  base::DictValue value;
+  base::apple::ScopedCFTypeRef<AXUIElementRef> window{nullptr};
+  bool safe = false;
+  CGRect bounds = CGRectZero;
+};
+// Runs only on the dedicated sequenced MayBlock runner. Every AX IPC is
+// bounded; neither whole-document editable values nor unknown visibility are
+// admitted.
+Sample ReadVisible(int pid,
+                   const std::shared_ptr<std::atomic_bool>& cancelled) {
+  Sample result;
+  const auto deadline = base::TimeTicks::Now() + base::Milliseconds(400);
+  base::apple::ScopedCFTypeRef<AXUIElementRef> app(
+      AXUIElementCreateApplication(pid));
+  auto focused = Attribute(app.get(), kAXFocusedUIElementAttribute);
+  auto window = Attribute(app.get(), kAXFocusedWindowAttribute);
+  if (cancelled->load() || !IsElement(focused.get()) ||
+      !IsElement(window.get()) ||
+      Sensitive(static_cast<AXUIElementRef>(focused.get()))) {
+    return result;
+  }
+  result.window.reset(static_cast<AXUIElementRef>(CFRetain(window.get())));
+  CGRect window_bounds;
+  if (!Bounds(result.window.get(), &window_bounds)) {
+    return result;
+  }
+  result.bounds = window_bounds;
+  std::string selection = Text(static_cast<AXUIElementRef>(focused.get()),
+                               kAXSelectedTextAttribute);
+  if (selection.size() > 4096) {
+    selection.clear();
+  }
+  std::string text;
+  std::string document_url = Text(result.window.get(), kAXDocumentAttribute);
+  if (!document_url.starts_with("https://") &&
+      !document_url.starts_with("http://")) {
+    document_url.clear();
+  }
+  std::vector<base::apple::ScopedCFTypeRef<AXUIElementRef>> pending;
+  pending.emplace_back(static_cast<AXUIElementRef>(CFRetain(window.get())));
+  size_t visited = 0;
+  while (!pending.empty() && visited++ < 256 && text.size() < 32768 &&
+         !cancelled->load() && base::TimeTicks::Now() < deadline) {
+    auto element = std::move(pending.back());
+    pending.pop_back();
+    CGRect bounds;
+    if (!Bounds(element.get(), &bounds) ||
+        !CGRectContainsRect(window_bounds, bounds)) {
+      continue;
+    }
+    auto hidden = Attribute(element.get(), kAXHiddenAttribute);
+    if (hidden && CFGetTypeID(hidden.get()) == CFBooleanGetTypeID() &&
+        CFBooleanGetValue(static_cast<CFBooleanRef>(hidden.get()))) {
+      continue;
+    }
+    const auto role = Text(element.get(), kAXRoleAttribute);
+    if (role == "AXWebArea" && document_url.empty()) {
+      auto url = Attribute(element.get(), kAXURLAttribute);
+      if (url && CFGetTypeID(url.get()) == CFURLGetTypeID()) {
+        document_url = String(CFURLGetString(static_cast<CFURLRef>(url.get())));
+      } else {
+        document_url = String(url.get());
+      }
+      if (!document_url.starts_with("https://") &&
+          !document_url.starts_with("http://")) {
+        document_url.clear();
+      }
+    }
+    if (role == "AXTextArea" || role == "AXTextField") {
+      if (Sensitive(element.get())) {
+        return {};
+      }
+      auto range = Attribute(element.get(), kAXVisibleCharacterRangeAttribute);
+      CFRange visible;
+      if (range && CFGetTypeID(range.get()) == AXValueGetTypeID() &&
+          AXValueGetValue(static_cast<AXValueRef>(range.get()),
+                          static_cast<AXValueType>(kAXValueCFRangeType),
+                          &visible) &&
+          visible.location >= 0 && visible.length > 0 &&
+          visible.length <= 32768) {
+        CFTypeRef substring = nullptr;
+        if (AXUIElementCopyParameterizedAttributeValue(
+                element.get(), kAXStringForRangeParameterizedAttribute,
+                range.get(), &substring) == kAXErrorSuccess) {
+          CF owned(substring);
+          auto value = String(owned.get());
+          if (text.size() + value.size() + 1 <= 32768) {
+            text += value + "\n";
+          }
+        }
+      }
+    } else if (role == "AXStaticText") {
+      auto value = Text(element.get(), kAXValueAttribute);
+      if (!value.empty() && text.size() + value.size() + 1 <= 32768) {
+        text += value + "\n";
+      }
+    }
+    auto children = VisibleChildren(
+        element.get(),
+        256 - std::min(visited + pending.size(), static_cast<size_t>(256)));
+    if (children && CFGetTypeID(children.get()) == CFArrayGetTypeID()) {
+      auto array = static_cast<CFArrayRef>(children.get());
+      for (CFIndex index = CFArrayGetCount(array) - 1;
+           index >= 0 && pending.size() + visited < 256; --index) {
+        auto* child = CFArrayGetValueAtIndex(array, index);
+        if (IsElement(child)) {
+          pending.emplace_back(static_cast<AXUIElementRef>(CFRetain(child)));
+        }
+      }
+    }
+  }
+  // A timeout or node overflow is partial visible text, never a full-document
+  // fallback.
+  if (cancelled->load()) {
+    return {};
+  }
+  result.safe = true;
+  if (text.empty() && !selection.empty()) {
+    text = selection;
+  }
+  result.value.Set("text", text);
+  result.value.Set("selection", selection);
+  if (!document_url.empty() && document_url.size() <= 8192) {
+    result.value.Set("documentUrl", document_url);
+  }
+  auto title = Text(result.window.get(), kAXTitleAttribute);
+  result.value.Set("windowTitle", title.size() <= 500 ? title : "");
+  return result;
+}
+bool SelectedWindowIsForeground(int pid, CGWindowID selected, CGRect bounds) {
+  CF windows(CGWindowListCopyWindowInfo(
+      kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements,
+      kCGNullWindowID));
+  if (!windows) {
+    return false;
+  }
+  auto array = static_cast<CFArrayRef>(windows.get());
+  for (CFIndex index = 0; index < CFArrayGetCount(array); ++index) {
+    auto dictionary =
+        static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(array, index));
+    auto owner = static_cast<CFNumberRef>(
+        CFDictionaryGetValue(dictionary, kCGWindowOwnerPID));
+    auto number = static_cast<CFNumberRef>(
+        CFDictionaryGetValue(dictionary, kCGWindowNumber));
+    auto layer = static_cast<CFNumberRef>(
+        CFDictionaryGetValue(dictionary, kCGWindowLayer));
+    int owner_pid = 0, window_number = 0, window_layer = -1;
+    if (!owner || !number || !layer ||
+        !CFNumberGetValue(owner, kCFNumberIntType, &owner_pid) ||
+        !CFNumberGetValue(number, kCFNumberIntType, &window_number) ||
+        !CFNumberGetValue(layer, kCFNumberIntType, &window_layer)) {
+      continue;
+    }
+    if (owner_pid != pid || window_layer != 0) {
+      continue;
+    }
+    CGRect actual;
+    auto rectangle = static_cast<CFDictionaryRef>(
+        CFDictionaryGetValue(dictionary, kCGWindowBounds));
+    return static_cast<CGWindowID>(window_number) == selected && rectangle &&
+           CGRectMakeWithDictionaryRepresentation(rectangle, &actual) &&
+           CGRectEqualToRect(actual, bounds);
+  }
+  return false;
+}
+}  // namespace
+
+API_AVAILABLE(macos(14.0))
+@interface AuxDesktopPickerObserver : NSObject <SCContentSharingPickerObserver>
+@property(nonatomic, assign) base::WeakPtr<aux::DesktopContextMac> owner;
+@end
+@implementation AuxDesktopPickerObserver
+@synthesize owner = _owner;
+- (void)contentSharingPicker:(SCContentSharingPicker*)picker
+         didUpdateWithFilter:(SCContentFilter*)filter
+                   forStream:(SCStream*)stream {
+  auto owner = _owner;
