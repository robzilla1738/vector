+
+ValueStore::Status SettingsStorageQuotaEnforcer::CommitAuxUiPreferenceMigration(
+    std::unique_ptr<AuxUiPreferenceCapture> capture) {
+  // A sync error can have applied the batch. Invalidate on every attempt;
+  // do not read/repair storage here or treat a failed result as success.
+  usage_calculated_ = false;
+  used_total_ = 0;
+  used_per_setting_.clear();
+  return delegate_->CommitAuxUiPreferenceMigration(std::move(capture));
+}
