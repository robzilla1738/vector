diff --git a/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm b/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm
--- a/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm
+++ b/chrome/browser/ui/webui_browser/webui_browser_window_mac.mm
@@ -119,6 +119,23 @@
     objc_setAssociatedObject(window, &kAuxMaterialKey, requested,
                              OBJC_ASSOCIATION_COPY_NONATOMIC);
   }
+  NSView* effect = objc_getAssociatedObject(window, &kAuxMaterialViewKey);
+  // Retained materials must follow theme changes too. Clear regular glass alone
+  // can brighten a dark sidebar beyond the contrast of its light text.
+  effect.appearance = window.appearance;
+  if (@available(macOS 26.0, *)) {
+    if ([effect isKindOfClass:[AuxGlassBackgroundView class]]) {
+      NSAppearance* appearance = window.effectiveAppearance;
+      NSString* matched = [appearance bestMatchFromAppearancesWithNames:
+          @[NSAppearanceNameAqua, NSAppearanceNameDarkAqua]];
+      [appearance performAsCurrentDrawingAppearance:^{
+        ((AuxGlassBackgroundView*)effect).tintColor =
+            [matched isEqualToString:NSAppearanceNameDarkAqua]
+                ? [NSColor.windowBackgroundColor colorWithAlphaComponent:0.8]
+                : NSColor.clearColor;
+      }];
+    }
+  }
   window.opaque = !glass;
   // Chromium's glass frame uses a nearly transparent backing to avoid AppKit
   // continuously invalidating a completely transparent window surface.
