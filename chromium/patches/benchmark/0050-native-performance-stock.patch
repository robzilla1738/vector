 namespace prefs {
+
+// Opt-in native measurement, used only in a disposable benchmark Local State.
+inline constexpr char kNativeBenchmarkEnabled[] = "performance.native_benchmark";
+inline constexpr char kNativeBenchmarkFixtureUrl[] = "performance.native_benchmark_fixture_url";
 
 // *************** PROFILE PREFS ***************
 // These are attached to the user profile
