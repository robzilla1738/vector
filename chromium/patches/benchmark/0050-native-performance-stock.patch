+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license.
+#ifndef CHROME_BROWSER_UI_PERFORMANCE_NATIVE_PERFORMANCE_H_
+#define CHROME_BROWSER_UI_PERFORMANCE_NATIVE_PERFORMANCE_H_
+
+#include <memory>
+#include <cstdint>
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_observer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/weak_document_ptr.h"
+#include "ui/events/event_handler.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace viz { struct FrameTimingDetails; }
+namespace ui { class Compositor; }
+namespace views { class Widget; }
+class TabStripModel;
+class NativePerformancePage;
+
+// Installed only in an explicitly opted-in disposable benchmark Local State.
+// Owns the original native widget and its shell document; no product authority,
+// synthetic readiness clock, input dispatch, or background sampling is exposed.
+class NativePerformance : public views::WidgetObserver,
+                          public ui::EventHandler,
+                          public content::WebContentsObserver,
+                          public content::RenderWidgetHostObserver,
+                          public content::RenderWidgetHost::InputEventObserver {
+ public:
+  static bool Enabled();
+  static std::unique_ptr<NativePerformance> Install(views::Widget* widget,
+                                                  content::WebContents* shell,
+                                                  TabStripModel* tabs);
+  static NativePerformance* ForWidget(views::Widget* widget);
+  explicit NativePerformance(views::Widget* widget,
+                             content::WebContents* shell, TabStripModel* tabs);
+  ~NativePerformance() override;
+  // Call only after the current native query results have committed to the DOM.
+  void CommitQuery(int query_id);
+  void CommitStockQuery(ui::Compositor* compositor);
+  void RecordFirstFrame(base::TimeTicks presentation);
+
+ private:
+  void OnWidgetDestroying(views::Widget* widget) override;
+  void OnWidgetVisibilityChanged(views::Widget* widget, bool visible) override;
+  void OnKeyEvent(ui::KeyEvent* event) override;
+  void OnInputEvent(const content::RenderWidgetHost& host,
+                    const blink::WebInputEvent& event,
+                    content::RenderWidgetHost::InputEventObserver::InputEventSource source) override;
+  void RenderWidgetHostDestroyed(content::RenderWidgetHost* host) override;
+  void PrimaryPageChanged(content::Page& page) override;
+  void DidFirstVisuallyNonEmptyPaint() override;
+  void AttachInputHost();
+  void DetachInputHost();
+  void Input(base::TimeTicks timestamp);
+  void QuerySubmitted(content::WeakDocumentPtr document,
+                      base::TimeTicks input,
+                      uint64_t serial,
+                      int query_id,
+                      bool success);
+  void QueryPresented(content::WeakDocumentPtr document,
+                      base::TimeTicks input,
+                      uint64_t serial,
+                      int query_id,
+                      const viz::FrameTimingDetails& details);
+  friend class NativePerformancePage;
+  std::unique_ptr<NativePerformancePage> page_;
+  raw_ptr<views::Widget> widget_;
+  raw_ptr<content::RenderWidgetHost> input_host_ = nullptr;
+  base::TimeTicks input_time_;
+  base::TimeTicks tab_input_time_;
+  bool interactive_recorded_ = false;
+  uint64_t input_serial_ = 0;
+  uint64_t recorded_serial_ = 0;
+  int committed_query_id_ = 0;
+  bool retired_ = false;
+  bool first_frame_recorded_ = false;
+  bool window_shown_recorded_ = false;
+  base::WeakPtrFactory<NativePerformance> weak_factory_{this};
+};
+#endif
