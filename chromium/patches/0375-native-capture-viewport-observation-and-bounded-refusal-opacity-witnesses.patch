+void DocumentAnimations::ReportMissingOpacityOwnerForAuxDiagnostic(
+    const cc::PropertyTrees& trees,
+    const cc::AnimationHost* expected_host) const {
+  for (const auto& timeline : timelines_) {
+    for (const auto& animation : timeline->GetAnimations()) {
+      if (!animation)
+        continue;
+      auto* compositor = animation->GetCompositorAnimation();
+      if (!compositor)
+        continue;
+      const auto* cc_animation = compositor->CcAnimation();
+      if (cc_animation->animation_host() != expected_host)
+        continue;
+      const auto* cc_effect = cc_animation->keyframe_effect();
+      cc::PropertyAnimationState pending, active;
+      cc_effect->GetPropertyAnimationState(&pending, &active);
+      const auto property = cc::TargetProperty::OPACITY;
+      if (!pending.currently_running[property] &&
+          !pending.potentially_animating[property] &&
+          !active.currently_running[property] &&
+          !active.potentially_animating[property]) {
+        continue;
+      }
+      for (const auto& model : cc_effect->keyframe_models()) {
+        if (model->TargetProperty() != property)
+          continue;
+        const auto* cc_model = cc::KeyframeModel::ToCcKeyframeModel(model.get());
+        const auto element_id = cc_model->element_id()
+                                    ? cc_model->element_id()
+                                    : cc_animation->element_id();
+        if (!element_id || trees.effect_tree().FindNodeFromElementId(element_id))
+          continue;
+        const auto* effect = DynamicTo<KeyframeEffect>(animation->effect());
+        const auto* target = effect ? effect->EffectTarget() : nullptr;
+        const auto* host = target ? target->OwnerShadowHost() : nullptr;
+        LOG(ERROR) << "AUX_OPACITY_OWNER sameHost=1 missing=1"
+                   << " activeRunning=" << active.currently_running[property]
+                   << " activePotential=" << active.potentially_animating[property]
+                   << " pendingRunning=" << pending.currently_running[property]
+                   << " pendingPotential=" << pending.potentially_animating[property]
+                   << " hasTarget=" << !!target
+                   << " connected=" << (target && target->isConnected())
+                   << " uaShadow=" << (target && target->IsInUserAgentShadowRoot())
+                   << " mediaHost=" << (host && host->IsMediaElement())
+                   << " fileDocument=" << document_->Url().ProtocolIs("file")
+                   << " internalDocument="
+                   << (document_->Url().ProtocolIs("chrome") ||
+                       document_->Url().ProtocolIs("chrome-untrusted"));
+        return;
+      }
+    }
+  }
+}
