@@ -0,0 +1,101 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/native_disposable_model_credential_lease.h"
+#include <utility>
+#include "base/check.h"
+namespace aux {
+NativeDisposableModelCredentialLease::Backend::~Backend() = default;
+NativeDisposableModelCredentialLease::NativeDisposableModelCredentialLease(
+    Owner owner, std::unique_ptr<Backend> backend,
+    base::RepeatingCallback<bool()> current,
+    base::OnceCallback<void(Receipt, std::shared_ptr<Backend>)> retain_debt)
+    : owner_(owner), lease_(base::UnguessableToken::Create()),
+      backend_(std::move(backend)), current_(std::move(current)),
+      retain_debt_(std::move(retain_debt)) {
+  CHECK(backend_);
+  CHECK(!retain_debt_.is_null());
+}
+// Move original item evidence and debt to the producer ledger, not a success
+// receipt or an account-wide deletion. The ledger must outlive original Worker.
+NativeDisposableModelCredentialLease::~NativeDisposableModelCredentialLease() {
+  weak_factory_.InvalidateWeakPtrs();
+  retired_ = true;
+  if (!cleanup_debt_) return;
+  auto pending = receipt();
+  pending.retired = true;
+  auto backend = std::move(backend_);
+  auto retain = std::move(retain_debt_);
+  std::move(retain).Run(pending, std::move(backend));
+}
+NativeDisposableModelCredentialLease::Receipt
+NativeDisposableModelCredentialLease::receipt() const {
+  return {lease_, owner_.host, owner_.profile, owner_.connection_generation,
+          state_, retired_, cleanup_debt_};
+}
+bool NativeDisposableModelCredentialLease::Current() {
+  if (retired_ || owner_.host.is_empty() || owner_.profile.is_empty() ||
+      owner_.connection_generation == 0 || current_.is_null()) return false;
+  auto weak = weak_factory_.GetWeakPtr();
+  const auto callback = current_;
+  const bool current = callback.Run();
+  if (!weak) return false;
+  if (!current) retired_ = true;
+  return current && !retired_;
+}
+bool NativeDisposableModelCredentialLease::AcquireAbsent() {
+  if (state_ != State::kRefused || write_attempted_ || !Current()) return false;
+  auto weak = weak_factory_.GetWeakPtr();
+  const auto backend = backend_;
+  const auto observed = backend->ObserveOriginal();
+  if (!weak || observed != Backend::Item::kAbsent) return false;
+  if (!Current()) return false;
+  state_ = State::kAbsent;
+  return true;
+}
+bool NativeDisposableModelCredentialLease::SaveFixed() {
+  if (state_ != State::kAbsent || write_attempted_ || !Current()) return false;
+  write_attempted_ = true;
+  cleanup_debt_ = true;  // Before any mutation or caller ACK.
+  auto weak = weak_factory_.GetWeakPtr();
+  const auto backend = backend_;
+  const auto outcome = backend->AddFixedOriginal();
+  if (!weak) return false;
+  if (outcome == Backend::Write::kNoWrite) {
+    cleanup_debt_ = false;
+    state_ = State::kRefused;
+    return false;
+  }
+  state_ = outcome == Backend::Write::kOriginalSaved ? State::kSaved : State::kUncertain;
+  const bool current = Current();
+  return current && state_ == State::kSaved;
+}
+bool NativeDisposableModelCredentialLease::ObserveExplicitRemoval() {
+  if (!write_attempted_ || !cleanup_debt_ || !Current()) return false;
+  auto weak = weak_factory_.GetWeakPtr();
+  const auto backend = backend_;
+  const auto observed = backend->ObserveOriginal();
+  if (!weak) return false;
+  if (!Current() || observed != Backend::Item::kAbsent) return false;
+  state_ = State::kRemoved;
+  cleanup_debt_ = false;
+  return true;
+}
+bool NativeDisposableModelCredentialLease::CleanupOriginal() {
+  if (!backend_) return false;
+  if (!cleanup_debt_) return state_ == State::kRemoved;
+  // Host retirement does not grant new authority. Backend retains only its
+  // original item witness and refuses changed Profile/item identity.
+  auto weak = weak_factory_.GetWeakPtr();
+  const auto backend = backend_;
+  const auto outcome = backend->RemoveOriginal();
+  if (!weak) return false;
+  if (outcome != Backend::Item::kAbsent) return false;
+  state_ = State::kRemoved;
+  cleanup_debt_ = false;
+  return true;
+}
+void NativeDisposableModelCredentialLease::Retire() {
+  retired_ = true;
+}
+}  // namespace aux
