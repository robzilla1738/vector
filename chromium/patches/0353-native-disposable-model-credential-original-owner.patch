+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_DISPOSABLE_CREDENTIAL_PROFILE_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_DISPOSABLE_CREDENTIAL_PROFILE_H_
+#include <atomic>
+#include <memory>
+#include "base/files/file_path.h"
+#include "base/supports_user_data.h"
+#include "base/unguessable_token.h"
+class AuxRuntimeHost;
+class Profile;
+namespace aux {
+// Retains normal-Save witness retirement independently of the one-use grant
+// and original Host/Worker. Profile destruction permanently retires it.
+class NativeDisposableCredentialProfile final : public base::SupportsUserData::Data {
+ public:
+  ~NativeDisposableCredentialProfile() override;
+ private:
+  friend class ::AuxRuntimeHost;
+  friend class NativeDisposableCredentialProfileTestPeer;
+  struct State {
+    explicit State(base::FilePath path);
+    ~State();
+    const base::FilePath profile;
+    const base::UnguessableToken identity = base::UnguessableToken::Create();
+    std::atomic_bool cleanup_debt{false};
+    std::atomic_bool saved_ack{false};
+    std::atomic_bool alive{true};
+    std::atomic_bool write_intent{false};
+  };
+  explicit NativeDisposableCredentialProfile(std::shared_ptr<State> original);
+  static std::shared_ptr<State> Existing(Profile* profile);
+  static std::shared_ptr<State> InstallBeforeIntent(Profile* profile);
+  const std::shared_ptr<State> original_;
+};
+}  // namespace aux
+#endif
