+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/native_disposable_credential_profile.h"
+#include <utility>
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/browser_thread.h"
+namespace aux {
+namespace { const char kOriginalCredentialProfile[] = "aux-fixed-disposable-credential-profile"; }
+NativeDisposableCredentialProfile::State::State(base::FilePath path) : profile(std::move(path)) {}
+NativeDisposableCredentialProfile::State::~State() = default;
+NativeDisposableCredentialProfile::NativeDisposableCredentialProfile(std::shared_ptr<State> original)
+    : original_(std::move(original)) {}
+NativeDisposableCredentialProfile::~NativeDisposableCredentialProfile() { original_->alive.store(false); }
+std::shared_ptr<NativeDisposableCredentialProfile::State>
+NativeDisposableCredentialProfile::Existing(Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile || profile->IsOffTheRecord() || !profile->IsRegularProfile()) return nullptr;
+  auto* original = static_cast<NativeDisposableCredentialProfile*>(profile->GetUserData(kOriginalCredentialProfile));
+  return original && original->original_->alive.load() && original->original_->profile == profile->GetPath()
+      ? original->original_ : nullptr;
+}
+std::shared_ptr<NativeDisposableCredentialProfile::State>
+NativeDisposableCredentialProfile::InstallBeforeIntent(Profile* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile || profile->IsOffTheRecord() || !profile->IsRegularProfile()) return nullptr;
+  if (auto original = Existing(profile)) return original;
+  // This private call is admitted by the original inherited grant before it
+  // sends intent; the state alone cannot authorize acquisition or deletion.
+  auto original = std::make_shared<State>(profile->GetPath());
+  profile->SetUserData(kOriginalCredentialProfile,
+      std::unique_ptr<NativeDisposableCredentialProfile>(new NativeDisposableCredentialProfile(original)));
+  return original;
+}
+}  // namespace aux
