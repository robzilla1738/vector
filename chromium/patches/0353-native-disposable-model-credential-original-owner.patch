+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/native_disposable_credential_profile.h"
+#include "chrome/test/base/testing_profile.h"
+#include "content/public/test/browser_task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace aux {
+class NativeDisposableCredentialProfileTestPeer {
+ public:
+  using State = NativeDisposableCredentialProfile::State;
+  static std::shared_ptr<State> Existing(Profile* profile) {
+    return NativeDisposableCredentialProfile::Existing(profile);
+  }
+  static std::shared_ptr<State> Install(Profile* profile) {
+    return NativeDisposableCredentialProfile::InstallBeforeIntent(profile);
+  }
+};
+TEST(NativeDisposableCredentialProfileTest, NormalProfileHasNoWriteRetirementUntilOriginalAdmission) {
+  content::BrowserTaskEnvironment tasks;
+  TestingProfile profile;
+  EXPECT_FALSE(NativeDisposableCredentialProfileTestPeer::Existing(&profile));
+  auto original = NativeDisposableCredentialProfileTestPeer::Install(&profile);
+  ASSERT_TRUE(original);
+  EXPECT_EQ(original->profile, profile.GetPath());
+  EXPECT_TRUE(original->alive.load());
+  EXPECT_FALSE(original->write_intent.load());
+}
+TEST(NativeDisposableCredentialProfileTest, HostReconnectionRetainsExactOriginalWriteRetirementState) {
+  content::BrowserTaskEnvironment tasks;
+  TestingProfile profile;
+  auto original = NativeDisposableCredentialProfileTestPeer::Install(&profile);
+  ASSERT_TRUE(original);
+  original->write_intent.store(true);
+  auto reconnected = NativeDisposableCredentialProfileTestPeer::Existing(&profile);
+  ASSERT_EQ(original.get(), reconnected.get());
+  EXPECT_TRUE(reconnected->write_intent.load());
+  EXPECT_EQ(original.get(), NativeDisposableCredentialProfileTestPeer::Install(&profile).get());
+}
+TEST(NativeDisposableCredentialProfileTest, ActualProfileDestructionRetiresRetainedWorkerMetadata) {
+  content::BrowserTaskEnvironment tasks;
+  auto profile = std::make_unique<TestingProfile>();
+  auto original = NativeDisposableCredentialProfileTestPeer::Install(profile.get());
+  ASSERT_TRUE(original);
+  original->write_intent.store(true);
+  profile.reset();
+  EXPECT_FALSE(original->alive.load());
+  EXPECT_TRUE(original->write_intent.load());
+  TestingProfile replacement;
+  EXPECT_FALSE(NativeDisposableCredentialProfileTestPeer::Existing(&replacement));
+}
+}  // namespace aux
