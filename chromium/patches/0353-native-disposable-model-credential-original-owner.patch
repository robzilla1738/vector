+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_DISPOSABLE_MODEL_CREDENTIAL_LEASE_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_DISPOSABLE_MODEL_CREDENTIAL_LEASE_H_
+#include <cstdint>
+#include <memory>
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/unguessable_token.h"
+class AuxRuntimeHost;
+namespace aux {
+class NativeDisposableModelCredentialTestPeer;
+// Closed prerequisite. Only the future authenticated host producer can create
+// or mutate a lease. No path, credential name, key, or external selector API.
+class NativeDisposableModelCredentialLease {
+ public:
+  enum class State { kRefused, kAbsent, kSaved, kRemoved, kUncertain };
+  struct Receipt {
+    base::UnguessableToken lease;
+    base::UnguessableToken host;
+    base::UnguessableToken profile;
+    uint64_t connection_generation;
+    State state;
+    bool retired;
+    bool cleanup_debt;
+  };
+  ~NativeDisposableModelCredentialLease();
+  Receipt receipt() const;
+ private:
+  friend class ::AuxRuntimeHost;
+  friend class NativeDisposableModelCredentialBackend;
+  friend class NativeDisposableModelCredentialTestPeer;
+  // Backend is fixed to the original generated Profile and one synthetic item.
+  // Its implementation must not use an account-wide delete or caller key.
+  class Backend {
+   public:
+    enum class Item { kAbsent, kOriginal, kForeign, kUnavailable };
+    enum class Write { kOriginalSaved, kNoWrite, kUncertain };
+    virtual ~Backend();
+    virtual Item ObserveOriginal() = 0;
+    virtual Write AddFixedOriginal() = 0;
+    virtual Item RemoveOriginal() = 0;
+  };
+  struct Owner {
+    base::UnguessableToken host;
+    base::UnguessableToken profile;
+    uint64_t connection_generation;
+  };
+  NativeDisposableModelCredentialLease(Owner owner,
+      std::unique_ptr<Backend> backend,
+      base::RepeatingCallback<bool()> current,
+      base::OnceCallback<void(Receipt, std::shared_ptr<Backend>)> retain_debt);
+  bool AcquireAbsent();
+  bool SaveFixed();
+  bool ObserveExplicitRemoval();
+  bool CleanupOriginal();
+  void Retire();
+  bool Current();
+  const Owner owner_;
+  const base::UnguessableToken lease_;
+  // Each in-flight call retains this exact backend through synchronous owner
+  // destruction and debt delivery; sharing never creates a new item witness.
+  std::shared_ptr<Backend> backend_;
+  base::RepeatingCallback<bool()> current_;
+  base::OnceCallback<void(Receipt, std::shared_ptr<Backend>)> retain_debt_;
+  State state_ = State::kRefused;
+  bool retired_ = false;
+  bool cleanup_debt_ = false;
+  bool write_attempted_ = false;
+  base::WeakPtrFactory<NativeDisposableModelCredentialLease> weak_factory_{this};
+};
+}  // namespace aux
+#endif
