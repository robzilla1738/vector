+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#ifndef CHROME_BROWSER_UI_AUX_NATIVE_DISPOSABLE_CREDENTIAL_GRANT_H_
+#define CHROME_BROWSER_UI_AUX_NATIVE_DISPOSABLE_CREDENTIAL_GRANT_H_
+#include <array>
+#include <atomic>
+#include <memory>
+#include <string>
+#include <sys/stat.h>
+#include "base/files/file_path.h"
+#include "base/files/scoped_file.h"
+#include "base/time/time.h"
+class AuxRuntimeHost;
+namespace aux {
+// Early inherited-descriptor prerequisite. It is not a public credential API.
+// Original launcher/Host joins must own capture, bind, retirement and debt.
+class NativeDisposableCredentialGrant {
+ public:
+  ~NativeDisposableCredentialGrant();
+ private:
+  friend class ::AuxRuntimeHost;
+  friend class NativeObservationMetadata;
+  friend class NativeDisposableCredentialGrantTestPeer;
+  static std::unique_ptr<NativeDisposableCredentialGrant> CaptureInherited();
+  NativeDisposableCredentialGrant();
+  bool PrepareChannel();
+  bool Current(const base::FilePath& original_profile);
+  bool BindOriginal(const base::FilePath& profile, std::string host,
+                    uint64_t connection_generation);
+  bool AcquireOriginalWitness(std::string* witness);
+  bool RetainOriginalReference(const std::string& witness,
+                               const std::string& reference);
+  bool Exchange(const std::string& request, std::string* response);
+  void Retire();
+  base::ScopedFD channel_;
+  std::array<base::ScopedFD, 3> directories_;
+  base::ScopedFD slot_, owner_;
+  std::array<struct stat, 3> directory_identity_{};
+  struct stat slot_identity_ {}, owner_identity_ {};
+  std::array<std::string, 3> directory_paths_;
+  std::string slot_path_, owner_bytes_, nonce_, host_, original_witness_, profile_alias_, endpoint_reservation_, endpoint_bytes_;
+  uint64_t connection_generation_ = 0;
+  pid_t original_parent_ = 0, original_slot_owner_ = 0;
+  base::FilePath original_profile_;
+  base::TimeTicks deadline_;
+  std::atomic_bool retired_{false};
+  bool bound_ = false, acquisition_consumed_ = false, reference_consumed_ = false;
+};
+}  // namespace aux
+#endif
