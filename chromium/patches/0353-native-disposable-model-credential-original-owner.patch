new file mode 100644
index 0000000..3ea8286
--- /dev/null
+++ b/chrome/browser/ui/aux/native_disposable_credential_grant.cc
@@ -0,0 +1,227 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/browser/ui/aux/native_disposable_credential_grant.h"
+#include <fcntl.h>
+#include <sys/param.h>
+#include <algorithm>
+#include <cerrno>
+#include "base/base_paths.h"
+#include "base/path_service.h"
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <array>
+#include <regex>
+#include <utility>
+#include "base/environment.h"
+#include "base/containers/span.h"
+#include "base/base64.h"
+#include <signal.h>
+#include <mach/mach_time.h>
+#include "base/strings/string_number_conversions.h"
+namespace aux {
+namespace {
+bool Same(const struct stat& a, const struct stat& b) {
+  return a.st_dev == b.st_dev && a.st_ino == b.st_ino &&
+         a.st_uid == b.st_uid && a.st_mode == b.st_mode;
+}
+bool Hex(const std::string& value) {
+  return value.size() == 64 && value.find_first_not_of("0123456789abcdef") == std::string::npos;
+}
+bool Path(int fd, std::string* path) {
+  std::array<char, MAXPATHLEN> value{};
+  if (fcntl(fd, F_GETPATH, value.data()) != 0) return false;
+  *path = value.data(); return true;
+}
+bool ReadBytes(int fd, const struct stat& info, std::string* bytes) {
+  if (info.st_size <= 0 || info.st_size > 4096) return false;
+  bytes->resize(info.st_size);
+  return pread(fd, bytes->data(), bytes->size(), 0) == info.st_size;
+}
+}  // namespace
+NativeDisposableCredentialGrant::NativeDisposableCredentialGrant() = default;
+NativeDisposableCredentialGrant::~NativeDisposableCredentialGrant() = default;
+std::unique_ptr<NativeDisposableCredentialGrant>
+NativeDisposableCredentialGrant::CaptureInherited() {
+  auto result = std::unique_ptr<NativeDisposableCredentialGrant>(new NativeDisposableCredentialGrant());
+  // These fixed inherited descriptors have no argv/env path selector.
+  result->channel_.reset(fcntl(3, F_DUPFD_CLOEXEC, 20));
+  if (!result->PrepareChannel()) return nullptr;
+  for (size_t i = 0; i < result->directories_.size(); ++i) {
+    result->directories_[i].reset(fcntl(4 + static_cast<int>(i), F_DUPFD_CLOEXEC, 20));
+    struct stat named{};
+    if (!result->directories_[i].is_valid() ||
+        fstat(result->directories_[i].get(), &result->directory_identity_[i]) != 0 ||
+        !Path(result->directories_[i].get(), &result->directory_paths_[i]) ||
+        lstat(result->directory_paths_[i].c_str(), &named) != 0 ||
+        !Same(named, result->directory_identity_[i]) || !S_ISDIR(named.st_mode) ||
+        named.st_uid != geteuid() || (named.st_mode & 0777) != 0700) return nullptr;
+  }
+  if (!std::regex_match(result->directory_paths_[0],
+      std::regex("/private/tmp/aux-native-journey-[A-Za-z0-9_-]+")) ||
+      result->directory_paths_[1] != result->directory_paths_[0] + "/profile" ||
+      result->directory_paths_[2] != result->directory_paths_[1] + "/Default") return nullptr;
+  result->slot_.reset(fcntl(7, F_DUPFD_CLOEXEC, 20));
+  result->owner_.reset(fcntl(8, F_DUPFD_CLOEXEC, 20));
+  std::string owner_path;
+  if (!result->channel_.is_valid() || !result->slot_.is_valid() || !result->owner_.is_valid() ||
+      fstat(result->slot_.get(), &result->slot_identity_) != 0 ||
+      fstat(result->owner_.get(), &result->owner_identity_) != 0 ||
+      !Path(result->slot_.get(), &result->slot_path_) || !Path(result->owner_.get(), &owner_path) ||
+      owner_path != result->slot_path_ + "/owner.json" ||
+      !S_ISDIR(result->slot_identity_.st_mode) || result->slot_identity_.st_uid != geteuid() ||
+      (result->slot_identity_.st_mode & 0777) != 0700 ||
+      !S_ISREG(result->owner_identity_.st_mode) || result->owner_identity_.st_uid != geteuid() ||
+      (result->owner_identity_.st_mode & 0777) != 0600 || result->owner_identity_.st_nlink != 1 ||
+      !ReadBytes(result->owner_.get(), result->owner_identity_, &result->owner_bytes_)) return nullptr;
+  uid_t uid; gid_t gid; pid_t peer = 0; socklen_t size = sizeof(peer);
+  if (getpeereid(result->channel_.get(), &uid, &gid) != 0 || uid != geteuid() ||
+      getsockopt(result->channel_.get(), SOL_LOCAL, LOCAL_PEERPID, &peer, &size) != 0 ||
+      size != sizeof(peer) || peer != getppid()) return nullptr;
+  result->original_parent_ = peer;
+  auto env = base::Environment::Create();
+  const auto token = env->GetVar("AUX_NATIVE_SLOT_TOKEN");
+  std::smatch owner;
+  if (!token || !std::regex_match(result->owner_bytes_, owner,
+      std::regex(R"OWNER(^\{"pid":([1-9][0-9]*),"token":"([a-f0-9-]{36})","startedAt":([1-9][0-9]*)\}$)OWNER")) ||
+      owner[2].str() != *token ||
+      !base::StringToInt(owner[1].str(), &result->original_slot_owner_) ||
+      result->original_slot_owner_ <= 0 || kill(result->original_slot_owner_, 0) != 0) return nullptr;
+  base::FilePath home;
+  if (!base::PathService::Get(base::DIR_HOME, &home) || result->slot_path_ !=
+      home.Append("aux-chromium-stable").Append(".aux-native-slot").value()) return nullptr;
+  for (int fd = 3; fd <= 8; ++fd) {
+    if (fcntl(fd, F_SETFD, FD_CLOEXEC) != 0) return nullptr;
+  }
+  // This transport-only read bound does not admit credential effects. The
+  // reservation below is the guardian's original Mach clock, never capture time.
+  std::string grant;
+  if (!result->Exchange("", &grant)) return nullptr;
+  std::smatch receipt;
+  uint64_t acquired_mach = 0;
+  if (!std::regex_match(grant, receipt,
+      std::regex("^GRANT\\|([a-f0-9]{64})\\|([1-9][0-9]*)\\|([1-9][0-9]*)\\|([a-f0-9]{64})\\|([A-Za-z0-9+/=]+)$")) ||
+      receipt[2].str() != base::NumberToString(getpid()) ||
+      !base::StringToUint64(receipt[3].str(), &acquired_mach) ||
+      acquired_mach > mach_absolute_time()) return nullptr;
+  const auto acquired = base::TimeTicks::FromMachAbsoluteTime(acquired_mach);
+  const auto now = base::TimeTicks::Now();
+  if (acquired.is_null() || acquired > now) return nullptr;
+  result->deadline_ = acquired + base::Seconds(150);
+  if (now >= result->deadline_) return nullptr;
+  result->nonce_ = receipt[1].str();
+  result->endpoint_reservation_ = receipt[4].str();
+  result->endpoint_bytes_ = receipt[5].str();
+  std::string endpoint;
+  std::smatch target;
+  int port = 0;
+  if (result->endpoint_bytes_.size() > 256 ||
+      !base::Base64Decode(result->endpoint_bytes_, &endpoint) ||
+      base::Base64Encode(endpoint) != result->endpoint_bytes_ ||
+      !std::regex_match(endpoint, target, std::regex("^http://127\\.0\\.0\\.1:([1-9][0-9]*)/v1$")) ||
+      !base::StringToInt(target[1].str(), &port) || port > 65535) return nullptr;
+  return result;
+}
+bool NativeDisposableCredentialGrant::PrepareChannel() {
+  struct stat info {};
+  const int enabled = 1;
+  const int flags = fcntl(channel_.get(), F_GETFL);
+  return channel_.is_valid() && flags >= 0 &&
+      fstat(channel_.get(), &info) == 0 && S_ISSOCK(info.st_mode) &&
+      setsockopt(channel_.get(), SOL_SOCKET, SO_NOSIGPIPE, &enabled, sizeof(enabled)) == 0 &&
+      fcntl(channel_.get(), F_SETFL, flags | O_NONBLOCK) == 0;
+}
+bool NativeDisposableCredentialGrant::Current(const base::FilePath& profile) {
+  if (retired_.load() || deadline_.is_null() || base::TimeTicks::Now() >= deadline_) {
+    retired_.store(true); return false;
+  }
+  std::string canonical = profile.value();
+  if (canonical.starts_with("/tmp/")) canonical = "/private" + canonical;
+  bool valid = canonical == directory_paths_[2] &&
+      (!bound_ || profile == original_profile_);
+  for (size_t i = 0; i < directories_.size(); ++i) {
+    struct stat held{}, named{};
+    valid = valid && fstat(directories_[i].get(), &held) == 0 &&
+        lstat(directory_paths_[i].c_str(), &named) == 0 &&
+        Same(held, directory_identity_[i]) && Same(named, directory_identity_[i]);
+  }
+  struct stat slot{}, held_slot{}, owner{}, held{}, quarantine{};
+  std::string bytes;
+  valid = valid && lstat(slot_path_.c_str(), &slot) == 0 && Same(slot, slot_identity_) &&
+      fstat(slot_.get(), &held_slot) == 0 && Same(held_slot, slot_identity_) &&
+      lstat((slot_path_ + "/owner.json").c_str(), &owner) == 0 && Same(owner, owner_identity_) && owner.st_nlink == 1 &&
+      fstat(owner_.get(), &held) == 0 && Same(held, owner_identity_) && held.st_nlink == 1 &&
+      ReadBytes(owner_.get(), held, &bytes) && bytes == owner_bytes_ && getppid() == original_parent_ &&
+      original_slot_owner_ > 0 && kill(original_slot_owner_, 0) == 0;
+  errno = 0;
+  if (fstatat(slot_.get(), "quarantine.json", &quarantine, AT_SYMLINK_NOFOLLOW) == 0 || errno != ENOENT) valid = false;
+  if (!valid) retired_.store(true);
+  return valid;
+}
+bool NativeDisposableCredentialGrant::BindOriginal(const base::FilePath& profile,
+    std::string host, uint64_t generation) {
+  if (bound_ || host.size() != 32 ||
+      host.find_first_not_of("0123456789ABCDEF") != std::string::npos ||
+      !generation || !Current(profile)) return false;
+  original_profile_ = profile;
+  profile_alias_ = profile.value().starts_with("/tmp/") ? "tmp" : "private-tmp";
+  host_ = std::move(host); connection_generation_ = generation; bound_ = true; return true;
+}
+bool NativeDisposableCredentialGrant::Exchange(const std::string& request, std::string* response) {
+  if (retired_.load() || request.size() > 4096 || request.find('\n') != std::string::npos) return false;
+  const auto transport_deadline = base::TimeTicks::Now() + base::Seconds(5);
+  const auto operation_deadline = deadline_.is_null() ? transport_deadline :
+      std::min(deadline_, transport_deadline);
+  const std::string output = request.empty() ? std::string() : request + "\n";
+  size_t sent = 0; response->clear();
+  while (base::TimeTicks::Now() < operation_deadline && !retired_.load()) {
+    const bool writing = sent < output.size();
+    pollfd descriptor{channel_.get(), static_cast<short>(writing ? POLLOUT : POLLIN), 0};
+    const int remaining = (operation_deadline - base::TimeTicks::Now()).InMillisecondsRoundedUp();
+    if (remaining <= 0 || poll(&descriptor, 1, remaining) <= 0 ||
+        descriptor.revents & (POLLERR | POLLHUP | POLLNVAL)) break;
+    if (writing) {
+      if (sent > output.size()) break;
+      const auto remaining_output = base::as_byte_span(output).subspan(sent);
+      const auto count = write(channel_.get(), remaining_output.data(), remaining_output.size());
+      if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) continue;
+      if (count <= 0) break; sent += count;
+    } else {
+      char byte; const auto count = read(channel_.get(), &byte, 1);
+      if (count < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) continue;
+      if (count != 1) break;
+      if (byte == '\n') return true;
+      if (byte == '\r' || response->size() >= 4096) break;
+      response->push_back(byte);
+    }
+  }
+  retired_.store(true); return false;
+}
+bool NativeDisposableCredentialGrant::AcquireOriginalWitness(std::string* witness) {
+  if (!bound_ || acquisition_consumed_) return false;
+  acquisition_consumed_ = true;
+  const std::string identity = host_ + "|" + base::NumberToString(connection_generation_);
+  std::string reply;
+  if (!Exchange("ACQUIRE|" + nonce_ + "|" + identity + "|" + profile_alias_ + "|" + endpoint_reservation_ + "|" + endpoint_bytes_, &reply)) return false;
+  const std::string prefix = "INTENT|" + nonce_ + "|" + identity + "|";
+  if (!reply.starts_with(prefix)) { Retire(); return false; }
+  *witness = reply.substr(prefix.size());
+  if (!Hex(*witness)) { Retire(); return false; }
+  original_witness_ = *witness;
+  return true;
+}
+bool NativeDisposableCredentialGrant::RetainOriginalReference(const std::string& witness,
+    const std::string& reference) {
+  if (!bound_ || !acquisition_consumed_ || reference_consumed_ || !Hex(witness) || witness != original_witness_ ||
+      reference.empty() || reference.size() > 1368 ||
+      reference.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=") != std::string::npos) return false;
+  reference_consumed_ = true;
+  const std::string identity = host_ + "|" + base::NumberToString(connection_generation_);
+  std::string reply;
+  return Exchange("SAVED|" + nonce_ + "|" + identity + "|" + witness + "|" + reference, &reply) &&
+      reply == "RETAINED|" + nonce_ + "|" + identity;
+}
+void NativeDisposableCredentialGrant::Retire() { retired_.store(true); }
+}  // namespace aux
