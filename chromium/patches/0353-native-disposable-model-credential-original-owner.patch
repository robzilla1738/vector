+namespace aux {
+class NativeDisposableCredentialGrantTestPeer {
+ public:
+  static std::unique_ptr<NativeDisposableCredentialGrant> Socket(int fd, bool expired = false) {
+    auto grant = std::unique_ptr<NativeDisposableCredentialGrant>(new NativeDisposableCredentialGrant());
+    grant->channel_.reset(fd);
+    if (!grant->PrepareChannel()) return nullptr;
+    grant->deadline_ = base::TimeTicks::Now() + (expired ? base::Seconds(-1) : base::Seconds(5));
+    return grant;
+  }
+  static bool Exchange(NativeDisposableCredentialGrant* grant, std::string* reply) {
+    return grant->Exchange("ACQUIRE|original-unit-channel", reply);
+  }
+  static void RetainedIntent(NativeDisposableCredentialGrant* grant) {
+    grant->bound_ = true;
+    grant->acquisition_consumed_ = true;
+    grant->original_witness_ = std::string(64, 'a');
+  }
+  static bool MayAdd(NativeDisposableCredentialGrant* grant) {
+    return grant->Current(base::FilePath("/tmp/original/profile/Default"));
+  }
+  static bool Retired(NativeDisposableCredentialGrant* grant) { return grant->retired_.load(); }
+};
+TEST(NativeDisposableCredentialGrantTest, OriginalPrivateSocketUsesNoSigpipeAndNonblocking) {
+  int pair[2]; ASSERT_EQ(socketpair(AF_UNIX, SOCK_STREAM, 0, pair), 0);
+  base::ScopedFD peer(pair[1]);
+  auto grant = NativeDisposableCredentialGrantTestPeer::Socket(pair[0]); ASSERT_TRUE(grant);
+  EXPECT_NE(fcntl(pair[0], F_GETFL) & O_NONBLOCK, 0);
+  int enabled = 0; socklen_t size = sizeof(enabled);
+  ASSERT_EQ(getsockopt(pair[0], SOL_SOCKET, SO_NOSIGPIPE, &enabled, &size), 0);
+  EXPECT_EQ(enabled, 1);
+}
+TEST(NativeDisposableCredentialGrantTest, ActualPeerCloseRefusesAndRetiresOriginalExchange) {
+  int pair[2]; ASSERT_EQ(socketpair(AF_UNIX, SOCK_STREAM, 0, pair), 0);
+  base::ScopedFD peer(pair[1]);
+  auto grant = NativeDisposableCredentialGrantTestPeer::Socket(pair[0]); ASSERT_TRUE(grant);
+  peer.reset();
+  std::string response;
+  EXPECT_FALSE(NativeDisposableCredentialGrantTestPeer::Exchange(grant.get(), &response));
+  EXPECT_TRUE(NativeDisposableCredentialGrantTestPeer::Retired(grant.get()));
+  EXPECT_TRUE(response.empty());
+}
+TEST(NativeDisposableCredentialGrantTest, OriginalExpiredDeadlineIssuesNoRequest) {
+  int pair[2]; ASSERT_EQ(socketpair(AF_UNIX, SOCK_STREAM, 0, pair), 0);
+  base::ScopedFD peer(pair[1]);
+  auto grant = NativeDisposableCredentialGrantTestPeer::Socket(pair[0], true); ASSERT_TRUE(grant);
+  std::string response;
+  EXPECT_FALSE(NativeDisposableCredentialGrantTestPeer::Exchange(grant.get(), &response));
+  EXPECT_TRUE(NativeDisposableCredentialGrantTestPeer::Retired(grant.get()));
+  char byte; EXPECT_EQ(recv(peer.get(), &byte, 1, MSG_DONTWAIT), -1);
+}
+TEST(NativeDisposableCredentialGrantTest, RetainedIntentCannotRefreshExpiredOriginalReservation) {
+  base::test::TaskEnvironment clock(base::test::TaskEnvironment::TimeSource::MOCK_TIME);
+  int pair[2]; ASSERT_EQ(socketpair(AF_UNIX, SOCK_STREAM, 0, pair), 0);
+  base::ScopedFD peer(pair[1]);
+  auto grant = NativeDisposableCredentialGrantTestPeer::Socket(pair[0]); ASSERT_TRUE(grant);
+  NativeDisposableCredentialGrantTestPeer::RetainedIntent(grant.get());
+  // Same original reservation expires between intent acknowledgment and Add.
+  clock.FastForwardBy(base::Seconds(5));
+  EXPECT_FALSE(NativeDisposableCredentialGrantTestPeer::MayAdd(grant.get()));
+  EXPECT_TRUE(NativeDisposableCredentialGrantTestPeer::Retired(grant.get()));
+  std::string response;
+  EXPECT_FALSE(NativeDisposableCredentialGrantTestPeer::Exchange(grant.get(), &response));
+  char byte; EXPECT_EQ(recv(peer.get(), &byte, 1, MSG_DONTWAIT), -1);
+}
+}  // namespace aux
