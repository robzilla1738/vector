 void NativePerformanceMailbox::Next(Reply reply) {
   if (failed_ || pending_ || expected_ || running_ || sequence_ >= 4000) { std::move(reply).Run(Invalid()); return; }
+  if (owner_) { NextReady(std::move(reply)); return; }
+  auto* web_ui = ui_ ? ui_->web_ui() : nullptr;
+  auto* shell = web_ui ? web_ui->GetWebContents() : nullptr;
+  auto* frame = shell ? shell->GetPrimaryMainFrame() : nullptr;
+  auto* window = shell ? WebUIBrowserWindow::FromWebShellWebContents(shell) : nullptr;
+  auto* compositor = window && window->widget() ? window->widget()->GetCompositor() : nullptr;
+  if (!frame || frame != web_ui->GetRenderFrameHost() || !compositor) {
+    std::move(reply).Run(Invalid()); return;
+  }
+  // Capabilities can arrive before the first visible native frame. Bind the
+  // original document and compositor once; presentation does not admit an owner.
+  document_ = frame->GetWeakDocumentPtr();
+  pending_ = std::move(reply);
+  timeout_.Start(FROM_HERE, base::Seconds(30), base::BindOnce(&NativePerformanceMailbox::Refuse, weak_factory_.GetWeakPtr()));
+  compositor->RequestSuccessfulPresentationTimeForNextFrame(base::BindOnce(
+      &NativePerformanceMailbox::Presented, weak_factory_.GetWeakPtr(), document_, compositor));
+  compositor->ScheduleDraw();
+}
+void NativePerformanceMailbox::Presented(content::WeakDocumentPtr original_document,
+    ui::Compositor* original_compositor, const viz::FrameTimingDetails&) {
+  if (!pending_ || failed_) return;
+  auto* frame = original_document.AsRenderFrameHostIfValid();
+  auto* web_ui = ui_ ? ui_->web_ui() : nullptr;
+  auto* shell = web_ui ? web_ui->GetWebContents() : nullptr;
+  auto* window = shell ? WebUIBrowserWindow::FromWebShellWebContents(shell) : nullptr;
+  if (!frame || !web_ui || frame != web_ui->GetRenderFrameHost() ||
+      !shell || frame != shell->GetPrimaryMainFrame() ||
+      !window || !window->widget() ||
+      window->widget()->GetCompositor() != original_compositor) { Refuse(); return; }
+  auto reply = std::move(pending_);
+  NextReady(std::move(reply));
+}
