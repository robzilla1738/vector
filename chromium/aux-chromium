#!/usr/bin/env python3
"""Reproduce and maintain the pinned Aux Chromium source and patch series."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
REPO = ROOT.parent
VERSION, REVISION = (ROOT / "version.txt").read_text().splitlines()[:2]
DEFAULT_SRC = Path.home() / "aux-chromium-stable/chromium/src"
SRC = Path(os.environ.get("AUX_CHROMIUM_SRC", DEFAULT_SRC)).expanduser().resolve()
DEPOT_TOOLS = Path(os.environ.get("AUX_DEPOT_TOOLS", Path.home() / "aux-chromium-proof/depot_tools"))
ENV = os.environ.copy()
ENV["PATH"] = f"{DEPOT_TOOLS}:{ENV.get('PATH', '')}"
ENV.setdefault("DEVELOPER_DIR", "/Applications/Xcode-beta.app/Contents/Developer")


def run(*args: str, cwd: Path | None = None, capture: bool = False) -> str:
    result = subprocess.run(args, cwd=cwd, env=ENV, check=True,
                            text=True, capture_output=capture)
    return result.stdout.strip() if capture else ""


def series() -> list[Path]:
    rows = (ROOT / "patches/series").read_text().splitlines()
    patches = [ROOT / "patches" / line for line in rows if line and not line.startswith("#")]
    if not patches or len(set(patches)) != len(patches) or not all(p.is_file() for p in patches):
        raise SystemExit("Patch series is empty, duplicated, or references a missing file")
    return patches


def assert_revision() -> None:
    if not (SRC / ".git").exists():
        raise SystemExit(f"Missing Chromium Git source: {SRC}")
    actual = run("git", "rev-parse", "HEAD", cwd=SRC, capture=True)
    if actual != REVISION:
        raise SystemExit(f"Expected Chromium {REVISION}, found {actual}")


def assert_clean() -> None:
    if run("git", "status", "--porcelain", "--untracked-files=no", cwd=SRC, capture=True):
        raise SystemExit("Chromium tracked source has local changes; inspect before changing the patch stack")


def applied() -> bool:
    return subprocess.run(["git", "apply", "--reverse", "--check", str(series()[-1])],
                          cwd=SRC, env=ENV, capture_output=True).returncode == 0


def presetup() -> None:
    if sys.platform != "darwin":
        raise SystemExit("Aux Chromium build currently requires macOS")
    for tool in ("git", "python3", "gn", "autoninja", "gclient"):
        if not shutil.which(tool, path=ENV["PATH"]):
            raise SystemExit(f"Missing {tool}; set AUX_DEPOT_TOOLS if needed")
    print(f"Chromium {VERSION} ({REVISION})")
    print(f"source: {SRC}")
    print(f"free bytes: {shutil.disk_usage(SRC.parent if SRC.parent.exists() else Path.home()).free}")


def setup() -> None:
    presetup()
    parent = SRC.parent
    parent.mkdir(parents=True, exist_ok=True)
    if not (SRC / ".git").exists():
        run("git", "clone", "--no-checkout", "https://chromium.googlesource.com/chromium/src.git", str(SRC))
    run("git", "fetch", "--depth=1", "origin", f"refs/tags/{VERSION}", cwd=SRC)
    tagged = run("git", "rev-parse", "FETCH_HEAD^{commit}", cwd=SRC, capture=True)
    if tagged != REVISION:
        raise SystemExit(f"Stable tag moved: expected {REVISION}, fetched {tagged}")
    assert_clean()
    run("git", "checkout", "--detach", REVISION, cwd=SRC)
    gclient_root = SRC.parent
    if not (gclient_root / ".gclient").exists():
        run("gclient", "config", "https://chromium.googlesource.com/chromium/src.git", cwd=gclient_root)
    run("gclient", "sync", "--no-history", "--shallow", "-j", "8",
        "--revision", f"src@{REVISION}", cwd=gclient_root)
    assert_revision()


def push() -> None:
    assert_revision()
    assert_clean()
    completed = []
    try:
        for patch in series():
            run("git", "apply", "--check", str(patch), cwd=SRC)
            run("git", "apply", str(patch), cwd=SRC)
            completed.append(patch)
            print(f"applied {patch.relative_to(ROOT)}")
    except Exception:
        for patch in reversed(completed):
            run("git", "apply", "--reverse", str(patch), cwd=SRC)
        raise


def pop() -> None:
    assert_revision()
    for patch in reversed(series()):
        run("git", "apply", "--reverse", "--check", str(patch), cwd=SRC)
        run("git", "apply", "--reverse", str(patch), cwd=SRC)
        print(f"removed {patch.relative_to(ROOT)}")
    assert_clean()


def configure(flavor: str) -> None:
    assert_revision()
    output = SRC / "out" / ("AuxDev" if flavor == "dev" else "AuxRelease")
    output.mkdir(parents=True, exist_ok=True)
    args = (ROOT / f"flags.{flavor}.gn").read_text()
    (output / "args.gn").write_text(args)
    run("gn", "gen", str(output), cwd=SRC)
    print(output)


def build(flavor: str) -> None:
    output = SRC / "out" / ("AuxDev" if flavor == "dev" else "AuxRelease")
    if not (output / "build.ninja").exists():
        raise SystemExit("Run configure first")
    run("nice", "-n", "10", "autoninja", "-C", str(output), "chrome", "-j", "8", cwd=SRC)


def run_app(flavor: str, profile: Path | None) -> None:
    output = SRC / "out" / ("AuxDev" if flavor == "dev" else "AuxRelease")
    app = output / "Aux.app"
    if not app.exists():
        raise SystemExit(f"Missing {app}; build first")
    argv = ["open", "-n", "-a", str(app)]
    if profile:
        argv += ["--args", f"--user-data-dir={profile.resolve()}"]
    run(*argv)


def validate() -> None:
    assert_revision()
    run("git", "diff", "--check", cwd=SRC)
    if applied():
        print("patch series applied; source diff has no whitespace errors")
    elif run("git", "status", "--porcelain", "--untracked-files=no", cwd=SRC, capture=True):
        raise SystemExit("Unrecognized Chromium source edits")
    else:
        completed = []
        try:
            for patch in series():
                run("git", "apply", "--check", str(patch), cwd=SRC)
                run("git", "apply", str(patch), cwd=SRC)
                completed.append(patch)
            run("git", "diff", "--check", cwd=SRC)
        finally:
            for patch in reversed(completed):
                run("git", "apply", "--reverse", str(patch), cwd=SRC)
        assert_clean()
        print("patch series applies cleanly to pinned Chromium")


def sanity() -> None:
    validate()
    if not (SRC / "chrome/browser/ui/webui_browser").is_dir():
        raise SystemExit("Webium source missing")
    if not (SRC / "components/surface_embed").is_dir():
        raise SystemExit("SurfaceEmbed source missing")
    print("Pinned source, Webium, and SurfaceEmbed present")


def refresh(destination: str, paths: list[str]) -> None:
    assert_revision()
    patch = ROOT / "patches" / destination
    if not patch.resolve().is_relative_to((ROOT / "patches").resolve()) or not paths:
        raise SystemExit("Specify a patch below chromium/patches and at least one source path")
    diff = run("git", "diff", "--binary", "HEAD", "--", *paths, cwd=SRC, capture=True)
    if not diff:
        raise SystemExit("No tracked diff for selected paths")
    patch.parent.mkdir(parents=True, exist_ok=True)
    patch.write_text(diff + "\n")
    print(patch)


def format_sources(paths: list[str]) -> None:
    assert_revision()
    if not paths:
        raise SystemExit("Specify Chromium source paths to format")
    run("git", "clang-format", "--", *paths, cwd=SRC)


def stage_shell() -> None:
    build_env = ENV.copy()
    build_env["AUX_CHROMIUM_SHELL_BUILD"] = "1"
    subprocess.run(["pnpm", "--filter", "@aux/desktop", "exec", "vite", "build"],
                   cwd=REPO, env=build_env, check=True)
    run("node", str(ROOT / "stage-shell.mjs"), "capture", cwd=REPO)
    run("node", str(ROOT / "stage-shell.mjs"), "install", cwd=REPO)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("setup", "presetup", "configure", "build", "run", "push", "pop", "refresh", "validate", "sanity", "format", "stage-shell"))
    parser.add_argument("--flavor", choices=("dev", "release"), default="dev")
    parser.add_argument("--profile", type=Path)
    parser.add_argument("--patch", help="destination relative to chromium/patches")
    parser.add_argument("paths", nargs="*")
    args = parser.parse_args()
    match args.command:
        case "setup": setup()
        case "presetup": presetup()
        case "push": push()
        case "pop": pop()
        case "configure": configure(args.flavor)
        case "build": build(args.flavor)
        case "run": run_app(args.flavor, args.profile)
        case "validate": validate()
        case "sanity": sanity()
        case "refresh": refresh(args.patch or "", args.paths)
        case "format": format_sources(args.paths)
        case "stage-shell": stage_shell()


if __name__ == "__main__":
    main()
