+
+void AuxSidebarView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  if (const auto* tile = views::AsViewClass<AuxPinnedTile>(source)) {
+    if (!GetWidget()) {
+      return;
+    }
+    menu_tab_contents_ =
+        tile->contents() ? tile->contents()->GetWeakPtr() : nullptr;
+    if (!menu_tab_contents_) {
+      return;
+    }
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    menu_model_->AddItem(kCommandTabReload, l10n_util::GetStringUTF16(IDS_AUX_RELOAD));
+    menu_model_->AddItem(kCommandTabDuplicate, l10n_util::GetStringUTF16(IDS_AUX_DUPLICATE));
+    menu_model_->AddItem(kCommandTabUnpin, l10n_util::GetStringUTF16(IDS_AUX_UNPIN_TAB));
+    menu_model_->AddItem(kCommandTabClose, l10n_util::GetStringUTF16(IDS_AUX_CLOSE));
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+    menu_runner_->RunMenuAt(GetWidget(), nullptr,
+                            gfx::Rect(point, gfx::Size()),
+                            views::MenuAnchorPosition::kTopLeft, source_type);
+    ScheduleRebuild();
+    return;
+  }
+  const auto* row = views::AsViewClass<AuxSidebarRow>(source);
+  if (!row) {
+    return;
+  }
+  if (row->bookmark_id() >= 0) {
+    auto* model =
+        BookmarkModelFactory::GetForBrowserContext(browser_->GetProfile());
+    const auto* node =
+        model ? bookmarks::GetBookmarkNodeByID(model, row->bookmark_id())
+              : nullptr;
+    if (!node || !GetWidget()) {
+      return;
+    }
+    menu_bookmark_id_ = node->id();
+    menu_bookmark_uuid_ = node->uuid().AsLowercaseString();
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    if (!node->is_folder()) {
+      menu_model_->AddItem(kBookmarkCurrent, l10n_util::GetStringUTF16(IDS_AUX_OPEN));
+    }
+    menu_model_->AddItem(kBookmarkNewTab, node->is_folder()
+                                              ? l10n_util::GetStringUTF16(IDS_AUX_OPEN_ALL_IN_NEW_TABS)
+                                              : l10n_util::GetStringUTF16(IDS_AUX_OPEN_IN_NEW_TAB));
+    menu_model_->AddItem(kBookmarkNewWindow, node->is_folder()
+                                                 ? l10n_util::GetStringUTF16(IDS_AUX_OPEN_ALL_IN_NEW_WINDOW)
+                                                 : l10n_util::GetStringUTF16(IDS_AUX_OPEN_IN_NEW_WINDOW));
+    if (!node->is_permanent_node() && !model->client()->IsNodeManaged(node) &&
+        browser_->GetProfile()->GetPrefs()->GetBoolean(
+            bookmarks::prefs::kEditBookmarksEnabled)) {
+      menu_model_->AddItem(kBookmarkEdit, l10n_util::GetStringUTF16(IDS_AUX_EDIT));
+      menu_model_->AddItem(kBookmarkDelete, l10n_util::GetStringUTF16(IDS_AUX_DELETE));
+    }
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+    menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                            views::MenuAnchorPosition::kTopLeft, source_type);
+    ScheduleRebuild();
+    return;
+  }
+  const auto chat = std::ranges::find(chats_, row->chat_id(), &Chat::id);
+  if (chat == chats_.end() || !GetWidget()) {
+    return;
+  }
+  menu_chat_id_ = chat->id;
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  if (chat->can_pin || chat->pinned) {
+    menu_model_->AddItem(kCommandPin, chat->pinned ? l10n_util::GetStringUTF16(IDS_AUX_UNPIN) : l10n_util::GetStringUTF16(IDS_AUX_PIN));
+  }
+  if (chat->unread) {
+    menu_model_->AddItem(kCommandMarkRead, l10n_util::GetStringUTF16(IDS_AUX_MARK_AS_READ));
+  }
+  menu_model_->AddItem(kCommandArchive, l10n_util::GetStringUTF16(IDS_AUX_ARCHIVE));
+  menu_model_->AddItem(kCommandDelete, l10n_util::GetStringUTF16(IDS_AUX_DELETE));
+  menu_pinned_ = chat->pinned;
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::HAS_MNEMONICS);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+  ScheduleRebuild();
+}
