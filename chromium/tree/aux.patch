+      _embeddedNativeInputDocumentBindings.empty()) {
+    return nullptr;
+  }
+  auto input = remote_cocoa::mojom::NativeInputEvent::New();
+  input->binding = _nativeInputDocumentBinding;
+  input->embedded_bindings.assign(_embeddedNativeInputDocumentBindings.begin(),
+                                  _embeddedNativeInputDocumentBindings.end());
+  input->event_data = ui::EventToData(event);
+  return input;
+}
