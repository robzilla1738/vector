+// Supplied45719a0 builds this DialogModel after retiring the actual menu.
+void ShowEditProfileDialog(base::WeakPtr<BrowserWindowInterface> browser,
+                           base::FilePath path) {
+  const auto source = browser && browser->GetProfile()
+      ? browser->GetProfile()->GetWeakPtr() : base::WeakPtr<Profile>();
+  const auto epoch = source ? aux::GetProfileCookieBindingEpoch(source.get()) : std::string();
+  if (!IsCurrentProfileMenuSource(browser, source, epoch)) return;
+  auto* manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  auto* entry =
+      manager
+          ? manager->GetProfileAttributesStorage().GetProfileAttributesWithPath(
+                path)
+          : nullptr;
+  if (!entry || entry->IsOmitted()) return;
+  std::u16string name = entry->GetLocalProfileName();
+  ui::DialogModel::Builder builder;
+  auto* model = builder.model();
+  builder.SetInternalName("AuxProfileMenuEditProfile")
+      .SetTitle(l10n_util::GetStringUTF16(IDS_AUX_EDIT_PROFILE))
+      .SetSubtitle(l10n_util::GetStringUTF16(IDS_AUX_RENAME_DIALOG_SUBTITLE))
+      .AddOkButton(
+          base::BindOnce(
+              [](base::WeakPtr<BrowserWindowInterface> sender,
+                 base::WeakPtr<Profile> source, std::string epoch,
+                 base::FilePath target, ui::DialogModel* dialog) {
+                // A native modal can outlive the retired menu and an account
+                // or profile switch. Keep the original source through Save.
+                if (!IsCurrentProfileMenuSource(sender, source, epoch)) return;
+                auto* profile_manager =
+                    g_browser_process ? g_browser_process->profile_manager()
+                                      : nullptr;
+                auto* target_entry =
+                    profile_manager
+                        ? profile_manager->GetProfileAttributesStorage()
+                              .GetProfileAttributesWithPath(target)
+                        : nullptr;
+                if (!target_entry || target_entry->IsOmitted()) {
+                  return;
+                }
+                const std::u16string normalized = base::CollapseWhitespace(
+                    dialog->GetTextfieldByUniqueId(kAuxEditProfileName)->text(),
+                    true);
+                if (!normalized.empty()) {
+                  target_entry->SetLocalProfileName(normalized,
+                                                    /*is_default_name=*/false);
+                }
+              },
+              browser, source, epoch, path, model),
+          ui::DialogModel::Button::Params().SetLabel(l10n_util::GetStringUTF16(IDS_AUX_SAVE)))
+      .AddCancelButton(base::DoNothing(),
+                       ui::DialogModel::Button::Params().SetLabel(l10n_util::GetStringUTF16(IDS_AUX_CANCEL)))
+      .AddTextfield(
+          kAuxEditProfileName, u"", name,
+          ui::DialogModelTextfield::Params().SetAccessibleName(l10n_util::GetStringUTF16(IDS_AUX_PROFILE_NAME_FIELD)))
+      .SetInitiallyFocusedField(kAuxEditProfileName);
+  constrained_window::ShowBrowserModal(builder.Build(),
+                                       browser->GetWindow()->GetNativeWindow());
+}
