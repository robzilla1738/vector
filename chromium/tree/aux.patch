+using AuxProfileMenuWidgets =
+    std::map<BrowserWindowInterface*, base::WeakPtr<views::Widget>>;
+AuxProfileMenuWidgets& ActiveAuxProfileMenus() {
+  static base::NoDestructor<AuxProfileMenuWidgets> menus;
+  return *menus;
+}
+void RetireAuxProfileMenu(BrowserWindowInterface* browser) {
+  auto& menus = ActiveAuxProfileMenus();
+  auto found = menus.find(browser);
+  if (found == menus.end())
+    return;
+  auto widget = found->second;
+  menus.erase(found);
+  if (widget) {
+#if defined(AUX_BROWSER_ONLY_NATIVE_STARTUP)
+    // CloseNow bypasses the client-owned Widget's retirement callback.
+    widget->Close();
+#else
+    widget->CloseNow();
+#endif
+  }
+}
+void TrackAuxProfileMenu(BrowserWindowInterface* browser,
+                         views::Widget* widget) {
+  ActiveAuxProfileMenus()[browser] = widget->GetWeakPtr();
+}
+void ForgetAuxProfileMenu(BrowserWindowInterface* browser,
+                          views::Widget* widget) {
+  auto& menus = ActiveAuxProfileMenus();
+  auto found = menus.find(browser);
+  if (found != menus.end() && (!found->second || found->second.get() == widget))
+    menus.erase(found);
+}
+
+#if defined(AUX_BROWSER_ONLY_NATIVE_STARTUP)
+// The client owns both objects. Destroy the Widget before its non-View delegate
+// and defer deletion out of native widget/activation observer iterations.
+struct OwnedPrimaryProfileMenu {
+  std::unique_ptr<views::BubbleDialogDelegate> delegate;
+  std::unique_ptr<views::Widget> widget;
+  ~OwnedPrimaryProfileMenu() {
+    widget.reset();
+    delegate.reset();
+  }
+};
+using OwnedPrimaryProfileMenus =
+    std::map<BrowserWindowInterface*, std::unique_ptr<OwnedPrimaryProfileMenu>>;
+OwnedPrimaryProfileMenus& PrimaryProfileMenuOwners() {
+  static base::NoDestructor<OwnedPrimaryProfileMenus> owners;
+  return *owners;
+}
+void CloseOwnedPrimaryProfileMenu(BrowserWindowInterface* browser,
+                                  views::Widget* expected,
+                                  views::Widget::ClosedReason) {
+  auto& owners = PrimaryProfileMenuOwners();
+  const auto found = owners.find(browser);
+  if (found == owners.end() || found->second->widget.get() != expected) return;
+  auto owner = std::move(found->second);
+  owners.erase(found);
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(owner));
+}
+views::Widget* CreateOwnedPrimaryProfileMenu(
+    BrowserWindowInterface* browser,
+    std::unique_ptr<views::BubbleDialogDelegate> delegate) {
+  auto& owners = PrimaryProfileMenuOwners();
+  // Retiring/replacing an earlier menu must not synchronously delete a Widget
+  // whose native close callback or observer notification is still on-stack.
+  if (const auto old = owners.find(browser); old != owners.end()) {
+    auto retired = std::move(old->second);
+    owners.erase(old);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(retired));
+  }
+  auto owner = std::make_unique<OwnedPrimaryProfileMenu>();
+  owner->delegate = std::move(delegate);
+  owner->widget = views::BubbleDialogDelegate::CreateBubble(owner->delegate.get());
+  auto* widget = owner->widget.get();
+  widget->MakeCloseSynchronous(base::BindOnce(
+      &CloseOwnedPrimaryProfileMenu, browser, widget));
+  owners.emplace(browser, std::move(owner));
+  return widget;
+}
+// Child menus have independent native close boundaries. Keep their delegate
+// alive until after the client-owned Widget, just like the primary menu above.
+using OwnedAuxProfilePopups =
+    std::map<views::Widget*, std::unique_ptr<OwnedPrimaryProfileMenu>>;
+OwnedAuxProfilePopups& AuxProfilePopupOwners() {
+  static base::NoDestructor<OwnedAuxProfilePopups> owners;
+  return *owners;
+}
+void RetireOwnedAuxProfilePopup(views::Widget* widget,
+                                 views::Widget::ClosedReason) {
+  auto& owners = AuxProfilePopupOwners();
+  const auto found = owners.find(widget);
+  if (found == owners.end()) return;
+  auto owner = std::move(found->second);
+  owners.erase(found);
+  // No further row action may run while native teardown is deferred out of
+  // activation/close observer iterations.
+  widget->GetContentsView()->SetEnabled(false);
+  widget->Hide();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(
+      FROM_HERE, std::move(owner));
+}
+views::Widget* CreateOwnedAuxProfilePopup(
+    std::unique_ptr<views::BubbleDialogDelegate> delegate) {
+  auto owner = std::make_unique<OwnedPrimaryProfileMenu>();
+  owner->delegate = std::move(delegate);
+  owner->widget = views::BubbleDialogDelegate::CreateBubble(owner->delegate.get());
+  auto* widget = owner->widget.get();
+  widget->MakeCloseSynchronous(base::BindOnce(
+      &RetireOwnedAuxProfilePopup, widget));
+  AuxProfilePopupOwners().emplace(widget, std::move(owner));
+  return widget;
+}
+#endif
+void RetireAuxProfilePopup(views::Widget* widget) {
+  if (!widget) return;
+#if defined(AUX_BROWSER_ONLY_NATIVE_STARTUP)
+  RetireOwnedAuxProfilePopup(widget, views::Widget::ClosedReason::kUnspecified);
+#else
+  widget->CloseNow();
+#endif
+}
+void DestroyAuxProfilePopup(views::Widget* widget) {
+  if (!widget) return;
+#if defined(AUX_BROWSER_ONLY_NATIVE_STARTUP)
+  auto& owners = AuxProfilePopupOwners();
+  const auto found = owners.find(widget);
+  if (found == owners.end()) return;
+  auto owner = std::move(found->second);
+  owners.erase(found);
+  // Parent destruction already occurs outside the native callback stack. Tear
+  // down its current child before any parent delegate/row members disappear.
+  owner.reset();
+#else
+  widget->CloseNow();
+#endif
+}
