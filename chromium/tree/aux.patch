+// Menu retirement is asynchronous. An old command must not retarget a
+// window that switched profiles/accounts before the posted action executes.
+bool IsCurrentProfileMenuSource(base::WeakPtr<BrowserWindowInterface> sender,
+                                base::WeakPtr<Profile> source,
+                                const std::string& epoch) {
+  const auto* unload = sender ? UnloadController::From(sender.get()) : nullptr;
+  return sender && source && !epoch.empty() && source->IsRegularProfile() &&
+      !source->IsOffTheRecord() && sender->GetProfile() == source.get() &&
+      sender->GetWindow() && unload && !unload->is_attempting_to_close_browser() &&
+      !unload->is_delete_scheduled() && !browser_shutdown::HasShutdownStarted() &&
+      !browser_shutdown::IsTryingToQuit() &&
+      aux::GetProfileCookieBindingEpoch(source.get()) == epoch &&
+      !aux::IsProfileCookieRestorePending(source.get());
+}
+void RunProfileMenuAction(base::WeakPtr<BrowserWindowInterface> sender,
+                          base::WeakPtr<Profile> source, std::string epoch,
+                          base::OnceClosure action) {
+  const bool current = IsCurrentProfileMenuSource(sender, source, epoch);
+  LOG(ERROR) << "Aux profile menu action: source_current=" << current
+             << " action_present=" << !!action;
+  if (current) std::move(action).Run();
+}
+// Supplied040fe7a4 receives the actual weak sender, not a global active window.
+// No persistent preview/loading owner is introduced for direct selections.
+void DispatchSelectedProfile(
+    base::WeakPtr<BrowserWindowInterface> sender, base::FilePath path) {
+#if defined(AUX_BROWSER_ONLY_NATIVE_STARTUP)
+  const auto source = sender && sender->GetProfile()
+      ? sender->GetProfile()->GetWeakPtr() : base::WeakPtr<Profile>();
+  const auto epoch = source ? aux::GetProfileCookieBindingEpoch(source.get())
+                            : std::string();
+  const auto* state = sender ? BrowserInitState::From(sender.get()) : nullptr;
+  if (path.empty() || !source || !state || state->is_aux_profile_switch_cache() ||
+      sender->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !IsCurrentProfileMenuSource(sender, source, epoch)) {
+    LOG(ERROR) << "Aux ordinary profile selection: source gate rejected"
+               << " path_present=" << !path.empty()
+               << " source_present=" << !!source
+               << " state_present=" << !!state;
+    return;
+  }
+  LOG(ERROR) << "Aux ordinary profile selection: native window dispatch";
+  // Ordinary profile selection activates/opens the native isolated window.
+  // Preserve this window's live tabs, unsent drafts and profile-owned services.
+  profiles::SwitchToProfile(path, /*always_create=*/false);
+#elif BUILDFLAG(IS_MAC) && BUILDFLAG(ENABLE_AUX_BROWSER)
+  aux::ProfileSwitchRequest::Dispatch(std::move(sender), std::move(path));
+#else
+  // This adapter is registered only in the Aux macOS product. Preserve the
+  // existing non-product selector behavior in other Chromium build targets.
+  if (sender) {
+    profiles::SwitchToProfile(path, /*always_create=*/false);
+  }
+#endif
+}
