+    return false;
+  }
+  if (file_chooser_opened_callback_) {
+    LOG(WARNING) << "Aux profile transition rejected: aim-cold.file-chooser-open-callback";
+    return false;
+  }
+  if (file_chooser_closed_callback_) {
+    LOG(WARNING) << "Aux profile transition rejected: aim-cold.file-chooser-close-callback";
+    return false;
+  }
+  return true;
+}
