+  if (operation === 'absent') return state === undefined;
+  if (!state || state.captureId !== captureId) return false;
+  if (operation === 'current') {
+    state.foreign(state.observer?.takeRecords() || []);
+    return !state.dirty && state.originals.every(item => item.node.isConnected && item.node.getAttribute('style') === item.maskedStyle && getComputedStyle(item.node).opacity === '0');
+  }
+  if (operation !== 'restore') return false;
+  // Drain style ABA and other queued author mutations before deciding that
+  // any original mask is still ours. Keep observing through author reactions.
+  state.foreign(state.observer?.takeRecords() || []);
+  let restorationMutation = false;
+  for (const item of state.originals) {
+    if (item.foreignStyle || !item.node.isConnected || item.node.getAttribute('style') !== item.maskedStyle) return false;
+    const before = item.node.getAttribute('style');
+    if (item.style === null) item.node.removeAttribute('style');
+    else item.node.setAttribute('style',item.style);
+    const records = state.observer?.takeRecords() || [];
+    const ownIndex = records.findIndex(record => record.type === 'attributes' && record.attributeName === 'style' && record.target === item.node && record.oldValue === before);
+    const others = records.filter((record,index) => index !== ownIndex);
+    if (others.length) restorationMutation = true;
+    state.foreign(others);
+    if (item.foreignStyle || !item.node.isConnected || item.node.getAttribute('style') !== item.style) return false;
+  }
+  const remaining = state.observer?.takeRecords() || [];
+  if (remaining.length) restorationMutation = true;
+  state.foreign(remaining);
+  if (restorationMutation || !state.originals.every(item => !item.foreignStyle && item.node.isConnected && item.node.getAttribute('style') === item.style)) return false;
+  state.observer?.disconnect();
+  delete globalThis[key];
+  return true;
+})
+)AUXMASK";
+}
+#endif
