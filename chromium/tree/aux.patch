+  }
+  if (enabled) {
+    _embeddedNativeInputDocumentBindings.insert(binding);
+  } else {
+    _embeddedNativeInputDocumentBindings.erase(binding);
+  }
+}
+
+- (void)setNativeInputDocumentBinding:(const std::string&)binding {
+  _nativeInputDocumentBinding = binding.size() <= 64 ? binding : std::string();
+  _embeddedNativeInputDocumentBindings.clear();
+}
