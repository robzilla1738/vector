+#if BUILDFLAG(ENABLE_AUX_BROWSER)
+bool LocationBarView::CanPrepareForAuxProfileSwitch(Profile* target) const {
+  if (!(target)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.01";
+    return false;
+  }
+  if (!(target->IsRegularProfile())) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.02";
+    return false;
+  }
+  if (!(browser_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.03";
+    return false;
+  }
+  if (!(browser_->GetType() == BrowserWindowInterface::TYPE_NORMAL)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.04";
+    return false;
+  }
+  if (!(profile_ == browser_->GetProfile())) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.05";
+    return false;
+  }
+  if (!(is_initialized_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.06";
+    return false;
+  }
+  if (!(!aux_profile_switch_paused_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.07";
+    return false;
+  }
+  if (!(!in_popup_state_transition_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.08";
+    return false;
+  }
+  if (!(!is_popup_mode_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.09";
+    return false;
+  }
+  if (!(omnibox_controller_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.10";
+    return false;
+  }
+  if (!(omnibox_view_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.11";
+    return false;
+  }
+  if (!(selected_keyword_view_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.12";
+    return false;
+  }
+  if (!(pref_registrar_)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.13";
+    return false;
+  }
+  if (omnibox_popup_aim_presenter_ &&
+      !omnibox_popup_aim_presenter_->CanRetireUnusedForAuxProfileSwitch()) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.14";
+    return false;
+  }
+  if (omnibox::IsWebUIOmniboxPopupEnabled() &&
+      (!aux_classic_webui_popup_ ||
+       !aux_classic_webui_popup_->CanPrepareForAuxProfileSwitch())) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.16";
+    return false;
+  }
+  if (!(!omnibox::IsWebUIOmniboxInBrowserViewEnabled())) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.17";
+    return false;
+  }
+  if (!(!base::FeatureList::IsEnabled(omnibox::kWebUIOmniboxFullPopup))) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.18";
+    return false;
+  }
+  if (!(!omnibox_controller_->IsPopupOpen())) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.19";
+    return false;
+  }
+  if (!(omnibox_view_->CanPrepareForAuxProfileSwitch())) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.20";
+    return false;
+  }
+  // These checks come AFTER the original AIM renderer-reset acknowledgment,
+  // live context/session ownership, classic popup and native input guards.
+  // The intermediate window-owned handoff must also be genuinely empty.
+  const auto* context = browser_ ? SearchboxContextData::From(browser_) : nullptr;
+  if (context && context->HasPendingContextForAuxProfileSwitch()) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.pending-context";
+    return false;
+  }
+  if (omnibox_popup_file_selector_ &&
+      !omnibox_popup_file_selector_->CanRetireUnusedForAuxProfileSwitch(
+          /*context_owners_settled=*/context != nullptr)) {
+    LOG(WARNING) << "Aux profile transition rejected: readiness.location.15";
+    return false;
+  }
+  return true;
+}
+
+uint64_t LocationBarView::BeginAuxProfileSwitch(Profile* target) {
+  CHECK(CanPrepareForAuxProfileSwitch(target));
+  aux_profile_switch_paused_ = true;
+  aux_profile_switch_source_ = profile_->GetWeakPtr();
+  content::WebContents* source_contents = GetWebContents();
+  aux_profile_switch_contents_ =
+      source_contents ? source_contents->GetWeakPtr()
+                      : base::WeakPtr<content::WebContents>();
+  aux_profile_switch_had_contents_ = source_contents != nullptr;
+  aux_profile_switch_saved_contents_ = false;
+  const uint64_t generation = ++aux_profile_switch_generation_;
+  weak_factory_.InvalidateWeakPtrs();
+  if (aux_classic_webui_popup_)
+    aux_classic_webui_popup_->PrepareForAuxProfileSwitch();
+  // Admission proved neither owner was invoked or retains pending work.
+  // Retire their source-profile WebContents only after the transaction begins.
+  aux_profile_switch_had_aim_presenter_ = !!omnibox_popup_aim_presenter_;
+  aux_profile_switch_had_file_selector_ = !!omnibox_popup_file_selector_;
+  omnibox_popup_file_selector_.reset();
+  omnibox_popup_aim_presenter_.reset();
+  pref_registrar_->Reset();
+  omnibox_view_->PrepareForAuxProfileSwitch();
+  omnibox_controller_->StopAutocomplete(/*clear_result=*/true);
+  return generation;
+}
+
+void LocationBarView::BindPrefsForAuxProfileSwitch() {
+  pref_registrar_->Reset();
+  pref_registrar_->Init(profile_->GetPrefs());
+  pref_registrar_->Add(omnibox::kShowAiModeOmniboxButton,
+                       base::BindRepeating(&LocationBarView::OnChanged,
+                                           base::Unretained(this)));
+}
+
+void LocationBarView::RebindAuxProfileSwitch(uint64_t generation) {
+  CHECK(aux_profile_switch_paused_);
+  CHECK_EQ(generation, aux_profile_switch_generation_);
+  CHECK(browser_->GetProfile()->IsRegularProfile());
+  CHECK(browser_->GetTabStripModel()->empty());
+  // Only the genuine Browser detach/deactivate path marks this after the
+  // real view saved draft/selection/IME state into this exact source tab.
+  CHECK(!aux_profile_switch_had_contents_ ||
+        (aux_profile_switch_contents_ && aux_profile_switch_saved_contents_));
+  profile_ = browser_->GetProfile();
+  omnibox_controller_->RebindClientForAuxProfileSwitch(
+      std::make_unique<ChromeOmniboxClient>(this, browser_, profile_));
+  selected_keyword_view_->RebindForAuxProfileSwitch(*profile_);
+  omnibox_view_->RebindForAuxProfileSwitch();
+  BindPrefsForAuxProfileSwitch();
+}
+
+void LocationBarView::EndAuxProfileSwitch(uint64_t generation) {
+  if (generation != aux_profile_switch_generation_ ||
+      !aux_profile_switch_paused_) {
+    return;
+  }
+  CHECK_EQ(profile_, browser_->GetProfile());
+  // End follows either committed client rebinding or Abort's source restore.
+  // Use the exact original constructors, now against that coherent profile.
+  CHECK(!omnibox_popup_aim_presenter_);
+  CHECK(!omnibox_popup_file_selector_);
+  if (aux_classic_webui_popup_)
+    aux_classic_webui_popup_->ResumeAfterAuxProfileSwitch();
+  if (aux_profile_switch_had_aim_presenter_) {
+    omnibox_popup_aim_presenter_ = std::make_unique<OmniboxPopupAimPresenter>(
+        /*location_bar=*/this, omnibox_controller_.get(),
+        /*presenter_delegate=*/*this);
+  }
+  if (aux_profile_switch_had_file_selector_) {
+    omnibox_popup_file_selector_ = std::make_unique<OmniboxPopupFileSelector>(
+        GetWidget()->GetNativeWindow());
+  }
+  aux_profile_switch_had_aim_presenter_ = false;
+  aux_profile_switch_had_file_selector_ = false;
+  aux_profile_switch_paused_ = false;
+  aux_profile_switch_source_.reset();
+  aux_profile_switch_contents_.reset();
+  aux_profile_switch_had_contents_ = false;
+  aux_profile_switch_saved_contents_ = false;
+  OnChanged();
+}
+
+void LocationBarView::AbortAuxProfileSwitch(uint64_t generation) {
+  if (generation != aux_profile_switch_generation_ ||
+      !aux_profile_switch_paused_) {
+    return;
+  }
+  CHECK_EQ(aux_profile_switch_source_.get(), browser_->GetProfile());
+  CHECK_EQ(profile_, browser_->GetProfile());
+  // The original client/providers were never replaced before identity.
+  // Restore real source observations after its actual tabs are restored.
+  omnibox_view_->RebindForAuxProfileSwitch();
+  BindPrefsForAuxProfileSwitch();
+  EndAuxProfileSwitch(generation);
+}
+#endif
