+    return false;
+  }
+  if (edit_model_ && !selected_context_released) {
+    LOG(WARNING) << "Aux profile transition rejected: aim-cold.file-edit-model";
+    return false;
+  }
+  if (deactivation_blocker_) {
+    LOG(WARNING) << "Aux profile transition rejected: aim-cold.file-blocker";
+    return false;
+  }
+  if (weak_factory_.HasWeakPtrs()) {
+    LOG(WARNING) << "Aux profile transition rejected: aim-cold.file-async-work";
+    return false;
+  }
+  if (open_ai_mode_callback_) {
