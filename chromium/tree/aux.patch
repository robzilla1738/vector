+  background-color: var(--color-searchbox-results-icon);
+}
+
+:host-context(cr-searchbox-match:is(:focus-within, [selected])):host-context(
+    [command-bar-style]) #text {
+  color: var(--color-searchbox-results-foreground-selected,
+      var(--color-searchbox-results-foreground));
+}
+
+:host-context(cr-searchbox-match:is(:focus-within, [selected])):host-context(
+    [command-bar-style]) #action-icon[style*='mask-image'] {
+  background-color: var(--color-searchbox-results-foreground-selected,
+      var(--color-searchbox-results-foreground));
+}
