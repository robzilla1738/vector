+SkColor ResolveProfileMenuColor(const views::View* view,
+                                ProfileMenuColor role) {
+  const bool dark =
+      view->GetWidget() && view->GetWidget()->GetColorMode() ==
+                               ui::ColorProviderKey::ColorMode::kDark;
+  switch (role) {
+    case ProfileMenuColor::kForeground:
+      return AuxThemeForeground(view, dark ? 0xd9fafafa : 0xd90a0a0a);
+    case ProfileMenuColor::kSecondary:
+      return AuxThemeForeground(view, dark ? 0x8cfafafa : 0x8c0a0a0a);
+    case ProfileMenuColor::kMuted:
+      return AuxThemeForeground(view, dark ? 0x73fafafa : 0x730a0a0a);
+    case ProfileMenuColor::kHover:
+      return AuxThemeForeground(view, dark ? 0x1afafafa : 0x140a0a0a);
