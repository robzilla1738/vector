+  if (aux_pending_file_operations_ != 0) {
+    LOG(ERROR) << "Aux profile transition rejected: file-read-or-context-handoff";
+    return false;
+  }
+  if (aux_ever_started_work_ && !aux_canceled_dialog_complete_ &&
+      !selected_context_released) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-started-work";
+    return false;
+  }
+  if (file_dialog_) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-dialog";
+    return false;
+  }
+  if (web_contents_ && !selected_context_released) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-source-tab";
+    return false;
+  }
+  if (edit_model_ && !selected_context_released) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-edit-model";
+    return false;
+  }
+  if (deactivation_blocker_) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-blocker";
+    return false;
+  }
+  if (weak_factory_.HasWeakPtrs()) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-async-work";
+    return false;
+  }
+  if (open_ai_mode_callback_) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-open-callback";
+    return false;
+  }
+  if (file_chooser_opened_callback_) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-chooser-open-callback";
+    return false;
+  }
+  if (file_chooser_closed_callback_) {
+    LOG(ERROR) << "Aux profile transition rejected: aim-cold.file-chooser-close-callback";
+    return false;
+  }
+  return true;
+}
