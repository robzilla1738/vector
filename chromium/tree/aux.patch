+void SessionServiceBase::ResetFromCurrentBrowsersWithWriteCompletion(
+    base::OnceCallback<void(sessions::SessionWriteCompletion)> done) {
+  auto report = base::BindPostTaskToCurrentDefault(std::move(done));
+  if (!is_saving_enabled_) {
+    sessions::SessionWriteCompletion result;
+    result.backend_outcomes.push_back(
+        sessions::SessionBackendWriteOutcome::kSavingDisabled);
+    std::move(report).Run(std::move(result));
+    return;
+  }
+  auto weak = weak_factory_.GetWeakPtr();
+  ResetFromCurrentBrowsers();
+  if (!weak) {
+    sessions::SessionWriteCompletion result;
+    result.backend_outcomes.push_back(
+        sessions::SessionBackendWriteOutcome::kOwnerLost);
+    std::move(report).Run(std::move(result));
+    return;
+  }
+  command_storage_manager_->SaveWithCompletion(std::move(report));
+}
+
+void SessionServiceBase::FlushPendingCommandsWithWriteCompletion(
+    base::OnceCallback<void(sessions::SessionWriteCompletion)> done) {
+  auto report = base::BindPostTaskToCurrentDefault(std::move(done));
+  if (!is_saving_enabled_ || !command_storage_manager_) {
+    sessions::SessionWriteCompletion result;
+    result.backend_outcomes.push_back(!is_saving_enabled_
+        ? sessions::SessionBackendWriteOutcome::kSavingDisabled
+        : sessions::SessionBackendWriteOutcome::kBackendUnavailable);
+    std::move(report).Run(std::move(result));
+    return;
+  }
+  command_storage_manager_->SaveWithCompletion(std::move(report));
+}
+
+base::WeakPtr<SessionServiceBase>
+SessionServiceBase::GetWeakPtrForNativeSessionWriterParticipant() {
+  return weak_factory_.GetWeakPtr();
+}
+
+void SessionServiceBase::CloseCommandWriterAdmissionAndObserve(
+    base::OnceCallback<void(sessions::SessionManagerCloseObservation)> done) {
+  if (!command_storage_manager_) {
+    sessions::SessionManagerCloseObservation result;
+    result.manager_unavailable = true;
+    auto report = base::BindPostTaskToCurrentDefault(std::move(done));
+    std::move(report).Run(std::move(result));
+    return;
+  }
+  command_storage_manager_->CloseWriterAdmissionAndObserve(std::move(done));
+}
