diff --git a/chrome/common/aux_semantic_filters.mojom b/chrome/common/aux_semantic_filters.mojom
new file mode 100644
index 0000000000000000000000000000000000000000..eff635e29c8aa7afc89f4685c267d95a9a09513d
--- /dev/null
+++ b/chrome/common/aux_semantic_filters.mojom
@@ -0,0 +1,57 @@
+// Copyright 2026 The Aux Authors. BSD-3-Clause.
+module chrome.mojom;
+
+// This interface is bound only to the exact browser-created semantic WebUI
+// document. No page, shell window or renderer-authored Profile/source owner can
+// bind it. Native retains ownership metadata; the semantic document sees data.
+struct SemanticFilterSource {
+  string id;
+  string text;
+  bool native_maintained;
+  // Canonical builtin source identity controls parser diagnostics separately
+  // from trusted scriptlet permissions. Hash binds the exact source bytes.
+  bool builtin_compilation;
+  string sha256;
+};
+struct SemanticFilterSnapshot {
+  string generation;
+  array<SemanticFilterSource> sources;
+  string public_suffix_list;
+  bool html_transform;
+  bool scriptlets;
+};
+enum SemanticFilterOperation {
+  kNetwork,
+  kPopup,
+  kDocumentCosmetics,
+  kGenericCosmetics,
+  kResponseHeaders,
+  kHtml,
+  kBodyPlan,
+  kBody,
+  kScriptlets,
+};
+struct SemanticFilterRequest {
+  uint64 id;
+  string generation;
+  SemanticFilterOperation operation;
+  // Native serializes the exact captured source plus operation-specific data.
+  // The receiver validates size/shape again; it never creates page authority.
+  string payload;
+};
+struct SemanticFilterResponse {
+  uint64 id;
+  string generation;
+  bool ok;
+  string payload;
+  string error;
+};
+interface NativeSemanticBridge {
+  // The native server supplies the immutable snapshot only once to its saved
+  // original document. ReportCompilation cannot publish Profile configuration.
+  Initialize() => (SemanticFilterSnapshot snapshot);
+  ReportCompilation(string generation, bool accepted, string diagnostics);
+  // At most one waiting Next callback and one executing request per document.
+  Next() => (SemanticFilterRequest request);
+  Complete(SemanticFilterResponse response);
+};
