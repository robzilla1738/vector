+TEST_F(RenderWidgetHostViewMacNativeInputBFCacheTest,
+       CacheRestoreReacquiresAdmissionWithoutReusingOriginalSubscription) {
+  ASSERT_NO_FATAL_FAILURE(AdmitPrimaryDocument());
+  const auto frame = contents()->GetPrimaryMainFrame()->GetWeakPtr();
+  const auto document = main_rfh()->GetWeakDocumentPtr();
+  const auto original_view = view_;
+  unsigned original_retired = 0;
+  auto original_subscription = view()->ObserveNativeInputAdmissionRetirement(
+      document, base::BindRepeating([](unsigned* count) { ++*count; },
+                                    &original_retired));
+  ASSERT_TRUE(original_subscription);
+  NavigateAndCommit(GURL("https://native-input-cache-next.test/second"));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(frame);
+  ASSERT_TRUE(frame->IsInBackForwardCache());
+  ASSERT_FALSE(frame->IsActive());
+  ASSERT_TRUE(original_view);
+  EXPECT_FALSE(static_cast<RenderWidgetHostViewMac*>(original_view.get())
+                   ->HasNativeInputAdmissionForDocument(document));
+  EXPECT_EQ(original_retired, 1u);
+
+  ASSERT_EQ(NavigationSimulator::GoBack(contents()), frame.get());
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(main_rfh(), frame.get());
+  ASSERT_TRUE(frame->IsActive());
+  ASSERT_EQ(main_rfh()->GetRenderWidgetHost()->GetView(), original_view.get());
+  view_ = original_view;
+  // No manual InitAsChild or synthetic ready state: actual restore hooks must
+  // publish a fresh binding and receive the real Cocoa acknowledgement.
+  ASSERT_TRUE(view()->HasNativeInputAdmissionForDocument(document));
+  EXPECT_EQ(original_retired, 1u);
+  unsigned restored_retired = 0;
+  auto restored_subscription = view()->ObserveNativeInputAdmissionRetirement(
+      document, base::BindRepeating([](unsigned* count) { ++*count; },
+                                    &restored_retired));
+  ASSERT_TRUE(restored_subscription);
+  NavigateAndCommit(GURL("https://native-input-cache-third.test/third"));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(original_retired, 1u);
+  EXPECT_EQ(restored_retired, 1u);
+}
