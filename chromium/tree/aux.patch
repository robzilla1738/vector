@@ -111,6 +111,27 @@ void AddGrayscaleSysColorOverrides(ColorMixer& mixer,
                                                 : kColorRefNeutral94};
 }
 
+// Aux uses a neutral grey dark palette: a raised grey frame and sidebar, with
+// the toolbar flush with the page.
+void AddAuxNeutralDarkSurfaces(ColorMixer& mixer) {
+  constexpr SkColor kPage = SkColorSetRGB(0x1B, 0x1B, 0x1B);
+  constexpr SkColor kFrame = SkColorSetRGB(0x2D, 0x2D, 0x2D);
+  constexpr SkColor kRaised = SkColorSetRGB(0x3D, 0x3D, 0x3D);
+  mixer[kColorSysSurface] = {kPage};
+  mixer[kColorSysBase] = {kPage};
+  mixer[kColorSysBaseContainer] = {kFrame};
+  mixer[kColorSysBaseContainerElevated] = {kFrame};
+  mixer[kColorSysHeader] = {kFrame};
+  mixer[kColorSysHeaderInactive] = {kFrame};
+  mixer[kColorSysHeaderContainer] = {kRaised};
+  mixer[kColorSysHeaderContainerInactive] = {kRaised};
+  mixer[kColorSysOmniboxContainer] = {kFrame};
+  mixer[kColorSysNeutralContainer] = {kFrame};
+  mixer[kColorSysDivider] = {kRaised};
+  mixer[kColorSysOnHeaderDivider] = {kRaised};
+  mixer[kColorSysSurfaceVariant] = {kFrame};
+}
+
 }  // namespace
 
 void AddSysColorMixer(ColorProvider* provider, const ColorProviderKey& key) {
@@ -410,6 +431,10 @@ void AddSysColorMixer(ColorProvider* provider, const ColorProviderKey& key) {
              key.user_color.has_value()) {
     AddThemedSysColorOverrides(mixer, key);
   }
+
+  if (dark_mode) {
+    AddAuxNeutralDarkSurfaces(mixer);
+  }
 }
 
