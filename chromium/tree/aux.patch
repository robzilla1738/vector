+namespace blink {
+struct BLINK_COMMON_EXPORT NativeMouseLinkObservation {
+  NativeMouseLinkObservation(base::UnguessableToken nonce,
+                             DocumentToken document,
+                             std::string href);
+  NativeMouseLinkObservation(const NativeMouseLinkObservation&);
+  NativeMouseLinkObservation(NativeMouseLinkObservation&&);
