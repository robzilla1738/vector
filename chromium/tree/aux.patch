+using AuxRawMap = std::map<DomStorageDatabase::Key, DomStorageDatabase::Value>;
+struct AuxDomMap {
+  DomStorageDatabase::MapLocator locator;
+  AuxRawMap source;
+  AuxRawMap target;
+  std::optional<base::Time> last_accessed;
+  std::optional<base::Time> last_modified;
