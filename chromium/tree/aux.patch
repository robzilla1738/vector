+base::CallbackListSubscription
+RenderWidgetHostViewChildFrame::ObserveNativeInputAdmissionRetirement(
+    const WeakDocumentPtr& document,
+    base::RepeatingClosure callback) {
+  auto* root = GetRootRenderWidgetHostView();
+  if (!root || !HasNativeInputAdmissionForDocument(document)) {
+    return {};
+  }
+  return root->ObserveEmbeddedNativeInputAdmissionRetirement(
+      this, document, std::move(callback));
+}
+bool RenderWidgetHostViewChildFrame::HasNativeInputAdmissionForDocument(
+    const WeakDocumentPtr& document) const {
+  auto* root = GetRootRenderWidgetHostView();
+  return root &&
+         root->HasEmbeddedNativeInputAdmission(
+             const_cast<RenderWidgetHostViewChildFrame*>(this), document);
+}
+void RenderWidgetHostViewChildFrame::AwaitNativeInputAdmissionForDocument(
+    const WeakDocumentPtr& document,
+    base::OnceCallback<void(bool)> callback) {
+  if (auto* root = GetRootRenderWidgetHostView()) {
+    root->AwaitEmbeddedNativeInputAdmission(this, document,
+                                            std::move(callback));
+  } else {
+    std::move(callback).Run(false);
+  }
+}
+void RenderWidgetHostViewChildFrame::RetireNativeInputAdmission() {
+  if (auto* root = GetRootRenderWidgetHostView()) {
+    root->RetireEmbeddedNativeInputAdmission(this);
+  }
+}
