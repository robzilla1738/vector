+void LocationBarView::ShowAuxSitePanel() {
+  // A press on the button first deactivates the open panel, which closes it.
+  constexpr base::TimeDelta kSamePress = base::Milliseconds(200);
+  WebContents* contents = GetWebContents();
+  if (!contents || base::TimeTicks::Now() - aux_site_panel_closed_ < kSamePress)
+    return;
+  // A popped-out sidebar stays while its panel is open.
+  auto* region = BrowserView::GetBrowserViewForBrowser(browser_)->vertical_tab_strip_region_view();
+  if (region)
+    aux_site_panel_lock_ = region->GetExpandOnHoverLock(ExpandOnHoverLockType::kKeepCurrentState);
+  auto* widget = aux::ShowAuxSitePanel(
+      *browser_, *contents, *aux_site_button_,
+      base::BindRepeating(base::IgnoreResult(&LocationBarView::ShowPageInfoDialog),
+                          weak_factory_.GetWeakPtr()));
+  widget->widget_delegate()->RegisterWindowClosingCallback(base::BindOnce(
+      [](base::WeakPtr<LocationBarView> owner) {
+        if (!owner)
+          return;
+        owner->aux_site_panel_closed_ = base::TimeTicks::Now();
+        owner->aux_site_panel_lock_.reset();
+      },
+      weak_factory_.GetWeakPtr()));
+}
