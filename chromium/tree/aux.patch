diff --git a/chrome/services/aux_document/document_extractor.cc b/chrome/services/aux_document/document_extractor.cc
new file mode 100644
index 0000000000000000000000000000000000000000..310d5f2b6c2932e258d17fc67b7ed7eecc82015c
--- /dev/null
+++ b/chrome/services/aux_document/document_extractor.cc
@@ -0,0 +1,336 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "chrome/services/aux_document/document_extractor.h"
+
+#include <array>
+
+#include "base/check.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/memory/shared_memory_mapping.h"
+#include "base/process/process.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/string_view_util.h"
+#include "base/task/thread_pool.h"
+#include "chrome/services/aux_document/document_segments.h"
+#include "chrome/services/aux_document/media_jobs.h"
+#include "content/public/common/content_switches.h"
+#include "crypto/hash.h"
+namespace aux::document {
+namespace {
+base::DictValue LocatedSegment(const mojom::Segment& segment) {
+  base::DictValue locator;
+  if (segment.locator->is_text()) {
+    const auto& value = *segment.locator->get_text();
+    locator.Set("kind", "text");
+    locator.Set("line", static_cast<double>(value.line));
+    locator.Set("offset", static_cast<double>(value.offset));
+  } else if (segment.locator->is_pdf()) {
+    const auto& value = *segment.locator->get_pdf();
+    locator.Set("kind", "pdf");
+    locator.Set("page", static_cast<double>(value.page));
+    locator.Set("block", static_cast<double>(value.block));
+    locator.Set("offset", static_cast<double>(value.offset));
+  } else {
+    const auto& value = *segment.locator->get_docx();
+    locator.Set("kind", "docx");
+    locator.Set("part", value.part);
+    locator.Set("paragraph", static_cast<double>(value.paragraph));
+    locator.Set("offset", static_cast<double>(value.offset));
+    if (value.heading_level) {
+      locator.Set("headingLevel", value.heading_level);
+    }
+    if (value.table) {
+      locator.Set("table", static_cast<double>(value.table));
+      locator.Set("row", static_cast<double>(value.row));
+      locator.Set("column", static_cast<double>(value.column));
+    }
+    if (value.note_id) {
+      locator.Set("noteId", *value.note_id);
+    }
+  }
+  return base::DictValue()
+      .Set("locator", std::move(locator))
+      .Set("text", segment.text);
+}
+base::DictValue LocatedMetadata(const mojom::Metadata& metadata) {
+  constexpr std::array<std::string_view, 3> formats = {"text", "pdf", "docx"};
+  constexpr std::array<std::string_view, 5> codes = {
+      "no_selectable_text", "unmapped_text", "external_relationships_ignored",
+      "embedded_content_ignored", "unsupported_markup_ignored"};
+  constexpr std::array<std::string_view, 7> stories = {
+      "", "body", "header", "footer", "footnote", "endnote", "comment"};
+  base::DictValue result;
+  result.Set("format", formats[static_cast<size_t>(metadata.format)]);
+  if (metadata.page_count) {
+    result.Set("pageCount", static_cast<double>(metadata.page_count));
+  }
+  base::ListValue warnings;
+  for (const auto& warning : metadata.warnings) {
+    base::DictValue value;
+    value.Set("code", codes[static_cast<size_t>(warning->code)]);
+    value.Set("count", static_cast<double>(warning->count));
+    if (warning->story != mojom::Story::kNone) {
+      value.Set("story", stories[static_cast<size_t>(warning->story)]);
+    }
+    if (warning->first_page) {
+      value.Set("firstPage", static_cast<double>(warning->first_page));
+    }
+    if (!warning->first_part.empty()) {
+      value.Set("firstPart", warning->first_part);
+    }
+    warnings.Append(std::move(value));
+  }
+  result.Set("warnings", std::move(warnings));
+  result.Set(
+      "completed",
+      base::DictValue()
+          .Set("textSha256", metadata.completed->text_sha256)
+          .Set("textBytes", static_cast<double>(metadata.completed->text_bytes))
+          .Set("segmentCount",
+               static_cast<double>(metadata.completed->segment_count)));
+  return result;
+}
+}  // namespace
+class DocumentExtractor::Parser {
+ public:
+  mojom::StartResultPtr Start(base::ReadOnlySharedMemoryRegion source,
+                              uint32_t source_bytes) {
+    if (source_bytes > kMaxSourceBytes) {
+      return mojom::StartResult::NewFailure(mojom::Failure::kSourceLimit);
+    }
+    base::ReadOnlySharedMemoryMapping mapping;
+    if (source.IsValid()) {
+      mapping = source.Map();
+    }
+    if ((source_bytes &&
+         (!mapping.IsValid() || mapping.size() != source_bytes)) ||
+        (!source_bytes && source.IsValid())) {
+      return mojom::StartResult::NewFailure(mojom::Failure::kInvalidDocument);
+    }
+    const auto bytes = source_bytes ? mapping.GetMemoryAsSpan<const uint8_t>()
+                                    : base::span<const uint8_t>();
+    const std::string_view text = base::as_string_view(bytes);
+    mojom::Failure failure = mojom::Failure::kNone;
+    if (text.substr(0, 1024).find("%PDF-") != std::string_view::npos) {
+      failure = ExtractPdf(bytes, output_);
+    } else if (text.starts_with("PK\003\004") ||
+               text.starts_with("PK\005\006")) {
+      failure = ExtractDocx(bytes, output_);
+    } else if (text.find('\0') != std::string_view::npos ||
+               !base::IsStringUTF8(text)) {
+      failure = mojom::Failure::kUnsupportedFormat;
+    } else {
+      std::string normalized(text);
+      if (normalized.starts_with("\xef\xbb\xbf")) {
+        normalized.erase(0, 3);
+      }
+      base::ReplaceSubstringsAfterOffset(&normalized, 0, "\r\n", "\n");
+      base::ReplaceSubstringsAfterOffset(&normalized, 0, "\r", "\n");
+      size_t start = 0;
+      uint32_t line = 1;
+      while (start < normalized.size()) {
+        const size_t newline = normalized.find('\n', start);
+        const size_t end =
+            newline == std::string::npos ? normalized.size() : newline + 1;
+        auto locator = mojom::TextLocator::New();
+        locator->line = line++;
+        failure = output_.Add(mojom::Locator::NewText(std::move(locator)),
+                              normalized.substr(start, end - start));
+        if (failure != mojom::Failure::kNone) {
+          break;
+        }
+        start = end;
+      }
+    }
+    if (failure != mojom::Failure::kNone) {
+      return mojom::StartResult::NewFailure(failure);
+    }
+    return mojom::StartResult::NewMetadata(output_.Finish());
+  }
+  mojom::ChunkPtr ReadChunk(uint32_t index) { return output_.Chunk(index); }
+  mojom::JobResultPtr Execute(std::vector<mojom::JobSourcePtr> sources,
+                              base::DictValue request) {
+    auto result = mojom::JobResult::New();
+    auto fail = [&](const std::string& reason) {
+      result->failure = reason;
+      return std::move(result);
+    };
+    if (sources.empty() || sources.size() > 8) {
+      return fail("Invalid document source count");
+    }
+    size_t total = 0;
+    std::vector<base::ReadOnlySharedMemoryMapping> mappings;
+    std::vector<base::span<const uint8_t>> bytes;
+    for (const auto& source : sources) {
+      total += source->size;
+      if (!source->size || total > kMaxSourceBytes ||
+          !source->source.IsValid()) {
+        return fail("Document source limit exceeded");
+      }
+      auto mapping = source->source.Map();
+      if (!mapping.IsValid() || mapping.size() != source->size) {
+        return fail("Document shared-memory identity is invalid");
+      }
+      auto data = mapping.GetMemoryAsSpan<const uint8_t>();
+      if (base::HexEncodeLower(crypto::hash::Sha256(data)) != source->sha256) {
+        return fail("Document source hash does not match");
+      }
+      bytes.push_back(data);
+      mappings.push_back(std::move(mapping));
+    }
+    const auto* kind = request.FindString("kind");
+    if (!kind) {
+      return fail("Missing document job kind");
+    }
+    JobResult computed;
+    if (*kind == "audioInspect" && bytes.size() == 1 && request.size() == 1) {
+      computed = InspectAudio(bytes[0], sources[0]->media_type);
+    } else if (*kind == "pdf" && request.size() == 2 &&
+               request.FindDict("options")) {
+      for (const auto& source : sources) {
+        if (source->media_type != "application/pdf") {
+          return fail("PDF bytes require a PDF source declaration");
+        }
+      }
+      computed = ExecutePdf(bytes, *request.FindDict("options"));
+    } else if (*kind == "extract" && bytes.size() == 1 && request.size() == 1) {
+      auto extracted = Start(std::move(sources[0]->source), sources[0]->size);
+      if (!extracted->is_metadata()) {
+        return fail("Document text extraction failed");
+      }
+      const auto& metadata = extracted->get_metadata();
+      const auto& media_type = sources[0]->media_type;
+      if ((metadata->format == mojom::Format::kPdf &&
+           media_type != "application/pdf") ||
+          (metadata->format == mojom::Format::kDocx &&
+           media_type != "application/zip" &&
+           media_type !=
+               "application/"
+               "vnd.openxmlformats-officedocument.wordprocessingml.document") ||
+          (metadata->format == mojom::Format::kText &&
+           media_type != "text/plain")) {
+        return fail(
+            "Document MIME declaration does not match its parsed format");
+      }
+      base::ListValue chunks;
+      for (uint32_t i = 0; i < metadata->chunk_count; ++i) {
+        base::ListValue segments;
+        for (const auto& segment : output_.Chunk(i)->segments) {
+          segments.Append(LocatedSegment(*segment));
+        }
+        chunks.Append(base::DictValue()
+                          .Set("index", static_cast<double>(i))
+                          .Set("segments", std::move(segments)));
+      }
+      auto serialized = base::WriteJson(chunks);
+      if (!serialized || serialized->size() > 32 * 1024 * 1024) {
+        return fail(
+            "Located document output exceeds its bounded transport budget");
+      }
+      computed.outputs.push_back(
+          {std::vector<uint8_t>(serialized->begin(), serialized->end()),
+           "application/json", "document-segments.json"});
+      computed.report.Set("kind", "extract");
+      computed.report.Set("sourceSha256",
+                          base::ListValue().Append(sources[0]->sha256));
+      computed.report.Set("extraction", LocatedMetadata(*metadata));
+    } else {
+      return fail("Unsupported document job");
+    }
+    if (!computed.failure.empty()) {
+      return fail(computed.failure);
+    }
+    size_t output_bytes = 0;
+    if (computed.outputs.size() > 40) {
+      return fail("Too many document outputs");
+    }
+    for (auto& output : computed.outputs) {
+      output_bytes += output.bytes.size();
+      if (output.bytes.empty() || output_bytes > 32 * 1024 * 1024) {
+        return fail("Document output limit exceeded");
+      }
+      auto memory =
+          base::ReadOnlySharedMemoryRegion::Create(output.bytes.size());
+      if (!memory.IsValid()) {
+        return fail("Document output allocation failed");
+      }
+      memory.mapping.GetMemoryAsSpan<uint8_t>().copy_from(output.bytes);
+      auto admitted = mojom::JobOutput::New();
+      admitted->source = std::move(memory.region);
+      admitted->size = output.bytes.size();
+      admitted->sha256 =
+          base::HexEncodeLower(crypto::hash::Sha256(output.bytes));
+      admitted->media_type = std::move(output.media_type);
+      admitted->label = std::move(output.label);
+      result->outputs.push_back(std::move(admitted));
+    }
+    result->report = std::move(computed.report);
+    return result;
+  }
+
+ private:
+  DocumentSegments output_;
+};
+DocumentExtractor::DocumentExtractor(
+    mojo::PendingReceiver<mojom::DocumentExtractor> receiver)
+    : receiver_(this, std::move(receiver)),
+      parser_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::TaskPriority::USER_VISIBLE})) {
+  CHECK_EQ(base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+               switches::kProcessType),
+           switches::kUtilityProcess);
+}
+DocumentExtractor::~DocumentExtractor() {
+  // This primordial interface owns an entire dedicated process. Its IO receiver
+  // must reclaim even a parser stuck on the separate parsing sequence. Never
+  // signal a PID: the child itself is the exact process whose owner retired.
+  base::Process::TerminateCurrentProcessImmediately(0);
+}
+void DocumentExtractor::Start(base::ReadOnlySharedMemoryRegion source,
+                              uint32_t source_bytes,
+                              StartCallback callback) {
+  if (started_) {
+    receiver_.ReportBadMessage(
+        "Document extractor accepts one immutable source");
+    return;
+  }
+  started_ = true;
+  parser_.AsyncCall(&Parser::Start)
+      .WithArgs(std::move(source), source_bytes)
+      .Then(base::BindOnce(&DocumentExtractor::Started,
+                           weak_factory_.GetWeakPtr(), std::move(callback)));
+}
+void DocumentExtractor::Execute(std::vector<mojom::JobSourcePtr> sources,
+                                base::DictValue request,
+                                ExecuteCallback callback) {
+  if (started_) {
+    receiver_.ReportBadMessage("Document utility accepts one immutable job");
+    return;
+  }
+  started_ = true;
+  parser_.AsyncCall(&Parser::Execute)
+      .WithArgs(std::move(sources), std::move(request))
+      .Then(std::move(callback));
+}
+void DocumentExtractor::Started(StartCallback callback,
+                                mojom::StartResultPtr result) {
+  if (result->is_metadata()) {
+    chunk_count_ = result->get_metadata()->chunk_count;
+  }
+  std::move(callback).Run(std::move(result));
+}
+void DocumentExtractor::ReadChunk(uint32_t index, ReadChunkCallback callback) {
+  if (index >= chunk_count_) {
+    receiver_.ReportBadMessage(
+        "Document chunk is outside the immutable snapshot");
+    return;
+  }
+  parser_.AsyncCall(&Parser::ReadChunk)
+      .WithArgs(index)
+      .Then(std::move(callback));
+}
+}  // namespace aux::document
