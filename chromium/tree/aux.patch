+
+// A fixed 96 DIP tile of fine monochrome grain, one speck per device pixel on
+// both 1x and 2x displays. Its alpha is scaled per theme.
+SkBitmap GrainBitmap(int size, uint32_t seed) {
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(size, size);
+  for (int y = 0; y < size; ++y) {
+    for (int x = 0; x < size; ++x) {
+      seed = seed * 1664525u + 1013904223u;
+      const uint8_t alpha = (seed >> 24) & 0x7f;
+      const uint8_t value = (seed >> 16) & 1 ? 0xff : 0x00;
+      *bitmap.getAddr32(x, y) = SkPreMultiplyARGB(alpha, value, value, value);
+    }
+  }
+  bitmap.setImmutable();
+  return bitmap;
+}
+const gfx::ImageSkia& GrainTile() {
+  static const base::NoDestructor<gfx::ImageSkia> tile([] {
+    constexpr int kSize = 96;
+    gfx::ImageSkia image(gfx::ImageSkiaRep(GrainBitmap(kSize, 0x41555821), 1.f));
+    image.AddRepresentation(gfx::ImageSkiaRep(GrainBitmap(kSize * 2, 0x41555822), 2.f));
+    image.MakeThreadSafe();
+    return image;
+  }());
+  return *tile;
+}
+
+// Arc-style Space backdrop: a gentle diagonal gradient across the whole
+// window, then grain. Both are laid out in BrowserView coordinates so the
+// sidebar, corners and toolbar read as one surface.
+bool PaintAuxBackdrop(gfx::Canvas* canvas, const views::View* view,
+                      const BrowserView* browser_view, SkColor flat) {
+  const bool dark = view->GetWidget() &&
+      view->GetWidget()->GetColorMode() == ui::ColorProviderKey::ColorMode::kDark;
+  const auto backdrop = aux_theme::GetBackdrop(
+      browser_view->GetProfile(), ActiveSpace(browser_view), dark);
+  if (!backdrop ||
+      view->GetNativeTheme()->preferred_contrast() ==
+          ui::NativeTheme::PreferredContrast::kMore)
+    return false;
+  gfx::Point origin;
+  views::View::ConvertPointToTarget(view, browser_view, &origin);
+  const gfx::Rect bounds = view->GetLocalBounds();
+  if (backdrop->colors.size() >= 2) {
+    // Top-leading to bottom-trailing, as Arc draws a multi-color Space.
+    const SkPoint points[2] = {
+        SkPoint::Make(-origin.x(), -origin.y()),
+        SkPoint::Make(browser_view->width() * 0.7f - origin.x(),
+                      browser_view->height() - origin.y())};
+    std::vector<SkColor4f> colors;
+    for (SkColor color : backdrop->colors)
+      colors.push_back(SkColor4f::FromColor(color));
+    cc::PaintFlags flags;
+    flags.setShader(cc::PaintShader::MakeLinearGradient(
+        points, colors.data(), nullptr, static_cast<int>(colors.size()),
+        SkTileMode::kClamp));
+    canvas->DrawRect(gfx::RectF(bounds), flags);
+  } else {
+    canvas->DrawColor(flat);
+  }
+  if (backdrop->grain > 0) {
+    cc::PaintFlags grain;
+    grain.setAlphaf(std::min(1.0f, backdrop->grain * 0.4f));
+    canvas->SaveLayerWithFlags(grain);
+    const auto& tile = GrainTile();
+    canvas->TileImageInt(tile, origin.x(), origin.y(), bounds.x(), bounds.y(),
+                         bounds.width(), bounds.height());
+    canvas->Restore();
+  }
+  return true;
+}
