+  auto reply = base::BindPostTask(compositor_task_runner_ ? compositor_task_runner_ : main_task_runner_, std::move(callback));
+  if (main_task_runner_->BelongsToCurrentThread()) CreateAuxPersonCaptureSwap(std::move(reply));
