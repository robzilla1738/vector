+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_AUX_TAB_SWITCHER_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_AUX_TAB_SWITCHER_H_
+
+class BrowserWindowInterface;
+
+// Ctrl-Tab switcher: lists the window's tabs by recent use, advances the
+// selection on every call and activates it once Control is released.
+void AuxCycleTabs(BrowserWindowInterface* browser, bool forward);
+
+// Cancels a pending/visible gesture without changing the original active tab.
+// Returns true only if Escape belongs to an active switcher.
+bool AuxCancelTabSwitch();
+
+// Whether Control is held for the key event being handled right now.
+bool AuxIsControlKeyDown();
+
+// Whether Control is still held, as seen by the events the app receives.
+bool AuxIsControlStillDown();
+
+// Called when the app sees Control go up: an open switcher activates its pick.
+void AuxControlReleased();
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_AUX_TAB_SWITCHER_H_
diff --git a/chrome/browser/ui/views/frame/aux_tab_switcher_mac.mm b/chrome/browser/ui/views/frame/aux_tab_switcher_mac.mm
new file mode 100644
index 0000000000000000000000000000000000000000..039eb8b1a87d68be478c97ae9c5d113703fbbc82
--- /dev/null
+++ b/chrome/browser/ui/views/frame/aux_tab_switcher_mac.mm
@@ -0,0 +1,60 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/aux_tab_switcher.h"
+
+#include "base/logging.h"
+
+#import <AppKit/AppKit.h>
+#import <CoreGraphics/CoreGraphics.h>
+
+namespace {
+
+bool g_control_down = false;
+id g_monitor = nil;
+
+void EnsureMonitor() {
+  if (g_monitor) {
+    return;
+  }
+  // Tracks Control from the events the app actually receives, so the panel
+  // closes when the release is delivered, whatever its source.
+  g_monitor = [NSEvent
+      addLocalMonitorForEventsMatchingMask:(NSEventMaskFlagsChanged |
+                                            NSEventMaskKeyDown |
+                                            NSEventMaskKeyUp)
+                                   handler:^NSEvent*(NSEvent* event) {
+                                     const bool was_down = g_control_down;
+                                     g_control_down =
+                                         (event.modifierFlags &
+                                          NSEventModifierFlagControl) != 0;
+                                     if (was_down && !g_control_down)
+                                       AuxControlReleased();
+                                     if (event.type == NSEventTypeKeyDown &&
+                                         event.keyCode == 53 && AuxCancelTabSwitch())
+                                       return nil;
+                                     return event;
+                                   }];
+}
+
+}  // namespace
+
+bool AuxIsControlKeyDown() {
+  EnsureMonitor();
+  NSEvent* current = [NSApp currentEvent];
+  const bool from_event =
+      current && (current.type == NSEventTypeKeyDown ||
+                  current.type == NSEventTypeFlagsChanged) &&
+      (current.modifierFlags & NSEventModifierFlagControl) != 0;
+  const bool hardware =
+      (CGEventSourceFlagsState(kCGEventSourceStateCombinedSessionState) &
+       kCGEventFlagMaskControl) != 0;
+  g_control_down = from_event || hardware;
+  return g_control_down;
+}
+
+bool AuxIsControlStillDown() {
+  EnsureMonitor();
+  return g_control_down;
+}
