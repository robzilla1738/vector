+void VerticalTabStripRegionView::SetAuxNavigationRowMerged(bool merged) {
+  if (merged == aux_navigation_row_merged_)
+    return;
+  aux_navigation_row_merged_ = merged;
+  // Merged, the caption row (traffic lights + toggle) leaves the flex pass and
+  // is placed over the top of the docked toolbar; Pins and the body then
+  // follow the toolbar in the normal pass, layers included.
+  top_button_container_->SetProperty(views::kViewIgnoredByLayoutKey, merged);
+  top_button_separator_->SetProperty(views::kViewIgnoredByLayoutKey, merged);
+  if (merged)
+    top_button_separator_->SetBoundsRect(gfx::Rect());
+  else
+    SetAuxNavigationRowTopMargin(0);
+  GetLayoutManager()->InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::SetAuxNavigationRowTopMargin(int top) {
+  if (!aux_navigation_row_host_)
+    return;
+  gfx::Insets margins;
+  if (const auto* current = aux_navigation_row_host_->GetProperty(views::kMarginsKey))
+    margins = *current;
+  if (margins.top() == top)
+    return;
+  margins.set_top(top);
+  aux_navigation_row_host_->SetProperty(views::kMarginsKey, margins);
+  GetLayoutManager()->InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::LayoutAuxNavigationRow(ToolbarView* toolbar) {
+  aux_navigation_row_split_ = 0;
+  if (!toolbar) {
+    if (auto* docked = browser_view()->toolbar())
+      docked->SetAuxSidebarNavigationLeadingInset(0);
+    return;
+  }
+  // Arc header: traffic lights, sidebar toggle, then back/forward/reload in
+  // one row; the address field sits directly below it.
+  constexpr int kToggleGap = 4;
+  const auto* margins = top_button_container_->GetProperty(views::kMarginsKey);
+  const int left = margins ? margins->left() : 0;
+  const int right = margins ? margins->right() : 0;
+  const int row_width = std::max(0, width() - left - right);
+  top_button_container_->SetBounds(left, 0, row_width,
+      top_button_container_->GetHeightForWidth(row_width));
+  auto* host = toolbar->parent();
+  aux_navigation_row_host_ = host;
+  const int split = top_button_container_->x() +
+      top_button_container_->GetAuxNavigationRowLeadingWidth() + kToggleGap;
+  toolbar->SetAuxSidebarNavigationLeadingInset(split - host->x() - toolbar->x());
+  aux_navigation_row_split_ = split;
+  const int button_row =
+      host->height() - toolbar->GetAuxSidebarNavigationRowHeight();
+  const int center =
+      top_button_container_->GetCollapseButton()->bounds().CenterPoint().y();
+  const int want = std::max(0, center - button_row / 2);
+  if (host->y() == want)
+    return;
+  const auto* host_margins = host->GetProperty(views::kMarginsKey);
+  SetAuxNavigationRowTopMargin(
+      std::max(0, (host_margins ? host_margins->top() : 0) + want - host->y()));
+  LayoutSuperclass<views::AccessiblePaneView>(this);
+}
+
+bool VerticalTabStripRegionView::IsInAuxNavigationLeading(
+    const gfx::Point& point) const {
+  return aux_navigation_row_split_ && point.x() < aux_navigation_row_split_ &&
+         top_button_container_->bounds().Contains(point);
+}
+
+views::View* VerticalTabStripRegionView::TargetForRect(views::View* root,
+                                                       const gfx::Rect& rect) {
+  // The docked toolbar overlaps the caption row; keep the toggle reachable.
+  if (root == this && IsInAuxNavigationLeading(rect.CenterPoint())) {
+    gfx::Point point = rect.CenterPoint();
+    views::View::ConvertPointToTarget(this, top_button_container_, &point);
+    return top_button_container_->GetEventHandlerForPoint(point);
+  }
+  return views::ViewTargeterDelegate::TargetForRect(root, rect);
+}
+
+views::View* VerticalTabStripRegionView::GetTooltipHandlerForPoint(
+    const gfx::Point& point) {
+  if (IsInAuxNavigationLeading(point)) {
+    gfx::Point point_in_child = point;
+    views::View::ConvertPointToTarget(this, top_button_container_,
+                                      &point_in_child);
+    return top_button_container_->GetTooltipHandlerForPoint(point_in_child);
+  }
+  return BaseTabStripRegionView::GetTooltipHandlerForPoint(point);
+}
