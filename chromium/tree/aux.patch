+
+gfx::Size HTMLVideoElement::AutoPictureInPictureSize() const {
+  auto* frame = GetDocument().GetFrame();
+  auto* layout = GetLayoutObject();
+  if (!frame || !frame->IsMainFrame() || !GetDocument().IsActive() ||
+      !layout || layout->StyleRef().Visibility() != EVisibility::kVisible ||
+      paused() || ended() || getReadyState() < kHaveCurrentData ||
+      PictureInPictureController::From(GetDocument()).IsElementAllowed(*this) !=
+          PictureInPictureController::Status::kEnabled) {
+    return gfx::Size();
+  }
+  return GetVisualSizeInDIPs(/*intersect_viewport=*/true);
+}
