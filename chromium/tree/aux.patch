@@ -0,0 +1,266 @@
+// Copyright 2026 The Aux Authors. BSD-3-Clause.
+#include "chrome/renderer/aux_cosmetic_filter_agent.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/time/time.h"
+#include "chrome/common/aux_content_filter_resource_constants.h"
+#include "chrome/common/chrome_isolated_world_ids.h"
+#include "chrome/renderer/semantic_cosmetic_document.h"
+#include "content/public/renderer/render_frame.h"
+#include "gin/converter.h"
+#include "third_party/blink/public/common/associated_interfaces/associated_interface_registry.h"
+#include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
+#include "third_party/blink/public/platform/scheduler/web_agent_group_scheduler.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_local_frame_client.h"
+#include "third_party/blink/public/web/web_script_source.h"
+#include "url/gurl.h"
+#include "v8/include/v8-primitive.h"
+namespace chrome {
+namespace {
+constexpr size_t kMaxResourcesBytes = 4 * 1024 * 1024;
+constexpr size_t kMaxTokens = 512;
+constexpr size_t kMaxTokenBytes = 256;
+blink::WebScriptSource Script(const std::string& text) {
+  return blink::WebScriptSource(blink::WebString::FromUtf8(text));
+}
+bool Tokens(const base::ListValue* values, std::vector<std::string>* output) {
+  if (!values || values->size() > kMaxTokens) return false;
+  for (const auto& value : *values) {
+    const auto* text = value.GetIfString();
+    if (!text || text->empty() || text->size() > kMaxTokenBytes) return false;
+    output->push_back(*text);
+  }
+  return true;
+}
+}
+AuxCosmeticFilterAgent::AuxCosmeticFilterAgent(content::RenderFrame* frame)
+    : content::RenderFrameObserver(frame) {
+  frame->GetAssociatedInterfaceRegistry()->AddInterface<mojom::AuxCosmeticAgent>(
+      base::BindRepeating(&AuxCosmeticFilterAgent::Bind, weak_factory_.GetWeakPtr()));
+}
+AuxCosmeticFilterAgent::~AuxCosmeticFilterAgent() = default;
+void AuxCosmeticFilterAgent::Bind(
+    mojo::PendingAssociatedReceiver<mojom::AuxCosmeticAgent> receiver) {
+  if (receivers_.size() >= 2) return;
+  receivers_.Add(this, std::move(receiver));
+}
+bool AuxCosmeticFilterAgent::Current(const Scope& scope) const {
+  const auto* frame = render_frame()->GetWebFrame();
+  return frame && frame->GetDocument().Token() == scope.document &&
+         GURL(frame->GetDocument().Url()) == GURL(scope.url);
+}
+void AuxCosmeticFilterAgent::Prepare(const std::optional<blink::DocumentToken>& document,
+    const std::optional<base::UnguessableToken>& navigation, uint64_t generation,
+    const std::string& url, const std::string& json, PrepareCallback callback) {
+  if (document.has_value() == navigation.has_value() || generation == 0 || json.size() > kMaxResourcesBytes ||
+      !GURL(url).SchemeIsHTTPOrHTTPS()) { std::move(callback).Run(false); return; }
+  // Same-document route/policy refresh replaces only reversible cosmetics.
+  // Imperative packaged scriptlets execute at most once per actual document.
+  if (current_ && document && current_->document == *document &&
+      generation < current_->generation) { std::move(callback).Run(false); return; }
+  auto data = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  const auto* origin = data ? data->FindString("warOrigin") : nullptr;
+  const GURL war(origin ? *origin : "");
+  const bool semantic = data && data->FindDict("semanticCosmetics");
+  if (!data || !semantic || data->FindDict("resources") ||
+      !data->FindString("mainScript") || !data->FindString("isolatedScript") ||
+      !war.SchemeIs("chrome-extension") ||
+      war.host() != aux::kContentFilterResourceExtensionId ||
+      war.path() != "/resources" || war.has_query() || war.has_ref()) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (navigation) {
+    prospective_ = NavigationScope{*navigation, generation, url, json};
+  } else {
+    Scope scope{*document, generation, url, json};
+    if (!Current(scope)) { std::move(callback).Run(false); return; }
+    // Current-page refresh is reversible only. Never execute new imperative
+    // scriptlets on a document whose original commit has already happened.
+    scriptlet_document_ = *document;
+    prepared_ = std::move(scope);
+  }
+  // This ACK confirms bounded staging on the associated prospective frame.
+  // Application is fenced again by its actual document token after commit.
+  const auto weak = weak_factory_.GetWeakPtr();
+  std::move(callback).Run(true);
+  if (weak) ApplyPrepared();
+}
+void AuxCosmeticFilterAgent::ApplyPrepared() {
+  if (in_bfcache_ || !prepared_ || !Current(*prepared_)) return;
+  auto data = base::JSONReader::ReadDict(prepared_->json, base::JSON_PARSE_RFC);
+  const auto* semantic = data ? data->FindDict("semanticCosmetics") : nullptr;
+  const auto* main = data ? data->FindString("mainScript") : nullptr;
+  const auto* isolated = data ? data->FindString("isolatedScript") : nullptr;
+  const auto* war_origin = data ? data->FindString("warOrigin") : nullptr;
+  const GURL war(war_origin ? *war_origin : "");
+  if (!war.SchemeIs("chrome-extension") ||
+      war.host() != aux::kContentFilterResourceExtensionId ||
+      war.path() != "/resources" || war.has_query() || war.has_ref()) {
+    prepared_.reset(); return;
+  }
+  base::DictValue globals;
+  globals.Set("warOrigin", *war_origin);
+  auto globals_json = base::WriteJson(globals);
+  if (!semantic || !globals_json || !main || !isolated) {
+    prepared_.reset();
+    return;
+  }
+  // Copy before executing trusted packaged scriptlets: they can initiate a new
+  // navigation, so each following operation must recheck this exact document.
+  const std::string main_script = *main, isolated_script = *isolated;
+  const bool run_scriptlets = scriptlet_document_ != prepared_->document;
+  if (run_scriptlets) scriptlet_document_ = prepared_->document;
+  generic_timer_.Stop(); host_.reset(); lookup_pending_ = false;
+  semantic_document_.reset();
+  current_ = std::move(prepared_);
+  prepared_.reset();
+  const auto weak = weak_factory_.GetWeakPtr();
+  auto* frame = render_frame()->GetWebFrame();
+  if (semantic) {
+    const auto encoded = base::WriteJson(*semantic);
+    const auto original_document = current_->document;
+    const auto original_generation = current_->generation;
+    const auto original_url = current_->url;
+    semantic_document_ = std::make_unique<SemanticCosmeticDocument>(
+        frame, base::BindRepeating(
+                   [](base::WeakPtr<AuxCosmeticFilterAgent> owner,
+                      blink::DocumentToken document, uint64_t generation,
+                      const std::string& url) {
+                     return owner && !owner->in_bfcache_ && owner->current_ &&
+                            owner->current_->document == document &&
+                            owner->current_->generation == generation &&
+                            owner->current_->url == url &&
+                            owner->Current(*owner->current_);
+                   },
+                   weak, original_document, original_generation, original_url));
+    if (!encoded || !semantic_document_->Install(*encoded)) {
+      Retire();
+      return;
+    }
+  }
+  if (!weak || !current_ || !Current(*current_)) return;
+  if (run_scriptlets && !isolated_script.empty())
+    frame->ExecuteScriptInIsolatedWorld(ISOLATED_WORLD_ID_AUX_CONTENT_FILTER,
+        Script("(()=>{const scriptletGlobals=" + *globals_json + ";\n" + isolated_script + "\n})();"),
+        blink::BackForwardCacheAware::kAllow);
+  if (!weak || !current_ || !Current(*current_)) return;
+  if (run_scriptlets && !main_script.empty())
+    frame->ExecuteScript(Script("(()=>{const scriptletGlobals=" + *globals_json + ";\n" + main_script + "\n})();"));
+  if (!weak || !current_ || !Current(*current_)) return;
+  StartGenericLookup();
+}
+void AuxCosmeticFilterAgent::StartGenericLookup() {
+  if (in_bfcache_ || !current_ || !Current(*current_) ||
+      !broker_document_ || *broker_document_ != current_->document ||
+      host_.is_bound())
+    return;
+  render_frame()->GetBrowserInterfaceBroker().GetInterface(
+      host_.BindNewPipeAndPassReceiver());
+  generic_timer_.Start(FROM_HERE, base::Milliseconds(250), this,
+                       &AuxCosmeticFilterAgent::PollGenericTokens);
+}
+void AuxCosmeticFilterAgent::PollGenericTokens() {
+  if (in_bfcache_ || !current_ || !host_.is_bound()) return;
+  if (!Current(*current_)) {
+    // Await the browser's original-document/URL-bound refresh. Retain the
+    // document marker so an SPA route change cannot rerun imperative scripts.
+    generic_timer_.Stop(); host_.reset(); lookup_pending_ = false; return;
+  }
+  if (lookup_pending_) return;
+  const auto document = current_->document;
+  const auto generation = current_->generation;
+  const auto weak = weak_factory_.GetWeakPtr();
+  auto* frame = render_frame()->GetWebFrame();
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  auto result = frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+      ISOLATED_WORLD_ID_AUX_CONTENT_FILTER,
+      Script("globalThis.__auxNativeSemanticCosmetics?.drain() ?? ''"),
+      blink::BackForwardCacheAware::kAllow);
+  if (!weak || !current_ || !Current(*current_) || result.IsEmpty() ||
+      !result->IsString() || result.As<v8::String>()->Length() > 131072) return;
+  std::string raw;
+  if (!gin::ConvertFromV8(isolate, result, &raw) || raw.size() > 131072) return;
+  auto data = base::JSONReader::ReadDict(raw, base::JSON_PARSE_RFC);
+  std::vector<std::string> classes, ids;
+  if (!data || !Tokens(data->FindList("classes"), &classes) ||
+      !Tokens(data->FindList("ids"), &ids) || classes.size() + ids.size() > kMaxTokens ||
+      (classes.empty() && ids.empty())) return;
+  lookup_pending_ = true;
+  if (semantic_document_) {
+    if (classes.size() + ids.size() > 128) {
+      Retire();
+      return;
+    }
+    host_->LookupSemantic(
+        document, generation, current_->url, classes, ids,
+        base::BindOnce(
+            [](base::WeakPtr<AuxCosmeticFilterAgent> owner,
+               blink::DocumentToken document, uint64_t generation,
+               std::string url, bool accepted, const std::string& css) {
+              if (!owner || !owner->current_ || !owner->semantic_document_ ||
+                  owner->current_->document != document ||
+                  owner->current_->generation != generation ||
+                  owner->current_->url != url ||
+                  !owner->Current(*owner->current_)) {
+                return;
+              }
+              owner->lookup_pending_ = false;
+              if (!accepted || css.size() > kMaxResourcesBytes ||
+                  !owner->semantic_document_->AddGenericCSS(css)) {
+                owner->Retire();
+              }
+            },
+            weak, document, generation, current_->url));
+    return;
+  }
+}
+void AuxCosmeticFilterAgent::Retire() {
+  semantic_document_.reset();
+  generic_timer_.Stop(); host_.reset(); current_.reset(); lookup_pending_ = false;
+}
+void AuxCosmeticFilterAgent::WillCommitNewDocument(const blink::DocumentToken& document,
+    const base::UnguessableToken& navigation, const GURL& url) {
+  broker_document_.reset();
+  prepared_.reset();
+  if (prospective_ && prospective_->navigation == navigation && GURL(prospective_->url) == url)
+    prepared_ = Scope{document, prospective_->generation, prospective_->url, prospective_->json};
+  prospective_.reset();
+}
+void AuxCosmeticFilterAgent::DidCreateNewDocument() {
+  broker_document_.reset();
+  Retire(); scriptlet_document_.reset(); ApplyPrepared();
+}
+void AuxCosmeticFilterAgent::DidCommitProvisionalLoad(ui::PageTransition) {
+  // RenderFrameImpl resets the broker AFTER DidCreateNewDocument, but BEFORE
+  // this callback. Requests on the preceding document pipe are discarded.
+  // Keep early cosmetics/scriptlets; request the host on its actual new pipe.
+  auto* frame = render_frame()->GetWebFrame();
+  if (!frame) return;
+  broker_document_ = frame->GetDocument().Token();
+  StartGenericLookup();
+}
+void AuxCosmeticFilterAgent::DidSetPageLifecycleState(blink::BFCacheStateChange change) {
+  if (change == blink::BFCacheStateChange::kStoredToBFCache) {
+    semantic_document_.reset();
+    in_bfcache_ = true;
+    generic_timer_.Stop(); host_.reset(); lookup_pending_ = false;
+  } else if (change == blink::BFCacheStateChange::kRestoredFromBFCache) {
+    in_bfcache_ = false;
+    // The native prospective-frame ACK may already have staged the current
+    // snapshot. Do not execute while frozen; apply after actual restoration.
+    ApplyPrepared();
+  }
+}
+void AuxCosmeticFilterAgent::WillDetach(blink::DetachReason) {
+  Retire(); scriptlet_document_.reset(); prepared_.reset(); receivers_.Clear();
+}
+void AuxCosmeticFilterAgent::OnDestruct() { delete this; }
+}  // namespace chrome
