+// upload endpoint. A report this run wrote without crashing (a dump taken
+// while running) is no reason to say Aux quit.
+void OfferAuxCrashReports() {
+  if (!aux_crash_reporting::HasConfiguredEndpoint() ||
+      aux_crash_reporting::HasUserChoice()) {
+    return;
+  }
+  Profile* profile = ProfileManager::GetLastUsedProfileIfLoaded();
+  if (!profile ||
+      ExitTypeService::GetLastSessionExitType(profile) != ExitType::kCrashed) {
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce([] {
+        const time_t started =
+            base::Process::Current().CreationTime().ToTimeT();
+        std::vector<crash_reporter::Report> reports;
+        crash_reporter::GetReports(&reports);
+        return std::ranges::any_of(reports, [started](const auto& report) {
+          return report.capture_time < started;
+        });
+      }),
+      base::BindOnce([](bool crashed) {
+        if (!crashed || browser_shutdown::HasShutdownStarted()) return;
+        chrome::ShowQuestionMessageBoxAsync(
+            gfx::NativeWindow(), u"Send crash reports to Aux?",
+            u"Aux quit unexpectedly. Crash reports help fix problems like "
+            u"this. They contain technical details about the crash, not your "
+            u"pages, passwords or files.",
+            base::BindOnce([](chrome::MessageBoxResult result) {
+              aux_crash_reporting::SetConsent(
+                  result == chrome::MESSAGE_BOX_RESULT_YES);
+            }));
+      }));
+}
