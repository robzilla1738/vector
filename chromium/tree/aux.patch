+  display: flex;
+  flex-shrink: 0;
+  height: 24px;
+  justify-content: center;
+  width: 24px;
+}
+
+:host-context([command-bar-style]) #action-icon {
+  -webkit-mask-size: 14px;
+  height: 14px;
+  width: 14px;
+}
