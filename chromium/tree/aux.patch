+namespace network {
+inline mojom::TrustedConnectionInfoPtr CaptureTrustedConnectionInfo(
+    const net::TransportInfo& info,
+    const GURL& original_url) {
+  auto result = mojom::TrustedConnectionInfo::New();
+  switch (info.type) {
+    case net::TransportType::kDirect:
+      result->type = mojom::TrustedConnectionType::kDirect;
+      break;
+    case net::TransportType::kProxied:
+      result->type = mojom::TrustedConnectionType::kProxied;
+      break;
+    case net::TransportType::kCached:
+      result->type = mojom::TrustedConnectionType::kCached;
+      break;
+    case net::TransportType::kCachedFromProxy:
+      result->type = mojom::TrustedConnectionType::kCachedFromProxy;
+      break;
+  }
+  result->endpoint = info.endpoint;
+  if ((info.type == net::TransportType::kDirect ||
+       info.type == net::TransportType::kCached) &&
+      info.dns_canonical_name_receipt &&
+      net::DnsCanonicalReceiptMatches(*info.dns_canonical_name_receipt,
+                                      original_url.host(),
+                                      info.endpoint.address())) {
+    result->canonical_name = mojom::TrustedDnsCanonicalName::New(
+        info.dns_canonical_name_receipt->query_host,
+        info.dns_canonical_name_receipt->canonical_name);
+  }
+  return result;
+}
+}  // namespace network
+#endif
