+bool TabStripServiceImpl::HasExternalBindingsOrActiveInvocation() const {
+  // This query is used only by explicit profile-transition admission. Report
+  // counts, never receiver identities or profile/tab data, before rejecting.
+  size_t external_observers = 0;
+  for (const auto& observer : observers_) {
+    if (&observer != this) {
+      ++external_observers;
+    }
+  }
+  const bool active_session = session_controller_->IsSessionInProgress();
+  const bool rejected = !mojo_clients_.empty() ||
+                        !mojo_experiment_clients_.empty() ||
+                        !mojo_observers_.empty() || active_session ||
+                        external_observers != 0;
+  if (rejected) {
+    LOG(ERROR) << "Aux profile transition rejected: tab-strip-service-bindings"
+               << " mojo_clients=" << mojo_clients_.size()
+               << " mojo_experimental=" << mojo_experiment_clients_.size()
+               << " mojo_observers=" << mojo_observers_.size()
+               << " native_external=" << external_observers
+               << " active_session=" << active_session;
+  }
+  return rejected;
+}
