+void DraggedTabsContainer::HandleTabDrop(
+    TabDragTarget::DragController& controller) {
+  if (!aux_merge_view_)
+    return;
+  // The drag still owns the model until it ends; split right after it.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](tabs::TabHandle target_handle,
+                        tabs::TabHandle source_handle) {
+                       auto* target = target_handle.Get();
+                       auto* source = source_handle.Get();
+                       auto* browser =
+                           target ? target->GetBrowserWindowInterface()
+                                  : nullptr;
+                       if (!browser || !source ||
+                           !aux::CanJoinNativeSplit(*browser, target, source)) {
+                         return;
+                       }
+                       aux::JoinNativeSplit(
+                           *browser, target, source,
+                           split_tabs::SplitPaneTree::Axis::kHorizontal,
+                           /*before=*/false);
+                     },
+                     aux_merge_target_, aux_merge_source_));
+}
+
+namespace {
+
+// The row a dragged tab would split with: the sidebar's hover fill with a thin
+// accent edge, so it reads as "join", not as hover.
+class AuxMergeTargetBackground : public views::Background {
+ public:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    const auto* colors = view->GetColorProvider();
+    if (!colors)
+      return;
+    constexpr float kRadius = 8;
+    constexpr float kStroke = 1.5f;
+    gfx::RectF bounds(view->GetLocalBounds());
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(colors->GetColor(ui::kColorSysStateHoverOnSubtle));
+    canvas->DrawRoundRect(bounds, kRadius, flags);
+    bounds.Inset(kStroke / 2);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(kStroke);
+    flags.setColor(colors->GetColor(ui::kColorSysPrimary));
+    canvas->DrawRoundRect(bounds, kRadius - kStroke / 2, flags);
+  }
+};
+
+const tabs::TabInterface* TabOfNode(const TabCollectionNode* node) {
+  if (!node || node->type() != TabCollectionNode::Type::TAB)
+    return nullptr;
+  const tabs::ConstChildPtr data = node->GetNodeData();
+  const auto* tab = std::get_if<tabs::ConstDanglingUntriagedTabInterface>(&data);
+  return tab ? tab->get() : nullptr;
+}
+
+}  // namespace
+
+bool DraggedTabsContainer::IsAuxMergeSupported() const {
+  return collection_node_ && !IsHorizontalDragSupported() &&
+         (collection_node_->type() == TabCollectionNode::Type::UNPINNED ||
+          collection_node_->type() == TabCollectionNode::Type::GROUP) &&
+         dragging_views_.size() == 1 && !GetDragHandler().IsDraggingGroups() &&
+         !GetDragHandler().IsDraggingPinnedTabs();
+}
+
+void DraggedTabsContainer::SetAuxMergeTarget(views::View* view,
+                                             tabs::TabHandle target,
+                                             tabs::TabHandle source) {
+  if (aux_merge_view_ == view)
+    return;
+  if (aux_merge_view_)
+    aux_merge_view_->SetBackground(nullptr);
+  aux_merge_view_ = view;
+  aux_merge_target_ = target;
+  aux_merge_source_ = source;
+  if (view)
+    view->SetBackground(std::make_unique<AuxMergeTargetBackground>());
+}
+
+bool DraggedTabsContainer::HandleAuxBandedDrag(
+    const gfx::Rect& dragged_tab_bounds) {
+  if (!IsAuxMergeSupported()) {
+    SetAuxMergeTarget(nullptr, {}, {});
+    return false;
+  }
+  const tabs::TabInterface* source =
+      TabOfNode(GetCollectionNodeFromView(*dragging_views_.begin()->first));
+  const views::ProposedLayout& layout = GetLayoutForDrag();
+  const int center_y = dragged_tab_bounds.CenterPoint().y();
+  bool after_dragged = false;
+  for (size_t i = 0; i < layout.child_layouts.size(); ++i) {
+    const auto& child = layout.child_layouts[i];
+    if (GetDragHandler().IsViewDragging(*child.child_view)) {
+      after_dragged = true;
+      continue;
+    }
+    const TabCollectionNode* node = GetCollectionNodeFromView(*child.child_view);
+    if (!child.visible || !node || center_y < child.bounds.y() ||
+        center_y >= child.bounds.bottom()) {
+      continue;
+    }
+    // Quarters of the row: 1 and 2 join, 0 and 3 reorder.
+    const int quarter = (center_y - child.bounds.y()) * 4 /
+                        std::max(1, child.bounds.height());
+    if (quarter == 1 || quarter == 2) {
+      const tabs::TabInterface* target = TabOfNode(node);
+      auto* browser = target ? const_cast<tabs::TabInterface*>(target)
+                                   ->GetBrowserWindowInterface()
+                             : nullptr;
+      if (source && browser &&
+          aux::CanJoinNativeSplit(
+              *browser, const_cast<tabs::TabInterface*>(target),
+              const_cast<tabs::TabInterface*>(source))) {
+        SetAuxMergeTarget(child.child_view, target->GetHandle(),
+                          source->GetHandle());
+      } else {
+        SetAuxMergeTarget(nullptr, {}, {});
+      }
+      return true;
+    }
+    SetAuxMergeTarget(nullptr, {}, {});
+    const TabCollectionNode* target = nullptr;
+    if (!after_dragged && quarter == 0) {
+      target = node;
+    } else if (after_dragged && quarter == 3) {
+      // Insert before the next row, or at the end.
+      for (size_t j = i + 1; j < layout.child_layouts.size() && !target; ++j) {
+        const auto& next = layout.child_layouts[j];
+        if (next.visible && !GetDragHandler().IsViewDragging(*next.child_view))
+          target = GetCollectionNodeFromView(*next.child_view);
+      }
+      if (!target) {
+        if (GetDragHandler().HandleDraggedTabsIntoPosition(*collection_node_,
+                                                            nullptr)) {
+          host_view_->InvalidateLayout();
+        }
+        return true;
+      }
+    } else {
+      return true;
+    }
+    if (GetDragHandler().HandleDraggedTabsIntoPosition(*collection_node_,
+                                                        target)) {
+      host_view_->InvalidateLayout();
+    }
+    return true;
+  }
+  SetAuxMergeTarget(nullptr, {}, {});
+  return false;
+}
