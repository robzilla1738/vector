+
+bool RenderWidgetHostImpl::AcceptNativeMouseDownLink(
+    RenderFrameHost* frame,
+    const blink::NativeMouseLinkObservation& link) {
+  const auto pending = native_mouse_downs_.find(link.nonce);
+  if (pending == native_mouse_downs_.end() || !frame ||
+      frame->GetRenderWidgetHost() != this || !frame->IsActive() ||
+      !frame->IsRenderFrameLive() || link.href.size() > 65536 ||
+      static_cast<RenderFrameHostImpl*>(frame)->GetDocumentToken() !=
+          link.document) {
+    return false;
+  }
+  const GURL href(link.href);
+  if (!href.is_valid()) {
+    return false;
+  }
+  auto& receipt = *pending->second;
+  bool original = false;
+  for (const auto& [document, url] : receipt.documents) {
+    if (document.AsRenderFrameHostIfValid() == frame &&
+        frame->GetLastCommittedURL() == url) {
+      original = true;
+    }
+  }
+  if (!original) {
+    return false;
+  }
+  if (receipt.accepted) {
+    return receipt.accepted->document == link.document &&
+           receipt.accepted->href == link.href;
+  }
+  receipt.accepted = link;
+  GetContentClient()->browser()->OnNativeTrustedMouseDownLink(frame, href);
+  return true;
+}
+void RenderWidgetHostImpl::RetireNativeMouseDowns() {
+  native_mouse_downs_.clear();
