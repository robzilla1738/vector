+  const auto outcome = ToObservedOutcome(AppendCommandsImpl(
+      std::move(commands), truncate, std::move(error_callback)));
+  if (outcome != SessionBackendWriteOutcome::kWritten)
+    writer_admission_.ObserveFailedWrite();
