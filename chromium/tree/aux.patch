+void VerticalTabStripRegionView::ShowAuxSpaceCreation() {
+  if (!aux_space_create_) {
+    auto* browser = browser_view() ? browser_view()->browser() : nullptr;
+    if (!browser || !aux::AuxOrganizationWindowController::FromBrowser(browser))
+      return;
+    const auto index = GetIndexOf(aux_sidebar_.get());
+    CHECK(index);
+    aux_space_create_ = AddChildViewAt(
+        std::make_unique<aux::AuxSpaceCreateView>(*browser,
+            base::BindOnce(&VerticalTabStripRegionView::EndAuxSpaceCreation,
+                           aux_preview_weak_factory_.GetWeakPtr())),
+        *index + 1);
+    // Same flexible slot as the body it stands in for.
+    aux_space_create_->SetProperty(views::kFlexBehaviorKey,
+        views::FlexSpecification(views::LayoutOrientation::kVertical,
+            views::MinimumFlexSizeRule::kScaleToMinimum,
+            views::MaximumFlexSizeRule::kUnbounded).WithWeight(1));
+    aux_sidebar_->SetVisible(false);
+    InvalidateLayout();
+  }
+  aux_space_create_->FocusName();
+}
+
+void VerticalTabStripRegionView::EndAuxSpaceCreation() {
+  if (!aux_space_create_)
+    return;
+  const bool had_focus = aux_space_create_->Contains(
+      GetFocusManager() ? GetFocusManager()->GetFocusedView() : nullptr);
+  auto* panel = aux_space_create_.get();
+  aux_space_create_ = nullptr;
+  RemoveChildViewT(panel);
+  aux_sidebar_->SetVisible(true);
+  InvalidateLayout();
+  if (had_focus && browser_view() && browser_view()->contents_web_view())
+    browser_view()->contents_web_view()->RequestFocus();
+}
