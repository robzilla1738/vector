+
+// Main-thread owner for Sparkle's standard updater and Aux's channel choice.
+@interface AuxSparkleUpdater : NSObject
+
+@property(nonatomic, readonly) BOOL available;
+@property(nonatomic, readonly) BOOL automaticallyChecksForUpdates;
+@property(nonatomic, readonly) BOOL betaChannelEnabled;
+
