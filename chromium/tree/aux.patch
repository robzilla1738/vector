+
+void LensOverlayEntryPointController::AbortAuxProfileSwitch() {
+  CHECK(aux_profile_switch_prepared_);
+  CHECK(aux_source_profile_);
+  CHECK_EQ(browser_window_interface_->GetProfile(), aux_source_profile_.get());
+  CHECK_EQ(From(browser_window_interface_), this);
+  // Core abort is pre-identity only. Genuine source tabs are already restored;
+  // reattach the original entry-point observations without pretending empty.
+  RestoreBindingsForAuxProfileSwitch();
