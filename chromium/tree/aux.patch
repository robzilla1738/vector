@@ -0,0 +1,27 @@
+// Copyright 2026 The Aux Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+module chrome.mojom;
+import "mojo/public/mojom/base/file.mojom";
+import "mojo/public/mojom/base/big_buffer.mojom";
+import "sandbox/policy/mojom/sandbox.mojom";
+import "url/mojom/url.mojom";
+struct AuxFirefoxHistory { url.mojom.Url url; string title; double visited_at; };
+struct AuxFirefoxBookmark { url.mojom.Url url; string title; array<string> path; bool is_folder; };
+struct AuxFirefoxTab { url.mojom.Url url; string title; int32 window_id; bool pinned; };
+struct AuxFirefoxProfileResult {
+  array<AuxFirefoxHistory> history;
+  array<AuxFirefoxBookmark> bookmarks;
+  array<AuxFirefoxTab> tabs;
+  map<string, string> category_errors;
+  string? error;
+};
+// Handles refer exclusively to copies already captured by the trusted native
+// importer. No arbitrary path, original Profile descriptor or credential is
+// accepted. SQLite/WAL and Mozilla session parsing execute in kService.
+[ServiceSandbox=sandbox.mojom.Sandbox.kService]
+interface AuxFirefoxProfileDecoder {
+  Decode(mojo_base.mojom.File? database, mojo_base.mojom.File? wal,
+         mojo_base.mojom.File? journal, mojo_base.mojom.BigBuffer? session,
+         bool history, bool bookmarks, bool tabs) => (AuxFirefoxProfileResult result);
+};
