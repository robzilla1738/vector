+
+void ExtensionBrowserWindowHelper::PrepareForAuxProfileSwitch() {
+  CHECK(CanPrepareForAuxProfileSwitch());
+  aux_profile_switch_source_ = browser_->GetProfile()->GetWeakPtr();
+  // Old registry unload events must not close tabs after identity has moved.
+  registry_observation_.Reset();
+}
+
+void ExtensionBrowserWindowHelper::RebindForAuxProfileSwitch(
+    Profile* target_profile) {
+  CHECK(aux_profile_switch_source_);
+  CHECK(!registry_observation_.IsObserving());
+  CHECK(target_profile);
+  CHECK(target_profile->IsRegularProfile());
+  CHECK_EQ(browser_->GetProfile(), target_profile);
+  auto* tabs = TabListInterface::From(&browser_.get());
+  CHECK(tabs);
+  CHECK_EQ(tabs->GetTabCount(), 0);
+  registry_observation_.Observe(ExtensionRegistry::Get(target_profile));
+  aux_profile_switch_source_.reset();
+}
+
+void ExtensionBrowserWindowHelper::AbortAuxProfileSwitch() {
+  CHECK(aux_profile_switch_source_);
+  CHECK_EQ(browser_->GetProfile(), aux_profile_switch_source_.get());
+  CHECK(!registry_observation_.IsObserving());
+  // Core rollback has already restored the actual source tabs. This observer
+  // owns no tab transfer; the target-only empty-model guard must remain intact.
+  registry_observation_.Observe(ExtensionRegistry::Get(browser_->GetProfile()));
+  aux_profile_switch_source_.reset();
+}
+#endif
