+AuxPersonCaptureSwapPromise::AuxPersonCaptureSwapPromise(base::OnceCallback<void(uint32_t)> reply) : reply_(std::move(reply)) {}
+int64_t AuxPersonCaptureSwapPromise::GetTraceId() const { return 0; }
