+std::optional<DnsCanonicalNameReceipt>
+QuicSessionPool::GetDnsCanonicalNameReceiptForSessionKey(
+    const QuicSessionKey& key) const {
+  const auto receipt = dns_canonical_names_by_session_key_.find(key);
+  const auto session = active_sessions_.find(key);
+  if (!key.proxy_chain().is_direct() ||
+      receipt == dns_canonical_names_by_session_key_.end() ||
+      session == active_sessions_.end()) {
+    return std::nullopt;
+  }
+  const auto peer = ToIPEndPoint(session->second->connection()->peer_address());
+  if (!DnsCanonicalReceiptMatches(receipt->second, key.server_id().host(),
+                                  peer.address())) {
+    return std::nullopt;
+  }
+  return receipt->second;
+}
+
+void QuicSessionPool::RecordDnsCanonicalNameForSession(
+    const QuicSessionAliasKey& key,
+    QuicChromiumClientSession* session,
+    const ConnectionEndpointMetadata& metadata) {
+  const auto active = active_sessions_.find(key.session_key());
+  if (active == active_sessions_.end() || active->second != session) {
+    return;
+  }
+  dns_canonical_names_by_session_key_.erase(key.session_key());
+  if (!key.session_key().proxy_chain().is_direct()) {
+    return;
+  }
+  const auto peer = ToIPEndPoint(session->connection()->peer_address());
+  const auto receipt = CaptureDnsCanonicalNameReceipt(
+      key.destination().host(), peer.address(), metadata.dns_canonical_names);
+  if (receipt) {
+    dns_canonical_names_by_session_key_.insert_or_assign(key.session_key(),
+                                                         *receipt);
+  }
+}
