+      .OnEnded(base::BindOnce(
+          [](MultiContentsViewMiniToolbar* toolbar) {
+            if (!toolbar->aux_revealed_) toolbar->SetVisible(false);
+          },
+          base::Unretained(this)))
+      .Once()
+      .SetDuration(base::Milliseconds(120))
+      .SetOpacity(this, reveal ? 1.f : 0.f);
