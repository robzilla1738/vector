+    LOG(WARNING) << "Aux profile transition rejected: file-read-or-context-handoff";
+    return false;
+  }
+  if (aux_ever_started_work_ && !aux_canceled_dialog_complete_ &&
+      !selected_context_released) {
+    LOG(WARNING) << "Aux profile transition rejected: aim-cold.file-started-work";
+    return false;
+  }
+  if (file_dialog_) {
+    LOG(WARNING) << "Aux profile transition rejected: aim-cold.file-dialog";
+    return false;
+  }
+  if (web_contents_ && !selected_context_released) {
