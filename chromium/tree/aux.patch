+// Supplied40fe36c chooses the first unused Profile N against both stored local
+// and displayed names, avatar26, then45838f8 dispatches in the same weak
+// sender.
+void CreatePrimaryProfile(base::WeakPtr<BrowserWindowInterface> sender) {
+  if (!sender || !sender->GetProfile() ||
+      !sender->GetProfile()->IsRegularProfile() || sender->GetProfile()->IsOffTheRecord()) {
+    return;
+  }
+  auto* manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (!manager) {
+    return;
+  }
+  const auto entries =
+      manager->GetProfileAttributesStorage().GetAllProfilesAttributes();
+  std::u16string name;
+  for (int index = 1;; ++index) {
+    name = l10n_util::GetStringFUTF16(IDS_AUX_NEW_PROFILE_DEFAULT_NAME,
+                                      base::NumberToString16(index));
+    const bool used = std::ranges::any_of(entries, [&name](auto* entry) {
+      return entry &&
+             (entry->GetLocalProfileName() == name || entry->GetName() == name);
+    });
+    if (!used) {
+      break;
+    }
+  }
+  auto* state = BrowserInitState::From(sender.get());
+  if (!state || state->is_aux_profile_switch_cache()) return;
+  const auto source = sender->GetProfile()->GetWeakPtr();
+  const auto epoch = aux::GetProfileCookieBindingEpoch(source.get());
+  if (!IsCurrentProfileMenuSource(sender, source, epoch)) return;
+  const uint64_t generation = state->BeginAuxProfileSwitchRequest();
+  ProfileManager::CreateMultiProfileAsync(
+      name, /*icon_index=*/26, /*is_hidden=*/false,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserWindowInterface> browser,
+             base::WeakPtr<Profile> source, std::string epoch,
+             uint64_t generation, Profile* profile) {
+            const auto current = [&]() {
+              const auto* state = browser ? BrowserInitState::From(browser.get()) : nullptr;
+              return state && state->IsCurrentAuxProfileSwitchRequest(generation) &&
+                  IsCurrentProfileMenuSource(browser, source, epoch);
+            };
+            if (!current() || !profile) return;
+            const auto target = profile->GetWeakPtr();
+            const auto identity = aux::InitializeFreshProfileIdentity(profile);
+            if (current() && target &&
+                identity != aux::FreshProfileIdentityInitialization::kUnavailable)
+              DispatchSelectedProfile(browser, target->GetPath());
+          },
+          sender, source, epoch, generation));
+}
