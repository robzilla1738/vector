diff --git a/net/base/dns_canonical_name_receipt.cc b/net/base/dns_canonical_name_receipt.cc
new file mode 100644
index 0000000000000000000000000000000000000000..db7a68010e90b3c1a9216cd4def5e71f1214c575
--- /dev/null
+++ b/net/base/dns_canonical_name_receipt.cc
@@ -0,0 +1,48 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "net/base/dns_canonical_name_receipt.h"
+
+#include <utility>
+namespace net {
+base::DictValue DnsCanonicalNamesToValue(
+    const DnsCanonicalNamesByAddress& names) {
+  base::DictValue result;
+  for (const auto& [address, owners] : names) {
+    base::ListValue values;
+    for (const auto& owner : owners) {
+      values.Append(owner);
+    }
+    result.Set(address.ToString(), std::move(values));
+  }
+  return result;
+}
+std::optional<DnsCanonicalNamesByAddress> DnsCanonicalNamesFromValue(
+    const base::DictValue& value) {
+  if (value.size() > 1024) {
+    return std::nullopt;
+  }
+  DnsCanonicalNamesByAddress result;
+  for (const auto [literal, owners_value] : value) {
+    IPAddress address;
+    const auto* owners = owners_value.GetIfList();
+    if (!address.AssignFromIPLiteral(literal) ||
+        (!address.IsIPv4() && !address.IsIPv6()) || !owners ||
+        owners->empty() || owners->size() > 128) {
+      return std::nullopt;
+    }
+    for (const auto& owner_value : *owners) {
+      const auto* owner = owner_value.GetIfString();
+      if (!owner) {
+        return std::nullopt;
+      }
+      const auto canonical = CanonicalReceiptHost(*owner);
+      if (!canonical || *canonical != *owner) {
+        return std::nullopt;
+      }
+      result[address].insert(*canonical);
+    }
+  }
+  return result;
+}
+}  // namespace net
diff --git a/net/base/dns_canonical_name_receipt.h b/net/base/dns_canonical_name_receipt.h
new file mode 100644
index 0000000000000000000000000000000000000000..9fbc40af3bfe780b13905d54cbfe905986de5e0e
--- /dev/null
+++ b/net/base/dns_canonical_name_receipt.h
@@ -0,0 +1,73 @@
+// Copyright 2026 The Aux Authors. BSD-3-Clause.
+#ifndef NET_BASE_DNS_CANONICAL_NAME_RECEIPT_H_
+#define NET_BASE_DNS_CANONICAL_NAME_RECEIPT_H_
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "net/base/ip_address.h"
+#include "net/base/net_export.h"
+#include "url/gurl.h"
+namespace net {
+// Values are final A/AAAA record-owner names, indexed by the actual answer
+// address. This is not the unordered union of CNAME/HTTPS aliases. Multiple
+// owners for one address are retained as ambiguity, never resolved by order.
+using DnsCanonicalNamesByAddress = std::map<IPAddress, std::set<std::string>>;
+NET_EXPORT base::DictValue DnsCanonicalNamesToValue(
+    const DnsCanonicalNamesByAddress& names);
+NET_EXPORT std::optional<DnsCanonicalNamesByAddress> DnsCanonicalNamesFromValue(
+    const base::DictValue& value);
+
+struct NET_EXPORT DnsCanonicalNameReceipt {
+  std::string query_host;
+  IPAddress peer_address;
+  std::string canonical_name;
+  friend bool operator==(const DnsCanonicalNameReceipt&,
+                         const DnsCanonicalNameReceipt&) = default;
+};
+inline std::optional<std::string> CanonicalReceiptHost(std::string_view input) {
+  std::string host = base::ToLowerASCII(input);
+  if (!host.empty() && host.back() == '.') {
+    host.pop_back();
+  }
+  if (host.empty() || host.size() > 253) {
+    return std::nullopt;
+  }
+  const GURL parsed("https://" + host + "/");
+  if (!parsed.is_valid() || parsed.host() != host || parsed.has_username() ||
+      parsed.has_password() || parsed.has_port() || parsed.path() != "/" ||
+      parsed.has_query() || parsed.has_ref() || parsed.HostIsIPAddress()) {
+    return std::nullopt;
+  }
+  return host;
+}
+inline std::optional<DnsCanonicalNameReceipt> CaptureDnsCanonicalNameReceipt(
+    const std::string& original_query_host,
+    const IPAddress& actual_peer,
+    const DnsCanonicalNamesByAddress& actual_answers) {
+  const auto query = CanonicalReceiptHost(original_query_host);
+  const auto answer = actual_answers.find(actual_peer);
+  if (!query || answer == actual_answers.end() || answer->second.size() != 1 ||
+      (!actual_peer.IsIPv4() && !actual_peer.IsIPv6())) {
+    return std::nullopt;
+  }
+  const auto canonical = CanonicalReceiptHost(*answer->second.begin());
+  if (!canonical) {
+    return std::nullopt;
+  }
+  return DnsCanonicalNameReceipt{*query, actual_peer, *canonical};
+}
+inline bool DnsCanonicalReceiptMatches(const DnsCanonicalNameReceipt& receipt,
+                                       std::string_view query_host,
+                                       const IPAddress& peer) {
+  const auto query = CanonicalReceiptHost(query_host);
+  return query && *query == receipt.query_host &&
+         peer == receipt.peer_address &&
+         CanonicalReceiptHost(receipt.canonical_name) == receipt.canonical_name;
+}
+}  // namespace net
+#endif
