+struct AsyncDomStorageDatabase::AuxUiCacheRound {
+  std::shared_ptr<AuxUiMigrationLease::State> state;
+  AuxUiCacheOperation operation = AuxUiCacheOperation::kRead;
+  bool prepare = false;
