{
  "name": "aux-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --env-file-if-exists=.env.local scripts/check-environment.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "backup:capture:online": "node scripts/cloud-recovery-online.mjs capture"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.121",
    "@clerk/backend": "^3.26.0",
    "@clerk/nextjs": "^7.9.18",
