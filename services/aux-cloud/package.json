    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@vercel/blob": "^2.8.2",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "music-metadata": "^12.2.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.34.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
